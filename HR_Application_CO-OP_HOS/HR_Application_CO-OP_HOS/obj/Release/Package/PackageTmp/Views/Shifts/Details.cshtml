@model HR_Application_CO_OP_HOS.Models.Shift

@{
    ViewBag.Title = "Shift Details";

    // Normalize nullable datetimes and compute duration safely
    DateTime? start = Model?.StartDateTime;
    DateTime? end = Model?.EndDateTime;
    TimeSpan? duration = null;
    int hours = 0;
    int minutes = 0;
    double totalMinutes = 0;
    bool hasDuration = false;
    string startDisplay = "N/A";
    string endDisplay = "N/A";
    bool isOvernight = false;

    if (start.HasValue && end.HasValue)
    {
        duration = end.Value - start.Value;
        hours = (int)duration.Value.TotalHours;
        minutes = duration.Value.Minutes;
        totalMinutes = duration.Value.TotalMinutes;
        hasDuration = true;
        startDisplay = start.Value.ToString("f");
        endDisplay = end.Value.ToString("f");
        isOvernight = start.Value.Date != end.Value.Date;
    }
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-eye"></i> Shift Details</h1>
            <p class="lead">View complete shift information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Shift Information</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-section">
                                <h4><i class="fa fa-barcode"></i> Basic Information</h4>
                                <table class="table table-striped">
                                    <tr>
                                        <th>Shift Code:</th>
                                        <td>@Html.DisplayFor(model => model.ShiftCode)</td>
                                    </tr>
                                    <tr>
                                        <th>Description:</th>
                                        <td>@Html.DisplayFor(model => model.ShiftDescription)</td>
                                    </tr>
                                    <tr>
                                        <th>Start Date/Time:</th>
                                        <td>@(start.HasValue ? start.Value.ToString("f") : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th>End Date/Time:</th>
                                        <td>@(end.HasValue ? end.Value.ToString("f") : "N/A")</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-section">
                                <h4><i class="fa fa-calculator"></i> Shift Analysis</h4>
                                <table class="table table-striped">
                                    <tr>
                                        <th>Duration:</th>
                                        <td>
                                            @if (hasDuration)
                                            {
                                                @($"{hours} hours {minutes} minutes")
                                            }
                                            else
                                            {
                                                <text>N/A</text>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Total Minutes:</th>
                                        <td>
                                            @if (hasDuration)
                                            {
                                                @($"{totalMinutes:F0} minutes")
                                            }
                                            else
                                            {
                                                <text>N/A</text>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Shift Type:</th>
                                        <td>
                                            @if (hasDuration)
                                            {
                                                if (duration.Value.TotalHours <= 8)
                                                {
                                                    <span class="label label-success">Regular Shift</span>
                                                }
                                                else if (duration.Value.TotalHours <= 12)
                                                {
                                                    <span class="label label-warning">Extended Shift</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-danger">Long Shift</span>
                                                }
                                            }
                                            else
                                            {
                                                <text>N/A</text>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Overnight:</th>
                                        <td>
                                            @if (start.HasValue && end.HasValue)
                                            {
                                                if (isOvernight)
                                                {
                                                    <span class="label label-info">Overnight Shift</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-default">Single Day</span>
                                                }
                                            }
                                            else
                                            {
                                                <text>N/A</text>
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="detail-section">
                                <h4><i class="fa fa-clock-o"></i> Timeline</h4>
                                <div class="timeline">
                                    <div class="timeline-item">
                                        <div class="timeline-point start-point">
                                            <i class="fa fa-play-circle"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h5>Shift Start</h5>
                                            <p>@(startDisplay)</p>
                                        </div>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="timeline-point end-point">
                                            <i class="fa fa-stop-circle"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h5>Shift End</h5>
                                            <p>@(endDisplay)</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-cogs"></i> Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="action-buttons">
                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning btn-block btn-lg">
                            <i class="fa fa-edit"></i> Edit Shift
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-primary btn-block btn-lg">
                            <i class="fa fa-list"></i> Back to List
                        </a>
                        <a href="@Url.Action("Create")" class="btn btn-success btn-block btn-lg">
                            <i class="fa fa-plus"></i> Create New
                        </a>
                    </div>
                </div>
            </div>

            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Quick Stats</h3>
                </div>
                <div class="panel-body">
                    <div class="stats-section">
                        <div class="stat-item">
                            <i class="fa fa-clock-o stat-icon"></i>
                            <div class="stat-info">
                                <h4>Shift Duration</h4>
                                <p class="stat-number">
                                    @if (hasDuration)
                                    {
                                        @($"{hours} h {minutes} m")
                                    }
                                    else
                                    {
                                        <text>N/A</text>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i class="fa fa-calendar stat-icon"></i>
                            <div class="stat-info">
                                <h4>Days Covered</h4>
                                <p class="stat-number">
                                    @if (start.HasValue && end.HasValue)
                                    {
                                        if (isOvernight)
                                        {
                                            <text>2 Days</text>
                                        }
                                        else
                                        {
                                            <text>1 Day</text>
                                        }
                                    }
                                    else
                                    {
                                        <text>N/A</text>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
    }

    .panel-primary .panel-heading {
        background-color: #3498db !important;
        color: white;
    }

    .detail-section {
        margin-bottom: 25px;
    }

        .detail-section h4 {
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }

    .table th {
        background-color: #ecf0f1;
        width: 40%;
    }

    .label {
        padding: 4px 8px;
        border-radius: 3px;
        font-size: 12px;
    }

    .label-success {
        background-color: #27ae60;
    }

    .label-warning {
        background-color: #f39c12;
    }

    .label-danger {
        background-color: #e74c3c;
    }

    .label-info {
        background-color: #3498db;
    }

    .label-default {
        background-color: #95a5a6;
    }

    .timeline {
        position: relative;
        padding: 20px 0;
    }

    .timeline-item {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .timeline-point {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        color: white;
        font-size: 18px;
    }

    .start-point {
        background-color: #27ae60;
    }

    .end-point {
        background-color: #e74c3c;
    }

    .timeline-content {
        flex: 1;
    }

        .timeline-content h5 {
            margin: 0;
            color: #2c3e50;
        }

        .timeline-content p {
            margin: 5px 0 0 0;
            color: #7f8c8d;
        }

    .action-buttons .btn {
        margin-bottom: 10px;
        padding: 15px;
        font-size: 16px;
    }

    .stats-section {
        text-align: center;
    }

    .stat-item {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 8px;
    }

    .stat-icon {
        font-size: 2rem;
        color: #3498db;
        margin-right: 15px;
    }

    .stat-info h4 {
        margin: 0;
        font-size: 14px;
        color: #7f8c8d;
    }

    .stat-number {
        margin: 5px 0 0 0;
        font-size: 1.5rem;
        font-weight: bold;
        color: #2c3e50;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 8px;
        }

        .col-md-8, .col-md-4 {
            margin-bottom: 15px;
        }

        .timeline-item {
            flex-direction: column;
            text-align: center;
        }

        .timeline-point {
            margin-right: 0;
            margin-bottom: 10px;
        }

        .stat-item {
            flex-direction: column;
            text-align: center;
        }

        .stat-icon {
            margin-right: 0;
            margin-bottom: 10px;
        }
    }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">