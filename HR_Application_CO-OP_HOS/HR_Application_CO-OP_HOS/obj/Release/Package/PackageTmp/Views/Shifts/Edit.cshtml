@model HR_Application_CO_OP_HOS.Models.Shift

@{
    ViewBag.Title = "Edit Shift";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Shift</h1>
            <p class="lead">Update shift information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Shift Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.ID)

                            <div class="form-group">
                                @Html.LabelFor(model => model.ShiftCode, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.ShiftCode, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.ShiftCode, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.ShiftDescription, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.ShiftDescription, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.ShiftDescription, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.StartDateTime, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.StartDateTime, new { htmlAttributes = new { @class = "form-control datetime-picker", @type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.StartDateTime, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.EndDateTime, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.EndDateTime, new { htmlAttributes = new { @class = "form-control datetime-picker", @type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.EndDateTime, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-4 col-md-8">
                                    <button type="submit" class="btn btn-warning btn-lg">
                                        <i class="fa fa-save"></i> Save Changes
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                        <i class="fa fa-arrow-left"></i> Back to List
                                    </a>
                                    <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-info btn-lg">
                                        <i class="fa fa-eye"></i> View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Current Values</h3>
                </div>
                <div class="panel-body">
                    <div class="current-values">
                        <h4><i class="fa fa-info-circle"></i> Current Shift Information</h4>
                        <table class="table table-bordered">
                            <tr>
                                <th>Shift Code:</th>
                                <td>@Model.ShiftCode</td>
                            </tr>
                            <tr>
                                <th>Description:</th>
                                <td>@Model.ShiftDescription</td>
                            </tr>
                            <tr>
                                <th>Start Time:</th>
                                <td>@(Model.StartDateTime.HasValue ? Model.StartDateTime.Value.ToString("yyyy-MM-dd HH:mm") : "N/A")</td>
                            </tr>
                            <tr>
                                <th>End Time:</th>
                                <td>@(Model.EndDateTime.HasValue ? Model.EndDateTime.Value.ToString("yyyy-MM-dd HH:mm") : "N/A")</td>
                            </tr>
                        </table>
                    </div>

                    <div class="info-section">
                        <h4><i class="fa fa-calculator"></i> Duration Calculator</h4>
                        <div class="form-group">
                            <label>Start Time:</label>
                            <input type="datetime-local" class="form-control" id="calcStart" value="@(Model.StartDateTime.HasValue ? Model.StartDateTime.Value.ToString("yyyy-MM-ddTHH:mm") : "")">
                        </div>
                        <div class="form-group">
                            <label>End Time:</label>
                            <input type="datetime-local" class="form-control" id="calcEnd" value="@(Model.EndDateTime.HasValue ? Model.EndDateTime.Value.ToString("yyyy-MM-ddTHH:mm") : "")">
                        </div>
                        <button class="btn btn-primary btn-sm" onclick="calculateDuration()">
                            Calculate Duration
                        </button>
                        <div id="durationResult" class="mt-2">
                            @{
                                TimeSpan? duration = null;
                                var hours = 0;
                                var minutes = 0;

                                if (Model.StartDateTime.HasValue && Model.EndDateTime.HasValue)
                                {
                                    duration = Model.EndDateTime.Value - Model.StartDateTime.Value;
                                    if (duration.HasValue)
                                    {
                                        hours = (int)duration.Value.TotalHours;
                                        minutes = duration.Value.Minutes;
                                    }
                                }
                            }
                            <strong>Current Duration: @hours hours @minutes minutes</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function calculateDuration() {
            var start = document.getElementById('calcStart').value;
            var end = document.getElementById('calcEnd').value;

            if (start && end) {
                var startDate = new Date(start);
                var endDate = new Date(end);

                if (startDate >= endDate) {
                    alert('End time must be after start time');
                    return;
                }

                var diff = endDate - startDate;
                var hours = Math.floor(diff / (1000 * 60 * 60));
                var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

                var durationText = hours + ' hours ' + minutes + ' minutes';
                document.getElementById('durationResult').innerHTML = '<strong>Duration: ' + durationText + '</strong>';
            } else {
                alert('Please select both start and end times');
            }
        }

        // Auto-update calculation when form fields change
        document.addEventListener('DOMContentLoaded', function () {
            var startField = document.querySelector('input[name="StartDateTime"]');
            var endField = document.querySelector('input[name="EndDateTime"]');
            var calcStart = document.getElementById('calcStart');
            var calcEnd = document.getElementById('calcEnd');

            if (startField && calcStart) {
                startField.addEventListener('change', function () {
                    calcStart.value = this.value;
                    calculateDuration();
                });
            }

            if (endField && calcEnd) {
                endField.addEventListener('change', function () {
                    calcEnd.value = this.value;
                    calculateDuration();
                });
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
    }

    .panel-warning .panel-heading {
        background-color: #f39c12 !important;
        color: white;
    }

    .current-values {
        margin-bottom: 25px;
    }

        .current-values table {
            width: 100%;
            font-size: 14px;
        }

        .current-values th {
            background-color: #ecf0f1;
            width: 40%;
        }

    .info-section {
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 5px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 8px;
        }

        .col-md-8, .col-md-4 {
            margin-bottom: 15px;
        }

        .btn {
            margin-bottom: 10px;
            width: 100%;
        }
    }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">