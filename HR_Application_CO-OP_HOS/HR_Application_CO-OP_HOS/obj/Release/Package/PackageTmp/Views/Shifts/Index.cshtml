@model IEnumerable<HR_Application_CO_OP_HOS.Models.Shift>

@{
    ViewBag.Title = "Shifts Management";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-clock-o"></i> Shifts Management</h1>
            <p class="lead">Manage employee shifts and schedules</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-primary quick-actions-panel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3 text-center">
                            <a href="@Url.Action("Create")" class="btn btn-success btn-lg btn-block">
                                <i class="fa fa-plus"></i> Create New Shift
                            </a>
                        </div>
                        <div class="col-md-3 text-center">
                            <button class="btn btn-info btn-lg btn-block" onclick="toggleFilters()">
                                <i class="fa fa-filter"></i> Toggle Filters
                            </button>
                        </div>
                        <div class="col-md-3 text-center">
                            <button class="btn btn-warning btn-lg btn-block" onclick="exportToExcel()">
                                <i class="fa fa-download"></i> Export to Excel
                            </button>
                        </div>
                        <div class="col-md-3 text-center">
                            <button class="btn btn-primary btn-lg btn-block" onclick="refreshData()">
                                <i class="fa fa-refresh"></i> Refresh Data
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="row no-gutters" id="filtersSection" style="display: none;">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filters</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="shiftCodeFilter">Shift Code</label>
                                <input type="text" class="form-control" id="shiftCodeFilter" placeholder="Filter by shift code">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="descriptionFilter">Description</label>
                                <input type="text" class="form-control" id="descriptionFilter" placeholder="Filter by description">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="startTimeFilter">Start Time</label>
                                <input type="time" class="form-control" id="startTimeFilter">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="endTimeFilter">End Time</label>
                                <input type="time" class="form-control" id="endTimeFilter">
                            </div>
                        </div>
                    </div>
                    <div class="row no-gutters">
                        <div class="col-12 text-right">
                            <button class="btn btn-primary" onclick="applyFilters()">
                                <i class="fa fa-check"></i> Apply Filters
                            </button>
                            <button class="btn btn-secondary" onclick="clearFilters()">
                                <i class="fa fa-times"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Section -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-list"></i> Shifts List</h3>
                </div>
                <div class="panel-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="shiftsTable">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>
                                            @Html.DisplayNameFor(model => model.ShiftCode)
                                            <i class="fa fa-sort sort-icon" onclick="sortTable(0)"></i>
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.ShiftDescription)
                                            <i class="fa fa-sort sort-icon" onclick="sortTable(1)"></i>
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.StartDateTime)
                                            <i class="fa fa-sort sort-icon" onclick="sortTable(2)"></i>
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.EndDateTime)
                                            <i class="fa fa-sort sort-icon" onclick="sortTable(3)"></i>
                                        </th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => item.ShiftCode)</td>
                                            <td>@Html.DisplayFor(modelItem => item.ShiftDescription)</td>
                                            <td>@Html.DisplayFor(modelItem => item.StartDateTime)</td>
                                            <td>@Html.DisplayFor(modelItem => item.EndDateTime)</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="row no-gutters">
                            <div class="col-12">
                                <div class="data-summary">
                                    <p>Total Shifts: <strong>@Model.Count()</strong></p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fa fa-exclamation-triangle"></i> No shifts found in the system.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter functionality
        function toggleFilters() {
            var filtersSection = document.getElementById('filtersSection');
            filtersSection.style.display = filtersSection.style.display === 'none' ? 'block' : 'none';
        }

        function applyFilters() {
            var shiftCodeFilter = document.getElementById('shiftCodeFilter').value.toLowerCase();
            var descriptionFilter = document.getElementById('descriptionFilter').value.toLowerCase();
            var startTimeFilter = document.getElementById('startTimeFilter').value;
            var endTimeFilter = document.getElementById('endTimeFilter').value;

            var table = document.getElementById('shiftsTable');
            var rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            for (var i = 0; i < rows.length; i++) {
                var cells = rows[i].getElementsByTagName('td');
                var shiftCode = cells[0].textContent.toLowerCase();
                var description = cells[1].textContent.toLowerCase();
                var startTime = cells[2].textContent;
                var endTime = cells[3].textContent;

                var showRow = true;

                if (shiftCodeFilter && !shiftCode.includes(shiftCodeFilter)) {
                    showRow = false;
                }
                if (descriptionFilter && !description.includes(descriptionFilter)) {
                    showRow = false;
                }
                if (startTimeFilter && !startTime.includes(startTimeFilter)) {
                    showRow = false;
                }
                if (endTimeFilter && !endTime.includes(endTimeFilter)) {
                    showRow = false;
                }

                rows[i].style.display = showRow ? '' : 'none';
            }
        }

        function clearFilters() {
            document.getElementById('shiftCodeFilter').value = '';
            document.getElementById('descriptionFilter').value = '';
            document.getElementById('startTimeFilter').value = '';
            document.getElementById('endTimeFilter').value = '';
            applyFilters();
        }

        // Sorting functionality
        function sortTable(columnIndex) {
            var table = document.getElementById('shiftsTable');
            var rows = Array.from(table.rows).slice(1); // Skip header
            var isAscending = !table.getAttribute('data-sort-asc');

            rows.sort(function (a, b) {
                var aValue = a.cells[columnIndex].textContent.trim();
                var bValue = b.cells[columnIndex].textContent.trim();

                // Handle numeric sorting for ShiftCode
                if (columnIndex === 0) {
                    aValue = parseInt(aValue) || 0;
                    bValue = parseInt(bValue) || 0;
                }

                if (aValue < bValue) return isAscending ? -1 : 1;
                if (aValue > bValue) return isAscending ? 1 : -1;
                return 0;
            });

            // Reappend sorted rows
            var tbody = table.getElementsByTagName('tbody')[0];
            tbody.innerHTML = '';
            rows.forEach(function (row) {
                tbody.appendChild(row);
            });

            table.setAttribute('data-sort-asc', isAscending);
        }

        // Export functionality
        function exportToExcel() {
            var table = document.getElementById('shiftsTable');
            var html = table.outerHTML;
            var url = 'data:application/vnd.ms-excel,' + escape(html);
            var downloadLink = document.createElement('a');
            downloadLink.href = url;
            downloadLink.download = 'shifts_export.xls';
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }

        function refreshData() {
            location.reload();
        }

        // Initialize table sorting
        document.addEventListener('DOMContentLoaded', function () {
            var table = document.getElementById('shiftsTable');
            table.setAttribute('data-sort-asc', 'true');
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
        font-size: 16px;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.4rem;
        opacity: 0.9;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 8px;
            padding-left: 8px;
        }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-title {
        font-size: 1.3rem;
        margin: 0;
    }

        .panel-title i {
            margin-right: 10px;
        }

    .panel-body {
        padding: 20px;
    }

    .quick-actions-panel {
        border-left: 5px solid #3498db;
    }

    .table th {
        background-color: #2c3e50;
        color: white;
        border: none;
        padding: 15px;
        font-weight: 600;
    }

    .table td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .sort-icon {
        cursor: pointer;
        margin-left: 5px;
        color: #ecf0f1;
    }

    .btn-group .btn {
        margin: 2px;
    }

    .data-summary {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 5px;
        margin-top: 15px;
    }

    .alert {
        border-radius: 10px;
        padding: 20px;
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 8px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.2rem;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
        }

            .btn-group .btn {
                margin: 2px 0;
            }
    }
</style>

<!-- Font Awesome for Icons -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">