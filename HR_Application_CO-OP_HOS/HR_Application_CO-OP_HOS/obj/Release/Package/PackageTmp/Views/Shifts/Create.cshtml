@model HR_Application_CO_OP_HOS.Models.Shift

@{
    ViewBag.Title = "Create New Shift";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create New Shift</h1>
            <p class="lead">Add a new shift to the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Shift Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group">
                                @Html.LabelFor(model => model.ShiftCode, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.ShiftCode, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter shift code" } })
                                    @Html.ValidationMessageFor(model => model.ShiftCode, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.ShiftDescription, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.ShiftDescription, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter shift description" } })
                                    @Html.ValidationMessageFor(model => model.ShiftDescription, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.StartDateTime, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.StartDateTime, new { htmlAttributes = new { @class = "form-control datetime-picker", @type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.StartDateTime, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.EndDateTime, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.EndDateTime, new { htmlAttributes = new { @class = "form-control datetime-picker", @type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.EndDateTime, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-4 col-md-8">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fa fa-save"></i> Create Shift
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                        <i class="fa fa-arrow-left"></i> Back to List
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Shift Information</h3>
                </div>
                <div class="panel-body">
                    <div class="info-section">
                        <h4><i class="fa fa-lightbulb-o"></i> Tips</h4>
                        <ul>
                            <li>Shift codes should be unique identifiers</li>
                            <li>Provide clear descriptions for better understanding</li>
                            <li>Ensure start time is before end time</li>
                            <li>Consider overlapping shifts when creating new ones</li>
                        </ul>
                    </div>

                    <div class="info-section">
                        <h4><i class="fa fa-calculator"></i> Duration Calculator</h4>
                        <div class="form-group">
                            <label>Start Time:</label>
                            <input type="datetime-local" class="form-control" id="calcStart">
                        </div>
                        <div class="form-group">
                            <label>End Time:</label>
                            <input type="datetime-local" class="form-control" id="calcEnd">
                        </div>
                        <button class="btn btn-primary btn-sm" onclick="calculateDuration()">
                            Calculate Duration
                        </button>
                        <div id="durationResult" class="mt-2" style="display: none;">
                            <strong>Duration: <span id="durationValue"></span></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function calculateDuration() {
            var start = document.getElementById('calcStart').value;
            var end = document.getElementById('calcEnd').value;

            if (start && end) {
                var startDate = new Date(start);
                var endDate = new Date(end);

                if (startDate >= endDate) {
                    alert('End time must be after start time');
                    return;
                }

                var diff = endDate - startDate;
                var hours = Math.floor(diff / (1000 * 60 * 60));
                var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

                var durationText = hours + ' hours ' + minutes + ' minutes';
                document.getElementById('durationValue').textContent = durationText;
                document.getElementById('durationResult').style.display = 'block';
            } else {
                alert('Please select both start and end times');
            }
        }

        // Auto-fill calculation fields when form fields change
        document.addEventListener('DOMContentLoaded', function () {
            var startField = document.querySelector('input[name="StartDateTime"]');
            var endField = document.querySelector('input[name="EndDateTime"]');
            var calcStart = document.getElementById('calcStart');
            var calcEnd = document.getElementById('calcEnd');

            if (startField && calcStart) {
                startField.addEventListener('change', function () {
                    calcStart.value = this.value;
                });
            }

            if (endField && calcEnd) {
                endField.addEventListener('change', function () {
                    calcEnd.value = this.value;
                });
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
