    }

    .btn {
        border-radius: 5px;
        padding: 10px 20px;
        margin-right: 10px;
    }

    .info-section {
        margin-bottom: 25px;
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 5px;
    }

        .info-section h4 {
            color: #2c3e50;
            margin-bottom: 15px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 8px;
        }

        .info-section ul {
