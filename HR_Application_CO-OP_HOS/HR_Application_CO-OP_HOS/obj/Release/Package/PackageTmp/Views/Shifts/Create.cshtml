        font-size: 2.2rem;
        margin-bottom: 15px;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0;
        border: none;
        padding: 15px 20px;
    }

    .panel-success .panel-heading {
        background-color: #27ae60 !important;
        color: white;
    }

    .panel-info .panel-heading {
        background-color: #3498db !important;
        color: white;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .control-label {
        font-weight: 600;
