@model HR_Application_CO_OP_HOS.Models.Shift

@{
    ViewBag.Title = "Delete Shift";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Shift</h1>
            <p class="lead">Remove shift from the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-danger">
                        <h4><i class="fa fa-warning"></i> Warning!</h4>
                        <p>You are about to permanently delete this shift. This action cannot be undone.</p>
                    </div>

                    <div class="confirmation-section">
                        <h4>Shift Details to be Deleted:</h4>
                        <table class="table table-bordered">
                            <tr>
                                <th>Shift Code:</th>
                                <td>@Html.DisplayFor(model => model.ShiftCode)</td>
                            </tr>
                            <tr>
                                <th>Description:</th>
                                <td>@Html.DisplayFor(model => model.ShiftDescription)</td>
                            </tr>
                            <tr>
                                <th>Start Date/Time:</th>
                                <td>@Html.DisplayFor(model => model.StartDateTime)</td>
                            </tr>
                            <tr>
                                <th>End Date/Time:</th>
                                <td>@Html.DisplayFor(model => model.EndDateTime)</td>
                            </tr>
                            <tr>
                                <th>Duration:</th>
                                <td>
                                    @{
                                        // Model.StartDateTime and Model.EndDateTime are nullable (DateTime?)
                                        // Subtraction results in TimeSpan? so check HasValue before accessing .Value
                                        string durationText;
                                        if (Model?.StartDateTime.HasValue == true && Model?.EndDateTime.HasValue == true)
                                        {
                                            TimeSpan duration = Model.EndDateTime.Value - Model.StartDateTime.Value;

                                            // If end is before start, make the duration positive and optionally indicate sign
                                            bool negative = duration < TimeSpan.Zero;
                                            if (negative)
                                            {
                                                duration = duration.Negate();
                                            }

                                            // Compute total hours (could be > 24) and remaining minutes
                                            var hours = (int)duration.TotalHours;
                                            var minutes = duration.Minutes;

                                            durationText = (negative ? "-" : "") + string.Format("{0} hours {1} minutes", hours, minutes);
                                        }
                                        else
                                        {
                                            durationText = "N/A";
                                        }
                                    }
                                    @durationText
                                </td>
                            </tr>
                        </table>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-actions">
                            <button type="submit" class="btn btn-danger btn-lg" onclick="return confirmDelete()">
                                <i class="fa fa-trash"></i> Confirm Delete
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                                <i class="fa fa-arrow-left"></i> Cancel
                            </a>
                            <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-info btn-lg">
                                <i class="fa fa-eye"></i> View Details
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Deletion Impact</h3>
                </div>
                <div class="panel-body">
                    <div class="impact-section">
                        <h4><i class="fa fa-exclamation-circle"></i> Potential Impacts</h4>
                        <ul>
                            <li>This shift will be permanently removed from the system</li>
                            <li>Any associated employee schedules may be affected</li>
                            <li>Historical data referencing this shift will show gaps</li>
                            <li>This action is irreversible</li>
                        </ul>
                    </div>

                    <div class="safety-check">
                        <h4><i class="fa fa-shield"></i> Safety Check</h4>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="confirmCheck">
                            <label class="form-check-label" for="confirmCheck">
                                I understand this action cannot be undone
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="backupCheck">
                            <label class="form-check-label" for="backupCheck">
                                I have verified this shift is not in use
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            var confirmCheck = document.getElementById('confirmCheck');
            var backupCheck = document.getElementById('backupCheck');

            if (!confirmCheck.checked || !backupCheck.checked) {
                alert('Please check all safety confirmation boxes before deleting.');
                return false;
            }

            return confirm('Are you absolutely sure you want to delete this shift? This action cannot be undone.');
        }

        // Disable delete button until safety checks are completed
        document.addEventListener('DOMContentLoaded', function () {
            var deleteButton = document.querySelector('button[type="submit"]');
            var confirmCheck = document.getElementById('confirmCheck');
            var backupCheck = document.getElementById('backupCheck');

            function updateDeleteButton() {
                if (confirmCheck.checked && backupCheck.checked) {
                    deleteButton.disabled = false;
                } else {
                    deleteButton.disabled = true;
                }
            }

            confirmCheck.addEventListener('change', updateDeleteButton);
            backupCheck.addEventListener('change', updateDeleteButton);

            // Initially disable the button
            deleteButton.disabled = true;
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
    }

    .panel-danger .panel-heading {
        background-color: #e74c3c !important;
        color: white;
    }

    .panel-warning .panel-heading {
        background-color: #f39c12 !important;
        color: white;
    }

    .alert-danger {
        border-radius: 8px;
        border-left: 5px solid #c0392b;
    }

    .confirmation-section {
        margin: 25px 0;
    }

        .confirmation-section h4 {
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .confirmation-section table {
            font-size: 14px;
        }

        .confirmation-section th {
            background-color: #ecf0f1;
            width: 30%;
        }

    .form-actions {
        text-align: center;
        margin-top: 25px;
    }

        .form-actions .btn {
            margin: 5px;
        }

    .impact-section {
        margin-bottom: 25px;
        padding: 15px;
        background-color: #fff3cd;
        border-radius: 5px;
        border-left: 4px solid #ffc107;
    }

        .impact-section h4 {
            color: #856404;
            margin-bottom: 15px;
        }

        .impact-section ul {
            padding-left: 20px;
            color: #856404;
        }

        .impact-section li {
            margin-bottom: 8px;
        }

    .safety-check {
        padding: 15px;
        background-color: #d1ecf1;
        border-radius: 5px;
        border-left: 4px solid #17a2b8;
    }

        .safety-check h4 {
            color: #0c5460;
            margin-bottom: 15px;
        }

    .form-check {
        margin-bottom: 10px;
    }

    .form-check-label {
        margin-left: 5px;
        color: #0c5460;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 8px;
        }

        .col-md-8, .col-md-4 {
            margin-bottom: 15px;
        }

        .form-actions .btn {
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">