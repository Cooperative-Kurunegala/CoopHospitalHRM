@model HR_Application_CO_OP_HOS.Models.RelatedPartySalary

@{
    ViewBag.Title = "Create Salary Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create Salary Record</h1>
            <p class="lead">Add new salary record for related party</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Form -->
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Salary Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyEPF, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.RelatedPartyEPF, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter EPF Number" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyEPF, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyID, "Related Party", htmlAttributes: new { @class = "control-label" })
                                    @Html.DropDownList("RelatedPartyID", null, "Select Related Party", htmlAttributes: new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Month, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.Month, new { htmlAttributes = new { @class = "form-control", @min = "1", @max = "12", @placeholder = "Month (1-12)" } })
                                    @Html.ValidationMessageFor(model => model.Month, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Year, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control", @placeholder = "Year" } })
                                    @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CompanyID, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CompanyID, new { htmlAttributes = new { @class = "form-control", @placeholder = "Company ID" } })
                                    @Html.ValidationMessageFor(model => model.CompanyID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Attendance Details -->
                        <div class="form-section">
                            <h4><i class="fa fa-calendar"></i> Attendance Details</h4>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WorkedDays, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.WorkedDays, new { htmlAttributes = new { @class = "form-control", @step = "0.5", @placeholder = "Worked Days" } })
                                        @Html.ValidationMessageFor(model => model.WorkedDays, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NoPayDays, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.NoPayDays, new { htmlAttributes = new { @class = "form-control", @step = "0.5", @placeholder = "No Pay Days" } })
                                        @Html.ValidationMessageFor(model => model.NoPayDays, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ActualNoPayDays, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.ActualNoPayDays, new { htmlAttributes = new { @class = "form-control", @step = "0.5", @placeholder = "Actual No Pay Days" } })
                                        @Html.ValidationMessageFor(model => model.ActualNoPayDays, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.TotalShifts, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.TotalShifts, new { htmlAttributes = new { @class = "form-control", @placeholder = "Total Shifts" } })
                                        @Html.ValidationMessageFor(model => model.TotalShifts, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Time Tracking -->
                        <div class="form-section">
                            <h4><i class="fa fa-clock-o"></i> Time Tracking</h4>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LateMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.LateMinutes, new { htmlAttributes = new { @class = "form-control", @placeholder = "Late Minutes" } })
                                        @Html.ValidationMessageFor(model => model.LateMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.OTMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.OTMinutes, new { htmlAttributes = new { @class = "form-control", @placeholder = "OT Minutes" } })
                                        @Html.ValidationMessageFor(model => model.OTMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DoubleOTMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.DoubleOTMinutes, new { htmlAttributes = new { @class = "form-control", @placeholder = "Double OT Minutes" } })
                                        @Html.ValidationMessageFor(model => model.DoubleOTMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ActualLateHours, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.ActualLateHours, new { htmlAttributes = new { @class = "form-control", @step = "0.5", @placeholder = "Actual Late Hours" } })
                                        @Html.ValidationMessageFor(model => model.ActualLateHours, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status Flags -->
                        <div class="form-section">
                            <h4><i class="fa fa-flag"></i> Status Flags</h4>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsPayoutGenerated, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsPayoutGenerated, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsPayoutGenerated, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsLocked, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsLocked, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsLocked, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsVerified, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsVerified, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsVerified, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsAttendanceVerified, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsAttendanceVerified, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsAttendanceVerified, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fa fa-save"></i> Create Salary Record
                            </button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Reference Information -->
        <div class="col-md-4">
            <!-- Related Party Information -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-users"></i> Related Party Info</h3>
                </div>
                <div class="panel-body" id="relatedPartyInfo">
                    <div class="text-center text-muted">
                        <i class="fa fa-info-circle fa-3x mb-3"></i>
                        <p>Select a related party to view details</p>
                    </div>
                </div>
            </div>

            <!-- Quick Calculations -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calculator"></i> Salary Calculator</h3>
                </div>
                <div class="panel-body">
                    <div class="calculation-item">
                        <label>Basic Salary:</label>
                        <span id="basicSalaryCalc" class="float-right">--</span>
                    </div>
                    <div class="calculation-item">
                        <label>OT Amount:</label>
                        <span id="otAmountCalc" class="float-right">--</span>
                    </div>
                    <div class="calculation-item">
                        <label>Deductions:</label>
                        <span id="deductionsCalc" class="float-right">--</span>
                    </div>
                    <hr>
                    <div class="calculation-item total">
                        <label><strong>Net Salary:</strong></label>
                        <span id="netSalaryCalc" class="float-right"><strong>--</strong></span>
                    </div>
                </div>
            </div>

            <!-- Form Tips -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-lightbulb-o"></i> Tips</h3>
                </div>
                <div class="panel-body">
                    <ul class="list-unstyled">
                        <li><i class="fa fa-check text-success"></i> Ensure all attendance data is verified</li>
                        <li><i class="fa fa-check text-success"></i> Double-check EPF numbers</li>
                        <li><i class="fa fa-check text-success"></i> Verify OT calculations</li>
                        <li><i class="fa fa-check text-success"></i> Review before locking records</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Related Party selection handler
            $('#RelatedPartyID').change(function () {
                var relatedPartyId = $(this).val();
                if (relatedPartyId) {
                    loadRelatedPartyInfo(relatedPartyId);
                } else {
                    $('#relatedPartyInfo').html('<div class="text-center text-muted"><i class="fa fa-info-circle fa-3x mb-3"></i><p>Select a related party to view details</p></div>');
                }
            });

            function loadRelatedPartyInfo(relatedPartyId) {
                // This would typically call an API endpoint
                // For now, we'll simulate with a loading state
                $('#relatedPartyInfo').html('<div class="text-center"><i class="fa fa-spinner fa-spin fa-2x"></i><p>Loading...</p></div>');

                // Simulate API call
                setTimeout(function () {
                    var sampleData = `
                        <div class="related-party-details">
                            <h5>Party Details</h5>
                            <div class="detail-item">
                                <label>Registration No:</label>
                                <span>RP${relatedPartyId.toString().padStart(4, '0')}</span>
                            </div>
                            <div class="detail-item">
                                <label>Name:</label>
                                <span>Sample Related Party</span>
                            </div>
                            <div class="detail-item">
                                <label>Designation:</label>
                                <span>Staff Member</span>
                            </div>
                            <div class="detail-item">
                                <label>Basic Salary:</label>
                                <span>LKR 45,000.00</span>
                            </div>
                            <div class="detail-item">
                                <label>Status:</label>
                                <span class="badge badge-success">Active</span>
                            </div>
                        </div>
                    `;
                    $('#relatedPartyInfo').html(sampleData);
                }, 1000);
            }

            // Auto-calculate fields
            $('input[type="number"]').on('change', function () {
                calculateSalaryPreview();
            });

            function calculateSalaryPreview() {
                // Basic salary calculation logic
                var workedDays = parseFloat($('#WorkedDays').val()) || 0;
                var basicSalary = workedDays * 1500; // Example rate

                // OT calculation
                var otMinutes = parseFloat($('#OTMinutes').val()) || 0;
                var otHours = otMinutes / 60;
                var otAmount = otHours * 200; // Example OT rate

                // Deductions
                var noPayDays = parseFloat($('#NoPayDays').val()) || 0;
                var deductions = noPayDays * 1500; // Example deduction rate

                var netSalary = basicSalary + otAmount - deductions;

                // Update display
                $('#basicSalaryCalc').text('LKR ' + basicSalary.toFixed(2));
                $('#otAmountCalc').text('LKR ' + otAmount.toFixed(2));
                $('#deductionsCalc').text('LKR ' + deductions.toFixed(2));
                $('#netSalaryCalc').html('<strong>LKR ' + netSalary.toFixed(2) + '</strong>');
            }

            // Form validation enhancement
            $('form').on('submit', function (e) {
                var isValid = true;
                var requiredFields = ['RelatedPartyEPF', 'Month', 'Year', 'RelatedPartyID'];

                requiredFields.forEach(function (field) {
                    var value = $('#' + field).val();
                    if (!value) {
                        isValid = false;
                        $('#' + field).addClass('is-invalid');
                    } else {
                        $('#' + field).removeClass('is-invalid');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    alert('Please fill in all required fields.');
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        background: white;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .form-section {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        border-left: 4px solid #3498db;
    }

        .form-section h4 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-weight: 600;
        }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .control-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .form-control {
        border-radius: 6px;
        border: 1px solid #ddd;
        padding: 10px 15px;
        font-size: 14px;
    }

    .form-check {
        padding: 10px 0;
    }

    .form-check-input {
        margin-right: 10px;
    }

    .form-actions {
        text-align: center;
        padding: 20px 0;
        border-top: 1px solid #eee;
        margin-top: 20px;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        margin: 0 10px;
    }

    .related-party-details .detail-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

        .related-party-details .detail-item:last-child {
            border-bottom: none;
        }

    .calculation-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

        .calculation-item.total {
            border-top: 2px solid #3498db;
            margin-top: 10px;
            padding-top: 15px;
        }

    .badge {
        font-size: 0.8rem;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    .alert {
        border-radius: 8px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .form-section .row .col-md-3,
        .form-section .row .col-md-4,
        .form-section .row .col-md-6 {
            margin-bottom: 15px;
        }

        .btn-lg {
            display: block;
            width: 100%;
            margin: 10px 0;
        }
    }
</style>
@Html.ActionLink("Back to List", "Index")
    </div>
</body>
</html>
