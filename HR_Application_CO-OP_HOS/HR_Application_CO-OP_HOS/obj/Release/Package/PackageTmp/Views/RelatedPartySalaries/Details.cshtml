@model HR_Application_CO_OP_HOS.Models.RelatedPartySalary

@{
    ViewBag.Title = "Salary Record Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-eye"></i> Salary Record Details</h1>
            <p class="lead">Detailed view of salary record information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Details -->
        <div class="col-md-8">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Salary Record Details</h3>
                </div>
                <div class="panel-body">
                    <div class="detail-sections">
                        <!-- Basic Information -->
                        <div class="detail-section">
                            <h4><i class="fa fa-id-card"></i> Basic Information</h4>
                            <div class="row">
                                <div class="col-md-4 detail-item">
                                    <label>Record ID:</label>
                                    <span>@Model.ID</span>
                                </div>
                                <div class="col-md-4 detail-item">
                                    <label>EPF Number:</label>
                                    <span>@Model.RelatedPartyEPF</span>
                                </div>
                                <div class="col-md-4 detail-item">
                                    <label>Period:</label>
                                    <span>@Model.Month/@Model.Year</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 detail-item">
                                    <label>Company ID:</label>
                                    <span>@Model.CompanyID</span>
                                </div>
                                <div class="col-md-4 detail-item">
                                    <label>Salary Type:</label>
                                    <span>@Model.SalaryTypeID</span>
                                </div>
                                <div class="col-md-4 detail-item">
                                    <label>Registration No:</label>
                                    <span>@(Model.RelatedParty?.RegistrationNumber ?? "N/A")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Attendance Summary -->
                        <div class="detail-section">
                            <h4><i class="fa fa-calendar-check-o"></i> Attendance Summary</h4>
                            <div class="row">
                                <div class="col-md-3 detail-item">
                                    <label>Worked Days:</label>
                                    <span class="value-highlight">@Model.WorkedDays</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>No Pay Days:</label>
                                    <span class="value-warning">@Model.NoPayDays</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Actual No Pay Days:</label>
                                    <span class="value-warning">@Model.ActualNoPayDays</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Total Shifts:</label>
                                    <span>@Model.TotalShifts</span>
                                </div>
                            </div>
                        </div>

                        <!-- Time Tracking -->
                        <div class="detail-section">
                            <h4><i class="fa fa-clock-o"></i> Time Tracking</h4>
                            <div class="row">
                                <div class="col-md-3 detail-item">
                                    <label>Late Minutes:</label>
                                    <span class="value-warning">@Model.LateMinutes</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>OT Minutes:</label>
                                    <span class="value-success">@Model.OTMinutes</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Double OT Minutes:</label>
                                    <span class="value-success">@Model.DoubleOTMinutes</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Actual Late Hours:</label>
                                    <span class="value-warning">@Model.ActualLateHours</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 detail-item">
                                    <label>Actual OT Hours:</label>
                                    <span class="value-success">@Model.ActualOTHours</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Actual DBL OT Hours:</label>
                                    <span class="value-success">@Model.ActualDBLOTHours</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Total In Late:</label>
                                    <span class="value-warning">@Model.TotalInLate</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Total Out Late:</label>
                                    <span class="value-warning">@Model.TotalOutLate</span>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information -->
                        <div class="detail-section">
                            <h4><i class="fa fa-list-alt"></i> Additional Information</h4>
                            <div class="row">
                                <div class="col-md-3 detail-item">
                                    <label>Final Late Count:</label>
                                    <span>@Model.FinalLateCount</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Total Additional Shifts:</label>
                                    <span>@Model.TotalAdditionalShifts</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Payee Tax Rate:</label>
                                    <span>@Model.PayeeTaxRate%</span>
                                </div>
                                <div class="col-md-3 detail-item">
                                    <label>Created Date:</label>
                                    <span>@(Model.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 detail-item">
                                    <label>Created By:</label>
                                    <span>@Model.CreatedBy</span>
                                </div>
                            </div>
                        </div>

                        <!-- Status Flags -->
                        <div class="detail-section">
                            <h4><i class="fa fa-flag"></i> Status Information</h4>
                            <div class="status-flags">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="status-item @(Model.IsPayoutGenerated == true ? "status-active" : "status-inactive")">
                                            <i class="fa @(Model.IsPayoutGenerated == true ? "fa-check-circle" : "fa-times-circle")"></i>
                                            <span>Payout Generated</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="status-item @(Model.IsLocked == true ? "status-active" : "status-inactive")">
                                            <i class="fa @(Model.IsLocked == true ? "fa-lock" : "fa-unlock")"></i>
                                            <span>Locked</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="status-item @(Model.IsVerified == true ? "status-active" : "status-inactive")">
                                            <i class="fa @(Model.IsVerified == true ? "fa-check-square" : "fa-square-o")"></i>
                                            <span>Verified</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="status-item @(Model.IsAttendanceVerified  == true? "status-active" : "status-inactive")">
                                            <i class="fa @(Model.IsAttendanceVerified == true ? "fa-check-square" : "fa-square-o")"></i>
                                            <span>Attendance Verified</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Information -->
        <div class="col-md-4">
            <!-- Actions Panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-cogs"></i> Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="action-buttons">
                        @Html.ActionLink("Edit Record", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-block btn-lg mb-3" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-block btn-lg mb-3" })

                        @if (!Model.IsLocked == true)
                        {
                            <button class="btn btn-success btn-block btn-lg mb-3" id="lockRecordBtn">
                                <i class="fa fa-lock"></i> Lock Record
                            </button>
                        }

                        @if (!Model.IsPayoutGenerated == true)
                        {
                            <button class="btn btn-info btn-block btn-lg mb-3" id="generatePayoutBtn">
                                <i class="fa fa-money"></i> Generate Payout
                            </button>
                        }

                        <button class="btn btn-dark btn-block btn-lg" id="printRecordBtn">
                            <i class="fa fa-print"></i> Print Record
                        </button>
                    </div>
                </div>
            </div>

            <!-- Record Summary -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Record Summary</h3>
                </div>
                <div class="panel-body">
                    <div class="summary-stats">
                        <div class="stat-item">
                            <label>Overall Status:</label>
                            <span>
                                @if (Model.IsPayoutGenerated == true)
                                {
                                    <span class="badge badge-success">Completed</span>
                                }
                                else if (Model.IsLocked == true)
                                {
                                    <span class="badge badge-warning">Locked</span>
                                }
                                else
                                {
                                    <span class="badge badge-info">In Progress</span>
                                }
                            </span>
                        </div>
                        <div class="stat-item">
                            <label>Verification Status:</label>
                            <span>
                                @if (Model.IsVerified == true && Model.IsAttendanceVerified == true)
                                {
                                    <span class="badge badge-success">Fully Verified</span>
                                }
                                else if (Model.IsVerified == true || Model.IsAttendanceVerified == true)
                                {
                                    <span class="badge badge-warning">Partially Verified</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Not Verified</span>
                                }
                            </span>
                        </div>
                        <div class="stat-item">
                            <label>Attendance Score:</label>
                            <span>
                                @{
                                    var attendanceScore = Model.WorkedDays > 0 ? (Model.WorkedDays / (Model.WorkedDays + Model.NoPayDays)) * 100 : 0;
                                }
                                <span class="badge @(attendanceScore >= 90 ? "badge-success" : attendanceScore >= 80 ? "badge-warning" : "badge-danger")">
                                    @attendanceScore.ToString?("0.0")%
                                </span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Party Information -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-user"></i> Related Party</h3>
                </div>
                <div class="panel-body">
                    @if (Model.RelatedParty != null)
                    {
                        <div class="party-details">
                            <div class="detail-item">
                                <label>Registration No:</label>
                                <span>@Model.RelatedParty.RegistrationNumber</span>
                            </div>
                            <div class="detail-item">
                                <label>Name:</label>
                                <span>@Model.RelatedParty.RelatedPartyName</span>
                            </div>
                            <div class="detail-item">
                                <label>Designation:</label>
                                <span>@(Model.RelatedParty.DesignationID?.ToString() ?? "N/A")</span>
                            </div>
                            <div class="detail-item">
                                <label>Category:</label>
                                <span>@(Model.RelatedParty.RelatedPartyCategoryID?.ToString() ?? "N/A")</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="fa fa-exclamation-triangle fa-2x mb-3"></i>
                            <p>No related party information available</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Calculations -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calculator"></i> Salary Estimate</h3>
                </div>
                <div class="panel-body">
                    <div class="calculation-preview">
                        <div class="calc-item">
                            <label>Basic Salary:</label>
                            <span>LKR --</span>
                        </div>
                        <div class="calc-item">
                            <label>OT Amount:</label>
                            <span>LKR --</span>
                        </div>
                        <div class="calc-item">
                            <label>Deductions:</label>
                            <span>LKR --</span>
                        </div>
                        <hr>
                        <div class="calc-item total">
                            <label><strong>Net Salary:</strong></label>
                            <span><strong>LKR --</strong></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Print functionality
            $('#printRecordBtn').click(function () {
                window.print();
            });

            // Lock record functionality
            $('#lockRecordBtn').click(function () {
                if (confirm('Are you sure you want to lock this record? Locked records cannot be modified.')) {
                    // Implement lock record logic here
                    alert('Record locking functionality would be implemented here');
                }
            });

            // Generate payout functionality
            $('#generatePayoutBtn').click(function () {
                if (confirm('Are you sure you want to generate payout for this record?')) {
                    // Implement generate payout logic here
                    alert('Payout generation functionality would be implemented here');
                }
            });

            // Calculate salary estimate
            function calculateSalaryEstimate() {
                var workedDays = @Model.WorkedDays;
                var otMinutes = @Model.OTMinutes;
                var noPayDays = @Model.NoPayDays;

                var basicSalary = workedDays * 1500; // Example rate
                var otHours = otMinutes / 60;
                var otAmount = otHours * 200; // Example OT rate
                var deductions = noPayDays * 1500; // Example deduction rate
                var netSalary = basicSalary + otAmount - deductions;

                $('.calculation-preview .calc-item:eq(0) span').text('LKR ' + basicSalary.toFixed(2));
                $('.calculation-preview .calc-item:eq(1) span').text('LKR ' + otAmount.toFixed(2));
                $('.calculation-preview .calc-item:eq(2) span').text('LKR ' + deductions.toFixed(2));
                $('.calculation-preview .calc-item.total span').html('<strong>LKR ' + netSalary.toFixed(2) + '</strong>');
            }

            // Calculate on page load
            calculateSalaryEstimate();
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #3498db 0%, #2c3e50 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        background: white;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .detail-sections {
        padding: 10px 0;
    }

    .detail-section {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        border-left: 4px solid #3498db;
    }

        .detail-section h4 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-weight: 600;
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 10px;
        }

    .detail-item {
        margin-bottom: 15px;
    }

        .detail-item label {
            font-weight: 600;
            color: #495057;
            display: block;
            margin-bottom: 5px;
        }

        .detail-item span {
            color: #6c757d;
            font-size: 1.1em;
        }

    .value-highlight {
        color: #28a745 !important;
        font-weight: 600;
    }

    .value-warning {
        color: #ffc107 !important;
        font-weight: 600;
    }

    .value-success {
        color: #17a2b8 !important;
        font-weight: 600;
    }

    .status-flags {
        padding: 10px 0;
    }

    .status-item {
        text-align: center;
        padding: 15px 10px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .status-active {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .status-inactive {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .status-item i {
        font-size: 1.5em;
        margin-bottom: 8px;
        display: block;
    }

    .action-buttons .btn {
        margin-bottom: 10px;
        padding: 12px;
        font-size: 16px;
    }

    .summary-stats .stat-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

        .summary-stats .stat-item:last-child {
            border-bottom: none;
        }

    .party-details .detail-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

        .party-details .detail-item:last-child {
            border-bottom: none;
        }

    .calculation-preview .calc-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
    }

        .calculation-preview .calc-item.total {
            border-top: 2px solid #3498db;
            margin-top: 10px;
            padding-top: 12px;
            font-weight: 600;
        }

    .badge {
        font-size: 0.85em;
        padding: 6px 12px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .detail-section .row .col-md-3,
        .detail-section .row .col-md-4 {
            margin-bottom: 15px;
        }

        .status-item {
            margin-bottom: 10px;
        }

        .action-buttons .btn {
            font-size: 14px;
            padding: 10px;
        }
    }

    @@media print {
        .dashboard-header,
        .action-buttons,
        .panel-heading {
            display: none;
        }

        .dashboard-container {
            background: white;
        }

        .panel {
            box-shadow: none;
            border: 1px solid #ddd;
        }
    }
</style>