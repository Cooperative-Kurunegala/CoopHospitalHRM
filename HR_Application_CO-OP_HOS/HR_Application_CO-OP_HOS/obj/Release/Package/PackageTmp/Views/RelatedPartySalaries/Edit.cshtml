@model HR_Application_CO_OP_HOS.Models.RelatedPartySalary

@{
    ViewBag.Title = "Edit Salary Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Salary Record</h1>
            <p class="lead">Modify existing salary record for related party</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Form -->
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Salary Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-warning" })

                        <div class="form-info">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Record ID:</strong> @Model.ID
                                </div>
                                <div class="col-md-6">
                                    <strong>Created:</strong> @(Model.CreatedDate?.ToString("yyyy-MM-dd") ?? "N/A")
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyEPF, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.RelatedPartyEPF, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter EPF Number" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyEPF, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyID, "Related Party", htmlAttributes: new { @class = "control-label" })
                                    @Html.DropDownList("RelatedPartyID", null, "Select Related Party", htmlAttributes: new { @class = "form-control select2" })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Month, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.Month, new { htmlAttributes = new { @class = "form-control", @min = "1", @max = "12" } })
                                    @Html.ValidationMessageFor(model => model.Month, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Year, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CompanyID, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CompanyID, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.CompanyID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Attendance Details -->
                        <div class="form-section">
                            <h4><i class="fa fa-calendar"></i> Attendance Details</h4>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WorkedDays, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.WorkedDays, new { htmlAttributes = new { @class = "form-control", @step = "0.5" } })
                                        @Html.ValidationMessageFor(model => model.WorkedDays, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NoPayDays, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.NoPayDays, new { htmlAttributes = new { @class = "form-control", @step = "0.5" } })
                                        @Html.ValidationMessageFor(model => model.NoPayDays, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ActualNoPayDays, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.ActualNoPayDays, new { htmlAttributes = new { @class = "form-control", @step = "0.5" } })
                                        @Html.ValidationMessageFor(model => model.ActualNoPayDays, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.TotalShifts, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.TotalShifts, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.TotalShifts, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Time Tracking -->
                        <div class="form-section">
                            <h4><i class="fa fa-clock-o"></i> Time Tracking</h4>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LateMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.LateMinutes, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.LateMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.OTMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.OTMinutes, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.OTMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DoubleOTMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.DoubleOTMinutes, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.DoubleOTMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ActualLateHours, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.ActualLateHours, new { htmlAttributes = new { @class = "form-control", @step = "0.5" } })
                                        @Html.ValidationMessageFor(model => model.ActualLateHours, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status Flags -->
                        <div class="form-section">
                            <h4><i class="fa fa-flag"></i> Status Flags</h4>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsPayoutGenerated, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsPayoutGenerated, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsPayoutGenerated, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsLocked, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsLocked, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsLocked, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsVerified, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsVerified, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsVerified, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsAttendanceVerified, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsAttendanceVerified, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsAttendanceVerified, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="fa fa-save"></i> Update Salary Record
                            </button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Reference Information -->
        <div class="col-md-4">
            <!-- Current Record Summary -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Current Record</h3>
                </div>
                <div class="panel-body">
                    <div class="record-summary">
                        <div class="summary-item">
                            <label>EPF Number:</label>
                            <span>@Model.RelatedPartyEPF</span>
                        </div>
                        <div class="summary-item">
                            <label>Period:</label>
                            <span>@Model.Month/@Model.Year</span>
                        </div>
                        <div class="summary-item">
                            <label>Worked Days:</label>
                            <span>@Model.WorkedDays</span>
                        </div>
                        <div class="summary-item">
                            <label>Status:</label>
                            <span>
                                @if (Model.IsPayoutGenerated == true)
                                {
                                    <span class="badge badge-success">Paid</span>
                                }
                                else if (Model.IsLocked == true)
                                {
                                    <span class="badge badge-warning">Locked</span>
                                }
                                else
                                {
                                    <span class="badge badge-info">Draft</span>
                                }
                            </span>
                        </div>
                        <div class="summary-item">
                            <label>Last Modified:</label>
                            <span>@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Party Information -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-user"></i> Related Party</h3>
                </div>
                <div class="panel-body" id="relatedPartyInfo">
                    <div class="text-center">
                        <i class="fa fa-spinner fa-spin fa-2x"></i>
                        <p>Loading party information...</p>
                    </div>
                </div>
            </div>

            <!-- Change History -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Recent Changes</h3>
                </div>
                <div class="panel-body">
                    <div class="change-history">
                        <div class="change-item">
                            <div class="change-desc">Record created</div>
                            <div class="change-date">@(Model.CreatedDate?.ToString("yyyy-MM-dd") ?? "N/A")</div>
                        </div>
                        <!-- Additional change history would be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Load related party information
            loadRelatedPartyInfo('@Model.RelatedPartyID');

            function loadRelatedPartyInfo(relatedPartyId) {
                if (relatedPartyId) {
                    // Simulate API call to get related party details
                    setTimeout(function () {
                        var sampleData = `
                            <div class="related-party-details">
                                <div class="detail-item">
                                    <label>Registration No:</label>
                                    <span>RP${relatedPartyId.toString().padStart(4, '0')}</span>
                                </div>
                                <div class="detail-item">
                                    <label>Name:</label>
                                    <span>Sample Related Party</span>
                                </div>
                                <div class="detail-item">
                                    <label>Designation:</label>
                                    <span>Staff Member</span>
                                </div>
                                <div class="detail-item">
                                    <label>Basic Salary:</label>
                                    <span>LKR 45,000.00</span>
                                </div>
                                <div class="detail-item">
                                    <label>Status:</label>
                                    <span class="badge badge-success">Active</span>
                                </div>
                            </div>
                        `;
                        $('#relatedPartyInfo').html(sampleData);
                    }, 1000);
                }
            }

            // Form validation
            $('form').on('submit', function (e) {
                var isValid = true;
                var requiredFields = ['RelatedPartyEPF', 'Month', 'Year', 'RelatedPartyID'];

                requiredFields.forEach(function (field) {
                    var value = $('#' + field).val();
                    if (!value) {
                        isValid = false;
                        $('#' + field).addClass('is-invalid');
                    } else {
                        $('#' + field).removeClass('is-invalid');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    alert('Please fill in all required fields.');
                }
            });

            // Auto-save draft functionality
            let autoSaveTimer;
            $('input, select, textarea').on('change input', function () {
                clearTimeout(autoSaveTimer);
                autoSaveTimer = setTimeout(function () {
                    // Implement auto-save logic here if needed
                    console.log('Auto-save triggered');
                }, 2000);
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        background: white;
    }

    .form-info {
        background: #fff3cd;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
        border-left: 4px solid #ffc107;
    }

    .form-section {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        border-left: 4px solid #3498db;
    }

    .record-summary .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

        .record-summary .summary-item:last-child {
            border-bottom: none;
        }

    .related-party-details .detail-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

        .related-party-details .detail-item:last-child {
            border-bottom: none;
        }

    .change-history .change-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #eee;
    }

        .change-history .change-item:last-child {
            border-bottom: none;
        }

    .change-desc {
        color: #666;
    }

    .change-date {
        color: #999;
        font-size: 0.9em;
    }

    .form-actions {
        text-align: center;
        padding: 20px 0;
        border-top: 1px solid #eee;
        margin-top: 20px;
    }

    .btn-lg {
        padding: 12px 25px;
        font-size: 16px;
        margin: 0 5px;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .form-actions .btn-lg {
            display: block;
            width: 100%;
            margin: 10px 0;
        }

        .form-section .row .col-md-3 {
            margin-bottom: 15px;
        }
    }
</style>