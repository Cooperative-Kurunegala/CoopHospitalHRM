@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartySalary>

@{
    ViewBag.Title = "Related Party Salaries";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-money"></i> Related Party Salaries</h1>
            <p class="lead">Manage and view all related party salary records</p>
        </div>
    </div>

    <!-- Quick Actions & Filters -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filters & Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-8">
                            <div class="form-inline">
                                <div class="form-group mr-3">
                                    <label for="monthFilter" class="mr-2">Month:</label>
                                    <select id="monthFilter" class="form-control">
                                        <option value="">All Months</option>
                                        @for (int i = 1; i <= 12; i++)
                                        {
                                            <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group mr-3">
                                    <label for="yearFilter" class="mr-2">Year:</label>
                                    <select id="yearFilter" class="form-control">
                                        <option value="">All Years</option>
                                        @for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year + 1; year++)
                                        {
                                            <option value="@year">@year</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="searchFilter" class="mr-2">Search:</label>
                                    <input type="text" id="searchFilter" class="form-control" placeholder="EPF, Related Party...">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-right">
                            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-lg" })
                            <button id="exportBtn" class="btn btn-info btn-lg ml-2">
                                <i class="fa fa-download"></i> Export
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-table"></i> Salary Records</h3>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="salaryTable">
                            <thead class="thead-dark">
                                <tr>
                                    <th>EPF</th>
                                    <th>Related Party</th>
                                    <th>Month/Year</th>
                                    <th>Worked Days</th>
                                    <th>Basic Salary</th>
                                    <th>Net Salary</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => item.RelatedPartyEPF)</td>
                                            <td>
                                                @if (item.RelatedParty != null)
                                                {
                                                    @Html.DisplayFor(modelItem => item.RelatedParty.RegistrationNumber)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>@Html.DisplayFor(modelItem => item.Month)/@Html.DisplayFor(modelItem => item.Year)</td>
                                            <td>@Html.DisplayFor(modelItem => item.WorkedDays)</td>
                                            <td>
                                                @{
                                                    // Calculate basic salary - you'll need to implement this based on your business logic
                                                    var basicSalary = "Calculated";
                                                }
                                                @basicSalary
                                            </td>
                                            <td>
                                                @{
                                                    // Calculate net salary - you'll need to implement this based on your business logic
                                                    var netSalary = "Calculated";
                                                }
                                                @netSalary
                                            </td>
                                            <td>
                                                @* item.IsPayoutGenerated and item.IsLocked are nullable bool (bool?). Compare to true explicitly. *@
                                                @if (item.IsPayoutGenerated == true)
                                                {
                                                    <span class="badge badge-success">Paid</span>
                                                }
                                                else if (item.IsLocked == true)
                                                {
                                                    <span class="badge badge-warning">Locked</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-info">Draft</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            <i class="fa fa-exclamation-circle fa-3x mb-3"></i>
                                            <h4>No salary records found</h4>
                                            <p>Click "Create New" to add the first salary record.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Summary -->
    @{
        // Compute stats in a code block to avoid inline nullable-bool lambda issues.
        var totalRecords = Model?.Count() ?? 0;
        var paidSalaries = Model?.Count(x => x.IsPayoutGenerated == true) ?? 0;
        var lockedRecords = Model?.Count(x => x.IsLocked == true) ?? 0;
        var draftRecords = Model?.Count(x => x.IsPayoutGenerated != true && x.IsLocked != true) ?? 0;
    }
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bar-chart"></i> Salary Statistics</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters text-center">
                        <div class="col-md-3 stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-file-text-o"></i>
                            </div>
                            <h4>Total Records</h4>
                            <p class="stat-number">@totalRecords</p>
                        </div>
                        <div class="col-md-3 stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-check-circle-o"></i>
                            </div>
                            <h4>Paid Salaries</h4>
                            <p class="stat-number">@paidSalaries</p>
                        </div>
                        <div class="col-md-3 stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-lock"></i>
                            </div>
                            <h4>Locked Records</h4>
                            <p class="stat-number">@lockedRecords</p>
                        </div>
                        <div class="col-md-3 stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-clock-o"></i>
                            </div>
                            <h4>Draft Records</h4>
                            <p class="stat-number">@draftRecords</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize filters
            $('#monthFilter, #yearFilter, #searchFilter').on('change keyup', function () {
                filterTable();
            });

            function filterTable() {
                var month = $('#monthFilter').val();
                var year = $('#yearFilter').val();
                var search = $('#searchFilter').val().toLowerCase();

                $('#salaryTable tbody tr').each(function () {
                    var $row = $(this);
                    var rowMonth = $row.find('td:eq(2)').text().split('/')[0];
                    var rowYear = $row.find('td:eq(2)').text().split('/')[1];
                    var rowText = $row.text().toLowerCase();

                    var showRow = true;

                    if (month && rowMonth != month) showRow = false;
                    if (year && rowYear != year) showRow = false;
                    if (search && rowText.indexOf(search) === -1) showRow = false;

                    $row.toggle(showRow);
                });
            }

            // Export functionality
            $('#exportBtn').click(function () {
                // Implement export logic here
                alert('Export functionality would be implemented here');
            });

            // Enhanced row hover effects
            $('#salaryTable tbody tr').hover(
                function () {
                    $(this).addClass('table-active');
                },
                function () {
                    $(this).removeClass('table-active');
                }
            );
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
        font-size: 16px;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: white;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 20px;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        background-color: #2c3e50;
        color: white;
    }

    .btn-group .btn {
        margin: 0 2px;
    }

    .stat-item {
        padding: 20px 15px;
    }

    .stat-icon {
        font-size: 2.5rem;
        color: #3498db;
        margin-bottom: 10px;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: #2c3e50;
    }

    .badge {
        font-size: 0.8rem;
        padding: 5px 10px;
    }

    .form-control {
        font-size: 14px;
    }

    .btn-lg {
        padding: 10px 20px;
        font-size: 16px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
        }

            .btn-group .btn {
                margin: 2px 0;
                width: 100%;
            }

        .form-inline .form-group {
            margin-bottom: 10px;
            width: 100%;
        }

        .form-inline .form-control {
            width: 100%;
        }
    }
</style>