@model HR_Application_CO_OP_HOS.Models.RelatedPartySalary

@{
    ViewBag.Title = "Delete Salary Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Salary Record</h1>
            <p class="lead">Confirm deletion of salary record</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Confirmation Panel -->
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Delete Confirmation</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-danger">
                        <h4><i class="fa fa-warning"></i> Warning!</h4>
                        <p>You are about to delete this salary record. This action cannot be undone. Please review the record details below before proceeding.</p>
                    </div>

                    <div class="record-preview">
                        <h4>Record to be Deleted:</h4>
                        <div class="preview-sections">
                            <!-- Basic Information -->
                            <div class="preview-section">
                                <h5>Basic Information</h5>
                                <div class="row">
                                    <div class="col-md-4 preview-item">
                                        <label>Record ID:</label>
                                        <span>@Model.ID</span>
                                    </div>
                                    <div class="col-md-4 preview-item">
                                        <label>EPF Number:</label>
                                        <span>@Model.RelatedPartyEPF</span>
                                    </div>
                                    <div class="col-md-4 preview-item">
                                        <label>Period:</label>
                                        <span>@Model.Month/@Model.Year</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Key Details -->
                            <div class="preview-section">
                                <h5>Key Details</h5>
                                <div class="row">
                                    <div class="col-md-3 preview-item">
                                        <label>Worked Days:</label>
                                        <span>@Model.WorkedDays</span>
                                    </div>
                                    <div class="col-md-3 preview-item">
                                        <label>No Pay Days:</label>
                                        <span>@Model.NoPayDays</span>
                                    </div>
                                    <div class="col-md-3 preview-item">
                                        <label>OT Minutes:</label>
                                        <span>@Model.OTMinutes</span>
                                    </div>
                                    <div class="col-md-3 preview-item">
                                        <label>Late Minutes:</label>
                                        <span>@Model.LateMinutes</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Status Information -->
                            <div class="preview-section">
                                <h5>Status Information</h5>
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="status-badge @(Model.IsPayoutGenerated == true ? "badge-success" : "badge-secondary")">
                                            @(Model.IsPayoutGenerated == true ? "Paid" : "Unpaid")
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="status-badge @(Model.IsLocked == true ? "badge-warning" : "badge-secondary")">
                                            @(Model.IsLocked == true ? "Locked" : "Unlocked")
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="status-badge @(Model.IsVerified == true ? "badge-info" : "badge-secondary")">
                                            @(Model.IsVerified == true ? "Verified" : "Unverified")
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="status-badge @(Model.IsAttendanceVerified == true ? "badge-info" : "badge-secondary")">
                                            @(Model.IsAttendanceVerified == true ? "Att. Verified" : "Att. Unverified")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Related Party -->
                            <div class="preview-section">
                                <h5>Related Party</h5>
                                <div class="preview-item">
                                    <label>Registration Number:</label>
                                    <span>@(Model.RelatedParty?.RegistrationNumber ?? "N/A")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        <div class="deletion-warning">
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                <label class="form-check-label" for="confirmDelete">
                                    I understand that this action cannot be undone and I confirm that I want to delete this record.
                                </label>
                            </div>

                            <div class="form-group">
                                <label for="deleteReason">Reason for deletion (optional):</label>
                                <textarea class="form-control" id="deleteReason" name="deleteReason" rows="3" placeholder="Enter reason for deletion..."></textarea>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-danger btn-lg" id="deleteButton" disabled>
                                <i class="fa fa-trash"></i> Confirm Delete
                            </button>
                            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Information -->
        <div class="col-md-4">
            <!-- Impact Analysis -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-circle"></i> Deletion Impact</h3>
                </div>
                <div class="panel-body">
                    <div class="impact-list">
                        <div class="impact-item negative">
                            <i class="fa fa-times-circle"></i>
                            <div>
                                <strong>Permanent Data Loss</strong>
                                <p>This record will be permanently removed from the system</p>
                            </div>
                        </div>
                        <div class="impact-item negative">
                            <i class="fa fa-bar-chart"></i>
                            <div>
                                <strong>Reporting Impact</strong>
                                <p>Historical reports and analytics will be affected</p>
                            </div>
                        </div>
                        <div class="impact-item negative">
                            <i class="fa fa-chain-broken"></i>
                            <div>
                                <strong>Audit Trail</strong>
                                <p>This action will be recorded in the system logs</p>
                            </div>
                        </div>
                        <div class="impact-item warning">
                            <i class="fa fa-money"></i>
                            <div>
                                <strong>Financial Records</strong>
                                <p>If this is a paid record, financial reconciliation may be affected</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Safe Alternatives -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-shield"></i> Safe Alternatives</h3>
                </div>
                <div class="panel-body">
                    <div class="alternative-options">
                        <div class="alternative-item">
                            <i class="fa fa-archive"></i>
                            <div>
                                <strong>Archive Instead</strong>
                                <p>Consider archiving the record instead of deleting</p>
                                <button class="btn btn-outline-info btn-sm mt-2" id="archiveBtn">Learn More</button>
                            </div>
                        </div>
                        <div class="alternative-item">
                            <i class="fa fa-lock"></i>
                            <div>
                                <strong>Mark as Void</strong>
                                <p>Void the record to maintain audit trail</p>
                                <button class="btn btn-outline-info btn-sm mt-2" id="voidBtn">Learn More</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="quick-actions">
                        @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-block mb-2" })
                        @Html.ActionLink("Edit Record", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-block mb-2" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-block" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Enable/disable delete button based on confirmation
            $('#confirmDelete').change(function () {
                $('#deleteButton').prop('disabled', !$(this).is(':checked'));
            });

            // Delete button click handler
            $('#deleteButton').click(function (e) {
                if (!confirm('Are you absolutely sure you want to delete this record? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }

                // Show loading state
                $(this).html('<i class="fa fa-spinner fa-spin"></i> Deleting...').prop('disabled', true);
            });

            // Alternative options
            $('#archiveBtn').click(function () {
                alert('Archiving would maintain the record in the system but mark it as inactive. This preserves data integrity for reporting and audit purposes.');
            });

            $('#voidBtn').click(function () {
                alert('Voiding would invalidate the record while keeping it in the system. This is useful for maintaining complete audit trails.');
            });

            // Form submission validation
            $('form').on('submit', function (e) {
                if (!$('#confirmDelete').is(':checked')) {
                    e.preventDefault();
                    alert('Please confirm deletion by checking the confirmation box.');
                    return false;
                }

                var reason = $('#deleteReason').val();
                if (!reason.trim()) {
                    if (!confirm('You haven\'t provided a reason for deletion. Are you sure you want to continue without a reason?')) {
                        e.preventDefault();
                        return false;
                    }
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        background: white;
    }

    .panel-danger .panel-heading {
        background: #e74c3c !important;
        color: white;
    }

    .alert-danger {
        border-radius: 8px;
        border-left: 4px solid #e74c3c;
    }

    .record-preview {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin: 20px 0;
        border: 1px solid #e9ecef;
    }

    .preview-sections {
        padding: 10px 0;
    }

    .preview-section {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #dee2e6;
    }

        .preview-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

        .preview-section h5 {
            color: #495057;
            font-weight: 600;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e74c3c;
        }

    .preview-item {
        margin-bottom: 10px;
    }

        .preview-item label {
            font-weight: 600;
            color: #6c757d;
            display: block;
            margin-bottom: 3px;
            font-size: 0.9em;
        }

        .preview-item span {
            color: #495057;
            font-weight: 500;
        }

    .status-badge {
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 0.85em;
        font-weight: 600;
        text-align: center;
        display: block;
    }

    .deletion-warning {
        background: #fff3cd;
        padding: 20px;
        border-radius: 8px;
        border-left: 4px solid #ffc107;
        margin: 20px 0;
    }

    .form-check-label {
        font-weight: 600;
        color: #856404;
    }

    .form-actions {
        text-align: center;
        padding: 20px 0;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        margin: 0 10px;
    }

    .impact-list .impact-item {
        display: flex;
        align-items: flex-start;
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

        .impact-list .impact-item:last-child {
            border-bottom: none;
        }

    .impact-item.negative i {
        color: #e74c3c;
    }

    .impact-item.warning i {
        color: #f39c12;
    }

    .impact-item i {
        font-size: 1.5em;
        margin-right: 15px;
        margin-top: 3px;
        flex-shrink: 0;
    }

    .impact-item div {
        flex: 1;
    }

    .impact-item strong {
        display: block;
        margin-bottom: 5px;
    }

    .impact-item p {
        margin: 0;
        color: #6c757d;
        font-size: 0.9em;
    }

    .alternative-options .alternative-item {
        display: flex;
        align-items: flex-start;
        padding: 15px 0;
        border-bottom: 1px solid #eee;
    }

        .alternative-options .alternative-item:last-child {
            border-bottom: none;
        }

    .alternative-item i {
        color: #3498db;
        font-size: 1.5em;
        margin-right: 15px;
        margin-top: 3px;
        flex-shrink: 0;
    }

    .alternative-item div {
        flex: 1;
    }

    .quick-actions .btn {
        margin-bottom: 10px;
        padding: 10px;
    }

    #deleteButton:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .form-actions .btn-lg {
            display: block;
            width: 100%;
            margin: 10px 0;
        }

        .preview-section .row .col-md-3,
        .preview-section .row .col-md-4 {
            margin-bottom: 15px;
        }

        .impact-item,
        .alternative-item {
            flex-direction: column;
            text-align: center;
        }

            .impact-item i,
            .alternative-item i {
                margin-right: 0;
                margin-bottom: 10px;
            }
    }
</style>