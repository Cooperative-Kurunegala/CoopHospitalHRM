﻿@model HR_Application_CO_OP_HOS.Models.DayType

@{
    ViewBag.Title = "Create Day Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Day Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        .header-section {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .content-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            border: none;
        }

        .card-header {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 20px 25px;
            border: none;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .card-body {
            padding: 30px;
        }

        .form-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .control-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .form-control {
            border-radius: 10px;
            border: 2px solid #ecf0f1;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .text-danger {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        .btn-container {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ecf0f1;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-right: 10px;
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover, .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .reference-panel {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #3498db;
        }

        .reference-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .reference-list {
            max-height: 200px;
            overflow-y: auto;
        }

        .reference-item {
            padding: 10px;
            border-bottom: 1px solid #ecf0f1;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .reference-item:hover {
                background: #3498db;
                color: white;
                border-radius: 5px;
            }

            .reference-item:last-child {
                border-bottom: none;
            }

        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
        }

        .alert {
            border-radius: 10px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="header-title"><i class="fa fa-plus-circle"></i> Create New Day Type</h1>
                    <p class="header-subtitle">Add a new day type to the system with associated shift information</p>
                </div>
                <div class="col-md-4 text-end">
                    <a href="@Url.Action("Index")" class="btn btn-light">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="row">
            <div class="col-12">
                <div class="content-card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fa fa-calendar-plus-o"></i> Day Type Information</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-container">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()

                                <!-- Validation Summary -->
                                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                <div class="row">
                                    <!-- Form Fields Column -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.DayTypeName, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.DayTypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter day type name" } })
                                            @Html.ValidationMessageFor(model => model.DayTypeName, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ShiftID, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.ShiftID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter shift ID", type = "number", min = "1" } })
                                            @Html.ValidationMessageFor(model => model.ShiftID, "", new { @class = "text-danger" })
                                            <small class="form-text text-muted">Enter the ID of the associated shift</small>
                                        </div>

                                        <div class="btn-container">
                                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                                <i class="fa fa-save"></i> Create Day Type
                                            </button>
                                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                                <i class="fa fa-times"></i> Cancel
                                            </a>
                                        </div>
                                    </div>

                                    <!-- Reference Data Column -->
                                    <div class="col-md-6">
                                        <div class="reference-panel">
                                            <h5 class="reference-title"><i class="fa fa-info-circle"></i> Available Shifts Reference</h5>
                                            <div class="reference-list" id="shiftsReference">
                                                <div class="text-center text-muted">
                                                    <i class="fa fa-spinner fa-spin"></i> Loading shifts...
                                                </div>
                                            </div>
                                        </div>

                                        <div class="reference-panel mt-3">
                                            <h5 class="reference-title"><i class="fa fa-list"></i> Existing Day Types</h5>
                                            <div class="reference-list" id="existingDayTypes">
                                                @try
                                                {
                                                    var existingTypes = new List<string>();
                                                    // This would typically come from the database
                                                    // For demo, we'll show some common types
                                                    existingTypes.AddRange(new[] { "Weekday", "Weekend", "Holiday", "Special" });

                                                    foreach (var type in existingTypes.Take(5))
                                                    {
                                                        <div class="reference-item">@type</div>
                                                    }
                                                }
                                                catch (Exception)
                                                {
                                                    <div class="text-muted">Unable to load existing day types</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            // Simulate loading shifts data (in real application, this would be an AJAX call)
            setTimeout(function () {
                $('#shiftsReference').html(`
                    <div class="reference-item" onclick="selectShift(1)">Shift 1 - Morning (06:00-14:00)</div>
                    <div class="reference-item" onclick="selectShift(2)">Shift 2 - Evening (14:00-22:00)</div>
                    <div class="reference-item" onclick="selectShift(3)">Shift 3 - Night (22:00-06:00)</div>
                    <div class="reference-item" onclick="selectShift(4)">Shift 4 - Special (Custom Hours)</div>
                `);
            }, 1000);

            // Form submission handling
            $('form').on('submit', function () {
                $('#submitBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Creating...');
            });

            // Input validation
            $('#DayTypeName').on('blur', function () {
                validateField($(this));
            });

            $('#ShiftID').on('blur', function () {
                validateField($(this));
            });

            function validateField(field) {
                if (field.val().trim() === '') {
                    field.addClass('is-invalid').removeClass('is-valid');
                } else {
                    field.addClass('is-valid').removeClass('is-invalid');
                }
            }

            // Error handling
            $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                console.error('AJAX Error:', thrownError);
                alert('An error occurred while processing your request. Please try again.');
                $('#submitBtn').prop('disabled', false).html('<i class="fa fa-save"></i> Create Day Type');
            });
        });

        function selectShift(shiftId) {
            $('#ShiftID').val(shiftId).addClass('is-valid');

            // Highlight the selected shift
            $('#shiftsReference .reference-item').removeClass('selected');
            $(`#shiftsReference .reference-item:nth-child(${shiftId})`).addClass('selected');
        }
    </script>
</body>
</html>