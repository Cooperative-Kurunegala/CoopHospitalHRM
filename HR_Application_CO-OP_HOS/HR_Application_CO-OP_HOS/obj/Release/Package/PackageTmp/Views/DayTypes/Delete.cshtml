﻿@model HR_Application_CO_OP_HOS.Models.DayType

@{
    ViewBag.Title = "Delete Day Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Day Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        .header-section {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .content-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            border: none;
        }

        .card-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 20px 25px;
            border: none;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .card-body {
            padding: 30px;
        }

        .warning-section {
            background: #fdf2f2;
            border: 2px solid #e74c3c;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 25px;
            text-align: center;
        }

        .warning-icon {
            font-size: 4rem;
            color: #e74c3c;
            margin-bottom: 15px;
        }

        .warning-title {
            color: #e74c3c;
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .warning-message {
            color: #7f8c8d;
            font-size: 1.1rem;
            margin-bottom: 0;
        }

        .details-container {
            max-width: 700px;
            margin: 0 auto;
        }

        .details-section {
            margin-bottom: 25px;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #ecf0f1;
        }

        .detail-item {
            margin-bottom: 15px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #e74c3c;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.1rem;
        }

        .impact-section {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .impact-title {
            color: #856404;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .impact-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .impact-list li {
                padding: 8px 0;
                border-bottom: 1px solid #ffeaa7;
            }

                .impact-list li:last-child {
                    border-bottom: none;
                }

                .impact-list li i {
                    color: #f39c12;
                    margin-right: 10px;
                }

        .btn-container {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ecf0f1;
            text-align: center;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 12px 40px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-right: 15px;
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-danger:hover, .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .confirmation-check {
            margin: 20px 0;
            text-align: center;
        }

        .form-check {
            display: inline-flex;
            align-items: center;
            margin-bottom: 15px;
        }

        .form-check-input {
            margin-right: 10px;
            transform: scale(1.2);
        }

        .form-check-label {
            font-weight: 600;
            color: #2c3e50;
        }

        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
        }

        .security-notice {
            background: #d1ecf1;
            border: 1px solid #bee5eb;
            border-radius: 8px;
            padding: 15px;
            margin-top: 20px;
            font-size: 0.9rem;
            color: #0c5460;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="header-title"><i class="fa fa-exclamation-triangle"></i> Delete Day Type</h1>
                    <p class="header-subtitle">Permanently remove a day type from the system</p>
                </div>
                <div class="col-md-4 text-end">
                    <a href="@Url.Action("Index")" class="btn btn-light">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="row">
            <div class="col-12">
                <div class="content-card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fa fa-trash-o"></i> Confirm Deletion</h3>
                    </div>
                    <div class="card-body">
                        <div class="details-container">
                            <!-- Warning Section -->
                            <div class="warning-section">
                                <div class="warning-icon">
                                    <i class="fa fa-exclamation-circle"></i>
                                </div>
                                <h3 class="warning-title">Warning: Irreversible Action</h3>
                                <p class="warning-message">
                                    You are about to permanently delete this day type. This action cannot be undone
                                    and may affect related records in the system.
                                </p>
                            </div>

                            <!-- Day Type Details -->
                            <div class="details-section">
                                <h4 class="section-title"><i class="fa fa-info-circle"></i> Day Type to be Deleted</h4>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="detail-item">
                                            <div class="detail-label">Day Type ID</div>
                                            <div class="detail-value">@Model.ID</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="detail-item">
                                            <div class="detail-label">Day Type Name</div>
                                            <div class="detail-value">@Model.DayTypeName</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="detail-item">
                                            <div class="detail-label">Shift ID</div>
                                            <div class="detail-value">@Model.ShiftID</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="detail-item">
                                            <div class="detail-label">Created Date</div>
                                            <div class="detail-value" id="createdDate">Unknown</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Impact Analysis -->
                            <div class="impact-section">
                                <h5 class="impact-title"><i class="fa fa-exclamation-triangle"></i> Potential Impacts</h5>
                                <ul class="impact-list">
                                    <li><i class="fa fa-calendar"></i> Employee schedules using this day type may be affected</li>
                                    <li><i class="fa fa-users"></i> Shift assignments referencing this day type will need review</li>
                                    <li><i class="fa fa-bar-chart"></i> Historical reports may show inconsistencies</li>
                                    <li><i class="fa fa-cogs"></i> System configurations may require updates</li>
                                </ul>
                            </div>

                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ID)

                                <!-- Confirmation Check -->
                                <div class="confirmation-check">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                        <label class="form-check-label" for="confirmDelete">
                                            I understand that this action is permanent and cannot be undone
                                        </label>
                                    </div>
                                </div>

                                <!-- Security Notice -->
                                <div class="security-notice">
                                    <i class="fa fa-shield"></i>
                                    <strong>Security Notice:</strong> This action is logged for audit purposes.
                                    Please ensure you have proper authorization to perform this deletion.
                                </div>

                                <!-- Action Buttons -->
                                <div class="btn-container">
                                    <button type="submit" class="btn btn-danger" id="deleteBtn" disabled>
                                        <i class="fa fa-trash"></i> Confirm Delete
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="fa fa-times"></i> Cancel
                                    </a>
                                </div>

                                <!-- Loading Spinner -->
                                <div class="loading-spinner" id="loadingSpinner">
                                    <i class="fa fa-spinner fa-spin"></i> Processing deletion...
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Load additional details
            loadAdditionalDetails();

            // Enable/disable delete button based on confirmation
            $('#confirmDelete').on('change', function () {
                $('#deleteBtn').prop('disabled', !this.checked);
            });

            // Form submission handling
            $('form').on('submit', function (e) {
                if (!$('#confirmDelete').is(':checked')) {
                    e.preventDefault();
                    alert('Please confirm that you understand this action is permanent.');
                    return false;
                }

                // Show loading spinner
                $('#loadingSpinner').show();
                $('#deleteBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Deleting...');

                // Additional confirmation
                if (!confirm('Are you absolutely sure you want to delete this day type? This action cannot be undone.')) {
                    e.preventDefault();
                    $('#loadingSpinner').hide();
                    $('#deleteBtn').prop('disabled', false).html('<i class="fa fa-trash"></i> Confirm Delete');
                    return false;
                }
            });

            // Error handling
            $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                console.error('AJAX Error:', thrownError);
                $('#loadingSpinner').hide();
                $('#deleteBtn').prop('disabled', false).html('<i class="fa fa-trash"></i> Confirm Delete');

                alert('An error occurred while processing your request. Please try again.');
            });

            // Keyboard shortcuts
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    window.location.href = '@Url.Action("Index")';
                }
            });
        });

        function loadAdditionalDetails() {
            // Simulate loading additional details
            setTimeout(function () {
                $('#createdDate').text(new Date().toLocaleDateString());
            }, 500);
        }

        // Backup functionality (optional)
        function backupBeforeDelete() {
            if (confirm('Would you like to create a backup before deleting?')) {
                // This would typically trigger a backup process
                console.log('Backup process started...');
                alert('Backup created successfully. You may now proceed with deletion.');
            }
        }

        // Risk assessment
        function assessDeletionRisk() {
            const riskFactors = [
                'Number of dependent records',
                'Active usage in current schedules',
                'Historical data references',
                'System configuration dependencies'
            ];

            let riskScore = 0;
            riskFactors.forEach(factor => {
                // Simulate risk calculation
                riskScore += Math.random() * 25;
            });

            alert(`Deletion Risk Assessment: ${Math.min(100, Math.round(riskScore))}% risk score\n\nPlease review potential impacts carefully.`);
        }

        // Call risk assessment on page load
        setTimeout(assessDeletionRisk, 1000);
    </script>
</body>
</html>