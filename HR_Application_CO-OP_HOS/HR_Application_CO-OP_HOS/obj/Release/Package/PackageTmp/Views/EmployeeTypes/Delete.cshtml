﻿@model HR_Application_CO_OP_HOS.Models.EmployeeType

@{
    ViewBag.Title = "Delete Employee Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container dashboard-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">DELETE EMPLOYEE TYPE</h1>
            <p class="hospital-subtitle">Hospital Human Resources System</p>
            <div class="admin-info">
                <span class="admin-welcome">Confirm Deletion</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <div class="action-panel">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <span>📋 Back to List</span>
        </a>
    </div>

    <div class="alert-section">
        <div class="alert alert-danger">
            <h3>⚠️ ARE YOU SURE YOU WANT TO DELETE THIS?</h3>
            <p>This action cannot be undone. Please confirm that you want to delete this employee type.</p>
        </div>
    </div>

    <div class="details-section">
        <div class="section-header">
            <h2>🗑️ CONFIRM DELETION</h2>
        </div>

        <div class="details-container">
            <div class="detail-card">
                <div class="detail-header">
                    <h3>📋 Employee Type to Delete</h3>
                </div>
                <div class="detail-content">
                    <div class="detail-row">
                        <div class="detail-label">Type Name:</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.TypeName)</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label">Description:</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.Description)</div>
                    </div>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">
                        <span>🗑️ Confirm Delete</span>
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <span>❌ Cancel</span>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .fullscreen-container {
        margin: 0;
        padding: 20px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #006400 0%, #228B22 100%);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .hospital-name {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .hospital-subtitle {
        font-size: 1.3rem;
        opacity: 0.9;
        margin-bottom: 20px;
    }

    .admin-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.1rem;
        background: rgba(255,255,255,0.2);
        padding: 15px;
        border-radius: 10px;
    }

    .action-panel {
        margin-bottom: 30px;
    }

    .btn {
        padding: 12px 25px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.3s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-danger {
        background: #dc3545;
        color: white;
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .alert-section {
        margin-bottom: 30px;
    }

    .alert {
        padding: 20px;
        border-radius: 10px;
        border-left: 5px solid;
    }

    .alert-danger {
        background-color: #f8d7da;
        border-color: #dc3545;
        color: #721c24;
    }

    .details-section {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .section-header {
        background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
        color: white;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 25px;
    }

        .section-header h2 {
            margin: 0;
            font-size: 1.6rem;
        }

    .details-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .detail-card {
        border: 2px solid #dc3545;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .detail-header {
        background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
        color: white;
        padding: 15px 20px;
    }

        .detail-header h3 {
            margin: 0;
            font-size: 1.4rem;
        }

    .detail-content {
        padding: 20px;
    }

    .detail-row {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #eee;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: bold;
        color: #dc3545;
        width: 200px;
        font-size: 1.1rem;
    }

    .detail-value {
        flex: 1;
        font-size: 1.1rem;
        color: #333;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 2px solid #eee;
    }

    @@media (max-width: 768px) {
        .hospital-name {
            font-size: 2rem;
        }

        .hospital-subtitle {
            font-size: 1.1rem;
        }

        .admin-info {
            flex-direction: column;
            gap: 10px;
        }

        .form-actions {
            flex-direction: column;
        }

        .detail-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .detail-label {
            width: 100%;
            margin-bottom: 5px;
        }
    }
</style>