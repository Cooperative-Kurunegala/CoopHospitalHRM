@model HR_Application_CO_OP_HOS.Models.RelatedParty

@{
    ViewBag.Title = "Delete Related Party";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Related Party</h1>
            <p class="lead">Remove related party from the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                    <div class="panel-tools">
                        <span class="badge badge-danger">ID: @Model.ID</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading"><i class="fa fa-warning"></i> Warning!</h4>
                        <p>You are about to delete the following related party. This action cannot be undone.</p>
                        <hr>
                        <p class="mb-0">Please review the information below before confirming deletion.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="deletion-section">
                                <h4><i class="fa fa-user"></i> Related Party to be Deleted</h4>
                                <div class="deletion-summary">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <dl class="dl-horizontal">
                                                <dt>@Html.DisplayNameFor(model => model.RegistrationNumber)</dt>
                                                <dd>@Html.DisplayFor(model => model.RegistrationNumber)</dd>

                                                <dt>@Html.DisplayNameFor(model => model.RelatedPartyName)</dt>
                                                <dd>@Html.DisplayFor(model => model.RelatedPartyName)</dd>

                                                <dt>@Html.DisplayNameFor(model => model.RelatedPartyType)</dt>
                                                <dd>
                                                    @if (Model.RelatedPartyType != null)
                                                    {
                                                        <span class="badge badge-info">@Model.RelatedPartyType.RelatedPartyTypeName</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Not Set</span>
                                                    }
                                                </dd>
                                            </dl>
                                        </div>
                                        <div class="col-md-6">
                                            <dl class="dl-horizontal">
                                                <dt>@Html.DisplayNameFor(model => model.Designation)</dt>
                                                <dd>
                                                    @if (!string.IsNullOrEmpty(Model.Designation))
                                                    {
                                                        @Html.DisplayFor(model => model.Designation)
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Not Set</span>
                                                    }
                                                </dd>

                                                <dt>@Html.DisplayNameFor(model => model.CompanyName)</dt>
                                                <dd>
                                                    @if (!string.IsNullOrEmpty(Model.CompanyName))
                                                    {
                                                        @Html.DisplayFor(model => model.CompanyName)
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Not Set</span>
                                                    }
                                                </dd>

                                                <dt>Status</dt>
                                                <dd>
                                                    @if (Model.IsActive == true)
                                                    {
                                                        <span class="badge badge-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger">Inactive</span>
                                                    }
                                                    @if (Model.ISresigned == true)
                                                    {
                                                        <span class="badge badge-warning ml-2">Resigned</span>
                                                    }
                                                </dd>
                                            </dl>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="impact-section">
                                <h4><i class="fa fa-exclamation-circle"></i> Potential Impact</h4>
                                <ul class="impact-list">
                                    <li><i class="fa fa-times text-danger"></i> All associated records will be affected</li>
                                    <li><i class="fa fa-times text-danger"></i> This action cannot be reversed</li>
                                    <li><i class="fa fa-times text-danger"></i> System references may need updating</li>
                                    <li><i class="fa fa-times text-danger"></i> Historical data will be preserved but marked as deleted</li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="confirmation-panel">
                                <h4><i class="fa fa-check-circle"></i> Confirmation Required</h4>

                                <div class="verification-step">
                                    <h5>Step 1: Verify Information</h5>
                                    <p>Ensure this is the correct record to delete.</p>
                                    <div class="verification-info">
                                        <p><strong>ID:</strong> @Model.ID</p>
                                        <p><strong>Name:</strong> @Model.RelatedPartyName</p>
                                        <p><strong>Registration:</strong> @Model.RegistrationNumber</p>
                                        <p><strong>Created:</strong> @(Model.RegisteredDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                                    </div>
                                </div>

                                <div class="verification-step">
                                    <h5>Step 2: Understand Consequences</h5>
                                    <p>Deleting this record will:</p>
                                    <ul>
                                        <li>Remove from active lists</li>
                                        <li>Affect related transactions</li>
                                        <li>Require system updates</li>
                                        <li>Be permanently removed from searches</li>
                                    </ul>
                                </div>

                                <div class="verification-step">
                                    <h5>Step 3: Confirm Action</h5>
                                    <p>Type "DELETE" to confirm:</p>
                                    <input type="text" id="confirmationInput" class="form-control" placeholder="Type DELETE here">
                                    <small class="form-text text-muted">This is case-sensitive</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="action-buttons text-center mt-4">
                            <button type="submit" id="deleteButton" class="btn btn-danger btn-lg" disabled>
                                <i class="fa fa-trash"></i> Confirm Delete
                            </button>
                            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#confirmationInput').on('keyup', function () {
                if ($(this).val() === 'DELETE') {
                    $('#deleteButton').prop('disabled', false).removeClass('btn-secondary').addClass('btn-danger');
                } else {
                    $('#deleteButton').prop('disabled', true).removeClass('btn-danger').addClass('btn-secondary');
                }
            });

            $('#deleteButton').click(function (e) {
                if (!confirm('Are you absolutely sure you want to delete this related party? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }

                $(this).prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Deleting...');

                // Add a small delay to show the loading state
                setTimeout(function () {
                    $('form').submit();
                }, 1000);
            });

            // Prevent form submission on enter key in confirmation input
            $('#confirmationInput').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#deleteButton').click();
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
        font-size: 16px;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.3rem;
        opacity: 0.9;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
    }

    .panel-danger {
        border-left: 5px solid #e74c3c;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
        background-color: #e74c3c !important;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .panel-title {
        font-size: 1.3rem;
        margin: 0;
    }

        .panel-title i {
            margin-right: 10px;
        }

    .panel-tools {
        display: flex;
        align-items: center;
    }

    .panel-body {
        padding: 30px;
    }

    .alert {
        border-radius: 8px;
        border: none;
        margin-bottom: 30px;
    }

    .deletion-section {
        margin-bottom: 30px;
    }

        .deletion-section h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

            .deletion-section h4 i {
                margin-right: 10px;
                color: #e74c3c;
            }

    .deletion-summary {
        background: #fff;
        border: 2px solid #e74c3c;
        border-radius: 8px;
        padding: 20px;
    }

    .dl-horizontal {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 10px 15px;
        margin-bottom: 0;
    }

        .dl-horizontal dt {
            font-weight: 600;
            color: #2c3e50;
            text-align: left;
        }

        .dl-horizontal dd {
            margin-bottom: 10px;
            color: #6c757d;
        }

    .impact-section {
        margin-bottom: 30px;
    }

        .impact-section h4 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-weight: 600;
        }

            .impact-section h4 i {
                margin-right: 10px;
                color: #e74c3c;
            }

    .impact-list {
        list-style: none;
        padding: 0;
    }

        .impact-list li {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
            display: flex;
            align-items: center;
        }

            .impact-list li:last-child {
                border-bottom: none;
            }

        .impact-list i {
            margin-right: 10px;
            font-size: 1.1rem;
            min-width: 20px;
        }

    .confirmation-panel {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        border-left: 4px solid #e74c3c;
    }

        .confirmation-panel h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

    .verification-step {
        margin-bottom: 20px;
        padding: 15px;
        background: white;
        border-radius: 6px;
        border: 1px solid #e9ecef;
    }

        .verification-step h5 {
            color: #e74c3c;
            margin-bottom: 10px;
            font-weight: 600;
            font-size: 1rem;
        }

        .verification-step p {
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .verification-step ul {
            font-size: 0.9rem;
            padding-left: 20px;
            margin-bottom: 0;
        }

    .verification-info {
        background: #f8f9fa;
        padding: 10px;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .form-control {
        border-radius: 6px;
        border: 1px solid #ddd;
        padding: 10px 12px;
        font-size: 1rem;
        margin-bottom: 5px;
    }

    .badge {
        font-size: 0.85rem;
        padding: 6px 12px;
    }

    .action-buttons {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    .btn-lg {
        padding: 12px 25px;
        font-size: 1.1rem;
        border-radius: 6px;
        margin: 0 5px;
        transition: all 0.3s ease;
    }

        .btn-lg:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .text-muted {
        color: #6c757d !important;
        font-style: italic;
    }

    .form-text {
        font-size: 0.8rem;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 8px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.1rem;
        }

        .panel-body {
            padding: 20px;
        }

        .dl-horizontal {
            grid-template-columns: 1fr;
            gap: 5px;
        }

        .action-buttons .btn {
            display: block;
            width: 100%;
            margin-bottom: 10px;
        }

        .panel-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .panel-tools {
            margin-top: 10px;
        }

        .confirmation-panel {
            margin-top: 20px;
        }
    }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">