@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedParty>

@{
    ViewBag.Title = "Related Parties Management";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-users"></i> Related Parties Management</h1>
            <p class="lead">Manage all related parties in the system</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-primary quick-actions-panel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            <a href="@Url.Action("Create")" class="btn btn-success btn-block btn-lg">
                                <i class="fa fa-plus"></i> Create New
                            </a>
                        </div>
                        <div class="col-md-3">
                            <button id="exportBtn" class="btn btn-info btn-block btn-lg">
                                <i class="fa fa-download"></i> Export Data
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button id="filterBtn" class="btn btn-warning btn-block btn-lg">
                                <i class="fa fa-filter"></i> Show Filters
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button id="refreshBtn" class="btn btn-primary btn-block btn-lg">
                                <i class="fa fa-refresh"></i> Refresh
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="row no-gutters" id="filtersSection" style="display: none;">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filters</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Search</label>
                                <input type="text" id="searchInput" class="form-control form-control-lg" placeholder="Search related parties...">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Status</label>
                                <select id="statusFilter" class="form-control form-control-lg">
                                    <option value="">All Status</option>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Designation</label>
                                <select id="designationFilter" class="form-control form-control-lg">
                                    <option value="">All Designations</option>
                                    @if (ViewBag.DesignationID != null)
                                    {
                                        foreach (var item in ViewBag.DesignationID as SelectList)
                                        {
                                            <option value="@item.Text">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <button id="applyFilters" class="btn btn-primary btn-block btn-lg">Apply Filters</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-table"></i> Related Parties List</h3>
                    <div class="panel-tools">
                        <span class="badge badge-primary" id="recordCount">@Model.Count() Records</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="relatedPartiesTable">
                            <thead>
                                <tr>
                                    <th>Registration No</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Designation</th>
                                    <th>Company</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr data-registration="@item.RegistrationNumber" data-name="@item.RelatedPartyName" data-designation="@item.Designation" data-status="@item.IsActive">
                                            <td>@Html.DisplayFor(modelItem => item.RegistrationNumber)</td>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.RelatedPartyName)</strong>
                                                @if (!string.IsNullOrEmpty(item.RelatedPartyEmail))
                                                {
                                                    <br /><small class="text-muted">@item.RelatedPartyEmail</small>
                                                }
                                            </td>
                                            <td>
                                                @if (item.RelatedPartyType != null)
                                                {
                                                    <span class="badge badge-info">@item.RelatedPartyType.RelatedPartyTypeName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Designation))
                                                {
                                                    @Html.DisplayFor(modelItem => item.Designation)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.CompanyName))
                                                {
                                                    @Html.DisplayFor(modelItem => item.CompanyName)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsActive == true)
                                                {
                                                    <span class="badge badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">Inactive</span>
                                                }
                                                @if (item.ISresigned == true)
                                                {
                                                    <br /><span class="badge badge-warning">Resigned</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("View", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            <i class="fa fa-exclamation-circle fa-3x mb-3"></i>
                                            <h4>No Related Parties Found</h4>
                                            <p>Click "Create New" to add your first related party.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Toggle filters
            $('#filterBtn').click(function () {
                $('#filtersSection').slideToggle();
            });

            // Apply filters
            $('#applyFilters').click(function () {
                applyTableFilters();
            });

            // Refresh data
            $('#refreshBtn').click(function () {
                location.reload();
            });

            // Export functionality
            $('#exportBtn').click(function () {
                exportToExcel();
            });

            // Search functionality
            $('#searchInput').on('keyup', function () {
                applyTableFilters();
            });

            // Filter change events
            $('#statusFilter, #designationFilter').change(function () {
                applyTableFilters();
            });

            function applyTableFilters() {
                var searchText = $('#searchInput').val().toLowerCase();
                var statusFilter = $('#statusFilter').val();
                var designationFilter = $('#designationFilter').val();

                var visibleCount = 0;

                $('#relatedPartiesTable tbody tr').each(function () {
                    var $row = $(this);
                    var registration = $row.data('registration')?.toString().toLowerCase() || '';
                    var name = $row.data('name')?.toString().toLowerCase() || '';
                    var designation = $row.data('designation')?.toString() || '';
                    var status = $row.data('status')?.toString();

                    var showRow = true;

                    // Search filter
                    if (searchText && !registration.includes(searchText) && !name.includes(searchText)) {
                        showRow = false;
                    }

                    // Status filter
                    if (statusFilter && status !== statusFilter) {
                        showRow = false;
                    }

                    // Designation filter
                    if (designationFilter && designation !== designationFilter) {
                        showRow = false;
                    }

                    if (showRow) {
                        $row.show();
                        visibleCount++;
                    } else {
                        $row.hide();
                    }
                });

                // Update record count
                $('#recordCount').text(visibleCount + ' Records');

                // Show no results message if needed
                if (visibleCount === 0) {
                    if ($('#noResultsRow').length === 0) {
                        $('#relatedPartiesTable tbody').append(
                            '<tr id="noResultsRow"><td colspan="7" class="text-center text-muted py-4">' +
                            '<i class="fa fa-search fa-3x mb-3"></i><h4>No matching records found</h4>' +
                            '<p>Try adjusting your search or filters</p></td></tr>'
                        );
                    }
                } else {
                    $('#noResultsRow').remove();
                }
            }

            function exportToExcel() {
                // Simple CSV export implementation
                var csv = [];
                var headers = [];

                // Get headers
                $('#relatedPartiesTable thead th').each(function () {
                    headers.push($(this).text().trim());
                });
                csv.push(headers.join(','));

                // Get data
                $('#relatedPartiesTable tbody tr:visible').each(function () {
                    var row = [];
                    $(this).find('td').each(function () {
                        var text = $(this).text().trim().replace(/,/g, ';');
                        row.push(text);
                    });
                    csv.push(row.join(','));
                });

                // Download
                var csvContent = "data:text/csv;charset=utf-8," + csv.join('\n');
                var encodedUri = encodeURI(csvContent);
                var link = document.createElement("a");
                link.setAttribute("href", encodedUri);
                link.setAttribute("download", "related_parties.csv");
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
        font-size: 16px;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.3rem;
        opacity: 0.9;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 8px;
            padding-left: 8px;
        }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .panel-title {
        font-size: 1.2rem;
        margin: 0;
    }

        .panel-title i {
            margin-right: 10px;
        }

    .panel-tools {
        display: flex;
        align-items: center;
    }

    .panel-body {
        padding: 20px;
    }

    .quick-actions-panel {
        border-left: 5px solid #3498db;
    }

    .btn-lg {
        padding: 12px 20px;
        font-size: 1.1rem;
        border-radius: 8px;
    }

    .table th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
        font-weight: 600;
        padding: 15px 12px;
    }

    .table td {
        padding: 12px;
        vertical-align: middle;
    }

    .badge {
        font-size: 0.85rem;
        padding: 6px 12px;
    }

    .btn-sm {
        padding: 6px 12px;
        margin: 2px;
        font-size: 0.85rem;
    }

    .form-control-lg {
        padding: 12px 16px;
        font-size: 1rem;
    }

    .btn-group .btn-sm {
        margin: 1px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 8px;
            font-size: 14px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.1rem;
        }

        .btn-lg {
            font-size: 1rem;
            padding: 10px 15px;
        }

        .table-responsive {
            font-size: 0.9rem;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
        }

            .btn-group .btn-sm {
                margin: 1px 0;
                text-align: center;
            }

        .panel-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .panel-tools {
            margin-top: 10px;
        }
    }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">