@model HR_Application_CO_OP_HOS.Models.RelatedParty

@{
    ViewBag.Title = "Related Party Details";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-user"></i> Related Party Details</h1>
            <p class="lead">Complete information for @Model.RelatedPartyName</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Related Party Information</h3>
                    <div class="panel-tools">
                        <span class="badge badge-primary">ID: @Model.ID</span>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="details-section">
                                <h4><i class="fa fa-id-card"></i> Basic Information</h4>
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="dl-horizontal">
                                            <dt>@Html.DisplayNameFor(model => model.RegistrationNumber)</dt>
                                            <dd>@Html.DisplayFor(model => model.RegistrationNumber)</dd>

                                            <dt>@Html.DisplayNameFor(model => model.RelatedPartyName)</dt>
                                            <dd>@Html.DisplayFor(model => model.RelatedPartyName)</dd>

                                            <dt>@Html.DisplayNameFor(model => model.RelatedPartyType)</dt>
                                            <dd>
                                                @if (Model.RelatedPartyType != null)
                                                {
                                                    <span class="badge badge-info">@Model.RelatedPartyType.RelatedPartyTypeName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="dl-horizontal">
                                            <dt>@Html.DisplayNameFor(model => model.Designation)</dt>
                                            <dd>
                                                @if (!string.IsNullOrEmpty(Model.Designation))
                                                {
                                                    @Html.DisplayFor(model => model.Designation)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </dd>

                                            <dt>@Html.DisplayNameFor(model => model.CompanyName)</dt>
                                            <dd>
                                                @if (!string.IsNullOrEmpty(Model.CompanyName))
                                                {
                                                    @Html.DisplayFor(model => model.CompanyName)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </dd>

                                            <dt>Status</dt>
                                            <dd>
                                                @if (Model.IsActive == true)
                                                {
                                                    <span class="badge badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">Inactive</span>
                                                }
                                                @if (Model.ISresigned == true)
                                                {
                                                    <span class="badge badge-warning ml-2">Resigned</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>

                            <div class="details-section">
                                <h4><i class="fa fa-address-card"></i> Contact Information</h4>
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="dl-horizontal">
                                            <dt>@Html.DisplayNameFor(model => model.RelatedPartyEmail)</dt>
                                            <dd>
                                                @if (!string.IsNullOrEmpty(Model.RelatedPartyEmail))
                                                {
                                                    <a href="mailto:@Model.RelatedPartyEmail">@Model.RelatedPartyEmail</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </dd>

                                            <dt>@Html.DisplayNameFor(model => model.TelephoneNumberList)</dt>
                                            <dd>
                                                @if (!string.IsNullOrEmpty(Model.TelephoneNumberList))
                                                {
                                                    @Html.DisplayFor(model => model.TelephoneNumberList)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="dl-horizontal">
                                            <dt>@Html.DisplayNameFor(model => model.MobileNoList)</dt>
                                            <dd>
                                                @if (!string.IsNullOrEmpty(Model.MobileNoList))
                                                {
                                                    @Html.DisplayFor(model => model.MobileNoList)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </dd>

                                            <dt>@Html.DisplayNameFor(model => model.RelatedPartyAddress)</dt>
                                            <dd>
                                                @if (!string.IsNullOrEmpty(Model.RelatedPartyAddress))
                                                {
                                                    @Html.DisplayFor(model => model.RelatedPartyAddress)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>

                            <div class="details-section">
                                <h4><i class="fa fa-calendar"></i> Employment Information</h4>
                                <div class="row">
                                    <div class="col-md-6">
                                        <dl class="dl-horizontal">
                                            <dt>@Html.DisplayNameFor(model => model.DateofJoin)</dt>
                                            <dd>@Html.DisplayFor(model => model.DateofJoin)</dd>

                                            <dt>@Html.DisplayNameFor(model => model.RegisteredDate)</dt>
                                            <dd>@Html.DisplayFor(model => model.RegisteredDate)</dd>
                                        </dl>
                                    </div>
                                    <div class="col-md-6">
                                        <dl class="dl-horizontal">
                                            <dt>@Html.DisplayNameFor(model => model.DateofResignation)</dt>
                                            <dd>
                                                @if (Model.DateofResignation.HasValue)
                                                {
                                                    @Html.DisplayFor(model => model.DateofResignation)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </dd>

                                            <dt>@Html.DisplayNameFor(model => model.IsDivisionHead)</dt>
                                            <dd>
                                                @if (Model.IsDivisionHead == true)
                                                {
                                                    <span class="badge badge-primary">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">No</span>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="summary-panel">
                                <h4><i class="fa fa-line-chart"></i> Quick Summary</h4>

                                <div class="summary-item">
                                    <h5>Basic Information</h5>
                                    <p><strong>ID:</strong> @Model.ID</p>
                                    <p><strong>Registration:</strong> @Model.RegistrationNumber</p>
                                    <p><strong>Created:</strong> @(Model.RegisteredDate?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                                </div>

                                <div class="summary-item">
                                    <h5>System Information</h5>
                                    <p>
                                        <strong>Username:</strong>
                                        @if (!string.IsNullOrEmpty(Model.UserName))
                                        {
                                            @Model.UserName
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                    <p>
                                        <strong>Location ID:</strong>
                                        @if (Model.LocationID.HasValue)
                                        {
                                            <span>@Model.LocationID</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                </div>

                                <div class="summary-item">
                                    <h5>Financial Information</h5>
                                    <p>
                                        <strong>Basic Salary:</strong>
                                        @if (Model.BasicSalary.HasValue)
                                        {
                                            @Model.BasicSalary.Value.ToString("C")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                    <p>
                                        <strong>Opening Balance:</strong>
                                        @if (Model.OpeningBalance.HasValue)
                                        {
                                            @Model.OpeningBalance.Value.ToString("C")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                </div>

                                <div class="summary-item">
                                    <h5>Additional Details</h5>
                                    <p>
                                        <strong>Gender:</strong>
                                        @if (Model.Gender.HasValue)
                                        {
                                            @(Model.Gender == 1 ? "Male" : "Female")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                    <p>
                                        <strong>Date of Birth:</strong>
                                        @if (Model.DateOfBirth.HasValue)
                                        {
                                            @Model.DateOfBirth.Value.ToString("yyyy-MM-dd")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="action-buttons text-center mt-4">
                        @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-lg" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                        @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-lg" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
        font-size: 16px;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.3rem;
        opacity: 0.9;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
    }

    .panel-info {
        border-left: 5px solid #3498db;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
        background-color: #3498db !important;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .panel-title {
        font-size: 1.3rem;
        margin: 0;
    }

        .panel-title i {
            margin-right: 10px;
        }

    .panel-tools {
        display: flex;
        align-items: center;
    }

    .panel-body {
        padding: 30px;
    }

    .details-section {
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }

        .details-section h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

            .details-section h4 i {
                margin-right: 10px;
                color: #3498db;
            }

    .dl-horizontal {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 10px 15px;
        margin-bottom: 0;
    }

        .dl-horizontal dt {
            font-weight: 600;
            color: #2c3e50;
            text-align: left;
        }

        .dl-horizontal dd {
            margin-bottom: 10px;
            color: #6c757d;
        }

    .summary-panel {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        border-left: 4px solid #27ae60;
    }

        .summary-panel h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

    .summary-item {
        margin-bottom: 20px;
        padding: 15px;
        background: white;
        border-radius: 6px;
        border: 1px solid #e9ecef;
    }

        .summary-item h5 {
            color: #27ae60;
            margin-bottom: 10px;
            font-weight: 600;
            border-bottom: 1px solid #eee;
            padding-bottom: 5px;
        }

        .summary-item p {
            margin-bottom: 5px;
            font-size: 0.95rem;
        }

    .badge {
        font-size: 0.85rem;
        padding: 6px 12px;
    }

    .action-buttons {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    .btn-lg {
        padding: 12px 25px;
        font-size: 1.1rem;
        border-radius: 6px;
        margin: 0 5px;
    }

    .text-muted {
        color: #6c757d !important;
        font-style: italic;
    }

    a[href^="mailto:"] {
        color: #3498db;
        text-decoration: none;
    }

        a[href^="mailto:"]:hover {
            text-decoration: underline;
        }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 8px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.1rem;
        }

        .panel-body {
            padding: 20px;
        }

        .dl-horizontal {
            grid-template-columns: 1fr;
            gap: 5px;
        }

        .action-buttons .btn {
            display: block;
            width: 100%;
            margin-bottom: 10px;
        }

        .panel-heading {
            flex-direction: column;
            align-items: flex-start;
        }

        .panel-tools {
            margin-top: 10px;
        }
    }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">