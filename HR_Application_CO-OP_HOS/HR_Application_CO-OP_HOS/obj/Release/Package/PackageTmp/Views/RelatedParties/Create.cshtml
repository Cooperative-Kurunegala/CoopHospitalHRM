@model HR_Application_CO_OP_HOS.Models.RelatedParty

@{
    ViewBag.Title = "Create Related Party";

    // Get dropdown data from ViewBag
    var designations = ViewBag.DesignationID as SelectList ?? new SelectList(new List<object>());
    var divisions = ViewBag.DivisionMasterID as SelectList ?? new SelectList(new List<object>());
    var companies = ViewBag.CompanyID as SelectList ?? new SelectList(new List<object>());
    var partyTypes = ViewBag.RelatedPartyTypeID as SelectList ?? new SelectList(new List<object>());
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-user-plus"></i> Create New Related Party</h1>
            <p class="lead">Add a new related party to the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Related Party Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-section">
                                    <h4><i class="fa fa-id-card"></i> Basic Information</h4>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.RegistrationNumber, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.RegistrationNumber, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter registration number" } })
                                                @Html.ValidationMessageFor(model => model.RegistrationNumber, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.RelatedPartyName, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.RelatedPartyName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter full name" } })
                                                @Html.ValidationMessageFor(model => model.RelatedPartyName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.RelatedPartyTypeID, "Related Party Type", htmlAttributes: new { @class = "control-label" })
                                                @Html.DropDownList("RelatedPartyTypeID", partyTypes, "Select Type", htmlAttributes: new { @class = "form-control", id = "RelatedPartyTypeID" })
                                                @Html.ValidationMessageFor(model => model.RelatedPartyTypeID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.DesignationID, htmlAttributes: new { @class = "control-label" })
                                                @Html.DropDownList("DesignationID", designations, "Select Designation", htmlAttributes: new { @class = "form-control", id = "DesignationID" })
                                                @Html.ValidationMessageFor(model => model.DesignationID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.DivisionMasterID, htmlAttributes: new { @class = "control-label" })
                                                @Html.DropDownList("DivisionMasterID", divisions, "Select Division", htmlAttributes: new { @class = "form-control", id = "DivisionMasterID" })
                                                @Html.ValidationMessageFor(model => model.DivisionMasterID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.CompanyID, htmlAttributes: new { @class = "control-label" })
                                                @Html.DropDownList("CompanyID", companies, "Select Company", htmlAttributes: new { @class = "form-control", id = "CompanyID" })
                                                @Html.ValidationMessageFor(model => model.CompanyID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h4><i class="fa fa-address-card"></i> Contact Information</h4>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.RelatedPartyEmail, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.RelatedPartyEmail, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter email address" } })
                                                @Html.ValidationMessageFor(model => model.RelatedPartyEmail, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.MobileNoList, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.MobileNoList, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter mobile numbers" } })
                                                @Html.ValidationMessageFor(model => model.MobileNoList, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RelatedPartyAddress, htmlAttributes: new { @class = "control-label" })
                                        @Html.TextAreaFor(model => model.RelatedPartyAddress, new { @class = "form-control", rows = "3", placeholder = "Enter full address" })
                                        @Html.ValidationMessageFor(model => model.RelatedPartyAddress, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h4><i class="fa fa-cog"></i> Additional Settings</h4>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <div class="checkbox">
                                                    <label>
                                                        @Html.EditorFor(model => model.IsActive)
                                                        @Html.DisplayNameFor(model => model.IsActive)
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <div class="checkbox">
                                                    <label>
                                                        @Html.EditorFor(model => model.IsDivisionHead)
                                                        @Html.DisplayNameFor(model => model.IsDivisionHead)
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="info-panel">
                                    <h4><i class="fa fa-info-circle"></i> Reference Information</h4>

                                    <div id="designationInfo" class="reference-info" style="display: none;">
                                        <h5>Selected Designation</h5>
                                        <div id="designationContent" class="reference-content">
                                            <!-- Will be populated by JavaScript -->
                                        </div>
                                    </div>

                                    <div id="divisionInfo" class="reference-info" style="display: none;">
                                        <h5>Selected Division</h5>
                                        <div id="divisionContent" class="reference-content">
                                            <!-- Will be populated by JavaScript -->
                                        </div>
                                    </div>

                                    <div id="companyInfo" class="reference-info" style="display: none;">
                                        <h5>Selected Company</h5>
                                        <div id="companyContent" class="reference-content">
                                            <!-- Will be populated by JavaScript -->
                                        </div>
                                    </div>

                                    <div id="typeInfo" class="reference-info" style="display: none;">
                                        <h5>Selected Party Type</h5>
                                        <div id="typeContent" class="reference-content">
                                            <!-- Will be populated by JavaScript -->
                                        </div>
                                    </div>

                                    <div class="help-text">
                                        <p><strong>Tip:</strong> Select from dropdowns to see information about each option.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fa fa-save"></i> Create Related Party
                            </button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Store dropdown options data
            var designationsData = {
                @foreach (var item in designations)
                {
                    if (item.Value != null)
                    {
                        @Html.Raw($"'{item.Value}': '{item.Text}',")
                    }
                }
            };

            var divisionsData = {
                @foreach (var item in divisions)
                {
                    if (item.Value != null)
                    {
                        @Html.Raw($"'{item.Value}': '{item.Text}',")
                    }
                }
            };

            var companiesData = {
                @foreach (var item in companies)
                {
                    if (item.Value != null)
                    {
                        @Html.Raw($"'{item.Value}': '{item.Text}',")
                    }
                }
            };

            var partyTypesData = {
                @foreach (var item in partyTypes)
                {
                    if (item.Value != null)
                    {
                        @Html.Raw($"'{item.Value}': '{item.Text}',")
                    }
                }
            };

            // Load reference data when dropdowns change
            $('#DesignationID').change(function () {
                var selectedId = $(this).val();
                var selectedText = designationsData[selectedId] || 'Unknown Designation';

                if (selectedId) {
                    $('#designationContent').html(`
                        <p><strong>Name:</strong> ${selectedText}</p>
                        <p><strong>ID:</strong> ${selectedId}</p>
                        <p class="text-success"><i class="fa fa-check"></i> Ready to use</p>
                    `);
                    $('#designationInfo').show();
                } else {
                    $('#designationInfo').hide();
                }
            });

            $('#DivisionMasterID').change(function () {
                var selectedId = $(this).val();
                var selectedText = divisionsData[selectedId] || 'Unknown Division';

                if (selectedId) {
                    $('#divisionContent').html(`
                        <p><strong>Name:</strong> ${selectedText}</p>
                        <p><strong>ID:</strong> ${selectedId}</p>
                        <p class="text-success"><i class="fa fa-check"></i> Ready to use</p>
                    `);
                    $('#divisionInfo').show();
                } else {
                    $('#divisionInfo').hide();
                }
            });

            $('#CompanyID').change(function () {
                var selectedId = $(this).val();
                var selectedText = companiesData[selectedId] || 'Unknown Company';

                if (selectedId) {
                    $('#companyContent').html(`
                        <p><strong>Name:</strong> ${selectedText}</p>
                        <p><strong>ID:</strong> ${selectedId}</p>
                        <p class="text-success"><i class="fa fa-check"></i> Ready to use</p>
                    `);
                    $('#companyInfo').show();
                } else {
                    $('#companyInfo').hide();
                }
            });

            $('#RelatedPartyTypeID').change(function () {
                var selectedId = $(this).val();
                var selectedText = partyTypesData[selectedId] || 'Unknown Type';

                if (selectedId) {
                    $('#typeContent').html(`
                        <p><strong>Name:</strong> ${selectedText}</p>
                        <p><strong>ID:</strong> ${selectedId}</p>
                        <p class="text-success"><i class="fa fa-check"></i> Ready to use</p>
                    `);
                    $('#typeInfo').show();
                } else {
                    $('#typeInfo').hide();
                }
            });

            // Form submission handling
            $('form').submit(function (e) {
                var isValid = $(this).valid();
                if (isValid) {
                    $('button[type="submit"]').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Creating...');
                }
            });

            // Auto-hide validation messages on input
            $('input, select, textarea').on('input change', function() {
                var $field = $(this);
                var $validationMessage = $field.siblings('.text-danger');
                if ($field.val().trim() !== '') {
                    $validationMessage.hide();
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
        font-size: 16px;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.3rem;
        opacity: 0.9;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
    }

    .panel-success {
        border-left: 5px solid #27ae60;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
        background-color: #27ae60 !important;
        color: white;
    }

    .panel-title {
        font-size: 1.3rem;
        margin: 0;
    }

        .panel-title i {
            margin-right: 10px;
        }

    .panel-body {
        padding: 30px;
    }

    .form-section {
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }

        .form-section h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

            .form-section h4 i {
                margin-right: 10px;
                color: #3498db;
            }

    .form-group {
        margin-bottom: 20px;
    }

    .control-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 6px;
        border: 1px solid #ddd;
        padding: 12px 15px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .info-panel {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        border-left: 4px solid #3498db;
    }

        .info-panel h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

    .reference-info {
        margin-bottom: 20px;
        padding: 15px;
        background: white;
        border-radius: 6px;
        border: 1px solid #e9ecef;
        animation: fadeIn 0.3s ease;
    }

        .reference-info h5 {
            color: #3498db;
            margin-bottom: 10px;
            font-weight: 600;
        }

    .reference-content {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .help-text {
        background: #e3f2fd;
        padding: 15px;
        border-radius: 6px;
        border-left: 4px solid #2196f3;
        font-size: 0.9rem;
    }

    .form-actions {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #eee;
        text-align: center;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 1.1rem;
        border-radius: 6px;
        margin: 0 10px;
    }

    .checkbox label {
        font-weight: normal;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .checkbox input[type="checkbox"] {
        margin-right: 8px;
        transform: scale(1.2);
    }

    .text-danger {
        font-size: 0.9rem;
        margin-top: 5px;
        display: block;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 8px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.1rem;
        }

        .panel-body {
            padding: 20px;
        }

        .form-actions .btn {
            display: block;
            width: 100%;
            margin-bottom: 10px;
        }

        .info-panel {
            margin-top: 20px;
        }
    }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">