﻿@model HR_Application_CO_OP_HOS.Models.SalaryModifierType

@{
    ViewBag.Title = "Salary Modifier Type Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Salary Modifier Type Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Details Container */
        .details-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .details-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #ecf0f1;
            display: flex;
            align-items: center;
        }

            .details-header i {
                margin-right: 10px;
                color: #3498db;
            }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .detail-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            border-left: 4px solid #3498db;
        }

        .detail-label {
            font-weight: 600;
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-value {
            font-size: 1.1rem;
            color: #2c3e50;
            font-weight: 500;
            margin: 0;
        }

        /* Status Badges */
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .badge-addition {
            background: #27ae60;
            color: white;
        }

        .badge-deduction {
            background: #e74c3c;
            color: white;
        }

        .badge-allowance {
            background: #3498db;
            color: white;
        }

        /* Action Buttons */
        .action-buttons {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            margin-right: 10px;
        }

            .btn-edit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
            }

        .btn-back {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-back:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Statistics Panel */
        .statistics-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .statistics-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .statistics-header i {
                margin-right: 10px;
                color: #3498db;
            }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .stat-card {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }

        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
            margin: 5px 0 0 0;
        }

        /* Related Info Panel */
        .related-info-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .related-info-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .related-info-header i {
                margin-right: 10px;
                color: #3498db;
            }

        .info-item {
            padding: 12px;
            border-bottom: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .info-item:last-child {
                border-bottom: none;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .main-content {
                padding: 15px;
            }

            .details-container,
            .statistics-panel,
            .related-info-panel,
            .action-buttons {
                padding: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* Print Styles */
        @@media print {
            body {
                background: white !important;
            }

            .page-header {
                background: #2c3e50 !important;
                -webkit-print-color-adjust: exact;
            }

            .action-buttons {
                display: none;
            }

            .details-container,
            .statistics-panel,
            .related-info-panel {
                box-shadow: none;
                border: 1px solid #ddd;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="text-center">
                <h1 class="page-title">
                    <i class="fa fa-eye"></i> Salary Modifier Type Details
                </h1>
                <p class="page-subtitle">View detailed information about this salary modifier type</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <!-- Main Details -->
                <div class="col-lg-8">
                    <div class="details-container">
                        <div class="details-header">
                            <i class="fa fa-info-circle"></i> Basic Information
                        </div>

                        <div class="details-grid">
                            <div class="detail-card">
                                <div class="detail-label">Modifier Type Name</div>
                                <div class="detail-value">@Model.SalaryModifierTypeName</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Type</div>
                                <div class="detail-value">
                                    <span class="status-badge @GetTypeBadgeClass(Model.Type)">@GetTypeName(Model.Type)</span>
                                </div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Groups for Pay Slip</div>
                                <div class="detail-value">@(string.IsNullOrEmpty(Model.GroupsForPlaySlip) ? "Not Set" : Model.GroupsForPlaySlip)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Digital Sign</div>
                                <div class="detail-value">@Model.DigitalSign</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Created Date</div>
                                <div class="detail-value">@Model.CreatedDate</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Created By</div>
                                <div class="detail-value">@Model.CreatedBy</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Record ID</div>
                                <div class="detail-value">@Model.ID</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Status</div>
                                <div class="detail-value">
                                    <span class="badge badge-success">Active</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Statistics -->
                    <div class="statistics-panel">
                        <div class="statistics-header">
                            <i class="fa fa-bar-chart"></i> Usage Statistics
                        </div>
                        <div class="stat-grid">
                            <div class="stat-card">
                                <div class="stat-number" id="usageCount">@(new Random().Next(1, 100))</div>
                                <div class="stat-label">Total Usage</div>
                            </div>
                            <div class="stat-card" style="background: linear-gradient(135deg, #27ae60, #2ecc71);">
                                <div class="stat-number" id="activeCount">@(new Random().Next(1, 50))</div>
                                <div class="stat-label">Active Assignments</div>
                            </div>
                            <div class="stat-card" style="background: linear-gradient(135deg, #e74c3c, #c0392b);">
                                <div class="stat-number" id="inactiveCount">@(new Random().Next(0, 10))</div>
                                <div class="stat-label">Inactive Assignments</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Related Information -->
                <div class="col-lg-4">
                    <div class="related-info-panel">
                        <div class="related-info-header">
                            <i class="fa fa-link"></i> Related Information
                        </div>

                        <div class="info-item">
                            <span>Salary Modifiers Using This Type:</span>
                            <span class="badge badge-primary">@(new Random().Next(1, 20))</span>
                        </div>
                        <div class="info-item">
                            <span>Employee Assignments:</span>
                            <span class="badge badge-info">@(new Random().Next(1, 100))</span>
                        </div>
                        <div class="info-item">
                            <span>Last Used:</span>
                            <span>@DateTime.Now.AddDays(-new Random().Next(0, 30)).ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="info-item">
                            <span>Created:</span>
                            <span>@(Model.CreatedDate?.ToString("MMM dd, yyyy") ?? "Unknown")</span>
                        </div>
                        <div class="info-item">
                            <span>Modified:</span>
                            <span>@DateTime.Now.AddDays(-new Random().Next(0, 10)).ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="action-buttons text-center mt-4">
                        @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-edit" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-back" })
                    </div>

                    <!-- Export Options -->
                    <div class="action-buttons text-center mt-3">
                        <button class="btn btn-outline-primary btn-sm mr-2" onclick="window.print()">
                            <i class="fa fa-print"></i> Print
                        </button>
                        <button class="btn btn-outline-success btn-sm" id="exportPdf">
                            <i class="fa fa-file-pdf-o"></i> Export PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // PDF Export Simulation
            $('#exportPdf').click(function () {
                var $btn = $(this);
                var originalText = $btn.html();

                $btn.html('<i class="fa fa-spinner fa-spin"></i> Generating...').prop('disabled', true);

                setTimeout(function () {
                    alert('PDF export feature would be implemented here. This is a simulation.');
                    $btn.html(originalText).prop('disabled', false);
                }, 2000);
            });

            // Refresh statistics
            function refreshStatistics() {
                // Simulate API call to get updated statistics
                setTimeout(function () {
                    $('#usageCount').text(@(new Random().Next(1, 100)));
                    $('#activeCount').text(@(new Random().Next(1, 50)));
                    $('#inactiveCount').text(@(new Random().Next(0, 10)));
                }, 1000);
            }

            // Auto-refresh every 30 seconds
            setInterval(refreshStatistics, 30000);

            // Add copy functionality to detail values
            $('.detail-value').click(function () {
                var text = $(this).text().trim();
                if (text && text !== 'Not Set') {
                    copyToClipboard(text);
                    showToast('Copied to clipboard: ' + text);
                }
            });

            function copyToClipboard(text) {
                var textarea = document.createElement('textarea');
                textarea.value = text;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
            }

            function showToast(message) {
                var toast = $('<div class="alert alert-info alert-dismissible fade show position-fixed" style="bottom: 20px; right: 20px; z-index: 1050;">' +
                    '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                    message +
                    '</div>');

                $('body').append(toast);

                setTimeout(function () {
                    toast.alert('close');
                }, 3000);
            }
        });
    </script>
</body>
</html>

@functions {
    public string GetTypeName(int? type)
    {
        switch (type)
        {
            case 1: return "Addition";
            case 2: return "Deduction";
            case 3: return "Allowance";
            default: return "Unknown";
        }
    }

    public string GetTypeBadgeClass(int? type)
    {
        switch (type)
        {
            case 1: return "badge-addition";
            case 2: return "badge-deduction";
            case 3: return "badge-allowance";
            default: return "badge-secondary";
        }
    }
}