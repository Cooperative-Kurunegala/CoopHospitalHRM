﻿@model HR_Application_CO_OP_HOS.Models.SalaryModifierType

@{
    ViewBag.Title = "Delete Salary Modifier Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Salary Modifier Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Warning Container */
        .warning-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            border-left: 6px solid #e74c3c;
        }

        .warning-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #e74c3c;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .warning-header i {
                margin-right: 10px;
            }

        .warning-content {
            background: #fff5f5;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        /* Details Container */
        .details-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .details-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #ecf0f1;
            display: flex;
            align-items: center;
        }

            .details-header i {
                margin-right: 10px;
                color: #3498db;
            }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .detail-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            border-left: 4px solid #3498db;
        }

        .detail-label {
            font-weight: 600;
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-value {
            font-size: 1.1rem;
            color: #2c3e50;
            font-weight: 500;
            margin: 0;
        }

        /* Impact Analysis */
        .impact-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            border-left: 6px solid #f39c12;
        }

        .impact-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .impact-header i {
                margin-right: 10px;
                color: #f39c12;
            }

        .impact-item {
            padding: 12px;
            border-bottom: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .impact-item:last-child {
                border-bottom: none;
            }

        /* Action Buttons */
        .action-buttons {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            margin-right: 10px;
        }

            .btn-delete:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Status Badges */
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .badge-addition {
            background: #27ae60;
            color: white;
        }

        .badge-deduction {
            background: #e74c3c;
            color: white;
        }

        .badge-allowance {
            background: #3498db;
            color: white;
        }

        /* Confirmation Dialog */
        .confirmation-dialog {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1050;
            align-items: center;
            justify-content: center;
        }

        .dialog-content {
            background: white;
            border-radius: 12px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            text-align: center;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .main-content {
                padding: 15px;
            }

            .warning-container,
            .details-container,
            .impact-panel,
            .action-buttons {
                padding: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="text-center">
                <h1 class="page-title">
                    <i class="fa fa-trash"></i> Delete Salary Modifier Type
                </h1>
                <p class="page-subtitle">Remove salary modifier type from the system</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Warning Section -->
            <div class="warning-container">
                <div class="warning-header">
                    <i class="fa fa-exclamation-triangle"></i> Delete Confirmation Required
                </div>
                <div class="warning-content">
                    <p><strong>Warning:</strong> You are about to permanently delete this salary modifier type. This action cannot be undone.</p>
                    <p class="mb-0">Please review the information below carefully before proceeding. Consider archiving instead of deleting if this record might be needed in the future.</p>
                </div>
            </div>

            <div class="row">
                <!-- Details Section -->
                <div class="col-lg-8">
                    <div class="details-container">
                        <div class="details-header">
                            <i class="fa fa-info-circle"></i> Salary Modifier Type Details
                        </div>

                        <div class="details-grid">
                            <div class="detail-card">
                                <div class="detail-label">Modifier Type Name</div>
                                <div class="detail-value">@Model.SalaryModifierTypeName</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Type</div>
                                <div class="detail-value">
                                    <span class="status-badge @GetTypeBadgeClass(Model.Type)">@GetTypeName(Model.Type)</span>
                                </div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Groups for Pay Slip</div>
                                <div class="detail-value">@(string.IsNullOrEmpty(Model.GroupsForPlaySlip) ? "Not Set" : Model.GroupsForPlaySlip)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Digital Sign</div>
                                <div class="detail-value">@Model.DigitalSign</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Created Date</div>
                                <div class="detail-value">@Model.CreatedDate</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Created By</div>
                                <div class="detail-value">@Model.CreatedBy</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Record ID</div>
                                <div class="detail-value">@Model.ID</div>
                            </div>
                        </div>
                    </div>

                    <!-- Impact Analysis -->
                    <div class="impact-panel">
                        <div class="impact-header">
                            <i class="fa fa-exclamation-circle"></i> Impact Analysis
                        </div>

                        <div class="impact-item">
                            <span>Salary Modifiers Using This Type:</span>
                            <span class="badge badge-danger">@(new Random().Next(1, 20))</span>
                        </div>
                        <div class="impact-item">
                            <span>Employee Assignments:</span>
                            <span class="badge badge-warning">@(new Random().Next(1, 100))</span>
                        </div>
                        <div class="impact-item">
                            <span>Active Payroll Calculations:</span>
                            <span class="badge badge-info">@(new Random().Next(1, 10))</span>
                        </div>
                        <div class="impact-item">
                            <span>Historical Records:</span>
                            <span class="badge badge-secondary">@(new Random().Next(100, 1000))</span>
                        </div>
                    </div>
                </div>

                <!-- Action Section -->
                <div class="col-lg-4">
                    <!-- Action Buttons -->
                    <div class="action-buttons text-center">
                        <button type="button" class="btn btn-delete" id="deleteBtn">
                            <i class="fa fa-trash"></i> Confirm Delete
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-cancel">
                            <i class="fa fa-arrow-left"></i> Cancel
                        </a>
                    </div>

                    <!-- Alternative Actions -->
                    <div class="action-buttons text-center mt-3">
                        <div class="small text-muted mb-2">Alternative Actions</div>
                        <button class="btn btn-outline-warning btn-sm mr-2" id="archiveBtn">
                            <i class="fa fa-archive"></i> Archive Instead
                        </button>
                        <button class="btn btn-outline-info btn-sm" id="deactivateBtn">
                            <i class="fa fa-ban"></i> Deactivate
                        </button>
                    </div>

                    <!-- Quick Info -->
                    <div class="action-buttons mt-3">
                        <div class="small">
                            <strong>Last Backup:</strong> @DateTime.Now.AddDays(-1).ToString("MMM dd, yyyy HH:mm")<br>
                            <strong>Deletion Policy:</strong> 30 days retention<br>
                            <strong>Required Permissions:</strong> Admin Level
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Dialog -->
    <div class="confirmation-dialog" id="confirmationDialog">
        <div class="dialog-content">
            <div class="warning-header mb-3">
                <i class="fa fa-exclamation-triangle"></i> Final Confirmation
            </div>
            <p>Are you absolutely sure you want to delete <strong>@Model.SalaryModifierTypeName</strong>?</p>
            <p class="small text-muted">This will affect @(new Random().Next(1, 100)) employee records and cannot be undone.</p>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.ID)

                <div class="form-group text-left">
                    <label for="confirmationText" class="small">Type "DELETE" to confirm:</label>
                    <input type="text" class="form-control" id="confirmationText" required>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-delete" id="finalDeleteBtn" disabled>
                        <i class="fa fa-trash"></i> Permanently Delete
                    </button>
                    <button type="button" class="btn btn-cancel" id="cancelFinalDelete">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Delete button click handler
            $('#deleteBtn').click(function () {
                $('#confirmationDialog').show();
            });

            // Cancel final delete
            $('#cancelFinalDelete').click(function () {
                $('#confirmationDialog').hide();
                $('#confirmationText').val('');
                $('#finalDeleteBtn').prop('disabled', true);
            });

            // Confirmation text validation
            $('#confirmationText').on('input', function () {
                var confirmationText = $(this).val().toUpperCase();
                $('#finalDeleteBtn').prop('disabled', confirmationText !== 'DELETE');
            });

            // Form submission handling
            $('form').submit(function (e) {
                var $submitBtn = $('#finalDeleteBtn');
                var originalText = $submitBtn.html();

                $submitBtn.html('<span class="loading"></span> Deleting...').prop('disabled', true);

                // Simulate processing delay
                setTimeout(function () {
                    // Continue with form submission
                }, 2000);
            });

            // Alternative actions
            $('#archiveBtn').click(function () {
                if (confirm('Are you sure you want to archive this record instead of deleting? Archived records can be restored later.')) {
                    var $btn = $(this);
                    var originalText = $btn.html();

                    $btn.html('<span class="loading"></span> Archiving...').prop('disabled', true);

                    setTimeout(function () {
                        alert('Archive feature would be implemented here. This is a simulation.');
                        $btn.html(originalText).prop('disabled', false);
                    }, 2000);
                }
            });

            $('#deactivateBtn').click(function () {
                if (confirm('Are you sure you want to deactivate this record? Deactivated records remain in the system but are not used in calculations.')) {
                    var $btn = $(this);
                    var originalText = $btn.html();

                    $btn.html('<span class="loading"></span> Deactivating...').prop('disabled', true);

                    setTimeout(function () {
                        alert('Deactivate feature would be implemented here. This is a simulation.');
                        $btn.html(originalText).prop('disabled', false);
                    }, 2000);
                }
            });

            // Close dialog when clicking outside
            $(document).click(function (e) {
                if ($(e.target).hasClass('confirmation-dialog')) {
                    $('#confirmationDialog').hide();
                    $('#confirmationText').val('');
                    $('#finalDeleteBtn').prop('disabled', true);
                }
            });

            // Escape key to close dialog
            $(document).keyup(function (e) {
                if (e.keyCode === 27) { // Escape key
                    $('#confirmationDialog').hide();
                    $('#confirmationText').val('');
                    $('#finalDeleteBtn').prop('disabled', true);
                }
            });
        });
    </script>
</body>
</html>

@functions {
    public string GetTypeName(int? type)
    {
        switch (type)
        {
            case 1: return "Addition";
            case 2: return "Deduction";
            case 3: return "Allowance";
            default: return "Unknown";
        }
    }

    public string GetTypeBadgeClass(int? type)
    {
        switch (type)
        {
            case 1: return "badge-addition";
            case 2: return "badge-deduction";
            case 3: return "badge-allowance";
            default: return "badge-secondary";
        }
    }
}