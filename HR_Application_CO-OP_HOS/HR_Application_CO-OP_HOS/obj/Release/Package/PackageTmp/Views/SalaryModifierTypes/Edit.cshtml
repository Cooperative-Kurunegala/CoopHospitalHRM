﻿@model HR_Application_CO_OP_HOS.Models.SalaryModifierType

@{
    ViewBag.Title = "Edit Salary Modifier Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Salary Modifier Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Form Container */
        .form-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .form-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #ecf0f1;
            display: flex;
            align-items: center;
        }

            .form-header i {
                margin-right: 10px;
                color: #3498db;
            }

        /* Form Controls */
        .form-group {
            margin-bottom: 25px;
        }

        .form-control {
            border-radius: 8px;
            border: 2px solid #ecf0f1;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .validation-message {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        /* Action Buttons */
        .action-buttons {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .btn-submit {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            margin-right: 10px;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Current Values Panel */
        .current-values-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .current-values-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .current-values-header i {
                margin-right: 10px;
                color: #3498db;
            }

        .current-value-item {
            padding: 15px;
            border-left: 4px solid #27ae60;
            background: #f8f9fa;
            margin-bottom: 10px;
            border-radius: 0 8px 8px 0;
        }

            .current-value-item h6 {
                margin: 0;
                color: #2c3e50;
                font-weight: 600;
            }

            .current-value-item p {
                margin: 5px 0 0 0;
                color: #7f8c8d;
                font-size: 1rem;
            }

        /* Change History */
        .history-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .history-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .history-header i {
                margin-right: 10px;
                color: #3498db;
            }

        .history-item {
            padding: 12px;
            border-bottom: 1px solid #ecf0f1;
            font-size: 0.9rem;
        }

            .history-item:last-child {
                border-bottom: none;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .main-content {
                padding: 15px;
            }

            .form-container,
            .current-values-panel,
            .history-panel,
            .action-buttons {
                padding: 20px;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="text-center">
                <h1 class="page-title">
                    <i class="fa fa-edit"></i> Edit Salary Modifier Type
                </h1>
                <p class="page-subtitle">Update salary modifier type information</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <!-- Form Section -->
                <div class="col-lg-8">
                    <div class="form-container">
                        <div class="form-header">
                            <i class="fa fa-edit"></i> Edit Salary Modifier Type Details
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ID)

                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="SalaryModifierTypeName">Modifier Type Name</label>
                                        @Html.EditorFor(model => model.SalaryModifierTypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter modifier type name" } })
                                        @Html.ValidationMessageFor(model => model.SalaryModifierTypeName, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="Type">Type</label>
                                        <select class="form-control" id="Type" name="Type">
                                            <option value="">Select Type</option>
                                            <option value="1" @(Model.Type == 1 ? "selected" : "")>Addition</option>
                                            <option value="2" @(Model.Type == 2 ? "selected" : "")>Deduction</option>
                                            <option value="3" @(Model.Type == 3 ? "selected" : "")>Allowance</option>
                                        </select>
                                        @Html.ValidationMessageFor(model => model.Type, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="GroupsForPlaySlip">Groups for Pay Slip</label>
                                        <select class="form-control" id="GroupsForPlaySlip" name="GroupsForPlaySlip">
                                            <option value="">Select Group</option>
                                            <option value="Basic" @(Model.GroupsForPlaySlip == "Basic" ? "selected" : "")>Basic</option>
                                            <option value="Allowances" @(Model.GroupsForPlaySlip == "Allowances" ? "selected" : "")>Allowances</option>
                                            <option value="Deductions" @(Model.GroupsForPlaySlip == "Deductions" ? "selected" : "")>Deductions</option>
                                            <option value="Taxes" @(Model.GroupsForPlaySlip == "Taxes" ? "selected" : "")>Taxes</option>
                                            <option value="Loans" @(Model.GroupsForPlaySlip == "Loans" ? "selected" : "")>Loans</option>
                                        </select>
                                        @Html.ValidationMessageFor(model => model.GroupsForPlaySlip, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="DigitalSign">Digital Sign</label>
                                        @Html.EditorFor(model => model.DigitalSign, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter digital sign value", type = "number", step = "0.01" } })
                                        @Html.ValidationMessageFor(model => model.DigitalSign, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="CreatedDate">Created Date</label>
                                        @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="CreatedBy">Created By</label>
                                        @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter creator ID", type = "number" } })
                                        @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                            </div>

                            <div class="action-buttons text-center">
                                <button type="submit" class="btn btn-submit" id="submitBtn">
                                    <i class="fa fa-save"></i> Update Salary Modifier Type
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-cancel">
                                    <i class="fa fa-arrow-left"></i> Back to List
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Current Values & History Section -->
                <div class="col-lg-4">
                    <!-- Current Values -->
                    <div class="current-values-panel">
                        <div class="current-values-header">
                            <i class="fa fa-list-alt"></i> Current Values
                        </div>

                        <div class="current-value-item">
                            <h6>Modifier Type Name</h6>
                            <p>@Model.SalaryModifierTypeName</p>
                        </div>

                        <div class="current-value-item">
                            <h6>Type</h6>
                            <p>@GetTypeName(Model.Type)</p>
                        </div>

                        <div class="current-value-item">
                            <h6>Group for Pay Slip</h6>
                            <p>@(string.IsNullOrEmpty(Model.GroupsForPlaySlip) ? "Not Set" : Model.GroupsForPlaySlip)</p>
                        </div>

                        <div class="current-value-item">
                            <h6>Digital Sign</h6>
                            <p>@Model.DigitalSign</p>
                        </div>

                        <div class="current-value-item">
                            <h6>Created Date</h6>
                            <p>@Model.CreatedDate</p>
                        </div>

                        <div class="current-value-item">
                            <h6>Created By</h6>
                            <p>@Model.CreatedBy</p>
                        </div>
                    </div>

                    <!-- Change History -->
                    <div class="history-panel">
                        <div class="history-header">
                            <i class="fa fa-history"></i> Recent Activity
                        </div>

                        <div class="history-item">
                            <strong>Last Modified:</strong>
                            <span id="lastModified">@DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <div class="history-item">
                            <strong>Record ID:</strong> @Model.ID
                        </div>
                        <div class="history-item">
                            <strong>Status:</strong> <span class="badge badge-success">Active</span>
                        </div>
                        <div class="history-item">
                            <strong>Usage:</strong> Used in @(new Random().Next(1, 50)) salary calculations
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            // Form submission handling
            $('form').submit(function (e) {
                var $submitBtn = $('#submitBtn');
                var originalText = $submitBtn.html();

                $submitBtn.html('<span class="loading"></span> Updating...').prop('disabled', true);

                // Update last modified time
                $('#lastModified').text(new Date().toLocaleString());

                setTimeout(function () {
                    $submitBtn.html(originalText).prop('disabled', false);
                }, 2000);
            });

            // Real-time validation feedback
            $('.form-control').on('blur', function () {
                var $this = $(this);
                if ($this.val().trim() === '') {
                    $this.addClass('is-invalid');
                } else {
                    $this.removeClass('is-invalid').addClass('is-valid');
                }
            });

            // Show field changes in real-time
            $('.form-control').on('input', function () {
                var fieldName = $(this).attr('id');
                var newValue = $(this).val();
                var currentValueElement = $('.current-value-item h6:contains("' + getDisplayName(fieldName) + '")').siblings('p');

                if (currentValueElement.length) {
                    currentValueElement.text(newValue || 'Not Set');
                }
            });

            function getDisplayName(fieldName) {
                var names = {
                    'SalaryModifierTypeName': 'Modifier Type Name',
                    'Type': 'Type',
                    'GroupsForPlaySlip': 'Group for Pay Slip',
                    'DigitalSign': 'Digital Sign',
                    'CreatedDate': 'Created Date',
                    'CreatedBy': 'Created By'
                };
                return names[fieldName] || fieldName;
            }

            // Confirmation for significant changes
            $('#Type, #GroupsForPlaySlip').change(function () {
                var fieldName = $(this).attr('id');
                var newValue = $(this).find('option:selected').text();

                if (fieldName === 'Type' || fieldName === 'GroupsForPlaySlip') {
                    showToast('Warning: Changing ' + fieldName.toLowerCase() + ' may affect existing salary calculations.', 'warning');
                }
            });

            function showToast(message, type) {
                // Simple toast implementation
                var toast = $('<div class="alert alert-' + type + ' alert-dismissible fade show position-fixed" style="top: 20px; right: 20px; z-index: 1050;">' +
                    '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                    message +
                    '</div>');

                $('body').append(toast);

                setTimeout(function () {
                    toast.alert('close');
                }, 5000);
            }
        });
    </script>
</body>
</html>

@functions {
    public string GetTypeName(int? type)
    {
        switch (type)
        {
            case 1: return "Addition";
            case 2: return "Deduction";
            case 3: return "Allowance";
            default: return "Unknown";
        }
    }
}