﻿@model IEnumerable<HR_Application_CO_OP_HOS.Models.SalaryModifierType>

@{
    ViewBag.Title = "Salary Modifier Types";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Salary Modifier Types</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Action Panel */
        .action-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        /* Filter Section */
        .filter-section {
            background: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .filter-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .filter-header i {
                margin-right: 10px;
                color: #3498db;
            }

        /* Data Table */
        .data-table-container {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .table-header {
            font-size: 1.4rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .table-header i {
                margin-right: 10px;
                color: #3498db;
            }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
        }

            .table th {
                background: linear-gradient(135deg, #3498db, #2980b9);
                color: white;
                font-weight: 600;
                padding: 15px;
                border: none;
                font-size: 1rem;
            }

            .table td {
                padding: 15px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: middle;
                font-size: 1rem;
            }

            .table tbody tr {
                transition: all 0.3s ease;
            }

                .table tbody tr:hover {
                    background-color: #f8f9fa;
                    transform: translateX(5px);
                }

        /* Action Buttons */
        .btn-action {
            padding: 6px 12px;
            margin: 2px;
            border: none;
            border-radius: 6px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .btn-edit {
            background: #f39c12;
            color: white;
        }

            .btn-edit:hover {
                background: #e67e22;
                transform: translateY(-2px);
            }

        .btn-details {
            background: #3498db;
            color: white;
        }

            .btn-details:hover {
                background: #2980b9;
                transform: translateY(-2px);
            }

        .btn-delete {
            background: #e74c3c;
            color: white;
        }

            .btn-delete:hover {
                background: #c0392b;
                transform: translateY(-2px);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 50px;
            color: #7f8c8d;
        }

            .no-records i {
                font-size: 4rem;
                margin-bottom: 20px;
                color: #bdc3c7;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .main-content {
                padding: 15px;
            }

            .table-responsive {
                border: none;
            }

            .table th,
            .table td {
                padding: 10px 8px;
                font-size: 0.9rem;
            }

            .btn-action {
                padding: 4px 8px;
                font-size: 0.8rem;
                margin: 1px;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Form Controls */
        .form-control {
            border-radius: 8px;
            border: 2px solid #ecf0f1;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .form-group label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="header-content">
                <div>
                    <h1 class="page-title">
                        <i class="fa fa-money"></i> Salary Modifier Types
                    </h1>
                    <p class="page-subtitle">Manage salary modifier types and their configurations</p>
                </div>
                <div>
                    <a href="@Url.Action("Create")" class="btn btn-create">
                        <i class="fa fa-plus"></i> Create New
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Filter Section -->
            <div class="filter-section">
                <div class="filter-header">
                    <i class="fa fa-filter"></i> Filter Records
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="searchName">Search by Name</label>
                            <input type="text" class="form-control" id="searchName" placeholder="Enter modifier type name...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="filterType">Filter by Type</label>
                            <select class="form-control" id="filterType">
                                <option value="">All Types</option>
                                <option value="1">Addition</option>
                                <option value="2">Deduction</option>
                                <option value="3">Allowance</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="filterGroup">Filter by Group</label>
                            <select class="form-control" id="filterGroup">
                                <option value="">All Groups</option>
                                <option value="Basic">Basic</option>
                                <option value="Allowances">Allowances</option>
                                <option value="Deductions">Deductions</option>
                                <option value="Taxes">Taxes</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 text-right">
                        <button class="btn btn-secondary" id="resetFilters">
                            <i class="fa fa-refresh"></i> Reset Filters
                        </button>
                        <button class="btn btn-primary" id="applyFilters">
                            <i class="fa fa-search"></i> Apply Filters
                        </button>
                    </div>
                </div>
            </div>

            <!-- Data Table -->
            <div class="data-table-container">
                <div class="table-header">
                    <i class="fa fa-table"></i> Salary Modifier Types List
                    <span class="badge badge-primary ml-2" id="recordCount">@Model.Count()</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Modifier Type Name</th>
                                <th>Type</th>
                                <th>Groups for Pay Slip</th>
                                <th>Created Date</th>
                                <th>Created By</th>
                                <th>Digital Sign</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.SalaryModifierTypeName)</td>
                                        <td>
                                            <span class="badge @(item.Type == 1 ? "badge-success" : item.Type == 2 ? "badge-danger" : "badge-info")">
                                                @GetTypeName(item.Type)
                                            </span>
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.GroupsForPlaySlip)</td>
                                        <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                                        <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                                        <td>@Html.DisplayFor(modelItem => item.DigitalSign)</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-action btn-edit" })
                                                @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-action btn-details" })
                                                @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-action btn-delete" })
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="no-records">
                                            <i class="fa fa-database"></i>
                                            <h4>No Records Found</h4>
                                            <p>No salary modifier types have been created yet.</p>
                                            <a href="@Url.Action("Create")" class="btn btn-create mt-3">
                                                <i class="fa fa-plus"></i> Create First Record
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript for Filtering -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Filter functionality
            $('#applyFilters').click(function () {
                filterTable();
            });

            $('#resetFilters').click(function () {
                $('#searchName').val('');
                $('#filterType').val('');
                $('#filterGroup').val('');
                filterTable();
            });

            // Real-time search
            $('#searchName').on('input', function () {
                filterTable();
            });

            function filterTable() {
                var nameFilter = $('#searchName').val().toLowerCase();
                var typeFilter = $('#filterType').val();
                var groupFilter = $('#filterGroup').val().toLowerCase();

                $('table tbody tr').each(function () {
                    var $row = $(this);
                    var name = $row.find('td:eq(0)').text().toLowerCase();
                    var type = $row.find('td:eq(1) .badge').text().toLowerCase();
                    var group = $row.find('td:eq(2)').text().toLowerCase();

                    var nameMatch = name.includes(nameFilter);
                    var typeMatch = !typeFilter || type.includes(typeFilter.toLowerCase());
                    var groupMatch = !groupFilter || group.includes(groupFilter);

                    if (nameMatch && typeMatch && groupMatch) {
                        $row.show();
                    } else {
                        $row.hide();
                    }
                });

                // Update record count
                var visibleCount = $('table tbody tr:visible').length;
                $('#recordCount').text(visibleCount);
            }

            // Add loading state to buttons
            $('.btn-action').click(function () {
                var $btn = $(this);
                var originalText = $btn.html();
                $btn.html('<span class="loading"></span> Loading...').prop('disabled', true);

                setTimeout(function () {
                    $btn.html(originalText).prop('disabled', false);
                }, 1000);
            });
        });
    </script>
</body>
</html>

@functions {
    public string GetTypeName(int? type)
    {
        switch (type)
        {
            case 1: return "Addition";
            case 2: return "Deduction";
            case 3: return "Allowance";
            default: return "Unknown";
        }
    }
}