﻿@model HR_Application_CO_OP_HOS.Models.SalaryModifierType

@{
    ViewBag.Title = "Create Salary Modifier Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Salary Modifier Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Form Container */
        .form-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .form-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #ecf0f1;
            display: flex;
            align-items: center;
        }

            .form-header i {
                margin-right: 10px;
                color: #3498db;
            }

        /* Form Controls */
        .form-group {
            margin-bottom: 25px;
        }

        .form-control {
            border-radius: 8px;
            border: 2px solid #ecf0f1;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .validation-message {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        /* Action Buttons */
        .action-buttons {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .btn-submit {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            margin-right: 10px;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Reference Panel */
        .reference-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .reference-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .reference-header i {
                margin-right: 10px;
                color: #3498db;
            }

        .reference-item {
            padding: 15px;
            border-left: 4px solid #3498db;
            background: #f8f9fa;
            margin-bottom: 10px;
            border-radius: 0 8px 8px 0;
        }

            .reference-item h6 {
                margin: 0;
                color: #2c3e50;
                font-weight: 600;
            }

            .reference-item p {
                margin: 5px 0 0 0;
                color: #7f8c8d;
                font-size: 0.9rem;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .main-content {
                padding: 15px;
            }

            .form-container,
            .reference-panel,
            .action-buttons {
                padding: 20px;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="text-center">
                <h1 class="page-title">
                    <i class="fa fa-plus-circle"></i> Create Salary Modifier Type
                </h1>
                <p class="page-subtitle">Add a new salary modifier type to the system</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <!-- Form Section -->
                <div class="col-lg-8">
                    <div class="form-container">
                        <div class="form-header">
                            <i class="fa fa-edit"></i> Salary Modifier Type Details
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="SalaryModifierTypeName">Modifier Type Name</label>
                                        @Html.EditorFor(model => model.SalaryModifierTypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter modifier type name" } })
                                        @Html.ValidationMessageFor(model => model.SalaryModifierTypeName, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="Type">Type</label>
                                        <select class="form-control" id="Type" name="Type">
                                            <option value="">Select Type</option>
                                            <option value="1">Addition</option>
                                            <option value="2">Deduction</option>
                                            <option value="3">Allowance</option>
                                        </select>
                                        @Html.ValidationMessageFor(model => model.Type, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="GroupsForPlaySlip">Groups for Pay Slip</label>
                                        <select class="form-control" id="GroupsForPlaySlip" name="GroupsForPlaySlip">
                                            <option value="">Select Group</option>
                                            <option value="Basic">Basic</option>
                                            <option value="Allowances">Allowances</option>
                                            <option value="Deductions">Deductions</option>
                                            <option value="Taxes">Taxes</option>
                                            <option value="Loans">Loans</option>
                                        </select>
                                        @Html.ValidationMessageFor(model => model.GroupsForPlaySlip, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="DigitalSign">Digital Sign</label>
                                        @Html.EditorFor(model => model.DigitalSign, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter digital sign value", type = "number", step = "0.01" } })
                                        @Html.ValidationMessageFor(model => model.DigitalSign, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="CreatedDate">Created Date</label>
                                        @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label" for="CreatedBy">Created By</label>
                                        @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter creator ID", type = "number" } })
                                        @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "validation-message" })
                                    </div>
                                </div>
                            </div>

                            <div class="action-buttons text-center">
                                <button type="submit" class="btn btn-submit" id="submitBtn">
                                    <i class="fa fa-save"></i> Create Salary Modifier Type
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-cancel">
                                    <i class="fa fa-arrow-left"></i> Back to List
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Reference Section -->
                <div class="col-lg-4">
                    <div class="reference-panel">
                        <div class="reference-header">
                            <i class="fa fa-info-circle"></i> Reference Information
                        </div>

                        <div class="reference-item">
                            <h6>Type Definitions</h6>
                            <p><strong>Addition:</strong> Positive amount added to salary</p>
                            <p><strong>Deduction:</strong> Negative amount subtracted from salary</p>
                            <p><strong>Allowance:</strong> Regular additional payment</p>
                        </div>

                        <div class="reference-item">
                            <h6>Group Categories</h6>
                            <p><strong>Basic:</strong> Core salary components</p>
                            <p><strong>Allowances:</strong> Additional benefits</p>
                            <p><strong>Deductions:</strong> Salary reductions</p>
                            <p><strong>Taxes:</strong> Tax-related items</p>
                            <p><strong>Loans:</strong> Loan repayments</p>
                        </div>

                        <div class="reference-item">
                            <h6>Digital Sign</h6>
                            <p>Used for verification and security purposes. Typically a numeric value that identifies this modifier type uniquely in calculations.</p>
                        </div>

                        <div class="reference-item">
                            <h6>Best Practices</h6>
                            <p>• Use clear, descriptive names</p>
                            <p>• Choose appropriate type and group</p>
                            <p>• Set unique digital signs for each type</p>
                            <p>• Document the purpose of each modifier</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            // Form submission handling
            $('form').submit(function (e) {
                var $submitBtn = $('#submitBtn');
                var originalText = $submitBtn.html();

                $submitBtn.html('<span class="loading"></span> Creating...').prop('disabled', true);

                // Simulate processing delay
                setTimeout(function () {
                    $submitBtn.html(originalText).prop('disabled', false);
                }, 2000);
            });

            // Real-time validation feedback
            $('.form-control').on('blur', function () {
                var $this = $(this);
                if ($this.val().trim() === '') {
                    $this.addClass('is-invalid');
                } else {
                    $this.removeClass('is-invalid').addClass('is-valid');
                }
            });

            // Auto-set current date for CreatedDate
            $('#CreatedDate').val(new Date().toISOString().slice(0, 16));

            // Tooltip for form fields
            $('.form-control').hover(function () {
                var fieldName = $(this).attr('id');
                var description = getFieldDescription(fieldName);
                if (description) {
                    $(this).attr('title', description);
                }
            });

            function getFieldDescription(fieldName) {
                var descriptions = {
                    'SalaryModifierTypeName': 'The name of the salary modifier type (e.g., Basic Salary, Overtime, Loan Deduction)',
                    'Type': 'Determines if this is an addition, deduction, or allowance',
                    'GroupsForPlaySlip': 'Groups similar modifiers together on pay slips',
                    'DigitalSign': 'Unique identifier for verification in calculations',
                    'CreatedDate': 'Date and time when this record was created',
                    'CreatedBy': 'ID of the user who created this record'
                };
                return descriptions[fieldName] || '';
            }
        });
    </script>
</body>
</html>