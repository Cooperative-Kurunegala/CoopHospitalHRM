@model HR_Application_CO_OP_HOS.Models.RelatedPartyLoan

@{
    ViewBag.Title = "Edit Employee Loan";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 0;
            margin: 0;
            background: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        .header-section {
            background: linear-gradient(135deg, #2c3e50 0%, #9b59b6 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .form-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 20px;
        }

        .form-group label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #9b59b6;
                box-shadow: 0 0 0 0.2rem rgba(155, 89, 182, 0.25);
            }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-warning:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.3);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .validation-summary {
            background: #e74c3c;
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .field-validation-error {
            color: #e74c3c;
            font-size: 14px;
            margin-top: 5px;
            display: block;
        }

        .info-panel {
            background: #f8f9fa;
            border-left: 4px solid #f39c12;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .help-text {
            color: #7f8c8d;
            font-size: 14px;
            margin-top: 5px;
        }

        .current-values {
            background: #e8f4fd;
            border-radius: 8px;
            padding: 15px;
            margin-top: 10px;
        }

        .foreign-key-select {
            background: #f8f9fa;
            border-left: 3px solid #3498db;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-edit"></i> Edit Employee Loan</h1>
                    <p class="lead mb-0">Update existing employee loan information</p>
                </div>
                <div class="col-md-4 text-right">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Main Form -->
                <div class="form-container">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyID)
                                    @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control foreign-key-select", placeholder = "Enter Employee ID" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "field-validation-error" })
                                    <small class="help-text">Current: @Html.DisplayFor(model => model.RelatedPartyID)</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LoanCategoryID)
                                    @Html.EditorFor(model => model.LoanCategoryID, new { htmlAttributes = new { @class = "form-control foreign-key-select", placeholder = "Enter Loan Category ID" } })
                                    @Html.ValidationMessageFor(model => model.LoanCategoryID, "", new { @class = "field-validation-error" })
                                    <small class="help-text">Current: @Html.DisplayFor(model => model.LoanCategoryID)</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LoanTotalAmount)
                                    @Html.EditorFor(model => model.LoanTotalAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter total amount", onchange = "calculateMonthlyAmount()" } })
                                    @Html.ValidationMessageFor(model => model.LoanTotalAmount, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NoOfInstallments)
                                    @Html.EditorFor(model => model.NoOfInstallments, new { htmlAttributes = new { @class = "form-control", placeholder = "Number of installments", onchange = "calculateMonthlyAmount()" } })
                                    @Html.ValidationMessageFor(model => model.NoOfInstallments, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.MonthlyAmount)
                                    @Html.EditorFor(model => model.MonthlyAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "Monthly amount", @readonly = "readonly" } })
                                    @Html.ValidationMessageFor(model => model.MonthlyAmount, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LoanStartDate)
                                    @Html.EditorFor(model => model.LoanStartDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                    @Html.ValidationMessageFor(model => model.LoanStartDate, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LoanEndDate)
                                    @Html.EditorFor(model => model.LoanEndDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                    @Html.ValidationMessageFor(model => model.LoanEndDate, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "field-validation-error" })
                                    </div>
                                    <small class="help-text">Check if this loan is currently active</small>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-warning">
                                <i class="fa fa-save"></i> Update Loan
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fa fa-times"></i> Cancel
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-4">
                <!-- Current Values Panel -->
                <div class="info-panel">
                    <h5><i class="fa fa-history"></i> Current Values</h5>
                    <div class="current-values">
                        <div class="mb-3">
                            <strong>Employee ID:</strong>
                            <div class="text-primary">@Html.DisplayFor(model => model.RelatedPartyID)</div>
                        </div>
                        <div class="mb-3">
                            <strong>Loan Category:</strong>
                            <div class="text-primary">@Html.DisplayFor(model => model.LoanCategoryID)</div>
                        </div>
                        <div class="mb-3">
                            <strong>Total Amount:</strong>
                            <div class="text-primary">@Html.DisplayFor(model => model.LoanTotalAmount)</div>
                        </div>
                        <div class="mb-3">
                            <strong>Monthly Amount:</strong>
                            <div class="text-primary">@Html.DisplayFor(model => model.MonthlyAmount)</div>
                        </div>
                        <div class="mb-3">
                            <strong>Installments:</strong>
                            <div class="text-primary">@Html.DisplayFor(model => model.NoOfInstallments)</div>
                        </div>
                        <div class="mb-3">
                            <strong>Start Date:</strong>
                            <div class="text-primary">@Html.DisplayFor(model => model.LoanStartDate)</div>
                        </div>
                        <div class="mb-3">
                            <strong>End Date:</strong>
                            <div class="text-primary">@Html.DisplayFor(model => model.LoanEndDate)</div>
                        </div>
                        <div class="mb-3">
                            <strong>Status:</strong>
                            <div class="text-primary">
                                @if (Model.IsActive == true)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="info-panel">
                    <h5><i class="fa fa-bolt"></i> Quick Actions</h5>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-outline-info">
                            <i class="fa fa-eye"></i> View Details
                        </a>
                        <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn btn-outline-danger">
                            <i class="fa fa-trash"></i> Delete Loan
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function calculateMonthlyAmount() {
            const totalAmount = parseFloat(document.getElementById('LoanTotalAmount').value) || 0;
            const installments = parseInt(document.getElementById('NoOfInstallments').value) || 0;

            if (totalAmount > 0 && installments > 0) {
                const monthlyAmount = totalAmount / installments;
                document.getElementById('MonthlyAmount').value = monthlyAmount.toFixed(2);
            } else {
                document.getElementById('MonthlyAmount').value = '';
            }
        }

        // Real-time validation
        document.addEventListener('DOMContentLoaded', function () {
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    let isValid = true;
                    const requiredFields = form.querySelectorAll('input[required]');

                    requiredFields.forEach(field => {
                        if (!field.value.trim()) {
                            isValid = false;
                            field.style.borderColor = '#e74c3c';
                        }
                    });

                    if (!isValid) {
                        e.preventDefault();
                        alert('Please fill in all required fields.');
                    }
                });
            });

            // Auto-calculate on input change
            document.getElementById('LoanTotalAmount').addEventListener('input', calculateMonthlyAmount);
            document.getElementById('NoOfInstallments').addEventListener('input', calculateMonthlyAmount);
        });
    </script>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>