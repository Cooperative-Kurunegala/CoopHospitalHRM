@model HR_Application_CO_OP_HOS.Models.RelatedPartyLoan

@{
    ViewBag.Title = "Employee Loan Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 0;
            margin: 0;
            background: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        .header-section {
            background: linear-gradient(135deg, #2c3e50 0%, #9b59b6 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .details-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 20px;
        }

        .detail-item {
            padding: 15px 0;
            border-bottom: 1px solid #ecf0f1;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .detail-value {
            color: #34495e;
            font-size: 16px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 600;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 600;
        }

        .info-panel {
            background: #f8f9fa;
            border-left: 4px solid #9b59b6;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-active {
            background-color: #2ecc71;
            color: white;
        }

        .badge-inactive {
            background-color: #e74c3c;
            color: white;
        }

        .financial-summary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-eye"></i> Employee Loan Details</h1>
                    <p class="lead mb-0">Complete loan information and financial details</p>
                </div>
                <div class="col-md-4 text-right">
                    <a href="@Url.Action("Index")" class="btn btn-primary">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Financial Summary -->
                <div class="financial-summary">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <h3>@Html.DisplayFor(model => model.LoanTotalAmount)</h3>
                            <small>Total Loan Amount</small>
                        </div>
                        <div class="col-md-4">
                            <h3>@Html.DisplayFor(model => model.MonthlyAmount)</h3>
                            <small>Monthly Installment</small>
                        </div>
                        <div class="col-md-4">
                            <h3>@Html.DisplayFor(model => model.NoOfInstallments)</h3>
                            <small>Total Installments</small>
                        </div>
                    </div>
                </div>

                <!-- Details Container -->
                <div class="details-container">
                    <h4 class="mb-4"><i class="fa fa-file-text-o"></i> Loan Information</h4>

                    <div class="detail-item">
                        <div class="detail-label">Employee ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.RelatedPartyID)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Loan Category ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LoanCategoryID)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Total Loan Amount</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LoanTotalAmount)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Monthly Installment</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.MonthlyAmount)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Number of Installments</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.NoOfInstallments)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Loan Start Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LoanStartDate)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Loan End Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LoanEndDate)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Status</div>
                        <div class="detail-value">
                            @if (Model.IsActive == true)
                            {
                                <span class="status-badge badge-active">Active</span>
                            }
                            else
                            {
                                <span class="status-badge badge-inactive">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Loan ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.ID)</div>
                    </div>

                    <div class="mt-4">
                        <div class="btn-group" role="group">
                            @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning" })
                            @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- Quick Actions -->
                <div class="info-panel">
                    <h5><i class="fa fa-bolt"></i> Quick Actions</h5>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                            <i class="fa fa-edit"></i> Edit Loan
                        </a>
                        <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn btn-danger">
                            <i class="fa fa-trash"></i> Delete Loan
                        </a>
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <i class="fa fa-plus"></i> Create New
                        </a>
                    </div>
                </div>

                <!-- Loan Statistics -->
                <div class="info-panel">
                    <h5><i class="fa fa-line-chart"></i> Loan Statistics</h5>
                    <div class="mt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Remaining Amount:</span>
                            <strong>@Html.DisplayFor(model => model.LoanTotalAmount)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Monthly Payment:</span>
                            <strong>@Html.DisplayFor(model => model.MonthlyAmount)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Remaining Installments:</span>
                            <strong>@Html.DisplayFor(model => model.NoOfInstallments)</strong>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Loan Duration:</span>
                            <strong>
                                @{
                                    if (Model.LoanStartDate.HasValue && Model.LoanEndDate.HasValue)
                                    {
                                        var duration = (Model.LoanEndDate.Value - Model.LoanStartDate.Value).Days;
                                        <text>@duration days</text>
                                    }
                                    else
                                    {
                                        <text>N/A</text>
                                    }
                                }
                            </strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Status:</span>
                            <strong>
                                @if (Model.IsActive == true)
                                {
                                    <span class="text-success">Active</span>
                                }
                                else
                                {
                                    <span class="text-danger">Inactive</span>
                                }
                            </strong>
                        </div>
                    </div>
                </div>

                <!-- Related Information -->
                <div class="info-panel">
                    <h5><i class="fa fa-link"></i> Related Information</h5>
                    <div class="mt-3">
                        <div class="mb-3">
                            <strong>Employee Details:</strong>
                            <div class="mt-2">
                                <button class="btn btn-outline-info btn-sm">
                                    <i class="fa fa-user"></i> View Employee
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <strong>Loan Category:</strong>
                            <div class="mt-2">
                                <button class="btn btn-outline-info btn-sm">
                                    <i class="fa fa-tags"></i> View Category
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <strong>Payment History:</strong>
                            <div class="mt-2">
                                <button class="btn btn-outline-info btn-sm">
                                    <i class="fa fa-history"></i> View Payments
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>