@model HR_Application_CO_OP_HOS.Models.RelatedPartyLoan

@{
    ViewBag.Title = "Create Employee Loan";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 0;
            margin: 0;
            background: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        .header-section {
            background: linear-gradient(135deg, #2c3e50 0%, #9b59b6 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .form-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 20px;
        }

        .form-group label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #9b59b6;
                box-shadow: 0 0 0 0.2rem rgba(155, 89, 182, 0.25);
            }

        .btn-primary {
            background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(155, 89, 182, 0.3);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .validation-summary {
            background: #e74c3c;
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .field-validation-error {
            color: #e74c3c;
            font-size: 14px;
            margin-top: 5px;
            display: block;
        }

        .info-panel {
            background: #f8f9fa;
            border-left: 4px solid #9b59b6;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .help-text {
            color: #7f8c8d;
            font-size: 14px;
            margin-top: 5px;
        }

        .calculation-preview {
            background: #e8f4fd;
            border-radius: 8px;
            padding: 15px;
            margin-top: 10px;
        }

        .foreign-key-select {
            background: #f8f9fa;
            border-left: 3px solid #3498db;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-plus-circle"></i> Create Employee Loan</h1>
                    <p class="lead mb-0">Add a new employee loan record with installment details</p>
                </div>
                <div class="col-md-4 text-right">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Main Form -->
                <div class="form-container">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyID)
                                    @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control foreign-key-select", placeholder = "Enter Employee ID" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "field-validation-error" })
                                    <small class="help-text">Enter the employee ID who is taking the loan</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LoanCategoryID)
                                    @Html.EditorFor(model => model.LoanCategoryID, new { htmlAttributes = new { @class = "form-control foreign-key-select", placeholder = "Enter Loan Category ID" } })
                                    @Html.ValidationMessageFor(model => model.LoanCategoryID, "", new { @class = "field-validation-error" })
                                    <small class="help-text">Select the loan category</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LoanTotalAmount)
                                    @Html.EditorFor(model => model.LoanTotalAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter total amount", onchange = "calculateMonthlyAmount()" } })
                                    @Html.ValidationMessageFor(model => model.LoanTotalAmount, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NoOfInstallments)
                                    @Html.EditorFor(model => model.NoOfInstallments, new { htmlAttributes = new { @class = "form-control", placeholder = "Number of installments", onchange = "calculateMonthlyAmount()" } })
                                    @Html.ValidationMessageFor(model => model.NoOfInstallments, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.MonthlyAmount)
                                    @Html.EditorFor(model => model.MonthlyAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "Monthly amount", @readonly = "readonly" } })
                                    @Html.ValidationMessageFor(model => model.MonthlyAmount, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LoanStartDate)
                                    @Html.EditorFor(model => model.LoanStartDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                    @Html.ValidationMessageFor(model => model.LoanStartDate, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LoanEndDate)
                                    @Html.EditorFor(model => model.LoanEndDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                    @Html.ValidationMessageFor(model => model.LoanEndDate, "", new { @class = "field-validation-error" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { @class = "form-check-input" } })
                                        @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "field-validation-error" })
                                    </div>
                                    <small class="help-text">Check if this loan is currently active</small>
                                </div>
                            </div>
                        </div>

                        <!-- Calculation Preview -->
                        <div class="calculation-preview" id="calculationPreview" style="display: none;">
                            <h6><i class="fa fa-calculator"></i> Loan Calculation Preview</h6>
                            <div class="row">
                                <div class="col-md-4">
                                    <strong>Total Amount:</strong>
                                    <div id="previewTotal">$0.00</div>
                                </div>
                                <div class="col-md-4">
                                    <strong>Installments:</strong>
                                    <div id="previewInstallments">0</div>
                                </div>
                                <div class="col-md-4">
                                    <strong>Monthly Payment:</strong>
                                    <div id="previewMonthly">$0.00</div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Create Loan
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fa fa-times"></i> Cancel
                            </a>
                            <button type="button" class="btn btn-outline-info" onclick="clearForm()">
                                <i class="fa fa-eraser"></i> Clear Form
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-4">
                <!-- Information Panel -->
                <div class="info-panel">
                    <h5><i class="fa fa-info-circle"></i> Loan Information</h5>
                    <p>Fill in all the required details to create a new employee loan record.</p>

                    <div class="mt-4">
                        <h6>Guidelines:</h6>
                        <ul>
                            <li>Verify employee ID before submission</li>
                            <li>Ensure loan amount is within policy limits</li>
                            <li>Set appropriate number of installments</li>
                            <li>Double-check dates for accuracy</li>
                            <li>Review all entries before saving</li>
                        </ul>
                    </div>
                </div>

                <!-- Foreign Key References -->
                <div class="info-panel">
                    <h5><i class="fa fa-database"></i> Reference Data</h5>
                    <div class="mb-3">
                        <strong>Available Loan Categories:</strong>
                        <div class="mt-2">
                            <span class="badge bg-primary me-1">Personal Loan</span>
                            <span class="badge bg-primary me-1">Housing Loan</span>
                            <span class="badge bg-primary me-1">Vehicle Loan</span>
                            <span class="badge bg-primary">Emergency Loan</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>Employee Validation:</strong>
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="validateEmployee()">
                                <i class="fa fa-check"></i> Validate Employee
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function calculateMonthlyAmount() {
            const totalAmount = parseFloat(document.getElementById('LoanTotalAmount').value) || 0;
            const installments = parseInt(document.getElementById('NoOfInstallments').value) || 0;

            if (totalAmount > 0 && installments > 0) {
                const monthlyAmount = totalAmount / installments;
                document.getElementById('MonthlyAmount').value = monthlyAmount.toFixed(2);

                // Update preview
                document.getElementById('calculationPreview').style.display = 'block';
                document.getElementById('previewTotal').textContent = '$' + totalAmount.toFixed(2);
                document.getElementById('previewInstallments').textContent = installments;
                document.getElementById('previewMonthly').textContent = '$' + monthlyAmount.toFixed(2);
            } else {
                document.getElementById('MonthlyAmount').value = '';
                document.getElementById('calculationPreview').style.display = 'none';
            }
        }

        function clearForm() {
            if (confirm('Are you sure you want to clear all form fields?')) {
                document.querySelector('form').reset();
                document.getElementById('calculationPreview').style.display = 'none';
            }
        }

        function validateEmployee() {
            const employeeId = document.getElementById('RelatedPartyID').value;
            if (!employeeId) {
                alert('Please enter an Employee ID first.');
                return;
            }

            // Simulate employee validation
            alert('Employee validation would check if ID ' + employeeId + ' exists in the system.');
        }

        // Real-time validation
        document.addEventListener('DOMContentLoaded', function () {
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    let isValid = true;
                    const requiredFields = form.querySelectorAll('input[required]');

                    requiredFields.forEach(field => {
                        if (!field.value.trim()) {
                            isValid = false;
                            field.style.borderColor = '#e74c3c';
                        }
                    });

                    // Additional validation for loan amounts
                    const totalAmount = parseFloat(document.getElementById('LoanTotalAmount').value) || 0;
                    if (totalAmount <= 0) {
                        isValid = false;
                        document.getElementById('LoanTotalAmount').style.borderColor = '#e74c3c';
                        alert('Loan amount must be greater than zero.');
                    }

                    if (!isValid) {
                        e.preventDefault();
                        alert('Please fill in all required fields correctly.');
                    }
                });
            });

            // Auto-calculate on input change
            document.getElementById('LoanTotalAmount').addEventListener('input', calculateMonthlyAmount);
            document.getElementById('NoOfInstallments').addEventListener('input', calculateMonthlyAmount);
        });
    </script>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>