@model HR_Application_CO_OP_HOS.Models.RelatedPartyLoan

@{
    ViewBag.Title = "Delete Employee Loan";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 0;
            margin: 0;
            background: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        .header-section {
            background: linear-gradient(135deg, #2c3e50 0%, #e74c3c 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .warning-container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 20px;
            border-left: 6px solid #e74c3c;
        }

        .detail-item {
            padding: 12px 0;
            border-bottom: 1px solid #ecf0f1;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .detail-value {
            color: #34495e;
            font-size: 16px;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .warning-alert {
            background: #fdf2f2;
            border: 2px solid #e74c3c;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .info-panel {
            background: #f8f9fa;
            border-left: 4px solid #e74c3c;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-active {
            background-color: #2ecc71;
            color: white;
        }

        .badge-inactive {
            background-color: #e74c3c;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-exclamation-triangle"></i> Delete Employee Loan</h1>
                    <p class="lead mb-0">Remove employee loan record from the system</p>
                </div>
                <div class="col-md-4 text-right">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Warning Container -->
                <div class="warning-container">
                    <div class="warning-alert">
                        <h4 class="text-danger"><i class="fa fa-warning"></i> Critical Action Required</h4>
                        <p class="mb-0">You are about to permanently delete an employee loan record. This action will remove all associated data and cannot be undone.</p>
                    </div>

                    <h4 class="mb-4">Loan Details to be Deleted</h4>

                    <div class="detail-item">
                        <div class="detail-label">Employee ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.RelatedPartyID)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Loan Category ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LoanCategoryID)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Total Loan Amount</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LoanTotalAmount)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Monthly Installment</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.MonthlyAmount)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Number of Installments</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.NoOfInstallments)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Loan Start Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LoanStartDate)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Loan End Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LoanEndDate)</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Status</div>
                        <div class="detail-value">
                            @if (Model.IsActive == true)
                            {
                                <span class="status-badge badge-active">Active</span>
                            }
                            else
                            {
                                <span class="status-badge badge-inactive">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Loan ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.ID)</div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="mt-4">
                            <button type="submit" class="btn btn-danger" onclick="return confirmDelete()">
                                <i class="fa fa-trash"></i> Confirm Delete
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fa fa-times"></i> Cancel
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-4">
                <!-- Consequences Panel -->
                <div class="info-panel">
                    <h5><i class="fa fa-exclamation-circle"></i> Consequences</h5>
                    <p>Deleting this employee loan will:</p>
                    <ul>
                        <li>Permanently remove all loan data</li>
                        <li>Delete associated installment records</li>
                        <li>Affect employee financial reports</li>
                        <li>Impact payroll calculations</li>
                        <li>This action cannot be reversed</li>
                    </ul>
                </div>

                <!-- Impact Analysis -->
                <div class="info-panel">
                    <h5><i class="fa fa-bar-chart"></i> Impact Analysis</h5>
                    <div class="mt-3">
                        <div class="mb-3">
                            <strong>Financial Impact:</strong>
                            <div class="text-danger">High</div>
                        </div>
                        <div class="mb-3">
                            <strong>Data Loss:</strong>
                            <div class="text-danger">Complete</div>
                        </div>
                        <div class="mb-3">
                            <strong>Recovery Option:</strong>
                            <div class="text-danger">Not Available</div>
                        </div>
                        <div class="mb-3">
                            <strong>Approval Required:</strong>
                            <div class="text-warning">Recommended</div>
                        </div>
                    </div>
                </div>

                <!-- Alternative Actions -->
                <div class="info-panel">
                    <h5><i class="fa fa-lightbulb-o"></i> Alternatives</h5>
                    <p>Consider these options instead:</p>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                            <i class="fa fa-edit"></i> Edit Instead
                        </a>
                        <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-info">
                            <i class="fa fa-eye"></i> View Details
                        </a>
                        @if (Model.IsActive == true)
                        {
                            <button type="button" class="btn btn-outline-secondary" onclick="deactivateInstead()">
                                <i class="fa fa-pause"></i> Deactivate Instead
                            </button>
                        }
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fa fa-list"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function confirmDelete() {
            const loanAmount = '@Model.LoanTotalAmount';
            const employeeId = '@Model.RelatedPartyID';

            return confirm(`FINAL CONFIRMATION: You are about to delete loan ${loanAmount} for employee ${employeeId}. This action is permanent and cannot be undone. Continue?`);
        }

        function deactivateInstead() {
            if (confirm('Would you like to deactivate this loan instead of deleting it? This will preserve the record but mark it as inactive.')) {
                alert('Deactivation feature would be implemented here. Redirecting to edit page...');
                window.location.href = '@Url.Action("Edit", new { id = Model.ID })';
            }
        }

        // Double confirmation for critical delete
        document.addEventListener('DOMContentLoaded', function () {
            const deleteForm = document.querySelector('form');
            if (deleteForm) {
                deleteForm.addEventListener('submit', function (e) {
                    if (!confirm('CRITICAL: This will permanently delete the employee loan record and all associated data. Are you absolutely sure?')) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
</body>
</html>