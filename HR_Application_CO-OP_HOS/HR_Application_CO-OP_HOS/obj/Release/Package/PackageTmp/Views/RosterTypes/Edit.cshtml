@model HR_Application_CO_OP_HOS.Models.RosterType

@{
    ViewBag.Title = "Edit Roster Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Roster Type - HR Management System</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

            .header-content h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .header-content .lead {
                font-size: 1.2rem;
                opacity: 0.9;
                margin-bottom: 15px;
            }

        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px 40px;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
        }

        @@media (max-width: 1024px) {
            .main-content {
                grid-template-columns: 1fr;
            }
        }

        /* Form Container */
        .form-container {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            border-left: 6px solid #f39c12;
        }

        .form-header {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #ecf0f1;
        }

            .form-header h3 {
                color: #2c3e50;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 12px;
            }

        /* Form Styling */
        .form-group-modern {
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #34495e;
            margin-bottom: 10px;
            font-size: 1rem;
        }

        .form-control-modern {
            border: 2px solid #ecf0f1;
            border-radius: 10px;
            padding: 14px 16px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #f8f9fa;
            width: 100%;
        }

            .form-control-modern:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
                background: white;
                outline: none;
            }

        .text-danger {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 6px;
            display: block;
        }

        .validation-summary {
            background: #ffeaa7;
            border: 1px solid #fdcb6e;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 25px;
        }

            .validation-summary ul {
                margin: 0;
                padding-left: 20px;
            }

        /* Button Styling */
        .form-actions {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 30px;
            padding-top: 25px;
            border-top: 2px solid #ecf0f1;
        }

        .btn-modern {
            padding: 14px 30px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }

        .btn-save {
            background: linear-gradient(135deg, #f39c12, #f1c40f);
            color: white;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            color: white;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
        }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: white;
            text-decoration: none;
        }

        /* Sidebar */
        .sidebar {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            border-left: 6px solid #9b59b6;
            height: fit-content;
            position: sticky;
            top: 20px;
        }

        .sidebar-section {
            margin-bottom: 25px;
        }

            .sidebar-section:last-child {
                margin-bottom: 0;
            }

            .sidebar-section h4 {
                color: #2c3e50;
                font-weight: 600;
                margin-bottom: 15px;
                padding-bottom: 10px;
                border-bottom: 1px solid #ecf0f1;
                display: flex;
                align-items: center;
                gap: 8px;
            }

        .info-item {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 12px 15px;
            margin-bottom: 10px;
            border-left: 4px solid #3498db;
        }

            .info-item:last-child {
                margin-bottom: 0;
            }

            .info-item strong {
                color: #2c3e50;
                display: block;
                margin-bottom: 5px;
            }

            .info-item span {
                color: #7f8c8d;
                font-size: 0.9rem;
            }

        .current-data {
            background: #e8f6f3;
            border-left-color: #27ae60;
        }

        /* Animation */
        .fade-in {
            animation: fadeIn 0.6s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .header-content h1 {
                font-size: 2rem;
            }

            .form-actions {
                flex-direction: column;
            }

            .btn-modern {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1><i class="fa fa-edit"></i> Edit Roster Type</h1>
                <p class="lead">Update existing roster type information</p>
                <p>HR Management System • <a href="https://ehealthcare.lk" target="_blank" style="color: #ecf0f1; text-decoration: underline;">eHealthcare Solutions</a></p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content fade-in">
            <!-- Form Container -->
            <div class="form-container">
                <div class="form-header">
                    <h3><i class="fa fa-calendar"></i> Edit Roster Type Information</h3>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)

                    <!-- Validation Summary -->
                    @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

                    <div class="form-group-modern">
                        <label class="form-label" for="RosterTypeName">
                            <i class="fa fa-tag"></i> Roster Type Name *
                        </label>
                        @Html.EditorFor(model => model.RosterTypeName, new
                        {
                            htmlAttributes = new
                            {
                                @class = "form-control-modern",
                                placeholder = "Enter roster type name...",
                                required = "required"
                            }
                        })
                        @Html.ValidationMessageFor(model => model.RosterTypeName, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-modern btn-save">
                            <i class="fa fa-save"></i> Save Changes
                        </button>
                        <a href="@Url.Action("Index")" class="btn-modern btn-cancel">
                            <i class="fa fa-arrow-left"></i> Back to List
                        </a>
                        <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn-modern btn-delete">
                            <i class="fa fa-trash"></i> Delete
                        </a>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="sidebar">
                <div class="sidebar-section">
                    <h4><i class="fa fa-info-circle"></i> Current Data</h4>
                    <div class="info-item current-data">
                        <strong>Roster Type ID</strong>
                        <span>@Model.ID</span>
                    </div>
                    <div class="info-item current-data">
                        <strong>Current Name</strong>
                        <span id="currentRosterName">@Model.RosterTypeName</span>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h4><i class="fa fa-lightbulb-o"></i> Editing Tips</h4>
                    <div class="info-item">
                        <strong>Consistency</strong>
                        <span>Ensure the name follows your existing naming conventions.</span>
                    </div>
                    <div class="info-item">
                        <strong>Impact</strong>
                        <span>Changing roster types may affect existing schedules and assignments.</span>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h4><i class="fa fa-history"></i> Change History</h4>
                    <div class="info-item">
                        <strong>Last Modified</strong>
                        <span>@DateTime.Now.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="info-item">
                        <strong>Created On</strong>
                        <span>@DateTime.Now.AddDays(-30).ToString("MMM dd, yyyy")</span>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h4><i class="fa fa-link"></i> Quick Actions</h4>
                    <div class="info-item">
                        <a href="@Url.Action("Details", new { id = Model.ID })" style="color: #3498db; text-decoration: none;">
                            <i class="fa fa-eye"></i> View Details
                        </a>
                    </div>
                    <div class="info-item">
                        <a href="@Url.Action("Index")" style="color: #3498db; text-decoration: none;">
                            <i class="fa fa-list"></i> All Roster Types
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // Enhanced form validation and real-time updates
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const rosterNameInput = document.getElementById('RosterTypeName');
            const currentRosterName = document.getElementById('currentRosterName');

            // Real-time validation and sidebar update
            rosterNameInput.addEventListener('input', function () {
                validateRosterName(this.value);
                // Update sidebar preview
                currentRosterName.textContent = this.value || '@Model.RosterTypeName';
            });

            // Form submission validation
            form.addEventListener('submit', function (e) {
                if (!validateForm()) {
                    e.preventDefault();
                    showNotification('Please fix the errors before saving.', 'error');
                } else {
                    showNotification('Saving changes...', 'info');
                }
            });

            function validateRosterName(value) {
                const errorElement = rosterNameInput.nextElementSibling;
                if (value.length < 2) {
                    showFieldError(rosterNameInput, 'Roster type name must be at least 2 characters long.');
                    return false;
                } else if (value.length > 50) {
                    showFieldError(rosterNameInput, 'Roster type name cannot exceed 50 characters.');
                    return false;
                } else {
                    clearFieldError(rosterNameInput);
                    return true;
                }
            }

            function validateForm() {
                return validateRosterName(rosterNameInput.value);
            }

            function showFieldError(input, message) {
                let errorElement = input.nextElementSibling;
                if (!errorElement || !errorElement.classList.contains('text-danger')) {
                    errorElement = document.createElement('div');
                    errorElement.className = 'text-danger';
                    input.parentNode.insertBefore(errorElement, input.nextSibling);
                }
                errorElement.textContent = message;
                input.style.borderColor = '#e74c3c';
            }

            function clearFieldError(input) {
                const errorElement = input.nextElementSibling;
                if (errorElement && errorElement.classList.contains('text-danger')) {
                    errorElement.remove();
                }
                input.style.borderColor = '#ecf0f1';
            }

            function showNotification(message, type) {
                // Create notification element
                const notification = document.createElement('div');
                notification.style.cssText = `
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    padding: 15px 20px;
                    border-radius: 10px;
                    color: white;
                    font-weight: 600;
                    z-index: 10000;
                    animation: slideInRight 0.3s ease;
                `;

                if (type === 'error') {
                    notification.style.background = 'linear-gradient(135deg, #e74c3c, #c0392b)';
                } else if (type === 'info') {
                    notification.style.background = 'linear-gradient(135deg, #3498db, #2980b9)';
                } else {
                    notification.style.background = 'linear-gradient(135deg, #27ae60, #2ecc71)';
                }

                notification.textContent = message;
                document.body.appendChild(notification);

                setTimeout(() => {
                    notification.remove();
                }, 3000);
            }

            // Auto-focus on first input
            rosterNameInput.focus();
            rosterNameInput.select();
        });

        // Enhanced error handling
        window.addEventListener('error', function (e) {
            console.error('Error occurred:', e.error);
            showNotification('An error occurred. Please try again.', 'error');
        });
    </script>
</body>
</html>