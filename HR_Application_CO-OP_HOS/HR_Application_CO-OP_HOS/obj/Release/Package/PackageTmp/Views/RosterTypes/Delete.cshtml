@model HR_Application_CO_OP_HOS.Models.RosterType

@{
    ViewBag.Title = "Delete Roster Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Roster Type - HR Management System</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

            .header-content h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .header-content .lead {
                font-size: 1.2rem;
                opacity: 0.9;
                margin-bottom: 15px;
            }

        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px 40px;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
        }

        @@media (max-width: 1024px) {
            .main-content {
                grid-template-columns: 1fr;
            }
        }

        /* Warning Container */
        .warning-container {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            border-left: 6px solid #e74c3c;
            text-align: center;
        }

        .warning-header {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #ecf0f1;
        }

            .warning-header h3 {
                color: #e74c3c;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
            }

        .warning-icon {
            font-size: 4rem;
            color: #e74c3c;
            margin-bottom: 20px;
        }

        .warning-message {
            background: #ffeaa7;
            border: 2px solid #fdcb6e;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 30px;
        }

            .warning-message h4 {
                color: #e74c3c;
                margin-bottom: 15px;
                font-weight: 600;
            }

        /* Details Grid */
        .details-grid {
            display: grid;
            gap: 15px;
            margin-bottom: 30px;
            text-align: left;
        }

        .detail-item {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px 20px;
            border-left: 4px solid #3498db;
        }

        .detail-label {
            font-weight: 600;
            color: #34495e;
            margin-bottom: 5px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-value {
            color: #2c3e50;
            font-size: 1rem;
            font-weight: 500;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 30px;
            padding-top: 25px;
            border-top: 2px solid #ecf0f1;
        }

        .btn-modern {
            padding: 14px 30px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            min-width: 150px;
            justify-content: center;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            color: white;
        }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: white;
            text-decoration: none;
        }

        /* Sidebar */
        .sidebar {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            border-left: 6px solid #9b59b6;
            height: fit-content;
            position: sticky;
            top: 20px;
        }

        .sidebar-section {
            margin-bottom: 25px;
        }

            .sidebar-section:last-child {
                margin-bottom: 0;
            }

            .sidebar-section h4 {
                color: #2c3e50;
                font-weight: 600;
                margin-bottom: 15px;
                padding-bottom: 10px;
                border-bottom: 1px solid #ecf0f1;
                display: flex;
                align-items: center;
                gap: 8px;
            }

        .info-item {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 12px 15px;
            margin-bottom: 10px;
            border-left: 4px solid #3498db;
        }

            .info-item:last-child {
                margin-bottom: 0;
            }

            .info-item strong {
                color: #2c3e50;
                display: block;
                margin-bottom: 5px;
            }

            .info-item span {
                color: #7f8c8d;
                font-size: 0.9rem;
            }

        .danger-item {
            background: #ffebee;
            border-left-color: #e74c3c;
        }

        .warning-item {
            background: #ffeaa7;
            border-left-color: #fdcb6e;
        }

        /* Confirmation Dialog */
        .confirmation-dialog {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 10000;
            align-items: center;
            justify-content: center;
        }

        .dialog-content {
            background: white;
            border-radius: 15px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        /* Animation */
        .fade-in {
            animation: fadeIn 0.6s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .shake {
            animation: shake 0.5s ease-in-out;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-10px);
            }

            75% {
                transform: translateX(10px);
            }
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .header-content h1 {
                font-size: 2rem;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn-modern {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1><i class="fa fa-exclamation-triangle"></i> Delete Roster Type</h1>
                <p class="lead">Permanently remove a roster type from the system</p>
                <p>HR Management System • <a href="https://ehealthcare.lk" target="_blank" style="color: #ecf0f1; text-decoration: underline;">eHealthcare Solutions</a></p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content fade-in">
            <!-- Warning Container -->
            <div class="warning-container">
                <div class="warning-icon">
                    <i class="fa fa-exclamation-circle"></i>
                </div>

                <div class="warning-header">
                    <h3><i class="fa fa-warning"></i> Confirm Deletion</h3>
                </div>

                <div class="warning-message">
                    <h4>⚠️ Critical Action Required</h4>
                    <p style="margin: 0; color: #d35400; font-weight: 500;">
                        You are about to permanently delete this roster type. This action cannot be undone and may affect existing schedules and employee assignments.
                    </p>
                </div>

                <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Roster Type ID</div>
                        <div class="detail-value">@Model.ID</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Roster Type Name</div>
                        <div class="detail-value">@Model.RosterTypeName</div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">Current Status</div>
                        <div class="detail-value">
                            <span style="color: #27ae60; font-weight: 600;">
                                <i class="fa fa-check-circle"></i> Active
                            </span>
                        </div>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)

                    <div class="action-buttons">
                        <button type="button" id="deleteBtn" class="btn-modern btn-delete">
                            <i class="fa fa-trash"></i> Delete Permanently
                        </button>
                        <a href="@Url.Action("Index")" class="btn-modern btn-cancel">
                            <i class="fa fa-arrow-left"></i> Cancel
                        </a>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="sidebar">
                <div class="sidebar-section">
                    <h4><i class="fa fa-info-circle"></i> Impact Analysis</h4>
                    <div class="info-item danger-item">
                        <strong>Immediate Effects</strong>
                        <span>15 active employee assignments will be affected</span>
                    </div>
                    <div class="info-item danger-item">
                        <strong>Data Loss</strong>
                        <span>Historical data referencing this roster type will be impacted</span>
                    </div>
                    <div class="info-item danger-item">
                        <strong>Recovery</strong>
                        <span>This action cannot be undone without a backup</span>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h4><i class="fa fa-lightbulb-o"></i> Alternatives</h4>
                    <div class="info-item">
                        <strong>Deactivate Instead</strong>
                        <span>Consider deactivating instead of deleting to preserve history</span>
                    </div>
                    <div class="info-item">
                        <strong>Merge Options</strong>
                        <span>Merge with another roster type instead of deletion</span>
                    </div>
                    <div class="info-item">
                        <strong>Archive</strong>
                        <span>Archive the roster type to remove from active use</span>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h4><i class="fa fa-shield"></i> Safety Check</h4>
                    <div class="info-item warning-item">
                        <strong>Backup Status</strong>
                        <span>Last backup: Today, 02:00 AM</span>
                    </div>
                    <div class="info-item warning-item">
                        <strong>Admin Approval</strong>
                        <span>Required for permanent deletions</span>
                    </div>
                    <div class="info-item warning-item">
                        <strong>Audit Trail</strong>
                        <span>This action will be logged for security</span>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h4><i class="fa fa-history"></i> Quick Actions</h4>
                    <div class="info-item">
                        <a href="@Url.Action("Edit", new { id = Model.ID })" style="color: #3498db; text-decoration: none; display: block;">
                            <i class="fa fa-edit"></i> Edit Instead
                        </a>
                    </div>
                    <div class="info-item">
                        <a href="@Url.Action("Details", new { id = Model.ID })" style="color: #3498db; text-decoration: none; display: block;">
                            <i class="fa fa-eye"></i> View Details
                        </a>
                    </div>
                    <div class="info-item">
                        <a href="@Url.Action("Index")" style="color: #3498db; text-decoration: none; display: block;">
                            <i class="fa fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Dialog -->
    <div class="confirmation-dialog" id="confirmationDialog">
        <div class="dialog-content">
            <div class="warning-icon" style="font-size: 3rem; margin-bottom: 20px;">
                <i class="fa fa-exclamation-triangle"></i>
            </div>
            <h3 style="color: #e74c3c; margin-bottom: 15px;">Final Confirmation</h3>
            <p style="margin-bottom: 25px; color: #7f8c8d;">
                Are you absolutely sure you want to permanently delete the roster type
                <strong>"@Model.RosterTypeName"</strong>? This action is irreversible.
            </p>
            <div style="display: flex; gap: 15px; justify-content: center;">
                <button type="button" id="confirmDelete" class="btn-modern btn-delete" style="min-width: 120px;">
                    <i class="fa fa-check"></i> Yes, Delete
                </button>
                <button type="button" id="cancelDelete" class="btn-modern btn-cancel" style="min-width: 120px;">
                    <i class="fa fa-times"></i> Cancel
                </button>
            </div>
        </div>
    </div>

    <script>
        // Enhanced delete confirmation with safety measures
        document.addEventListener('DOMContentLoaded', function () {
            const deleteBtn = document.getElementById('deleteBtn');
            const confirmationDialog = document.getElementById('confirmationDialog');
            const confirmDelete = document.getElementById('confirmDelete');
            const cancelDelete = document.getElementById('cancelDelete');
            const form = document.querySelector('form');

            let confirmationCount = 0;

            deleteBtn.addEventListener('click', function () {
                confirmationCount++;

                if (confirmationCount === 1) {
                    // First confirmation - show warning
                    showNotification('Please confirm deletion one more time.', 'warning');
                    deleteBtn.innerHTML = '<i class="fa fa-exclamation-triangle"></i> Click Again to Confirm';
                    deleteBtn.classList.add('shake');

                    setTimeout(() => {
                        deleteBtn.classList.remove('shake');
                    }, 500);
                } else if (confirmationCount === 2) {
                    // Second confirmation - show dialog
                    confirmationDialog.style.display = 'flex';
                }
            });

            confirmDelete.addEventListener('click', function () {
                // Final confirmation - submit form
                showNotification('Deleting roster type...', 'info');
                form.submit();
            });

            cancelDelete.addEventListener('click', function () {
                confirmationDialog.style.display = 'none';
                resetConfirmation();
            });

            // Close dialog when clicking outside
            confirmationDialog.addEventListener('click', function (e) {
                if (e.target === confirmationDialog) {
                    confirmationDialog.style.display = 'none';
                    resetConfirmation();
                }
            });

            function resetConfirmation() {
                confirmationCount = 0;
                deleteBtn.innerHTML = '<i class="fa fa-trash"></i> Delete Permanently';
            }

            function showNotification(message, type) {
                const notification = document.createElement('div');
                notification.style.cssText = `
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    padding: 15px 20px;
                    border-radius: 10px;
                    color: white;
                    font-weight: 600;
                    z-index: 10000;
                    animation: slideInRight 0.3s ease;
                `;

                if (type === 'warning') {
                    notification.style.background = 'linear-gradient(135deg, #f39c12, #e67e22)';
                } else if (type === 'info') {
                    notification.style.background = 'linear-gradient(135deg, #3498db, #2980b9)';
                } else {
                    notification.style.background = 'linear-gradient(135deg, #e74c3c, #c0392b)';
                }

                notification.textContent = message;
                document.body.appendChild(notification);

                setTimeout(() => {
                    notification.remove();
                }, 3000);
            }

            // Add safety timeout to reset confirmation
            setInterval(() => {
                if (confirmationCount > 0) {
                    confirmationCount = 0;
                    deleteBtn.innerHTML = '<i class="fa fa-trash"></i> Delete Permanently';
                    showNotification('Deletion confirmation reset due to inactivity.', 'info');
                }
            }, 30000); // Reset after 30 seconds

            // Prevent accidental form submission
            form.addEventListener('submit', function (e) {
                if (confirmationCount < 2) {
                    e.preventDefault();
                    showNotification('Please complete the confirmation process.', 'warning');
                }
            });

            // Add keyboard shortcuts
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    confirmationDialog.style.display = 'none';
                    resetConfirmation();
                }
            });
        });

        // Enhanced error handling
        window.addEventListener('error', function (e) {
            console.error('Error occurred:', e.error);
            showNotification('An error occurred. Please try again.', 'error');
        });

        function showNotification(message, type) {
            // Fallback notification function
            alert(message);
        }
    </script>
</body>
</html>