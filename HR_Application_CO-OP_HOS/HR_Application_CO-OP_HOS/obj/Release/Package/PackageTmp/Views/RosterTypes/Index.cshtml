@model IEnumerable<HR_Application_CO_OP_HOS.Models.RosterType>

@{
    ViewBag.Title = "Roster Types Management";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Roster Types - HR Management System</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

            .header-content h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .header-content .lead {
                font-size: 1.2rem;
                opacity: 0.9;
                margin-bottom: 15px;
            }

        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px 40px;
        }

        /* Action Panel */
        .action-panel {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            border-left: 6px solid #3498db;
        }

        .btn-modern {
            padding: 12px 25px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            color: white;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
                color: white;
            }

        /* Table Styling */
        .table-container {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .table-modern {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-bottom: 0;
        }

            .table-modern thead {
                background: linear-gradient(135deg, #34495e, #2c3e50);
                color: white;
            }

            .table-modern th {
                padding: 18px 15px;
                font-weight: 600;
                font-size: 1rem;
                border: none;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .table-modern td {
                padding: 15px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: middle;
                font-size: 1rem;
            }

            .table-modern tbody tr {
                transition: all 0.3s ease;
            }

                .table-modern tbody tr:hover {
                    background-color: #f8f9fa;
                    transform: translateY(-1px);
                    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                }

        /* Action Links */
        .action-links {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-action {
            padding: 8px 15px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.3s ease;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12, #f1c40f);
            color: white;
        }

        .btn-details {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
            color: white;
            text-decoration: none;
        }

        /* Filter Section */
        .filter-section {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 25px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        }

        .filter-form {
            display: flex;
            gap: 15px;
            align-items: end;
            flex-wrap: wrap;
        }

        .form-group-modern {
            flex: 1;
            min-width: 250px;
        }

        .form-control-modern {
            border: 2px solid #ecf0f1;
            border-radius: 10px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #f8f9fa;
        }

            .form-control-modern:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
                background: white;
            }

        .btn-filter {
            background: linear-gradient(135deg, #9b59b6, #8e44ad);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-filter:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(155, 89, 182, 0.4);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 60px 20px;
            color: #7f8c8d;
        }

            .no-records i {
                font-size: 4rem;
                margin-bottom: 20px;
                color: #bdc3c7;
            }

            .no-records h3 {
                font-size: 1.5rem;
                margin-bottom: 10px;
                color: #34495e;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .header-content h1 {
                font-size: 2rem;
            }

            .action-links {
                flex-direction: column;
            }

            .btn-action {
                justify-content: center;
            }

            .filter-form {
                flex-direction: column;
            }

            .form-group-modern {
                min-width: 100%;
            }

            .table-container {
                overflow-x: auto;
            }

            .table-modern {
                min-width: 600px;
            }
        }

        /* Animation */
        .fade-in {
            animation: fadeIn 0.6s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1><i class="fa fa-calendar"></i> Roster Types Management</h1>
                <p class="lead">Manage and organize different roster types in the system</p>
                <p>HR Management System • <a href="https://ehealthcare.lk" target="_blank" style="color: #ecf0f1; text-decoration: underline;">eHealthcare Solutions</a></p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content fade-in">
            <!-- Action Panel -->
            <div class="action-panel">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <h3 style="margin: 0; color: #2c3e50; font-weight: 600;">
                        <i class="fa fa-list"></i> All Roster Types
                    </h3>
                    <a href="@Url.Action("Create")" class="btn-modern btn-create">
                        <i class="fa fa-plus"></i> Create New Roster Type
                    </a>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <h4 style="margin-bottom: 20px; color: #2c3e50; font-weight: 600;">
                    <i class="fa fa-filter"></i> Filter Roster Types
                </h4>
                <div class="filter-form">
                    <div class="form-group-modern">
                        <label for="searchFilter" style="font-weight: 600; color: #34495e; margin-bottom: 8px;">Search Roster Types</label>
                        <input type="text" id="searchFilter" class="form-control-modern" placeholder="Enter roster type name...">
                    </div>
                    <div class="form-group-modern">
                        <label for="statusFilter" style="font-weight: 600; color: #34495e; margin-bottom: 8px;">Status Filter</label>
                        <select id="statusFilter" class="form-control-modern">
                            <option value="">All Roster Types</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <button type="button" class="btn-filter" onclick="applyFilters()">
                        <i class="fa fa-search"></i> Apply Filters
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="clearFilters()" style="padding: 12px 25px; border-radius: 10px;">
                        <i class="fa fa-refresh"></i> Clear
                    </button>
                </div>
            </div>

            <!-- Table Container -->
            <div class="table-container">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table-modern">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Roster Type Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="font-weight: 600; color: #2c3e50;">@item.ID</td>
                                        <td style="color: #34495e;">@item.RosterTypeName</td>
                                        <td>
                                            <div class="action-links">
                                                <a href="@Url.Action("Edit", new { id = item.ID })" class="btn-action btn-edit">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>
                                                <a href="@Url.Action("Details", new { id = item.ID })" class="btn-action btn-details">
                                                    <i class="fa fa-eye"></i> Details
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = item.ID })" class="btn-action btn-delete">
                                                    <i class="fa fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-records">
                        <i class="fa fa-calendar-times-o"></i>
                        <h3>No Roster Types Found</h3>
                        <p>There are no roster types available in the system.</p>
                        <a href="@Url.Action("Create")" class="btn-modern btn-create" style="margin-top: 20px;">
                            <i class="fa fa-plus"></i> Create First Roster Type
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        // Filter functionality
        function applyFilters() {
            const searchFilter = document.getElementById('searchFilter').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;

            const rows = document.querySelectorAll('.table-modern tbody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                const rosterName = row.cells[1].textContent.toLowerCase();
                let shouldShow = true;

                // Apply search filter
                if (searchFilter && !rosterName.includes(searchFilter)) {
                    shouldShow = false;
                }

                // Apply status filter (you can extend this based on your data)
                if (statusFilter) {
                    // Add your status logic here based on your model
                }

                if (shouldShow) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Show no results message if needed
            if (visibleCount === 0) {
                // You can add a no results message here
            }
        }

        function clearFilters() {
            document.getElementById('searchFilter').value = '';
            document.getElementById('statusFilter').value = '';
            applyFilters();
        }

        // Initialize filters on page load
        document.addEventListener('DOMContentLoaded', function () {
            applyFilters();

            // Add real-time search
            document.getElementById('searchFilter').addEventListener('input', applyFilters);
            document.getElementById('statusFilter').addEventListener('change', applyFilters);
        });

        // Enhanced error handling
        window.addEventListener('error', function (e) {
            console.error('Error occurred:', e.error);
            // You can show a user-friendly error message here
        });
    </script>
</body>
</html>