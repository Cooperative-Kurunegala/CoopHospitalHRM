@model HR_Application_CO_OP_HOS.Models.RosterStatu

@{
    ViewBag.Title = "Create Roster Status";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Roster Status</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Form Container */
        .form-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-header {
            background: #34495e;
            color: white;
            padding: 20px;
        }

        .form-title {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .form-body {
            padding: 30px;
        }

        /* Form Styles */
        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 2px solid #ecf0f1;
            padding: 12px 15px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-check-input {
            width: 20px;
            height: 20px;
            margin-top: 0;
        }

        /* Button Styles */
        .btn-submit {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            transition: all 0.3s ease;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #bdc3c7 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

            .btn-submit:hover, .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            }

        /* Reference Panel */
        .reference-panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .reference-header {
            background: #9b59b6;
            color: white;
            padding: 20px;
        }

        .reference-title {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 600;
        }

        .reference-body {
            padding: 20px;
            max-height: 400px;
            overflow-y: auto;
        }

        .reference-item {
            padding: 15px;
            border-bottom: 1px solid #ecf0f1;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .reference-item:hover {
                background-color: #f8f9fa;
                transform: translateX(5px);
            }

            .reference-item.active {
                background-color: #3498db;
                color: white;
            }

        /* Validation Styles */
        .field-validation-error {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background-color: #e74c3c;
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 10px;
            }

            .page-title {
                font-size: 2rem;
            }

            .form-body {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title"><i class="fa fa-plus-circle"></i> Create New Roster Status</h1>
                    <p class="page-subtitle">Add a new roster status configuration to the system</p>
                </div>
                <div class="col-md-4 text-end">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-cancel" })
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Main Form -->
            <div class="col-lg-8">
                <div class="form-container">
                    <div class="form-header">
                        <h3 class="form-title"><i class="fa fa-edit"></i> Roster Status Details</h3>
                    </div>
                    <div class="form-body">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DayStatusDescription, htmlAttributes: new { @class = "form-label" })
                                        @Html.EditorFor(model => model.DayStatusDescription, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter day status description" } })
                                        @Html.ValidationMessageFor(model => model.DayStatusDescription, "", new { @class = "field-validation-error" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.OrderIndex, htmlAttributes: new { @class = "form-label" })
                                        @Html.EditorFor(model => model.OrderIndex, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter order index" } })
                                        @Html.ValidationMessageFor(model => model.OrderIndex, "", new { @class = "field-validation-error" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StartDate, htmlAttributes: new { @class = "form-label" })
                                        @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "field-validation-error" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EndDate, htmlAttributes: new { @class = "form-label" })
                                        @Html.EditorFor(model => model.EndDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                        @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "field-validation-error" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RosterTypeID, htmlAttributes: new { @class = "form-label" })
                                        <select class="form-select" id="RosterTypeID" name="RosterTypeID">
                                            <option value="">Select Roster Type</option>
                                            <!-- Options will be populated by JavaScript -->
                                        </select>
                                        @Html.ValidationMessageFor(model => model.RosterTypeID, "", new { @class = "field-validation-error" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NoOfMinutes, htmlAttributes: new { @class = "form-label" })
                                        @Html.EditorFor(model => model.NoOfMinutes, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter number of minutes" } })
                                        @Html.ValidationMessageFor(model => model.NoOfMinutes, "", new { @class = "field-validation-error" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="checkbox-container">
                                            @Html.EditorFor(model => model.RosterRelated)
                                            @Html.LabelFor(model => model.RosterRelated, htmlAttributes: new { @class = "form-label", style = "margin-bottom: 0;" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.RosterRelated, "", new { @class = "field-validation-error" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="checkbox-container">
                                            @Html.EditorFor(model => model.WithNextDay)
                                            @Html.LabelFor(model => model.WithNextDay, htmlAttributes: new { @class = "form-label", style = "margin-bottom: 0;" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.WithNextDay, "", new { @class = "field-validation-error" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group text-end">
                                <input type="submit" value="Create" class="btn btn-submit" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-cancel" })
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Reference Panel -->
            <div class="col-lg-4">
                <div class="reference-panel">
                    <div class="reference-header">
                        <h3 class="reference-title"><i class="fa fa-info-circle"></i> Roster Types Reference</h3>
                    </div>
                    <div class="reference-body" id="rosterTypesList">
                        <!-- Roster types will be populated by JavaScript -->
                        <div class="text-center text-muted">
                            <i class="fa fa-spinner fa-spin" style="font-size: 2rem;"></i>
                            <p>Loading roster types...</p>
                        </div>
                    </div>
                </div>

                <div class="reference-panel mt-4">
                    <div class="reference-header">
                        <h3 class="reference-title"><i class="fa fa-lightbulb-o"></i> Quick Tips</h3>
                    </div>
                    <div class="reference-body">
                        <div class="reference-item">
                            <h6><i class="fa fa-check-circle text-success"></i> Day Status Description</h6>
                            <p class="small mb-0">Enter a clear, descriptive name for the roster status (e.g., "Regular Shift", "Night Duty")</p>
                        </div>
                        <div class="reference-item">
                            <h6><i class="fa fa-check-circle text-success"></i> Order Index</h6>
                            <p class="small mb-0">Set the display order (lower numbers appear first in lists)</p>
                        </div>
                        <div class="reference-item">
                            <h6><i class="fa fa-check-circle text-success"></i> Roster Type</h6>
                            <p class="small mb-0">Select the appropriate roster type from available options</p>
                        </div>
                        <div class="reference-item">
                            <h6><i class="fa fa-check-circle text-success"></i> Duration</h6>
                            <p class="small mb-0">Set start and end dates to define the active period</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Load roster types
            function loadRosterTypes() {
                // This would typically be an AJAX call to get roster types from the database
                // For demonstration, we'll use sample data
                const rosterTypes = [
                    { id: 1, name: 'Regular Shift', description: 'Standard working hours' },
                    { id: 2, name: 'Night Shift', description: 'Overnight duty hours' },
                    { id: 3, name: 'Weekend Shift', description: 'Weekend duty schedule' },
                    { id: 4, name: 'Holiday Shift', description: 'Special holiday schedule' },
                    { id: 5, name: 'Emergency Shift', description: 'Emergency response duty' }
                ];

                const selectElement = document.getElementById('RosterTypeID');
                const listContainer = document.getElementById('rosterTypesList');

                // Clear loading message
                listContainer.innerHTML = '';

                // Populate dropdown
                rosterTypes.forEach(type => {
                    const option = document.createElement('option');
                    option.value = type.id;
                    option.textContent = type.name;
                    selectElement.appendChild(option);
                });

                // Populate reference list
                rosterTypes.forEach(type => {
                    const item = document.createElement('div');
                    item.className = 'reference-item';
                    item.innerHTML = `
                        <h6>${type.name}</h6>
                        <p class="small mb-0 text-muted">${type.description}</p>
                    `;
                    item.addEventListener('click', function () {
                        // Set the selected value in dropdown
                        selectElement.value = type.id;

                        // Highlight selected item
                        document.querySelectorAll('.reference-item').forEach(i => i.classList.remove('active'));
                        this.classList.add('active');
                    });
                    listContainer.appendChild(item);
                });

                // Show message if no roster types
                if (rosterTypes.length === 0) {
                    listContainer.innerHTML = `
                        <div class="text-center text-muted">
                            <i class="fa fa-exclamation-triangle" style="font-size: 2rem;"></i>
                            <p>No roster types available</p>
                        </div>
                    `;
                }
            }

            // Form validation enhancement
            const form = document.querySelector('form');
            form.addEventListener('submit', function (e) {
                let isValid = true;
                const requiredFields = form.querySelectorAll('[data-val-required]');

                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        isValid = false;
                        field.style.borderColor = '#e74c3c';
                    } else {
                        field.style.borderColor = '#ecf0f1';
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    alert('Please fill in all required fields marked with *');
                }
            });

            // Initialize
            loadRosterTypes();
        });
    </script>
</body>
</html>