@model IEnumerable<HR_Application_CO_OP_HOS.Models.RosterStatu>

@{
    ViewBag.Title = "Roster Status - Index";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Roster Status - Index</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Action Buttons */
        .action-buttons {
            margin-bottom: 20px;
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            }

        /* Table Styles */
        .table-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .table-header {
            background: #34495e;
            color: white;
            padding: 20px;
        }

        .table-title {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .table-responsive {
            border-radius: 0 0 12px 12px;
        }

        .table {
            margin: 0;
            font-size: 1.1rem;
        }

            .table thead th {
                background-color: #2c3e50;
                color: white;
                border: none;
                padding: 18px 15px;
                font-weight: 600;
                font-size: 1.1rem;
            }

            .table tbody td {
                padding: 16px 15px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: middle;
            }

            .table tbody tr:hover {
                background-color: #f8f9fa;
                transform: scale(1.01);
                transition: all 0.2s ease;
            }

        /* Action Links */
        .action-links a {
            margin: 0 5px;
            padding: 8px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-edit {
            background-color: #3498db;
            color: white;
        }

        .btn-details {
            background-color: #27ae60;
            color: white;
        }

        .btn-delete {
            background-color: #e74c3c;
            color: white;
        }

        .action-links a:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        /* Filter Section */
        .filter-section {
            background: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .filter-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #2c3e50;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 2px solid #ecf0f1;
            padding: 12px 15px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
            font-size: 1.2rem;
        }

        /* Status Badges */
        .status-active {
            background-color: #27ae60;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .status-inactive {
            background-color: #e74c3c;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 10px;
            }

            .page-title {
                font-size: 2rem;
            }

            .table thead {
                display: none;
            }

            .table tbody td {
                display: block;
                text-align: right;
                padding: 15px;
                border-bottom: 1px solid #ddd;
            }

                .table tbody td:before {
                    content: attr(data-label);
                    float: left;
                    font-weight: bold;
                    color: #2c3e50;
                }

            .action-links {
                text-align: center;
            }

                .action-links a {
                    display: block;
                    margin: 5px 0;
                }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title"><i class="fa fa-calendar-check-o"></i> Roster Status Management</h1>
                    <p class="page-subtitle">Manage and monitor all roster status configurations in the system</p>
                </div>
                <div class="col-md-4 text-end">
                    <div class="action-buttons">
                        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-create" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <h4 class="filter-title"><i class="fa fa-filter"></i> Filter Records</h4>
            <div class="row">
                <div class="col-md-3">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search by description...">
                </div>
                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status Types</option>
                        <option value="true">Roster Related</option>
                        <option value="false">Not Roster Related</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="rosterTypeFilter" class="form-select">
                        <option value="">All Roster Types</option>
                        <!-- Roster types would be populated from database -->
                    </select>
                </div>
                <div class="col-md-3">
                    <button id="resetFilters" class="btn btn-secondary w-100">Reset Filters</button>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title"><i class="fa fa-list"></i> Roster Status Records</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="rosterStatusTable">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.DayStatusDescription)</th>
                            <th>@Html.DisplayNameFor(model => model.OrderIndex)</th>
                            <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                            <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                            <th>@Html.DisplayNameFor(model => model.RosterRelated)</th>
                            <th>@Html.DisplayNameFor(model => model.RosterTypeID)</th>
                            <th>@Html.DisplayNameFor(model => model.NoOfMinutes)</th>
                            <th>@Html.DisplayNameFor(model => model.WithNextDay)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td data-label="Description">@Html.DisplayFor(modelItem => item.DayStatusDescription)</td>
                                    <td data-label="Order Index">@Html.DisplayFor(modelItem => item.OrderIndex)</td>
                                    <td data-label="Start Date">@Html.DisplayFor(modelItem => item.StartDate)</td>
                                    <td data-label="End Date">@Html.DisplayFor(modelItem => item.EndDate)</td>
                                    <td data-label="Roster Related">
                                        @if (item.RosterRelated == true)
                                        {
                                            <span class="status-active">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="status-inactive">No</span>
                                        }
                                    </td>
                                    <td data-label="Roster Type">@Html.DisplayFor(modelItem => item.RosterTypeID)</td>
                                    <td data-label="Minutes">@Html.DisplayFor(modelItem => item.NoOfMinutes)</td>
                                    <td data-label="With Next Day">
                                        @if (item.WithNextDay == true)
                                        {
                                            <span class="status-active">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="status-inactive">No</span>
                                        }
                                    </td>
                                    <td data-label="Actions" class="action-links">
                                        @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn-edit" })
                                        @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn-details" })
                                        @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn-delete" })
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="no-records">
                                    <i class="fa fa-exclamation-circle" style="font-size: 3rem; margin-bottom: 15px;"></i>
                                    <br>
                                    No roster status records found in the system.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Filter functionality
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const statusFilter = document.getElementById('statusFilter');
            const rosterTypeFilter = document.getElementById('rosterTypeFilter');
            const resetFilters = document.getElementById('resetFilters');
            const tableRows = document.querySelectorAll('#rosterStatusTable tbody tr');

            function filterTable() {
                const searchText = searchInput.value.toLowerCase();
                const statusValue = statusFilter.value;
                const rosterTypeValue = rosterTypeFilter.value;

                tableRows.forEach(row => {
                    if (row.cells.length > 1) { // Skip the "no records" row
                        const description = row.cells[0].textContent.toLowerCase();
                        const rosterRelated = row.cells[4].querySelector('.status-active') ? 'true' : 'false';
                        const rosterType = row.cells[5].textContent.trim();

                        const matchesSearch = description.includes(searchText);
                        const matchesStatus = statusValue === '' || rosterRelated === statusValue;
                        const matchesRosterType = rosterTypeValue === '' || rosterType === rosterTypeValue;

                        if (matchesSearch && matchesStatus && matchesRosterType) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    }
                });
            }

            searchInput.addEventListener('input', filterTable);
            statusFilter.addEventListener('change', filterTable);
            rosterTypeFilter.addEventListener('change', filterTable);

            resetFilters.addEventListener('click', function () {
                searchInput.value = '';
                statusFilter.value = '';
                rosterTypeFilter.value = '';
                filterTable();
            });

            // Load roster types from a service (this would typically come from an API)
            // For demonstration, we'll add some dummy options
            function loadRosterTypes() {
                // This would typically be an AJAX call to get roster types
                // For now, we'll add some example options
                const rosterTypes = [
                    { id: 1, name: 'Regular Shift' },
                    { id: 2, name: 'Night Shift' },
                    { id: 3, name: 'Weekend Shift' }
                ];

                rosterTypes.forEach(type => {
                    const option = document.createElement('option');
                    option.value = type.id;
                    option.textContent = type.name;
                    rosterTypeFilter.appendChild(option);
                });
            }

            loadRosterTypes();
        });
    </script>
</body>
</html>