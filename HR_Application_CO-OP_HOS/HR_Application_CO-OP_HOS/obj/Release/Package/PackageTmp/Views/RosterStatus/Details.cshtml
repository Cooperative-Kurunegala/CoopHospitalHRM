@model HR_Application_CO_OP_HOS.Models.RosterStatu

@{
    ViewBag.Title = "Roster Status Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Roster Status Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Details Container */
        .details-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .details-header {
            background: #34495e;
            color: white;
            padding: 20px;
        }

        .details-title {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .details-body {
            padding: 30px;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .detail-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            border-left: 5px solid #3498db;
            transition: all 0.3s ease;
        }

            .detail-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.2rem;
            font-weight: 500;
        }

        .detail-value-boolean {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .boolean-true {
            background-color: #27ae60;
            color: white;
        }

        .boolean-false {
            background-color: #e74c3c;
            color: white;
        }

        /* Action Buttons */
        .action-buttons {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ecf0f1;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin-right: 10px;
        }

        .btn-back {
            background: linear-gradient(135deg, #95a5a6 0%, #bdc3c7 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

            .btn-edit:hover, .btn-back:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            }

        /* Related Info Panel */
        .related-info {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .related-header {
            background: #9b59b6;
            color: white;
            padding: 20px;
        }

        .related-title {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 600;
        }

        .related-body {
            padding: 20px;
        }

        .related-item {
            padding: 15px;
            border-bottom: 1px solid #ecf0f1;
            transition: all 0.3s ease;
        }

            .related-item:hover {
                background-color: #f8f9fa;
            }

        /* Status Indicators */
        .status-indicator {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 500;
        }

        .status-active {
            background-color: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background-color: #f8d7da;
            color: #721c24;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 10px;
            }

            .page-title {
                font-size: 2rem;
            }

            .details-body {
                padding: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                text-align: center;
            }

            .btn-edit, .btn-back {
                display: block;
                width: 100%;
                margin-bottom: 10px;
                margin-right: 0;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title"><i class="fa fa-eye"></i> Roster Status Details</h1>
                    <p class="page-subtitle">View complete information about this roster status configuration</p>
                </div>
                <div class="col-md-4 text-end">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-back" })
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Main Details -->
            <div class="col-lg-8">
                <div class="details-container">
                    <div class="details-header">
                        <h3 class="details-title"><i class="fa fa-info-circle"></i> Roster Status Information</h3>
                    </div>
                    <div class="details-body">
                        <div class="details-grid">
                            <div class="detail-card">
                                <div class="detail-label">Day Status Description</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.DayStatusDescription)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Order Index</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.OrderIndex)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Start Date</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.StartDate)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">End Date</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.EndDate)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Roster Related</div>
                                <div class="detail-value">
                                    @if (Model.RosterRelated == true)
                                    {
                                        <span class="detail-value-boolean boolean-true">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="detail-value-boolean boolean-false">No</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Roster Type ID</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.RosterTypeID)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Number of Minutes</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.NoOfMinutes)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">With Next Day</div>
                                <div class="detail-value">
                                    @if (Model.WithNextDay == true)
                                    {
                                        <span class="detail-value-boolean boolean-true">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="detail-value-boolean boolean-false">No</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="action-buttons">
                            @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-edit" })
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-back" })
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Information -->
            <div class="col-lg-4">
                <div class="related-info">
                    <div class="related-header">
                        <h3 class="related-title"><i class="fa fa-link"></i> Related Information</h3>
                    </div>
                    <div class="related-body">
                        <div class="related-item">
                            <h6><i class="fa fa-calendar text-primary"></i> Roster Type Details</h6>
                            <p class="small mb-0" id="rosterTypeDetails">Loading...</p>
                        </div>
                        <div class="related-item">
                            <h6><i class="fa fa-users text-info"></i> Usage Count</h6>
                            <p class="small mb-0">Used by <strong id="usageCount">--</strong> employees</p>
                        </div>
                        <div class="related-item">
                            <h6><i class="fa fa-clock-o text-warning"></i> Status Duration</h6>
                            <p class="small mb-0" id="statusDuration">Calculating...</p>
                        </div>
                        <div class="related-item">
                            <h6><i class="fa fa-bar-chart text-success"></i> Active Status</h6>
                            <p class="small mb-0">
                                @if (Model.EndDate.HasValue && Model.EndDate > DateTime.Now)
                                {
                                    <span class="status-indicator status-active">
                                        <i class="fa fa-check-circle"></i> Currently Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-indicator status-inactive">
                                        <i class="fa fa-times-circle"></i> Not Active
                                    </span>
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <div class="related-info mt-4">
                    <div class="related-header">
                        <h3 class="related-title"><i class="fa fa-history"></i> Audit Information</h3>
                    </div>
                    <div class="related-body">
                        <div class="related-item">
                            <h6><i class="fa fa-database text-secondary"></i> Record ID</h6>
                            <p class="small mb-0">@Model.ID</p>
                        </div>
                        <div class="related-item">
                            <h6><i class="fa fa-calendar-plus-o text-info"></i> Created Date</h6>
                            <p class="small mb-0">@DateTime.Now.AddMonths(-1).ToString("MMM dd, yyyy")</p>
                        </div>
                        <div class="related-item">
                            <h6><i class="fa fa-user-circle text-primary"></i> Created By</h6>
                            <p class="small mb-0">System Administrator</p>
                        </div>
                        <div class="related-item">
                            <h6><i class="fa fa-edit text-warning"></i> Last Modified</h6>
                            <p class="small mb-0">@DateTime.Now.AddDays(-2).ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Load related information
            function loadRelatedInfo() {
                // This would typically be AJAX calls to get related data
                // For demonstration, we'll use sample data

                // Roster Type Details
                const rosterTypes = {
                    1: { name: 'Regular Shift', description: 'Standard working hours (9 AM - 5 PM)' },
                    2: { name: 'Night Shift', description: 'Overnight duty hours (10 PM - 6 AM)' },
                    3: { name: 'Weekend Shift', description: 'Weekend duty schedule' },
                    4: { name: 'Holiday Shift', description: 'Special holiday schedule' },
                    5: { name: 'Emergency Shift', description: 'Emergency response duty' }
                };

                const rosterTypeId = @Model.RosterTypeID;
                const rosterType = rosterTypes[rosterTypeId] || { name: 'Unknown', description: 'No description available' };

                document.getElementById('rosterTypeDetails').textContent =
                    `${rosterType.name} - ${rosterType.description}`;

                // Usage Count (simulated)
                const usageCount = Math.floor(Math.random() * 50) + 1;
                document.getElementById('usageCount').textContent = usageCount;

                // Status Duration
                const startDate = new Date('@Model.StartDate');
                const endDate = @(Model.EndDate.HasValue ? $"new Date('{Model.EndDate.Value}')" : "null");

                if (endDate) {
                    const durationMs = endDate - startDate;
                    const durationDays = Math.ceil(durationMs / (1000 * 60 * 60 * 24));
                    document.getElementById('statusDuration').textContent =
                        `${durationDays} days (${Math.ceil(durationDays/30)} months)`;
                } else {
                    document.getElementById('statusDuration').textContent = 'Ongoing (no end date)';
                }
            }

            // Initialize
            loadRelatedInfo();
        });
    </script>
</body>
</html>