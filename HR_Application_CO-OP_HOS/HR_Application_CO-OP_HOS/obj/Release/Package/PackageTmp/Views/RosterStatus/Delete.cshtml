@model HR_Application_CO_OP_HOS.Models.RosterStatu

@{
    ViewBag.Title = "Delete Roster Status";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Roster Status</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Warning Container */
        .warning-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
            border-left: 6px solid #e74c3c;
        }

        .warning-header {
            background: #e74c3c;
            color: white;
            padding: 20px;
        }

        .warning-title {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .warning-body {
            padding: 30px;
        }

        .warning-alert {
            background: #fdf2f2;
            border: 1px solid #f5c6cb;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .warning-icon {
            font-size: 3rem;
            color: #e74c3c;
            margin-bottom: 15px;
        }

        /* Details Container */
        .details-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .details-header {
            background: #34495e;
            color: white;
            padding: 20px;
        }

        .details-title {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .details-body {
            padding: 30px;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .detail-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            border-left: 5px solid #3498db;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.2rem;
            font-weight: 500;
        }

        .detail-value-boolean {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .boolean-true {
            background-color: #27ae60;
            color: white;
        }

        .boolean-false {
            background-color: #e74c3c;
            color: white;
        }

        /* Action Buttons */
        .action-buttons {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ecf0f1;
            text-align: center;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            transition: all 0.3s ease;
            margin-right: 10px;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #bdc3c7 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

            .btn-delete:hover, .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            }

        /* Impact Analysis */
        .impact-analysis {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
            border-left: 6px solid #f39c12;
        }

        .impact-header {
            background: #f39c12;
            color: white;
            padding: 20px;
        }

        .impact-title {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 600;
        }

        .impact-body {
            padding: 20px;
        }

        .impact-item {
            padding: 15px;
            border-bottom: 1px solid #ecf0f1;
            transition: all 0.3s ease;
        }

            .impact-item:hover {
                background-color: #f8f9fa;
            }

        .impact-warning {
            color: #e74c3c;
            font-weight: 600;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 10px;
            }

            .page-title {
                font-size: 2rem;
            }

            .warning-body, .details-body {
                padding: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                text-align: center;
            }

            .btn-delete, .btn-cancel {
                display: block;
                width: 100%;
                margin-bottom: 10px;
                margin-right: 0;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title"><i class="fa fa-trash"></i> Delete Roster Status</h1>
                    <p class="page-subtitle">Remove roster status configuration from the system</p>
                </div>
                <div class="col-md-4 text-end">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-cancel" })
                </div>
            </div>
        </div>

        <!-- Warning Section -->
        <div class="warning-container">
            <div class="warning-header">
                <h3 class="warning-title"><i class="fa fa-exclamation-triangle"></i> Delete Confirmation Required</h3>
            </div>
            <div class="warning-body">
                <div class="warning-alert text-center">
                    <div class="warning-icon">
                        <i class="fa fa-exclamation-circle"></i>
                    </div>
                    <h4 style="color: #e74c3c; margin-bottom: 15px;">Are you sure you want to delete this?</h4>
                    <p class="mb-0" style="font-size: 1.1rem;">
                        You are about to permanently delete the roster status:
                        <strong>"@Model.DayStatusDescription"</strong>. This action cannot be undone.
                    </p>
                </div>

                <!-- Impact Analysis -->
                <div class="impact-analysis">
                    <div class="impact-header">
                        <h3 class="impact-title"><i class="fa fa-line-chart"></i> Impact Analysis</h3>
                    </div>
                    <div class="impact-body">
                        <div class="impact-item">
                            <h6><i class="fa fa-users text-info"></i> Affected Employees</h6>
                            <p class="small mb-0">
                                <span class="impact-warning" id="affectedEmployees">--</span> employees are currently using this roster status
                            </p>
                        </div>
                        <div class="impact-item">
                            <h6><i class="fa fa-calendar text-warning"></i> Schedule Impact</h6>
                            <p class="small mb-0">
                                <span class="impact-warning" id="scheduleImpact">--</span> future schedules will be affected
                            </p>
                        </div>
                        <div class="impact-item">
                            <h6><i class="fa fa-database text-primary"></i> Data Loss</h6>
                            <p class="small mb-0">
                                All configuration data for this roster status will be permanently removed from the system
                            </p>
                        </div>
                        <div class="impact-item">
                            <h6><i class="fa fa-history text-secondary"></i> Audit Trail</h6>
                            <p class="small mb-0">
                                A record of this deletion will be maintained in the system audit logs
                            </p>
                        </div>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="action-buttons">
                        <input type="submit" value="Confirm Delete" class="btn btn-delete" />
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-cancel" })
                    </div>
                }
            </div>
        </div>

        <!-- Details Section -->
        <div class="details-container">
            <div class="details-header">
                <h3 class="details-title"><i class="fa fa-info-circle"></i> Roster Status Details</h3>
            </div>
            <div class="details-body">
                <div class="details-grid">
                    <div class="detail-card">
                        <div class="detail-label">Day Status Description</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.DayStatusDescription)</div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-label">Order Index</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.OrderIndex)</div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-label">Start Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.StartDate)</div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-label">End Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.EndDate)</div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-label">Roster Related</div>
                        <div class="detail-value">
                            @if (Model.RosterRelated == true)
                            {
                                <span class="detail-value-boolean boolean-true">Yes</span>
                            }
                            else
                            {
                                <span class="detail-value-boolean boolean-false">No</span>
                            }
                        </div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-label">Roster Type ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.RosterTypeID)</div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-label">Number of Minutes</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.NoOfMinutes)</div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-label">With Next Day</div>
                        <div class="detail-value">
                            @if (Model.WithNextDay == true)
                            {
                                <span class="detail-value-boolean boolean-true">Yes</span>
                            }
                            else
                            {
                                <span class="detail-value-boolean boolean-false">No</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Load impact analysis data
            function loadImpactAnalysis() {
                // This would typically be AJAX calls to get impact data
                // For demonstration, we'll use sample data

                // Simulate loading affected employees count
                const affectedEmployees = Math.floor(Math.random() * 20) + 1;
                document.getElementById('affectedEmployees').textContent = affectedEmployees;

                // Simulate loading schedule impact
                const scheduleImpact = Math.floor(Math.random() * 50) + 5;
                document.getElementById('scheduleImpact').textContent = scheduleImpact;
            }

            // Add confirmation for delete action
            const deleteForm = document.querySelector('form');
            const deleteButton = deleteForm.querySelector('input[type="submit"]');

            deleteButton.addEventListener('click', function (e) {
                if (!confirm('Are you absolutely sure you want to delete this roster status? This action cannot be undone.')) {
                    e.preventDefault();
                }
            });

            // Initialize
            loadImpactAnalysis();
        });
    </script>
</body>
</html>