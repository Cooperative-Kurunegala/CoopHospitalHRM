@model HR_Application_CO_OP_HOS.Models.CurrentPayrollMonth

@{
    ViewBag.Title = "Delete Payroll Month";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Payroll Month</h1>
            <p class="lead">Remove payroll month configuration from system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Warning Section -->
        <div class="col-12">
            <div class="alert alert-danger">
                <h4><i class="fa fa-exclamation-triangle"></i> Warning!</h4>
                <p class="mb-0">You are about to delete a payroll month configuration. This action cannot be undone and may affect payroll calculations.</p>
            </div>
        </div>

        <!-- Details Section -->
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Payroll Month to Delete</h3>
                </div>
                <div class="panel-body">
                    <div class="delete-details">
                        <div class="detail-row">
                            <div class="detail-label">Month Name:</div>
                            <div class="detail-value">@(Model.MonthName ?? "Not Set")</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Month/Year:</div>
                            <div class="detail-value">@Model.CurrentPayrollMonthValue/@Model.CurrentPayrollYearValue</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Company:</div>
                            <div class="detail-value">
                                @try
                                {
                                    using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                    {
                                        var company = context.Companies.Find(Model.CompanyID);
                                        @(company?.companyName ?? "Not Set")
                                    }
                                }
                                catch
                                {
                                    <text>Error loading company data</text>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Salary Type:</div>
                            <div class="detail-value">
                                @try
                                {
                                    using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                    {
                                        var salaryType = context.SalaryTypes.Find(Model.SalaryTypeID);
                                        @(salaryType?.SalaryTypeName ?? "Not Set")
                                    }
                                }
                                catch
                                {
                                    <text>Error loading salary type data</text>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Status:</div>
                            <div class="detail-value">
                                @if (Model.IsCurrentPayrollMonth == true)
                                {
                                    <span class="badge badge-warning">Current Month</span>
                                }
                                @if (Model.IsClosed == true) 
                                {
                                    <span class="badge badge-danger ml-1">Closed</span>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Duration:</div>
                            <div class="detail-value">
                                @if (Model.DurationFrom.HasValue && Model.DurationTo.HasValue)
                                {
                                    <text>@Model.DurationFrom.Value.ToString("MMM dd, yyyy") - @Model.DurationTo.Value.ToString("MMM dd, yyyy")</text>
                                }
                                else
                                {
                                    <span class="text-muted">Not Set</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Impact Analysis -->
        <div class="col-md-4">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-circle"></i> Delete Impact</h3>
                </div>
                <div class="panel-body">
                    <div class="impact-list">
                        <div class="impact-item">
                            <i class="fa fa-times-circle text-danger"></i>
                            <span>Payroll calculations for this period</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-times-circle text-danger"></i>
                            <span>Employee salary records</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-times-circle text-danger"></i>
                            <span>Attendance calculations</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-times-circle text-danger"></i>
                            <span>Financial reports</span>
                        </div>
                    </div>

                    <div class="confirmation-check mt-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="confirmDelete">
                            <label class="form-check-label" for="confirmDelete">
                                I understand this action cannot be undone
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-body text-center">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="action-buttons">
                            <button type="submit" class="btn btn-danger btn-lg" id="deleteButton" disabled>
                                <i class="fa fa-trash"></i> Confirm Delete
                            </button>
                            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Enable delete button only when confirmation is checked
            $('#confirmDelete').change(function () {
                $('#deleteButton').prop('disabled', !$(this).is(':checked'));
            });

            // Confirm delete action
            $('#deleteButton').click(function (e) {
                if (!confirm('Are you absolutely sure you want to delete this payroll month? This action cannot be undone.')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #e74c3c 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .alert {
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .delete-details {
        display: flex;
        flex-direction: column;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #2c3e50;
        min-width: 150px;
    }

    .detail-value {
        color: #34495e;
        text-align: right;
    }

    .badge {
        font-size: 0.85rem;
        padding: 5px 10px;
    }

    .impact-list {
        display: flex;
        flex-direction: column;
    }

    .impact-item {
        display: flex;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .impact-item:last-child {
            border-bottom: none;
        }

        .impact-item i {
            margin-right: 10px;
            font-size: 1.2rem;
        }

    .confirmation-check {
        padding: 15px;
        background-color: #fff3cd;
        border-radius: 8px;
        border: 1px solid #ffeaa7;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-right: 10px;
    }

    .form-check-label {
        font-weight: 600;
        color: #856404;
    }

    .action-buttons .btn {
        margin: 0 10px;
        padding: 12px 30px;
        font-weight: 600;
        min-width: 150px;
    }

    #deleteButton:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .text-muted {
        font-style: italic;
    }

    @@media (max-width: 768px) {
        .detail-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .detail-label {
            margin-bottom: 5px;
        }

        .detail-value {
            text-align: left;
        }

        .action-buttons .btn {
            display: block;
            width: 100%;
            margin: 10px 0;
        }
    }
</style>