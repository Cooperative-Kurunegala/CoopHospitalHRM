@model IEnumerable<HR_Application_CO_OP_HOS.Models.CurrentPayrollMonth>

@{
    ViewBag.Title = "Current Payroll Months";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-calendar"></i> Current Payroll Months</h1>
            <p class="lead">Manage payroll month configurations and settings</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-block" })
                        </div>
                        <div class="col-md-9">
                            <div class="row no-gutters">
                                <div class="col-md-4">
                                    <input type="text" id="searchInput" class="form-control" placeholder="Search payroll months..." />
                                </div>
                                <div class="col-md-4">
                                    <select id="companyFilter" class="form-control">
                                        <option value="">All Companies</option>
                                        @try
                                        {
                                            var companies = new List<HR_Application_CO_OP_HOS.Models.Company>();
                                            using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                            {
                                                companies = context.Companies.ToList();
                                            }
                                            foreach (var company in companies)
                                            {
                                                <option value="@company.ID">@company.companyName</option>
                                            }
                                        }
                                        catch (Exception ex)
                                        {
                                            <option value="">Error loading companies</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select id="statusFilter" class="form-control">
                                        <option value="">All Status</option>
                                        <option value="true">Current Month</option>
                                        <option value="false">Not Current</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-table"></i> Payroll Months List</h3>
                </div>
                <div class="panel-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="payrollTable">
                                <thead>
                                    <tr>
                                        <th>Month Name</th>
                                        <th>Month Value</th>
                                        <th>Year Value</th>
                                        <th>Company</th>
                                        <th>Salary Type</th>
                                        <th>Current Month</th>
                                        <th>Closed</th>
                                        <th>Duration</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => item.MonthName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.CurrentPayrollMonthValue)</td>
                                            <td>@Html.DisplayFor(modelItem => item.CurrentPayrollYearValue)</td>
                                            <td>
                                                @try
                                                {
                                                    using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                                    {
                                                        var company = context.Companies.Find(item.CompanyID);
                                                        @(company?.companyName ?? "N/A")
                                                    }
                                                }
                                                catch
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @try
                                                {
                                                    using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                                    {
                                                        var salaryType = context.SalaryTypes.Find(item.SalaryTypeID);
                                                        @(salaryType?.SalaryTypeName ?? "N/A")
                                                    }
                                                }
                                                catch
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsCurrentPayrollMonth == true)
                                                {
                                                    <span class="badge badge-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsClosed == true)
                                                {
                                                    <span class="badge badge-danger">Closed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">Open</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.DurationFrom.HasValue && item.DurationTo.HasValue)
                                                {
                                                    @item.DurationFrom.Value.ToString("MM/dd/yyyy") <text>-</text> @item.DurationTo.Value.ToString("MM/dd/yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Set</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fa fa-exclamation-triangle"></i> No payroll months found.
                            @Html.ActionLink("Create the first payroll month", "Create")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#payrollTable tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Company filter
            $('#companyFilter').on('change', function () {
                var value = $(this).val().toLowerCase();
                $('#payrollTable tbody tr').filter(function () {
                    $(this).toggle(value === '' || $(this).find('td:eq(3)').text().toLowerCase().indexOf(value) > -1);
                });
            });

            // Status filter
            $('#statusFilter').on('change', function () {
                var value = $(this).val();
                $('#payrollTable tbody tr').filter(function () {
                    if (value === '') return true;
                    var isCurrent = $(this).find('td:eq(5)').text().trim().toLowerCase() === 'yes';
                    return (value === 'true' && isCurrent) || (value === 'false' && !isCurrent);
                });
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .table th {
        background-color: #34495e;
        color: white;
        border: none;
        padding: 15px;
    }

    .table td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .badge {
        font-size: 0.85em;
        padding: 5px 10px;
    }

    .btn-group .btn {
        margin: 2px;
    }

    .alert {
        border-radius: 10px;
        padding: 20px;
    }
</style>