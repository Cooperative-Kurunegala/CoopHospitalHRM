@model HR_Application_CO_OP_HOS.Models.CurrentPayrollMonth

@{
    ViewBag.Title = "Payroll Month Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-eye"></i> Payroll Month Details</h1>
            <p class="lead">View detailed information about payroll month configuration</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Details -->
        <div class="col-md-8">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Payroll Month Information</h3>
                </div>
                <div class="panel-body">
                    <div class="detail-section">
                        <div class="detail-row">
                            <div class="detail-label">Month Name:</div>
                            <div class="detail-value">@(Model.MonthName ?? "Not Set")</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Month Value:</div>
                            <div class="detail-value">@Model.CurrentPayrollMonthValue</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Year Value:</div>
                            <div class="detail-value">@Model.CurrentPayrollYearValue</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Company:</div>
                            <div class="detail-value">
                                @try
                                {
                                    using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                    {
                                        var company = context.Companies.Find(Model.CompanyID);
                                        <text>@(company?.companyName ?? "Not Set") (ID: @Model.CompanyID)</text>
                                    }
                                }
                                catch
                                {
                                    <text>Error loading company data</text>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Salary Type:</div>
                            <div class="detail-value">
                                @try
                                {
                                    using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                    {
                                        var salaryType = context.SalaryTypes.Find(Model.SalaryTypeID);
                                        <text>@(salaryType?.SalaryTypeName ?? "Not Set") (ID: @Model.SalaryTypeID)</text>
                                    }
                                }
                                catch
                                {
                                    <text>Error loading salary type data</text>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Current Payroll Month:</div>
                            <div class="detail-value">
                                @if (Model.IsCurrentPayrollMonth == true)
                                {
                                    <span class="badge badge-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">No</span>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Closed Status:</div>
                            <div class="detail-value">
                                @if (Model.IsClosed == true)
                                {
                                    <span class="badge badge-danger">Closed</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Open</span>
                                }
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Duration:</div>
                            <div class="detail-value">
                                @if (Model.DurationFrom.HasValue && Model.DurationTo.HasValue)
                                {
                                    <text>@Model.DurationFrom.Value.ToString("MMM dd, yyyy") - @Model.DurationTo.Value.ToString("MMM dd, yyyy")</text>
                                    <br />
                                    <small class="text-muted">
                                        @((Model.DurationTo.Value - Model.DurationFrom.Value).Days + 1) days
                                    </small>
                                }
                                else
                                {
                                    <span class="text-muted">Not Set</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions & Related Info -->
        <div class="col-md-4">
            <!-- Actions -->
            <div class="panel panel-primary mb-4">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-cogs"></i> Actions</h3>
                </div>
                <div class="panel-body text-center">
                    <div class="action-buttons">
                        @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-block mb-2" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-block mb-2" })
                        @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-block" })
                    </div>
                </div>
            </div>

            <!-- Status Information -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bar-chart"></i> Status Overview</h3>
                </div>
                <div class="panel-body">
                    <div class="status-item">
                        <div class="status-indicator @(Model.IsCurrentPayrollMonth == true ? "active" : "inactive")"></div>
                        <div class="status-text">
                            <strong>Current Payroll Month</strong>
                            <small>@(Model.IsCurrentPayrollMonth == true ? "Active" : "Inactive")</small>
                        </div>
                    </div>

                    <div class="status-item">
                        <div class="status-indicator @(Model.IsClosed == true ? "closed" : "open")"></div>
                        <div class="status-text">
                            <strong>Month Status</strong>
                            <small>@(Model.IsClosed == true ? "Closed" : "Open")</small>
                        </div>
                    </div>

                    <div class="status-item">
                        <div class="status-indicator @(Model.DurationFrom.HasValue && Model.DurationTo.HasValue ? "valid" : "invalid")"></div>
                        <div class="status-text">
                            <strong>Duration Set</strong>
                            <small>@(Model.DurationFrom.HasValue && Model.DurationTo.HasValue ? "Yes" : "No")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Information -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> System Information</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-4 text-center">
                            <div class="system-info-item">
                                <i class="fa fa-database fa-2x"></i>
                                <h5>Record ID</h5>
                                <p>@Model.ID</p>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="system-info-item">
                                <i class="fa fa-calendar fa-2x"></i>
                                <h5>Payroll Period</h5>
                                <p>@Model.CurrentPayrollMonthValue/@Model.CurrentPayrollYearValue</p>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="system-info-item">
                                <i class="fa fa-calculator fa-2x"></i>
                                <h5>Configuration</h5>
                                <p>@(Model.IsClosed == true ? "Locked" : "Editable")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .detail-section {
        display: flex;
        flex-direction: column;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 15px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: #2c3e50;
        min-width: 200px;
    }

    .detail-value {
        color: #34495e;
        text-align: right;
        flex: 1;
    }

    .badge {
        font-size: 0.9rem;
        padding: 6px 12px;
    }

    .action-buttons .btn {
        margin: 5px 0;
        padding: 12px;
        font-weight: 600;
    }

    .status-item {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .status-item:last-child {
            border-bottom: none;
        }

    .status-indicator {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-right: 15px;
    }

        .status-indicator.active {
            background-color: #27ae60;
        }

        .status-indicator.inactive {
            background-color: #95a5a6;
        }

        .status-indicator.open {
            background-color: #27ae60;
        }

        .status-indicator.closed {
            background-color: #e74c3c;
        }

        .status-indicator.valid {
            background-color: #3498db;
        }

        .status-indicator.invalid {
            background-color: #f39c12;
        }

    .status-text small {
        color: #7f8c8d;
        display: block;
    }

    .system-info-item {
        padding: 20px;
    }

        .system-info-item i {
            color: #3498db;
            margin-bottom: 10px;
        }

        .system-info-item h5 {
            color: #2c3e50;
            margin: 10px 0;
        }

        .system-info-item p {
            color: #7f8c8d;
            font-weight: 600;
            margin: 0;
        }

    .text-muted {
        font-style: italic;
    }

    @@media (max-width: 768px) {
        .detail-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .detail-label {
            margin-bottom: 5px;
        }

        .detail-value {
            text-align: left;
        }
    }
</style>