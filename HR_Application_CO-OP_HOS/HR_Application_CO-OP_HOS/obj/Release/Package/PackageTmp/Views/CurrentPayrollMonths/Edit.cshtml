@model HR_Application_CO_OP_HOS.Models.CurrentPayrollMonth

@{
    ViewBag.Title = "Edit Payroll Month";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Payroll Month</h1>
            <p class="lead">Update payroll month configuration</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Edit Payroll Month Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.MonthName, htmlAttributes: new { @class = "control-label" })
                                @Html.EditorFor(model => model.MonthName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter month name" } })
                                @Html.ValidationMessageFor(model => model.MonthName, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.CurrentPayrollMonthValue, htmlAttributes: new { @class = "control-label" })
                                @Html.EditorFor(model => model.CurrentPayrollMonthValue, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter month value (1-12)" } })
                                @Html.ValidationMessageFor(model => model.CurrentPayrollMonthValue, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.CurrentPayrollYearValue, htmlAttributes: new { @class = "control-label" })
                                @Html.EditorFor(model => model.CurrentPayrollYearValue, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter year value" } })
                                @Html.ValidationMessageFor(model => model.CurrentPayrollYearValue, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.CompanyID, htmlAttributes: new { @class = "control-label" })
                                <select id="CompanyID" name="CompanyID" class="form-control" required>
                                    <option value="">Select Company</option>
                                    @try
                                    {
                                        var companies = new List<HR_Application_CO_OP_HOS.Models.Company>();
                                        using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                        {
                                            companies = context.Companies.Where(c => c.ID > 0).ToList();
                                        }
                                        foreach (var company in companies)
                                        {
                                            <option value="@company.ID" selected="@(company.ID == Model.CompanyID)">@company.companyName</option>
                                        }
                                    }
                                    catch (Exception ex)
                                    {
                                        <option value="">Error loading companies</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(model => model.CompanyID, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.SalaryTypeID, htmlAttributes: new { @class = "control-label" })
                                <select id="SalaryTypeID" name="SalaryTypeID" class="form-control" required>
                                    <option value="">Select Salary Type</option>
                                    @try
                                    {
                                        var salaryTypes = new List<HR_Application_CO_OP_HOS.Models.SalaryType>();
                                        using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                        {
                                            salaryTypes = context.SalaryTypes.Where(st => st.ID > 0).ToList();
                                        }
                                        foreach (var salaryType in salaryTypes)
                                        {
                                            <option value="@salaryType.ID" selected="@(salaryType.ID == Model.SalaryTypeID)">@salaryType.SalaryTypeName</option>
                                        }
                                    }
                                    catch (Exception ex)
                                    {
                                        <option value="">Error loading salary types</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(model => model.SalaryTypeID, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.DurationFrom, htmlAttributes: new { @class = "control-label" })
                                @Html.EditorFor(model => model.DurationFrom, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                @Html.ValidationMessageFor(model => model.DurationFrom, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(model => model.DurationTo, htmlAttributes: new { @class = "control-label" })
                                @Html.EditorFor(model => model.DurationTo, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                @Html.ValidationMessageFor(model => model.DurationTo, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group col-md-3">
                                <div class="form-check">
                                    @Html.EditorFor(model => model.IsCurrentPayrollMonth, new { htmlAttributes = new { @class = "form-check-input" } })
                                    @Html.LabelFor(model => model.IsCurrentPayrollMonth, htmlAttributes: new { @class = "form-check-label" })
                                    @Html.ValidationMessageFor(model => model.IsCurrentPayrollMonth, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-3">
                                <div class="form-check">
                                    @Html.EditorFor(model => model.IsClosed, new { htmlAttributes = new { @class = "form-check-input" } })
                                    @Html.LabelFor(model => model.IsClosed, htmlAttributes: new { @class = "form-check-label" })
                                    @Html.ValidationMessageFor(model => model.IsClosed, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="fa fa-save"></i> Update Payroll Month
                            </button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            @Html.ActionLink("Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Current Data & Reference Section -->
        <div class="col-md-4">
            <!-- Current Data -->
            <div class="panel panel-info mb-4">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Current Data</h3>
                </div>
                <div class="panel-body">
                    <div class="current-data-item">
                        <strong>Month Name:</strong>
                        <span>@(Model.MonthName ?? "Not Set")</span>
                    </div>
                    <div class="current-data-item">
                        <strong>Month/Year:</strong>
                        <span>@Model.CurrentPayrollMonthValue/@Model.CurrentPayrollYearValue</span>
                    </div>
                    <div class="current-data-item">
                        <strong>Company:</strong>
                        <span>
                            @try
                            {
                                using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                {
                                    var company = context.Companies.Find(Model.CompanyID);
                                    @(company?.companyName ?? "Not Set")
                                }
                            }
                            catch
                            {
                                <span class="text-muted">Error loading</span>
                            }
                        </span>
                    </div>
                    <div class="current-data-item">
                        <strong>Salary Type:</strong>
                        <span>
                            @try
                            {
                                using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                {
                                    var salaryType = context.SalaryTypes.Find(Model.SalaryTypeID);
                                    @(salaryType?.SalaryTypeName ?? "Not Set")
                                }
                            }
                            catch
                            {
                                <span class="text-muted">Error loading</span>
                            }
                        </span>
                    </div>
                    <div class="current-data-item">
                        <strong>Status:</strong>
                        <span>
                            @if (Model.IsCurrentPayrollMonth == true)
                            {
                                <span class="badge badge-success">Current Month</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Not Current</span>
                            }
                            @if (Model.IsClosed == true)
                            {
                                <span class="badge badge-danger ml-1">Closed</span>
                            }
                            else
                            {
                                <span class="badge badge-success ml-1">Open</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <!-- Reference Data -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-database"></i> Reference Data</h3>
                </div>
                <div class="panel-body">
                    <div class="reference-section">
                        <h5><i class="fa fa-building"></i> Companies</h5>
                        <div class="reference-list">
                            @try
                            {
                                var companies = new List<HR_Application_CO_OP_HOS.Models.Company>();
                                using (var context = new HR_Application_CO_OP_HOS.Models.HREntities())
                                {
                                    companies = context.Companies.Where(c => c.ID > 0).ToList();
                                }
                                if (companies.Any())
                                {
                                    foreach (var company in companies.Take(5))
                                    {
                                        <div class="reference-item @(company.ID == Model.CompanyID ? "active" : "")">
                                            <strong>@company.companyName</strong>
                                            <small class="text-muted">ID: @company.ID</small>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted">No companies found</div>
                                }
                            }
                            catch (Exception ex)
                            {
                                <div class="text-danger">Error loading companies</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Auto-calculate duration based on month and year
            $('#CurrentPayrollMonthValue, #CurrentPayrollYearValue').on('change', function() {
                var month = parseInt($('#CurrentPayrollMonthValue').val());
                var year = parseInt($('#CurrentPayrollYearValue').val());

                if (month >= 1 && month <= 12 && year >= 2000 && year <= 2100) {
                    var durationFrom = new Date(year, month - 1, 1);
                    var durationTo = new Date(year, month, 0);

                    $('#DurationFrom').val(durationFrom.toISOString().split('T')[0]);
                    $('#DurationTo').val(durationTo.toISOString().split('T')[0]);

                    // Auto-set month name
                    var monthNames = ["January", "February", "March", "April", "May", "June",
                                      "July", "August", "September", "October", "November", "December"];
                    $('#MonthName').val(monthNames[month - 1] + ' ' + year);
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #f39c12 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .current-data-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .current-data-item:last-child {
            border-bottom: none;
        }

    .reference-list {
        max-height: 150px;
        overflow-y: auto;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 10px;
    }

    .reference-item {
        padding: 8px 12px;
        border-bottom: 1px solid #f8f9fa;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 5px;
        margin-bottom: 5px;
    }

        .reference-item.active {
            background-color: #3498db;
            color: white;
        }

        .reference-item:last-child {
            border-bottom: none;
        }

    .btn-lg {
        padding: 12px 30px;
        font-size: 1.1rem;
        margin: 5px;
    }

    .badge {
        font-size: 0.8rem;
        padding: 4px 8px;
    }
</style>