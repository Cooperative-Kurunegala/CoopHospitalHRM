﻿@model HR_Application_CO_OP_HOS.Models.EmployeeQualification

@{
    ViewBag.Title = "Create Employee Qualification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="fullscreen-container dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">CREATE EMPLOYEE QUALIFICATION</h1>
            <p class="hospital-subtitle">Hospital Human Resources System</p>
            <div class="admin-info">
                <span class="admin-welcome">Add New Qualification Record</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="dashboard-section">
        <div class="section-header">
            <h2>🎓 NEW QUALIFICATION RECORD</h2>
        </div>
        <div class="section-content">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-container">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="form-grid">
                        <div class="form-group">
                            @Html.LabelFor(model => model.EmployeeID, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.EmployeeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Employee ID" } })
                            @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Qualification, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.Qualification, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Qualification Name" } })
                            @Html.ValidationMessageFor(model => model.Qualification, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Institution, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.Institution, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Institution Name" } })
                            @Html.ValidationMessageFor(model => model.Institution, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Year, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Year", type = "number", min = "1900", max = "2100" } })
                            @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Grade, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.Grade, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Grade/Marks" } })
                            @Html.ValidationMessageFor(model => model.Grade, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.DocumentPath, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.DocumentPath, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Document Path/URL" } })
                            @Html.ValidationMessageFor(model => model.DocumentPath, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group checkbox-group">
                            <div class="form-check">
                                @Html.EditorFor(model => model.IsVerified, new { htmlAttributes = new { @class = "form-check-input" } })
                                @Html.LabelFor(model => model.IsVerified, htmlAttributes: new { @class = "form-check-label" })
                                @Html.ValidationMessageFor(model => model.IsVerified, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.VerifiedBy, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.VerifiedBy, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Verifier ID" } })
                            @Html.ValidationMessageFor(model => model.VerifiedBy, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.VerifiedDate, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.VerifiedDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            @Html.ValidationMessageFor(model => model.VerifiedDate, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-success btn-lg">
                            <span class="btn-icon">💾</span> Create Qualification
                        </button>
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .fullscreen-container {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .dashboard-header {
        background: linear-gradient(135deg, #006400 0%, #228B22 100%);
        color: white;
        padding: 25px 20px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .hospital-name {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 8px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .hospital-subtitle {
        font-size: 1.1rem;
        margin-bottom: 15px;
        opacity: 0.9;
    }

    .admin-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1rem;
        background: rgba(255,255,255,0.1);
        padding: 12px 18px;
        border-radius: 8px;
        margin-top: 15px;
    }

    .dashboard-section {
        background: white;
        margin: 15px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .section-header {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        padding: 18px;
        border-bottom: 3px solid #006400;
    }

        .section-header h2 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: bold;
        }

    .section-content {
        padding: 25px;
    }

    .form-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 0;
    }

    .checkbox-group {
        grid-column: 1 / -1;
    }

    .form-label {
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 8px;
        display: block;
        font-size: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 2px solid #ddd;
        border-radius: 6px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background: #f8f9fa;
    }

        .form-control:focus {
            border-color: #006400;
            box-shadow: 0 0 0 0.2rem rgba(0, 100, 0, 0.25);
            background: white;
        }

    .form-check {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 6px;
        border: 1px solid #ddd;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
    }

    .form-check-label {
        margin: 0;
        font-weight: normal;
        font-size: 1rem;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
    }

    .btn {
        padding: 12px 30px;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-success {
        background: #28a745;
        color: white;
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .alert {
        padding: 12px 18px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .text-danger {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
        font-weight: 500;
    }

    @@media (max-width: 768px) {
        .hospital-name {
            font-size: 1.6rem;
        }

        .admin-info {
            flex-direction: column;
            gap: 8px;
            font-size: 0.9rem;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .form-actions {
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            width: 100%;
            justify-content: center;
            padding: 10px 25px;
        }

        .section-content {
            padding: 20px;
        }
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}