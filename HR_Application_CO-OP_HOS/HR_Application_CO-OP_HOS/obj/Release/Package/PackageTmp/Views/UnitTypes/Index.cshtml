@model IEnumerable<HR_Application_CO_OP_HOS.Models.UnitType>

@{
    ViewBag.Title = "Unit Types Management";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Unit Types</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            padding: 0 !important;
            margin: 0 !important;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 20px;
            margin: 0;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 20px -20px;
            border-radius: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Action Buttons */
        .action-buttons {
            margin-bottom: 25px;
        }

        .btn {
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            border: none;
            font-size: 1.1rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
        }

        .btn-success {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            color: white;
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Table Styling */
        .table-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .table {
            width: 100%;
            margin-bottom: 0;
            font-size: 1.1rem;
        }

            .table th {
                background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
                color: white;
                padding: 20px;
                font-weight: 600;
                border: none;
                font-size: 1.2rem;
            }

            .table td {
                padding: 18px 20px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: middle;
            }

            .table tbody tr {
                transition: all 0.3s ease;
            }

                .table tbody tr:hover {
                    background-color: #f8f9fa;
                    transform: translateX(5px);
                }

        /* Action Links */
        .action-links a {
            color: #3498db;
            text-decoration: none;
            margin: 0 8px;
            padding: 8px 15px;
            border-radius: 6px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

            .action-links a:hover {
                background-color: #3498db;
                color: white;
                text-decoration: none;
            }

        /* Filter Section */
        .filter-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .filter-title {
            font-size: 1.4rem;
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .form-control {
            padding: 12px 15px;
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 60px 20px;
            color: #7f8c8d;
            font-size: 1.3rem;
        }

            .no-records i {
                font-size: 4rem;
                margin-bottom: 20px;
                color: #bdc3c7;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .table th,
            .table td {
                padding: 12px 8px;
                font-size: 1rem;
            }

            .action-links a {
                display: block;
                margin: 5px 0;
                text-align: center;
            }
        }

        /* Checkbox styling */
        .checkbox {
            transform: scale(1.3);
            margin: 0 10px;
        }

        /* Status badges */
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .status-active {
            background-color: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background-color: #f8d7da;
            color: #721c24;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-cubes"></i> Unit Types Management
            </h1>
            <p class="page-subtitle">Manage and organize different unit types in the system</p>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a href="@Url.Action("Create")" class="btn btn-success">
                <i class="fa fa-plus"></i> Create New Unit Type
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                <i class="fa fa-dashboard"></i> Back to Dashboard
            </a>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <h3 class="filter-title"><i class="fa fa-filter"></i> Filter Unit Types</h3>
            <div class="row">
                <div class="col-md-4">
                    <input type="text" id="nameFilter" class="form-control" placeholder="Filter by Name..." onkeyup="filterTable()">
                </div>
                <div class="col-md-4">
                    <input type="text" id="codeFilter" class="form-control" placeholder="Filter by Code..." onkeyup="filterTable()">
                </div>
                <div class="col-md-4">
                    <select id="boxItemFilter" class="form-control" onchange="filterTable()">
                        <option value="">All Box Items</option>
                        <option value="true">Box Items</option>
                        <option value="false">Non-Box Items</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Table Container -->
        <div class="table-container">
            @if (Model != null && Model.Any())
            {
                <table class="table" id="unitTypesTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Is Box Item</th>
                            <th>Unit Type Code</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                                <td>
                                    @if (item.IsBoxItem == true)
                                    {
                                        <span class="status-badge status-active">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">No</span>
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.UnitTypeCode)</td>
                                <td class="action-links">
                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="no-records">
                    <i class="fa fa-cubes"></i>
                    <h3>No Unit Types Found</h3>
                    <p>There are no unit types available in the system.</p>
                    <a href="@Url.Action("Create")" class="btn btn-success">
                        <i class="fa fa-plus"></i> Create First Unit Type
                    </a>
                </div>
            }
        </div>
    </div>

    <script>
        function filterTable() {
            var nameFilter = document.getElementById('nameFilter').value.toLowerCase();
            var codeFilter = document.getElementById('codeFilter').value.toLowerCase();
            var boxItemFilter = document.getElementById('boxItemFilter').value;

            var table = document.getElementById('unitTypesTable');
            if (!table) return;

            var tr = table.getElementsByTagName('tr');

            for (var i = 1; i < tr.length; i++) {
                var tdName = tr[i].getElementsByTagName('td')[0];
                var tdCode = tr[i].getElementsByTagName('td')[3];
                var tdBoxItem = tr[i].getElementsByTagName('td')[2];

                if (tdName && tdCode && tdBoxItem) {
                    var nameValue = tdName.textContent || tdName.innerText;
                    var codeValue = tdCode.textContent || tdCode.innerText;
                    var boxItemValue = tdBoxItem.textContent || tdBoxItem.innerText;
                    var isBoxItem = boxItemValue.toLowerCase().includes('yes');

                    var nameMatch = nameValue.toLowerCase().indexOf(nameFilter) > -1;
                    var codeMatch = codeValue.toLowerCase().indexOf(codeFilter) > -1;
                    var boxItemMatch = boxItemFilter === '' ||
                        (boxItemFilter === 'true' && isBoxItem) ||
                        (boxItemFilter === 'false' && !isBoxItem);

                    if (nameMatch && codeMatch && boxItemMatch) {
                        tr[i].style.display = '';
                    } else {
                        tr[i].style.display = 'none';
                    }
                }
            }
        }

        // Exception handling for table operations
        try {
            document.addEventListener('DOMContentLoaded', function () {
                console.log('Unit Types page loaded successfully');
            });
        } catch (error) {
            console.error('Error initializing unit types page:', error);
        }
    </script>
</body>
</html>