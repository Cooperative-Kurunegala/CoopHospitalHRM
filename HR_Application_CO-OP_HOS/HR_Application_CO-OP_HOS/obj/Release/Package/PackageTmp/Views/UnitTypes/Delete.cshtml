@model HR_Application_CO_OP_HOS.Models.UnitType

@{
    ViewBag.Title = "Delete Unit Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Unit Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            padding: 0 !important;
            margin: 0 !important;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 20px;
            margin: 0;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 20px -20px;
            border-radius: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Warning Container */
        .warning-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 20px;
            border-left: 6px solid #e74c3c;
        }

        /* Warning Message */
        .warning-message {
            background: linear-gradient(135deg, #fdf2f2 0%, #f8d7da 100%);
            border: 2px solid #f5c6cb;
            border-radius: 8px;
            padding: 25px;
            margin-bottom: 25px;
            text-align: center;
        }

            .warning-message h3 {
                color: #721c24;
                margin-bottom: 15px;
                font-weight: 600;
            }

            .warning-message i {
                font-size: 3rem;
                color: #e74c3c;
                margin-bottom: 15px;
            }

        /* Details Container */
        .details-container {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .dl-horizontal {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 10px;
        }

        .detail-item {
            display: contents;
        }

        dt {
            font-weight: 600;
            color: #2c3e50;
            padding: 10px;
        }

        dd {
            margin: 0;
            padding: 10px;
            background: white;
            border-radius: 6px;
        }

        /* Buttons */
        .btn {
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            border: none;
            font-size: 1.1rem;
            margin-right: 10px;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn-default {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Action Buttons */
        .action-buttons {
            text-align: center;
            margin-top: 30px;
        }

        /* Impact Warning */
        .impact-warning {
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
            border: 2px solid #ffeaa7;
            border-radius: 8px;
            padding: 20px;
            margin-top: 25px;
        }

            .impact-warning h5 {
                color: #856404;
                margin-bottom: 10px;
                font-weight: 600;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .warning-container {
                padding: 20px;
            }

            .dl-horizontal {
                grid-template-columns: 1fr;
            }

            .action-buttons .btn {
                display: block;
                width: 100%;
                margin-bottom: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-trash"></i> Delete Unit Type
            </h1>
            <p class="page-subtitle">Remove unit type from the system</p>
        </div>

        <!-- Warning Container -->
        <div class="warning-container">
            <!-- Warning Message -->
            <div class="warning-message">
                <i class="fa fa-exclamation-triangle"></i>
                <h3>Are you sure you want to delete this unit type?</h3>
                <p>This action cannot be undone. Please review the details below before proceeding.</p>
            </div>

            <!-- Impact Warning -->
            <div class="impact-warning">
                <h5><i class="fa fa-warning"></i> Important Notice</h5>
                <p>Deleting this unit type may affect related inventory items and system functionality. Make sure this unit type is not being used elsewhere in the system before proceeding.</p>
            </div>

            <!-- Details Container -->
            <div class="details-container">
                <h4>Unit Type Details</h4>
                <div class="dl-horizontal">
                    <div class="detail-item">
                        <dt>@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd>@Html.DisplayFor(model => model.Name)</dd>
                    </div>

                    <div class="detail-item">
                        <dt>@Html.DisplayNameFor(model => model.Description)</dt>
                        <dd>
                            @if (string.IsNullOrEmpty(Model.Description))
                            {
                                <span class="text-muted">No description</span>
                            }
                            else
                            {
                                @Html.DisplayFor(model => model.Description)
                            }
                        </dd>
                    </div>

                    <div class="detail-item">
                        <dt>@Html.DisplayNameFor(model => model.IsBoxItem)</dt>
                        <dd>@(Model.IsBoxItem == true ? "Yes" : "No")</dd>
                    </div>

                    <div class="detail-item">
                        <dt>@Html.DisplayNameFor(model => model.UnitTypeCode)</dt>
                        <dd>
                            @if (string.IsNullOrEmpty(Model.UnitTypeCode))
                            {
                                <span class="text-muted">No code</span>
                            }
                            else
                            {
                                @Html.DisplayFor(model => model.UnitTypeCode)
                            }
                        </dd>
                    </div>

                    <div class="detail-item">
                        <dt>Record ID</dt>
                        <dd><code>@Model.ID</code></dd>
                    </div>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="action-buttons">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                </div>
            }
        </div>
    </div>

    <script>
        // Delete confirmation enhancement
        try {
            document.addEventListener('DOMContentLoaded', function () {
                const deleteForm = document.querySelector('form');
                const deleteButton = document.querySelector('input[type="submit"]');

                if (deleteForm && deleteButton) {
                    deleteForm.addEventListener('submit', function (e) {
                        const isConfirmed = confirm('Are you absolutely sure you want to delete this unit type? This action cannot be undone.');
                        if (!isConfirmed) {
                            e.preventDefault();
                        } else {
                            deleteButton.disabled = true;
                            deleteButton.value = 'Deleting...';
                        }
                    });
                }

                console.log('Delete Unit Type page initialized successfully');
            });
        } catch (error) {
            console.error('Error initializing delete page:', error);
        }
    </script>
</body>
</html>