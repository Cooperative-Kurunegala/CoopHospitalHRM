@model HR_Application_CO_OP_HOS.Models.UnitType

@{
    ViewBag.Title = "Edit Unit Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Unit Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <style>
        /* Full Screen Layout */
        body {
            padding: 0 !important;
            margin: 0 !important;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 20px;
            margin: 0;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 20px -20px;
            border-radius: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Form Container */
        .form-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 20px;
        }

        /* Form Styling */
        .form-horizontal {
            max-width: 100%;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .control-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            padding: 12px 15px;
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            width: 100%;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .checkbox {
            transform: scale(1.5);
            margin: 10px;
        }

        /* Validation */
        .text-danger {
            color: #e74c3c;
            font-size: 1rem;
            margin-top: 5px;
            display: block;
        }

        .field-validation-error {
            background-color: #f8d7da;
            color: #721c24;
            padding: 8px 12px;
            border-radius: 6px;
            display: inline-block;
            margin-top: 5px;
        }

        /* Buttons */
        .btn {
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            border: none;
            font-size: 1.1rem;
            margin-right: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
        }

        .btn-default {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Action Buttons */
        .action-buttons {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ecf0f1;
        }

        /* Current Values Panel */
        .current-values {
            background: linear-gradient(135deg, #e8f6f3 0%, #d1f2eb 100%);
            border-left: 4px solid #27ae60;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
        }

            .current-values h4 {
                color: #2c3e50;
                margin-bottom: 15px;
                font-weight: 600;
            }

        .value-item {
            margin-bottom: 10px;
            padding: 8px;
            background: white;
            border-radius: 6px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .form-container {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-edit"></i> Edit Unit Type
            </h1>
            <p class="page-subtitle">Update unit type information</p>
        </div>

        <!-- Current Values Panel -->
        <div class="current-values">
            <h4><i class="fa fa-info-circle"></i> Current Values</h4>
            <div class="value-item">
                <strong>Name:</strong> @Model.Name
            </div>
            <div class="value-item">
                <strong>Description:</strong> @(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)
            </div>
            <div class="value-item">
                <strong>Is Box Item:</strong> @(Model.IsBoxItem == true ? "Yes" : "No")
            </div>
            <div class="value-item">
                <strong>Unit Type Code:</strong> @(string.IsNullOrEmpty(Model.UnitTypeCode) ? "No code" : Model.UnitTypeCode)
            </div>
        </div>

        <!-- Form Container -->
        <div class="form-container">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.ID)

                    <div class="form-group">
                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label" })
                        <div>
                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter unit type name" } })
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label" })
                        <div>
                            @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter description" } })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.IsBoxItem, htmlAttributes: new { @class = "control-label" })
                        <div>
                            <div class="checkbox">
                                @Html.EditorFor(model => model.IsBoxItem)
                                @Html.ValidationMessageFor(model => model.IsBoxItem, "", new { @class = "text-danger" })
                            </div>
                            <small class="text-muted">Check this if this unit type represents a box containing multiple items</small>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.UnitTypeCode, htmlAttributes: new { @class = "control-label" })
                        <div>
                            @Html.EditorFor(model => model.UnitTypeCode, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter unit type code" } })
                            @Html.ValidationMessageFor(model => model.UnitTypeCode, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="action-buttons">
                        <input type="submit" value="Save" class="btn btn-primary" />
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                        @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-warning" })
                    </div>
                </div>
            }
        </div>
    </div>

    <script>
        // Form validation and enhancement
        $(document).ready(function () {
            try {
                // Add real-time validation feedback
                $('input[type="text"]').on('blur', function () {
                    var $this = $(this);
                    if ($this.val().trim() === '') {
                        $this.addClass('is-invalid');
                    } else {
                        $this.removeClass('is-invalid');
                    }
                });

                // Form submission handling
                $('form').on('submit', function (e) {
                    var isValid = true;
                    $('input[type="text"]').each(function () {
                        if ($(this).val().trim() === '') {
                            $(this).addClass('is-invalid');
                            isValid = false;
                        }
                    });

                    if (!isValid) {
                        e.preventDefault();
                        alert('Please fill in all required fields.');
                    }
                });

                console.log('Edit Unit Type form initialized successfully');
            } catch (error) {
                console.error('Error initializing edit form:', error);
            }
        });
    </script>
</body>
</html>