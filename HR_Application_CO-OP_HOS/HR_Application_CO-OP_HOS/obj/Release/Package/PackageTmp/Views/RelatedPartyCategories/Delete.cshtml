@model HR_Application_CO_OP_HOS.Models.RelatedPartyCategory

@{
    ViewBag.Title = "Delete Related Party Category";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            overflow-x: hidden;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 0;
        }

        .header-content {
            padding: 0 30px;
        }

        .header-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
            min-height: calc(100vh - 200px);
        }

        /* Warning Container */
        .warning-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
            border-left: 6px solid #e74c3c;
        }

        .warning-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 20px 25px;
        }

        .warning-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .warning-body {
            padding: 30px;
        }

        /* Warning Message */
        .warning-message {
            background: #fdf2f2;
            border: 2px solid #f5c6cb;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
            text-align: center;
        }

        .warning-icon {
            font-size: 3rem;
            color: #e74c3c;
            margin-bottom: 15px;
        }

        .warning-text {
            font-size: 1.3rem;
            font-weight: 600;
            color: #721c24;
            margin-bottom: 10px;
        }

        .warning-subtext {
            color: #856404;
            font-size: 1rem;
        }

        /* Details Container */
        .details-container {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .details-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 10px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        .detail-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #e9ecef;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #495057;
        }

        .detail-value {
            color: #6c757d;
            text-align: right;
        }

        .detail-value-important {
            color: #e74c3c;
            font-weight: 600;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-delete:hover, .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.2);
                color: white;
                text-decoration: none;
            }

        /* Impact Section */
        .impact-section {
            background: #fff3cd;
            border: 2px solid #ffeaa7;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }

        .impact-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #856404;
            margin-bottom: 10px;
        }

        .impact-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .impact-item {
            padding: 8px 0;
            color: #856404;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .impact-item i {
                color: #e74c3c;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .header-title {
                font-size: 2rem;
            }

            .warning-body {
                padding: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
                gap: 10px;
            }

            .btn-delete, .btn-cancel {
                width: 100%;
                justify-content: center;
            }

            .detail-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .detail-value {
                text-align: left;
                margin-top: 5px;
            }
        }

        /* Animation */
        .fade-in {
            animation: fadeIn 0.6s ease-in;
        }

        .shake {
            animation: shake 0.5s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }

        /* Loading States */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 10px;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Confirmation Check */
        .confirmation-check {
            margin: 20px 0;
            text-align: center;
        }

        .confirmation-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .confirmation-input {
            margin: 0 10px;
            transform: scale(1.2);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="fa fa-exclamation-triangle"></i> Delete Category
                </h1>
                <p class="header-subtitle">Permanently remove this related party category from the system</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content fade-in">
            <div class="warning-container">
                <div class="warning-header">
                    <h3 class="warning-title"><i class="fa fa-trash"></i> Confirm Deletion</h3>
                </div>
                <div class="warning-body">
                    <!-- Warning Message -->
                    <div class="warning-message">
                        <div class="warning-icon">
                            <i class="fa fa-exclamation-circle"></i>
                        </div>
                        <h3 class="warning-text">Are you sure you want to delete this?</h3>
                        <p class="warning-subtext">This action cannot be undone and will permanently remove the category from the system.</p>
                    </div>

                    <!-- Category Details -->
                    <div class="details-container">
                        <h4 class="details-title">
                            <i class="fa fa-info-circle"></i> Category Details
                        </h4>
                        <div class="details-grid">
                            <div class="detail-item">
                                <span class="detail-label">Category ID</span>
                                <span class="detail-value-important">@Model.ID</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Category Name</span>
                                <span class="detail-value">@Model.RelatedPartyCategoryName</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Related Party Type ID</span>
                                <span class="detail-value">@Model.RelatedPartyTypeID</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Category Code</span>
                                <span class="detail-value">
                                    @if (!string.IsNullOrEmpty(Model.RelatedPartyCategoryCode))
                                    {
                                        @Model.RelatedPartyCategoryCode
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Grade</span>
                                <span class="detail-value">
                                    @if (Model.RelatedPartyGrade.HasValue)
                                    {
                                        @Model.RelatedPartyGrade.Value
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="detail-item" style="flex-direction: column; align-items: flex-start; margin-top: 15px;">
                            <span class="detail-label">Description</span>
                            <span class="detail-value" style="text-align: left; margin-top: 8px;">
                                @if (!string.IsNullOrEmpty(Model.RelatedPartyCategoryDescription))
                                {
                                    @Model.RelatedPartyCategoryDescription
                                }
                                else
                                {
                                    <span class="text-muted">No description provided</span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Impact Warning -->
                    <div class="impact-section">
                        <h5 class="impact-title"><i class="fa fa-exclamation-triangle"></i> Potential Impact</h5>
                        <ul class="impact-list">
                            <li class="impact-item">
                                <i class="fa fa-users"></i>
                                <span>Related parties assigned to this category may be affected</span>
                            </li>
                            <li class="impact-item">
                                <i class="fa fa-bar-chart"></i>
                                <span>Reports and analytics referencing this category may need updates</span>
                            </li>
                            <li class="impact-item">
                                <i class="fa fa-history"></i>
                                <span>Historical data will retain references but new assignments won't be possible</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Confirmation Check -->
                    <div class="confirmation-check">
                        <label class="confirmation-label">
                            <input type="checkbox" id="confirmDelete" class="confirmation-input">
                            I understand that this action cannot be undone
                        </label>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        @using (Html.BeginForm("Delete", "RelatedPartyCategories", FormMethod.Post, new { id = "deleteForm" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ID)
                            <button type="submit" class="btn btn-delete" id="deleteBtn" disabled>
                                <i class="fa fa-trash"></i> Delete Permanently
                            </button>
                        }
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-cancel" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Enable/disable delete button based on confirmation
            $('#confirmDelete').on('change', function () {
                $('#deleteBtn').prop('disabled', !$(this).is(':checked'));
            });

            // Form submission handling
            $('#deleteForm').on('submit', function (e) {
                if (!$('#confirmDelete').is(':checked')) {
                    e.preventDefault();
                    $('#confirmDelete').closest('.confirmation-check').addClass('shake');
                    setTimeout(function () {
                        $('.confirmation-check').removeClass('shake');
                    }, 500);
                    return false;
                }

                $('#deleteBtn').html('<span class="spinner"></span> Deleting...').addClass('loading');
            });

            // Double confirmation for delete
            $('#deleteBtn').on('click', function (e) {
                if ($('#confirmDelete').is(':checked')) {
                    var categoryName = '@Model.RelatedPartyCategoryName';
                    var userConfirmed = confirm('FINAL WARNING: Are you absolutely sure you want to delete the category "' + categoryName + '"? This action is permanent and cannot be undone.');

                    if (!userConfirmed) {
                        e.preventDefault();
                        return false;
                    }
                }
            });

            // Add some visual feedback
            $('.btn-delete').on('mouseenter', function () {
                if (!$(this).prop('disabled')) {
                    $(this).css('transform', 'scale(1.05)');
                }
            }).on('mouseleave', function () {
                $(this).css('transform', 'scale(1)');
            });
        });
    </script>
</body>
</html>