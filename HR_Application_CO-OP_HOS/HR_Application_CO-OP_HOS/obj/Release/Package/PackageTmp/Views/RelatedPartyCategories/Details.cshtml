@model HR_Application_CO_OP_HOS.Models.RelatedPartyCategory

@{
    ViewBag.Title = "Related Party Category Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            overflow-x: hidden;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 0;
        }

        .header-content {
            padding: 0 30px;
        }

        .header-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
            min-height: calc(100vh - 200px);
        }

        /* Details Container */
        .details-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .details-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px 25px;
        }

        .details-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .details-body {
            padding: 30px;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        .detail-group {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            border-left: 4px solid #3498db;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-value {
            font-size: 1.1rem;
            color: #34495e;
            font-weight: 500;
        }

        .detail-value-empty {
            color: #7f8c8d;
            font-style: italic;
        }

        /* Time Schedule Section */
        .time-schedule {
            background: white;
            border: 2px solid #ecf0f1;
            border-radius: 10px;
            padding: 25px;
            margin-top: 20px;
        }

        .time-schedule-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #ecf0f1;
            padding-bottom: 10px;
        }

        .time-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .time-slot {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid #e9ecef;
        }

        .time-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
            font-size: 0.9rem;
        }

        .time-value {
            font-size: 1.1rem;
            color: #27ae60;
            font-weight: 500;
        }

        .time-value-empty {
            color: #e74c3c;
            font-style: italic;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            padding-top: 25px;
            border-top: 2px solid #ecf0f1;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-back {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-edit:hover, .btn-back:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.2);
                color: white;
                text-decoration: none;
            }

        /* Status Badges */
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        /* ID Badge */
        .id-badge {
            background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .header-title {
                font-size: 2rem;
            }

            .details-body {
                padding: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .action-buttons {
                flex-direction: column;
                gap: 10px;
            }

            .btn-edit, .btn-back {
                width: 100%;
                justify-content: center;
            }

            .time-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Animation */
        .fade-in {
            animation: fadeIn 0.6s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Description Box */
        .description-box {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            margin-top: 10px;
        }

        .description-content {
            line-height: 1.6;
            color: #495057;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="fa fa-eye"></i> Category Details
                </h1>
                <p class="header-subtitle">View detailed information about this related party category</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content fade-in">
            <div class="details-container">
                <div class="details-header">
                    <h3 class="details-title">
                        <i class="fa fa-tag"></i> @Model.RelatedPartyCategoryName
                        <span class="id-badge float-right">ID: @Model.ID</span>
                    </h3>
                </div>
                <div class="details-body">
                    <!-- Basic Information -->
                    <div class="details-grid">
                        <div class="detail-group">
                            <div class="detail-label">Category Name</div>
                            <div class="detail-value">@Model.RelatedPartyCategoryName</div>
                        </div>

                        <div class="detail-group">
                            <div class="detail-label">Related Party Type ID</div>
                            <div class="detail-value">
                                @Model.RelatedPartyTypeID
                                <span class="badge badge-info ml-2">Type</span>
                            </div>
                        </div>

                        <div class="detail-group">
                            <div class="detail-label">Category Code</div>
                            <div class="detail-value">
                                @if (!string.IsNullOrEmpty(Model.RelatedPartyCategoryCode))
                                {
                                    @Model.RelatedPartyCategoryCode
                                }
                                else
                                {
                                    <span class="detail-value-empty">Not specified</span>
                                }
                            </div>
                        </div>

                        <div class="detail-group">
                            <div class="detail-label">Grade</div>
                            <div class="detail-value">
                                @if (Model.RelatedPartyGrade.HasValue)
                                {
                                    @Model.RelatedPartyGrade.Value
                                    <span class="badge badge-warning ml-2">Grade</span>
                                }
                                else
                                {
                                    <span class="detail-value-empty">Not specified</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="detail-group" style="grid-column: 1 / -1;">
                        <div class="detail-label">Description</div>
                        <div class="description-box">
                            <div class="description-content">
                                @if (!string.IsNullOrEmpty(Model.RelatedPartyCategoryDescription))
                                {
                                    @Model.RelatedPartyCategoryDescription
                                }
                                else
                                {
                                    <span class="detail-value-empty">No description provided</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Time Schedule -->
                    <div class="time-schedule">
                        <h4 class="time-schedule-title">
                            <i class="fa fa-clock-o"></i> Attendance Schedule
                        </h4>
                        <div class="time-grid">
                            <div class="time-slot">
                                <div class="time-label">In Capture Start</div>
                                <div class="time-value">
                                    @if (Model.AttendanceInCaptureStart.HasValue)
                                    {
                                        @Model.AttendanceInCaptureStart.Value.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="time-value-empty">Not set</span>
                                    }
                                </div>
                            </div>

                            <div class="time-slot">
                                <div class="time-label">In Capture End</div>
                                <div class="time-value">
                                    @if (Model.AttendanceInCaptureEnd.HasValue)
                                    {
                                        @Model.AttendanceInCaptureEnd.Value.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="time-value-empty">Not set</span>
                                    }
                                </div>
                            </div>

                            <div class="time-slot">
                                <div class="time-label">Out Capture Start</div>
                                <div class="time-value">
                                    @if (Model.AttendanceOutCaptureStart.HasValue)
                                    {
                                        @Model.AttendanceOutCaptureStart.Value.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="time-value-empty">Not set</span>
                                    }
                                </div>
                            </div>

                            <div class="time-slot">
                                <div class="time-label">Out Capture End</div>
                                <div class="time-value">
                                    @if (Model.AttendanceOutCaptureEnd.HasValue)
                                    {
                                        @Model.AttendanceOutCaptureEnd.Value.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="time-value-empty">Not set</span>
                                    }
                                </div>
                            </div>

                            <div class="time-slot">
                                <div class="time-label">Expected In</div>
                                <div class="time-value">
                                    @if (Model.ExpectedIn.HasValue)
                                    {
                                        @Model.ExpectedIn.Value.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="time-value-empty">Not set</span>
                                    }
                                </div>
                            </div>

                            <div class="time-slot">
                                <div class="time-label">Expected Out</div>
                                <div class="time-value">
                                    @if (Model.ExpectedOut.HasValue)
                                    {
                                        @Model.ExpectedOut.Value.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="time-value-empty">Not set</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons">
                        @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-edit" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-back" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>