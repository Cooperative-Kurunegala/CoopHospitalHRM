@model HR_Application_CO_OP_HOS.Models.RelatedPartyCategory

@{
    ViewBag.Title = "Edit Related Party Category";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            overflow-x: hidden;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 0;
        }

        .header-content {
            padding: 0 30px;
        }

        .header-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
            min-height: calc(100vh - 200px);
        }

        /* Form Container */
        .form-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .form-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px 25px;
        }

        .form-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .form-body {
            padding: 30px;
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
            width: 100%;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

            .form-control.is-invalid {
                border-color: #e74c3c;
            }

        .validation-message {
            color: #e74c3c;
            font-size: 0.875rem;
            margin-top: 5px;
            display: block;
        }

        /* Buttons */
        .btn-submit {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            transition: all 0.3s ease;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(243, 156, 18, 0.4);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            margin-left: 10px;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(149, 165, 166, 0.4);
                color: white;
                text-decoration: none;
            }

        /* Current Values Panel */
        .current-values-panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .current-values-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 20px 25px;
        }

        .current-values-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin: 0;
        }

        .current-values-body {
            padding: 20px;
        }

        .value-item {
            padding: 12px 15px;
            border-bottom: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .value-item:last-child {
                border-bottom: none;
            }

        .value-label {
            font-weight: 600;
            color: #2c3e50;
        }

        .value-content {
            color: #7f8c8d;
            text-align: right;
        }

        .value-badge {
            background: #3498db;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.875rem;
        }

        /* Reference Data Panel */
        .reference-panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .reference-header {
            background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
            color: white;
            padding: 20px 25px;
        }

        .reference-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin: 0;
        }

        .reference-body {
            padding: 20px;
            max-height: 300px;
            overflow-y: auto;
        }

        .reference-item {
            padding: 10px 15px;
            border-bottom: 1px solid #ecf0f1;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .reference-item:hover {
                background-color: #f8f9fa;
            }

            .reference-item:last-child {
                border-bottom: none;
            }

        .reference-name {
            font-weight: 600;
            color: #2c3e50;
        }

        .reference-id {
            color: #7f8c8d;
            font-size: 0.875rem;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .header-title {
                font-size: 2rem;
            }

            .form-body {
                padding: 20px;
            }

            .btn-submit, .btn-cancel {
                width: 100%;
                margin: 5px 0;
            }

            .value-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .value-content {
                text-align: left;
                margin-top: 5px;
            }
        }

        /* Animation */
        .fade-in {
            animation: fadeIn 0.6s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Loading States */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 10px;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="fa fa-edit"></i> Edit Related Party Category
                </h1>
                <p class="header-subtitle">Update the details of this related party category</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content fade-in">
            <div class="row">
                <!-- Form Column -->
                <div class="col-lg-8">
                    <div class="form-container">
                        <div class="form-header">
                            <h3 class="form-title"><i class="fa fa-pencil"></i> Edit Category Information</h3>
                        </div>
                        <div class="form-body">
                            @using (Html.BeginForm("Edit", "RelatedPartyCategories", FormMethod.Post, new { id = "editForm" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ID)
                                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.RelatedPartyCategoryName)</label>
                                            @Html.EditorFor(model => model.RelatedPartyCategoryName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter category name" } })
                                            @Html.ValidationMessageFor(model => model.RelatedPartyCategoryName, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.RelatedPartyTypeID)</label>
                                            @Html.EditorFor(model => model.RelatedPartyTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter related party type ID", type = "number" } })
                                            @Html.ValidationMessageFor(model => model.RelatedPartyTypeID, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.RelatedPartyCategoryCode)</label>
                                            @Html.EditorFor(model => model.RelatedPartyCategoryCode, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter category code" } })
                                            @Html.ValidationMessageFor(model => model.RelatedPartyCategoryCode, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.RelatedPartyGrade)</label>
                                            @Html.EditorFor(model => model.RelatedPartyGrade, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter grade", type = "number" } })
                                            @Html.ValidationMessageFor(model => model.RelatedPartyGrade, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">@Html.DisplayNameFor(model => model.RelatedPartyCategoryDescription)</label>
                                    @Html.TextAreaFor(model => model.RelatedPartyCategoryDescription, new { @class = "form-control", rows = 4, placeholder = "Enter category description" })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyCategoryDescription, "", new { @class = "validation-message" })
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.AttendanceInCaptureStart)</label>
                                            @Html.EditorFor(model => model.AttendanceInCaptureStart, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                            @Html.ValidationMessageFor(model => model.AttendanceInCaptureStart, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.AttendanceInCaptureEnd)</label>
                                            @Html.EditorFor(model => model.AttendanceInCaptureEnd, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                            @Html.ValidationMessageFor(model => model.AttendanceInCaptureEnd, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.AttendanceOutCaptureStart)</label>
                                            @Html.EditorFor(model => model.AttendanceOutCaptureStart, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                            @Html.ValidationMessageFor(model => model.AttendanceOutCaptureStart, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.AttendanceOutCaptureEnd)</label>
                                            @Html.EditorFor(model => model.AttendanceOutCaptureEnd, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                            @Html.ValidationMessageFor(model => model.AttendanceOutCaptureEnd, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.ExpectedIn)</label>
                                            @Html.EditorFor(model => model.ExpectedIn, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                            @Html.ValidationMessageFor(model => model.ExpectedIn, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">@Html.DisplayNameFor(model => model.ExpectedOut)</label>
                                            @Html.EditorFor(model => model.ExpectedOut, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                            @Html.ValidationMessageFor(model => model.ExpectedOut, "", new { @class = "validation-message" })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group text-right">
                                    <button type="submit" class="btn btn-submit" id="submitBtn">
                                        <i class="fa fa-save"></i> Update Category
                                    </button>
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-cancel" })
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Sidebar Column -->
                <div class="col-lg-4">
                    <!-- Current Values Panel -->
                    <div class="current-values-panel">
                        <div class="current-values-header">
                            <h3 class="current-values-title"><i class="fa fa-info-circle"></i> Current Values</h3>
                        </div>
                        <div class="current-values-body">
                            <div class="value-item">
                                <span class="value-label">Category ID</span>
                                <span class="value-badge">@Model.ID</span>
                            </div>
                            <div class="value-item">
                                <span class="value-label">Created Date</span>
                                <span class="value-content">@DateTime.Now.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="value-item">
                                <span class="value-label">Last Updated</span>
                                <span class="value-content">Just now</span>
                            </div>
                            <div class="value-item">
                                <span class="value-label">Status</span>
                                <span class="value-badge" style="background: #27ae60;">Active</span>
                            </div>
                        </div>
                    </div>

                    <!-- Reference Data Panel -->
                    <div class="reference-panel">
                        <div class="reference-header">
                            <h3 class="reference-title"><i class="fa fa-database"></i> Reference Data</h3>
                        </div>
                        <div class="reference-body">
                            <div class="mb-3">
                                <h6 class="text-primary"><i class="fa fa-tags"></i> Related Party Types</h6>
                                <div class="reference-item" onclick="setRelatedPartyType(1)">
                                    <div class="reference-name">Employee</div>
                                    <div class="reference-id">ID: 1</div>
                                </div>
                                <div class="reference-item" onclick="setRelatedPartyType(2)">
                                    <div class="reference-name">Patient</div>
                                    <div class="reference-id">ID: 2</div>
                                </div>
                                <div class="reference-item" onclick="setRelatedPartyType(3)">
                                    <div class="reference-name">Vendor</div>
                                    <div class="reference-id">ID: 3</div>
                                </div>
                            </div>

                            <div>
                                <h6 class="text-primary"><i class="fa fa-star"></i> Grade Guidelines</h6>
                                <div class="reference-item" onclick="setGrade(1)">
                                    <div class="reference-name">Grade 1</div>
                                    <div class="reference-id">Entry Level</div>
                                </div>
                                <div class="reference-item" onclick="setGrade(2)">
                                    <div class="reference-name">Grade 2</div>
                                    <div class="reference-id">Junior Level</div>
                                </div>
                                <div class="reference-item" onclick="setGrade(3)">
                                    <div class="reference-name">Grade 3</div>
                                    <div class="reference-id">Mid Level</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Form submission handling
            $('#editForm').on('submit', function () {
                $('#submitBtn').html('<span class="spinner"></span> Updating...').addClass('loading');
            });

            // Real-time validation
            $('.form-control').on('blur', function () {
                validateField($(this));
            });

            function validateField(field) {
                var value = field.val();
                var isValid = true;

                if (field.attr('name').includes('Name') && !value.trim()) {
                    showError(field, 'This field is required');
                    isValid = false;
                } else if (field.attr('name').includes('ID') && (!value || value < 1)) {
                    showError(field, 'Please enter a valid ID');
                    isValid = false;
                } else {
                    clearError(field);
                }

                return isValid;
            }

            function showError(field, message) {
                field.addClass('is-invalid');
                field.next('.validation-message').text(message);
            }

            function clearError(field) {
                field.removeClass('is-invalid');
                field.next('.validation-message').text('');
            }

            // Auto-format time inputs
            $('input[type="time"]').on('change', function () {
                var value = $(this).val();
                if (value && !value.match(/^\d{2}:\d{2}$/)) {
                    $(this).addClass('is-invalid');
                } else {
                    $(this).removeClass('is-invalid');
                }
            });
        });

        // Reference data functions
        function setRelatedPartyType(id) {
            $('#RelatedPartyTypeID').val(id).trigger('change');
            showNotification('Related Party Type set to ID: ' + id);
        }

        function setGrade(grade) {
            $('#RelatedPartyGrade').val(grade).trigger('change');
            showNotification('Grade set to: ' + grade);
        }

        function showNotification(message) {
            // Create notification element
            var notification = $('<div class="alert alert-success alert-dismissible fade show" style="position: fixed; top: 20px; right: 20px; z-index: 1050; min-width: 300px;">' +
                '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                '<strong><i class="fa fa-check-circle"></i> Success!</strong> ' + message +
                '</div>');

            $('body').append(notification);

            // Auto remove after 3 seconds
            setTimeout(function () {
                notification.alert('close');
            }, 3000);
        }
    </script>
</body>
</html>