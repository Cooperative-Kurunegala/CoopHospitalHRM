﻿@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartyRole>

@{
    ViewBag.Title = "Related Party Roles - HRM System";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Related Party Roles</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 0 30px 30px 30px;
        }

        /* Action Panel */
        .action-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        /* Filter Section */
        .filter-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 4px solid #3498db;
        }

        .filter-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
        }

        /* Table Styling */
        .data-table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .table-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px;
        }

            .table-header h3 {
                margin: 0;
                font-size: 1.5rem;
                font-weight: 600;
            }

        .table {
            margin: 0;
            font-size: 1.1rem;
        }

            .table thead th {
                background-color: #ecf0f1;
                border: none;
                padding: 18px 15px;
                font-weight: 600;
                color: #2c3e50;
                font-size: 1.1rem;
                border-bottom: 2px solid #bdc3c7;
            }

            .table tbody td {
                padding: 16px 15px;
                vertical-align: middle;
                border-bottom: 1px solid #ecf0f1;
                font-size: 1.05rem;
            }

            .table tbody tr {
                transition: all 0.3s ease;
            }

                .table tbody tr:hover {
                    background-color: #f8f9fa;
                    transform: scale(1.01);
                }

        /* Action Buttons */
        .btn-action {
            padding: 8px 15px;
            margin: 2px;
            border-radius: 6px;
            font-weight: 500;
            transition: all 0.3s ease;
            border: none;
            font-size: 0.95rem;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            color: white;
        }

            .btn-edit:hover {
                transform: translateY(-2px);
                box-shadow: 0 3px 10px rgba(243, 156, 18, 0.4);
            }

        .btn-details {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
        }

            .btn-details:hover {
                transform: translateY(-2px);
                box-shadow: 0 3px 10px rgba(52, 152, 219, 0.4);
            }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

            .btn-delete:hover {
                transform: translateY(-2px);
                box-shadow: 0 3px 10px rgba(231, 76, 60, 0.4);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 50px;
            color: #7f8c8d;
            font-size: 1.2rem;
        }

            .no-records i {
                font-size: 3rem;
                margin-bottom: 15px;
                color: #bdc3c7;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 0 15px 15px 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .action-panel {
                padding: 15px;
            }

            .table thead th,
            .table tbody td {
                padding: 12px 8px;
                font-size: 0.95rem;
            }

            .btn-action {
                display: block;
                width: 100%;
                margin-bottom: 5px;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title">
                        <i class="fa fa-users"></i> Related Party Roles
                    </h1>
                    <p class="page-subtitle">Manage all related party roles in the system</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to Dashboard", "Index", "Home", null, new { @class = "btn btn-light btn-lg" })
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Action Panel -->
            <div class="action-panel">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h3 style="margin: 0; color: #2c3e50;">
                            <i class="fa fa-list"></i> Role Management
                        </h3>
                    </div>
                    <div class="col-md-6 text-right">
                        @Html.ActionLink("Create New Role", "Create", null, new { @class = "btn btn-create" })
                    </div>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <h4 class="filter-title"><i class="fa fa-filter"></i> Filter Roles</h4>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="searchName">Search by Name</label>
                            <input type="text" id="searchName" class="form-control" placeholder="Enter role name...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="searchCode">Search by Code</label>
                            <input type="text" id="searchCode" class="form-control" placeholder="Enter role code...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button id="clearFilters" class="btn btn-secondary btn-block">Clear Filters</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Table -->
            <div class="data-table-container">
                <div class="table-header">
                    <h3><i class="fa fa-table"></i> Related Party Roles List</h3>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover" id="rolesTable">
                        <thead>
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.RelatedPartyRoleName)</th>
                                <th>@Html.DisplayNameFor(model => model.RelatedPartyRoleDescription)</th>
                                <th>@Html.DisplayNameFor(model => model.RelatedPartyRoleCode)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.RelatedPartyRoleName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.RelatedPartyRoleDescription)</td>
                                        <td>
                                            <span class="badge badge-primary" style="font-size: 1rem; padding: 8px 12px;">
                                                @Html.DisplayFor(modelItem => item.RelatedPartyRoleCode)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-action btn-edit" })
                                                @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-action btn-details" })
                                                @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-action btn-delete" })
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4">
                                        <div class="no-records">
                                            <i class="fa fa-exclamation-circle"></i>
                                            <h4>No Records Found</h4>
                                            <p>No related party roles have been created yet.</p>
                                            @Html.ActionLink("Create First Role", "Create", null, new { @class = "btn btn-create mt-3" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Filter functionality
            $('#searchName').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                filterTable(value, 0);
            });

            $('#searchCode').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                filterTable(value, 2);
            });

            $('#clearFilters').on('click', function () {
                $('#searchName').val('');
                $('#searchCode').val('');
                $('#rolesTable tbody tr').show();
            });

            function filterTable(value, columnIndex) {
                $('#rolesTable tbody tr').each(function () {
                    var row = $(this);
                    var cellText = row.find('td').eq(columnIndex).text().toLowerCase();
                    if (cellText.indexOf(value) > -1) {
                        row.show();
                    } else {
                        row.hide();
                    }
                });
            }

            // Loading state for buttons
            $('.btn-action').on('click', function () {
                var $btn = $(this);
                var originalText = $btn.html();
                $btn.html('<span class="loading"></span> Loading...').prop('disabled', true);

                setTimeout(function () {
                    $btn.html(originalText).prop('disabled', false);
                }, 1000);
            });

            // Table row hover effects
            $('#rolesTable tbody tr').on('mouseenter', function () {
                $(this).addClass('table-active');
            }).on('mouseleave', function () {
                $(this).removeClass('table-active');
            });
        });
    </script>
</body>
</html>