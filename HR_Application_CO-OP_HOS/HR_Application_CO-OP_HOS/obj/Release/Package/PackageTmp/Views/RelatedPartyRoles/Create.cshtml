﻿@model HR_Application_CO_OP_HOS.Models.RelatedPartyRole

@{
    ViewBag.Title = "Create Related Party Role - HRM System";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Related Party Role</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 0 30px 30px 30px;
        }

        /* Form Container */
        .form-container {
            background: white;
            border-radius: 12px;
            padding: 0;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .form-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 25px;
        }

            .form-header h3 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 600;
            }

        .form-body {
            padding: 30px;
        }

        /* Form Styling */
        .form-group {
            margin-bottom: 25px;
        }

        .control-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1.05rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .text-danger {
            font-size: 0.95rem;
            margin-top: 5px;
            font-weight: 500;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 20px;
            border-top: 1px solid #ecf0f1;
            text-align: right;
        }

        .btn-submit {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            margin-right: 10px;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Reference Section */
        .reference-section {
            background: white;
            border-radius: 12px;
            padding: 0;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .reference-header {
            background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
            color: white;
            padding: 20px;
        }

            .reference-header h4 {
                margin: 0;
                font-size: 1.4rem;
                font-weight: 600;
            }

        .reference-body {
            padding: 20px;
            max-height: 300px;
            overflow-y: auto;
        }

        .reference-item {
            padding: 12px 15px;
            border: 1px solid #ecf0f1;
            border-radius: 6px;
            margin-bottom: 10px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .reference-item:hover {
                background-color: #f8f9fa;
                border-color: #3498db;
            }

            .reference-item.active {
                background-color: #3498db;
                color: white;
                border-color: #3498db;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 0 15px 15px 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .form-body {
                padding: 20px;
            }

            .action-buttons {
                text-align: center;
            }

                .action-buttons .btn {
                    display: block;
                    width: 100%;
                    margin-bottom: 10px;
                }
        }

        /* Validation Styles */
        .input-validation-error {
            border-color: #e74c3c !important;
        }

        .field-validation-error {
            color: #e74c3c;
            display: block;
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title">
                        <i class="fa fa-plus-circle"></i> Create Related Party Role
                    </h1>
                    <p class="page-subtitle">Add a new role to the system</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-light btn-lg" })
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <!-- Form Column -->
                <div class="col-lg-8">
                    <div class="form-container">
                        <div class="form-header">
                            <h3><i class="fa fa-pencil-square-o"></i> Role Information</h3>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-body">
                                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyRoleName, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.RelatedPartyRoleName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter role name" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyRoleName, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyRoleDescription, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.RelatedPartyRoleDescription, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter role description", rows = "4" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyRoleDescription, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyRoleCode, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.RelatedPartyRoleCode, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter role code" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyRoleCode, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="action-buttons">
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-cancel" })
                                <button type="submit" class="btn btn-submit">
                                    <i class="fa fa-save"></i> Create Role
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Reference Column -->
                <div class="col-lg-4">
                    <div class="reference-section">
                        <div class="reference-header">
                            <h4><i class="fa fa-info-circle"></i> Existing Roles</h4>
                        </div>
                        <div class="reference-body">
                            @{
                                // This would typically come from the controller
                                // For demonstration, we'll show a message
                            }
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"></i>
                                <strong>Information:</strong><br />
                                When creating a new role, ensure the role code is unique and follows the established naming convention.
                            </div>
                            <div class="alert alert-warning">
                                <i class="fa fa-exclamation-triangle"></i>
                                <strong>Best Practices:</strong><br />
                                - Use descriptive role names<br />
                                - Keep role codes short and meaningful<br />
                                - Provide clear descriptions for each role
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            // Form submission handling
            $('form').on('submit', function () {
                var $submitBtn = $(this).find('button[type="submit"]');
                var originalText = $submitBtn.html();
                $submitBtn.html('<span class="loading"></span> Creating...').prop('disabled', true);
            });

            // Auto-suggest for role code based on name
            $('#RelatedPartyRoleName').on('blur', function () {
                var roleName = $(this).val();
                if (roleName && !$('#RelatedPartyRoleCode').val()) {
                    // Generate a suggested code (first 3 letters of each word, uppercase)
                    var words = roleName.split(' ');
                    var suggestedCode = '';
                    for (var i = 0; i < Math.min(words.length, 3); i++) {
                        if (words[i].length > 0) {
                            suggestedCode += words[i].substring(0, 3).toUpperCase();
                        }
                    }
                    $('#RelatedPartyRoleCode').val(suggestedCode);
                }
            });

            // Character counter for description
            $('#RelatedPartyRoleDescription').on('input', function () {
                var length = $(this).val().length;
                $('#descCounter').text(length + ' characters');
            });

            // Initialize character counter
            if ($('#RelatedPartyRoleDescription').length) {
                $('<small class="form-text text-muted" id="descCounter">0 characters</small>').insertAfter('#RelatedPartyRoleDescription');
                $('#RelatedPartyRoleDescription').trigger('input');
            }
        });
    </script>
</body>
</html>