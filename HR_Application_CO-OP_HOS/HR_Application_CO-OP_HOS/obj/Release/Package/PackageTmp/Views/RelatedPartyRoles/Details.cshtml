﻿@model HR_Application_CO_OP_HOS.Models.RelatedPartyRole

@{
    ViewBag.Title = "Role Details - HRM System";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Role Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 0 30px 30px 30px;
        }

        /* Details Container */
        .details-container {
            background: white;
            border-radius: 12px;
            padding: 0;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .details-header {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            padding: 25px;
        }

            .details-header h3 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 600;
            }

        .details-body {
            padding: 30px;
        }

        /* Detail Items */
        .detail-item {
            margin-bottom: 25px;
            padding: 20px;
            border: 1px solid #ecf0f1;
            border-radius: 8px;
            background: #f8f9fa;
            transition: all 0.3s ease;
        }

            .detail-item:hover {
                border-color: #3498db;
                background: white;
                transform: translateX(5px);
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.2rem;
            font-weight: 500;
        }

        .detail-code {
            display: inline-block;
            background: #3498db;
            color: white;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 1.1rem;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 20px;
            border-top: 1px solid #ecf0f1;
            text-align: center;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            margin-right: 10px;
        }

            .btn-edit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
            }

        .btn-back {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
        }

            .btn-back:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Statistics Section */
        .stats-container {
            background: white;
            border-radius: 12px;
            padding: 0;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .stats-header {
            background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
            color: white;
            padding: 20px;
        }

            .stats-header h4 {
                margin: 0;
                font-size: 1.4rem;
                font-weight: 600;
            }

        .stats-body {
            padding: 20px;
        }

        .stat-item {
            text-align: center;
            padding: 15px;
            border: 1px solid #ecf0f1;
            border-radius: 8px;
            margin-bottom: 10px;
            transition: all 0.3s ease;
        }

            .stat-item:hover {
                border-color: #9b59b6;
                background: #f8f9fa;
            }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: #2c3e50;
            display: block;
        }

        .stat-label {
            font-size: 1rem;
            color: #7f8c8d;
        }

        /* Related Info Section */
        .related-info {
            background: white;
            border-radius: 12px;
            padding: 0;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .related-header {
            background: linear-gradient(135deg, #1abc9c 0%, #16a085 100%);
            color: white;
            padding: 20px;
        }

            .related-header h4 {
                margin: 0;
                font-size: 1.4rem;
                font-weight: 600;
            }

        .related-body {
            padding: 20px;
            max-height: 300px;
            overflow-y: auto;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 0 15px 15px 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .details-body {
                padding: 20px;
            }

            .action-buttons {
                text-align: center;
            }

                .action-buttons .btn {
                    display: block;
                    width: 100%;
                    margin-bottom: 10px;
                }

            .detail-item {
                padding: 15px;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title">
                        <i class="fa fa-eye"></i> Role Details
                    </h1>
                    <p class="page-subtitle">View detailed information about this role</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-light btn-lg" })
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <!-- Details Column -->
                <div class="col-lg-8">
                    <div class="details-container">
                        <div class="details-header">
                            <h3><i class="fa fa-info-circle"></i> Role Information</h3>
                        </div>

                        <div class="details-body">
                            <div class="detail-item">
                                <div class="detail-label">Role ID</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.ID)</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">Role Name</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.RelatedPartyRoleName)</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">Role Description</div>
                                <div class="detail-value">
                                    @if (!string.IsNullOrEmpty(Model.RelatedPartyRoleDescription))
                                    {
                                        @Html.DisplayFor(model => model.RelatedPartyRoleDescription)
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description provided</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">Role Code</div>
                                <div class="detail-value">
                                    <span class="detail-code">@Html.DisplayFor(model => model.RelatedPartyRoleCode)</span>
                                </div>
                            </div>
                        </div>

                        <div class="action-buttons">
                            @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-edit" })
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-back" })
                        </div>
                    </div>
                </div>

                <!-- Statistics Column -->
                <div class="col-lg-4">
                    <!-- Statistics Section -->
                    <div class="stats-container">
                        <div class="stats-header">
                            <h4><i class="fa fa-bar-chart"></i> Role Statistics</h4>
                        </div>
                        <div class="stats-body">
                            <div class="stat-item">
                                <span class="stat-number">--</span>
                                <span class="stat-label">Users Assigned</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">--</span>
                                <span class="stat-label">Active Sessions</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-number">--</span>
                                <span class="stat-label">Permissions</span>
                            </div>
                            <div class="alert alert-info mt-3">
                                <i class="fa fa-info-circle"></i>
                                <small>Statistics are calculated based on current system data.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Related Information -->
                    <div class="related-info">
                        <div class="related-header">
                            <h4><i class="fa fa-link"></i> Related Information</h4>
                        </div>
                        <div class="related-body">
                            <div class="alert alert-warning">
                                <i class="fa fa-exclamation-triangle"></i>
                                <strong>System Role</strong><br />
                                This role is used across the HRM system for access control and permissions management.
                            </div>
                            <div class="alert alert-info">
                                <i class="fa fa-lightbulb-o"></i>
                                <strong>Usage Tips:</strong><br />
                                - Roles define user permissions<br />
                                - Each user can have multiple roles<br />
                                - Role changes affect system access immediately
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            // Add loading state to buttons
            $('.btn').on('click', function () {
                var $btn = $(this);
                var originalText = $btn.html();

                // Only show loading for actions that navigate away
                if (!$btn.hasClass('btn-back')) {
                    $btn.html('<span class="loading"></span> Loading...').prop('disabled', true);

                    setTimeout(function () {
                        $btn.html(originalText).prop('disabled', false);
                    }, 1500);
                }
            });

            // Add animation to detail items on page load
            $('.detail-item').each(function (index) {
                var $item = $(this);
                setTimeout(function () {
                    $item.css('opacity', '0').animate({ opacity: 1 }, 500);
                }, index * 200);
            });

            // Simulate statistics loading
            setTimeout(function () {
                $('.stat-number').each(function () {
                    var $stat = $(this);
                    var target = Math.floor(Math.random() * 100) + 1;
                    animateValue($stat, 0, target, 1000);
                });
            }, 1000);

            function animateValue(element, start, end, duration) {
                var range = end - start;
                var current = start;
                var increment = end > start ? 1 : -1;
                var stepTime = Math.abs(Math.floor(duration / range));
                var timer = setInterval(function () {
                    current += increment;
                    element.text(current);
                    if (current == end) {
                        clearInterval(timer);
                    }
                }, stepTime);
            }
        });
    </script>
</body>
</html>