﻿@model HR_Application_CO_OP_HOS.Models.RelatedPartyRole

@{
    ViewBag.Title = "Delete Related Party Role - HRM System";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Related Party Role</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 0 30px 30px 30px;
        }

        /* Warning Container */
        .warning-container {
            background: white;
            border-radius: 12px;
            padding: 0;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            border-left: 6px solid #e74c3c;
        }

        .warning-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 25px;
        }

            .warning-header h3 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 600;
            }

        .warning-body {
            padding: 30px;
        }

        .warning-icon {
            font-size: 4rem;
            color: #e74c3c;
            margin-bottom: 20px;
        }

        .warning-title {
            font-size: 2rem;
            color: #e74c3c;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .warning-message {
            font-size: 1.2rem;
            color: #7f8c8d;
            margin-bottom: 25px;
            line-height: 1.6;
        }

        /* Details Container */
        .details-container {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 25px;
            margin-bottom: 25px;
            border: 1px solid #e74c3c;
        }

        .detail-item {
            margin-bottom: 20px;
            padding: 15px;
            background: white;
            border-radius: 6px;
            border-left: 4px solid #3498db;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
            margin-bottom: 5px;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.2rem;
            font-weight: 500;
        }

        .detail-code {
            display: inline-block;
            background: #3498db;
            color: white;
            padding: 6px 12px;
            border-radius: 15px;
            font-weight: 600;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 25px;
            border-top: 1px solid #ecf0f1;
            text-align: center;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 15px 40px;
            font-size: 1.2rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            margin-right: 15px;
        }

            .btn-delete:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 15px 30px;
            font-size: 1.2rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Impact Analysis */
        .impact-container {
            background: white;
            border-radius: 12px;
            padding: 0;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            border-left: 6px solid #f39c12;
        }

        .impact-header {
            background: linear-gradient(135deg, #f39c12 0%, #d35400 100%);
            color: white;
            padding: 20px;
        }

            .impact-header h4 {
                margin: 0;
                font-size: 1.4rem;
                font-weight: 600;
            }

        .impact-body {
            padding: 20px;
        }

        .impact-item {
            padding: 12px 15px;
            border: 1px solid #f39c12;
            border-radius: 6px;
            margin-bottom: 10px;
            background: #fef9e7;
            transition: all 0.3s ease;
        }

            .impact-item:hover {
                background: #fcf3cf;
                transform: translateX(5px);
            }

        .impact-warning {
            color: #e74c3c;
            font-weight: 600;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 0 15px 15px 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .warning-body {
                padding: 20px;
            }

            .action-buttons {
                text-align: center;
            }

                .action-buttons .btn {
                    display: block;
                    width: 100%;
                    margin-bottom: 15px;
                }

            .warning-title {
                font-size: 1.6rem;
            }

            .warning-icon {
                font-size: 3rem;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Confirmation Dialog Styles */
        .confirmation-dialog {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .dialog-content {
            background: white;
            padding: 30px;
            border-radius: 12px;
            max-width: 500px;
            width: 90%;
            text-align: center;
        }

        .dialog-icon {
            font-size: 4rem;
            color: #e74c3c;
            margin-bottom: 20px;
        }

        .dialog-title {
            font-size: 1.8rem;
            color: #e74c3c;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .dialog-message {
            font-size: 1.1rem;
            color: #7f8c8d;
            margin-bottom: 25px;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title">
                        <i class="fa fa-trash-o"></i> Delete Related Party Role
                    </h1>
                    <p class="page-subtitle">Remove role from the system</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-light btn-lg" })
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <!-- Warning Column -->
                <div class="col-lg-8">
                    <div class="warning-container">
                        <div class="warning-header">
                            <h3><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                        </div>

                        <div class="warning-body text-center">
                            <div class="warning-icon">
                                <i class="fa fa-exclamation-circle"></i>
                            </div>
                            <h2 class="warning-title">Warning: Irreversible Action</h2>
                            <p class="warning-message">
                                You are about to permanently delete the role <strong>"@Model.RelatedPartyRoleName"</strong>.
                                This action cannot be undone and may affect system functionality.
                            </p>

                            <!-- Role Details -->
                            <div class="details-container">
                                <h4 style="color: #e74c3c; margin-bottom: 20px;">
                                    <i class="fa fa-list"></i> Role Details to be Deleted
                                </h4>

                                <div class="detail-item">
                                    <div class="detail-label">Role ID</div>
                                    <div class="detail-value">@Html.DisplayFor(model => model.ID)</div>
                                </div>

                                <div class="detail-item">
                                    <div class="detail-label">Role Name</div>
                                    <div class="detail-value">@Html.DisplayFor(model => model.RelatedPartyRoleName)</div>
                                </div>

                                <div class="detail-item">
                                    <div class="detail-label">Role Description</div>
                                    <div class="detail-value">
                                        @if (!string.IsNullOrEmpty(Model.RelatedPartyRoleDescription))
                                        {
                                            @Html.DisplayFor(model => model.RelatedPartyRoleDescription)
                                        }
                                        else
                                        {
                                            <span class="text-muted">No description provided</span>
                                        }
                                    </div>
                                </div>

                                <div class="detail-item">
                                    <div class="detail-label">Role Code</div>
                                    <div class="detail-value">
                                        <span class="detail-code">@Html.DisplayFor(model => model.RelatedPartyRoleCode)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ID)

                            <div class="action-buttons">
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-cancel" })
                                <button type="button" id="deleteConfirmBtn" class="btn btn-delete">
                                    <i class="fa fa-trash"></i> Delete Role
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Impact Analysis Column -->
                <div class="col-lg-4">
                    <div class="impact-container">
                        <div class="impact-header">
                            <h4><i class="fa fa-chain-broken"></i> Impact Analysis</h4>
                        </div>
                        <div class="impact-body">
                            <div class="impact-item">
                                <i class="fa fa-users impact-warning"></i>
                                <strong>User Access:</strong> Users with this role may lose system access
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-shield impact-warning"></i>
                                <strong>Permissions:</strong> All permissions associated with this role will be removed
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-cogs impact-warning"></i>
                                <strong>System Functions:</strong> Some system functions may become unavailable
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-history impact-warning"></i>
                                <strong>Audit Trail:</strong> This action will be logged in the system audit trail
                            </div>

                            <div class="alert alert-danger mt-3">
                                <i class="fa fa-exclamation-triangle"></i>
                                <strong>Critical:</strong> This operation is irreversible. Please ensure you have proper backups.
                            </div>
                        </div>
                    </div>

                    <!-- Safety Check -->
                    <div class="impact-container">
                        <div class="impact-header">
                            <h4><i class="fa fa-check-circle"></i> Safety Checklist</h4>
                        </div>
                        <div class="impact-body">
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="safetyCheck1">
                                <label class="form-check-label" for="safetyCheck1">
                                    I have verified this role is not in use
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="safetyCheck2">
                                <label class="form-check-label" for="safetyCheck2">
                                    I understand this action is permanent
                                </label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="safetyCheck3">
                                <label class="form-check-label" for="safetyCheck3">
                                    I have proper authorization to delete this role
                                </label>
                            </div>
                            <div class="alert alert-info mt-3">
                                <i class="fa fa-info-circle"></i>
                                All safety checks must be completed before deletion.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Dialog -->
    <div class="confirmation-dialog" id="confirmationDialog">
        <div class="dialog-content">
            <div class="dialog-icon">
                <i class="fa fa-question-circle"></i>
            </div>
            <h3 class="dialog-title">Final Confirmation</h3>
            <p class="dialog-message">
                Are you absolutely sure you want to delete the role <strong>"@Model.RelatedPartyRoleName"</strong>?
                This action cannot be reversed.
            </p>
            <div>
                <button type="button" id="finalCancelBtn" class="btn btn-cancel" style="margin-right: 10px;">
                    <i class="fa fa-times"></i> Cancel
                </button>
                <button type="button" id="finalDeleteBtn" class="btn btn-delete">
                    <i class="fa fa-trash"></i> Yes, Delete Permanently
                </button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            var deleteConfirmed = false;

            // Initial delete button click
            $('#deleteConfirmBtn').on('click', function () {
                // Check if all safety checks are completed
                var check1 = $('#safetyCheck1').is(':checked');
                var check2 = $('#safetyCheck2').is(':checked');
                var check3 = $('#safetyCheck3').is(':checked');

                if (!check1 || !check2 || !check3) {
                    alert('Please complete all safety checks before proceeding with deletion.');
                    return;
                }

                // Show confirmation dialog
                $('#confirmationDialog').fadeIn();
            });

            // Final cancel button
            $('#finalCancelBtn').on('click', function () {
                $('#confirmationDialog').fadeOut();
            });

            // Final delete button
            $('#finalDeleteBtn').on('click', function () {
                deleteConfirmed = true;
                var $btn = $(this);
                var originalText = $btn.html();

                $btn.html('<span class="loading"></span> Deleting...').prop('disabled', true);
                $('#finalCancelBtn').prop('disabled', true);

                // Submit the form
                $('form').submit();
            });

            // Form submission handling
            $('form').on('submit', function (e) {
                if (!deleteConfirmed) {
                    e.preventDefault();
                    return false;
                }

                var $submitBtn = $('button[type="submit"]');
                var originalText = $submitBtn.html();
                $submitBtn.html('<span class="loading"></span> Deleting...').prop('disabled', true);
                $('.btn-cancel').prop('disabled', true);
            });

            // Safety check validation
            $('.form-check-input').on('change', function () {
                validateSafetyChecks();
            });

            function validateSafetyChecks() {
                var check1 = $('#safetyCheck1').is(':checked');
                var check2 = $('#safetyCheck2').is(':checked');
                var check3 = $('#safetyCheck3').is(':checked');

                if (check1 && check2 && check3) {
                    $('#deleteConfirmBtn').prop('disabled', false);
                } else {
                    $('#deleteConfirmBtn').prop('disabled', true);
                }
            }

            // Initialize safety check validation
            validateSafetyChecks();

            // Add warning animation
            $('.warning-icon').css('animation', 'pulse 2s infinite');

            // Add custom styles for pulse animation
            $('<style>.pulse { animation: pulse 2s infinite; } @@keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }</style>').appendTo('head');
        });
    </script>
</body>
</html>