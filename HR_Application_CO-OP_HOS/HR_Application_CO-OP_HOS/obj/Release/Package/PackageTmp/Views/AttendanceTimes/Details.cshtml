@model HR_Application_CO_OP_HOS.Models.AttendanceTime

@{
    ViewBag.Title = "Attendance Time Details";

    // Normalize nullable TimeSpan values and compute duration safely
    TimeSpan fromTime = Model.AttendanceFromTime ?? TimeSpan.Zero;
    TimeSpan toTime = Model.AttendanceToTime ?? TimeSpan.Zero;

    // Calculate duration and correct for overnight shifts (to < from)
    TimeSpan rawDuration = toTime - fromTime;
    TimeSpan duration = rawDuration < TimeSpan.Zero ? rawDuration + TimeSpan.FromDays(1) : rawDuration;

    // Display-friendly strings (show placeholder when original values are null)
    string startDisplay = Model.AttendanceFromTime.HasValue ? fromTime.ToString(@"hh\:mm") : "--";
    string endDisplay = Model.AttendanceToTime.HasValue ? toTime.ToString(@"hh\:mm") : "--";
    string totalDurationDisplay = duration.ToString(@"hh\:mm");
    double durationHours = Math.Floor(duration.TotalHours);
    int durationMinutes = duration.Minutes;
    bool isOvernight = Model.AttendanceFromTime.HasValue && Model.AttendanceToTime.HasValue && toTime < fromTime;
}
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-eye"></i> Attendance Time Details</h1>
            <p class="lead">View detailed information about attendance time configuration</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-clock-o"></i> Time Configuration Details</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="detail-card">
                                <div class="detail-header">
                                    <h4>Configuration ID: @Model.ID</h4>
                                    <span class="status-badge active">Active</span>
                                </div>

                                <div class="detail-section">
                                    <h5><i class="fa fa-time"></i> Time Information</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="detail-item">
                                                <label>Start Time:</label>
                                                <div class="value-box">
                                                    <i class="fa fa-clock-o"></i>
                                                    <span class="time-value">@startDisplay</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="detail-item">
                                                <label>End Time:</label>
                                                <div class="value-box">
                                                    <i class="fa fa-clock-o"></i>
                                                    <span class="time-value">@endDisplay</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="detail-section">
                                    <h5><i class="fa fa-calculator"></i> Duration Analysis</h5>
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="metric-card">
                                                <div class="metric-value" id="totalDuration">
                                                    @totalDurationDisplay
                                                </div>
                                                <div class="metric-label">Total Duration</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="metric-card">
                                                <div class="metric-value" id="durationHours">
                                                    @durationHours
                                                </div>
                                                <div class="metric-label">Hours</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="metric-card">
                                                <div class="metric-value" id="durationMinutes">
                                                    @durationMinutes
                                                </div>
                                                <div class="metric-label">Minutes</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="detail-section">
                                    <h5><i class="fa fa-info-circle"></i> Additional Information</h5>
                                    <div class="info-grid">
                                        <div class="info-item">
                                            <label>Configuration Type:</label>
                                            <span>Standard Working Hours</span>
                                        </div>
                                        <div class="info-item">
                                            <label>Time Format:</label>
                                            <span>24-Hour Format</span>
                                        </div>
                                        <div class="info-item">
                                            <label>Overnight:</label>
                                            <span>
                                                @if (isOvernight)
                                                {
                                                    <span class="badge badge-warning">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">No</span>
                                                }
                                            </span>
                                        </div>
                                        <div class="info-item">
                                            <label>Shift Category:</label>
                                            <span>
                                                @if (Model.AttendanceFromTime.HasValue)
                                                {
                                                    if (fromTime.Hours < 12)
                                                    {
                                                        <span class="badge badge-primary">Morning Shift</span>
                                                    }
                                                    else if (fromTime.Hours < 18)
                                                    {
                                                        <span class="badge badge-info">Afternoon Shift</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-dark">Evening Shift</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Unknown</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="action-buttons">
                                    @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-lg" })
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-lg" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-sidebar">
                                <div class="sidebar-section">
                                    <h5><i class="fa fa-line-chart"></i> Usage Statistics</h5>
                                    <div class="stats-container">
                                        <div class="stat-item">
                                            <div class="stat-value" id="usageCount">--</div>
                                            <div class="stat-label">Times Used</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-value" id="lastUsed">--</div>
                                            <div class="stat-label">Last Used</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-value" id="avgDuration">--</div>
                                            <div class="stat-label">Avg. Duration</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="sidebar-section">
                                    <h5><i class="fa fa-users"></i> Related Shifts</h5>
                                    <div id="relatedShifts">
                                        <div class="text-center text-muted">
                                            <i class="fa fa-spinner fa-spin"></i> Loading shifts...
                                        </div>
                                    </div>
                                </div>

                                <div class="sidebar-section">
                                    <h5><i class="fa fa-history"></i> Quick Actions</h5>
                                    <div class="quick-actions">
                                        <button class="btn btn-outline-primary btn-block mb-2" onclick="duplicateConfiguration()">
                                            <i class="fa fa-copy"></i> Duplicate
                                        </button>
                                        <button class="btn btn-outline-info btn-block mb-2" onclick="exportConfiguration()">
                                            <i class="fa fa-download"></i> Export
                                        </button>
                                        <button class="btn btn-outline-success btn-block" onclick="testConfiguration()">
                                            <i class="fa fa-play"></i> Test
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Load usage statistics
            loadUsageStatistics();
            loadRelatedShifts();

            // Animate metric cards
            animateMetrics();
        });

        function loadUsageStatistics() {
            // Simulate loading usage statistics
            setTimeout(function () {
                $('#usageCount').text('156');
                $('#lastUsed').text('Today');
                $('#avgDuration').text('8.5h');
            }, 1500);
        }

        function loadRelatedShifts() {
            // Simulate loading related shifts
            setTimeout(function () {
                var shifts = [
                    { name: 'Morning Shift', time: '08:00-16:00', active: true },
                    { name: 'Day Shift', time: '09:00-17:00', active: true },
                    { name: 'Swing Shift', time: '16:00-00:00', active: false }
                ];

                var html = '';
                shifts.forEach(function (shift) {
                    html += '<div class="shift-item ' + (shift.active ? 'active' : 'inactive') + '">';
                    html += '<strong>' + shift.name + '</strong><br>';
                    html += '<small>' + shift.time + '</small>';
                    html += '</div>';
                });

                $('#relatedShifts').html(html);
            }, 1000);
        }

        function animateMetrics() {
            $('.metric-value').each(function () {
                var $this = $(this);
                var value = $this.text();
                $this.css('opacity', 0);

                setTimeout(function () {
                    $this.animate({ opacity: 1 }, 1000);
                }, 500);
            });
        }

        function duplicateConfiguration() {
            alert('Duplicate functionality would be implemented here');
        }

        function exportConfiguration() {
            alert('Export functionality would be implemented here');
        }

        function testConfiguration() {
            alert('Test functionality would be implemented here');
        }
    </script>
}

