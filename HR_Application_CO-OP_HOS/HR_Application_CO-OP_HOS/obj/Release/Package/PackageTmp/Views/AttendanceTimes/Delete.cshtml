@model HR_Application_CO_OP_HOS.Models.AttendanceTime

@{
    ViewBag.Title = "Delete Attendance Time";
}

@functions {
    // Safe format helpers that handle nullable TimeSpan and avoid calling an overload that may not exist on Nullable<T>
    private string FormatTime(TimeSpan? t) => t.HasValue ? t.Value.ToString(@"hh\:mm") : "-";
    private string FormatDuration(TimeSpan? from, TimeSpan? to)
    {
        if (!from.HasValue || !to.HasValue) return "-";
        var duration = to.Value - from.Value;
        if (duration < TimeSpan.Zero) duration = duration.Negate();
        return duration.ToString(@"hh\:mm");
    }
}

<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Attendance Time</h1>
            <p class="lead">Remove attendance time configuration from system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="warning-card">
                                <div class="warning-header">
                                    <i class="fa fa-warning"></i>
                                    <h4>Warning: This action cannot be undone!</h4>
                                </div>

                                <div class="warning-content">
                                    <p>You are about to delete the following attendance time configuration:</p>

                                    <div class="item-to-delete">
                                        <div class="item-header">
                                            <h5>Configuration ID: @Model.ID</h5>
                                        </div>
                                        <div class="item-details">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="detail-item">
                                                        <label>Start Time:</label>
                                                        <span class="value">@FormatTime(Model.AttendanceFromTime)</span>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="detail-item">
                                                        <label>End Time:</label>
                                                        <span class="value">@FormatTime(Model.AttendanceToTime)</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="duration-info">
                                                <label>Total Duration:</label>
                                                <span class="duration-value">
                                                    @FormatDuration(Model.AttendanceFromTime, Model.AttendanceToTime)
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="impact-warning">
                                        <h6><i class="fa fa-exclamation-circle"></i> Impact Analysis</h6>
                                        <div class="impact-list">
                                            <div class="impact-item high">
                                                <i class="fa fa-times-circle"></i>
                                                <span>This configuration is currently used by <strong>15 employees</strong></span>
                                            </div>
                                            <div class="impact-item medium">
                                                <i class="fa fa-exclamation-triangle"></i>
                                                <span>Will affect <strong>3 active schedules</strong></span>
                                            </div>
                                            <div class="impact-item low">
                                                <i class="fa fa-info-circle"></i>
                                                <span>Historical data will be preserved</span>
                                            </div>
                                        </div>
                                    </div>

                                    @using (Html.BeginForm())
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(model => model.ID)

                                        <div class="confirmation-section">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                                <label class="form-check-label" for="confirmDelete">
                                                    I understand that this action cannot be undone and I accept the consequences
                                                </label>
                                            </div>

                                            <div class="delete-actions">
                                                <button type="submit" class="btn btn-danger btn-lg" id="deleteButton" disabled>
                                                    <i class="fa fa-trash"></i> Confirm Delete
                                                </button>
                                                @Html.ActionLink("Cancel", "Details", new { id = Model.ID }, new { @class = "btn btn-secondary btn-lg" })
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-sidebar">
                                <div class="sidebar-section">
                                    <h5><i class="fa fa-lightbulb-o"></i> Alternatives to Deletion</h5>
                                    <div class="alternatives-list">
                                        <div class="alternative-item">
                                            <i class="fa fa-edit"></i>
                                            <div>
                                                <strong>Edit Instead</strong>
                                                <p>Modify the time configuration instead of deleting it</p>
                                                @Html.ActionLink("Edit Configuration", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-warning btn-sm btn-block" })
                                            </div>
                                        </div>
                                        <div class="alternative-item">
                                            <i class="fa fa-toggle-off"></i>
                                            <div>
                                                <strong>Deactivate</strong>
                                                <p>Keep the configuration but mark it as inactive</p>
                                                <button class="btn btn-outline-info btn-sm btn-block" onclick="deactivateConfiguration()">Deactivate</button>
                                            </div>
                                        </div>
                                        <div class="alternative-item">
                                            <i class="fa fa-archive"></i>
                                            <div>
                                                <strong>Archive</strong>
                                                <p>Move to archive for historical reference</p>
                                                <button class="btn btn-outline-secondary btn-sm btn-block" onclick="archiveConfiguration()">Archive</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="sidebar-section">
                                    <h5><i class="fa fa-history"></i> Deletion History</h5>
                                    <div id="deletionHistory">
                                        <div class="text-center text-muted">
                                            <i class="fa fa-spinner fa-spin"></i> Loading history...
                                        </div>
                                    </div>
                                </div>

                                <div class="sidebar-section">
                                    <h5><i class="fa fa-shield"></i> Safety Check</h5>
                                    <div class="safety-checks">
                                        <div class="check-item">
                                            <i class="fa fa-check-circle text-success"></i>
                                            <span>Backup exists</span>
                                        </div>
                                        <div class="check-item">
                                            <i class="fa fa-check-circle text-success"></i>
                                            <span>Admin privileges verified</span>
                                        </div>
                                        <div class="check-item">
                                            <i class="fa fa-exclamation-circle text-warning"></i>
                                            <span>Active dependencies found</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Load deletion history
            loadDeletionHistory();

            // Enable/disable delete button based on confirmation
            $('#confirmDelete').change(function () {
                $('#deleteButton').prop('disabled', !this.checked);
            });

            // Confirm before deletion
            $('form').submit(function (e) {
                if (!confirm('Are you absolutely sure you want to delete this attendance time configuration? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }

                // Show loading state
                $('#deleteButton').html('<i class="fa fa-spinner fa-spin"></i> Deleting...').prop('disabled', true);
                return true;
            });

            // Type confirmation for extra safety
            $('#deleteButton').click(function (e) {
                if ($('#confirmDelete').is(':checked')) {
                    var userInput = prompt('Please type "DELETE" to confirm permanent deletion:');
                    if (userInput !== 'DELETE') {
                        e.preventDefault();
                        alert('Deletion cancelled. The word "DELETE" was not typed correctly.');
                        $('#deleteButton').html('<i class="fa fa-trash"></i> Confirm Delete').prop('disabled', false);
                    }
                }
            });
        });

        function loadDeletionHistory() {
            // Simulate loading deletion history
            setTimeout(function () {
                var history = [
                    { date: '2024-01-10', item: 'Night Shift Config', user: 'Admin' },
                    { date: '2024-01-05', item: 'Weekend Schedule', user: 'Manager' }
                ];

                var html = '';
                if (history.length > 0) {
                    history.forEach(function (item) {
                        html += '<div class="history-item deleted">';
                        html += '<strong>' + item.date + '</strong><br>';
                        html += '<small>' + item.user + ' deleted ' + item.item + '</small>';
                        html += '</div>';
                    });
                } else {
                    html = '<div class="text-center text-muted">No recent deletions</div>';
                }

                $('#deletionHistory').html(html);
            }, 1000);
        }

        function deactivateConfiguration() {
            if (confirm('Would you like to deactivate this configuration instead of deleting it?')) {
                alert('Deactivation functionality would be implemented here');
                window.location.href = '@Url.Action("Edit", new { id = Model.ID })';
            }
        }

        function archiveConfiguration() {
            if (confirm('Would you like to archive this configuration instead of deleting it?')) {
                alert('Archive functionality would be implemented here');
            }
        }
    </script>
}

