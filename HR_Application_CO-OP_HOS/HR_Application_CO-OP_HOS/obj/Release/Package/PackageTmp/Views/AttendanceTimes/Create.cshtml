@model HR_Application_CO_OP_HOS.Models.AttendanceTime

@{
    ViewBag.Title = "Create Attendance Time";
}

<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create New Attendance Time</h1>
            <p class="lead">Add new attendance time configuration</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-clock-o"></i> Attendance Time Details</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-8">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-container">
                                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                    <div class="form-section">
                                        <h4><i class="fa fa-time"></i> Time Configuration</h4>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendanceFromTime, htmlAttributes: new { @class = "control-label" })
                                                    <div class="input-group">
                                                        @Html.EditorFor(model => model.AttendanceFromTime, new { htmlAttributes = new { @class = "form-control time-picker", type = "time", required = "required" } })
                                                        <div class="input-group-append">
                                                            <span class="input-group-text"><i class="fa fa-clock-o"></i></span>
                                                        </div>
                                                    </div>
                                                    @Html.ValidationMessageFor(model => model.AttendanceFromTime, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AttendanceToTime, htmlAttributes: new { @class = "control-label" })
                                                    <div class="input-group">
                                                        @Html.EditorFor(model => model.AttendanceToTime, new { htmlAttributes = new { @class = "form-control time-picker", type = "time", required = "required" } })
                                                        <div class="input-group-append">
                                                            <span class="input-group-text"><i class="fa fa-clock-o"></i></span>
                                                        </div>
                                                    </div>
                                                    @Html.ValidationMessageFor(model => model.AttendanceToTime, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-actions">
                                        <button type="submit" class="btn btn-success btn-lg">
                                            <i class="fa fa-save"></i> Create Attendance Time
                                        </button>
                                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="col-md-4">
                            <div class="info-panel">
                                <h4><i class="fa fa-info-circle"></i> Information</h4>
                                <div class="info-content">
                                    <div class="info-item">
                                        <h5>Current Time Slots</h5>
                                        <div id="currentTimeSlots">
                                            <div class="text-center text-muted">
                                                <i class="fa fa-spinner fa-spin"></i> Loading...
                                            </div>
                                        </div>
                                    </div>
                                    <div class="info-item">
                                        <h5>Duration Calculator</h5>
                                        <div class="duration-calculator">
                                            <div class="form-group">
                                                <label>Start Time</label>
                                                <input type="time" class="form-control" id="calcStartTime">
                                            </div>
                                            <div class="form-group">
                                                <label>End Time</label>
                                                <input type="time" class="form-control" id="calcEndTime">
                                            </div>
                                            <button class="btn btn-info btn-block" id="calculateDuration">
                                                <i class="fa fa-calculator"></i> Calculate Duration
                                            </button>
                                            <div id="durationResult" class="mt-3 text-center" style="display: none;">
                                                <h4 class="text-success" id="calculatedDuration"></h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Load current time slots
            loadCurrentTimeSlots();

            // Duration calculator
            $('#calculateDuration').click(function () {
                var startTime = $('#calcStartTime').val();
                var endTime = $('#calcEndTime').val();

                if (startTime && endTime) {
                    var start = new Date('2000-01-01T' + startTime);
                    var end = new Date('2000-01-01T' + endTime);

                    if (end < start) {
                        end.setDate(end.getDate() + 1); // Handle overnight
                    }

                    var duration = (end - start) / (1000 * 60 * 60); // hours
                    var hours = Math.floor(duration);
                    var minutes = Math.round((duration - hours) * 60);

                    $('#calculatedDuration').text(hours + ' hours ' + minutes + ' minutes');
                    $('#durationResult').show();
                }
            });

            // Auto-calculate when times change in main form
            $('.time-picker').change(function () {
                var startTime = $('#AttendanceFromTime').val();
                var endTime = $('#AttendanceToTime').val();

                if (startTime && endTime) {
                    $('#calcStartTime').val(startTime);
                    $('#calcEndTime').val(endTime);
                    $('#calculateDuration').click();
                }
            });
        });

        function loadCurrentTimeSlots() {
            // Simulate loading current time slots
            setTimeout(function () {
                var slots = [
                    { from: '08:00', to: '16:00', duration: '8 hours' },
                    { from: '09:00', to: '17:00', duration: '8 hours' },
                    { from: '07:30', to: '15:30', duration: '8 hours' }
                ];

                var html = '';
                if (slots.length > 0) {
                    slots.forEach(function (slot) {
                        html += '<div class="time-slot-item">';
                        html += '<span class="time-from">' + slot.from + '</span>';
                        html += ' <i class="fa fa-arrow-right"></i> ';
                        html += '<span class="time-to">' + slot.to + '</span>';
                        html += '<br><small class="text-muted">' + slot.duration + '</small>';
                        html += '</div>';
                    });
                } else {
                    html = '<div class="text-center text-muted">No time slots configured</div>';
                }

                $('#currentTimeSlots').html(html);
            }, 1000);
        }
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin: 15px;
        background: white;
    }

    .panel-heading {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%) !important;
        color: white;
        border-radius: 10px 10px 0 0 !important;
        padding: 15px 20px;
        border: none;
    }

    .panel-body {
        padding: 30px;
    }

    .form-container {
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .form-section {
        margin-bottom: 30px;
        padding: 20px;
        background: white;
        border-radius: 8px;
        border-left: 4px solid #3498db;
    }

        .form-section h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ecf0f1;
        }

    .form-group {
        margin-bottom: 20px;
    }

    .control-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border: 2px solid #ecf0f1;
        border-radius: 6px;
        padding: 12px 15px;
        font-size: 16px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .input-group-text {
        background: #ecf0f1;
        border: 2px solid #ecf0f1;
        border-left: none;
    }

    .form-actions {
        text-align: center;
        padding: 20px;
        background: white;
        border-radius: 8px;
        margin-top: 30px;
    }

    .btn {
        padding: 12px 30px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 6px;
        margin: 0 10px;
        transition: all 0.3s ease;
    }

    .btn-success {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        border: none;
    }

    .info-panel {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        height: 100%;
        border-left: 4px solid #e74c3c;
    }

        .info-panel h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }

    .info-item {
        margin-bottom: 25px;
    }

        .info-item h5 {
            color: #34495e;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

    .time-slot-item {
        background: white;
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 6px;
        border-left: 3px solid #3498db;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .time-from, .time-to {
        font-weight: 600;
        color: #2c3e50;
    }

    .duration-calculator {
        background: white;
        padding: 15px;
        border-radius: 6px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    @@media (max-width: 768px) {
        .panel-body {
            padding: 15px;
        }

        .form-container {
            padding: 15px;
        }

        .form-actions .btn {
            display: block;
            width: 100%;
            margin: 10px 0;
        }

        .info-panel {
            margin-top: 20px;
        }
    }
</style>