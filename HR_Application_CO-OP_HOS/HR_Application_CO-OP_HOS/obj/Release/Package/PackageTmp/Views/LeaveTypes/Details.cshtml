﻿@model HR_Application_CO_OP_HOS.Models.LeaveType

@{
    ViewBag.Title = "Leave Type Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="fullscreen-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">LEAVE TYPE DETAILS</h1>
            <p class="hospital-subtitle">Hospital Human Resources Management System</p>
            <div class="admin-info">
                <span class="admin-welcome">View Leave Type Configuration</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="dashboard-section">
        <div class="section-header">
            <h2>👁️ LEAVE TYPE INFORMATION</h2>
        </div>

        <div class="section-content">
            <div class="details-container">
                <div class="details-grid">
                    <div class="detail-group">
                        <label class="detail-label">Leave Type Name:</label>
                        <div class="detail-value">@Html.DisplayFor(model => model.LeaveTypeName)</div>
                    </div>

                    <div class="detail-group">
                        <label class="detail-label">Leave Code:</label>
                        <div class="detail-value">@Html.DisplayFor(model => model.LeaveCode)</div>
                    </div>

                    <div class="detail-group">
                        <label class="detail-label">Maximum Days Per Year:</label>
                        <div class="detail-value">@Html.DisplayFor(model => model.MaxDaysPerYear)</div>
                    </div>

                    <div class="detail-group">
                        <label class="detail-label">Paid Leave:</label>
                        <div class="detail-value">
                            <span class="status-badge @(Model.IsPaid ? "status-active" : "status-inactive")">
                                @(Model.IsPaid ? "Yes" : "No")
                            </span>
                        </div>
                    </div>

                    <div class="detail-group">
                        <label class="detail-label">Status:</label>
                        <div class="detail-value">
                            <span class="status-badge @(Model.IsActive ? "status-active" : "status-inactive")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="action-buttons">
                    <a href="@Url.Action("Edit", new { id = Model.LeaveTypeID })" class="btn btn-primary">
                        <span class="btn-icon">✏️</span>
                        EDIT
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <span class="btn-icon">←</span>
                        BACK TO LIST
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fullscreen-container {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: #f8f9fa;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #006400, #004d00);
        color: white;
        padding: 30px 20px;
        text-align: center;
    }

    .hospital-name {
        font-size: 3rem;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .hospital-subtitle {
        font-size: 1.5rem;
        opacity: 0.9;
        margin-bottom: 20px;
    }

    .admin-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.4rem;
        background: rgba(255,255,255,0.1);
        padding: 15px;
        border-radius: 10px;
        margin-top: 20px;
    }

    .dashboard-section {
        background: white;
        margin: 20px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .section-header {
        background: #006400;
        color: white;
        padding: 20px;
        border-radius: 15px 15px 0 0;
    }

        .section-header h2 {
            margin: 0;
            font-size: 2rem;
        }

    .section-content {
        padding: 40px;
    }

    .details-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        margin-bottom: 40px;
    }

    .detail-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .detail-label {
        font-weight: bold;
        font-size: 1.4rem;
        color: #333;
    }

    .detail-value {
        font-size: 1.4rem;
        color: #666;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #006400;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 1.2rem;
        font-weight: bold;
        text-transform: uppercase;
        display: inline-block;
    }

    .status-active {
        background: #d4edda;
        color: #155724;
    }

    .status-inactive {
        background: #f8d7da;
        color: #721c24;
    }

    .action-buttons {
        display: flex;
        gap: 20px;
        margin-top: 40px;
        padding-top: 30px;
        border-top: 2px solid #eee;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 30px;
        font-size: 1.4rem;
        font-weight: bold;
        text-decoration: none;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: #006400;
        color: white;
    }

        .btn-primary:hover {
            background: #004d00;
            transform: translateY(-2px);
            text-decoration: none;
            color: white;
        }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

        .btn-secondary:hover {
            background: #545b62;
            transform: translateY(-2px);
            text-decoration: none;
            color: white;
        }

    .btn-icon {
        font-size: 1.6rem;
    }

    @@media (max-width: 768px) {
        .details-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column;
        }

        .hospital-name {
            font-size: 2rem;
        }

        .admin-info {
            flex-direction: column;
            gap: 10px;
            text-align: center;
        }
    }
</style>