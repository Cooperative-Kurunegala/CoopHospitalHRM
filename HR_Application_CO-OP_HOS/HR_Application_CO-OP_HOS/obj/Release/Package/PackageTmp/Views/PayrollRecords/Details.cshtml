@model HR_Application_CO_OP_HOS.Models.PayrollRecord
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Payroll Details</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f5f5f5;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .header {
            background: #006400;
            color: white;
            padding: 20px;
            text-align: center;
        }

            .header h1 {
                margin: 0;
                font-size: 2rem;
            }

        .content {
            padding: 30px;
        }

        .dl-horizontal {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 15px;
            margin-bottom: 30px;
        }

        dt {
            font-weight: bold;
            color: #006400;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 5px;
        }

        dd {
            margin: 0;
            padding: 10px;
            border: 1px solid #dee2e6;
            border-radius: 5px;
        }

        .financial-positive {
            color: #28a745;
            font-weight: bold;
        }

        .financial-negative {
            color: #dc3545;
            font-weight: bold;
        }

        .action-links {
            text-align: center;
            padding: 20px;
            border-top: 1px solid #dee2e6;
        }

            .action-links a {
                margin: 0 10px;
                padding: 10px 20px;
                text-decoration: none;
                border-radius: 5px;
                font-weight: bold;
            }

        .btn-edit {
            background: #ffc107;
            color: black;
        }

        .btn-back {
            background: #6c757d;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Payroll Record Details</h1>
        </div>

        <div class="content">
            <dl class="dl-horizontal">
                <dt>Employee ID</dt>
                <dd>@Model.EmployeeID</dd>

                <dt>Pay Period</dt>
                <dd>@(Model.PayPeriod ?? "")</dd>

                <dt>Pay Date</dt>
                <dd>@Model.PayDate.ToString("yyyy-MM-dd")</dd>

                <dt>Basic Salary</dt>
                <dd class="financial-positive">@Model.BasicSalary.ToString("C")</dd>

                <dt>Fixed Allowances</dt>
                <dd class="financial-positive">@Model.FixedAllowances.ToString("C")</dd>

                <dt>Variable Allowances</dt>
                <dd class="financial-positive">@Model.VariableAllowances.ToString("C")</dd>

                <dt>Overtime Pay</dt>
                <dd class="financial-positive">@Model.OvertimePay.ToString("C")</dd>

                <dt>Shift Allowances</dt>
                <dd class="financial-positive">@Model.ShiftAllowances.ToString("C")</dd>

                <dt>Attendance Incentive</dt>
                <dd class="financial-positive">@Model.AttendanceIncentive.ToString("C")</dd>

                <dt>Gross Salary</dt>
                <dd class="financial-positive">@Model.GrossSalary.ToString("C")</dd>

                <dt>EPF Employee</dt>
                <dd class="financial-negative">@Model.EPFEmployee.ToString("C")</dd>

                <dt>EPF Employer</dt>
                <dd class="financial-negative">@Model.EPFEmployer.ToString("C")</dd>

                <dt>ETF Employer</dt>
                <dd class="financial-negative">@Model.ETFEmployer.ToString("C")</dd>

                <dt>Payee Tax</dt>
                <dd class="financial-negative">@Model.PayeeTax.ToString("C")</dd>

                <dt>Loan Deductions</dt>
                <dd class="financial-negative">@Model.LoanDeductions.ToString("C")</dd>

                <dt>Other Deductions</dt>
                <dd class="financial-negative">@Model.OtherDeductions.ToString("C")</dd>

                <dt>Total Deductions</dt>
                <dd class="financial-negative">@Model.TotalDeductions.ToString("C")</dd>

                <dt>Net Salary</dt>
                <dd class="financial-positive">@Model.NetSalary.ToString("C")</dd>

                <dt>Status</dt>
                <dd>@(Model.Status ?? "")</dd>

                <dt>Payment Method</dt>
                <dd>@(Model.PaymentMethod ?? "")</dd>

                <dt>Bank Account ID</dt>
                <dd>@(Model.BankAccountID.HasValue ? Model.BankAccountID.Value.ToString() : "N/A")</dd>

                <dt>Generated Date</dt>
                <dd>@Model.GeneratedDate.ToString("yyyy-MM-dd")</dd>

                <dt>Generated By</dt>
                <dd>@(Model.GeneratedBy.HasValue ? Model.GeneratedBy.Value.ToString() : "N/A")</dd>
            </dl>

            <div class="action-links">
                <a href="@Url.Action("Edit", new { id = Model.PayrollID })" class="btn-edit">Edit</a>
                <a href="@Url.Action("Index")" class="btn-back">Back to List</a>
            </div>
        </div>
    </div>
</body>
</html>