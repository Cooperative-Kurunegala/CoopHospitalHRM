@model HR_Application_CO_OP_HOS.Models.PayrollRecord

@{
    ViewBag.Title = "Payroll Record Details";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-file-text"></i> Payroll Record Details</h1>
            <p class="lead">Detailed view of payroll record information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Details -->
        <div class="col-md-8">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Payroll Information</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-group">
                                <label class="detail-label">Record ID:</label>
                                <div class="detail-value">@Model.Id</div>
                            </div>
                            <div class="detail-group">
                                <label class="detail-label">Employee:</label>
                                <div class="detail-value">
                                    @if (Model.RelatedParty != null)
                                    {
                                        @Model.RelatedParty.RegistrationNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">Employee @Model.EmployeeId</span>
                                    }
                                </div>
                            </div>
                            <div class="detail-group">
                                <label class="detail-label">Pay Period:</label>
                                <div class="detail-value">
                                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month), @Model.Year
                                </div>
                            </div>
                            <div class="detail-group">
                                <label class="detail-label">Generated Date:</label>
                                <div class="detail-value">@Model.GeneratedDate.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-group">
                                <label class="detail-label">Basic Salary:</label>
                                <div class="detail-value salary-amount">@Model.BasicSalary.ToString("C")</div>
                            </div>
                            <div class="detail-group">
                                <label class="detail-label">Total Allowances:</label>
                                <div class="detail-value salary-amount allowance">@Model.TotalAllowances.ToString("C")</div>
                            </div>
                            <div class="detail-group">
                                <label class="detail-label">Total Deductions:</label>
                                <div class="detail-value salary-amount deduction">@Model.TotalDeductions.ToString("C")</div>
                            </div>
                            <div class="detail-group">
                                <label class="detail-label">Net Salary:</label>
                                <div class="detail-value salary-amount net-salary">@Model.NetSalary.ToString("C")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Salary Breakdown Chart -->
                    <div class="row" style="margin-top: 30px;">
                        <div class="col-12">
                            <h4><i class="fa fa-pie-chart"></i> Salary Breakdown</h4>
                            <div id="salaryChart" style="height: 200px; background: #f8f9fa; border-radius: 8px; padding: 20px;">
                                <canvas id="breakdownChart" width="400" height="200"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Audit Information -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Audit Information</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-group">
                                <label class="detail-label">Created Date:</label>
                                <div class="detail-value">@(Model.CreatedDate?.ToString("MMM dd, yyyy HH:mm") ?? "N/A")</div>
                            </div>
                            <div class="detail-group">
                                <label class="detail-label">Created By:</label>
                                <div class="detail-value">@(Model.CreatedBy?.ToString() ?? "N/A")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-group">
                                <label class="detail-label">Modified Date:</label>
                                <div class="detail-value">@(Model.ModifiedDate?.ToString("MMM dd, yyyy HH:mm") ?? "N/A")</div>
                            </div>
                            <div class="detail-group">
                                <label class="detail-label">Modified By:</label>
                                <div class="detail-value">@(Model.ModifiedBy?.ToString() ?? "N/A")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Information -->
        <div class="col-md-4">
            <!-- Employee Information -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-user"></i> Employee Information</h3>
                </div>
                <div class="panel-body">
                    @if (Model.RelatedParty != null)
                    {
                        <div class="employee-details">
                            <h4>@Model.RelatedParty.RegistrationNumber</h4>
                            <p><strong>Employee ID:</strong> @Model.EmployeeId</p>
                            <p><strong>Related Party ID:</strong> @Model.RelatedParty.ID</p>
                            <hr>
                            <p class="text-muted">
                                <small>
                                    For complete employee details, visit the
                                    @Html.ActionLink("Employee Management", "Index", "RelatedParties") section.
                                </small>
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle"></i>
                            Employee details not available. Employee ID: @Model.EmployeeId
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="action-buttons">
                        @Html.ActionLink("Edit Record", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning btn-block btn-lg" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default btn-block btn-lg" })
                        @Html.ActionLink("Print Details", "javascript:void(0)", null, new { @class = "btn btn-info btn-block btn-lg", @onclick = "printDetails()" })
                    </div>
                </div>
            </div>

            <!-- Salary Summary -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calculator"></i> Salary Summary</h3>
                </div>
                <div class="panel-body">
                    <div class="salary-summary">
                        <div class="summary-item">
                            <span class="summary-label">Gross Salary:</span>
                            <span class="summary-value">@((Model.BasicSalary + Model.TotalAllowances).ToString("C"))</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Deductions:</span>
                            <span class="summary-value text-danger">@Model.TotalDeductions.ToString("C")</span>
                        </div>
                        <div class="summary-item total">
                            <span class="summary-label">Net Pay:</span>
                            <span class="summary-value text-success">@Model.NetSalary.ToString("C")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function printDetails() {
            try {
                window.print();
            } catch (error) {
                alert('Error printing details: ' + error.message);
            }
        }

        function initializeChart() {
            try {
                var ctx = document.getElementById('breakdownChart').getContext('2d');
                var chart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Basic Salary', 'Allowances', 'Deductions'],
                        datasets: [{
                            data: [
                                @Model.BasicSalary,
                                @Model.TotalAllowances,
                                @Model.TotalDeductions
                            ],
                            backgroundColor: [
                                '#3498db',
                                '#2ecc71',
                                '#e74c3c'
                            ],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true
                            }
                        },
                        tooltips: {
                            callbacks: {
                                label: function(tooltipItem, data) {
                                    var dataset = data.datasets[tooltipItem.datasetIndex];
                                    var total = dataset.data.reduce(function(previousValue, currentValue) {
                                        return previousValue + currentValue;
                                    });
                                    var currentValue = dataset.data[tooltipItem.index];
                                    var percentage = Math.floor((currentValue / total) * 100 + 0.5);
                                    return data.labels[tooltipItem.index] + ': ' + currentValue.toLocaleString('en-US', {
                                        style: 'currency',
                                        currency: 'USD'
                                    }) + ' (' + percentage + '%)';
                                }
                            }
                        }
                    }
                });
            } catch (error) {
                console.error('Error initializing chart:', error);
                document.getElementById('salaryChart').innerHTML =
                    '<div class="alert alert-warning text-center">Chart could not be loaded</div>';
            }
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            initializeChart();
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .detail-group {
        margin-bottom: 20px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #3498db;
    }

    .detail-label {
        font-weight: 600;
        color: #2c3e50;
        display: block;
        margin-bottom: 5px;
        font-size: 0.9em;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .detail-value {
        font-size: 1.2em;
        color: #34495e;
        font-weight: 500;
    }

    .salary-amount {
        font-size: 1.3em;
        font-weight: 600;
    }

    .net-salary {
        color: #27ae60;
        font-size: 1.5em;
    }

    .allowance {
        color: #2ecc71;
    }

    .deduction {
        color: #e74c3c;
    }

    .action-buttons .btn {
        margin-bottom: 10px;
        padding: 12px;
        font-size: 1.1em;
    }

    .salary-summary {
        font-size: 1.1em;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #ecf0f1;
    }

        .summary-item.total {
            border-top: 2px solid #bdc3c7;
            border-bottom: none;
            font-weight: bold;
            font-size: 1.2em;
            margin-top: 10px;
            padding-top: 15px;
        }

    .summary-label {
        color: #7f8c8d;
    }

    .summary-value {
        font-weight: 600;
    }

    .employee-details h4 {
        color: #2c3e50;
        margin-bottom: 15px;
    }

    @@media print {
        .dashboard-header,
        .panel-heading,
        .action-buttons {
            display: none !important;
        }

        .dashboard-container {
            background: white !important;
            padding: 0 !important;
        }

        .panel {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
        }
    }
</style>