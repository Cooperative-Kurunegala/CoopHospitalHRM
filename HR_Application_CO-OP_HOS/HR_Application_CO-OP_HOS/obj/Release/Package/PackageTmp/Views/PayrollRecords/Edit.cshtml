@model HR_Application_CO_OP_HOS.Models.PayrollRecord

@{
    ViewBag.Title = "Edit Payroll Record";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Payroll Record</h1>
            <p class="lead">Update payroll record information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Payroll Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Id)

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.EmployeeId, "Employee", new { @class = "control-label" })
                                    @Html.DropDownList("EmployeeId", null, "Select Employee", new { @class = "form-control", @onchange = "loadEmployeeDetails(this.value)" })
                                    @Html.ValidationMessageFor(model => model.EmployeeId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Month, new { @class = "control-label" })
                                    @Html.DropDownListFor(model => model.Month, Enumerable.Range(1, 12).Select(m => new SelectListItem
                               {
                                   Text = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m),
                                   Value = m.ToString(),
                                   Selected = m == Model.Month
                               }), "Select Month", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Month, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Year, new { @class = "control-label" })
                                    @Html.EditorFor(model => model.Year, new { htmlAttributes = new { @class = "form-control", @type = "number", @min = "2000", @max = "2100" } })
                                    @Html.ValidationMessageFor(model => model.Year, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.BasicSalary, new { @class = "control-label" })
                                    <div class="input-group">
                                        <span class="input-group-addon">$</span>
                                        @Html.EditorFor(model => model.BasicSalary, new { htmlAttributes = new { @class = "form-control", @onchange = "calculateNetSalary()" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.BasicSalary, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.TotalAllowances, new { @class = "control-label" })
                                    <div class="input-group">
                                        <span class="input-group-addon">$</span>
                                        @Html.EditorFor(model => model.TotalAllowances, new { htmlAttributes = new { @class = "form-control", @onchange = "calculateNetSalary()" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.TotalAllowances, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.TotalDeductions, new { @class = "control-label" })
                                    <div class="input-group">
                                        <span class="input-group-addon">$</span>
                                        @Html.EditorFor(model => model.TotalDeductions, new { htmlAttributes = new { @class = "form-control", @onchange = "calculateNetSalary()" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.TotalDeductions, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NetSalary, new { @class = "control-label" })
                                    <div class="input-group">
                                        <span class="input-group-addon">$</span>
                                        @Html.EditorFor(model => model.NetSalary, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.NetSalary, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.GeneratedDate, new { @class = "control-label" })
                                    @Html.EditorFor(model => model.GeneratedDate, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                                    @Html.ValidationMessageFor(model => model.GeneratedDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Audit Fields -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CreatedDate, new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ModifiedDate, new { @class = "control-label" })
                                    @Html.EditorFor(model => model.ModifiedDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @Value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") } })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="fa fa-save"></i> Update Payroll Record
                            </button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default btn-lg" })
                            @Html.ActionLink("View Details", "Details", new { id = Model.Id }, new { @class = "btn btn-info btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Employee Details & Calculator Section -->
        <div class="col-md-4">
            <div class="panel panel-info" id="employeeDetailsPanel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-user"></i> Employee Details</h3>
                </div>
                <div class="panel-body" id="employeeDetails">
                    <div class="text-center">
                        <i class="fa fa-spinner fa-spin"></i> Loading employee details...
                    </div>
                </div>
            </div>

            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calculator"></i> Salary Calculator</h3>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <label>Basic Salary:</label>
                        <input type="number" class="form-control" id="calcBasic" onchange="updateCalculator()" value="@Model.BasicSalary">
                    </div>
                    <div class="form-group">
                        <label>Allowances:</label>
                        <input type="number" class="form-control" id="calcAllowances" onchange="updateCalculator()" value="@Model.TotalAllowances">
                    </div>
                    <div class="form-group">
                        <label>Deductions:</label>
                        <input type="number" class="form-control" id="calcDeductions" onchange="updateCalculator()" value="@Model.TotalDeductions">
                    </div>
                    <div class="form-group">
                        <label>Net Salary:</label>
                        <input type="number" class="form-control" id="calcNet" readonly style="font-weight: bold; background-color: #e8f5e8;" value="@Model.NetSalary">
                    </div>
                    <button type="button" class="btn btn-success btn-block" onclick="applyCalculatorValues()">
                        Apply to Form
                    </button>
                </div>
            </div>

            <!-- Change History -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Record History</h3>
                </div>
                <div class="panel-body">
                    <p><strong>Created:</strong> @(Model.CreatedDate?.ToString("MMM dd, yyyy HH:mm") ?? "N/A")</p>
                    <p><strong>Last Modified:</strong> @(Model.ModifiedDate?.ToString("MMM dd, yyyy HH:mm") ?? "N/A")</p>
                    <p><strong>Record ID:</strong> @Model.Id</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function calculateNetSalary() {
            try {
                var basic = parseFloat($('#BasicSalary').val()) || 0;
                var allowances = parseFloat($('#TotalAllowances').val()) || 0;
                var deductions = parseFloat($('#TotalDeductions').val()) || 0;
                var netSalary = basic + allowances - deductions;
                $('#NetSalary').val(netSalary.toFixed(2));
            } catch (error) {
                console.error('Error calculating net salary:', error);
            }
        }

        function updateCalculator() {
            try {
                var basic = parseFloat($('#calcBasic').val()) || 0;
                var allowances = parseFloat($('#calcAllowances').val()) || 0;
                var deductions = parseFloat($('#calcDeductions').val()) || 0;
                var net = basic + allowances - deductions;
                $('#calcNet').val(net.toFixed(2));
            } catch (error) {
                console.error('Error updating calculator:', error);
            }
        }

        function applyCalculatorValues() {
            try {
                $('#BasicSalary').val($('#calcBasic').val());
                $('#TotalAllowances').val($('#calcAllowances').val());
                $('#TotalDeductions').val($('#calcDeductions').val());
                calculateNetSalary();
            } catch (error) {
                alert('Error applying calculator values: ' + error.message);
            }
        }

        function loadEmployeeDetails(employeeId) {
            if (!employeeId) {
                $('#employeeDetailsPanel').hide();
                return;
            }

            try {
                // Simulate loading employee details
                setTimeout(function () {
                    var employeeData = {
                        name: "Employee " + employeeId,
                        designation: "Designation " + employeeId,
                        department: "Department " + employeeId,
                        basicSalary: (50000 + (employeeId * 1000)).toFixed(2)
                    };

                    var html = `
                        <div class="employee-info">
                            <h4>${employeeData.name}</h4>
                            <p><strong>Designation:</strong> ${employeeData.designation}</p>
                            <p><strong>Department:</strong> ${employeeData.department}</p>
                            <p><strong>Current Basic Salary:</strong> $${employeeData.basicSalary}</p>
                            <hr>
                            <p class="text-muted"><small>Employee ID: ${employeeId}</small></p>
                        </div>
                    `;
                    $('#employeeDetails').html(html);
                }, 500);
            } catch (error) {
                $('#employeeDetails').html('<div class="alert alert-danger">Error loading employee details</div>');
            }
        }

        // Initialize on page load
        $(document).ready(function () {
            calculateNetSalary();
            updateCalculator();
            loadEmployeeDetails($('#EmployeeId').val());
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .control-label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .input-group-addon {
        background-color: #ecf0f1;
        border: 1px solid #bdc3c7;
    }

    .employee-info h4 {
        color: #2c3e50;
        margin-bottom: 15px;
    }
</style>