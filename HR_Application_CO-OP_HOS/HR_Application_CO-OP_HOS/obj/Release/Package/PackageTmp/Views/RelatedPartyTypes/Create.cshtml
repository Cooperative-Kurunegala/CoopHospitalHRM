@model HR_Application_CO_OP_HOS.Models.RelatedPartyType

@{
    Layout = null;
    ViewBag.Title = "Create Related Party Type";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Related Party Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

            .dashboard-header h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .dashboard-header .lead {
                font-size: 1.4rem;
                opacity: 0.9;
            }

        .form-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            padding: 30px;
            margin: 0 20px 30px 20px;
        }

        .form-header {
            border-bottom: 2px solid #3498db;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

            .form-header h4 {
                color: #2c3e50;
                font-weight: 600;
                margin: 0;
            }

        .form-group {
            margin-bottom: 25px;
        }

        .control-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }

        .btn-outline-secondary {
            border: 2px solid #95a5a6;
            border-radius: 8px;
            padding: 12px 30px;
            font-weight: 600;
            font-size: 1.1rem;
            color: #7f8c8d;
            transition: all 0.3s ease;
        }

            .btn-outline-secondary:hover {
                background-color: #95a5a6;
                color: white;
                transform: translateY(-2px);
            }

        .text-danger {
            font-size: 0.9rem;
            margin-top: 5px;
            font-weight: 500;
        }

        .action-links {
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #e9ecef;
        }

        .info-panel {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #3498db;
        }

            .info-panel h5 {
                color: #2c3e50;
                margin-bottom: 15px;
                font-weight: 600;
            }

        .info-item {
            padding: 8px 0;
            border-bottom: 1px solid #e9ecef;
        }

            .info-item:last-child {
                border-bottom: none;
            }

        .filter-section {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .filter-header {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        @@media (max-width: 768px) {
            .form-container {
                margin: 0 10px 20px 10px;
                padding: 20px;
            }

            .dashboard-header {
                padding: 20px;
            }

                .dashboard-header h1 {
                    font-size: 2rem;
                }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Dashboard Header -->
        <div class="dashboard-header">
            <h1><i class="fa fa-plus-circle"></i> Create Related Party Type</h1>
            <p class="lead">Add a new related party type to the system</p>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="form-container">
                    <div class="form-header">
                        <h4><i class="fa fa-info-circle"></i> Related Party Type Information</h4>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group">
                                @Html.LabelFor(model => model.RelatedPartyTypeName, htmlAttributes: new { @class = "control-label" })
                                <div>
                                    @Html.EditorFor(model => model.RelatedPartyTypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter related party type name" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyTypeName, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="d-flex gap-3">
                                    <input type="submit" value="Create" class="btn btn-primary" />
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="form-container">
                    <div class="form-header">
                        <h4><i class="fa fa-database"></i> System Information</h4>
                    </div>

                    <div class="info-panel">
                        <h5>Related Party Types</h5>
                        <div class="info-item">
                            <strong>Total Types:</strong>
                            <span class="float-end">
                                @try
                                {
                                    var db = new HR_Application_CO_OP_HOS.Models.HREntities();
                                    var count = db.RelatedPartyTypes.Count();
                                    <span>@count</span>
                                }
                                catch (Exception ex)
                                {
                                    <span class="text-danger">Error: @ex.Message</span>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="info-panel mt-4">
                        <h5>Quick Actions</h5>
                        <div class="d-grid gap-2">
                            @Html.ActionLink("View All Types", "Index", null, new { @class = "btn btn-outline-primary btn-sm" })
                            @Html.ActionLink("Manage Related Parties", "Index", "RelatedParties", null, new { @class = "btn btn-outline-info btn-sm" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Form validation enhancement
            $('form').on('submit', function (e) {
                var isValid = $(this).valid();
                if (isValid) {
                    $('input[type="submit"]').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Creating...');
                }
            });

            // Auto-focus on first input
            $('form input[type="text"]:first').focus();

            // Real-time validation feedback
            $('.form-control').on('blur', function () {
                $(this).valid();
            });
        });
    </script>
</body>
</html>