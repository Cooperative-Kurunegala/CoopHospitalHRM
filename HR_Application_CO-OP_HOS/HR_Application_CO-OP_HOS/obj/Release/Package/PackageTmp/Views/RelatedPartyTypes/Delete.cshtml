@model HR_Application_CO_OP_HOS.Models.RelatedPartyType

@{
    Layout = null;
    ViewBag.Title = "Delete Related Party Type";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Related Party Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

            .dashboard-header h1 {
                font-size: 2.5rem;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .dashboard-header .lead {
                font-size: 1.4rem;
                opacity: 0.9;
            }

        .alert-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            padding: 30px;
            margin: 0 20px 30px 20px;
            border-left: 6px solid #e74c3c;
        }

        .alert-header {
            border-bottom: 2px solid #e74c3c;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

            .alert-header h4 {
                color: #2c3e50;
                font-weight: 600;
                margin: 0;
            }

        .details-panel {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .detail-item {
            padding: 12px 0;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
        }

        .detail-value {
            color: #7f8c8d;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
            }

        .btn-outline-secondary {
            border: 2px solid #95a5a6;
            border-radius: 8px;
            padding: 12px 30px;
            font-weight: 600;
            font-size: 1.1rem;
            color: #7f8c8d;
            transition: all 0.3s ease;
        }

            .btn-outline-secondary:hover {
                background-color: #95a5a6;
                color: white;
                transform: translateY(-2px);
            }

        .warning-icon {
            font-size: 4rem;
            color: #e74c3c;
            text-align: center;
            margin-bottom: 20px;
        }

        .impact-panel {
            background: #fff3f3;
            border-radius: 8px;
            padding: 20px;
            margin-top: 25px;
            border-left: 4px solid #e74c3c;
        }

            .impact-panel h5 {
                color: #c0392b;
                margin-bottom: 15px;
                font-weight: 600;
            }

        @@media (max-width: 768px) {
            .alert-container {
                margin: 0 10px 20px 10px;
                padding: 20px;
            }

            .dashboard-header {
                padding: 20px;
            }

                .dashboard-header h1 {
                    font-size: 2rem;
                }

            .detail-item {
                flex-direction: column;
            }

            .detail-value {
                margin-top: 5px;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Dashboard Header -->
        <div class="dashboard-header">
            <h1><i class="fa fa-exclamation-triangle"></i> Delete Related Party Type</h1>
            <p class="lead">Permanently remove this related party type from the system</p>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="alert-container">
                    <div class="alert-header">
                        <h4><i class="fa fa-warning"></i> Confirm Deletion</h4>
                    </div>

                    <div class="warning-icon">
                        <i class="fa fa-exclamation-circle"></i>
                    </div>

                    <h3 class="text-center text-danger mb-4">Are you sure you want to delete this?</h3>

                    <div class="details-panel">
                        <div class="detail-item">
                            <span class="detail-label">@Html.DisplayNameFor(model => model.RelatedPartyTypeName)</span>
                            <span class="detail-value">@Html.DisplayFor(model => model.RelatedPartyTypeName)</span>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="impact-panel">
                            <h5><i class="fa fa-info-circle"></i> Deletion Impact</h5>
                            <p class="mb-2">This action will permanently remove the related party type from the system.</p>
                            <p class="mb-0"><strong>Note:</strong> This action cannot be undone.</p>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <input type="submit" value="Delete" class="btn btn-danger" />
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="alert-container" style="border-left-color: #3498db;">
                    <div class="alert-header" style="border-bottom-color: #3498db;">
                        <h4><i class="fa fa-database"></i> System Information</h4>
                    </div>

                    <div class="details-panel">
                        <h5 class="mb-3">Related Data</h5>
                        <div class="detail-item">
                            <span class="detail-label">Related Parties:</span>
                            <span class="detail-value">
                                @try
                                {
                                    var db = new HR_Application_CO_OP_HOS.Models.HREntities();
                                    var count = db.RelatedParties.Count(rp => rp.RelatedPartyTypeID == Model.ID);
                                    <span>@count</span>
                                }
                                catch (Exception ex)
                                {
                                    <span class="text-danger">Error</span>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="details-panel mt-4">
                        <h5 class="mb-3">Quick Actions</h5>
                        <div class="d-grid gap-2">
                            @Html.ActionLink("View All Types", "Index", null, new { @class = "btn btn-outline-primary btn-sm" })
                            @Html.ActionLink("Edit This Type", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-warning btn-sm" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Confirm deletion
            $('form').on('submit', function (e) {
                if (!confirm('Are you absolutely sure you want to delete this related party type? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }

                $('input[type="submit"]').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Deleting...');
            });

            // Escape key to go back
            $(document).keyup(function (e) {
                if (e.keyCode === 27) { // Escape key
                    window.location.href = '@Url.Action("Index")';
                }
            });
        });
    </script>
</body>
</html>