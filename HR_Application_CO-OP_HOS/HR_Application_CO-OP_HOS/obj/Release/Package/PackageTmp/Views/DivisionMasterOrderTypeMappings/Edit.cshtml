@model HR_Application_CO_OP_HOS.Models.DivisionMasterOrderTypeMapping

@{
    ViewBag.Title = "Edit Mapping";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Mapping</h1>
            <p class="lead">Update division master order type mapping details</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Mapping Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-container">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            @Html.HiddenFor(model => model.ID)

                            <div class="current-values mb-4">
                                <h5><i class="fa fa-info-circle"></i> Current Values</h5>
                                <div class="row">
                                    <div class="col-md-4">
                                        <strong>Division Master:</strong><br>
                                        <span id="currentDivision">Loading...</span>
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Order Type:</strong><br>
                                        <span id="currentOrderType">Loading...</span>
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Location:</strong><br>
                                        <span id="currentLocation">Loading...</span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.DivisionMasterID, "Division Master", new { @class = "control-label" })
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.DivisionMasterID, (SelectList)ViewBag.DivisionMasters, "Select Division Master", new { @class = "form-control", id = "DivisionMasterID" })
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-info" onclick="showDivisionDetails()">
                                                <i class="fa fa-info"></i>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.DivisionMasterID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.OrderTypeID, "Order Type", new { @class = "control-label" })
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.OrderTypeID, (SelectList)ViewBag.OrderTypes, "Select Order Type", new { @class = "form-control", id = "OrderTypeID" })
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-info" onclick="showOrderTypeDetails()">
                                                <i class="fa fa-info"></i>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.OrderTypeID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.LocationID, "Location", new { @class = "control-label" })
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.LocationID, (SelectList)ViewBag.Locations, "Select Location", new { @class = "form-control", id = "LocationID" })
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-info" onclick="showLocationDetails()">
                                                <i class="fa fa-info"></i>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.LocationID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group col-md-6">
                                    @Html.LabelFor(model => model.OrderSequence, "Order Sequence", new { @class = "control-label" })
                                    @Html.EditorFor(model => model.OrderSequence, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter sequence number" } })
                                    @Html.ValidationMessageFor(model => model.OrderSequence, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Lower numbers have higher priority</small>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-warning btn-lg">
                                    <i class="fa fa-save"></i> Update Mapping
                                </button>
                                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                @Html.ActionLink("Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Division Master Details Panel -->
            <div class="panel panel-info" id="divisionPanel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-building"></i> Division Master Info</h3>
                </div>
                <div class="panel-body">
                    <div class="info-placeholder" id="divisionInfo">
                        <p class="text-muted">Select a division master to view details</p>
                    </div>
                </div>
            </div>

            <!-- Order Type Details Panel -->
            <div class="panel panel-primary" id="orderTypePanel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-list-alt"></i> Order Type Info</h3>
                </div>
                <div class="panel-body">
                    <div class="info-placeholder" id="orderTypeInfo">
                        <p class="text-muted">Select an order type to view details</p>
                    </div>
                </div>
            </div>

            <!-- Location Details Panel -->
            <div class="panel panel-success" id="locationPanel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-map-marker"></i> Location Info</h3>
                </div>
                <div class="panel-body">
                    <div class="info-placeholder" id="locationInfo">
                        <p class="text-muted">Select a location to view details</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sample data - in real scenario, this would come from the database
        var divisionMastersData = {
            @if (ViewBag.DivisionMastersDictionary != null)
            {
                foreach (var item in ViewBag.DivisionMastersDictionary)
                {
                    <text>@item.Key: { name: "@item.Value", code: "DM@(item.Key)", description: "Division Master @item.Key details" },</text>
                }
            }
        };

        var orderTypesData = {
            @if (ViewBag.OrderTypesDictionary != null)
            {
                foreach (var item in ViewBag.OrderTypesDictionary)
                {
                    <text>@item.Key: { name: "@item.Value", code: "OT@(item.Key)", sequence: "@(item.Key * 10)" },</text>
                }
            }
        };

        var locationsData = {
            @if (ViewBag.LocationsDictionary != null)
            {
                foreach (var item in ViewBag.LocationsDictionary)
                {
                    <text>@item.Key: { name: "@item.Value", orderIndex: "@(item.Key * 5)" },</text>
                }
            }
        };

        function showDivisionDetails() {
            var divisionId = $('#DivisionMasterID').val();
            var infoDiv = $('#divisionInfo');

            if (divisionId && divisionMastersData[divisionId]) {
                var division = divisionMastersData[divisionId];
                infoDiv.html(`
                    <h5>${division.name}</h5>
                    <p><strong>Code:</strong> ${division.code}</p>
                    <p><strong>Description:</strong> ${division.description}</p>
                    <p><strong>ID:</strong> ${divisionId}</p>
                `);
            } else {
                infoDiv.html('<p class="text-warning">Please select a valid division master</p>');
            }
        }

        function showOrderTypeDetails() {
            var orderTypeId = $('#OrderTypeID').val();
            var infoDiv = $('#orderTypeInfo');

            if (orderTypeId && orderTypesData[orderTypeId]) {
                var orderType = orderTypesData[orderTypeId];
                infoDiv.html(`
                    <h5>${orderType.name}</h5>
                    <p><strong>Code:</strong> ${orderType.code}</p>
                    <p><strong>Default Sequence:</strong> ${orderType.sequence}</p>
                    <p><strong>ID:</strong> ${orderTypeId}</p>
                `);
            } else {
                infoDiv.html('<p class="text-warning">Please select a valid order type</p>');
            }
        }

        function showLocationDetails() {
            var locationId = $('#LocationID').val();
            var infoDiv = $('#locationInfo');

            if (locationId && locationsData[locationId]) {
                var location = locationsData[locationId];
                infoDiv.html(`
                    <h5>${location.name}</h5>
                    <p><strong>Order Index:</strong> ${location.orderIndex}</p>
                    <p><strong>ID:</strong> ${locationId}</p>
                `);
            } else {
                infoDiv.html('<p class="text-warning">Please select a valid location</p>');
            }
        }

        // Display current values
        function displayCurrentValues() {
            var currentDivisionId = @Model.DivisionMasterID;
            var currentOrderTypeId = @Model.OrderTypeID;
            var currentLocationId = @Model.LocationID;

            if (divisionMastersData[currentDivisionId]) {
                $('#currentDivision').text(divisionMastersData[currentDivisionId].name + " (ID: " + currentDivisionId + ")");
            }
            if (orderTypesData[currentOrderTypeId]) {
                $('#currentOrderType').text(orderTypesData[currentOrderTypeId].name + " (ID: " + currentOrderTypeId + ")");
            }
            if (locationsData[currentLocationId]) {
                $('#currentLocation').text(locationsData[currentLocationId].name + " (ID: " + currentLocationId + ")");
            }
        }

        // Auto-update info panels when selection changes
        $(document).ready(function () {
            $('#DivisionMasterID').change(showDivisionDetails);
            $('#OrderTypeID').change(showOrderTypeDetails);
            $('#LocationID').change(showLocationDetails);

            // Show current values and details on page load
            displayCurrentValues();
            showDivisionDetails();
            showOrderTypeDetails();
            showLocationDetails();
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 30px;
        background: white;
    }

    .panel-heading {
        color: white;
        border-radius: 15px 15px 0 0;
        padding: 20px 25px;
    }

    .panel-warning .panel-heading {
        background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
    }

    .panel-info .panel-heading {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%);
    }

    .panel-primary .panel-heading {
        background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
    }

    .panel-success .panel-heading {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
    }

    .panel-body {
        padding: 25px;
    }

    .current-values {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid #3498db;
    }

        .current-values h5 {
            color: #2c3e50;
            margin-bottom: 15px;
        }

    .form-container {
        max-width: 100%;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .control-label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #2c3e50;
    }

    .form-control {
        border-radius: 8px;
        border: 2px solid #e9ecef;
        padding: 12px 15px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .input-group-append .btn {
        border: 2px solid #e9ecef;
        border-left: none;
        border-radius: 0 8px 8px 0;
    }

    .form-actions {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e9ecef;
        text-align: center;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
        margin: 0 5px;
    }

    .info-placeholder {
        min-height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

        .info-placeholder h5 {
            color: #2c3e50;
            margin-bottom: 10px;
        }

    .text-danger {
        font-size: 12px;
        margin-top: 5px;
    }

    .alert-danger {
        border-radius: 8px;
        border: none;
        background: #e74c3c;
        color: white;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 15px;
            padding-left: 15px;
        }

    @@media (max-width: 768px) {
        .form-actions .btn {
            display: block;
            width: 100%;
            margin: 10px 0;
        }

        .current-values .row > div {
            margin-bottom: 10px;
        }
    }
</style>