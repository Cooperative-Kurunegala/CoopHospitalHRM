@model HR_Application_CO_OP_HOS.Models.DivisionMasterOrderTypeMapping

@{
    ViewBag.Title = "Delete Mapping";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Mapping</h1>
            <p class="lead">Remove division master order type mapping from system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-warning">
                        <h4><i class="fa fa-warning"></i> Warning!</h4>
                        <p>You are about to permanently delete this mapping. This action cannot be undone.</p>
                    </div>

                    <div class="deletion-details">
                        <h4>Mapping Details to be Deleted:</h4>

                        <div class="detail-card">
                            <div class="detail-header">
                                <h5>Basic Information</h5>
                            </div>
                            <div class="detail-content">
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Mapping ID:</strong> @Model.ID
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Order Sequence:</strong> @Model.OrderSequence
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-header">
                                <h5>Division Master</h5>
                            </div>
                            <div class="detail-content">
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Division Master ID:</strong> @Model.DivisionMasterID
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Division Name:</strong> <span id="deleteDivisionName">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-header">
                                <h5>Order Type</h5>
                            </div>
                            <div class="detail-content">
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Order Type ID:</strong> @Model.OrderTypeID
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Order Type Name:</strong> <span id="deleteOrderTypeName">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-header">
                                <h5>Location</h5>
                            </div>
                            <div class="detail-content">
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Location ID:</strong> @Model.LocationID
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Location Name:</strong> <span id="deleteLocationName">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="deletion-actions">
                            <div class="confirmation-check">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                    <label class="form-check-label" for="confirmDelete">
                                        I understand that this action cannot be undone and I confirm that I want to delete this mapping.
                                    </label>
                                </div>
                            </div>

                            <div class="action-buttons">
                                <button type="submit" class="btn btn-danger btn-lg" id="deleteButton" disabled>
                                    <i class="fa fa-trash"></i> Confirm Delete
                                </button>
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Impact Analysis Panel -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Impact Analysis</h3>
                </div>
                <div class="panel-body">
                    <div class="impact-analysis">
                        <h5>Potential Impacts:</h5>
                        <ul class="impact-list">
                            <li><i class="fa fa-exclamation-circle text-warning"></i> Order processing sequences may be affected</li>
                            <li><i class="fa fa-exclamation-circle text-warning"></i> Division-order type relationships will be removed</li>
                            <li><i class="fa fa-exclamation-circle text-warning"></i> Location-specific mappings will be lost</li>
                            <li><i class="fa fa-exclamation-circle text-warning"></i> System may require reconfiguration</li>
                        </ul>

                        <div class="recommendation">
                            <h6><i class="fa fa-lightbulb-o text-info"></i> Recommendation:</h6>
                            <p>Consider deactivating instead of deleting if this mapping might be needed in the future.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Safe Alternatives Panel -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-shield"></i> Safe Alternatives</h3>
                </div>
                <div class="panel-body">
                    <div class="safe-alternatives">
                        <div class="alternative-option">
                            <h6>Edit Instead</h6>
                            <p>Modify the mapping instead of deleting it.</p>
                            @Html.ActionLink("Edit Mapping", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-warning btn-sm btn-block" })
                        </div>

                        <div class="alternative-option">
                            <h6>View Details</h6>
                            <p>Review full details before proceeding.</p>
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-outline-info btn-sm btn-block" })
                        </div>

                        <div class="alternative-option">
                            <h6>Back to List</h6>
                            <p>Return to mappings list without changes.</p>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary btn-sm btn-block" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sample data - in real scenario, this would come from the database
        var divisionMastersData = {
            @if (ViewBag.DivisionMastersDictionary != null)
            {
                foreach (var item in ViewBag.DivisionMastersDictionary)
                {
                    <text>@item.Key: { name: "@item.Value" },</text>
                }
            }
        };

        var orderTypesData = {
            @if (ViewBag.OrderTypesDictionary != null)
            {
                foreach (var item in ViewBag.OrderTypesDictionary)
                {
                    <text>@item.Key: { name: "@item.Value" },</text>
                }
            }
        };

        var locationsData = {
            @if (ViewBag.LocationsDictionary != null)
            {
                foreach (var item in ViewBag.LocationsDictionary)
                {
                    <text>@item.Key: { name: "@item.Value" },</text>
                }
            }
        };

        function loadDeleteDetails() {
            var divisionId = @Model.DivisionMasterID;
            var orderTypeId = @Model.OrderTypeID;
            var locationId = @Model.LocationID;

            if (divisionMastersData[divisionId]) {
                $('#deleteDivisionName').text(divisionMastersData[divisionId].name);
            } else {
                $('#deleteDivisionName').text('Not Found');
            }

            if (orderTypesData[orderTypeId]) {
                $('#deleteOrderTypeName').text(orderTypesData[orderTypeId].name);
            } else {
                $('#deleteOrderTypeName').text('Not Found');
            }

            if (locationsData[locationId]) {
                $('#deleteLocationName').text(locationsData[locationId].name);
            } else {
                $('#deleteLocationName').text('Not Found');
            }
        }

        $(document).ready(function () {
            loadDeleteDetails();

            // Enable/disable delete button based on confirmation
            $('#confirmDelete').change(function () {
                $('#deleteButton').prop('disabled', !this.checked);
            });

            // Double confirmation for delete
            $('#deleteButton').click(function (e) {
                if (!confirm('Are you absolutely sure you want to delete this mapping? This action is permanent and cannot be undone.')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 30px;
        background: white;
    }

    .panel-heading {
        color: white;
        border-radius: 15px 15px 0 0;
        padding: 20px 25px;
    }

    .panel-danger .panel-heading {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
    }

    .panel-warning .panel-heading {
        background: linear-gradient(135deg, #f39c12 0%, #d35400 100%);
    }

    .panel-info .panel-heading {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%);
    }

    .panel-body {
        padding: 25px;
    }

    .alert-warning {
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
        border: none;
        border-radius: 10px;
        color: #856404;
        border-left: 4px solid #ffc107;
    }

        .alert-warning h4 {
            color: #856404;
            margin-bottom: 10px;
        }

            .alert-warning h4 i {
                margin-right: 10px;
            }

    .deletion-details {
        margin: 30px 0;
    }

        .deletion-details h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

    .detail-card {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        margin-bottom: 15px;
        overflow: hidden;
    }

    .detail-header {
        background: #f8f9fa;
        padding: 15px 20px;
        border-bottom: 1px solid #e9ecef;
    }

        .detail-header h5 {
            margin: 0;
            color: #2c3e50;
            font-weight: 600;
        }

    .detail-content {
        padding: 20px;
    }

        .detail-content .row {
            margin-bottom: 10px;
        }

            .detail-content .row:last-child {
                margin-bottom: 0;
            }

    .deletion-actions {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e9ecef;
    }

    .confirmation-check {
        margin-bottom: 25px;
    }

    .form-check {
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #e74c3c;
    }

    .form-check-input {
        margin-top: 0.3rem;
        margin-right: 10px;
    }

    .form-check-label {
        font-weight: 500;
        color: #2c3e50;
    }

    .action-buttons {
        text-align: center;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
        margin: 0 10px;
    }

    .impact-analysis h5 {
        color: #2c3e50;
        margin-bottom: 15px;
        font-weight: 600;
    }

    .impact-list {
        list-style: none;
        padding: 0;
        margin-bottom: 20px;
    }

        .impact-list li {
            padding: 8px 0;
            border-bottom: 1px solid #f1f1f1;
        }

            .impact-list li:last-child {
                border-bottom: none;
            }

        .impact-list i {
            margin-right: 10px;
        }

    .recommendation {
        background: #e8f4fd;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #3498db;
    }

        .recommendation h6 {
            color: #2980b9;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .recommendation p {
            margin: 0;
            color: #2c3e50;
            font-size: 14px;
        }

    .safe-alternatives {
        font-size: 14px;
    }

    .alternative-option {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e9ecef;
    }

        .alternative-option:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

        .alternative-option h6 {
            color: #2c3e50;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .alternative-option p {
            color: #7f8c8d;
            margin-bottom: 10px;
        }

    .btn-block {
        border-radius: 6px;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 15px;
            padding-left: 15px;
        }

    @@media (max-width: 768px) {
        .action-buttons .btn {
            display: block;
            width: 100%;
            margin: 10px 0;
        }

        .detail-content .row > div {
            margin-bottom: 10px;
        }

        .form-check-label {
            font-size: 14px;
        }
    }
</style>