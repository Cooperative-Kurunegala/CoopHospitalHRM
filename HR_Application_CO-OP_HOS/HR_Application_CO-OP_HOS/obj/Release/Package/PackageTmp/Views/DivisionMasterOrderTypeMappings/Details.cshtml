@model HR_Application_CO_OP_HOS.Models.DivisionMasterOrderTypeMapping

@{
    ViewBag.Title = "Mapping Details";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-eye"></i> Mapping Details</h1>
            <p class="lead">View division master order type mapping information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Mapping Information</h3>
                </div>
                <div class="panel-body">
                    <div class="details-container">
                        <div class="detail-section">
                            <h4><i class="fa fa-link"></i> Basic Information</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <label>Mapping ID:</label>
                                        <span>@Model.ID</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <label>Order Sequence:</label>
                                        <span>@Model.OrderSequence</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="detail-section">
                            <h4><i class="fa fa-building"></i> Division Master</h4>
                            <div class="detail-item">
                                <label>Division Master ID:</label>
                                <span>@Model.DivisionMasterID</span>
                            </div>
                            <div class="detail-item">
                                <label>Division Name:</label>
                                <span id="divisionName">Loading...</span>
                            </div>
                            <div class="detail-item">
                                <label>Division Code:</label>
                                <span id="divisionCode">Loading...</span>
                            </div>
                        </div>

                        <div class="detail-section">
                            <h4><i class="fa fa-list-alt"></i> Order Type</h4>
                            <div class="detail-item">
                                <label>Order Type ID:</label>
                                <span>@Model.OrderTypeID</span>
                            </div>
                            <div class="detail-item">
                                <label>Order Type Name:</label>
                                <span id="orderTypeName">Loading...</span>
                            </div>
                            <div class="detail-item">
                                <label>Order Type Code:</label>
                                <span id="orderTypeCode">Loading...</span>
                            </div>
                        </div>

                        <div class="detail-section">
                            <h4><i class="fa fa-map-marker"></i> Location</h4>
                            <div class="detail-item">
                                <label>Location ID:</label>
                                <span>@Model.LocationID</span>
                            </div>
                            <div class="detail-item">
                                <label>Location Name:</label>
                                <span id="locationName">Loading...</span>
                            </div>
                            <div class="detail-item">
                                <label>Location Order Index:</label>
                                <span id="locationOrderIndex">Loading...</span>
                            </div>
                        </div>

                        <div class="action-buttons">
                            @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-lg" })
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Quick Actions Panel -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="quick-actions">
                        <a href="@Url.Action("Create")" class="btn btn-success btn-block mb-3">
                            <i class="fa fa-plus"></i> Create New Mapping
                        </a>
                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning btn-block mb-3">
                            <i class="fa fa-edit"></i> Edit This Mapping
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-info btn-block mb-3">
                            <i class="fa fa-list"></i> View All Mappings
                        </a>
                    </div>
                </div>
            </div>

            <!-- Related Information Panel -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-sitemap"></i> Related Information</h3>
                </div>
                <div class="panel-body">
                    <div class="related-info">
                        <div class="related-item">
                            <h6>Division Master Details</h6>
                            <p id="divisionDetails">Loading division information...</p>
                        </div>
                        <div class="related-item">
                            <h6>Order Type Details</h6>
                            <p id="orderTypeDetails">Loading order type information...</p>
                        </div>
                        <div class="related-item">
                            <h6>Location Details</h6>
                            <p id="locationDetails">Loading location information...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sample data - in real scenario, this would come from the database
        var divisionMastersData = {
            @if (ViewBag.DivisionMastersDictionary != null)
            {
                foreach (var item in ViewBag.DivisionMastersDictionary)
                {
                    <text>@item.Key: { name: "@item.Value", code: "DM@(item.Key)", description: "Division Master @item.Key - @item.Value provides specialized services and management for this division." },</text>
                }
            }
        };

        var orderTypesData = {
            @if (ViewBag.OrderTypesDictionary != null)
            {
                foreach (var item in ViewBag.OrderTypesDictionary)
                {
                    <text>@item.Key: { name: "@item.Value", code: "OT@(item.Key)", description: "Order Type @item.Key - @item.Value defines the workflow and processing rules for this type of order." },</text>
                }
            }
        };

        var locationsData = {
            @if (ViewBag.LocationsDictionary != null)
            {
                foreach (var item in ViewBag.LocationsDictionary)
                {
                    <text>@item.Key: { name: "@item.Value", orderIndex: "@(item.Key * 5)", description: "Location @item.Key - @item.Value serves as a physical or logical location within the organization." },</text>
                }
            }
        };

        function loadDetails() {
            var divisionId = @Model.DivisionMasterID;
            var orderTypeId = @Model.OrderTypeID;
            var locationId = @Model.LocationID;

            // Load Division Master Details
            if (divisionMastersData[divisionId]) {
                $('#divisionName').text(divisionMastersData[divisionId].name);
                $('#divisionCode').text(divisionMastersData[divisionId].code);
                $('#divisionDetails').text(divisionMastersData[divisionId].description);
            } else {
                $('#divisionName').text('Not Found');
                $('#divisionCode').text('N/A');
                $('#divisionDetails').text('Division master information not available.');
            }

            // Load Order Type Details
            if (orderTypesData[orderTypeId]) {
                $('#orderTypeName').text(orderTypesData[orderTypeId].name);
                $('#orderTypeCode').text(orderTypesData[orderTypeId].code);
                $('#orderTypeDetails').text(orderTypesData[orderTypeId].description);
            } else {
                $('#orderTypeName').text('Not Found');
                $('#orderTypeCode').text('N/A');
                $('#orderTypeDetails').text('Order type information not available.');
            }

            // Load Location Details
            if (locationsData[locationId]) {
                $('#locationName').text(locationsData[locationId].name);
                $('#locationOrderIndex').text(locationsData[locationId].orderIndex);
                $('#locationDetails').text(locationsData[locationId].description);
            } else {
                $('#locationName').text('Not Found');
                $('#locationOrderIndex').text('N/A');
                $('#locationDetails').text('Location information not available.');
            }
        }

        $(document).ready(function () {
            loadDetails();
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 30px;
        background: white;
    }

    .panel-heading {
        color: white;
        border-radius: 15px 15px 0 0;
        padding: 20px 25px;
    }

    .panel-info .panel-heading {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%);
    }

    .panel-success .panel-heading {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
    }

    .panel-primary .panel-heading {
        background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
    }

    .panel-body {
        padding: 25px;
    }

    .details-container {
        max-width: 100%;
    }

    .detail-section {
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e9ecef;
    }

        .detail-section:last-child {
            border-bottom: none;
        }

        .detail-section h4 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

            .detail-section h4 i {
                margin-right: 10px;
                color: #3498db;
            }

    .detail-item {
        margin-bottom: 15px;
        display: flex;
        flex-wrap: wrap;
    }

        .detail-item label {
            font-weight: 600;
            color: #7f8c8d;
            min-width: 180px;
            margin-bottom: 5px;
        }

        .detail-item span {
            color: #2c3e50;
            font-weight: 500;
            flex: 1;
        }

    .action-buttons {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e9ecef;
        text-align: center;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
        margin: 0 10px;
    }

    .quick-actions .btn {
        margin-bottom: 15px;
        padding: 15px;
        font-size: 14px;
        border-radius: 8px;
        text-align: left;
    }

        .quick-actions .btn i {
            margin-right: 10px;
            width: 20px;
        }

    .related-info {
        font-size: 14px;
    }

    .related-item {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e9ecef;
    }

        .related-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

        .related-item h6 {
            color: #2c3e50;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .related-item p {
            color: #7f8c8d;
            margin: 0;
            line-height: 1.5;
        }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 15px;
            padding-left: 15px;
        }

    @@media (max-width: 768px) {
        .detail-item {
            flex-direction: column;
        }

            .detail-item label {
                min-width: auto;
                margin-bottom: 5px;
            }

        .action-buttons .btn {
            display: block;
            width: 100%;
            margin: 10px 0;
        }

        .quick-actions .btn {
            text-align: center;
        }
    }
</style>