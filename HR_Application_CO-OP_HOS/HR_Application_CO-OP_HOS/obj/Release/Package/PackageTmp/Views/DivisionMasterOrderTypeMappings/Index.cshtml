@model IEnumerable<HR_Application_CO_OP_HOS.Models.DivisionMasterOrderTypeMapping>

@{
    ViewBag.Title = "Division Master Order Type Mappings";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-link"></i> Division Master Order Type Mappings</h1>
            <p class="lead">Manage mappings between divisions, order types, and locations</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-list"></i> All Mappings
                        <div class="header-actions">
                            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-sm" })
                        </div>
                    </h3>
                </div>
                <div class="panel-body">
                    <!-- Filters Section -->
                    <div class="filters-section mb-4">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Division Master</label>
                                    @Html.DropDownList("DivisionMasterFilter", (SelectList)ViewBag.DivisionMasters, "All Divisions", new { @class = "form-control filter-select" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Order Type</label>
                                    @Html.DropDownList("OrderTypeFilter", (SelectList)ViewBag.OrderTypes, "All Order Types", new { @class = "form-control filter-select" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Location</label>
                                    @Html.DropDownList("LocationFilter", (SelectList)ViewBag.Locations, "All Locations", new { @class = "form-control filter-select" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Search</label>
                                    <input type="text" id="searchInput" class="form-control" placeholder="Search mappings..." />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-right">
                                <button id="clearFilters" class="btn btn-outline-secondary">Clear Filters</button>
                            </div>
                        </div>
                    </div>

                    <!-- Data Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="mappingsTable">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Division Master</th>
                                    <th>Order Type</th>
                                    <th>Location</th>
                                    <th>Order Sequence</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr data-division="@item.DivisionMasterID" data-ordertype="@item.OrderTypeID" data-location="@item.LocationID">
                                            <td>
                                                <div class="data-with-tooltip">
                                                    <span>@(ViewBag.DivisionMastersDictionary != null && ViewBag.DivisionMastersDictionary.ContainsKey(item.DivisionMasterID) ? ViewBag.DivisionMastersDictionary[item.DivisionMasterID] : $"Division #{item.DivisionMasterID}")</span>
                                                    <div class="tooltip-content">
                                                        Division Master ID: @item.DivisionMasterID
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="data-with-tooltip">
                                                    <span>@(ViewBag.OrderTypesDictionary != null && ViewBag.OrderTypesDictionary.ContainsKey(item.OrderTypeID) ? ViewBag.OrderTypesDictionary[item.OrderTypeID] : $"Order Type #{item.OrderTypeID}")</span>
                                                    <div class="tooltip-content">
                                                        Order Type ID: @item.OrderTypeID
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="data-with-tooltip">
                                                    <span>@(ViewBag.LocationsDictionary != null && ViewBag.LocationsDictionary.ContainsKey(item.LocationID) ? ViewBag.LocationsDictionary[item.LocationID] : $"Location #{item.LocationID}")</span>
                                                    <div class="tooltip-content">
                                                        Location ID: @item.LocationID
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.OrderSequence</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">
                                            <i class="fa fa-info-circle"></i> No mapping records found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Summary Section -->
                    <div class="summary-section mt-4">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="summary-card">
                                    <h5>Total Mappings</h5>
                                    <p class="summary-number">@(Model?.Count() ?? 0)</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="summary-card">
                                    <h5>Unique Divisions</h5>
                                    <p class="summary-number">@(Model?.Select(m => m.DivisionMasterID).Distinct().Count() ?? 0)</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="summary-card">
                                    <h5>Active Locations</h5>
                                    <p class="summary-number">@(Model?.Select(m => m.LocationID).Distinct().Count() ?? 0)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Filter functionality
            $('.filter-select, #searchInput').on('change keyup', function () {
                filterTable();
            });

            $('#clearFilters').on('click', function () {
                $('.filter-select').val('');
                $('#searchInput').val('');
                filterTable();
            });

            function filterTable() {
                var divisionFilter = $('#DivisionMasterFilter').val();
                var orderTypeFilter = $('#OrderTypeFilter').val();
                var locationFilter = $('#LocationFilter').val();
                var searchText = $('#searchInput').val().toLowerCase();

                $('#mappingsTable tbody tr').each(function () {
                    var division = $(this).data('division');
                    var orderType = $(this).data('ordertype');
                    var location = $(this).data('location');
                    var rowText = $(this).text().toLowerCase();

                    var divisionMatch = !divisionFilter || division == divisionFilter;
                    var orderTypeMatch = !orderTypeFilter || orderType == orderTypeFilter;
                    var locationMatch = !locationFilter || location == locationFilter;
                    var searchMatch = !searchText || rowText.indexOf(searchText) > -1;

                    $(this).toggle(divisionMatch && orderTypeMatch && locationMatch && searchMatch);
                });
            }

            // Initialize tooltips
            $('.data-with-tooltip').hover(function () {
                $(this).find('.tooltip-content').fadeIn(200);
            }, function () {
                $(this).find('.tooltip-content').fadeOut(200);
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 30px;
        background: white;
    }

    .panel-heading {
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%) !important;
        color: white;
        border-radius: 15px 15px 0 0;
        padding: 20px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-actions {
        display: flex;
        gap: 10px;
    }

    .filters-section {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }

    .table th {
        background: #2c3e50;
        color: white;
        border: none;
        padding: 15px;
        font-weight: 600;
    }

    .table td {
        padding: 12px 15px;
        vertical-align: middle;
        border-color: #e9ecef;
    }

    .btn-group .btn {
        margin: 2px;
        border-radius: 5px;
    }

    .data-with-tooltip {
        position: relative;
        display: inline-block;
        cursor: help;
    }

    .tooltip-content {
        display: none;
        position: absolute;
        background: #2c3e50;
        color: white;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 12px;
        white-space: nowrap;
        z-index: 1000;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-bottom: 5px;
    }

        .tooltip-content:after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #2c3e50 transparent transparent transparent;
        }

    .summary-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        border-radius: 10px;
    }

    .summary-card {
        text-align: center;
        padding: 15px;
    }

        .summary-card h5 {
            font-size: 14px;
            margin-bottom: 10px;
            opacity: 0.9;
        }

    .summary-number {
        font-size: 2rem;
        font-weight: bold;
        margin: 0;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 10px 15px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 15px;
            padding-left: 15px;
        }
</style>