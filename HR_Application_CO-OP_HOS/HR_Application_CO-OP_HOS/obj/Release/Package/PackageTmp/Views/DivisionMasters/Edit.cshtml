@model HR_Application_CO_OP_HOS.Models.DivisionMaster

@{
    ViewBag.Title = "Edit Division Master";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Division Master</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 0;
            margin: 0;
        }

        body {
            padding: 0 !important;
            margin: 0 !important;
            overflow-x: hidden;
        }

        .dashboard-header .jumbotron {
            background: linear-gradient(135deg, #2c3e50 0%, #f39c12 100%);
            color: white;
            border-radius: 0;
            padding: 40px 20px;
            margin: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .panel {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin: 20px 0;
            background: white;
        }

        .panel-heading {
            border-radius: 10px 10px 0 0 !important;
            border: none;
            padding: 20px;
            font-weight: 600;
        }

        .panel-body {
            padding: 25px;
        }

        .current-info dl {
            margin-bottom: 0;
        }

        .current-info dt {
            font-weight: 600;
            color: #6c757d;
        }

        .current-info dd {
            color: #495057;
        }

        .form-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .checkbox-group {
            background: #e9ecef;
            padding: 15px;
            border-radius: 5px;
        }

        @@media (max-width: 768px) {
            .dashboard-header .jumbotron {
                padding: 30px 15px;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-header">
            <div class="jumbotron">
                <h1><i class="fa fa-edit"></i> Edit Division Master</h1>
                <p class="lead">Update division master information</p>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8">
                    <div class="panel panel-warning">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-sitemap"></i> Edit Division Master Details</h3>
                        </div>
                        <div class="panel-body">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ID)

                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                    <!-- Basic Information Section -->
                                    <div class="form-section">
                                        <h5><i class="fa fa-info-circle"></i> Basic Information</h5>
                                        <div class="form-group row">
                                            @Html.LabelFor(model => model.DivisionMasterName, htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.EditorFor(model => model.DivisionMasterName, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter division name" } })
                                                @Html.ValidationMessageFor(model => model.DivisionMasterName, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            @Html.LabelFor(model => model.DivisionMasterCode, htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.EditorFor(model => model.DivisionMasterCode, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter division code" } })
                                                @Html.ValidationMessageFor(model => model.DivisionMasterCode, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            @Html.LabelFor(model => model.DivisionMasterDescription, htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.TextAreaFor(model => model.DivisionMasterDescription, new { @class = "form-control form-control-lg", rows = "3", placeholder = "Enter division description" })
                                                @Html.ValidationMessageFor(model => model.DivisionMasterDescription, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Configuration Section -->
                                    <div class="form-section">
                                        <h5><i class="fa fa-cogs"></i> Configuration</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.MenuTypeID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.MenuTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Menu Type ID" } })
                                                    @Html.ValidationMessageFor(model => model.MenuTypeID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.MenuTypeDetailID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.MenuTypeDetailID, new { htmlAttributes = new { @class = "form-control", placeholder = "Menu Type Detail ID" } })
                                                    @Html.ValidationMessageFor(model => model.MenuTypeDetailID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.DivisionMasterTypeID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.DivisionMasterTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Division Type ID" } })
                                                    @Html.ValidationMessageFor(model => model.DivisionMasterTypeID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.ParentDivisionMasterID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.ParentDivisionMasterID, new { htmlAttributes = new { @class = "form-control", placeholder = "Parent Division ID" } })
                                                    @Html.ValidationMessageFor(model => model.ParentDivisionMasterID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Settings Section -->
                                    <div class="form-section">
                                        <h5><i class="fa fa-sliders"></i> Settings</h5>
                                        <div class="checkbox-group">
                                            <div class="form-check form-switch">
                                                @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { @class = "form-check-input" } })
                                                @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                            </div>

                                            <div class="form-check form-switch">
                                                @Html.EditorFor(model => model.IsStockManaged, new { htmlAttributes = new { @class = "form-check-input" } })
                                                @Html.LabelFor(model => model.IsStockManaged, htmlAttributes: new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsStockManaged, "", new { @class = "text-danger" })
                                            </div>

                                            <div class="form-check form-switch">
                                                @Html.EditorFor(model => model.IsReserved, new { htmlAttributes = new { @class = "form-check-input" } })
                                                @Html.LabelFor(model => model.IsReserved, htmlAttributes: new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsReserved, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Additional Information -->
                                    <div class="form-section">
                                        <h5><i class="fa fa-info"></i> Additional Information</h5>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.LocationID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.LocationID, new { htmlAttributes = new { @class = "form-control", placeholder = "Location ID" } })
                                                    @Html.ValidationMessageFor(model => model.LocationID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.OrderTypeID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.OrderTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Order Type ID" } })
                                                    @Html.ValidationMessageFor(model => model.OrderTypeID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.OrderSequence, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.OrderSequence, new { htmlAttributes = new { @class = "form-control", placeholder = "Order Sequence" } })
                                                    @Html.ValidationMessageFor(model => model.OrderSequence, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AccoutClassID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.AccoutClassID, new { htmlAttributes = new { @class = "form-control", placeholder = "Account Class ID" } })
                                                    @Html.ValidationMessageFor(model => model.AccoutClassID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AccoutClassCode, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.AccoutClassCode, new { htmlAttributes = new { @class = "form-control", placeholder = "Account Class Code" } })
                                                    @Html.ValidationMessageFor(model => model.AccoutClassCode, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group row mt-4">
                                        <div class="col-md-12 text-end">
                                            <button type="submit" class="btn btn-warning btn-lg">
                                                <i class="fa fa-save"></i> Update Division Master
                                            </button>
                                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Current Information Panel -->
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-info-circle"></i> Current Information</h3>
                        </div>
                        <div class="panel-body">
                            <div class="current-info">
                                <h5><i class="fa fa-sitemap text-primary"></i> Current Details</h5>
                                <dl class="row">
                                    <dt class="col-sm-5">Division ID:</dt>
                                    <dd class="col-sm-7">@Model.ID</dd>

                                    <dt class="col-sm-5">Current Name:</dt>
                                    <dd class="col-sm-7" id="currentDivisionName">@Model.DivisionMasterName</dd>

                                    <dt class="col-sm-5">Current Code:</dt>
                                    <dd class="col-sm-7" id="currentDivisionCode">@Model.DivisionMasterCode</dd>

                                    <dt class="col-sm-5">Status:</dt>
                                    <dd class="col-sm-7">
                                        @if (Model.IsActive == true)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-5">Stock Managed:</dt>
                                    <dd class="col-sm-7">
                                        @if (Model.IsStockManaged == true)
                                        {
                                            <span class="badge bg-info">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </dd>
                                </dl>
                            </div>

                            <div class="impact-analysis mt-4">
                                <h5><i class="fa fa-exclamation-triangle text-warning"></i> Impact Analysis</h5>
                                <div class="alert alert-warning">
                                    <strong>Note:</strong> Changing division properties will affect:
                                    <ul class="mt-2 mb-0">
                                        <li>All related employee records</li>
                                        <li>Division hierarchy structure</li>
                                        <li>Stock management operations</li>
                                        <li>Reporting and analytics</li>
                                    </ul>
                                </div>
                            </div>

                            <div class="change-history mt-4">
                                <h5><i class="fa fa-history text-info"></i> Quick Actions</h5>
                                <div class="btn-group-vertical w-100">
                                    @Html.ActionLink("View Related Employees", "Index", "RelatedParties", new { divisionId = Model.ID }, new { @class = "btn btn-outline-primary btn-sm mb-2" })
                                    @Html.ActionLink("View Division Charges", "Index", "DivisionCharges", new { divisionId = Model.ID }, new { @class = "btn btn-outline-info btn-sm mb-2" })
                                    @Html.ActionLink("View Child Divisions", "Index", "DivisionMasters", new { parentId = Model.ID }, new { @class = "btn btn-outline-success btn-sm" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const originalName = '@Model.DivisionMasterName';
            const originalCode = '@Model.DivisionMasterCode';

            // Real-time comparison
            const divisionNameInput = document.getElementById('DivisionMasterName');
            const divisionCodeInput = document.getElementById('DivisionMasterCode');

            function updateComparison() {
                const newName = divisionNameInput.value;
                const newCode = divisionCodeInput.value;
                const currentNameElement = document.getElementById('currentDivisionName');
                const currentCodeElement = document.getElementById('currentDivisionCode');

                if (newName !== originalName) {
                    currentNameElement.innerHTML = `<span class="text-warning">${originalName}</span>`;
                } else {
                    currentNameElement.textContent = originalName;
                }

                if (newCode !== originalCode) {
                    currentCodeElement.innerHTML = `<span class="text-warning">${originalCode}</span>`;
                } else {
                    currentCodeElement.textContent = originalCode;
                }
            }

            divisionNameInput.addEventListener('input', updateComparison);
            divisionCodeInput.addEventListener('input', updateComparison);

            // Form submission enhancement
            const form = document.querySelector('form');
            form.addEventListener('submit', function(e) {
                const newName = divisionNameInput.value.trim();
                if (newName === '') {
                    e.preventDefault();
                    showError('Division name cannot be empty');
                    return false;
                }

                if (newName === originalName && divisionCodeInput.value === originalCode) {
                    if (!confirm('No changes detected. Are you sure you want to continue?')) {
                        e.preventDefault();
                        return false;
                    }
                }

                showLoading('Updating division master...');
            });

            function showError(message) {
                const alertHtml = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa fa-exclamation-triangle"></i> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
                form.insertAdjacentHTML('afterbegin', alertHtml);
            }

            function showLoading(message) {
                // Implement loading indicator
                console.log(message);
            }
        });
    </script>
</body>
</html>