@model HR_Application_CO_OP_HOS.Models.DivisionMaster

@{
    ViewBag.Title = "Delete Division Master";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Division Master</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 0;
            margin: 0;
        }

        body {
            padding: 0 !important;
            margin: 0 !important;
            overflow-x: hidden;
        }

        .dashboard-header .jumbotron {
            background: linear-gradient(135deg, #2c3e50 0%, #e74c3c 100%);
            color: white;
            border-radius: 0;
            padding: 40px 20px;
            margin: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .panel {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin: 20px 0;
            background: white;
        }

        .panel-heading {
            border-radius: 10px 10px 0 0 !important;
            border: none;
            padding: 20px;
            font-weight: 600;
        }

        .panel-body {
            padding: 25px;
        }

        .division-details dl {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #e74c3c;
        }

        .division-details dt {
            font-weight: 600;
            color: #6c757d;
        }

        .division-details dd {
            color: #495057;
            font-weight: 500;
        }

        .impact-list .list-group-item {
            border: none;
            border-left: 3px solid #e74c3c;
            margin-bottom: 5px;
            font-weight: 500;
        }

        .btn-group-vertical .btn {
            text-align: left;
            padding: 10px 15px;
        }

        #deleteButton {
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .dashboard-header .jumbotron {
                padding: 30px 15px;
            }

            .division-details .row {
                margin-bottom: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-header">
            <div class="jumbotron">
                <h1><i class="fa fa-trash"></i> Delete Division Master</h1>
                <p class="lead">Remove division master from the system</p>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8">
                    <div class="panel panel-danger">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                        </div>
                        <div class="panel-body">
                            <div class="alert alert-danger">
                                <h4><i class="fa fa-warning"></i> Warning!</h4>
                                <p>You are about to permanently delete this division master. This action cannot be undone.</p>
                            </div>

                            <div class="division-details">
                                <h5>Division to be deleted:</h5>
                                <dl class="row">
                                    <dt class="col-sm-4">Division ID:</dt>
                                    <dd class="col-sm-8">@Model.ID</dd>

                                    <dt class="col-sm-4">Division Name:</dt>
                                    <dd class="col-sm-8">@Model.DivisionMasterName</dd>

                                    <dt class="col-sm-4">Division Code:</dt>
                                    <dd class="col-sm-8">@Model.DivisionMasterCode</dd>

                                    <dt class="col-sm-4">Status:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.IsActive == true)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Description:</dt>
                                    <dd class="col-sm-8">
                                        @if (!string.IsNullOrEmpty(Model.DivisionMasterDescription))
                                        {
                                            @Model.DivisionMasterDescription
                                        }
                                        else
                                        {
                                            <span class="text-muted">No description</span>
                                        }
                                    </dd>
                                </dl>
                            </div>

                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-actions no-color mt-4">
                                    <button type="submit" class="btn btn-danger btn-lg" id="deleteButton">
                                        <i class="fa fa-trash"></i> Confirm Delete
                                    </button>
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Impact Analysis Panel -->
                    <div class="panel panel-warning">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-chain-broken"></i> Impact Analysis</h3>
                        </div>
                        <div class="panel-body">
                            <div class="impact-list">
                                <h5><i class="fa fa-exclamation-circle text-danger"></i> This will affect:</h5>
                                <ul class="list-group">
                                    <li class="list-group-item list-group-item-danger">
                                        <i class="fa fa-users"></i> All related employee records
                                    </li>
                                    <li class="list-group-item list-group-item-danger">
                                        <i class="fa fa-cubes"></i> Division charges and items
                                    </li>
                                    <li class="list-group-item list-group-item-danger">
                                        <i class="fa fa-sitemap"></i> Child division hierarchy
                                    </li>
                                    <li class="list-group-item list-group-item-danger">
                                        <i class="fa fa-file-text"></i> All associated reports
                                    </li>
                                    <li class="list-group-item list-group-item-danger">
                                        <i class="fa fa-bar-chart"></i> Analytics and statistics
                                    </li>
                                    <li class="list-group-item list-group-item-danger">
                                        <i class="fa fa-database"></i> Stock management data
                                    </li>
                                </ul>
                            </div>

                            <div class="recommendation mt-4">
                                <div class="alert alert-info">
                                    <h6><i class="fa fa-lightbulb-o"></i> Recommendation</h6>
                                    <p class="mb-0">Consider deactivating instead of deleting to preserve historical data and relationships.</p>
                                </div>
                            </div>

                            <div class="alternative-actions mt-4">
                                <h5><i class="fa fa-random"></i> Alternative Actions</h5>
                                <div class="btn-group-vertical w-100">
                                    @Html.ActionLink("Edit Instead", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-warning btn-sm mb-2" })
                                    @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-outline-info btn-sm mb-2" })
                                    @Html.ActionLink("Deactivate Only", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-secondary btn-sm mb-2" })
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-primary btn-sm" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let confirmed = false;
            const deleteButton = document.getElementById('deleteButton');

            deleteButton.addEventListener('click', function(e) {
                if (!confirmed) {
                    e.preventDefault();

                    // Show confirmation dialog with more details
                    const divisionName = '@Model.DivisionMasterName';
                    const confirmationMessage =
                        'You are about to PERMANENTLY DELETE the division:\n\n' +
                        'Division: ' + divisionName + '\n' +
                        'ID: @Model.ID\n' +
                        'Code: @Model.DivisionMasterCode\n\n' +
                        'This action cannot be undone!\n\n' +
                        'Type "DELETE" to confirm:';

                    const userInput = prompt(confirmationMessage);

                    if (userInput === 'DELETE') {
                        confirmed = true;
                        showLoading('Deleting division master...');
                        deleteButton.click();
                    } else {
                        showError('Deletion cancelled. The division was not deleted.');
                    }
                }
            });

            // Add confirmation safeguard
            const form = document.querySelector('form');
            form.addEventListener('submit', function(e) {
                if (!confirmed) {
                    e.preventDefault();
                    showError('Please confirm deletion using the button.');
                    return false;
                }
            });

            function showError(message) {
                const alertHtml = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa fa-exclamation-triangle"></i> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
                document.querySelector('.panel-body').insertAdjacentHTML('afterbegin', alertHtml);
            }

            function showLoading(message) {
                deleteButton.innerHTML = `<i class="fa fa-spinner fa-spin"></i> ${message}`;
                deleteButton.disabled = true;
            }
        });
    </script>
</body>
</html>