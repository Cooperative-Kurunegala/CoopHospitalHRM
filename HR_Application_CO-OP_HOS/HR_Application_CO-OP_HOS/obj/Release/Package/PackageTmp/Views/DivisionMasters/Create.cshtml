@model HR_Application_CO_OP_HOS.Models.DivisionMaster

@{
    ViewBag.Title = "Create Division Master";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Division Master</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 0;
            margin: 0;
        }

        body {
            padding: 0 !important;
            margin: 0 !important;
            overflow-x: hidden;
        }

        .dashboard-header .jumbotron {
            background: linear-gradient(135deg, #2c3e50 0%, #27ae60 100%);
            color: white;
            border-radius: 0;
            padding: 40px 20px;
            margin: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .panel {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin: 20px 0;
            background: white;
        }

        .panel-heading {
            border-radius: 10px 10px 0 0 !important;
            border: none;
            padding: 20px;
            font-weight: 600;
        }

        .panel-body {
            padding: 25px;
        }

        .form-control-lg {
            font-size: 1.1rem;
            padding: 12px 15px;
        }

        .reference-section .list-group-item {
            border: none;
            border-left: 3px solid transparent;
            margin-bottom: 5px;
            transition: all 0.3s ease;
        }

            .reference-section .list-group-item:hover {
                border-left-color: #3498db;
                background-color: #f8f9fa;
            }

        .form-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .checkbox-group {
            background: #e9ecef;
            padding: 15px;
            border-radius: 5px;
        }

        @@media (max-width: 768px) {
            .dashboard-header .jumbotron {
                padding: 30px 15px;
            }

            .form-group.row .col-md-9 {
                margin-top: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-header">
            <div class="jumbotron">
                <h1><i class="fa fa-plus-circle"></i> Create New Division Master</h1>
                <p class="lead">Add a new organizational division to the system</p>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8">
                    <div class="panel panel-success">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-sitemap"></i> Division Master Information</h3>
                        </div>
                        <div class="panel-body">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                    <!-- Basic Information Section -->
                                    <div class="form-section">
                                        <h5><i class="fa fa-info-circle"></i> Basic Information</h5>
                                        <div class="form-group row">
                                            @Html.LabelFor(model => model.DivisionMasterName, htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.EditorFor(model => model.DivisionMasterName, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter division name" } })
                                                @Html.ValidationMessageFor(model => model.DivisionMasterName, "", new { @class = "text-danger" })
                                                <small class="form-text text-muted">Enter the full name of the division</small>
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            @Html.LabelFor(model => model.DivisionMasterCode, htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.EditorFor(model => model.DivisionMasterCode, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter division code" } })
                                                @Html.ValidationMessageFor(model => model.DivisionMasterCode, "", new { @class = "text-danger" })
                                                <small class="form-text text-muted">Unique code for the division</small>
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            @Html.LabelFor(model => model.DivisionMasterDescription, htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-9">
                                                @Html.TextAreaFor(model => model.DivisionMasterDescription, new { @class = "form-control form-control-lg", rows = "3", placeholder = "Enter division description" })
                                                @Html.ValidationMessageFor(model => model.DivisionMasterDescription, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Configuration Section -->
                                    <div class="form-section">
                                        <h5><i class="fa fa-cogs"></i> Configuration</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.MenuTypeID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.MenuTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Menu Type ID" } })
                                                    @Html.ValidationMessageFor(model => model.MenuTypeID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.MenuTypeDetailID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.MenuTypeDetailID, new { htmlAttributes = new { @class = "form-control", placeholder = "Menu Type Detail ID" } })
                                                    @Html.ValidationMessageFor(model => model.MenuTypeDetailID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.DivisionMasterTypeID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.DivisionMasterTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Division Type ID" } })
                                                    @Html.ValidationMessageFor(model => model.DivisionMasterTypeID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.ParentDivisionMasterID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.ParentDivisionMasterID, new { htmlAttributes = new { @class = "form-control", placeholder = "Parent Division ID" } })
                                                    @Html.ValidationMessageFor(model => model.ParentDivisionMasterID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Settings Section -->
                                    <div class="form-section">
                                        <h5><i class="fa fa-sliders"></i> Settings</h5>
                                        <div class="checkbox-group">
                                            <div class="form-check form-switch">
                                                @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { @class = "form-check-input", @checked = "checked" } })
                                                @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                            </div>

                                            <div class="form-check form-switch">
                                                @Html.EditorFor(model => model.IsStockManaged, new { htmlAttributes = new { @class = "form-check-input" } })
                                                @Html.LabelFor(model => model.IsStockManaged, htmlAttributes: new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsStockManaged, "", new { @class = "text-danger" })
                                            </div>

                                            <div class="form-check form-switch">
                                                @Html.EditorFor(model => model.IsReserved, new { htmlAttributes = new { @class = "form-check-input" } })
                                                @Html.LabelFor(model => model.IsReserved, htmlAttributes: new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsReserved, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Additional Information -->
                                    <div class="form-section">
                                        <h5><i class="fa fa-info"></i> Additional Information</h5>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.LocationID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.LocationID, new { htmlAttributes = new { @class = "form-control", placeholder = "Location ID" } })
                                                    @Html.ValidationMessageFor(model => model.LocationID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.OrderTypeID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.OrderTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Order Type ID" } })
                                                    @Html.ValidationMessageFor(model => model.OrderTypeID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.OrderSequence, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.OrderSequence, new { htmlAttributes = new { @class = "form-control", placeholder = "Order Sequence" } })
                                                    @Html.ValidationMessageFor(model => model.OrderSequence, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AccoutClassID, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.AccoutClassID, new { htmlAttributes = new { @class = "form-control", placeholder = "Account Class ID" } })
                                                    @Html.ValidationMessageFor(model => model.AccoutClassID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.AccoutClassCode, htmlAttributes: new { @class = "control-label" })
                                                    @Html.EditorFor(model => model.AccoutClassCode, new { htmlAttributes = new { @class = "form-control", placeholder = "Account Class Code" } })
                                                    @Html.ValidationMessageFor(model => model.AccoutClassCode, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group row mt-4">
                                        <div class="col-md-12 text-end">
                                            <button type="submit" class="btn btn-success btn-lg">
                                                <i class="fa fa-save"></i> Create Division Master
                                            </button>
                                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Reference Information Panel -->
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-info-circle"></i> Reference Information</h3>
                        </div>
                        <div class="panel-body">
                            <div class="reference-section">
                                <h5><i class="fa fa-link"></i> Related Entities</h5>
                                <p class="text-muted">This division can be linked to:</p>
                                <ul class="list-group">
                                    <li class="list-group-item">
                                        <i class="fa fa-users text-primary"></i>
                                        <strong>Related Parties</strong>
                                        <span class="badge bg-primary float-end" id="relatedPartiesCount">--</span>
                                    </li>
                                    <li class="list-group-item">
                                        <i class="fa fa-cubes text-success"></i>
                                        <strong>Division Charges</strong>
                                        <span class="badge bg-success float-end" id="divisionChargesCount">--</span>
                                    </li>
                                    <li class="list-group-item">
                                        <i class="fa fa-sitemap text-warning"></i>
                                        <strong>Child Divisions</strong>
                                        <span class="badge bg-warning float-end" id="childDivisionsCount">--</span>
                                    </li>
                                </ul>
                            </div>

                            <div class="quick-tips mt-4">
                                <h5><i class="fa fa-lightbulb-o"></i> Quick Tips</h5>
                                <div class="alert alert-info">
                                    <ul class="mb-0">
                                        <li>Use descriptive division names</li>
                                        <li>Set unique codes for identification</li>
                                        <li>Enable stock management for inventory divisions</li>
                                        <li>Set parent division for hierarchical structure</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Form validation enhancement
            const form = document.querySelector('form');
            form.addEventListener('submit', function(e) {
                const divisionName = document.getElementById('DivisionMasterName').value.trim();
                if (divisionName === '') {
                    e.preventDefault();
                    showError('Division name is required');
                    return false;
                }
                showLoading('Creating division master...');
            });

            // Real-time validation
            const divisionNameInput = document.getElementById('DivisionMasterName');
            divisionNameInput.addEventListener('input', function() {
                const value = this.value;
                if (value.length > 0) {
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                } else {
                    this.classList.remove('is-valid');
                    this.classList.add('is-invalid');
                }
            });

            // Load reference data (simulated)
            loadReferenceData();

            function loadReferenceData() {
                // Simulate loading reference data
                setTimeout(function() {
                    document.getElementById('relatedPartiesCount').textContent = '0';
                    document.getElementById('divisionChargesCount').textContent = '0';
                    document.getElementById('childDivisionsCount').textContent = '0';
                }, 500);
            }

            function showError(message) {
                const alertHtml = `<div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa fa-exclamation-triangle"></i> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
                form.insertAdjacentHTML('afterbegin', alertHtml);
            }

            function showLoading(message) {
                // You can implement a loading indicator here
                console.log(message);
            }
        });
    </script>
</body>
</html>