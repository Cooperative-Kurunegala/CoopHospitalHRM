@model HR_Application_CO_OP_HOS.Models.DivisionMaster

@{
    ViewBag.Title = "Division Master Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Division Master Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 0;
            margin: 0;
        }

        body {
            padding: 0 !important;
            margin: 0 !important;
            overflow-x: hidden;
        }

        .dashboard-header .jumbotron {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            border-radius: 0;
            padding: 40px 20px;
            margin: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .panel {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin: 20px 0;
            background: white;
        }

        .panel-heading {
            border-radius: 10px 10px 0 0 !important;
            border: none;
            padding: 20px;
            font-weight: 600;
        }

        .panel-body {
            padding: 25px;
        }

        .details-dl dt {
            font-weight: 600;
            color: #6c757d;
            padding: 8px 0;
        }

        .details-dl dd {
            color: #495057;
            padding: 8px 0;
            border-bottom: 1px solid #e9ecef;
        }

        .stat-item {
            padding: 20px;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            background: #f8f9fa;
            text-align: center;
        }

            .stat-item h3 {
                font-size: 2rem;
                font-weight: bold;
                margin: 10px 0;
                color: #2c3e50;
            }

        .quick-links .list-group-item {
            border: none;
            border-left: 3px solid transparent;
            margin-bottom: 5px;
            transition: all 0.3s ease;
        }

            .quick-links .list-group-item:hover {
                border-left-color: #3498db;
                background-color: #f8f9fa;
            }

        .badge-detail {
            font-size: 0.9rem;
            padding: 8px 12px;
        }

        @@media (max-width: 768px) {
            .dashboard-header .jumbotron {
                padding: 30px 15px;
            }

            .details-dl .row {
                margin-bottom: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-header">
            <div class="jumbotron">
                <h1><i class="fa fa-sitemap"></i> Division Master Details</h1>
                <p class="lead">View complete division master information</p>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8">
                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-info-circle"></i> Basic Information</h3>
                        </div>
                        <div class="panel-body">
                            <div class="details-section">
                                <dl class="row details-dl">
                                    <dt class="col-sm-4">Division ID:</dt>
                                    <dd class="col-sm-8">@Model.ID</dd>

                                    <dt class="col-sm-4">Division Name:</dt>
                                    <dd class="col-sm-8">
                                        <strong>@Model.DivisionMasterName</strong>
                                        @if (Model.IsActive == true)
                                        {
                                            <span class="badge bg-success badge-detail ms-2">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger badge-detail ms-2">Inactive</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Division Code:</dt>
                                    <dd class="col-sm-8">@Model.DivisionMasterCode</dd>

                                    <dt class="col-sm-4">Description:</dt>
                                    <dd class="col-sm-8">
                                        @if (!string.IsNullOrEmpty(Model.DivisionMasterDescription))
                                        {
                                            @Model.DivisionMasterDescription
                                        }
                                        else
                                        {
                                            <span class="text-muted">No description provided</span>
                                        }
                                    </dd>
                                </dl>
                            </div>

                            <!-- Configuration Details -->
                            <div class="details-section mt-4">
                                <h5><i class="fa fa-cogs"></i> Configuration</h5>
                                <dl class="row details-dl">
                                    <dt class="col-sm-4">Menu Type ID:</dt>
                                    <dd class="col-sm-8">@(Model.MenuTypeID?.ToString() ?? "Not set")</dd>

                                    <dt class="col-sm-4">Menu Type Detail ID:</dt>
                                    <dd class="col-sm-8">@(Model.MenuTypeDetailID?.ToString() ?? "Not set")</dd>

                                    <dt class="col-sm-4">Division Type ID:</dt>
                                    <dd class="col-sm-8">@(Model.DivisionMasterTypeID?.ToString() ?? "Not set")</dd>

                                    <dt class="col-sm-4">Parent Division ID:</dt>
                                    <dd class="col-sm-8">@(Model.ParentDivisionMasterID?.ToString() ?? "No parent")</dd>
                                </dl>
                            </div>

                            <!-- Settings Details -->
                            <div class="details-section mt-4">
                                <h5><i class="fa fa-sliders"></i> Settings</h5>
                                <dl class="row details-dl">
                                    <dt class="col-sm-4">Stock Managed:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.IsStockManaged == true)
                                        {
                                            <span class="badge bg-info badge-detail">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary badge-detail">No</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Reserved:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.IsReserved == true)
                                        {
                                            <span class="badge bg-warning badge-detail">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary badge-detail">No</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Location ID:</dt>
                                    <dd class="col-sm-8">@(Model.LocationID?.ToString() ?? "Not set")</dd>

                                    <dt class="col-sm-4">Order Type ID:</dt>
                                    <dd class="col-sm-8">@(Model.OrderTypeID?.ToString() ?? "Not set")</dd>
                                </dl>
                            </div>

                            <!-- Additional Information -->
                            <div class="details-section mt-4">
                                <h5><i class="fa fa-info"></i> Additional Information</h5>
                                <dl class="row details-dl">
                                    <dt class="col-sm-4">Order Sequence:</dt>
                                    <dd class="col-sm-8">@(Model.OrderSequence?.ToString() ?? "Not set")</dd>

                                    <dt class="col-sm-4">Account Class ID:</dt>
                                    <dd class="col-sm-8">@(Model.AccoutClassID?.ToString() ?? "Not set")</dd>

                                    <dt class="col-sm-4">Account Class Code:</dt>
                                    <dd class="col-sm-8">@(Model.AccoutClassCode?.ToString() ?? "Not set")</dd>
                                </dl>
                            </div>

                            <div class="action-buttons mt-4">
                                <div class="btn-group" role="group">
                                    @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-lg" })
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-lg" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Related Data Panel -->
                    <div class="panel panel-success">
                        <div class="panel-heading">
                            <h3 class="panel-title"><i class="fa fa-line-chart"></i> Related Statistics</h3>
                        </div>
                        <div class="panel-body">
                            <div class="statistics-section">
                                <div class="stat-item text-center mb-4">
                                    <div class="stat-icon">
                                        <i class="fa fa-users fa-3x text-primary"></i>
                                    </div>
                                    <h3 id="employeeCount">--</h3>
                                    <p class="text-muted">Total Employees</p>
                                </div>

                                <div class="stat-item text-center mb-4">
                                    <div class="stat-icon">
                                        <i class="fa fa-cubes fa-3x text-success"></i>
                                    </div>
                                    <h3 id="divisionChargesCount">--</h3>
                                    <p class="text-muted">Division Charges</p>
                                </div>

                                <div class="stat-item text-center">
                                    <div class="stat-icon">
                                        <i class="fa fa-sitemap fa-3x text-warning"></i>
                                    </div>
                                    <h3 id="childDivisionsCount">--</h3>
                                    <p class="text-muted">Child Divisions</p>
                                </div>
                            </div>

                            <div class="quick-links mt-4">
                                <h5><i class="fa fa-external-link"></i> Quick Links</h5>
                                <div class="list-group">
                                    <a href="@Url.Action("Index", "RelatedParties", new { divisionId = Model.ID })" class="list-group-item list-group-item-action">
                                        <i class="fa fa-users text-primary"></i> View Employees
                                    </a>
                                    <a href="@Url.Action("Index", "DivisionCharges", new { divisionId = Model.ID })" class="list-group-item list-group-item-action">
                                        <i class="fa fa-cubes text-success"></i> View Division Charges
                                    </a>
                                    <a href="@Url.Action("Index", "DivisionMasters", new { parentId = Model.ID })" class="list-group-item list-group-item-action">
                                        <i class="fa fa-sitemap text-warning"></i> View Child Divisions
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Load statistics (simulated)
            loadStatistics();

            function loadStatistics() {
                // Simulate API call to get statistics
                setTimeout(function() {
                    document.getElementById('employeeCount').textContent = '0';
                    document.getElementById('divisionChargesCount').textContent = '0';
                    document.getElementById('childDivisionsCount').textContent = '0';
                }, 1000);
            }

            // Print functionality
            document.querySelector('.btn-print')?.addEventListener('click', function() {
                window.print();
            });
        });
    </script>
</body>
</html>