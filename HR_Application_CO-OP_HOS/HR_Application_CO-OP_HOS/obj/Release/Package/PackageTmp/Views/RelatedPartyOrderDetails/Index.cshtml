@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartyOrderDetail>

@{
    ViewBag.Title = "Related Party Order Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Content Section */
        .content-section {
            padding: 30px;
        }

        /* Action Panel */
        .action-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        /* Table Styling */
        .data-table-container {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow-x: auto;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1rem;
            min-width: 1200px;
        }

            .table th {
                background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
                color: white;
                padding: 16px;
                font-weight: 600;
                border: none;
                position: sticky;
                top: 0;
            }

            .table td {
                padding: 14px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: middle;
            }

            .table tbody tr {
                transition: all 0.3s ease;
            }

                .table tbody tr:hover {
                    background-color: #f8f9fa;
                    transform: translateY(-1px);
                    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                }

        /* Action Links */
        .action-links a {
            margin: 0 6px;
            padding: 6px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .btn-edit {
            background: #f39c12;
            color: white;
        }

        .btn-details {
            background: #3498db;
            color: white;
        }

        .btn-delete {
            background: #e74c3c;
            color: white;
        }

        .btn-create {
            background: #27ae60;
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            transition: all 0.3s ease;
        }

            .btn-create i {
                margin-right: 8px;
            }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
                color: white;
                text-decoration: none;
            }

        .action-links a:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            color: white;
            text-decoration: none;
        }

        /* Filter Section */
        .filter-section {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .filter-input {
            border: 2px solid #e9ecef;
            border-radius: 6px;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }

            .filter-input:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 60px 20px;
            color: #7f8c8d;
        }

            .no-records i {
                font-size: 4rem;
                margin-bottom: 20px;
                color: #bdc3c7;
            }

            .no-records h4 {
                font-size: 1.5rem;
                margin-bottom: 10px;
            }

        /* Status Badges */
        .status-active {
            background: #27ae60;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .status-inactive {
            background: #e74c3c;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-section {
                padding: 15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .action-links a {
                display: block;
                margin: 5px 0;
                text-align: center;
            }

            .data-table-container {
                padding: 15px;
            }
        }

        /* Column Toggles */
        .column-toggle {
            background: #34495e;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 6px;
            margin: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .column-toggle:hover {
                background: #2c3e50;
            }

        .hidden-column {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title">
                        <i class="fa fa-list-alt"></i> Order Details
                    </h1>
                    <p class="page-subtitle">Manage all related party order details in the system</p>
                </div>
                <div class="col-md-4 text-right">
                    <a href="@Url.Action("Create")" class="btn-create">
                        <i class="fa fa-plus"></i> Create New
                    </a>
                </div>
            </div>
        </div>

        <!-- Content Section -->
        <div class="content-section">
            <!-- Filter Section -->
            <div class="filter-section">
                <div class="row">
                    <div class="col-md-3">
                        <input type="text" id="searchFilter" class="form-control filter-input" placeholder="Search order details...">
                    </div>
                    <div class="col-md-3">
                        <input type="number" id="orderIdFilter" class="form-control filter-input" placeholder="Order ID">
                    </div>
                    <div class="col-md-3">
                        <select id="statusFilter" class="form-control filter-input">
                            <option value="">All Status</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button id="clearFilters" class="btn btn-outline-secondary btn-block">Clear Filters</button>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="text-center">
                            <small class="text-muted">Column Toggles: </small>
                            <button class="column-toggle" data-column="2">Qty/Price</button>
                            <button class="column-toggle" data-column="3">Line Total</button>
                            <button class="column-toggle" data-column="4">Division Info</button>
                            <button class="column-toggle" data-column="7">Dates</button>
                            <button class="column-toggle" data-column="12">Batch Info</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Table -->
            <div class="data-table-container">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover" id="orderDetailsTable">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Order ID</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Line Total</th>
                                    <th>Division Charge</th>
                                    <th>Division Name</th>
                                    <th>Created Date</th>
                                    <th>Created By</th>
                                    <th>Charge Type</th>
                                    <th>Batch Number</th>
                                    <th>Expiry Date</th>
                                    <th>Is Nurse Charge</th>
                                    <th>Bonus Qty</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.ID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.OrderID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Qty)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                        <td>@Html.DisplayFor(modelItem => item.LineTotal)</td>
                                        <td>@Html.DisplayFor(modelItem => item.DivisionChargeID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.DivisionChargeName)</td>
                                        <td>@(item.CreatedDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                                        <td>@Html.DisplayFor(modelItem => item.ChargeTypeID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.BatchNumber)</td>
                                        <td>@(item.ExpiryDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td>
                                            <span class="@(item.IsNurseCharge == true ? "status-active" : "status-inactive")">
                                                @(item.IsNurseCharge == true ? "Yes" : "No")
                                            </span>
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.BonusQty)</td>
                                        <td class="action-links">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn-edit" })
                                            @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn-details" })
                                            @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn-delete" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-records">
                        <i class="fa fa-list-alt"></i>
                        <h4>No Order Details Found</h4>
                        <p>There are no related party order details in the system yet.</p>
                        <a href="@Url.Action("Create")" class="btn-create">
                            <i class="fa fa-plus"></i> Create First Order Detail
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Search filter functionality
            $('#searchFilter').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#orderDetailsTable tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Order ID filter
            $('#orderIdFilter').on('keyup', function () {
                var value = $(this).val();
                if (value === '') {
                    $('#orderDetailsTable tbody tr').show();
                } else {
                    $('#orderDetailsTable tbody tr').filter(function () {
                        var orderId = $(this).find('td:eq(1)').text();
                        $(this).toggle(orderId.indexOf(value) > -1);
                    });
                }
            });

            // Status filter
            $('#statusFilter').on('change', function () {
                var value = $(this).val();
                if (value === '') {
                    $('#orderDetailsTable tbody tr').show();
                } else {
                    $('#orderDetailsTable tbody tr').filter(function () {
                        var status = $(this).find('td:eq(12)').text().toLowerCase();
                        $(this).toggle(status.indexOf(value) > -1);
                    });
                }
            });

            // Clear filters
            $('#clearFilters').on('click', function () {
                $('#searchFilter').val('');
                $('#orderIdFilter').val('');
                $('#statusFilter').val('');
                $('#orderDetailsTable tbody tr').show();
            });

            // Column toggle functionality
            $('.column-toggle').on('click', function () {
                var column = $(this).data('column');
                $('table tr').each(function () {
                    var cell = $(this).find('td:eq(' + (column - 1) + ')');
                    cell.toggleClass('hidden-column');
                });
                $('table th:eq(' + (column - 1) + ')').toggleClass('hidden-column');
                $(this).toggleClass('active');
            });

            // Enhanced row click functionality
            $('#orderDetailsTable tbody tr').on('click', function (e) {
                if (!$(e.target).is('a') && !$(e.target).is('button')) {
                    var id = $(this).find('td:first').text();
                    window.location.href = '@Url.Action("Details")/' + id;
                }
            });

            // Auto-refresh data every 30 seconds
            setInterval(function () {
                console.log('Auto-refresh would occur here in a real application');
            }, 30000);
        });
    </script>
</body>
</html>