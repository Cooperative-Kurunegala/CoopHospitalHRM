﻿@model HR_Application_CO_OP_HOS.Models.AttendanceRecord

@{
    ViewBag.Title = "Attendance Record Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">ATTENDANCE RECORD DETAILS</h1>
            <p class="hospital-subtitle">View Attendance Information</p>
            <div class="admin-info">
                <span class="admin-welcome">Welcome, System Administrator</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="row no-gutters">
            <div class="col-md-8 dashboard-section">
                <div class="section-header">
                    <h2>📊 ATTENDANCE INFORMATION</h2>
                </div>
                <div class="section-content">
                    <div class="detail-card" style="background:#f8f9fa;border:3px solid #006400;border-radius:15px;padding:40px;">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <strong>Employee ID:</strong>
                                    <span>@Html.DisplayFor(model => model.EmployeeID)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Attendance Date:</strong>
                                    <span>@Html.DisplayFor(model => model.AttendanceDate)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Shift ID:</strong>
                                    <span>@Html.DisplayFor(model => model.ShiftID)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Scheduled In:</strong>
                                    <span>@Html.DisplayFor(model => model.ScheduledIn)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Scheduled Out:</strong>
                                    <span>@Html.DisplayFor(model => model.ScheduledOut)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Actual In:</strong>
                                    <span>@Html.DisplayFor(model => model.ActualIn)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Actual Out:</strong>
                                    <span>@Html.DisplayFor(model => model.ActualOut)</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <strong>Total Hours:</strong>
                                    <span class="badge @(Model.TotalHours >= 8 ? "badge-success" : "badge-warning")">
                                        @Html.DisplayFor(model => model.TotalHours) hrs
                                    </span>
                                </div>
                                <div class="detail-item">
                                    <strong>Overtime Hours:</strong>
                                    <span>
                                        @if (Model.OvertimeHours > 0)
                                        {
                                            <span class="badge badge-info">@Model.OvertimeHours hrs</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">0 hrs</span>
                                        }
                                    </span>
                                </div>
                                <div class="detail-item">
                                    <strong>Night Hours:</strong>
                                    <span>@Html.DisplayFor(model => model.NightHours) hrs</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Late Minutes:</strong>
                                    <span>@Html.DisplayFor(model => model.LateMinutes) mins</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Early Out Minutes:</strong>
                                    <span>@Html.DisplayFor(model => model.EarlyOutMinutes) mins</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Status:</strong>
                                    <span>
                                        @{
                                            var statusClass = Model.Status == "Present" ? "badge-success" :
                                                            Model.Status == "Absent" ? "badge-danger" :
                                                            Model.Status == "Late" ? "badge-warning" : "badge-secondary";
                                        }
                                        <span class="badge @statusClass">@Model.Status</span>
                                    </span>
                                </div>
                                <div class="detail-item">
                                    <strong>Regularized:</strong>
                                    <span>
                                        @if (Model.IsRegularized)
                                        {
                                            <span class="badge badge-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">No</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Remarks))
                        {
                            <div class="detail-item full-width">
                                <strong>Remarks:</strong>
                                <p style="background:white;padding:20px;border-radius:10px;margin-top:10px;">@Model.Remarks</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 dashboard-section">
                <div class="section-header">
                    <h2>⚡ QUICK ACTIONS</h2>
                </div>
                <div class="section-content">
                    <div class="action-grid">
                        <a href="@Url.Action("Edit", "AttendanceRecords", new { id = Model.AttendanceID })" class="action-card">
                            <div class="action-icon">✏️</div>
                            <span>Edit Record</span>
                        </a>
                        <a href="@Url.Action("Index", "AttendanceRecords")" class="action-card">
                            <div class="action-icon">📋</div>
                            <span>Back to List</span>
                        </a>
                        <a href="@Url.Action("Create", "AttendanceRecords")" class="action-card">
                            <div class="action-icon">➕</div>
                            <span>Create New</span>
                        </a>
                        <a href="@Url.Action("Index", "Employees")" class="action-card">
                            <div class="action-icon">👥</div>
                            <span>View Employees</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-item {
        padding: 15px 0;
        border-bottom: 1px solid #dee2e6;
        font-size: 1.8rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .full-width {
        flex-direction: column;
        align-items: flex-start;
    }

    .badge {
        font-size: 1.4rem;
        padding: 8px 12px;
    }
</style>