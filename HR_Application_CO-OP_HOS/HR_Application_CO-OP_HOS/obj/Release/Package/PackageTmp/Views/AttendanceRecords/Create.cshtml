﻿@model HR_Application_CO_OP_HOS.Models.AttendanceRecord

@{
    ViewBag.Title = "Create Attendance Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">CREATE ATTENDANCE RECORD</h1>
            <p class="hospital-subtitle">Add New Attendance Entry</p>
            <div class="admin-info">
                <span class="admin-welcome">Welcome, System Administrator</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="row no-gutters">
            <div class="col-md-12 dashboard-section">
                <div class="section-header">
                    <h2>📝 ATTENDANCE DETAILS</h2>
                </div>
                <div class="section-content">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-container" style="background:#f8f9fa;border:3px solid #006400;border-radius:15px;padding:40px;">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-grid">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.EmployeeID, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.EmployeeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Employee ID" } })
                                    @Html.ValidationMessageFor(model => model.EmployeeID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.AttendanceDate, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.AttendanceDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                    @Html.ValidationMessageFor(model => model.AttendanceDate, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ShiftID, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.ShiftID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Shift ID" } })
                                    @Html.ValidationMessageFor(model => model.ShiftID, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ScheduledIn, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.ScheduledIn, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.ScheduledIn, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ScheduledOut, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.ScheduledOut, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.ScheduledOut, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ActualIn, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.ActualIn, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.ActualIn, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ActualOut, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.ActualOut, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.ActualOut, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.TotalHours, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.TotalHours, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                    @Html.ValidationMessageFor(model => model.TotalHours, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.OvertimeHours, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.OvertimeHours, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                    @Html.ValidationMessageFor(model => model.OvertimeHours, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.NightHours, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.NightHours, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                    @Html.ValidationMessageFor(model => model.NightHours, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.LateMinutes, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.LateMinutes, new { htmlAttributes = new { @class = "form-control", placeholder = "0" } })
                                    @Html.ValidationMessageFor(model => model.LateMinutes, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.EarlyOutMinutes, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.EarlyOutMinutes, new { htmlAttributes = new { @class = "form-control", placeholder = "0" } })
                                    @Html.ValidationMessageFor(model => model.EarlyOutMinutes, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.Status, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., Present, Absent, Late" } })
                                    @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group full-width">
                                    @Html.LabelFor(model => model.Remarks, htmlAttributes: new { @class = "form-label" })
                                    @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", rows = 3, placeholder = "Enter any remarks..." })
                                    @Html.ValidationMessageFor(model => model.Remarks, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.IsRegularized, htmlAttributes: new { @class = "form-label" })
                                    <div class="checkbox-container">
                                        @Html.EditorFor(model => model.IsRegularized)
                                        @Html.ValidationMessageFor(model => model.IsRegularized, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <span>💾 Create Record</span>
                                </button>
                                <a href="@Url.Action("Index", "AttendanceRecords")" class="btn btn-secondary btn-lg">
                                    <span>📋 Back to List</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-container {
        max-width: 100%;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
        margin-bottom: 40px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        font-weight: bold;
        margin-bottom: 10px;
        font-size: 1.8rem;
        color: #006400;
    }

    .form-control {
        width: 100%;
        padding: 15px;
        font-size: 1.6rem;
        border: 2px solid #006400;
        border-radius: 10px;
        background: white;
    }

    .checkbox-container {
        margin-top: 10px;
    }

        .checkbox-container input[type="checkbox"] {
            transform: scale(1.5);
            margin-right: 10px;
        }

    .form-actions {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 40px;
    }

    .btn-lg {
        padding: 20px 40px;
        font-size: 1.8rem;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}