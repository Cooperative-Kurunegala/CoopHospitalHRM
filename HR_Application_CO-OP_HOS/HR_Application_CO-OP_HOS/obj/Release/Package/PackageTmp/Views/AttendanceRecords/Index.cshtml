@model IEnumerable<HR_Application_CO_OP_HOS.Models.AttendanceRecord>

@{
    ViewBag.Title = "Attendance Records";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-list-alt"></i> Attendance Records Management</h1>
            <p class="lead">Manage raw attendance data and processing status</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-block" })
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-info btn-block" onclick="processSelectedRecords()">
                                <i class="fa fa-cog"></i> Process Selected
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-warning btn-block" onclick="applyFilters()">
                                <i class="fa fa-filter"></i> Apply Filters
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-secondary btn-block" onclick="clearFilters()">
                                <i class="fa fa-refresh"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filters</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>EPF Number</label>
                                <input type="number" id="filterEPF" class="form-control" placeholder="Filter by EPF">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Date From</label>
                                <input type="datetime-local" id="filterDateFrom" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Date To</label>
                                <input type="datetime-local" id="filterDateTo" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Processing Status</label>
                                <select id="filterProcessed" class="form-control">
                                    <option value="">All</option>
                                    <option value="true">Processed</option>
                                    <option value="false">Not Processed</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bar-chart"></i> Records Overview</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters text-center">
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-icon text-primary">
                                    <i class="fa fa-database"></i>
                                </div>
                                <h4>Total Records</h4>
                                <p class="stat-number">@Model.Count()</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-icon text-success">
                                    <i class="fa fa-check-circle"></i>
                                </div>
                                <h4>Processed</h4>
                                <p class="stat-number">@Model.Count(r => r.IsProcessed == true)</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-icon text-warning">
                                    <i class="fa fa-clock-o"></i>
                                </div>
                                <h4>Pending</h4>
                                <p class="stat-number">@Model.Count(r => r.IsProcessed != true)</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-item">
                                <div class="stat-icon text-info">
                                    <i class="fa fa-building"></i>
                                </div>
                                <h4>Companies</h4>
                                <p class="stat-number">@Model.Select(r => r.CompanyID).Distinct().Count()</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-table"></i> Attendance Records</h3>
                    <div class="panel-tools">
                        <span class="badge badge-primary" id="recordCount">@Model.Count() records</span>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="selectAll">
                            <label class="form-check-label" for="selectAll">Select All</label>
                        </div>
                    </div>
                </div>
                <div class="panel-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="attendanceTable">
                                <thead class="thead-dark">
                                    <tr>
                                        <th style="width: 50px;">
                                            <input type="checkbox" id="selectAllRows">
                                        </th>
                                        <th>@Html.DisplayNameFor(model => model.EPFNo)</th>
                                        <th>@Html.DisplayNameFor(model => model.AttendanceDateTime)</th>
                                        <th>@Html.DisplayNameFor(model => model.IsProcessed)</th>
                                        <th>@Html.DisplayNameFor(model => model.CompanyID)</th>
                                        <th>Record Type</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" class="row-select" value="@item.ID">
                                            </td>
                                            <td>
                                                <span class="badge badge-info">@Html.DisplayFor(modelItem => item.EPFNo)</span>
                                            </td>
                                            <td>
                                                @if (item.AttendanceDateTime.HasValue)
                                                {
                                                    <div>
                                                        <strong>@item.AttendanceDateTime.Value.ToString("MMM dd, yyyy")</strong>
                                                        <br>
                                                        <small class="text-muted">@item.AttendanceDateTime.Value.ToString("hh:mm tt")</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsProcessed == true)
                                                {
                                                    <span class="badge badge-success">
                                                        <i class="fa fa-check"></i> Processed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">
                                                        <i class="fa fa-clock-o"></i> Pending
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge badge-secondary">@Html.DisplayFor(modelItem => item.CompanyID)</span>
                                            </td>
                                            <td>
                                                @{
                                                    var recordType = GetRecordType(item.AttendanceDateTime);
                                                }
                                                <span class="badge @GetRecordTypeBadgeClass(recordType)">@recordType</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fa fa-exclamation-triangle fa-3x"></i>
                            <h4>No Attendance Records Found</h4>
                            <p>There are no attendance records in the system. @Html.ActionLink("Create a new record", "Create") to get started.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter functionality
        function applyFilters() {
            const epfFilter = document.getElementById('filterEPF').value;
            const dateFrom = document.getElementById('filterDateFrom').value;
            const dateTo = document.getElementById('filterDateTo').value;
            const processedFilter = document.getElementById('filterProcessed').value;

            const rows = document.querySelectorAll('#attendanceTable tbody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                let showRow = true;
                const epf = row.cells[1].textContent.trim();
                const processed = row.cells[3].textContent.includes('Processed');

                if (epfFilter && !epf.includes(epfFilter)) {
                    showRow = false;
                }

                if (processedFilter !== '') {
                    if (processedFilter === 'true' && !processed) showRow = false;
                    if (processedFilter === 'false' && processed) showRow = false;
                }

                row.style.display = showRow ? '' : 'none';
                if (showRow) visibleCount++;
            });

            document.getElementById('recordCount').textContent = visibleCount + ' records';
        }

        function clearFilters() {
            document.getElementById('filterEPF').value = '';
            document.getElementById('filterDateFrom').value = '';
            document.getElementById('filterDateTo').value = '';
            document.getElementById('filterProcessed').value = '';
            applyFilters();
        }

        function processSelectedRecords() {
            const selectedIds = Array.from(document.querySelectorAll('.row-select:checked'))
                .map(checkbox => checkbox.value);

            if (selectedIds.length === 0) {
                alert('Please select at least one record to process.');
                return;
            }

            if (confirm(`Are you sure you want to mark ${selectedIds.length} record(s) as processed?`)) {
                // Simulate processing - in real app, this would be an AJAX call
                selectedIds.forEach(id => {
                    const row = document.querySelector(`.row-select[value="${id}"]`).closest('tr');
                    const statusCell = row.cells[3];
                    statusCell.innerHTML = '<span class="badge badge-success"><i class="fa fa-check"></i> Processed</span>';
                });

                showAlert(`${selectedIds.length} record(s) marked as processed.`, 'success');
            }
        }

        // Select all functionality
        document.getElementById('selectAllRows').addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('.row-select');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                `;
            document.querySelector('.panel-body').prepend(alertDiv);

            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }

        // Initialize filters
        document.addEventListener('DOMContentLoaded', function () {
            applyFilters();
        });
    </script>
}

@functions {
    public string GetRecordType(DateTime? attendanceDateTime)
    {
        if (!attendanceDateTime.HasValue) return "Unknown";

        var hour = attendanceDateTime.Value.Hour;
        if (hour < 12) return "Morning";
        if (hour < 17) return "Afternoon";
        return "Evening";
    }

    public string GetRecordTypeBadgeClass(string recordType)
    {
        switch (recordType)
        {
            case "Morning": return "badge-primary";
            case "Afternoon": return "badge-warning";
            case "Evening": return "badge-dark";
            default: return "badge-secondary";
        }
    }
}

