        padding: 30px;
    }

    .stat-item {
        padding: 15px;
    }

    .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: #2c3e50;
        margin: 10px 0;
    }

    .form-check {
        margin: 0;
    }
</style>