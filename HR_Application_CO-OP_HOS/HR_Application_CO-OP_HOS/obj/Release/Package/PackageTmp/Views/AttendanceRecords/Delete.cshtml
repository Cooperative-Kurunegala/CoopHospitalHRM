@model HR_Application_CO_OP_HOS.Models.AttendanceRecord

@{
    ViewBag.Title = "Delete Attendance Record";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Attendance Record</h1>
            <p class="lead">Remove attendance record from the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Confirmation Panel -->
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-danger">
                        <h4><i class="fa fa-warning"></i> Warning: This action cannot be undone!</h4>
                        <p>You are about to permanently delete this attendance record. This action will remove all associated data and cannot be recovered.</p>
                    </div>

                    <div class="confirmation-details">
                        <h5>Record to be deleted:</h5>
                        <div class="detail-summary">
                            <div class="row no-gutters">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <strong>Record ID:</strong>
                                        <span>@Model.ID</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <strong>EPF Number:</strong>
                                        <span>@Html.DisplayFor(model => model.EPFNo)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row no-gutters">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <strong>Company ID:</strong>
                                        <span>@Html.DisplayFor(model => model.CompanyID)</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <strong>Processing Status:</strong>
                                        <span>
                                            @if (Model.IsProcessed == true)
                                            {
                                                <span class="badge badge-success">Processed</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">Not Processed</span>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="row no-gutters">
                                <div class="col-12">
                                    <div class="detail-item">
                                        <strong>Attendance Date & Time:</strong>
                                        <span>@(Model.AttendanceDateTime?.ToString("MMM dd, yyyy HH:mm") ?? "N/A")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="row no-gutters mt-4">
                            <div class="col-12">
                                <div class="form-group text-center">
                                    <button type="submit" class="btn btn-danger btn-lg" onclick="return confirmDelete()">
                                        <i class="fa fa-trash"></i> Confirm Delete
                                    </button>
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Side Panel -->
        <div class="col-md-4">
            <!-- Impact Analysis -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Impact Analysis</h3>
                </div>
                <div class="panel-body">
                    <div class="impact-list">
                        <div class="impact-item">
                            <i class="fa fa-exclamation-circle text-warning"></i>
                            <span>This record will be permanently removed</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-bar-chart text-info"></i>
                            <span>Attendance analytics will be affected</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-calculator text-primary"></i>
                            <span>Payroll calculations may need adjustment</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-history text-muted"></i>
                            <span>Audit trail will be maintained</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Employee Information -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-user"></i> Employee Information</h3>
                </div>
                <div class="panel-body">
                    <div id="employeeInfo" class="text-center">
                        <div class="employee-details">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Loading...</span>
                            </div>
                            <p>Loading employee data...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alternative Actions -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-lightbulb-o"></i> Alternative Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="alternative-actions">
                        <p class="text-muted">Consider these alternatives instead of deletion:</p>
                        <div class="action-item">
                            @Html.ActionLink("Edit Record", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-warning btn-block mb-2" })
                        </div>
                        <div class="action-item">
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-outline-info btn-block mb-2" })
                        </div>
                        <div class="action-item">
                            <button class="btn btn-outline-secondary btn-block" onclick="history.back()">
                                <i class="fa fa-arrow-left"></i> Go Back
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            const epf = @Model.EPFNo;
            const date = '@Model.AttendanceDateTime?.ToString("MMM dd, yyyy HH:mm")';
            const recordId = @Model.ID;

            return confirm(`Are you absolutely sure you want to delete attendance record #${recordId} for EPF ${epf} at ${date}? This action cannot be undone.`);
        }

        function loadEmployeeInfo() {
            const epf = @Model.EPFNo;

            // Simulate employee data loading
            setTimeout(() => {
                document.getElementById('employeeInfo').innerHTML = `
                    <div class="employee-details">
                        <h5>John Doe</h5>
                        <p class="text-muted">EPF: ${epf}</p>
                        <p><strong>Designation:</strong> Software Engineer</p>
                        <p><strong>Department:</strong> IT Department</p>
                        <p><strong>Status:</strong> <span class="badge badge-success">Active</span></p>
                        <div class="alert alert-warning mt-2">
                            <small><i class="fa fa-info-circle"></i> Deleting this record will affect employee's attendance history</small>
                        </div>
                    </div>
                `;
            }, 1000);
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadEmployeeInfo();
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        background: white;
    }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .alert {
        border-radius: 8px;
        border: none;
    }

    .confirmation-details {
        margin: 25px 0;
    }

    .detail-summary {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-top: 15px;
    }

    .detail-item {
        padding: 10px 0;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        justify-content: space-between;
    }

        .detail-item:last-child {
            border-bottom: none;
        }

    .impact-list .impact-item {
        display: flex;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

        .impact-list .impact-item:last-child {
            border-bottom: none;
        }

        .impact-list .impact-item i {
            margin-right: 10px;
            font-size: 1.2em;
            width: 20px;
        }

    .alternative-actions .action-item {
        margin-bottom: 10px;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
        margin: 0 5px;
    }

    .employee-details {
        text-align: left;
    }

    .badge {
        font-size: 0.8em;
    }
</style>