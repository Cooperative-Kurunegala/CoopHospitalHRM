@{
    ViewBag.Title = "About HRM System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="about-header">
        <h1>ABOUT HRM SYSTEM</h1>
        <p class="subtitle">Hospital Human Resources Management Solution</p>
    </div>

    <div class="about-content" style="padding:30px;">
        <div class="row no-gutters">
            <div class="col-md-8">
                <div class="info-section">
                    <h2>🏥 System Overview</h2>
                    <p class="lead">
                        Comprehensive HRM solution specifically designed for Leading Private Hospital in Sri Lanka,
                        providing complete workforce management capabilities for healthcare professionals.
                    </p>

                    <div class="features-grid">
                        <div class="feature-item">
                            <h3>🎯 Core Features</h3>
                            <div class="feature-list">
                                <div class="feature-badge">Employee Management</div>
                                <div class="feature-badge">Attendance Tracking</div>
                                <div class="feature-badge">Payroll Processing</div>
                                <div class="feature-badge">Leave Management</div>
                                <div class="feature-badge">Shift Management</div>
                                <div class="feature-badge">Financial Integration</div>
                            </div>
                        </div>

                        <div class="feature-item">
                            <h3>📦 Hospital Modules</h3>
                            <div class="modules-grid">
                                <div class="module-column">
                                    <ul>
                                        <li>Employee Records Management</li>
                                        <li>Attendance & Time Tracking</li>
                                        <li>Payroll & Compensation</li>
                                        <li>Leave Management System</li>
                                        <li>Shift & Roster Management</li>
                                    </ul>
                                </div>
                                <div class="module-column">
                                    <ul>
                                        <li>Financial Management</li>
                                        <li>Bank & Account Management</li>
                                        <li>Tax Management</li>
                                        <li>System Administration</li>
                                        <li>Reporting & Analytics</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="sidebar-info">
                    <div class="info-card">
                        <h3>📋 System Information</h3>
                        <div class="info-list">
                            <div class="info-item"><strong>Version:</strong> 2.0</div>
                            <div class="info-item"><strong>Framework:</strong> ASP.NET MVC</div>
                            <div class="info-item"><strong>Database:</strong> SQL Server</div>
                            <div class="info-item"><strong>Modules:</strong> 60+</div>
                            <div class="info-item"><strong>Last Updated:</strong> @DateTime.Now.ToString("MMMM yyyy")</div>
                        </div>
                    </div>

                    <div class="info-card developer-info">
                        <h3>👨‍💻 Developer</h3>
                        <h4>eHealthcare Solutions</h4>
                        <p>Specialized in healthcare software solutions</p>
                        <div class="contact-info"><strong>Website:</strong> <a href="https://ehealthcare.lk" target="_blank">ehealthcare.lk</a></div>
                        <div class="contact-info"><strong>Email:</strong> <a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>