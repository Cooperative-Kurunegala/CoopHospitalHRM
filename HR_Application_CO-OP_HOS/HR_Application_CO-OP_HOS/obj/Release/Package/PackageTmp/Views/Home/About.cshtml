@{
    ViewBag.Title = "About HRM System";
}

<div class="page-header">
    <h1>@ViewBag.Title</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <h3>Human Resources Management System</h3>
        <p class="lead">
            Comprehensive HRM solution designed specifically for 
        </p>

        <h4>System Overview</h4>
        <p>
            This Human Resources Management (HRM) web application is built using ASP.NET MVC framework
            and provides a complete solution for managing hospital staff, attendance, payroll, leaves,
            and other HR operations.
        </p>

        <h4>Key Features</h4>
        <ul>
            <li><strong>Employee Management:</strong> Complete employee lifecycle management</li>
            <li><strong>Attendance Tracking:</strong> Real-time attendance monitoring and reporting</li>
            <li><strong>Payroll Processing:</strong> Automated salary calculations and disbursements</li>
            <li><strong>Leave Management:</strong> Comprehensive leave application and approval system</li>
            <li><strong>Shift Management:</strong> Flexible roster and shift planning</li>
            <li><strong>Financial Integration:</strong> Bank and payment system integration</li>
            <li><strong>Reporting & Analytics:</strong> Detailed reports and insights</li>
        </ul>

        <h4>Modules Included</h4>
        <div class="row">
            <div class="col-md-6">
                <ul>
                    <li>Admission Management</li>
                    <li>Attendance & Time Management</li>
                    <li>Payroll & Compensation</li>
                    <li>Employee Management</li>
                    <li>Leave Management</li>
                </ul>
            </div>
            <div class="col-md-6">
                <ul>
                    <li>Financial Management</li>
                    <li>System Administration</li>
                    <li>Channeling Management</li>
                    <li>Charge Management</li>
                    <li>Insurance Claims</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title">System Information</h3>
            </div>
            <div class="panel-body">
                <p><strong>Version:</strong> 1.0</p>
                <p><strong>Framework:</strong> ASP.NET MVC</p>
                <p><strong>Database:</strong> SQL Server</p>
                <p><strong>Modules:</strong> 60+</p>
                <p><strong>Last Updated:</strong> @DateTime.Now.ToString("MMMM yyyy")</p>
            </div>
        </div>

        <div class="panel panel-success">
            <div class="panel-heading">
                <h3 class="panel-title">Developer</h3>
            </div>
            <div class="panel-body">
                <h4>eHealthcare Solutions</h4>
                <p>Specialized in healthcare software solutions</p>
                <p>
                    <strong>Website:</strong> <a href="https://ehealthcare.lk" target="_blank">https://ehealthcare.lk</a><br>
                    <strong>Email:</strong> <a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a>
                </p>
            </div>
        </div>
    </div>
</div>

