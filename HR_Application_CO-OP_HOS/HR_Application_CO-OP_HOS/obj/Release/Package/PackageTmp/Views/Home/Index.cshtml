﻿@{
    ViewBag.Title = "HRM System Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Dashboard -->
<div class="fullscreen-container dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">HOSPITAL HUMAN RESOURCES MANAGEMENT</h1>
            <p class="hospital-subtitle">Leading Healthcare Provider in Sri Lanka</p>
            <div class="admin-info">
                <span class="admin-welcome">Welcome, System Administrator</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Quick Stats Overview -->
    <div class="stats-overview">
        <div class="row no-gutters">
            <div class="col-md-2 stat-card">
                <div class="stat-content">
                    <div class="stat-icon">👥</div>
                    <h3>Total Employees</h3>
                    <p class="stat-number">@ViewBag.TotalEmployees</p>
                </div>
            </div>
            <div class="col-md-2 stat-card">
                <div class="stat-content">
                    <div class="stat-icon">📊</div>
                    <h3>Active Today</h3>
                    <p class="stat-number">@ViewBag.ActiveToday</p>
                </div>
            </div>
            <div class="col-md-2 stat-card">
                <div class="stat-content">
                    <div class="stat-icon">💼</div>
                    <h3>On Leave</h3>
                    <p class="stat-number">@ViewBag.OnLeave</p>
                </div>
            </div>
            <div class="col-md-2 stat-card">
                <div class="stat-content">
                    <div class="stat-icon">💰</div>
                    <h3>Pending Payroll</h3>
                    <p class="stat-number">@ViewBag.PendingPayroll</p>
                </div>
            </div>
            <div class="col-md-2 stat-card">
                <div class="stat-content">
                    <div class="stat-icon">🏥</div>
                    <h3>Departments</h3>
                    <p class="stat-number">@ViewBag.TotalDepartments</p>
                </div>
            </div>
            <div class="col-md-2 stat-card">
                <div class="stat-content">
                    <div class="stat-icon">✅</div>
                    <h3>System Status</h3>
                    <p class="stat-number text-success">Optimal</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Dashboard Grid -->
    <div class="dashboard-grid">
        <div class="row no-gutters">
            <!-- Employee Management Section -->
            <div class="col-md-6 dashboard-section">
                <div class="section-header">
                    <h2>👥 EMPLOYEE MANAGEMENT</h2>
                </div>
                <div class="section-content">
                    <div class="action-grid">
                        <a href="@Url.Action("Index", "Employees")" class="action-card">
                            <div class="action-icon">👤</div>
                            <span>Employee Records</span>
                        </a>
                        <a href="@Url.Action("Index", "Designations")" class="action-card">
                            <div class="action-icon">🎯</div>
                            <span>Designations</span>
                        </a>
                        <a href="@Url.Action("Index", "EmployeeTypes")" class="action-card">
                            <div class="action-icon">📋</div>
                            <span>Employee Types</span>
                        </a>
                        <a href="@Url.Action("Index", "EmployeeCategories")" class="action-card">
                            <div class="action-icon">📁</div>
                            <span>Categories</span>
                        </a>
                        <a href="@Url.Action("Index", "EmployeeShifts")" class="action-card">
                            <div class="action-icon">⏰</div>
                            <span>Employee Shifts</span>
                        </a>
                        <a href="@Url.Action("Index", "Companies")" class="action-card">
                            <div class="action-icon">🏢</div>
                            <span>Companies</span>
                        </a>
                        <a href="@Url.Action("Index", "Locations")" class="action-card">
                            <div class="action-icon">📍</div>
                            <span>Locations</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Attendance & Time Management -->
            <div class="col-md-6 dashboard-section">
                <div class="section-header">
                    <h2>⏰ ATTENDANCE & TIME</h2>
                </div>
                <div class="section-content">
                    <div class="action-grid">
                        <a href="@Url.Action("Index", "AttendanceRecords")" class="action-card">
                            <div class="action-icon">📝</div>
                            <span>Attendance Records</span>
                        </a>
                        <a href="@Url.Action("Index", "Shifts")" class="action-card">
                            <div class="action-icon">🔄</div>
                            <span>Shift Management</span>
                        </a>
                        <a href="@Url.Action("Index", "OnCallSchedules")" class="action-card">
                            <div class="action-icon">📅</div>
                            <span>On-Call Schedules</span>
                        </a>
                        <a href="@Url.Action("Index", "PerformanceAppraisals")" class="action-card">
                            <div class="action-icon">⭐</div>
                            <span>Performance</span>
                        </a>
                        <a href="@Url.Action("Index", "EmployeeQualifications")" class="action-card">
                            <div class="action-icon">📚</div>
                            <span>Qualifications</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row no-gutters">
            <div class="col-md-6 dashboard-section">
                <div class="section-header"><h2>💰 PAYROLL & COMPENSATION</h2></div>
                <div class="section-content">
                    <div class="action-grid">
                        <a href="@Url.Action("Index", "PayrollRecords")" class="action-card"><div class="action-icon">💵</div><span>Payroll Records</span></a>
                        <a href="@Url.Action("Index", "Allowances")" class="action-card"><div class="action-icon">💳</div><span>Allowances</span></a>
                        <a href="@Url.Action("Index", "EmployeeAllowances")" class="action-card"><div class="action-icon">💰</div><span>Employee Allowances</span></a>
                        <a href="@Url.Action("Index", "LoanCategories")" class="action-card"><div class="action-icon">🏦</div><span>Loan Categories</span></a>
                        <a href="@Url.Action("Index", "LoanInstallments")" class="action-card"><div class="action-icon">📊</div><span>Loan Installments</span></a>
                        <a href="@Url.Action("Index", "EmployeeLoans")" class="action-card"><div class="action-icon">💼</div><span>Employee Loans</span></a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 dashboard-section">
                <div class="section-header"><h2>📅 LEAVE MANAGEMENT</h2></div>
                <div class="section-content">
                    <div class="action-grid">
                        <a href="@Url.Action("Index", "Leaves")" class="action-card"><div class="action-icon">🏖️</div><span>Leave Applications</span></a>
                        <a href="@Url.Action("Index", "LeaveTypes")" class="action-card"><div class="action-icon">📑</div><span>Leave Types</span></a>
                        <a href="@Url.Action("Index", "LeaveCategories")" class="action-card"><div class="action-icon">📂</div><span>Leave Categories</span></a>
                        <a href="@Url.Action("Index", "PerformanceAppraisals")" class="action-card"><div class="action-icon">⭐</div><span>Appraisals</span></a>
                        <a href="@Url.Action("Index", "EmployeeTrainings")" class="action-card"><div class="action-icon">🎓</div><span>Trainings</span></a>
                        <a href="@Url.Action("Index", "Specializations")" class="action-card"><div class="action-icon">🎯</div><span>Specializations</span></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row no-gutters">
            <div class="col-md-6 dashboard-section">
                <div class="section-header"><h2>💳 FINANCIAL MANAGEMENT</h2></div>
                <div class="section-content">
                    <div class="action-grid">
                        <a href="@Url.Action("Index", "Banks")" class="action-card"><div class="action-icon">🏦</div><span>Banks</span></a>
                        <a href="@Url.Action("Index", "BankBranches")" class="action-card"><div class="action-icon">🏢</div><span>Bank Branches</span></a>
                        <a href="@Url.Action("Index", "EmployeeBankAccounts")" class="action-card"><div class="action-icon">💳</div><span>Employee Accounts</span></a>
                        <a href="@Url.Action("Index", "PayrollRecords")" class="action-card"><div class="action-icon">💸</div><span>Payment Records</span></a>
                        <a href="@Url.Action("Index", "TaxTypes")" class="action-card"><div class="action-icon">📊</div><span>Tax Types</span></a>
                        <a href="@Url.Action("Index", "LoanCategories")" class="action-card"><div class="action-icon">🏦</div><span>Loan Categories</span></a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 dashboard-section">
                <div class="section-header"><h2>⚙️ SYSTEM ADMINISTRATION</h2></div>
                <div class="section-content">
                    <div class="action-grid">
                        <a href="@Url.Action("Index", "SystemConfigurations")" class="action-card"><div class="action-icon">⚙️</div><span>System Settings</span></a>
                        <a href="@Url.Action("Index", "Departments")" class="action-card"><div class="action-icon">🏢</div><span>Departments</span></a>
                        <a href="@Url.Action("Index", "Wards")" class="action-card"><div class="action-icon">🏥</div><span>Wards</span></a>
                        <a href="@Url.Action("About", "Home")" class="action-card"><div class="action-icon">ℹ️</div><span>System Info</span></a>
                        <a href="@Url.Action("Contact", "Home")" class="action-card"><div class="action-icon">📞</div><span>Support</span></a>
                        <a href="@Url.Action("Index", "Specializations")" class="action-card"><div class="action-icon">🎯</div><span>Specializations</span></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions Panel -->
        <div class="quick-actions-panel">
            <div class="section-header"><h2>🚀 QUICK ACTIONS</h2></div>
            <div class="quick-actions-grid">
                <a href="@Url.Action("Create", "Employees")" class="quick-action-btn btn-primary"><span>➕ Add New Employee</span></a>
                <a href="@Url.Action("Create", "AttendanceRecords")" class="quick-action-btn btn-success"><span>📝 Record Attendance</span></a>
                <a href="@Url.Action("Index", "PayrollRecords")" class="quick-action-btn btn-info"><span>💰 Process Payroll</span></a>
                <a href="@Url.Action("Create", "Leaves")" class="quick-action-btn btn-warning"><span>📅 Manage Leaves</span></a>
                <a href="@Url.Action("Index", "Reports")" class="quick-action-btn btn-secondary"><span>📈 Generate Reports</span></a>
                <a href="@Url.Action("Contact", "Home")" class="quick-action-btn btn-dark"><span>📞 Support</span></a>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        margin: 0;
        padding: 0;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 0;
            padding-left: 0;
        }

    .admin-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.8rem;
        background: rgba(0,0,0,0.2);
        padding: 20px;
        border-radius: 10px;
    }

    .stats-overview {
        padding: 40px 20px;
        background: #ffffff;
        border-bottom: 4px solid #006400;
    }

    .stat-card {
        padding: 20px;
        text-align: center;
        border-right: 2px solid #f0f0f0;
    }

    .stat-content {
        padding: 30px 20px;
        background: #f8f9fa;
        border-radius: 15px;
        border: 3px solid #006400;
        transition: all 0.3s ease;
    }

        .stat-content:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,100,0,0.2);
        }

    .stat-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    .dashboard-grid {
        padding: 40px 20px;
    }

    .dashboard-section {
        padding: 20px;
    }

    .section-content {
        padding: 40px;
    }

    .action-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
        height: 100%;
    }

    .action-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: #f8f9fa;
        border: 3px solid #006400;
        border-radius: 15px;
        text-decoration: none;
        color: #000000;
        transition: all 0.3s ease;
        text-align: center;
        min-height: 200px;
    }

        .action-card:hover {
            background: #006400;
            color: #ffffff;
            transform: translateY(-5px);
            text-decoration: none;
        }

    .quick-actions-panel {
        padding: 40px 20px;
        background: #ffffff;
        margin-top: 40px;
        border-top: 4px solid #000000;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
        margin-top: 30px;
    }

    .quick-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        border: none;
        border-radius: 15px;
        font-size: 2rem;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s ease;
        text-align: center;
        min-height: 120px;
    }

    @@media (max-width: 768px) {
        body {
            font-size: 24px;
        }

        .hospital-name {
            font-size: 2.5rem;
        }

        .hospital-subtitle {
            font-size: 1.5rem;
        }

        .admin-info {
            flex-direction: column;
            gap: 15px;
            font-size: 1.4rem;
        }

        .action-grid {
            grid-template-columns: 1fr;
        }

        .quick-actions-grid {
            grid-template-columns: 1fr;
        }
    }
</style>