@{
    ViewBag.Title = "Contact Support";
}

<div class="page-header">
    <h1>@ViewBag.Title</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <h3>Get in Touch</h3>
        <p class="lead">
            We're here to help with any questions or support you may need regarding the HRM System.
        </p>

        <div class="well">
            <h4>Technical Support</h4>
            <p>
                For technical assistance, system issues, or bug reports, please contact our support team:
            </p>
            <p>
                <strong>Email:</strong> <a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a><br>
                <strong>Response Time:</strong> Within 24 hours during business days
            </p>
        </div>

        <div class="well">
            <h4>System Administrator</h4>
            <p>
                For hospital-specific queries, user access, or local system configuration:
            </p>
            <p>
                <strong>Contact:</strong> Please reach out to your local system administrator<br>
                <strong>Location:</strong> 
            </p>
        </div>

        <h4>Frequently Asked Questions</h4>
        <div class="panel-group" id="faqAccordion">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        <a data-toggle="collapse" data-parent="#faqAccordion" href="#faq1">
                            How do I reset my password?
                        </a>
                    </h4>
                </div>
                <div id="faq1" class="panel-collapse collapse">
                    <div class="panel-body">
                        Contact your system administrator or send a password reset request to our support team.
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        <a data-toggle="collapse" data-parent="#faqAccordion" href="#faq2">
                            Where can I find user manuals?
                        </a>
                    </h4>
                </div>
                <div id="faq2" class="panel-collapse collapse">
                    <div class="panel-body">
                        User manuals and documentation are available through your system administrator or can be requested from support.
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        <a data-toggle="collapse" data-parent="#faqAccordion" href="#faq3">
                            How do I report a system bug?
                        </a>
                    </h4>
                </div>
                <div id="faq3" class="panel-collapse collapse">
                    <div class="panel-body">
                        Please email detailed information about the issue to <a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a> including steps to reproduce the problem.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title">Developer Information</h3>
            </div>
            <div class="panel-body">
                <h4>eHealthcare Solutions</h4>
                <p>Specialized Healthcare Software Solutions</p>

                <address>
                    <strong>Website:</strong><br>
                    <a href="https://ehealthcare.lk" target="_blank">https://ehealthcare.lk</a>
                </address>

                <address>
                    <strong>Support Email:</strong><br>
                    <a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a>
                </address>

                <address>
                    <strong>Services:</strong><br>
                    Healthcare Software Development<br>
                    HRM Systems<br>
                    Hospital Management Systems<br>
                    Custom Healthcare Solutions
                </address>
            </div>
        </div>

        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title">Hospital Information</h3>
            </div>
            <div class="panel-body">
                <h4></h4>
                <p>This HRM System is specifically designed and implemented for:</p>
                <p>
                    <strong></strong><br>
                    Ensuring efficient human resources management<br>
                    and streamlined hospital operations.
                </p>
            </div>
        </div>

        <div class="alert alert-warning">
            <h4>Emergency Support</h4>
            <p>
                For critical system outages affecting hospital operations,
                please contact both your local system administrator and our support team immediately.
            </p>
        </div>
    </div>
</div>

<style>
    .well {
        background-color: #f8f9fa;
        border-left: 4px solid #3498db;
    }

    .panel-primary .panel-heading {
        background-color: #2c3e50;
        border-color: #2c3e50;
    }
</style>