        padding: 40px 30px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        background: white;
    }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .panel-tools {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        background-color: #2c3e50;
        color: white;
    }

    .btn-group .btn {
        margin: 2px;
        border-radius: 6px;
    }

    .badge {
        font-size: 0.8em;
        padding: 6px 12px;
    }

    .alert {
