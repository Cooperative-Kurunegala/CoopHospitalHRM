@model IEnumerable<HR_Application_CO_OP_HOS.Models.AttendanceData>

@{
    ViewBag.Title = "Attendance Data";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-clock-o"></i> Attendance Data Management</h1>
            <p class="lead">Manage employee attendance records and time tracking</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-block" })
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-info btn-block" onclick="exportToExcel()">
                                <i class="fa fa-download"></i> Export to Excel
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-warning btn-block" onclick="applyFilters()">
                                <i class="fa fa-filter"></i> Apply Filters
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-secondary btn-block" onclick="clearFilters()">
                                <i class="fa fa-refresh"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filters</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>EPF Number</label>
                                <input type="number" id="filterEPF" class="form-control" placeholder="Filter by EPF">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Date From</label>
                                <input type="date" id="filterDateFrom" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Date To</label>
                                <input type="date" id="filterDateTo" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Records Per Page</label>
                                <select id="pageSize" class="form-control">
                                    <option value="10">10</option>
                                    <option value="25" selected>25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-table"></i> Attendance Records</h3>
                    <div class="panel-tools">
                        <span class="badge badge-primary" id="recordCount">@Model.Count() records</span>
                    </div>
                </div>
                <div class="panel-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="attendanceTable">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.EPF)</th>
                                        <th>@Html.DisplayNameFor(model => model.Date)</th>
                                        <th>@Html.DisplayNameFor(model => model.InTime)</th>
                                        <th>@Html.DisplayNameFor(model => model.OutTime)</th>
                                        <th>Work Hours</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge badge-info">@Html.DisplayFor(modelItem => item.EPF)</span>
                                            </td>
                                            <td>
                                                @if (item.Date.HasValue)
                                                {
                                                    @item.Date.Value.ToString("MMM dd, yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.InTime.HasValue)
                                                {
                                                    @item.InTime.Value.ToString("hh:mm tt")
                                                }
                                                else
                                                {
                                                    <span class="text-warning">No In Time</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.OutTime.HasValue)
                                                {
                                                    @item.OutTime.Value.ToString("hh:mm tt")
                                                }
                                                else
                                                {
                                                    <span class="text-warning">No Out Time</span>
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    var workHours = CalculateWorkHours(item.InTime, item.OutTime);
                                                }
                                                <span class="badge @(workHours >= TimeSpan.FromHours(8) ? "badge-success" : "badge-warning")">
                                                    @workHours.ToString(@"hh\:mm")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="row no-gutters mt-3">
                            <div class="col-12">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center" id="pagination">
                                        <!-- Pagination will be generated by JavaScript -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fa fa-exclamation-triangle fa-3x"></i>
                            <h4>No Attendance Records Found</h4>
                            <p>There are no attendance records in the system. @Html.ActionLink("Create a new record", "Create") to get started.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Calculate work hours function
        function calculateWorkHours(inTime, outTime) {
            if (!inTime || !outTime) return 'N/A';

            const inDate = new Date(inTime);
            const outDate = new Date(outTime);
            const diffMs = outDate - inDate;
            const diffHrs = Math.floor(diffMs / (1000 * 60 * 60));
            const diffMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

            return `${diffHrs.toString().padStart(2, '0')}:${diffMins.toString().padStart(2, '0')}`;
        }

        // Filter functionality
        function applyFilters() {
            const epfFilter = document.getElementById('filterEPF').value;
            const dateFrom = document.getElementById('filterDateFrom').value;
            const dateTo = document.getElementById('filterDateTo').value;

            // Simple client-side filtering
            const rows = document.querySelectorAll('#attendanceTable tbody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                let showRow = true;
                const epf = row.cells[0].textContent.trim();
                const date = row.cells[1].textContent.trim();

                if (epfFilter && !epf.includes(epfFilter)) {
                    showRow = false;
                }

                // Add date filtering logic here

                row.style.display = showRow ? '' : 'none';
                if (showRow) visibleCount++;
            });

            document.getElementById('recordCount').textContent = visibleCount + ' records';
        }

        function clearFilters() {
            document.getElementById('filterEPF').value = '';
            document.getElementById('filterDateFrom').value = '';
            document.getElementById('filterDateTo').value = '';
            applyFilters();
        }

        function exportToExcel() {
            // Simple CSV export
            const rows = document.querySelectorAll('#attendanceTable tr');
            let csv = [];

            for (let i = 0; i < rows.length; i++) {
                let row = [], cols = rows[i].querySelectorAll('td, th');

                for (let j = 0; j < cols.length - 1; j++) { // Exclude actions column
                    row.push(cols[j].innerText);
                }

                csv.push(row.join(','));
            }

            // Download CSV file
            const csvContent = "data:text/csv;charset=utf-8," + csv.join('\n');
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "attendance_data.csv");
            document.body.appendChild(link);
            link.click();
        }

        // Initialize filters
        document.addEventListener('DOMContentLoaded', function() {
            applyFilters();
        });
    </script>
}

@functions {
    public TimeSpan CalculateWorkHours(DateTime? inTime, DateTime? outTime)
    {
        if (!inTime.HasValue || !outTime.HasValue)
            return TimeSpan.Zero;

        return outTime.Value - inTime.Value;
    }
}

<style>
