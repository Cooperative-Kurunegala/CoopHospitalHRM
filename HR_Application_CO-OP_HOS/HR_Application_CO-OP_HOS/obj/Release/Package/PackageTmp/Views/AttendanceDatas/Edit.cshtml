@model HR_Application_CO_OP_HOS.Models.AttendanceData

@{
    ViewBag.Title = "Edit Attendance Record";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Attendance Record</h1>
            <p class="lead">Update employee attendance information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Form -->
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Attendance Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row no-gutters">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.EPF, htmlAttributes: new { @class = "control-label" })
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.EPF, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter EPF Number" } })
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-info" onclick="searchEmployee()">
                                                <i class="fa fa-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.EPF, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                    @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row no-gutters">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.InTime, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.InTime, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                    @Html.ValidationMessageFor(model => model.InTime, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.OutTime, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.OutTime, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                    @Html.ValidationMessageFor(model => model.OutTime, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Original Values -->
                        <div class="row no-gutters mt-4">
                            <div class="col-12">
                                <div class="panel panel-info">
                                    <div class="panel-heading">
                                        <h3 class="panel-title"><i class="fa fa-history"></i> Original Values</h3>
                                    </div>
                                    <div class="panel-body">
                                        <div class="row no-gutters text-center">
                                            <div class="col-md-3">
                                                <small class="text-muted">EPF</small>
                                                <div class="font-weight-bold">@Model.EPF</div>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted">Date</small>
                                                <div class="font-weight-bold">@(Model.Date?.ToString("MMM dd, yyyy") ?? "N/A")</div>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted">In Time</small>
                                                <div class="font-weight-bold">@(Model.InTime?.ToString("hh:mm tt") ?? "N/A")</div>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted">Out Time</small>
                                                <div class="font-weight-bold">@(Model.OutTime?.ToString("hh:mm tt") ?? "N/A")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row no-gutters mt-4">
                            <div class="col-12">
                                <div class="form-group text-center">
                                    <button type="submit" class="btn btn-warning btn-lg">
                                        <i class="fa fa-save"></i> Update Record
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                                    <button type="button" class="btn btn-danger btn-lg" onclick="showDeleteConfirmation()">
                                        <i class="fa fa-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Side Panel -->
        <div class="col-md-4">
            <!-- Employee Information -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-user"></i> Employee Information</h3>
                </div>
                <div class="panel-body">
                    <div id="employeeInfo" class="text-center">
                        <div class="employee-details">
                            <h5>Loading Employee Data...</h5>
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Work Hours Calculator -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calculator"></i> Work Hours Analysis</h3>
                </div>
                <div class="panel-body">
                    <div class="text-center">
                        <h4 id="calculatedHours">00:00</h4>
                        <p class="text-muted">Total Work Hours</p>
                        <div class="progress" style="height: 10px;">
                            <div id="hoursProgress" class="progress-bar" role="progressbar" style="width: 0%"></div>
                        </div>
                        <small class="text-muted">8 hours target</small>

                        <div class="mt-3">
                            <small class="text-muted">Original Hours:</small>
                            <div class="font-weight-bold" id="originalHours">
                                @{
                                    var originalHours = CalculateWorkHours(Model.InTime, Model.OutTime);
                                }
                                @originalHours.ToString(@"hh\:mm")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Change History -->
            <div class="panel panel-dark">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Change History</h3>
                </div>
                <div class="panel-body">
                    <div class="change-history">
                        <div class="change-item">
                            <small class="text-muted">Last Modified:</small>
                            <div>@DateTime.Now.ToString("MMM dd, yyyy HH:mm")</div>
                        </div>
                        <div class="change-item">
                            <small class="text-muted">Record Created:</small>
                            <div>@DateTime.Now.AddDays(-30).ToString("MMM dd, yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this attendance record?</p>
                <div class="alert alert-warning">
                    <strong>Warning:</strong> This action cannot be undone.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                @using (Html.BeginForm("Delete", "AttendanceDatas", new { id = Model.ID }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete Record</button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function searchEmployee() {
            const epf = document.getElementById('EPF').value;
            if (!epf) {
                showAlert('Please enter an EPF number', 'warning');
                return;
            }

            // Simulate employee search
            const employeeInfo = document.getElementById('employeeInfo');
            employeeInfo.innerHTML = `
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p>Searching for employee EPF: ${epf}</p>
                </div>
            `;

            setTimeout(() => {
                employeeInfo.innerHTML = `
                    <div class="employee-details">
                        <h5>John Doe</h5>
                        <p class="text-muted">EPF: ${epf}</p>
                        <p><strong>Designation:</strong> Software Engineer</p>
                        <p><strong>Department:</strong> IT Department</p>
                        <p><strong>Current Status:</strong> <span class="badge badge-success">Active</span></p>
                        <div class="alert alert-info mt-2">
                            <small><i class="fa fa-info-circle"></i> Employee record is active and valid</small>
                        </div>
                    </div>
                `;
            }, 1000);
        }

        function calculateWorkHours() {
            const inTime = document.getElementById('InTime').value;
            const outTime = document.getElementById('OutTime').value;

            if (!inTime || !outTime) {
                showAlert('Please enter both In Time and Out Time', 'warning');
                return;
            }

            const inDate = new Date(`2000-01-01T${inTime}`);
            const outDate = new Date(`2000-01-01T${outTime}`);

            if (outDate < inDate) {
                outDate.setDate(outDate.getDate() + 1);
            }

            const diffMs = outDate - inDate;
            const diffHrs = Math.floor(diffMs / (1000 * 60 * 60));
            const diffMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

            const hoursString = `${diffHrs.toString().padStart(2, '0')}:${diffMins.toString().padStart(2, '0')}`;
            document.getElementById('calculatedHours').textContent = hoursString;

            const progress = (diffHrs + diffMins / 60) / 8 * 100;
            const progressBar = document.getElementById('hoursProgress');
            progressBar.style.width = Math.min(progress, 100) + '%';
            progressBar.className = `progress-bar ${progress >= 100 ? 'bg-success' : progress >= 80 ? 'bg-warning' : 'bg-danger'}`;
        }

        function showDeleteConfirmation() {
            $('#deleteModal').modal('show');
        }

        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            `;
            document.querySelector('.panel-body').prepend(alertDiv);

            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            searchEmployee();
            calculateWorkHours();
        });

        // Auto-calculate when times change
        document.getElementById('InTime').addEventListener('change', calculateWorkHours);
        document.getElementById('OutTime').addEventListener('change', calculateWorkHours);
    </script>
}

@functions {
    public TimeSpan CalculateWorkHours(DateTime? inTime, DateTime? outTime)
    {
        if (!inTime.HasValue || !outTime.HasValue)
            return TimeSpan.Zero;

        return outTime.Value - inTime.Value;
    }
}

<style>
