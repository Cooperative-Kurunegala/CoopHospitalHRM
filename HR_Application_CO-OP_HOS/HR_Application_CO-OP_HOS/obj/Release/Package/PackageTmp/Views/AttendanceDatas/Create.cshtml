@model HR_Application_CO_OP_HOS.Models.AttendanceData

@{
    ViewBag.Title = "Create Attendance Record";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create Attendance Record</h1>
            <p class="lead">Add new employee attendance entry</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Form -->
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Attendance Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="row no-gutters">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.EPF, htmlAttributes: new { @class = "control-label" })
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.EPF, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter EPF Number" } })
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-info" onclick="searchEmployee()">
                                                <i class="fa fa-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.EPF, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                    @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row no-gutters">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.InTime, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.InTime, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                    @Html.ValidationMessageFor(model => model.InTime, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.OutTime, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.OutTime, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                                    @Html.ValidationMessageFor(model => model.OutTime, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row no-gutters mt-4">
                            <div class="col-12">
                                <div class="form-group text-center">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fa fa-save"></i> Create Record
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    <button type="button" class="btn btn-info btn-lg" onclick="calculateWorkHours()">
                                        <i class="fa fa-calculator"></i> Calculate Hours
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Side Panel -->
        <div class="col-md-4">
            <!-- Employee Information -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-user"></i> Employee Information</h3>
                </div>
                <div class="panel-body">
                    <div id="employeeInfo" class="text-center text-muted">
                        <i class="fa fa-user fa-3x"></i>
                        <p>Enter EPF number to view employee details</p>
                    </div>
                </div>
            </div>

            <!-- Work Hours Calculator -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calculator"></i> Work Hours Calculator</h3>
                </div>
                <div class="panel-body">
                    <div class="text-center">
                        <h4 id="calculatedHours">00:00</h4>
                        <p class="text-muted">Total Work Hours</p>
                        <div class="progress" style="height: 10px;">
                            <div id="hoursProgress" class="progress-bar" role="progressbar" style="width: 0%"></div>
                        </div>
                        <small class="text-muted">8 hours target</small>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bolt"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <button class="btn btn-outline-primary btn-block mb-2" onclick="setCurrentTime('InTime')">
                        <i class="fa fa-clock-o"></i> Set Current In Time
                    </button>
                    <button class="btn btn-outline-primary btn-block mb-2" onclick="setCurrentTime('OutTime')">
                        <i class="fa fa-clock-o"></i> Set Current Out Time
                    </button>
                    <button class="btn btn-outline-secondary btn-block" onclick="clearForm()">
                        <i class="fa fa-eraser"></i> Clear Form
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function searchEmployee() {
            const epf = document.getElementById('EPF').value;
            if (!epf) {
                showAlert('Please enter an EPF number', 'warning');
                return;
            }

            // Simulate employee search - in real application, this would be an AJAX call
            const employeeInfo = document.getElementById('employeeInfo');
            employeeInfo.innerHTML = `
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p>Searching for employee EPF: ${epf}</p>
                </div>
            `;

            // Simulate API call delay
            setTimeout(() => {
                employeeInfo.innerHTML = `
                    <div class="employee-details">
                        <h5>John Doe</h5>
                        <p class="text-muted">EPF: ${epf}</p>
                        <p><strong>Designation:</strong> Software Engineer</p>
                        <p><strong>Department:</strong> IT</p>
                        <p><strong>Company:</strong> Main Branch</p>
                        <div class="alert alert-success mt-2">
                            <small>Employee found and active</small>
                        </div>
                    </div>
                `;
            }, 1000);
        }

        function calculateWorkHours() {
            const inTime = document.getElementById('InTime').value;
            const outTime = document.getElementById('OutTime').value;

            if (!inTime || !outTime) {
                showAlert('Please enter both In Time and Out Time', 'warning');
                return;
            }

            const inDate = new Date(`2000-01-01T${inTime}`);
            const outDate = new Date(`2000-01-01T${outTime}`);

            // Handle overnight shifts
            if (outDate < inDate) {
                outDate.setDate(outDate.getDate() + 1);
            }

            const diffMs = outDate - inDate;
            const diffHrs = Math.floor(diffMs / (1000 * 60 * 60));
            const diffMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

            const hoursString = `${diffHrs.toString().padStart(2, '0')}:${diffMins.toString().padStart(2, '0')}`;
            document.getElementById('calculatedHours').textContent = hoursString;

            // Update progress bar
            const progress = (diffHrs + diffMins / 60) / 8 * 100;
            const progressBar = document.getElementById('hoursProgress');
            progressBar.style.width = Math.min(progress, 100) + '%';
            progressBar.className = `progress-bar ${progress >= 100 ? 'bg-success' : progress >= 80 ? 'bg-warning' : 'bg-danger'}`;
        }

        function setCurrentTime(fieldId) {
            const now = new Date();
            const timeString = now.toTimeString().substring(0, 5);
            document.getElementById(fieldId).value = timeString;

            // Recalculate hours if both fields are filled
            if (document.getElementById('InTime').value && document.getElementById('OutTime').value) {
                calculateWorkHours();
            }
        }

        function clearForm() {
            if (confirm('Are you sure you want to clear all form data?')) {
                document.querySelector('form').reset();
                document.getElementById('employeeInfo').innerHTML = `
                    <div class="text-center text-muted">
                        <i class="fa fa-user fa-3x"></i>
                        <p>Enter EPF number to view employee details</p>
                    </div>
                `;
                document.getElementById('calculatedHours').textContent = '00:00';
                document.getElementById('hoursProgress').style.width = '0%';
            }
        }

        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            `;
            document.querySelector('.panel-body').prepend(alertDiv);

            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }

        // Auto-calculate when times change
        document.getElementById('InTime').addEventListener('change', calculateWorkHours);
        document.getElementById('OutTime').addEventListener('change', calculateWorkHours);
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        background: white;
    }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .control-label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #2c3e50;
    }

    .form-control {
        border-radius: 8px;
        border: 2px solid #e9ecef;
        padding: 12px 15px;
        font-size: 16px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
        margin: 0 5px;
    }

    .employee-details {
        text-align: left;
    }

    .progress {
        border-radius: 10px;
    }

    .progress-bar {
        border-radius: 10px;
        transition: width 0.5s ease;
    }

    .alert {
        border-radius: 8px;
        border: none;
    }
</style>