@model HR_Application_CO_OP_HOS.Models.RelatedPartyDefaultSalaryModifier

@{
    Layout = null;
    ViewBag.Title = "Details - Related Party Default Salary Modifier";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Details - Related Party Default Salary Modifier</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .header-section {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .header-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .details-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 30px;
            overflow: hidden;
        }

        .details-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 25px 30px;
            border-bottom: 1px solid #eee;
        }

            .details-header h4 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 600;
            }

        .details-body {
            padding: 30px;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .detail-card {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .detail-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 3px 15px rgba(0,0,0,0.1);
            }

            .detail-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 4px;
                height: 100%;
                background: #3498db;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.1rem;
            font-weight: 500;
            word-break: break-word;
        }

        .boolean-true {
            color: #27ae60;
            font-weight: 600;
        }

        .boolean-false {
            color: #e74c3c;
            font-weight: 600;
        }

        /* Foreign Key Section */
        .foreign-key-section {
            background: #e8f4fd;
            border: 1px solid #b3dcf9;
            border-radius: 8px;
            padding: 25px;
            margin: 25px 0;
        }

        .section-title {
            color: #2c3e50;
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .foreign-key-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        .foreign-key-card {
            background: white;
            border: 1px solid #d1ecf1;
            border-radius: 6px;
            padding: 15px;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 25px 30px;
            border-top: 1px solid #e9ecef;
            text-align: center;
        }

        .btn {
            padding: 12px 25px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1.1rem;
            margin: 0 8px;
            transition: all 0.3s ease;
            border: none;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
        }

            .btn-warning:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
            }

        .btn-default {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

            .btn-default:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Back Link */
        .back-link {
            text-align: center;
            margin-top: 20px;
        }

            .back-link a {
                color: #3498db;
                text-decoration: none;
                font-weight: 600;
                font-size: 1.1rem;
            }

                .back-link a:hover {
                    text-decoration: underline;
                }

        /* Status Indicators */
        .status-indicator {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-right: 8px;
        }

        .status-active {
            background: #27ae60;
        }

        .status-inactive {
            background: #e74c3c;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .header-title {
                font-size: 2rem;
            }

            .details-body {
                padding: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                text-align: center;
            }

            .btn {
                width: 100%;
                margin: 5px 0;
                display: block;
            }
        }

        /* Print Styles */
        @@media print {
            .header-section {
                background: #2c3e50 !important;
                -webkit-print-color-adjust: exact;
            }

            .action-buttons {
                display: none;
            }

            .back-link {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="fa fa-eye"></i> Related Party Default Salary Modifier Details
                </h1>
                <p class="header-subtitle">View comprehensive details of this salary modifier configuration</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="details-container">
                <div class="details-header">
                    <h4><i class="fa fa-info-circle"></i> Record Information</h4>
                </div>

                <div class="details-body">
                    <!-- Basic Details Grid -->
                    <div class="details-grid">
                        <!-- Core Information -->
                        <div class="detail-card">
                            <div class="detail-label">Order Index</div>
                            <div class="detail-value">@Html.DisplayFor(model => model.OrderIndex)</div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Is Enabled</div>
                            <div class="detail-value @(Model.IsEnabled == true ? "boolean-true" : "boolean-false")">
                                <span class="status-indicator @(Model.IsEnabled == true ? "status-active" : "status-inactive")"></span>
                                @(Model.IsEnabled == true ? "Enabled" : "Disabled")
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Created Date</div>
                            <div class="detail-value">@Html.DisplayFor(model => model.CreatedDate)</div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Created By</div>
                            <div class="detail-value">@Html.DisplayFor(model => model.CreatedBy)</div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Default Value</div>
                            <div class="detail-value">@Html.DisplayFor(model => model.DefaultValue)</div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Is Payee</div>
                            <div class="detail-value @(Model.IsPayee == true ? "boolean-true" : "boolean-false")">
                                @(Model.IsPayee == true ? "Yes" : "No")
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Is Removed</div>
                            <div class="detail-value @(Model.IsRemoved == true ? "boolean-true" : "boolean-false")">
                                @(Model.IsRemoved == true ? "Yes" : "No")
                            </div>
                        </div>

                        <!-- Record ID -->
                        <div class="detail-card">
                            <div class="detail-label">Record ID</div>
                            <div class="detail-value">@Html.DisplayFor(model => model.ID)</div>
                        </div>
                    </div>

                    <!-- Foreign Key Relationships Section -->
                    <div class="foreign-key-section">
                        <h5 class="section-title"><i class="fa fa-link"></i> Related Entities</h5>
                        <div class="foreign-key-grid">
                            <!-- Related Party Information -->
                            <div class="foreign-key-card">
                                <div class="detail-label">Related Party</div>
                                <div class="detail-value">
                                    <strong>@Html.DisplayFor(model => model.RelatedParty.RegistrationNumber)</strong><br />
                                    @Html.DisplayFor(model => model.RelatedParty.RelatedPartyName)<br />
                                    <small class="text-muted">ID: @Html.DisplayFor(model => model.RelatedPartyID)</small>
                                </div>
                            </div>

                            <!-- Salary Modifier Information -->
                            <div class="foreign-key-card">
                                <div class="detail-label">Salary Modifier</div>
                                <div class="detail-value">
                                    <strong>@Html.DisplayFor(model => model.SalaryModifier.SalaryModifierName)</strong><br />
                                    <small class="text-muted">ID: @Html.DisplayFor(model => model.SalaryModifierID)</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    <div class="additional-info">
                        <h5><i class="fa fa-list-alt"></i> Configuration Summary</h5>
                        <div class="summary-card" style="background: #f8f9fa; padding: 20px; border-radius: 8px; border-left: 4px solid #3498db;">
                            <p>
                                This configuration defines a default salary modifier for <strong>@Html.DisplayFor(model => model.RelatedParty.RelatedPartyName)</strong>
                                using the <strong>@Html.DisplayFor(model => model.SalaryModifier.SalaryModifierName)</strong> modifier with order index
                                <strong>@Html.DisplayFor(model => model.OrderIndex)</strong>.
                            </p>

                            @if (Model.IsEnabled == true)
                            {
                                <p class="boolean-true"><i class="fa fa-check-circle"></i> This modifier is currently active and will be applied to salary calculations.</p>
                            }
                            else
                            {
                                <p class="boolean-false"><i class="fa fa-times-circle"></i> This modifier is currently inactive and will not affect salary calculations.</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="action-buttons">
                    @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning" })
                    @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger" })
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
                </div>
            </div>

            <div class="back-link">
                @Html.ActionLink("← Back to List", "Index")
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Add print functionality
            $('.btn-default').first().after('<button class="btn btn-info" onclick="window.print()"><i class="fa fa-print"></i> Print</button>');

            // Add copy to clipboard functionality for important fields
            $('.detail-value').click(function () {
                var text = $(this).text().trim();
                if (text && text.length > 0) {
                    navigator.clipboard.writeText(text).then(function () {
                        var $original = $(this);
                        var originalText = $original.text();
                        $original.text('Copied!');
                        setTimeout(function () {
                            $original.text(originalText);
                        }, 2000);
                    }.bind(this));
                }
            });

            // Enhanced hover effects
            $('.detail-card').hover(
                function () {
                    $(this).css('border-color', '#3498db');
                },
                function () {
                    $(this).css('border-color', '#e9ecef');
                }
            );
        });
    </script>
</body>
</html>