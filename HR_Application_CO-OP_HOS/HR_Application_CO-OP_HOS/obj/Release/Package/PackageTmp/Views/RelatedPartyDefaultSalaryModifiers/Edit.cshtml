@model HR_Application_CO_OP_HOS.Models.RelatedPartyDefaultSalaryModifier

@{
    Layout = null;
    ViewBag.Title = "Edit Related Party Default Salary Modifier";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit - Related Party Default Salary Modifier</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .header-section {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .header-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .edit-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 30px;
            overflow: hidden;
        }

        .edit-header {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
            padding: 25px 30px;
            border-bottom: 1px solid #eee;
        }

            .edit-header h4 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 600;
            }

        .edit-body {
            padding: 30px;
        }

        /* Two Column Layout */
        .form-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .form-section {
            margin-bottom: 25px;
        }

        .section-title {
            color: #2c3e50;
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f39c12;
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 25px;
        }

        .control-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #f39c12;
                box-shadow: 0 0 0 0.2rem rgba(243, 156, 18, 0.25);
            }

        .checkbox {
            margin-top: 8px;
        }

            .checkbox label {
                font-weight: 500;
                color: #34495e;
            }

        /* Foreign Key Helper */
        .foreign-key-helper {
            background: #fef9e7;
            border: 1px solid #f7dc6f;
            border-radius: 8px;
            padding: 15px;
            margin-top: 10px;
            display: none;
            max-height: 200px;
            overflow-y: auto;
        }

        .helper-title {
            font-weight: 600;
            color: #b7950b;
            margin-bottom: 10px;
            font-size: 1rem;
        }

        .helper-item {
            padding: 8px 12px;
            border-bottom: 1px solid #f7dc6f;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .helper-item:hover {
                background-color: #fcf3cf;
            }

            .helper-item:last-child {
                border-bottom: none;
            }

        /* Current Values Display */
        .current-values {
            background: #e8f6f3;
            border: 1px solid #a3e4d7;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .current-value-item {
            margin-bottom: 10px;
            padding: 8px 12px;
            background: white;
            border-radius: 4px;
            border-left: 4px solid #1abc9c;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 25px 30px;
            border-top: 1px solid #e9ecef;
            text-align: right;
            grid-column: 1 / -1;
        }

        .btn {
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1.1rem;
            margin-left: 10px;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
        }

            .btn-warning:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
            }

        .btn-default {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

            .btn-default:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Back Link */
        .back-link {
            text-align: center;
            margin-top: 20px;
        }

            .back-link a {
                color: #3498db;
                text-decoration: none;
                font-weight: 600;
                font-size: 1.1rem;
            }

                .back-link a:hover {
                    text-decoration: underline;
                }

        /* Responsive Design */
        @@media (max-width: 992px) {
            .form-columns {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .header-title {
                font-size: 2rem;
            }

            .edit-body {
                padding: 20px;
            }

            .action-buttons {
                text-align: center;
            }

            .btn {
                width: 100%;
                margin: 5px 0;
            }
        }

        /* Validation Styles */
        .text-danger {
            font-size: 0.9rem;
            margin-top: 5px;
            font-weight: 500;
        }

        .field-validation-error {
            color: #e74c3c;
        }

        .input-validation-error {
            border-color: #e74c3c;
        }

        .validation-summary-errors {
            background: #fadbd8;
            border: 1px solid #e74c3c;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 25px;
        }

        /* Loading State */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="fa fa-edit"></i> Edit Related Party Default Salary Modifier
                </h1>
                <p class="header-subtitle">Update existing salary modifier configuration</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="edit-container">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)

                    <div class="edit-header">
                        <h4><i class="fa fa-pencil-square"></i> Edit Salary Modifier Configuration</h4>
                    </div>

                    <div class="edit-body">
                        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                        <!-- Current Values Display -->
                        <div class="current-values">
                            <h5><i class="fa fa-info-circle"></i> Current Configuration</h5>
                            <div class="current-value-item">
                                <strong>Related Party:</strong> @Html.DisplayFor(model => model.RelatedParty.RegistrationNumber) - @Html.DisplayFor(model => model.RelatedParty.RelatedPartyName)
                            </div>
                            <div class="current-value-item">
                                <strong>Salary Modifier:</strong> @Html.DisplayFor(model => model.SalaryModifier.SalaryModifierName)
                            </div>
                            <div class="current-value-item">
                                <strong>Status:</strong> <span class="@(Model.IsEnabled == true ? "boolean-true" : "boolean-false")">@(Model.IsEnabled == true ? "Active" : "Inactive")</span>
                            </div>
                        </div>

                        <div class="form-columns">
                            <!-- Left Column - Core Information -->
                            <div class="form-section">
                                <h5 class="section-title"><i class="fa fa-cog"></i> Core Configuration</h5>

                                <!-- Related Party Selection -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartyID, "Related Party", htmlAttributes: new { @class = "control-label" })
                                    <div>
                                        @Html.DropDownList("RelatedPartyID", null, htmlAttributes: new { @class = "form-control foreign-key-select", data_entity = "RelatedParty" })
                                        @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="foreign-key-helper" id="RelatedPartyHelper">
                                        <div class="helper-title">Available Related Parties</div>
                                        <div class="helper-content">
                                            <!-- Will be populated by JavaScript -->
                                        </div>
                                    </div>
                                </div>

                                <!-- Salary Modifier Selection -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.SalaryModifierID, "Salary Modifier", htmlAttributes: new { @class = "control-label" })
                                    <div>
                                        @Html.DropDownList("SalaryModifierID", null, htmlAttributes: new { @class = "form-control foreign-key-select", data_entity = "SalaryModifier" })
                                        @Html.ValidationMessageFor(model => model.SalaryModifierID, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="foreign-key-helper" id="SalaryModifierHelper">
                                        <div class="helper-title">Available Salary Modifiers</div>
                                        <div class="helper-content">
                                            <!-- Will be populated by JavaScript -->
                                        </div>
                                    </div>
                                </div>

                                <!-- Order Index -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.OrderIndex, htmlAttributes: new { @class = "control-label" })
                                    <div>
                                        @Html.EditorFor(model => model.OrderIndex, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter order index" } })
                                        @Html.ValidationMessageFor(model => model.OrderIndex, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <!-- Default Value -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.DefaultValue, htmlAttributes: new { @class = "control-label" })
                                    <div>
                                        @Html.EditorFor(model => model.DefaultValue, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter default value" } })
                                        @Html.ValidationMessageFor(model => model.DefaultValue, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column - Status & Dates -->
                            <div class="form-section">
                                <h5 class="section-title"><i class="fa fa-toggle-on"></i> Status & Settings</h5>

                                <!-- Is Enabled -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.IsEnabled, htmlAttributes: new { @class = "control-label" })
                                    <div class="checkbox">
                                        <label>
                                            @Html.EditorFor(model => model.IsEnabled)
                                            Enable this salary modifier
                                        </label>
                                        @Html.ValidationMessageFor(model => model.IsEnabled, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <!-- Is Payee -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.IsPayee, htmlAttributes: new { @class = "control-label" })
                                    <div class="checkbox">
                                        <label>
                                            @Html.EditorFor(model => model.IsPayee)
                                            This is a payee modifier
                                        </label>
                                        @Html.ValidationMessageFor(model => model.IsPayee, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <!-- Is Removed -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.IsRemoved, htmlAttributes: new { @class = "control-label" })
                                    <div class="checkbox">
                                        <label>
                                            @Html.EditorFor(model => model.IsRemoved)
                                            Mark as removed
                                        </label>
                                        @Html.ValidationMessageFor(model => model.IsRemoved, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <!-- Created Date -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CreatedDate, htmlAttributes: new { @class = "control-label" })
                                    <div>
                                        @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <!-- Created By -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label" })
                                    <div>
                                        @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter creator ID" } })
                                        @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="action-buttons">
                                <button type="submit" class="btn btn-warning">
                                    <i class="fa fa-save"></i> Save Changes
                                </button>
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                                @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info" })
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="back-link">
                @Html.ActionLink("← Back to List", "Index")
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Foreign key helper functionality
            $('.foreign-key-select').focus(function () {
                var entity = $(this).data('entity');
                var helperId = entity + 'Helper';
                $('#' + helperId).slideDown();
            }).blur(function () {
                setTimeout(function () {
                    $('.foreign-key-helper').slideUp();
                }, 200);
            });

            // Form submission handling
            $('form').submit(function () {
                var $form = $(this);
                var $submitBtn = $form.find('button[type="submit"]');

                if ($form.valid()) {
                    $submitBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');
                    $form.addClass('loading');
                }
            });

            // Real-time validation
            $('input, select').on('blur', function () {
                $(this).valid();
            });

            // Enhanced user experience
            $('input[type="checkbox"]').parent().addClass('checkbox-styled');

            // Auto-save draft functionality
            let autoSaveTimer;
            $('input, select').on('change', function () {
                clearTimeout(autoSaveTimer);
                autoSaveTimer = setTimeout(function () {
                    console.log('Form changes detected - ready to save');
                }, 2000);
            });

            // Confirmation for navigation away from page with unsaved changes
            let formChanged = false;
            $('input, select, textarea').on('change input', function () {
                formChanged = true;
            });

            $('a').click(function (e) {
                if (formChanged) {
                    if (!confirm('You have unsaved changes. Are you sure you want to leave this page?')) {
                        e.preventDefault();
                    }
                }
            });
        });

        // Error handling for form submission
        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            alert('An error occurred while saving: ' + thrownError);
            $('form').removeClass('loading');
            $('button[type="submit"]').prop('disabled', false).html('<i class="fa fa-save"></i> Save Changes');
        });
    </script>
</body>
</html>