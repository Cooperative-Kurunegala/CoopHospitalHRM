@model HR_Application_CO_OP_HOS.Models.RelatedPartyDefaultSalaryModifier

@{
    Layout = null;
    ViewBag.Title = "Delete Related Party Default Salary Modifier";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete - Related Party Default Salary Modifier</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .header-section {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .header-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .delete-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 30px;
            overflow: hidden;
        }

        .delete-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 25px 30px;
            border-bottom: 1px solid #eee;
        }

            .delete-header h3 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 600;
            }

        .delete-body {
            padding: 30px;
        }

        .warning-section {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .warning-icon {
            color: #f39c12;
            font-size: 2rem;
            margin-right: 15px;
        }

        .warning-text {
            color: #856404;
            font-size: 1.2rem;
            font-weight: 600;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .detail-card {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            transition: all 0.3s ease;
        }

            .detail-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.1rem;
            font-weight: 500;
        }

        .boolean-true {
            color: #27ae60;
            font-weight: 600;
        }

        .boolean-false {
            color: #e74c3c;
            font-weight: 600;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 25px 30px;
            border-top: 1px solid #e9ecef;
            text-align: center;
        }

        .btn {
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1.1rem;
            margin: 0 10px;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
            }

        .btn-default {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

            .btn-default:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Back Link */
        .back-link {
            text-align: center;
            margin-top: 20px;
        }

            .back-link a {
                color: #3498db;
                text-decoration: none;
                font-weight: 600;
                font-size: 1.1rem;
            }

                .back-link a:hover {
                    text-decoration: underline;
                }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .header-title {
                font-size: 2rem;
            }

            .delete-body {
                padding: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                text-align: center;
            }

            .btn {
                width: 100%;
                margin: 5px 0;
            }
        }

        /* Loading State */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="fa fa-trash-o"></i> Delete Related Party Default Salary Modifier
                </h1>
                <p class="header-subtitle">Permanently remove this salary modifier configuration</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="delete-container">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="delete-header">
                        <h3><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                    </div>

                    <div class="delete-body">
                        <!-- Warning Section -->
                        <div class="warning-section d-flex align-items-center">
                            <i class="fa fa-warning warning-icon"></i>
                            <div class="warning-text">
                                Are you sure you want to delete this record? This action cannot be undone.
                            </div>
                        </div>

                        <!-- Details Grid -->
                        <div class="details-grid">
                            <!-- Basic Information -->
                            <div class="detail-card">
                                <div class="detail-label">Order Index</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.OrderIndex)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Is Enabled</div>
                                <div class="detail-value @(Model.IsEnabled == true ? "boolean-true" : "boolean-false")">
                                    @(Model.IsEnabled == true? "Yes" : "No")
                                </div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Created Date</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.CreatedDate)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Created By</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.CreatedBy)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Default Value</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.DefaultValue)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Is Payee</div>
                                <div class="detail-value @(Model.IsPayee == true ? "boolean-true" : "boolean-false")">
                                    @(Model.IsPayee == true ? "Yes" : "No")
                                </div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Is Removed</div>
                                <div class="detail-value @(Model.IsRemoved == true ? "boolean-true" : "boolean-false")">
                                    @(Model.IsRemoved == true ? "Yes" : "No")
                                </div>
                            </div>

                            <!-- Foreign Key Relationships -->
                            <div class="detail-card">
                                <div class="detail-label">Related Party</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.RelatedParty.RegistrationNumber)</div>
                            </div>

                            <div class="detail-card">
                                <div class="detail-label">Salary Modifier</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.SalaryModifier.SalaryModifierName)</div>
                            </div>
                        </div>

                        <!-- Additional Information -->
                        <div class="additional-info">
                            <h5><i class="fa fa-info-circle"></i> Additional Information</h5>
                            <p>This record is linked to the following entities:</p>
                            <ul>
                                <li><strong>Related Party:</strong> @Html.DisplayFor(model => model.RelatedParty.RegistrationNumber) - @Html.DisplayFor(model => model.RelatedParty.RelatedPartyName)</li>
                                <li><strong>Salary Modifier:</strong> @Html.DisplayFor(model => model.SalaryModifier.SalaryModifierName)</li>
                            </ul>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button type="submit" class="btn btn-danger" id="deleteButton">
                            <i class="fa fa-trash"></i> Confirm Delete
                        </button>
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                    </div>
                }
            </div>

            <div class="back-link">
                @Html.ActionLink("← Back to List", "Index")
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")

    <script>
        $(document).ready(function () {
            // Delete confirmation with additional warning
            $('#deleteButton').click(function (e) {
                e.preventDefault();

                if (confirm('⚠️ WARNING: This action is irreversible!\n\nAre you absolutely sure you want to delete this record?')) {
                    var $form = $(this).closest('form');
                    var $button = $(this);

                    $button.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Deleting...');
                    $form.addClass('loading');
                    $form.submit();
                }
            });

            // Double confirmation for critical action
            $('form').submit(function (e) {
                if (!confirm('FINAL WARNING: This will permanently delete the record. Continue?')) {
                    e.preventDefault();
                    $('#deleteButton').prop('disabled', false).html('<i class="fa fa-trash"></i> Confirm Delete');
                    $('form').removeClass('loading');
                }
            });

            // Error handling
            $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                alert('An error occurred while deleting: ' + thrownError);
                $('#deleteButton').prop('disabled', false).html('<i class="fa fa-trash"></i> Confirm Delete');
                $('form').removeClass('loading');
            });
        });
    </script>
</body>
</html>