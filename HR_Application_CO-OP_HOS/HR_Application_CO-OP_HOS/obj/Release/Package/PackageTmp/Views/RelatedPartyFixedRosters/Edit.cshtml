@model HR_Application_CO_OP_HOS.Models.RelatedPartyFixedRoster

@{
    ViewBag.Title = "Edit Fixed Roster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Fixed Roster</h1>
            <p class="lead">Update fixed roster assignment</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Edit Roster Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            @Html.HiddenFor(model => model.ID)

                            <div class="form-group row">
                                @Html.LabelFor(model => model.RosterID, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.RosterID, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.RosterID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.WeekDay, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.WeekDay, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.WeekDay, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-4 col-md-8">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fa fa-save"></i> Save Changes
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Current Values</h3>
                </div>
                <div class="panel-body">
                    <dl class="row">
                        <dt class="col-sm-5">Roster ID:</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.RosterID)</dd>

                        <dt class="col-sm-5">Related Party ID:</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.RelatedPartyID)</dd>

                        <dt class="col-sm-5">Week Day:</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.WeekDay)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}