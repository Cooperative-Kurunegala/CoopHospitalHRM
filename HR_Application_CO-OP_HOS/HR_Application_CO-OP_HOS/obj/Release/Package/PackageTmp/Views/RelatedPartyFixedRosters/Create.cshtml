@model HR_Application_CO_OP_HOS.Models.RelatedPartyFixedRoster

@{
    ViewBag.Title = "Create Fixed Roster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create Fixed Roster</h1>
            <p class="lead">Add new fixed roster assignment</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Roster Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group row">
                                @Html.LabelFor(model => model.RosterID, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.RosterID, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Roster ID" } })
                                    @Html.ValidationMessageFor(model => model.RosterID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Related Party ID" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Enter the employee ID for this roster assignment</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.WeekDay, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.WeekDay, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Week Day" } })
                                    @Html.ValidationMessageFor(model => model.WeekDay, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">e.g., Monday, Tuesday, etc.</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-4 col-md-8">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-save"></i> Create
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Quick Reference</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-info">
                        <h5><i class="fa fa-lightbulb-o"></i> Tips:</h5>
                        <ul>
                            <li>Ensure the Roster ID matches existing roster definitions</li>
                            <li>Verify the Related Party ID corresponds to a valid employee</li>
                            <li>Use standard weekday names (Monday-Sunday)</li>
                        </ul>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6>Available Rosters</h6>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Roster information will be displayed here when available</p>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6>Employee Details</h6>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Employee information will be displayed here when ID is entered</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Real-time validation feedback
            $('input').on('blur', function () {
                $(this).valid();
            });

            // Enhanced RelatedPartyID lookup (conceptual)
            $('#RelatedPartyID').on('change', function () {
                var relatedPartyId = $(this).val();
                if (relatedPartyId) {
                    // In a real implementation, this would fetch employee details
                    console.log('Fetching details for employee:', relatedPartyId);
                }
            });
        });
    </script>
}