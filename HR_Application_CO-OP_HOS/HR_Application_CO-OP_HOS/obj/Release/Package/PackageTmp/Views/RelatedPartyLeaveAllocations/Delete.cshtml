@model HR_Application_CO_OP_HOS.Models.RelatedPartyLeaveAllocation

@{
    ViewBag.Title = "Delete Leave Allocation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Leave Allocation</h1>
            <p class="lead">Remove employee leave allocation</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-warning">
                        <h4><i class="fa fa-warning"></i> Warning!</h4>
                        <p>Are you sure you want to delete this leave allocation? This action cannot be undone and may affect leave tracking.</p>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h5>Allocation Details to be Deleted</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">Employee ID:</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.RelatedPartyID)</dd>

                                <dt class="col-sm-4">HR Year:</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.HRYear)</dd>

                                <dt class="col-sm-4">Leave Category:</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.LeaveCategoryID)</dd>

                                <dt class="col-sm-4">Starting Value:</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.StartingValue)</dd>

                                <dt class="col-sm-4">Start Date:</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.StartingValueDate)</dd>
                            </dl>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-actions no-color mt-3">
                            <button type="submit" class="btn btn-danger">
                                <i class="fa fa-trash"></i> Confirm Delete
                            </button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Impact Analysis</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-info">
                        <h6>Deleting this allocation may affect:</h6>
                        <ul>
                            <li>Employee leave balance</li>
                            <li>Leave approval workflows</li>
                            <li>Payroll calculations</li>
                            <li>Compliance reporting</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>