@model HR_Application_CO_OP_HOS.Models.RelatedPartyLeaveAllocation

@{
    ViewBag.Title = "Create Leave Allocation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create Leave Allocation</h1>
            <p class="lead">Add new leave allocation for employee</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Leave Allocation Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group row">
                                @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Employee ID" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Enter the employee ID for leave allocation</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.HRYear, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.HRYear, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter HR Year", @min = "2000", @max = "2100" } })
                                    @Html.ValidationMessageFor(model => model.HRYear, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Enter the financial year (e.g., 2024)</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.LeaveCategoryID, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.LeaveCategoryID, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Leave Category ID" } })
                                    @Html.ValidationMessageFor(model => model.LeaveCategoryID, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Enter the leave category identifier</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.StartingValue, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.StartingValue, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Starting Value", @step = "0.5" } })
                                    @Html.ValidationMessageFor(model => model.StartingValue, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Number of leave days allocated</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.StartingValueDate, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.StartingValueDate, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                                    @Html.ValidationMessageFor(model => model.StartingValueDate, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Date when leave allocation becomes effective</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-4 col-md-8">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-save"></i> Create Allocation
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Allocation Guidelines</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-info">
                        <h5><i class="fa fa-lightbulb-o"></i> Best Practices:</h5>
                        <ul>
                            <li>Verify employee ID exists in the system</li>
                            <li>Use current financial year for new allocations</li>
                            <li>Ensure leave category matches company policy</li>
                            <li>Set appropriate starting date for allocation</li>
                        </ul>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6>Leave Categories</h6>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Leave category information will be displayed here when available</p>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h6>Employee Information</h6>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">Employee details will appear here when ID is entered</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Set default year to current year
            var currentYear = new Date().getFullYear();
            $('#HRYear').val(currentYear);

            // Real-time validation
            $('input').on('blur', function () {
                $(this).valid();
            });

            // Enhanced input handling
            $('#RelatedPartyID').on('change', function () {
                var employeeId = $(this).val();
                if (employeeId) {
                    // In real implementation, fetch employee details
                    console.log('Fetching employee details for:', employeeId);
                }
            });
        });
    </script>
}