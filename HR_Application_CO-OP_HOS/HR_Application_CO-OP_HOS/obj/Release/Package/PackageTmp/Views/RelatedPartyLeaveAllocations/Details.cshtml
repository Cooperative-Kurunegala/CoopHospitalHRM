@model HR_Application_CO_OP_HOS.Models.RelatedPartyLeaveAllocation

@{
    ViewBag.Title = "Leave Allocation Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-info-circle"></i> Leave Allocation Details</h1>
            <p class="lead">View employee leave allocation details</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-list-alt"></i> Allocation Information</h3>
                </div>
                <div class="panel-body">
                    <dl class="row dl-horizontal">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.RelatedPartyID)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.RelatedPartyID)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.HRYear)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.HRYear)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.LeaveCategoryID)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.LeaveCategoryID)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.StartingValue)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.StartingValue)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.StartingValueDate)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.StartingValueDate)</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-cogs"></i> Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="btn-group-vertical w-100">
                        @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning mb-2" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>