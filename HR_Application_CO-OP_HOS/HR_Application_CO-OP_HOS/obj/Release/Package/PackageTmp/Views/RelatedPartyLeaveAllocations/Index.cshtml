@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartyLeaveAllocation>

@{
    ViewBag.Title = "Leave Allocation Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-calendar-check-o"></i> Leave Allocation Management</h1>
            <p class="lead">Manage employee leave allocations</p>
        </div>
    </div>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> Leave Allocation List</h3>
        </div>
        <div class="panel-body">
            <div class="toolbar mb-3">
                <div class="row">
                    <div class="col-md-6">
                        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success" })
                        <div class="btn-group ml-2">
                            <button type="button" class="btn btn-outline-primary dropdown-toggle" data-toggle="dropdown">
                                <i class="fa fa-filter"></i> Filter
                            </button>
                            <div class="dropdown-menu">
                                <a class="dropdown-item filter-item" data-filter="all">All Records</a>
                                <a class="dropdown-item filter-item" data-filter="current">Current Year</a>
                                <a class="dropdown-item filter-item" data-filter="previous">Previous Year</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 text-right">
                        <div class="input-group">
                            <input type="text" id="searchInput" class="form-control" placeholder="Search allocations...">
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" id="searchButton">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover" id="leaveTable">
                    <thead class="thead-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.RelatedPartyID)</th>
                            <th>@Html.DisplayNameFor(model => model.HRYear)</th>
                            <th>@Html.DisplayNameFor(model => model.LeaveCategoryID)</th>
                            <th>@Html.DisplayNameFor(model => model.StartingValue)</th>
                            <th>@Html.DisplayNameFor(model => model.StartingValueDate)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.RelatedPartyID)</td>
                                    <td>@Html.DisplayFor(modelItem => item.HRYear)</td>
                                    <td>@Html.DisplayFor(modelItem => item.LeaveCategoryID)</td>
                                    <td>@Html.DisplayFor(modelItem => item.StartingValue)</td>
                                    <td>@Html.DisplayFor(modelItem => item.StartingValueDate)</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                            @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                            @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">No leave allocation records found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchButton').click(function () {
                filterTable();
            });

            $('#searchInput').keyup(function () {
                filterTable();
            });

            // Filter functionality
            $('.filter-item').click(function () {
                var filter = $(this).data('filter');
                applyFilter(filter);
            });

            function filterTable() {
                var searchText = $('#searchInput').val().toLowerCase();
                $('#leaveTable tbody tr').each(function () {
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.indexOf(searchText) > -1);
                });
            }

            function applyFilter(filter) {
                var currentYear = new Date().getFullYear();
                $('#leaveTable tbody tr').each(function () {
                    var yearCell = $(this).find('td:eq(1)').text();
                    switch (filter) {
                        case 'current':
                            $(this).toggle(yearCell == currentYear);
                            break;
                        case 'previous':
                            $(this).toggle(yearCell == currentYear - 1);
                            break;
                        default:
                            $(this).show();
                    }
                });
            }
        });
    </script>
}