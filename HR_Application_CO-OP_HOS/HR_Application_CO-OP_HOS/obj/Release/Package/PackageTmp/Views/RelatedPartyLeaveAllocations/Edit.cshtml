@model HR_Application_CO_OP_HOS.Models.RelatedPartyLeaveAllocation

@{
    ViewBag.Title = "Edit Leave Allocation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Leave Allocation</h1>
            <p class="lead">Update employee leave allocation</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Edit Allocation Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            @Html.HiddenFor(model => model.ID)

                            <div class="form-group row">
                                @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.HRYear, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.HRYear, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.HRYear, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.LeaveCategoryID, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.LeaveCategoryID, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.LeaveCategoryID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.StartingValue, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.StartingValue, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.StartingValue, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(model => model.StartingValueDate, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.StartingValueDate, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                                    @Html.ValidationMessageFor(model => model.StartingValueDate, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-4 col-md-8">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fa fa-save"></i> Save Changes
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Current Allocation</h3>
                </div>
                <div class="panel-body">
                    <dl class="row">
                        <dt class="col-sm-5">Employee ID:</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.RelatedPartyID)</dd>

                        <dt class="col-sm-5">HR Year:</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.HRYear)</dd>

                        <dt class="col-sm-5">Leave Category:</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.LeaveCategoryID)</dd>

                        <dt class="col-sm-5">Starting Value:</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.StartingValue)</dd>

                        <dt class="col-sm-5">Start Date:</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.StartingValueDate)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}