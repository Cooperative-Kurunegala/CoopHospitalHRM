﻿@model HR_Application_CO_OP_HOS.Models.PayeeTax

@{
    ViewBag.Title = "Payee Tax Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Payee Tax Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        .header-section {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .details-container {
            background: white;
            border-radius: 15px;
            padding: 0;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .details-header {
            background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
            color: white;
            padding: 25px;
            font-weight: 600;
            font-size: 1.4rem;
        }

        .details-body {
            padding: 40px;
        }

        .detail-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            border-left: 5px solid #3498db;
            transition: all 0.3s ease;
        }

            .detail-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 0;
        }

            .detail-value.rate {
                color: #e74c3c;
                font-size: 2rem;
            }

            .detail-value.conditions {
                color: #7f8c8d;
                line-height: 1.6;
            }

        .btn {
            border-radius: 10px;
            padding: 12px 25px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            font-size: 1.1rem;
            margin: 5px;
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .stats-panel {
            background: linear-gradient(135deg, #ffeaa7 0%, #fab1a0 100%);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .stat-item {
            text-align: center;
            padding: 15px;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: #2d3436;
            margin: 10px 0;
        }

        .stat-label {
            color: #636e72;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .related-info {
            background: #e8f4fd;
            border-radius: 12px;
            padding: 25px;
            margin-top: 25px;
            border-left: 5px solid #3498db;
        }

        .info-item {
            padding: 12px 0;
            border-bottom: 1px solid #d1ecf1;
        }

            .info-item:last-child {
                border-bottom: none;
            }

        .info-label {
            font-weight: 600;
            color: #2c3e50;
        }

        .info-value {
            color: #17a2b8;
            font-weight: 600;
        }

        .action-buttons {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 25px;
            margin-top: 25px;
            text-align: center;
        }

        .badge-custom {
            font-size: 1rem;
            padding: 10px 15px;
            border-radius: 8px;
            font-weight: 600;
        }

        .impact-analysis {
            background: #fff3cd;
            border-radius: 12px;
            padding: 20px;
            margin-top: 20px;
            border-left: 5px solid #ffc107;
        }

        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline-item {
            position: relative;
            padding: 15px 0;
            border-left: 3px solid #3498db;
            padding-left: 20px;
            margin-left: 10px;
        }

            .timeline-item::before {
                content: '';
                position: absolute;
                left: -8px;
                top: 20px;
                width: 12px;
                height: 12px;
                background: #3498db;
                border-radius: 50%;
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-eye"></i> Payee Tax Details</h1>
                    <p class="lead">View comprehensive information about this tax rate</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Main Details -->
            <div class="col-md-8">
                <div class="details-container">
                    <div class="details-header">
                        <i class="fa fa-info-circle"></i> Tax Rate Information
                    </div>
                    <div class="details-body">
                        <!-- Key Information -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-card">
                                    <div class="detail-label">Tax Rate</div>
                                    <div class="detail-value rate">@((Model.PayeeRate ?? 0m).ToString("F2"))%</div>
                                    <small class="text-muted">Percentage applied to taxable income</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-card">
                                    <div class="detail-label">Tax Type ID</div>
                                    <div class="detail-value">
                                        <span class="badge badge-custom badge-info">@Html.DisplayFor(model => model.TaxTypeID)</span>
                                    </div>
                                    <small class="text-muted">Internal tax type identifier</small>
                                </div>
                            </div>
                        </div>

                        <!-- Conditions -->
                        <div class="detail-card">
                            <div class="detail-label">Conditions & Applicability</div>
                            <div class="detail-value conditions">
                                @if (string.IsNullOrEmpty(Model.Conditions))
                                {
                                    <span class="text-muted">No specific conditions defined</span>
                                }
                                else
                                {
                                    @Html.DisplayFor(model => model.Conditions)
                                }
                            </div>
                        </div>

                        <!-- Record Information -->
                        <div class="detail-card">
                            <div class="detail-label">Record Information</div>
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Record ID:</strong> <span class="badge badge-dark">@Model.ID</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>Status:</strong> <span class="badge badge-success">Active</span>
                                </div>
                            </div>
                        </div>

                        <!-- Impact Analysis -->
                        <div class="impact-analysis">
                            <h5><i class="fa fa-line-chart"></i> Tax Impact Analysis</h5>
                            <div class="row text-center">
                                <div class="col-md-3">
                                    <div class="stat-item">
                                        <div class="stat-number">$@((5000m * (Model.PayeeRate ?? 0m) / 100m).ToString("F2"))</div>
                                        <div class="stat-label">On $5,000 Salary</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-item">
                                        <div class="stat-number">$@((10000m * (Model.PayeeRate ?? 0m) / 100m).ToString("F2"))</div>
                                        <div class="stat-label">On $10,000 Salary</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-item">
                                        <div class="stat-number">$@((25000m * (Model.PayeeRate ?? 0m) / 100m).ToString("F2"))</div>
                                        <div class="stat-label">On $25,000 Salary</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-item">
                                        <div class="stat-number">$@((50000m * (Model.PayeeRate ?? 0m) / 100m).ToString("F2"))</div>
                                        <div class="stat-label">On $50,000 Salary</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons">
                            <div class="btn-group" role="group">
                                @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning" })
                                @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger" })
                                @Html.ActionLink("Create Similar", "Create", null, new { @class = "btn btn-success" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar Information -->
            <div class="col-md-4">
                <!-- Quick Stats -->
                <div class="details-container">
                    <div class="details-header" style="background: linear-gradient(135deg, #27ae60 0%, #229954 100%);">
                        <i class="fa fa-bar-chart"></i> Quick Statistics
                    </div>
                    <div class="details-body">
                        <div class="stats-panel">
                            <div class="stat-item">
                                <div class="stat-number">@((Model.PayeeRate ?? 0m).ToString("F2"))%</div>
                                <div class="stat-label">Current Rate</div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-number">
                                    @if ((Model.PayeeRate ?? 0m) <= 10m)
                                    {
                                        <span class="badge badge-success">Low</span>
                                    }
                                    else if ((Model.PayeeRate ?? 0m) <= 25m)
                                    {
                                        <span class="badge badge-warning">Medium</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">High</span>
                                    }
                                </div>
                                <div class="stat-label">Tax Category</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Related Information -->
                <div class="details-container mt-4">
                    <div class="details-header" style="background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);">
                        <i class="fa fa-link"></i> Related Information
                    </div>
                    <div class="details-body">
                        <div class="related-info">
                            <div class="info-item">
                                <span class="info-label">Tax Type:</span>
                                <span class="info-value">
                                    @switch (Model.TaxTypeID)
                                    {
                                        case 1:<text>Standard Income Tax</text>; break;
                                    case 2: <text>Progressive Tax</text>; break;
                                case 3: <text>Flat Tax</text>; break;
                            case 4: <text>Corporate Tax</text>; break;
                        case 5: <text>Capital Gains Tax</text>; break;
                    default: <text>Unknown Type</text>; break;
            }
                                </span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Affected Employees:</span>
                                <span class="info-value">Calculating...</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Last Updated:</span>
                                <span class="info-value">@DateTime.Now.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Compliance Status:</span>
                                <span class="info-value"><span class="badge badge-success">Compliant</span></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="details-container mt-4">
                    <div class="details-header" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                        <i class="fa fa-rocket"></i> Quick Actions
                    </div>
                    <div class="details-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-info btn-sm" onclick="calculateTax()">
                                <i class="fa fa-calculator"></i> Tax Calculator
                            </button>
                            <button class="btn btn-warning btn-sm" onclick="exportDetails()">
                                <i class="fa fa-download"></i> Export Details
                            </button>
                            <button class="btn btn-success btn-sm" onclick="generateReport()">
                                <i class="fa fa-file-pdf-o"></i> Generate Report
                            </button>
                            <button class="btn btn-dark btn-sm" onclick="showAuditLog()">
                                <i class="fa fa-history"></i> View Audit Log
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Render taxRate as a numeric literal (InvariantCulture) so JS math works regardless of server culture
        var taxRate = @((Model.PayeeRate ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture));

        $(document).ready(function () {
            // Animate elements on load
            $('.detail-card').each(function (index) {
                $(this).delay(100 * index).animate({ opacity: 1, marginTop: 0 }, 500);
            });

            // Add interactive elements
            $('.detail-card').hover(
                function () {
                    $(this).css('transform', 'translateY(-5px)');
                },
                function () {
                    $(this).css('transform', 'translateY(0)');
                }
            );

            // Calculate real-time impact
            function updateImpactAnalysis() {
                var rate = parseFloat(taxRate) || 0;
                var salaries = [5000, 10000, 25000, 50000];

                salaries.forEach(function(salary, index) {
                    var tax = (salary * rate / 100).toFixed(2);
                    $('.stat-number').eq(index).text('$' + tax);
                });
            }

            updateImpactAnalysis();

            // Print functionality
            function printDetails() {
                window.print();
            }

            // Share functionality
            function shareDetails() {
                if (navigator.share) {
                    navigator.share({
                        title: 'Payee Tax Details - ' + taxRate + '%',
                        text: 'View details for tax rate ' + taxRate + '%',
                        url: window.location.href
                    });
                } else {
                    // Fallback for browsers that don't support Web Share API
                    alert('Share URL: ' + window.location.href);
                }
            }
        });

        // Action functions
        function calculateTax() {
            var salary = prompt('Enter salary amount to calculate tax:');
            if (salary && !isNaN(salary)) {
                var tax = (salary * (parseFloat(taxRate) || 0) / 100).toFixed(2);
                alert('Tax amount: $' + tax + '\nNet salary: $' + (salary - tax).toFixed(2));
            }
        }

        function exportDetails() {
            // Simulate export functionality
            var data = {
                id: @Model.ID,
                rate: @((Model.PayeeRate ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture)),
                conditions: '@System.Web.HttpUtility.JavaScriptStringEncode(Model.Conditions ?? "")',
                taxType: @Model.TaxTypeID ?? 0,
                exportDate: new Date().toISOString()
            };

            var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(data, null, 2));
            var downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "payee_tax_" + @Model.ID + ".json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();

            showToast('Details exported successfully!', 'success');
        }

        function generateReport() {
            showToast('Report generation started...', 'info');
            // Simulate report generation
            setTimeout(function() {
                showToast('PDF report generated successfully!', 'success');
            }, 2000);
        }

        function showAuditLog() {
            showToast('Loading audit log...', 'info');
            // Simulate audit log loading
            setTimeout(function() {
                var auditData = [
                    { date: '2024-01-15', action: 'Created', user: 'System Admin' },
                    { date: '2024-01-20', action: 'Updated', user: 'HR Manager' },
                    { date: '2024-02-01', action: 'Viewed', user: 'Finance Team' }
                ];

                var auditHtml = '<div class="timeline">';
                auditData.forEach(function(item) {
                    auditHtml += '<div class="timeline-item">';
                    auditHtml += '<strong>' + item.action + '</strong> by ' + item.user + '<br>';
                    auditHtml += '<small class="text-muted">' + item.date + '</small>';
                    auditHtml += '</div>';
                });
                auditHtml += '</div>';

                // Show in modal or alert
                alert('Audit Log:\n\n' + auditData.map(item =>
                    item.date + ' - ' + item.action + ' by ' + item.user
                ).join('\n'));
            }, 1000);
        }

        function showToast(message, type) {
            var toast = $('<div class="alert alert-' + (type === 'error' ? 'danger' : type) +
                         ' alert-dismissible fade show" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">' +
                         '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                         message +
                         '</div>');

            $('body').append(toast);

            setTimeout(function() {
                toast.alert('close');
            }, 3000);
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey) {
                switch(e.key) {
                    case 'p':
                        e.preventDefault();
                        window.print();
                        break;
                    case 'e':
                        e.preventDefault();
                        window.location.href = '@Url.Action("Edit", new { id = Model.ID })';
                        break;
                    case 'l':
                        e.preventDefault();
                        window.location.href = '@Url.Action("Index")';
                        break;
                }
            }
        });

        // Initialize tooltips
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
</body>
</html>