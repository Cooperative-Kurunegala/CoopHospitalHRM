﻿@model HR_Application_CO_OP_HOS.Models.PayeeTax

@{
    ViewBag.Title = "Delete Payee Tax";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Payee Tax</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
        }

        .header-section {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .delete-container {
            background: white;
            border-radius: 15px;
            padding: 0;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .delete-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 25px;
            font-weight: 600;
            font-size: 1.4rem;
        }

        .delete-body {
            padding: 40px;
        }

        .warning-section {
            background: #f8d7da;
            border: 2px solid #f5c6cb;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .details-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            border-left: 5px solid #6c757d;
        }

        .detail-item {
            padding: 15px 0;
            border-bottom: 1px solid #dee2e6;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.2rem;
            font-weight: 600;
        }

        .impact-section {
            background: #fff3cd;
            border: 2px solid #ffeaa7;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .impact-item {
            padding: 10px 0;
        }

        .btn {
            border-radius: 10px;
            padding: 15px 30px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            font-size: 1.2rem;
            margin: 5px;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .confirmation-dialog {
            background: #d4edda;
            border: 2px solid #c3e6cb;
            border-radius: 12px;
            padding: 25px;
            margin-top: 25px;
            display: none;
        }

        .security-check {
            background: #e2e3e5;
            border-radius: 8px;
            padding: 15px;
            margin: 15px 0;
        }

        .countdown {
            font-size: 1.5rem;
            font-weight: bold;
            color: #e74c3c;
            text-align: center;
            margin: 20px 0;
        }

        .archive-option {
            background: #d1ecf1;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }

        .badge-custom {
            font-size: 1rem;
            padding: 10px 15px;
            border-radius: 8px;
            font-weight: 600;
        }

        .action-buttons {
            text-align: center;
            margin-top: 30px;
        }

        .risk-indicator {
            background: #f8d7da;
            color: #721c24;
            padding: 10px 15px;
            border-radius: 6px;
            font-weight: 600;
            margin: 10px 0;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header Section -->
        <div class="header-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-trash"></i> Delete Payee Tax</h1>
                    <p class="lead">Remove tax rate from the system</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Main Content -->
            <div class="col-md-8">
                <div class="delete-container">
                    <div class="delete-header">
                        <i class="fa fa-exclamation-triangle"></i> Delete Confirmation Required
                    </div>
                    <div class="delete-body">
                        <!-- Warning Section -->
                        <div class="warning-section">
                            <div class="row align-items-center">
                                <div class="col-md-2 text-center">
                                    <i class="fa fa-warning fa-4x" style="color: #dc3545;"></i>
                                </div>
                                <div class="col-md-10">
                                    <h3 style="color: #721c24;">Critical Action Required</h3>
                                    <p class="mb-0" style="color: #721c24; font-size: 1.1rem;">
                                        You are about to permanently delete a tax rate. This action cannot be undone and may affect payroll calculations.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Record Details -->
                        <div class="details-card">
                            <h4><i class="fa fa-info-circle"></i> Record to be Deleted</h4>
                            <div class="detail-item">
                                <div class="detail-label">Tax Rate</div>
                                <div class="detail-value" style="color: #e74c3c; font-size: 1.5rem;">
                                    @Html.DisplayFor(model => model.PayeeRate)%
                                </div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Conditions</div>
                                <div class="detail-value">
                                    @if (string.IsNullOrEmpty(Model.Conditions))
                                    {
                                        <span class="text-muted">No conditions defined</span>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(model => model.Conditions)
                                    }
                                </div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Tax Type ID</div>
                                <div class="detail-value">
                                    <span class="badge badge-custom badge-info">@Html.DisplayFor(model => model.TaxTypeID)</span>
                                </div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Record ID</div>
                                <div class="detail-value">
                                    <span class="badge badge-custom badge-dark">@Model.ID</span>
                                </div>
                            </div>
                        </div>

                        <!-- Impact Analysis -->
                        <div class="impact-section">
                            <h4><i class="fa fa-exclamation-circle"></i> Potential Impact</h4>
                            <div class="impact-item">
                                <i class="fa fa-times-circle text-danger"></i>
                                <strong>Payroll Calculations:</strong> Active payroll runs using this rate will be affected
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-times-circle text-danger"></i>
                                <strong>Employee Records:</strong> Employee tax configurations referencing this rate may need updates
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-times-circle text-danger"></i>
                                <strong>Financial Reports:</strong> Historical reports may show inconsistencies
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-times-circle text-danger"></i>
                                <strong>Audit Trail:</strong> This action will be permanently logged
                            </div>
                        </div>

                        <!-- Security Check -->
                        <div class="security-check">
                            <h5><i class="fa fa-shield"></i> Security Verification</h5>
                            <div class="form-group">
                                <label for="confirmText" class="form-label">
                                    Type "DELETE" to confirm this action:
                                </label>
                                <input type="text" id="confirmText" class="form-control" placeholder="Type DELETE here">
                                <small class="form-text text-muted">This helps prevent accidental deletions.</small>
                            </div>
                        </div>

                        <!-- Archive Option -->
                        <div class="archive-option">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="archiveCheck">
                                <label class="form-check-label" for="archiveCheck">
                                    <strong>Archive instead of delete</strong> - Keep record in archive for historical reference
                                </label>
                            </div>
                            <small class="form-text text-muted">
                                Archived records remain accessible for reports but are removed from active use.
                            </small>
                        </div>

                        <!-- Countdown Timer -->
                        <div class="countdown" id="countdown">
                            Confirm within: <span id="countdownTimer">30</span> seconds
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ID)

                                <button type="button" id="cancelBtn" class="btn btn-secondary">
                                    <i class="fa fa-arrow-left"></i> Cancel
                                </button>
                                <button type="button" id="deleteBtn" class="btn btn-danger" disabled>
                                    <i class="fa fa-trash"></i> Confirm Delete
                                </button>
                                <button type="button" id="archiveBtn" class="btn btn-warning">
                                    <i class="fa fa-archive"></i> Archive Instead
                                </button>
                            }
                        </div>

                        <!-- Final Confirmation -->
                        <div class="confirmation-dialog" id="finalConfirmation">
                            <h4><i class="fa fa-check-circle text-success"></i> Final Confirmation</h4>
                            <p>Are you absolutely sure you want to proceed with deletion?</p>
                            <div class="risk-indicator">
                                <i class="fa fa-exclamation-triangle"></i>
                                HIGH RISK ACTION - THIS CANNOT BE UNDONE
                            </div>
                            <div class="action-buttons">
                                <button type="button" id="finalCancel" class="btn btn-secondary">
                                    No, Go Back
                                </button>
                                <button type="submit" id="finalDelete" class="btn btn-danger">
                                    Yes, Delete Permanently
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar Information -->
            <div class="col-md-4">
                <!-- Risk Assessment -->
                <div class="delete-container">
                    <div class="delete-header" style="background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);">
                        <i class="fa fa-clipboard"></i> Risk Assessment
                    </div>
                    <div class="delete-body">
                        <div class="risk-indicator">
                            <i class="fa fa-exclamation-triangle"></i>
                            HIGH RISK LEVEL
                        </div>
                        <div class="details-card">
                            <h5>Risk Factors:</h5>
                            <ul>
                                <li>Active tax rate in use</li>
                                <li>Linked to payroll calculations</li>
                                <li>No backup rate available</li>
                                <li>Financial impact possible</li>
                            </ul>
                        </div>
                        <div class="details-card">
                            <h5>Recommended Actions:</h5>
                            <ul>
                                <li>Consider archiving instead</li>
                                <li>Verify no active dependencies</li>
                                <li>Inform affected departments</li>
                                <li>Update documentation</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="delete-container mt-4">
                    <div class="delete-header" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);">
                        <i class="fa fa-life-ring"></i> Alternative Actions
                    </div>
                    <div class="delete-body">
                        <div class="d-grid gap-2">
                            @Html.ActionLink("Edit Instead", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-sm" })
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-sm" })
                            @Html.ActionLink("Create Replacement", "Create", null, new { @class = "btn btn-success btn-sm" })
                            <button class="btn btn-dark btn-sm" onclick="exportBackup()">
                                <i class="fa fa-download"></i> Export Backup
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var countdown = 30;
            var countdownInterval;
            var isArchiving = false;

            // Start countdown timer
            function startCountdown() {
                countdownInterval = setInterval(function () {
                    countdown--;
                    $('#countdownTimer').text(countdown);

                    if (countdown <= 0) {
                        clearInterval(countdownInterval);
                        $('#deleteBtn').prop('disabled', true);
                        $('#countdown').html('<span class="text-danger">Time expired! Refresh page to try again.</span>');
                    }
                }, 1000);
            }

            startCountdown();

            // Enable delete button when user types "DELETE"
            $('#confirmText').on('input', function () {
                var confirmText = $(this).val().toUpperCase();
                $('#deleteBtn').prop('disabled', confirmText !== 'DELETE');
            });

            // Cancel button action
            $('#cancelBtn').on('click', function () {
                if (confirm('Are you sure you want to cancel? Any unsaved changes will be lost.')) {
                    window.location.href = '@Url.Action("Index")';
                }
            });

            // Delete button action - show final confirmation
            $('#deleteBtn').on('click', function () {
                $('#finalConfirmation').slideDown();
                $('html, body').animate({
                    scrollTop: $('#finalConfirmation').offset().top - 100
                }, 500);
            });

            // Archive button action
            $('#archiveBtn').on('click', function () {
                isArchiving = true;
                if (confirm('Archive this tax rate instead of deleting? This keeps the record for historical purposes.')) {
                    // Simulate archive action
                    showToast('Archiving record...', 'info');
                    setTimeout(function() {
                        showToast('Record archived successfully!', 'success');
                        setTimeout(function() {
                            window.location.href = '@Url.Action("Index")';
                        }, 1500);
                    }, 2000);
                }
            });

            // Final confirmation actions
            $('#finalCancel').on('click', function () {
                $('#finalConfirmation').slideUp();
            });

            $('#finalDelete').on('click', function () {
                // Perform actual deletion
                $('form').submit();
            });

            // Archive checkbox
            $('#archiveCheck').on('change', function () {
                if ($(this).is(':checked')) {
                    showToast('Record will be archived instead of deleted', 'info');
                }
            });

            // Export backup functionality
            window.exportBackup = function() {
                var backupData = {
                    id: @Model.ID,
                    payeeRate: @Model.PayeeRate,
                    conditions: '@Model.Conditions',
                    taxTypeID: @Model.TaxTypeID,
                    exportedAt: new Date().toISOString(),
                    reason: 'Pre-deletion backup'
                };

                var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData, null, 2));
                var downloadAnchor = document.createElement('a');
                downloadAnchor.setAttribute("href", dataStr);
                downloadAnchor.setAttribute("download", "tax_rate_backup_" + @Model.ID + ".json");
                document.body.appendChild(downloadAnchor);
                downloadAnchor.click();
                downloadAnchor.remove();

                showToast('Backup exported successfully!', 'success');
            };

            // Toast notification function
            function showToast(message, type) {
                var toast = $('<div class="alert alert-' + (type === 'error' ? 'danger' : type) +
                             ' alert-dismissible fade show" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">' +
                             '<button type="button" class="close" data-dismiss="alert">&times;</button>' +
                             message +
                             '</div>');

                $('body').append(toast);

                setTimeout(function() {
                    toast.alert('close');
                }, 3000);
            }

            // Keyboard shortcuts
            $(document).on('keydown', function(e) {
                // Escape key to cancel
                if (e.key === 'Escape') {
                    $('#cancelBtn').click();
                }

                // Ctrl+D to focus delete confirmation
                if (e.ctrlKey && e.key === 'd') {
                    e.preventDefault();
                    $('#confirmText').focus();
                }
            });

            // Form submission handling
            $('form').on('submit', function(e) {
                if (isArchiving) {
                    e.preventDefault();
                    return false;
                }

                var confirmText = $('#confirmText').val().toUpperCase();
                if (confirmText !== 'DELETE') {
                    e.preventDefault();
                    showToast('Please type "DELETE" to confirm deletion', 'error');
                    return false;
                }

                // Show loading state
                $('button[type="submit"]').html('<i class="fa fa-spinner fa-spin"></i> Deleting...').prop('disabled', true);

                // Additional confirmation for high-risk deletion
                if (@Model.PayeeRate > 10) {
                    if (!confirm('WARNING: You are deleting a significant tax rate (' + @Model.PayeeRate + '%). This may have major impacts. Continue?')) {
                        e.preventDefault();
                        $('button[type="submit"]').html('Yes, Delete Permanently').prop('disabled', false);
                        return false;
                    }
                }

                clearInterval(countdownInterval);
            });

            // Prevent accidental navigation
            $(window).on('beforeunload', function() {
                if ($('#confirmText').val().toUpperCase() === 'DELETE') {
                    return 'You have unsaved changes. Are you sure you want to leave?';
                }
            });

            // Clean up beforeunload when form is submitted
            $('form').on('submit', function() {
                $(window).off('beforeunload');
            });
        });
    </script>
</body>
</html>