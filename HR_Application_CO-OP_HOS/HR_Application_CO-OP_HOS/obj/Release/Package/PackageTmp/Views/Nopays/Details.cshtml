﻿@model HR_Application_CO_OP_HOS.Models.Nopay

@{
    ViewBag.Title = "No Pay Record Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>No Pay Record Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-top: 10px;
        }

        /* Content Container */
        .content-container {
            padding: 0 30px 30px 30px;
        }

        /* Card Styling */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 30px rgba(0,0,0,0.15);
            }

        .card-header {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            border-radius: 12px 12px 0 0 !important;
            padding: 20px 25px;
            border: none;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .card-body {
            padding: 25px;
        }

        /* Detail Item Styling */
        .detail-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .detail-item {
            padding: 20px;
            border-bottom: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
            flex: 1;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.1rem;
            flex: 2;
            text-align: right;
        }

        .detail-value-badge {
            background: #e74c3c;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 1.1rem;
        }

        /* Buttons */
        .btn-action {
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 5px;
            font-size: 1.1rem;
            text-decoration: none;
            display: inline-block;
            border: none;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
        }

        .btn-back {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: white;
        }

        /* Related Info Panel */
        .related-info {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #3498db;
        }

        .related-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .related-item {
            padding: 15px;
            background: white;
            border-radius: 6px;
            margin-bottom: 10px;
            border-left: 3px solid #3498db;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-container {
                padding: 0 15px 15px 15px;
            }

            .page-header {
                padding: 20px 15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .detail-container {
                padding: 20px;
            }

            .detail-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .detail-value {
                text-align: left;
                margin-top: 5px;
            }

            .btn-action {
                display: block;
                width: 100%;
                margin: 10px 0;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <!-- Page Header -->
    <div class="page-header">
        <div class="container-fluid">
            <h1 class="page-title"><i class="fa fa-eye"></i> No Pay Record Details</h1>
            <p class="page-subtitle">View detailed information about no pay record</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container-fluid content-container">
        <div class="row">
            <!-- Details Column -->
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa fa-info-circle"></i> Record Information</h2>
                    </div>
                    <div class="card-body">
                        <div class="detail-container">
                            <div class="detail-item">
                                <div class="detail-label">Record ID</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.ID)</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">Employee ID</div>
                                <div class="detail-value">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-user-circle me-3" style="font-size: 24px; color: #3498db;"></i>
                                        <div>
                                            <div class="fw-bold">Employee #@Html.DisplayFor(model => model.RelatedPartyID)</div>
                                            <small class="text-muted">ID: @Html.DisplayFor(model => model.RelatedPartyID)</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">Pay Period</div>
                                <div class="detail-value">
                                    @{
                                        var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName((int)Model.PayMonth);
                                    }
                                    <i class="fa fa-calendar me-2"></i> @monthName, @Html.DisplayFor(model => model.PayYear)
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">No Pay Days</div>
                                <div class="detail-value">
                                    <span class="detail-value-badge">
                                        <i class="fa fa-calendar-times-o me-2"></i>
                                        @Html.DisplayFor(model => model.NoPayDays) days
                                    </span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">Record Status</div>
                                <div class="detail-value">
                                    <span class="badge bg-success" style="font-size: 1rem; padding: 8px 12px;">
                                        <i class="fa fa-check-circle me-2"></i> Active
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <div>
                                @Html.ActionLink("Edit Record", "Edit", new { id = Model.ID }, new { @class = "btn-action btn-edit" })
                                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn-action btn-back" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Information Column -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa fa-link"></i> Related Information</h2>
                    </div>
                    <div class="card-body">
                        <!-- Employee Information -->
                        <div class="related-info">
                            <h4 class="related-title"><i class="fa fa-user"></i> Employee Details</h4>
                            <div class="related-item">
                                <div class="fw-bold">John Smith</div>
                                <div class="text-muted">Employee #@Model.RelatedPartyID</div>
                                <div class="mt-2">
                                    <small><i class="fa fa-building me-2"></i>HR Department</small><br>
                                    <small><i class="fa fa-briefcase me-2"></i>Senior Manager</small><br>
                                    <small><i class="fa fa-envelope me-2"></i>john.smith@company.com</small>
                                </div>
                            </div>
                        </div>

                        <!-- Pay Period Information -->
                        <div class="related-info">
                            <h4 class="related-title"><i class="fa fa-calendar"></i> Pay Period</h4>
                            <div class="related-item">
                                <div class="fw-bold">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName((int)Model.PayMonth) @Model.PayYear</div>
                                <div class="mt-2">
                                    <small><i class="fa fa-clock-o me-2"></i>Full Month</small><br>
                                    <small><i class="fa fa-money me-2"></i>Regular Pay Cycle</small><br>
                                    <small><i class="fa fa-calendar-check-o me-2"></i>Processed</small>
                                </div>
                            </div>
                        </div>

                        <!-- Impact Analysis -->
                        <div class="related-info">
                            <h4 class="related-title"><i class="fa fa-calculator"></i> Impact Analysis</h4>
                            <div class="related-item">
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="fw-bold text-danger">@Model.NoPayDays</div>
                                        <small>No Pay Days</small>
                                    </div>
                                    <div class="col-6">
                                        <div class="fw-bold text-success">@(22 - Model.NoPayDays)</div>
                                        <small>Working Days</small>
                                    </div>
                                </div>
                                <div class="progress mt-3" style="height: 10px;">
                                    <div class="progress-bar bg-success" style="width: @((22 - Model.NoPayDays)/22*100)%"></div>
                                    <div class="progress-bar bg-danger" style="width: @(Model.NoPayDays/22*100)%"></div>
                                </div>
                                <small class="text-muted mt-2 d-block">Based on 22 working days per month</small>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="related-info">
                            <h4 class="related-title"><i class="fa fa-rocket"></i> Quick Actions</h4>
                            <div class="d-grid gap-2">
                                @Html.ActionLink("View Employee Profile", "Details", "RelatedParties", new { id = Model.RelatedPartyID }, new { @class = "btn btn-outline-primary btn-sm" })
                                @Html.ActionLink("View Payroll Records", "Index", "PayrollRecords", null, new { @class = "btn btn-outline-success btn-sm" })
                                @Html.ActionLink("View Attendance", "Index", "AttendanceRecords", null, new { @class = "btn btn-outline-info btn-sm" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>