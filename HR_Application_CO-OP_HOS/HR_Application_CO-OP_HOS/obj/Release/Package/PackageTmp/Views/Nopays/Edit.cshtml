﻿@model HR_Application_CO_OP_HOS.Models.Nopay

@{
    ViewBag.Title = "Edit No Pay Record";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit No Pay Record</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-top: 10px;
        }

        /* Content Container */
        .content-container {
            padding: 0 30px 30px 30px;
        }

        /* Card Styling */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 30px rgba(0,0,0,0.15);
            }

        .card-header {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
            border-radius: 12px 12px 0 0 !important;
            padding: 20px 25px;
            border: none;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .card-body {
            padding: 25px;
        }

        /* Form Styling */
        .form-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 12px 15px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .field-validation-error {
            color: #e74c3c;
            font-size: 0.95rem;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background-color: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 4px solid #e74c3c;
        }

        /* Buttons */
        .btn-submit {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
            border: none;
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
            border: none;
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .btn-submit:hover, .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        /* Reference Panel */
        .reference-panel {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #3498db;
        }

        .reference-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .reference-item {
            padding: 10px 15px;
            background: white;
            border-radius: 6px;
            margin-bottom: 10px;
            border-left: 3px solid #3498db;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .reference-item:hover {
                background: #e3f2fd;
                transform: translateX(5px);
            }

            .reference-item.selected {
                background: #3498db;
                color: white;
            }

        /* Current Values */
        .current-values {
            background: #e8f4fd;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            border-left: 4px solid #3498db;
        }

        .current-value-item {
            padding: 10px 15px;
            background: white;
            border-radius: 6px;
            margin-bottom: 10px;
            border-left: 3px solid #27ae60;
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
            margin-right: 10px;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-container {
                padding: 0 15px 15px 15px;
            }

            .page-header {
                padding: 20px 15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .form-container {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Page Header -->
    <div class="page-header">
        <div class="container-fluid">
            <h1 class="page-title"><i class="fa fa-edit"></i> Edit No Pay Record</h1>
            <p class="page-subtitle">Update existing no pay record information</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container-fluid content-container">
        <div class="row">
            <!-- Form Column -->
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa fa-pencil"></i> Edit Record Details</h2>
                    </div>
                    <div class="card-body">
                        <!-- Current Values -->
                        <div class="current-values">
                            <h4 class="reference-title"><i class="fa fa-info-circle"></i> Current Values</h4>
                            <div class="current-value-item">
                                <div class="row">
                                    <div class="col-md-3">
                                        <strong>Employee ID:</strong>
                                    </div>
                                    <div class="col-md-9">
                                        @Html.DisplayFor(model => model.RelatedPartyID)
                                    </div>
                                </div>
                            </div>
                            <div class="current-value-item">
                                <div class="row">
                                    <div class="col-md-3">
                                        <strong>Pay Month:</strong>
                                    </div>
                                    <div class="col-md-9">
                                        @{
                                            var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName((int)Model.PayMonth);
                                        }
                                        @monthName
                                    </div>
                                </div>
                            </div>
                            <div class="current-value-item">
                                <div class="row">
                                    <div class="col-md-3">
                                        <strong>Pay Year:</strong>
                                    </div>
                                    <div class="col-md-9">
                                        @Html.DisplayFor(model => model.PayYear)
                                    </div>
                                </div>
                            </div>
                            <div class="current-value-item">
                                <div class="row">
                                    <div class="col-md-3">
                                        <strong>No Pay Days:</strong>
                                    </div>
                                    <div class="col-md-9">
                                        @Html.DisplayFor(model => model.NoPayDays)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-container">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ID)

                                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.RelatedPartyID, "Employee ID", htmlAttributes: new { @class = "form-label" })
                                            @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Employee ID" } })
                                            @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "field-validation-error" })
                                            <small class="form-text text-muted">Enter the employee ID for this no pay record</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.PayMonth, "Pay Month", htmlAttributes: new { @class = "form-label" })
                                            @Html.EditorFor(model => model.PayMonth, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Month (1-12)", min = "1", max = "12" } })
                                            @Html.ValidationMessageFor(model => model.PayMonth, "", new { @class = "field-validation-error" })
                                            <small class="form-text text-muted">Enter the month number (1-12)</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.PayYear, "Pay Year", htmlAttributes: new { @class = "form-label" })
                                            @Html.EditorFor(model => model.PayYear, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Year" } })
                                            @Html.ValidationMessageFor(model => model.PayYear, "", new { @class = "field-validation-error" })
                                            <small class="form-text text-muted">Enter the year for this record</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.NoPayDays, "No Pay Days", htmlAttributes: new { @class = "form-label" })
                                            @Html.EditorFor(model => model.NoPayDays, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter No Pay Days", step = "0.5", min = "0" } })
                                            @Html.ValidationMessageFor(model => model.NoPayDays, "", new { @class = "field-validation-error" })
                                            <small class="form-text text-muted">Enter the number of no pay days (can be decimal)</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-4">
                                    <div>
                                        <input type="submit" value="Update Record" class="btn btn-submit" id="submitBtn" />
                                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-cancel ms-2" })
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reference Column -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa fa-info-circle"></i> Reference Information</h2>
                    </div>
                    <div class="card-body">
                        <!-- Employee Reference -->
                        <div class="reference-panel">
                            <h4 class="reference-title"><i class="fa fa-users"></i> Employee Reference</h4>
                            <div class="reference-item @(Model.RelatedPartyID == 1 ? "selected" : "")" data-id="1">
                                <div class="fw-bold">John Smith</div>
                                <small class="text-muted">ID: 1 | Department: HR</small>
                            </div>
                            <div class="reference-item @(Model.RelatedPartyID == 2 ? "selected" : "")" data-id="2">
                                <div class="fw-bold">Sarah Johnson</div>
                                <small class="text-muted">ID: 2 | Department: Finance</small>
                            </div>
                            <div class="reference-item @(Model.RelatedPartyID == 3 ? "selected" : "")" data-id="3">
                                <div class="fw-bold">Michael Brown</div>
                                <small class="text-muted">ID: 3 | Department: IT</small>
                            </div>
                            <small class="text-muted mt-2 d-block">Click on an employee to auto-fill the ID</small>
                        </div>

                        <!-- Month Reference -->
                        <div class="reference-panel mt-4">
                            <h4 class="reference-title"><i class="fa fa-calendar"></i> Month Reference</h4>
                            <div class="row">
                                <div class="col-6 mb-2">
                                    <div class="reference-item text-center @(Model.PayMonth == 1 ? "selected" : "")" data-month="1">
                                        <div>January</div>
                                        <small class="text-muted">Month 1</small>
                                    </div>
                                </div>
                                <div class="col-6 mb-2">
                                    <div class="reference-item text-center @(Model.PayMonth == 2 ? "selected" : "")" data-month="2">
                                        <div>February</div>
                                        <small class="text-muted">Month 2</small>
                                    </div>
                                </div>
                                <div class="col-6 mb-2">
                                    <div class="reference-item text-center @(Model.PayMonth == 3 ? "selected" : "")" data-month="3">
                                        <div>March</div>
                                        <small class="text-muted">Month 3</small>
                                    </div>
                                </div>
                                <div class="col-6 mb-2">
                                    <div class="reference-item text-center @(Model.PayMonth == 4 ? "selected" : "")" data-month="4">
                                        <div>April</div>
                                        <small class="text-muted">Month 4</small>
                                    </div>
                                </div>
                            </div>
                            <small class="text-muted mt-2 d-block">Click on a month to auto-fill the month number</small>
                        </div>

                        <!-- Quick Tips -->
                        <div class="reference-panel mt-4">
                            <h4 class="reference-title"><i class="fa fa-lightbulb-o"></i> Quick Tips</h4>
                            <ul class="list-unstyled">
                                <li class="mb-2"><i class="fa fa-check text-success me-2"></i> No pay days can be decimal values (e.g., 0.5 for half day)</li>
                                <li class="mb-2"><i class="fa fa-check text-success me-2"></i> Ensure the employee ID exists in the system</li>
                                <li class="mb-2"><i class="fa fa-check text-success me-2"></i> Month should be between 1-12</li>
                                <li class="mb-2"><i class="fa fa-check text-success me-2"></i> Year should be current or past year</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            // Employee reference selection
            $('.reference-item[data-id]').click(function () {
                $('.reference-item[data-id]').removeClass('selected');
                $(this).addClass('selected');
                $('#RelatedPartyID').val($(this).data('id'));
            });

            // Month reference selection
            $('.reference-item[data-month]').click(function () {
                $('.reference-item[data-month]').removeClass('selected');
                $(this).addClass('selected');
                $('#PayMonth').val($(this).data('month'));
            });

            // Form submission loading state
            $('form').submit(function () {
                var $submitBtn = $('#submitBtn');
                var originalText = $submitBtn.val();
                $submitBtn.html('<span class="loading"></span> Updating...').prop('disabled', true);

                // Re-enable after 3 seconds if still on page (form validation failed)
                setTimeout(function() {
                    $submitBtn.val(originalText).prop('disabled', false);
                }, 3000);
            });

            // Input validation
            $('#PayMonth').on('input', function() {
                var value = parseInt($(this).val());
                if (value < 1 || value > 12) {
                    $(this).addClass('is-invalid');
                } else {
                    $(this).removeClass('is-invalid');
                }
            });

            $('#NoPayDays').on('input', function() {
                var value = parseFloat($(this).val());
                if (value < 0) {
                    $(this).addClass('is-invalid');
                } else {
                    $(this).removeClass('is-invalid');
                }
            });
        });
    </script>
</body>
</html>