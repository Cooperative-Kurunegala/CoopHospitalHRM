﻿@model HR_Application_CO_OP_HOS.Models.Nopay

@{
    ViewBag.Title = "Delete No Pay Record";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete No Pay Record</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-top: 10px;
        }

        /* Content Container */
        .content-container {
            padding: 0 30px 30px 30px;
        }

        /* Card Styling */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 30px rgba(0,0,0,0.15);
            }

        .card-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            border-radius: 12px 12px 0 0 !important;
            padding: 20px 25px;
            border: none;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .card-body {
            padding: 25px;
        }

        /* Warning Section */
        .warning-section {
            background: #f8d7da;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 4px solid #e74c3c;
        }

        .warning-icon {
            font-size: 2rem;
            color: #e74c3c;
            margin-right: 15px;
        }

        .warning-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #721c24;
            margin: 0;
        }

        .warning-text {
            color: #721c24;
            margin-top: 10px;
        }

        /* Detail Item Styling */
        .detail-container {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .detail-item {
            padding: 20px;
            border-bottom: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
            flex: 1;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.1rem;
            flex: 2;
            text-align: right;
        }

        .detail-value-badge {
            background: #e74c3c;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 1.1rem;
        }

        /* Buttons */
        .btn-action {
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 5px;
            font-size: 1.1rem;
            text-decoration: none;
            display: inline-block;
            border: none;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: white;
        }

        /* Impact Analysis */
        .impact-analysis {
            background: #fff3cd;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #ffc107;
        }

        .impact-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #856404;
            margin-bottom: 15px;
        }

        .impact-item {
            padding: 10px 15px;
            background: white;
            border-radius: 6px;
            margin-bottom: 10px;
            border-left: 3px solid #ffc107;
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
            margin-right: 10px;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-container {
                padding: 0 15px 15px 15px;
            }

            .page-header {
                padding: 20px 15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .detail-container {
                padding: 20px;
            }

            .detail-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .detail-value {
                text-align: left;
                margin-top: 5px;
            }

            .btn-action {
                display: block;
                width: 100%;
                margin: 10px 0;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <!-- Page Header -->
    <div class="page-header">
        <div class="container-fluid">
            <h1 class="page-title"><i class="fa fa-trash"></i> Delete No Pay Record</h1>
            <p class="page-subtitle">Remove no pay record from the system</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container-fluid content-container">
        <div class="row">
            <!-- Delete Confirmation Column -->
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h2>
                    </div>
                    <div class="card-body">
                        <!-- Warning Section -->
                        <div class="warning-section d-flex align-items-start">
                            <div class="warning-icon">
                                <i class="fa fa-exclamation-circle"></i>
                            </div>
                            <div>
                                <h3 class="warning-title">Warning: This action cannot be undone!</h3>
                                <p class="warning-text">
                                    You are about to permanently delete this no pay record. This action will remove all
                                    associated data and cannot be recovered. Please review the details below before proceeding.
                                </p>
                            </div>
                        </div>

                        <!-- Record Details -->
                        <div class="detail-container">
                            <div class="detail-item">
                                <div class="detail-label">Record ID</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.ID)</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">Employee ID</div>
                                <div class="detail-value">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-user-circle me-3" style="font-size: 24px; color: #3498db;"></i>
                                        <div>
                                            <div class="fw-bold">Employee #@Html.DisplayFor(model => model.RelatedPartyID)</div>
                                            <small class="text-muted">ID: @Html.DisplayFor(model => model.RelatedPartyID)</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">Pay Period</div>
                                <div class="detail-value">
                                    @{
                                        var monthName = System.Globalization.CultureInfo.CurrentCulture
                            .DateTimeFormat.GetMonthName((int)Model.PayMonth);

                                    }
                                    <i class="fa fa-calendar me-2"></i> @monthName, @Html.DisplayFor(model => model.PayYear)
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">No Pay Days</div>
                                <div class="detail-value">
                                    <span class="detail-value-badge">
                                        <i class="fa fa-calendar-times-o me-2"></i>
                                        @Html.DisplayFor(model => model.NoPayDays) days
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Impact Analysis -->
                        <div class="impact-analysis">
                            <h4 class="impact-title"><i class="fa fa-line-chart"></i> Deletion Impact</h4>
                            <div class="impact-item">
                                <i class="fa fa-times text-danger me-2"></i>
                                <strong>Payroll Calculations:</strong> This record will be removed from all payroll calculations
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-times text-danger me-2"></i>
                                <strong>Employee Records:</strong> The no pay days will no longer appear in employee records
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-times text-danger me-2"></i>
                                <strong>Reporting:</strong> This data will be excluded from all future reports
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-times text-danger me-2"></i>
                                <strong>Audit Trail:</strong> A deletion record will be added to the system logs
                            </div>
                        </div>

                        <!-- Delete Form -->
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="d-flex justify-content-between mt-4">
                                <div>
                                    <input type="submit" value="Confirm Delete" class="btn-action btn-delete" id="deleteBtn" />
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn-action btn-cancel" })
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Related Information Column -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa fa-info-circle"></i> Related Information</h2>
                    </div>
                    <div class="card-body">
                        <!-- Employee Information -->
                        <div class="related-info" style="background: #f8f9fa; border-radius: 8px; padding: 20px; border-left: 4px solid #3498db;">
                            <h4 class="related-title" style="font-size: 1.2rem; font-weight: 600; color: #2c3e50; margin-bottom: 15px;">
                                <i class="fa fa-user"></i> Employee Details
                            </h4>
                            <div class="related-item" style="padding: 15px; background: white; border-radius: 6px; margin-bottom: 10px; border-left: 3px solid #3498db;">
                                <div class="fw-bold">John Smith</div>
                                <div class="text-muted">Employee #@Model.RelatedPartyID</div>
                                <div class="mt-2">
                                    <small><i class="fa fa-building me-2"></i>HR Department</small><br>
                                    <small><i class="fa fa-briefcase me-2"></i>Senior Manager</small>
                                </div>
                            </div>
                        </div>

                        <!-- Alternative Actions -->
                        <div class="related-info mt-4" style="background: #e8f4fd; border-radius: 8px; padding: 20px; border-left: 4px solid #3498db;">
                            <h4 class="related-title" style="font-size: 1.2rem; font-weight: 600; color: #2c3e50; margin-bottom: 15px;">
                                <i class="fa fa-lightbulb-o"></i> Alternative Actions
                            </h4>
                            <div class="d-grid gap-2">
                                @Html.ActionLink("Edit Instead", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-warning btn-sm" })
                                @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-outline-info btn-sm" })
                                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary btn-sm" })
                            </div>
                        </div>

                        <!-- System Information -->
                        <div class="related-info mt-4" style="background: #f8f9fa; border-radius: 8px; padding: 20px; border-left: 4px solid #3498db;">
                            <h4 class="related-title" style="font-size: 1.2rem; font-weight: 600; color: #2c3e50; margin-bottom: 15px;">
                                <i class="fa fa-database"></i> System Information
                            </h4>
                            <div class="related-item" style="padding: 10px 15px; background: white; border-radius: 6px; margin-bottom: 10px; border-left: 3px solid #3498db;">
                                <small><i class="fa fa-clock-o me-2"></i>Created: Recently</small><br>
                                <small><i class="fa fa-user me-2"></i>By: System Admin</small><br>
                                <small><i class="fa fa-shield me-2"></i>Security: Standard</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            // Delete confirmation with loading state
            $('#deleteBtn').click(function (e) {
                if (!confirm('Are you absolutely sure you want to delete this record? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }

                var $deleteBtn = $(this);
                var originalText = $deleteBtn.val();
                $deleteBtn.html('<span class="loading"></span> Deleting...').prop('disabled', true);

                // Allow form to submit
                return true;
            });

            // Double confirmation for delete
            $('form').submit(function (e) {
                if (!confirm('FINAL WARNING: This will permanently delete the record. Continue?')) {
                    e.preventDefault();
                    $('#deleteBtn').html('Confirm Delete').prop('disabled', false);
                    return false;
                }
                return true;
            });
        });
    </script>
</body>
</html>