﻿@model IEnumerable<HR_Application_CO_OP_HOS.Models.Nopay>

@{
    ViewBag.Title = "No Pay Records";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>No Pay Records</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-top: 10px;
        }

        /* Content Container */
        .content-container {
            padding: 0 30px 30px 30px;
        }

        /* Card Styling */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 30px rgba(0,0,0,0.15);
            }

        .card-header {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            border-radius: 12px 12px 0 0 !important;
            padding: 20px 25px;
            border: none;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .card-body {
            padding: 25px;
        }

        /* Table Styling */
        .table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .table {
            margin: 0;
            font-size: 1.1rem;
        }

            .table thead th {
                background-color: #34495e;
                color: white;
                border: none;
                padding: 18px 15px;
                font-weight: 600;
                font-size: 1.1rem;
            }

            .table tbody td {
                padding: 16px 15px;
                vertical-align: middle;
                border-bottom: 1px solid #ecf0f1;
            }

            .table tbody tr:hover {
                background-color: #f8f9fa;
            }

        /* Action Buttons */
        .btn-action {
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 500;
            transition: all 0.3s ease;
            margin: 2px;
            font-size: 0.95rem;
        }

        .btn-view {
            background-color: #3498db;
            color: white;
            border: none;
        }

        .btn-edit {
            background-color: #f39c12;
            color: white;
            border: none;
        }

        .btn-delete {
            background-color: #e74c3c;
            color: white;
            border: none;
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            border: none;
            padding: 12px 25px;
            font-weight: 600;
            border-radius: 8px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
            color: white;
        }

        /* Filter Section */
        .filter-section {
            background: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .filter-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 12px 15px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
            font-size: 1.2rem;
        }

            .no-records i {
                font-size: 3rem;
                margin-bottom: 15px;
                color: #bdc3c7;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-container {
                padding: 0 15px 15px 15px;
            }

            .page-header {
                padding: 20px 15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .table thead {
                display: none;
            }

            .table, .table tbody, .table tr, .table td {
                display: block;
                width: 100%;
            }

                .table tr {
                    margin-bottom: 15px;
                    border-radius: 8px;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                }

                .table td {
                    text-align: right;
                    padding-left: 50%;
                    position: relative;
                    border-bottom: 1px solid #ecf0f1;
                }

                    .table td::before {
                        content: attr(data-label);
                        position: absolute;
                        left: 15px;
                        width: calc(50% - 15px);
                        padding-right: 15px;
                        font-weight: 600;
                        text-align: left;
                        color: #2c3e50;
                    }

            .btn-action {
                display: block;
                width: 100%;
                margin: 5px 0;
            }
        }

        /* Loading Animation */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
            margin-right: 10px;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <!-- Page Header -->
    <div class="page-header">
        <div class="container-fluid">
            <h1 class="page-title"><i class="fa fa-calendar-times-o"></i> No Pay Records Management</h1>
            <p class="page-subtitle">Manage employee no pay days and records</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container-fluid content-container">
        <!-- Action Card -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title"><i class="fa fa-cogs"></i> Actions</h2>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-create" })
                    </div>
                    <div>
                        @Html.ActionLink("Back to Dashboard", "Index", "Home", null, new { @class = "btn btn-action", style = "background-color: #95a5a6; color: white;" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <h3 class="filter-title"><i class="fa fa-filter"></i> Filter Records</h3>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="filterYear" class="form-label">Pay Year</label>
                    <select class="form-select" id="filterYear">
                        <option value="">All Years</option>
                        @{
                            var currentYear = DateTime.Now.Year;
                            for (int year = currentYear - 5; year <= currentYear + 1; year++)
                            {
                                <option value="@year">@year</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="filterMonth" class="form-label">Pay Month</label>
                    <select class="form-select" id="filterMonth">
                        <option value="">All Months</option>
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="filterEmployee" class="form-label">Employee</label>
                    <input type="text" class="form-control" id="filterEmployee" placeholder="Search employee...">
                </div>
                <div class="col-md-3 mb-3 d-flex align-items-end">
                    <button type="button" class="btn btn-action me-2" style="background-color: #3498db;" id="applyFilter">
                        <i class="fa fa-search"></i> Apply Filter
                    </button>
                    <button type="button" class="btn btn-action" style="background-color: #95a5a6;" id="resetFilter">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title"><i class="fa fa-list"></i> No Pay Records</h2>
            </div>
            <div class="card-body p-0">
                <div class="table-container">
                    @if (Model != null && Model.Any())
                    {
                        <table class="table table-hover" id="nopayTable">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Pay Month</th>
                                    <th>Pay Year</th>
                                    <th>No Pay Days</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td data-label="Employee">
                                            <div class="d-flex align-items-center">
                                                <div class="employee-avatar me-3">
                                                    <i class="fa fa-user-circle" style="font-size: 24px; color: #3498db;"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">Employee #@item.RelatedPartyID</div>
                                                    <small class="text-muted">ID: @item.RelatedPartyID</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="Pay Month">
                                            @{
                                                var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName((int)item.PayMonth);
                                            }
                                            @monthName
                                        </td>
                                        <td data-label="Pay Year">@item.PayYear</td>
                                        <td data-label="No Pay Days">
                                            <span class="badge bg-danger" style="font-size: 1rem; padding: 8px 12px;">
                                                @item.NoPayDays days
                                            </span>
                                        </td>
                                        <td data-label="Actions">
                                            <div class="btn-group" role="group">
                                                @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-action btn-view" })
                                                @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-action btn-edit" })
                                                @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-action btn-delete" })
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="no-records">
                            <i class="fa fa-inbox"></i>
                            <h3>No Records Found</h3>
                            <p>There are no no-pay records in the system yet.</p>
                            @Html.ActionLink("Create New Record", "Create", null, new { @class = "btn btn-create mt-3" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            // Filter functionality
            $('#applyFilter').click(function () {
                filterTable();
            });

            $('#resetFilter').click(function () {
                $('#filterYear').val('');
                $('#filterMonth').val('');
                $('#filterEmployee').val('');
                filterTable();
            });

            function filterTable() {
                var year = $('#filterYear').val().toLowerCase();
                var month = $('#filterMonth').val().toLowerCase();
                var employee = $('#filterEmployee').val().toLowerCase();

                $('#nopayTable tbody tr').each(function () {
                    var rowYear = $(this).find('td:eq(2)').text().toLowerCase();
                    var rowMonth = $(this).find('td:eq(1)').text().toLowerCase();
                    var rowEmployee = $(this).find('td:eq(0)').text().toLowerCase();

                    var yearMatch = year === '' || rowYear.indexOf(year) > -1;
                    var monthMatch = month === '' || rowMonth.indexOf(getMonthName(month)) > -1;
                    var employeeMatch = employee === '' || rowEmployee.indexOf(employee) > -1;

                    if (yearMatch && monthMatch && employeeMatch) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            function getMonthName(monthNumber) {
                var months = [
                    '', 'january', 'february', 'march', 'april', 'may', 'june',
                    'july', 'august', 'september', 'october', 'november', 'december'
                ];
                return months[parseInt(monthNumber)] || '';
            }

            // Loading state for buttons
            $('.btn-action').click(function () {
                var $btn = $(this);
                var originalText = $btn.html();
                $btn.html('<span class="loading"></span> Loading...').prop('disabled', true);

                setTimeout(function() {
                    $btn.html(originalText).prop('disabled', false);
                }, 1000);
            });
        });
    </script>
</body>
</html>