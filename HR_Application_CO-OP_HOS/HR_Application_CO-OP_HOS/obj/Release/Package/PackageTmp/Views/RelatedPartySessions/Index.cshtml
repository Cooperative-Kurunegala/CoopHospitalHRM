@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartySession>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Related Party Sessions</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Action Bar */
        .action-bar {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        /* Filter Section */
        .filter-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .filter-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .form-group label {
            font-weight: 600;
            color: #34495e;
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 10px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .btn-filter {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            padding: 10px 20px;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-filter:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }

        /* Data Container */
        .data-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .table-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px;
        }

            .table-header h3 {
                margin: 0;
                font-size: 1.5rem;
                font-weight: 600;
            }

        /* Modern Table */
        .modern-table {
            width: 100%;
            border-collapse: collapse;
        }

            .modern-table th {
                background: #ecf0f1;
                color: #2c3e50;
                font-weight: 600;
                padding: 15px;
                text-align: left;
                border-bottom: 2px solid #bdc3c7;
                font-size: 1rem;
            }

            .modern-table td {
                padding: 15px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: top;
                font-size: 0.95rem;
            }

            .modern-table tbody tr {
                transition: all 0.3s ease;
            }

                .modern-table tbody tr:hover {
                    background: #f8f9fa;
                    transform: translateX(5px);
                }

        /* Action Links */
        .action-links a {
            padding: 6px 12px;
            margin: 2px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .btn-edit {
            background: #f39c12;
            color: white;
        }

            .btn-edit:hover {
                background: #e67e22;
                color: white;
                transform: translateY(-1px);
            }

        .btn-details {
            background: #3498db;
            color: white;
        }

            .btn-details:hover {
                background: #2980b9;
                color: white;
                transform: translateY(-1px);
            }

        .btn-delete {
            background: #e74c3c;
            color: white;
        }

            .btn-delete:hover {
                background: #c0392b;
                color: white;
                transform: translateY(-1px);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 60px 20px;
            color: #7f8c8d;
        }

            .no-records i {
                font-size: 4rem;
                margin-bottom: 20px;
                color: #bdc3c7;
            }

            .no-records h4 {
                font-size: 1.5rem;
                margin-bottom: 10px;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .modern-table {
                display: block;
                overflow-x: auto;
            }

            .action-links {
                white-space: nowrap;
            }
        }

        /* Loading Animation */
        .loading {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 2s linear infinite;
            margin: 0 auto 20px auto;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Foreign Key Helper */
        .foreign-key-helper {
            background: #f8f9fa;
            border-left: 4px solid #3498db;
            padding: 15px;
            margin: 10px 0;
            border-radius: 0 8px 8px 0;
        }

            .foreign-key-helper h6 {
                color: #2c3e50;
                margin-bottom: 8px;
                font-weight: 600;
            }

        .fk-item {
            background: white;
            padding: 8px 12px;
            margin: 5px 0;
            border-radius: 6px;
            border: 1px solid #ecf0f1;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .fk-item:hover {
                background: #3498db;
                color: white;
                transform: translateX(5px);
            }

        /* Tooltip */
        .tooltip-info {
            cursor: help;
            color: #3498db;
            margin-left: 5px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-calendar-check-o"></i> Related Party Sessions
            </h1>
            <p class="page-subtitle">Manage and view all related party session records</p>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Action Bar -->
            <div class="action-bar">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h4 style="margin: 0; color: #2c3e50;">
                            <i class="fa fa-list"></i> Session Records
                        </h4>
                    </div>
                    <div class="col-md-6 text-right">
                        @Html.ActionLink("Create New Session", "Create", null, new { @class = "btn btn-create" })
                    </div>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="filter-header">
                    <i class="fa fa-filter"></i> Filter Sessions
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="filterEPF">EPF Number</label>
                            <input type="number" class="form-control" id="filterEPF" placeholder="Enter EPF">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="filterMonth">Pay Month</label>
                            <select class="form-control" id="filterMonth">
                                <option value="">All Months</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="filterYear">Pay Year</label>
                            <select class="form-control" id="filterYear">
                                <option value="">All Years</option>
                                @for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year + 1; year++)
                                {
                                    <option value="@year">@year</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button class="btn btn-filter btn-block" id="applyFilters">
                                <i class="fa fa-search"></i> Apply Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Container -->
            <div class="data-container">
                <div class="table-header">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h3><i class="fa fa-table"></i> Session Records</h3>
                        </div>
                        <div class="col-md-6 text-right">
                            <span class="badge badge-light" id="recordCount">@Model.Count() records found</span>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    @if (Model.Any())
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>EPF</th>
                                    <th>Pay Period</th>
                                    <th>Calendar Day</th>
                                    <th>Check In/Out</th>
                                    <th>Worked Time</th>
                                    <th>OT Minutes</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@Html.DisplayFor(modelItem => item.EPF)</strong>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.PayMonth)/@Html.DisplayFor(modelItem => item.PayYear)
                                        </td>
                                        <td>
                                            @(item.CalendarDay?.ToString("MMM dd, yyyy") ?? "N/A")
                                        </td>
                                        <td>
                                            <small>
                                                In: @(item.CheckInDateTime?.ToString("HH:mm") ?? "N/A")<br>
                                                Out: @(item.CheckOutDateTime?.ToString("HH:mm") ?? "N/A")
                                            </small>
                                        </td>
                                        <td>
                                            @if (item.WorkedMinutes > 0)
                                            {
                                                <span class="badge badge-success">
                                                    @(item.WorkedMinutes / 60)h @(item.WorkedMinutes % 60)m
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">N/A</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.OTMinutes > 0)
                                            {
                                                <span class="badge badge-warning">
                                                    @item.OTMinutes m
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">0</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.SessionStatus == 1)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td class="action-links">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn-edit" })
                                            @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn-details" })
                                            @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn-delete" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="no-records">
                            <i class="fa fa-database"></i>
                            <h4>No Session Records Found</h4>
                            <p>There are no related party session records in the database.</p>
                            @Html.ActionLink("Create First Session", "Create", null, new { @class = "btn btn-create" })
                        </div>
                    }
                </div>
            </div>

            <!-- Foreign Key Reference Section -->
            <div class="filter-section mt-4">
                <div class="filter-header">
                    <i class="fa fa-info-circle"></i> Reference Data
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="foreign-key-helper">
                            <h6>Day Types <i class="fa fa-question-circle tooltip-info" title="Available day types for sessions"></i></h6>
                            <!-- This would typically be populated from your database -->
                            <div class="fk-item">Regular Day</div>
                            <div class="fk-item">Holiday</div>
                            <div class="fk-item">Weekend</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="foreign-key-helper">
                            <h6>Session Status <i class="fa fa-question-circle tooltip-info" title="Available session statuses"></i></h6>
                            <div class="fk-item">Active</div>
                            <div class="fk-item">Completed</div>
                            <div class="fk-item">Cancelled</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="foreign-key-helper">
                            <h6>Admission Types <i class="fa fa-question-circle tooltip-info" title="Available admission types"></i></h6>
                            <div class="fk-item">Inpatient</div>
                            <div class="fk-item">Outpatient</div>
                            <div class="fk-item">Day Care</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <script>
        $(document).ready(function () {
            // Filter functionality
            $('#applyFilters').click(function () {
                applyTableFilters();
            });

            // Enter key support for filters
            $('.form-control').keypress(function (e) {
                if (e.which === 13) {
                    applyTableFilters();
                }
            });

            function applyTableFilters() {
                const epfFilter = $('#filterEPF').val().toLowerCase();
                const monthFilter = $('#filterMonth').val();
                const yearFilter = $('#filterYear').val();

                $('.modern-table tbody tr').each(function () {
                    const $row = $(this);
                    const epf = $row.find('td:eq(0)').text().toLowerCase();
                    const monthYear = $row.find('td:eq(1)').text();

                    let showRow = true;

                    if (epfFilter && epf.indexOf(epfFilter) === -1) {
                        showRow = false;
                    }

                    if (monthFilter && !monthYear.startsWith(monthFilter + '/')) {
                        showRow = false;
                    }

                    if (yearFilter && !monthYear.endsWith(yearFilter)) {
                        showRow = false;
                    }

                    $row.toggle(showRow);
                });

                // Update record count
                const visibleCount = $('.modern-table tbody tr:visible').length;
                $('#recordCount').text(visibleCount + ' records found');

                if (visibleCount === 0) {
                    $('.modern-table').hide();
                    $('.table-responsive').append(`
                        <div class="no-records">
                            <i class="fa fa-search"></i>
                            <h4>No Matching Records</h4>
                            <p>No sessions match your filter criteria.</p>
                            <button class="btn btn-filter" id="clearFilters">Clear Filters</button>
                        </div>
                    `);

                    $('#clearFilters').click(function () {
                        clearFilters();
                    });
                }
            }

            function clearFilters() {
                $('#filterEPF').val('');
                $('#filterMonth').val('');
                $('#filterYear').val('');
                $('.modern-table tbody tr').show();
                $('.modern-table').show();
                $('.no-records').remove();
                $('#recordCount').text('@Model.Count() records found');
            }

            // Tooltip initialization
            $('.tooltip-info').hover(function () {
                const title = $(this).attr('title');
                $(this).attr('data-original-title', title).tooltip('show');
            });

            // Loading state for actions
            $('.action-links a').click(function (e) {
                const $link = $(this);
                $link.html('<i class="fa fa-spinner fa-spin"></i> Loading...').addClass('disabled');
            });

            // Responsive table enhancements
            function enhanceTableResponsive() {
                if ($(window).width() < 768) {
                    $('.modern-table th:nth-child(n+4), .modern-table td:nth-child(n+4)').hide();
                } else {
                    $('.modern-table th, .modern-table td').show();
                }
            }

            $(window).resize(enhanceTableResponsive);
            enhanceTableResponsive();
        });

        // Error handling for AJAX calls (if implemented later)
        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            console.error('AJAX Error:', thrownError);
            alert('An error occurred while processing your request. Please try again.');
        });
    </script>
</body>
</html>