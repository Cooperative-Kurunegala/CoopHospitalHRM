@model HR_Application_CO_OP_HOS.Models.RelatedPartySession

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Related Party Session</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .form-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .form-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .form-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .form-container {
            padding: 0 30px 30px 30px;
        }

        .form-content {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .form-section {
            padding: 30px;
            border-bottom: 1px solid #eee;
        }

            .form-section:last-child {
                border-bottom: none;
            }

        .section-title {
            font-size: 1.5rem;
            color: #2c3e50;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid #3498db;
            font-weight: 600;
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 25px;
        }

        .control-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .checkbox {
            margin-top: 8px;
        }

        /* Foreign Key Selector */
        .foreign-key-selector {
            position: relative;
        }

        .fk-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            z-index: 1000;
            max-height: 300px;
            overflow-y: auto;
            display: none;
        }

        .fk-item {
            padding: 12px 15px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            .fk-item:hover {
                background-color: #f8f9fa;
            }

            .fk-item:last-child {
                border-bottom: none;
            }

        .fk-search {
            padding: 12px 15px;
            border-bottom: 1px solid #eee;
            background: #f8f9fa;
        }

        /* Action Buttons */
        .form-actions {
            background: #f8f9fa;
            padding: 25px 30px;
            border-top: 1px solid #eee;
            text-align: right;
        }

        .btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

            .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        /* Validation Styles */
        .text-danger {
            font-size: 0.9rem;
            margin-top: 5px;
            font-weight: 500;
        }

        .field-validation-error {
            color: #e74c3c;
        }

        .input-validation-error {
            border-color: #e74c3c;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .form-container {
                padding: 0 15px 15px 15px;
            }

            .form-section {
                padding: 20px;
            }

            .form-title {
                font-size: 2rem;
            }

            .section-title {
                font-size: 1.3rem;
            }
        }

        /* Loading States */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 2s linear infinite;
            margin: 20px auto;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* No Records Found */
        .no-records {
            text-align: center;
            padding: 30px;
            color: #7f8c8d;
            font-style: italic;
        }

        /* Success/Error Messages */
        .alert {
            border-radius: 8px;
            padding: 15px 20px;
            margin-bottom: 25px;
            border: none;
            font-weight: 500;
        }

        .alert-success {
            background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
            color: white;
        }

        .alert-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }
    </style>
</head>
<body>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Header Section -->
    <div class="form-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 text-center">
                    <h1 class="form-title">
                        <i class="fa fa-plus-circle"></i> Create Related Party Session
                    </h1>
                    <p class="form-subtitle">Add new session record to the system</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Form Content -->
    <div class="container-fluid form-container">
        <div class="row">
            <div class="col-12">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-content">
                        <!-- Validation Summary -->
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <!-- Basic Information Section -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <i class="fa fa-info-circle"></i> Basic Information
                            </h3>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EPF, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.EPF, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter EPF number" } })
                                        @Html.ValidationMessageFor(model => model.EPF, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label" })
                                        <div class="foreign-key-selector">
                                            @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control fk-input", placeholder = "Select Related Party", data_fk_table = "RelatedParties", data_fk_display = "RelatedPartyName" } })
                                            <div class="fk-dropdown">
                                                <div class="fk-search">
                                                    <input type="text" class="form-control form-control-sm fk-search-input" placeholder="Search related parties...">
                                                </div>
                                                <div class="fk-items">
                                                    <!-- Related parties will be loaded here -->
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PayMonth, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.PayMonth, new { htmlAttributes = new { @class = "form-control", placeholder = "Pay month", min = "1", max = "12" } })
                                        @Html.ValidationMessageFor(model => model.PayMonth, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PayYear, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.PayYear, new { htmlAttributes = new { @class = "form-control", placeholder = "Pay year" } })
                                        @Html.ValidationMessageFor(model => model.PayYear, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CalendarDay, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CalendarDay, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                        @Html.ValidationMessageFor(model => model.CalendarDay, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Time and Attendance Section -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <i class="fa fa-clock-o"></i> Time & Attendance
                            </h3>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CheckInDateTime, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CheckInDateTime, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.CheckInDateTime, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CheckOutDateTime, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CheckOutDateTime, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.CheckOutDateTime, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ActualInDateTime, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.ActualInDateTime, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.ActualInDateTime, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ActualOutDateTime, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.ActualOutDateTime, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.ActualOutDateTime, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Work Details Section -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <i class="fa fa-briefcase"></i> Work Details
                            </h3>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WorkedMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.WorkedMinutes, new { htmlAttributes = new { @class = "form-control", placeholder = "Worked minutes" } })
                                        @Html.ValidationMessageFor(model => model.WorkedMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.OTMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.OTMinutes, new { htmlAttributes = new { @class = "form-control", placeholder = "OT minutes" } })
                                        @Html.ValidationMessageFor(model => model.OTMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LateInMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.LateInMinutes, new { htmlAttributes = new { @class = "form-control", placeholder = "Late in minutes" } })
                                        @Html.ValidationMessageFor(model => model.LateInMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EarlyOutMinutes, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.EarlyOutMinutes, new { htmlAttributes = new { @class = "form-control", placeholder = "Early out minutes" } })
                                        @Html.ValidationMessageFor(model => model.EarlyOutMinutes, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information Section -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <i class="fa fa-cogs"></i> Additional Information
                            </h3>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CompanyID, htmlAttributes: new { @class = "control-label" })
                                        <div class="foreign-key-selector">
                                            @Html.EditorFor(model => model.CompanyID, new { htmlAttributes = new { @class = "form-control fk-input", placeholder = "Select Company", data_fk_table = "Companies", data_fk_display = "companyName" } })
                                            <div class="fk-dropdown">
                                                <div class="fk-search">
                                                    <input type="text" class="form-control form-control-sm fk-search-input" placeholder="Search companies...">
                                                </div>
                                                <div class="fk-items">
                                                    <!-- Companies will be loaded here -->
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.CompanyID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LocationID, htmlAttributes: new { @class = "control-label" })
                                        <div class="foreign-key-selector">
                                            @Html.EditorFor(model => model.LocationID, new { htmlAttributes = new { @class = "form-control fk-input", placeholder = "Select Location", data_fk_table = "Locations", data_fk_display = "LocationName" } })
                                            <div class="fk-dropdown">
                                                <div class="fk-search">
                                                    <input type="text" class="form-control form-control-sm fk-search-input" placeholder="Search locations...">
                                                </div>
                                                <div class="fk-items">
                                                    <!-- Locations will be loaded here -->
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.LocationID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DayTypeID, htmlAttributes: new { @class = "control-label" })
                                        <div class="foreign-key-selector">
                                            @Html.EditorFor(model => model.DayTypeID, new { htmlAttributes = new { @class = "form-control fk-input", placeholder = "Select Day Type", data_fk_table = "DayTypes", data_fk_display = "DayTypeName" } })
                                            <div class="fk-dropdown">
                                                <div class="fk-search">
                                                    <input type="text" class="form-control form-control-sm fk-search-input" placeholder="Search day types...">
                                                </div>
                                                <div class="fk-items">
                                                    <!-- Day types will be loaded here -->
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.DayTypeID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ShiftID, htmlAttributes: new { @class = "control-label" })
                                        <div class="foreign-key-selector">
                                            @Html.EditorFor(model => model.ShiftID, new { htmlAttributes = new { @class = "form-control fk-input", placeholder = "Select Shift", data_fk_table = "Shifts", data_fk_display = "ShiftDescription" } })
                                            <div class="fk-dropdown">
                                                <div class="fk-search">
                                                    <input type="text" class="form-control form-control-sm fk-search-input" placeholder="Search shifts...">
                                                </div>
                                                <div class="fk-items">
                                                    <!-- Shifts will be loaded here -->
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.ShiftID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Boolean Flags Section -->
                        <div class="form-section">
                            <h3 class="section-title">
                                <i class="fa fa-toggle-on"></i> Status Flags
                            </h3>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="checkbox">
                                            <label>
                                                @Html.EditorFor(model => model.IsHomeVisit)
                                                @Html.LabelFor(model => model.IsHomeVisit)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="checkbox">
                                            <label>
                                                @Html.EditorFor(model => model.IsOTPaid)
                                                @Html.LabelFor(model => model.IsOTPaid)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="checkbox">
                                            <label>
                                                @Html.EditorFor(model => model.IsRecommended)
                                                @Html.LabelFor(model => model.IsRecommended)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <div class="checkbox">
                                            <label>
                                                @Html.EditorFor(model => model.IsOTApproved)
                                                @Html.LabelFor(model => model.IsOTApproved)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Create Session
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fa fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Foreign key selector functionality
            $('.fk-input').each(function () {
                var $input = $(this);
                var $dropdown = $input.siblings('.fk-dropdown');
                var $search = $dropdown.find('.fk-search-input');
                var $items = $dropdown.find('.fk-items');
                var fkTable = $input.data('fk-table');
                var displayField = $input.data('fk-display');

                // Load foreign key data
                loadForeignKeyData(fkTable, displayField, $items);

                // Show dropdown on focus
                $input.on('focus', function () {
                    $dropdown.show();
                    $search.focus();
                });

                // Hide dropdown when clicking outside
                $(document).on('click', function (e) {
                    if (!$(e.target).closest('.foreign-key-selector').length) {
                        $dropdown.hide();
                    }
                });

                // Filter items based on search
                $search.on('input', function () {
                    var searchTerm = $(this).val().toLowerCase();
                    $items.find('.fk-item').each(function () {
                        var text = $(this).text().toLowerCase();
                        $(this).toggle(text.includes(searchTerm));
                    });
                });

                // Select item
                $items.on('click', '.fk-item', function () {
                    var id = $(this).data('id');
                    var text = $(this).text();
                    $input.val(id);
                    $input.trigger('change');
                    $dropdown.hide();
                });
            });

            // Load foreign key data function
            function loadForeignKeyData(tableName, displayField, $container) {
                // This is a simplified version - in a real scenario, you'd make an AJAX call to your API
                // For demonstration, we'll use a switch statement with sample data

                var sampleData = [];

                switch (tableName) {
                    case 'RelatedParties':
                        sampleData = [
                            { ID: 1, RelatedPartyName: 'John Doe - EPF001' },
                            { ID: 2, RelatedPartyName: 'Jane Smith - EPF002' },
                            { ID: 3, RelatedPartyName: 'Mike Johnson - EPF003' }
                        ];
                        break;
                    case 'Companies':
                        sampleData = [
                            { ID: 1, companyName: 'Main Hospital' },
                            { ID: 2, companyName: 'Branch Clinic A' },
                            { ID: 3, companyName: 'Branch Clinic B' }
                        ];
                        break;
                    case 'Locations':
                        sampleData = [
                            { ID: 1, LocationName: 'Main Building - Floor 1' },
                            { ID: 2, LocationName: 'Main Building - Floor 2' },
                            { ID: 3, LocationName: 'Emergency Wing' }
                        ];
                        break;
                    case 'DayTypes':
                        sampleData = [
                            { ID: 1, DayTypeName: 'Regular Working Day' },
                            { ID: 2, DayTypeName: 'Weekend' },
                            { ID: 3, DayTypeName: 'Public Holiday' }
                        ];
                        break;
                    case 'Shifts':
                        sampleData = [
                            { ID: 1, ShiftDescription: 'Morning Shift (8AM-4PM)' },
                            { ID: 2, ShiftDescription: 'Evening Shift (4PM-12AM)' },
                            { ID: 3, ShiftDescription: 'Night Shift (12AM-8AM)' }
                        ];
                        break;
                }

                if (sampleData.length > 0) {
                    $container.empty();
                    sampleData.forEach(function (item) {
                        $container.append('<div class="fk-item" data-id="' + item.ID + '">' + item[displayField] + '</div>');
                    });
                } else {
                    $container.html('<div class="no-records">No records found</div>');
                }
            }

            // Form submission handling
            $('form').on('submit', function (e) {
                var $form = $(this);
                var isValid = $form.valid();

                if (isValid) {
                    $form.addClass('loading');
                    // Form will be submitted normally
                }
            });

            // Real-time validation feedback
            $('.form-control').on('blur', function () {
                $(this).valid();
            });

            // Auto-calculate worked minutes if check-in and check-out are provided
            $('#CheckInDateTime, #CheckOutDateTime').on('change', function () {
                var checkIn = $('#CheckInDateTime').val();
                var checkOut = $('#CheckOutDateTime').val();

                if (checkIn && checkOut) {
                    var start = new Date(checkIn);
                    var end = new Date(checkOut);
                    var diffMs = end - start;
                    var diffMins = Math.round(diffMs / 60000);

                    if (diffMins > 0) {
                        $('#WorkedMinutes').val(diffMins);
                    }
                }
            });

            // Exception handling for AJAX calls (if implemented later)
            $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                console.error('AJAX Error:', thrownError);
                alert('An error occurred while loading data. Please try again.');
            });
        });
    </script>
</body>
</html>