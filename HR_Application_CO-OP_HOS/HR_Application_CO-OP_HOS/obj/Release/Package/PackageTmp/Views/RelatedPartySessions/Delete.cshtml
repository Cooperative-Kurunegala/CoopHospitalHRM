﻿@model HR_Application_CO_OP_HOS.Models.RelatedPartySession

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Related Party Session</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px 0;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 0 30px 30px 30px;
        }

        /* Delete Confirmation Card */
        .delete-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 30px;
            border: none;
        }

        .card-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            border-radius: 15px 15px 0 0 !important;
            padding: 25px 30px;
            border: none;
        }

            .card-header h3 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 600;
            }

        .card-body {
            padding: 40px;
        }

        /* Warning Alert */
        .warning-alert {
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
            border: 2px solid #ffc107;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
        }

            .warning-alert h4 {
                color: #856404;
                margin-bottom: 15px;
                font-weight: 600;
            }

            .warning-alert p {
                color: #856404;
                margin: 0;
                font-size: 1.1rem;
            }

        /* Data Display */
        .data-section {
            margin-bottom: 40px;
        }

        .section-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid #3498db;
        }

        .data-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .data-item {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            border-left: 5px solid #3498db;
        }

        .data-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1rem;
            margin-bottom: 8px;
        }

        .data-value {
            color: #34495e;
            font-size: 1.1rem;
            font-weight: 500;
        }

        .data-value-empty {
            color: #7f8c8d;
            font-style: italic;
        }

        /* Foreign Key Data Display */
        .foreign-key-section {
            background: #e8f4fd;
            border-radius: 10px;
            padding: 25px;
            margin-top: 20px;
        }

        .foreign-key-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #2980b9;
            margin-bottom: 20px;
        }

        .foreign-key-data {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: flex-start;
            align-items: center;
            flex-wrap: wrap;
            padding-top: 30px;
            border-top: 2px solid #ecf0f1;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 15px 40px;
            font-size: 1.2rem;
            font-weight: 600;
            border-radius: 10px;
            color: white;
            transition: all 0.3s ease;
        }

            .btn-delete:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
                background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 15px 40px;
            font-size: 1.2rem;
            font-weight: 600;
            border-radius: 10px;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
                color: white;
                text-decoration: none;
            }

        /* Loading Spinner */
        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
        }

        .spinner-border {
            width: 3rem;
            height: 3rem;
        }

        /* Error Message */
        .error-message {
            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
            border: 2px solid #dc3545;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            color: #721c24;
            display: none;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .main-content {
                padding: 0 15px 20px 15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .data-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .card-body {
                padding: 25px 20px;
            }

            .action-buttons {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-delete, .btn-cancel {
                width: 100%;
                text-align: center;
            }
        }

        /* Animation */
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Badge Styles */
        .badge-boolean {
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .badge-true {
            background: #d4edda;
            color: #155724;
        }

        .badge-false {
            background: #f8d7da;
            color: #721c24;
        }

        /* DateTime Display */
        .datetime-value {
            background: #f8f9fa;
            padding: 8px 12px;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 0.95rem;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header text-center">
            <div class="container">
                <h1 class="page-title">
                    <i class="fas fa-trash-alt me-3"></i>Delete Related Party Session
                </h1>
                <p class="page-subtitle">HR Management System - Confirm Deletion</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row justify-content-center">
                <div class="col-12 col-xl-10">
                    <!-- Delete Confirmation Card -->
                    <div class="card delete-card fade-in">
                        <div class="card-header">
                            <h3><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion</h3>
                        </div>
                        <div class="card-body">
                            <!-- Warning Alert -->
                            <div class="warning-alert">
                                <h4><i class="fas fa-exclamation-circle me-2"></i>Warning</h4>
                                <p>You are about to permanently delete this Related Party Session. This action cannot be undone. Please review the details below before proceeding.</p>
                            </div>

                            <!-- Error Message -->
                            <div class="error-message" id="errorMessage">
                                <i class="fas fa-times-circle me-2"></i>
                                <span id="errorText"></span>
                            </div>

                            <!-- Loading Spinner -->
                            <div class="loading-spinner" id="loadingSpinner">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">Processing deletion...</p>
                            </div>

                            <!-- Session Details -->
                            <div class="data-section">
                                <h4 class="section-title">
                                    <i class="fas fa-info-circle me-2"></i>Session Details
                                </h4>

                                <div class="data-grid">
                                    <!-- Basic Information -->
                                    <div class="data-item">
                                        <div class="data-label">EPF Number</div>
                                        <div class="data-value">@(Model.EPF?.ToString() ?? "<span class='data-value-empty'>Not Set</span>")</div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Pay Period</div>
                                        <div class="data-value">
                                            @(Model.PayMonth?.ToString() ?? "N/A") / @(Model.PayYear?.ToString() ?? "N/A")
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Calendar Day</div>
                                        <div class="data-value datetime-value">
                                            @(Model.CalendarDay?.ToString("yyyy-MM-dd HH:mm") ?? "<span class='data-value-empty'>Not Set</span>")
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Session Number</div>
                                        <div class="data-value">@(Model.RelatedPartySessionNo ?? "<span class='data-value-empty'>Not Set</span>")</div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Session Status</div>
                                        <div class="data-value">
                                            @switch (Model.SessionStatus)
                                            {
                                                case 0:<span class="badge badge-boolean badge-true">Active</span>; break;
                                                case 1: <span class="badge badge-boolean badge-false">Inactive</span>; break;
                                                default: <span class="data-value-empty">Not Set</span>; break;
                                            }
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Attendance Status</div>
                                        <div class="data-value">@(Model.AttendanceStatus ?? "<span class='data-value-empty'>Not Set</span>")</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Time Tracking -->
                            <div class="data-section">
                                <h4 class="section-title">
                                    <i class="fas fa-clock me-2"></i>Time Tracking
                                </h4>

                                <div class="data-grid">
                                    <div class="data-item">
                                        <div class="data-label">Check In</div>
                                        <div class="data-value datetime-value">
                                            @(Model.CheckInDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "<span class='data-value-empty'>Not Recorded</span>")
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Check Out</div>
                                        <div class="data-value datetime-value">
                                            @(Model.CheckOutDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "<span class='data-value-empty'>Not Recorded</span>")
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Actual In</div>
                                        <div class="data-value datetime-value">
                                            @(Model.ActualInDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "<span class='data-value-empty'>Not Recorded</span>")
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Actual Out</div>
                                        <div class="data-value datetime-value">
                                            @(Model.ActualOutDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "<span class='data-value-empty'>Not Recorded</span>")
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Worked Minutes</div>
                                        <div class="data-value">@(Model.WorkedMinutes?.ToString() ?? "0") minutes</div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">OT Minutes</div>
                                        <div class="data-value">@(Model.OTMinutes?.ToString() ?? "0") minutes</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Financial Information -->
                            <div class="data-section">
                                <h4 class="section-title">
                                    <i class="fas fa-money-bill-wave me-2"></i>Financial Information
                                </h4>

                                <div class="data-grid">
                                    <div class="data-item">
                                        <div class="data-label">Bill Total</div>
                                        <div class="data-value">@(Model.BillTotal?.ToString("C2") ?? "<span class='data-value-empty'>$0.00</span>")</div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Final Bill Total</div>
                                        <div class="data-value">@(Model.FinalBillTotal?.ToString("C2") ?? "<span class='data-value-empty'>$0.00</span>")</div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Discount</div>
                                        <div class="data-value">@(Model.Discount?.ToString("C2") ?? "<span class='data-value-empty'>$0.00</span>")</div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Total Sales</div>
                                        <div class="data-value">@(Model.TotalSales?.ToString("C2") ?? "<span class='data-value-empty'>$0.00</span>")</div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Cash Balance</div>
                                        <div class="data-value">@(Model.CashBalace?.ToString("C2") ?? "<span class='data-value-empty'>$0.00</span>")</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Boolean Flags -->
                            <div class="data-section">
                                <h4 class="section-title">
                                    <i class="fas fa-toggle-on me-2"></i>Session Flags
                                </h4>

                                <div class="data-grid">
                                    <div class="data-item">
                                        <div class="data-label">OT Approved</div>
                                        <div class="data-value">
                                            @if (Model.IsOTApproved.HasValue)
                                            {
                                                <span class="badge badge-boolean @(Model.IsOTApproved.Value ? "badge-true" : "badge-false")">
                                                    @(Model.IsOTApproved.Value ? "Yes" : "No")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="data-value-empty">Not Set</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">OT Paid</div>
                                        <div class="data-value">
                                            @if (Model.IsOTPaid.HasValue)
                                            {
                                                <span class="badge badge-boolean @(Model.IsOTPaid.Value ? "badge-true" : "badge-false")">
                                                    @(Model.IsOTPaid.Value ? "Yes" : "No")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="data-value-empty">Not Set</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Home Visit</div>
                                        <div class="data-value">
                                            @if (Model.IsHomeVisit.HasValue)
                                            {
                                                <span class="badge badge-boolean @(Model.IsHomeVisit.Value ? "badge-true" : "badge-false")">
                                                    @(Model.IsHomeVisit.Value ? "Yes" : "No")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="data-value-empty">Not Set</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Recommended</div>
                                        <div class="data-value">
                                            @if (Model.IsRecommended.HasValue)
                                            {
                                                <span class="badge badge-boolean @(Model.IsRecommended.Value ? "badge-true" : "badge-false")">
                                                    @(Model.IsRecommended.Value ? "Yes" : "No")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="data-value-empty">Not Set</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">With Meal</div>
                                        <div class="data-value">
                                            @if (Model.IsWithMeal.HasValue)
                                            {
                                                <span class="badge badge-boolean @(Model.IsWithMeal.Value ? "badge-true" : "badge-false")">
                                                    @(Model.IsWithMeal.Value ? "Yes" : "No")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="data-value-empty">Not Set</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="data-item">
                                        <div class="data-label">Air Conditioned</div>
                                        <div class="data-value">
                                            @if (Model.IsAirConditioned.HasValue)
                                            {
                                                <span class="badge badge-boolean @(Model.IsAirConditioned.Value ? "badge-true" : "badge-false")">
                                                    @(Model.IsAirConditioned.Value ? "Yes" : "No")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="data-value-empty">Not Set</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="action-buttons">
                                @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "deleteForm" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-delete" id="deleteButton">
                                        <i class="fas fa-trash-alt me-2"></i>Confirm Delete
                                    </button>
                                }
                                <a href="@Url.Action("Index")" class="btn btn-cancel">
                                    <i class="fas fa-arrow-left me-2"></i>Back to List
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            // Form submission handling
            $('#deleteForm').on('submit', function (e) {
                e.preventDefault();

                // Show loading spinner
                $('#loadingSpinner').show();
                $('#deleteButton').prop('disabled', true);
                $('#errorMessage').hide();

                // Perform the deletion
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            // Redirect to index page on success
                            window.location.href = '@Url.Action("Index")';
                        } else {
                            showError(response.message || 'An error occurred during deletion.');
                        }
                    },
                    error: function (xhr, status, error) {
                        let errorMessage = 'An error occurred while deleting the record.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                        showError(errorMessage);
                    },
                    complete: function () {
                        $('#loadingSpinner').hide();
                        $('#deleteButton').prop('disabled', false);
                    }
                });
            });

            function showError(message) {
                $('#errorText').text(message);
                $('#errorMessage').show();
                $('html, body').animate({
                    scrollTop: $('#errorMessage').offset().top - 100
                }, 500);
            }

            // Add confirmation for delete
            $('#deleteButton').on('click', function (e) {
                if (!confirm('Are you absolutely sure you want to delete this Related Party Session? This action cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }
            });

            // Add animation to data items
            $('.data-item').each(function (index) {
                $(this).delay(100 * index).animate({ opacity: 1 }, 300);
            });
        });
    </script>
</body>
</html>