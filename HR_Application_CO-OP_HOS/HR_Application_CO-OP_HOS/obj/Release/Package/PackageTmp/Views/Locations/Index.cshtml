@model IEnumerable<HR_Application_CO_OP_HOS.Models.Location>

@{
    ViewBag.Title = "Locations Management";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-map-marker"></i> Locations Management</h1>
            <p class="lead">Manage all hospital locations and departments</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-list"></i> All Locations</h3>
                </div>
                <div class="panel-body">
                    <div class="action-bar mb-4">
                        <div class="row">
                            <div class="col-md-6">
                                @Html.ActionLink("Create New Location", "Create", null, new { @class = "btn btn-success btn-lg" })
                            </div>
                            <div class="col-md-6 text-right">
                                <div class="input-group">
                                    <input type="text" id="searchInput" class="form-control form-control-lg" placeholder="Search locations...">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button" id="searchButton">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="locationsTable">
                            <thead class="thead-dark">
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.LocationName)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.OrderIndex)
                                    </th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.LocationName)</strong>
                                            </td>
                                            <td>
                                                <span class="badge badge-primary">@Html.DisplayFor(modelItem => item.OrderIndex)</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">
                                            <i class="fa fa-exclamation-circle fa-3x mb-3"></i>
                                            <h4>No Locations Found</h4>
                                            <p>No location records available in the system.</p>
                                            @Html.ActionLink("Create First Location", "Create", null, new { @class = "btn btn-primary" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <h5><i class="fa fa-info-circle"></i> Summary</h5>
                                    <p>Total Locations: <strong>@Model.Count()</strong></p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchButton').click(function () {
                filterTable();
            });

            $('#searchInput').keyup(function () {
                filterTable();
            });

            function filterTable() {
                var searchText = $('#searchInput').val().toLowerCase();
                $('#locationsTable tbody tr').each(function () {
                    var rowText = $(this).text().toLowerCase();
                    if (rowText.indexOf(searchText) === -1) {
                        $(this).hide();
                    } else {
                        $(this).show();
                    }
                });
            }

            // Enhanced row hover effects
            $('#locationsTable tbody tr').hover(
                function () {
                    $(this).addClass('table-active');
                },
                function () {
                    $(this).removeClass('table-active');
                }
            );
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
        font-size: 16px;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.3rem;
        opacity: 0.9;
        margin-bottom: 10px;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: white;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%) !important;
        color: white;
    }

    .panel-title {
        font-size: 1.3rem;
        margin: 0;
    }

    .panel-body {
        padding: 25px;
    }

    .action-bar {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        font-size: 1rem;
        padding: 15px 12px;
    }

    .table td {
        padding: 15px 12px;
        vertical-align: middle;
    }

    .btn-group .btn {
        margin: 0 2px;
        border-radius: 5px;
    }

    .summary-card {
        background: #e8f4fd;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #3498db;
    }

    .badge {
        font-size: 0.9rem;
        padding: 6px 12px;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 10px;
            padding-left: 10px;
        }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.1rem;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
        }

            .btn-group .btn {
                margin: 2px 0;
                width: 100%;
            }

        .action-bar .row > div {
            margin-bottom: 10px;
        }
    }
</style>