@model HR_Application_CO_OP_HOS.Models.Location

@{
    ViewBag.Title = "Edit Location";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Location</h1>
            <p class="lead">Update location information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Location Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-container">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            @Html.HiddenFor(model => model.ID)

                            <div class="current-info mb-4">
                                <h5><i class="fa fa-info-circle"></i> Current Information</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Location ID:</strong> @Model.ID
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Current Name:</strong> @Model.LocationName
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.LocationName, htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-map-marker"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.LocationName, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter location name" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.LocationName, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.OrderIndex, htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-sort-numeric-asc"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.OrderIndex, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter order index", type = "number" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.OrderIndex, "", new { @class = "text-danger" })
                                <small class="form-text text-muted">Lower numbers appear first in lists</small>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-warning btn-lg">
                                    <i class="fa fa-save"></i> Update Location
                                </button>
                                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Update History</h3>
                </div>
                <div class="panel-body">
                    <div class="reference-info">
                        <h5><i class="fa fa-clock-o"></i> Last Modified:</h5>
                        <p class="text-muted">No modification history available</p>
                    </div>

                    <div class="reference-info mt-4">
                        <h5><i class="fa fa-lightbulb-o"></i> Editing Tips:</h5>
                        <ul>
                            <li>Update location name carefully</li>
                            <li>Changing order index affects sorting</li>
                            <li>Consider impact on existing records</li>
                            <li>Review changes before saving</li>
                        </ul>
                    </div>

                    <div class="alert alert-warning mt-4">
                        <i class="fa fa-exclamation-triangle"></i>
                        <strong>Note:</strong> Changes will affect all related records immediately.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Auto-focus on first input
            $('#LocationName').focus().select();

            // Form validation enhancement
            $('form').submit(function (e) {
                var locationName = $('#LocationName').val().trim();
                if (locationName === '') {
                    e.preventDefault();
                    $('#LocationName').addClass('is-invalid');
                    return false;
                }
            });

            // Real-time validation
            $('#LocationName').on('input', function () {
                var currentValue = '@Model.LocationName';
                var newValue = $(this).val().trim();

                if (newValue === '') {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                } else if (newValue !== currentValue) {
                    $(this).removeClass('is-invalid').addClass('is-valid is-changed');
                } else {
                    $(this).removeClass('is-invalid is-valid is-changed');
                }
            });

            $('#OrderIndex').on('input', function () {
                var currentValue = '@Model.OrderIndex';
                var newValue = $(this).val();

                if (newValue !== '' && !isNaN(newValue) && newValue >= 0) {
                    if (newValue != currentValue) {
                        $(this).removeClass('is-invalid').addClass('is-valid is-changed');
                    } else {
                        $(this).removeClass('is-invalid is-valid is-changed');
                    }
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                }
            });

            // Show confirmation if changes were made
            window.addEventListener('beforeunload', function (e) {
                var changedFields = $('.is-changed').length;
                if (changedFields > 0) {
                    e.preventDefault();
                    e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.3rem;
        opacity: 0.9;
        margin-bottom: 10px;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: white;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
        color: white;
    }

    .panel-warning .panel-heading {
        background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%) !important;
    }

    .panel-info .panel-heading {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%) !important;
    }

    .panel-title {
        font-size: 1.3rem;
        margin: 0;
    }

    .panel-body {
        padding: 25px;
    }

    .current-info {
        background: #fffbf0;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #f39c12;
    }

    .form-container {
        max-width: 100%;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .control-label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        color: #2c3e50;
    }

    .input-group {
        margin-bottom: 5px;
    }

    .input-group-text {
        background-color: #ecf0f1;
        border: 1px solid #bdc3c7;
    }

    .form-control-lg {
        padding: 12px 16px;
        font-size: 1.1rem;
        border-radius: 0 5px 5px 0;
    }

    .form-actions {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #ecf0f1;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 1.1rem;
        margin-right: 10px;
        margin-bottom: 10px;
    }

    .reference-info {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .is-valid {
        border-color: #27ae60 !important;
        background-color: #f8fff8;
    }

    .is-invalid {
        border-color: #e74c3c !important;
    }

    .is-changed {
        border-left: 4px solid #f39c12 !important;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 10px;
            padding-left: 10px;
        }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.1rem;
        }

        .form-actions .btn {
            width: 100%;
            margin-bottom: 10px;
        }

        .current-info .row > div {
            margin-bottom: 10px;
        }
    }
</style>