@model HR_Application_CO_OP_HOS.Models.Location

@{
    ViewBag.Title = "Create New Location";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create New Location</h1>
            <p class="lead">Add a new hospital location or department</p>
        </div>
    </div>

    <div class="row no-gutters">
        <div class="col-md-8">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Location Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-container">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group">
                                @Html.LabelFor(model => model.LocationName, htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-map-marker"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.LocationName, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter location name" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.LocationName, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.OrderIndex, htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-sort-numeric-asc"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.OrderIndex, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter order index", type = "number" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.OrderIndex, "", new { @class = "text-danger" })
                                <small class="form-text text-muted">Lower numbers appear first in lists</small>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fa fa-save"></i> Create Location
                                </button>
                                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Quick Reference</h3>
                </div>
                <div class="panel-body">
                    <div class="reference-info">
                        <h5><i class="fa fa-lightbulb-o"></i> Tips:</h5>
                        <ul>
                            <li>Use descriptive location names</li>
                            <li>Order index determines display sequence</li>
                            <li>Lower numbers appear first</li>
                            <li>Keep names consistent across the system</li>
                        </ul>
                    </div>

                    <div class="reference-info mt-4">
                        <h5><i class="fa fa-exclamation-triangle"></i> Common Locations:</h5>
                        <ul>
                            <li>Main Hospital Building</li>
                            <li>Emergency Department</li>
                            <li>Outpatient Department</li>
                            <li>Intensive Care Unit</li>
                            <li>Operating Theaters</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Auto-focus on first input
            $('#LocationName').focus();

            // Form validation enhancement
            $('form').submit(function (e) {
                var locationName = $('#LocationName').val().trim();
                if (locationName === '') {
                    e.preventDefault();
                    $('#LocationName').addClass('is-invalid');
                    return false;
                }
            });

            // Real-time validation
            $('#LocationName').on('input', function () {
                if ($(this).val().trim() !== '') {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                }
            });

            $('#OrderIndex').on('input', function () {
                var value = $(this).val();
                if (value !== '' && !isNaN(value) && value >= 0) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.3rem;
        opacity: 0.9;
        margin-bottom: 10px;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: white;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
        color: white;
    }

    .panel-success .panel-heading {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%) !important;
    }

    .panel-info .panel-heading {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%) !important;
    }

    .panel-title {
        font-size: 1.3rem;
        margin: 0;
    }

    .panel-body {
        padding: 25px;
    }

    .form-container {
        max-width: 100%;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .control-label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        color: #2c3e50;
    }

    .input-group {
        margin-bottom: 5px;
    }

    .input-group-text {
        background-color: #ecf0f1;
        border: 1px solid #bdc3c7;
    }

    .form-control-lg {
        padding: 12px 16px;
        font-size: 1.1rem;
        border-radius: 0 5px 5px 0;
    }

    .form-actions {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #ecf0f1;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 1.1rem;
        margin-right: 10px;
    }

    .reference-info {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

        .reference-info h5 {
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .reference-info ul {
            padding-left: 20px;
            margin-bottom: 0;
        }

        .reference-info li {
            margin-bottom: 5px;
            color: #7f8c8d;
        }

    .is-valid {
        border-color: #27ae60 !important;
    }

    .is-invalid {
        border-color: #e74c3c !important;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 10px;
            padding-left: 10px;
        }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.1rem;
        }

        .form-actions .btn {
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>