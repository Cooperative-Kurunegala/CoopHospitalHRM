@model HR_Application_CO_OP_HOS.Models.Location

@{
    ViewBag.Title = "Create Location";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="fullscreen-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">CREATE LOCATION</h1>
            <p class="hospital-subtitle">Hospital Human Resources Management System</p>
            <div class="admin-info">
                <span class="admin-welcome">Add New Location</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="content-section">
        <div class="form-container">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-card">
                    <div class="form-header">
                        <h2>📍 Location Information</h2>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-grid">
                        <div class="form-group">
                            @Html.LabelFor(model => model.LocationName, htmlAttributes: new { @class = "control-label" })
                            <div class="form-input">
                                @Html.EditorFor(model => model.LocationName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter location name" } })
                                @Html.ValidationMessageFor(model => model.LocationName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Address, htmlAttributes: new { @class = "control-label" })
                            <div class="form-input">
                                @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter full address" } })
                                @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })
                            <div class="form-input">
                                <div class="checkbox-container">
                                    @Html.EditorFor(model => model.IsActive)
                                    @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-success btn-lg">
                            <span class="btn-icon">💾</span>
                            CREATE LOCATION
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                            <span class="btn-icon">←</span>
                            BACK TO LIST
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<style>
    .fullscreen-container {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .dashboard-header {
        background: rgba(0, 0, 0, 0.8);
        color: white;
        padding: 30px 0;
        border-bottom: 4px solid #006400;
    }

    .header-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .hospital-name {
        font-size: 3rem;
        font-weight: bold;
        margin-bottom: 10px;
        color: #ffffff;
    }

    .hospital-subtitle {
        font-size: 1.5rem;
        margin-bottom: 20px;
        color: #cccccc;
    }

    .admin-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.4rem;
        background: rgba(0, 100, 0, 0.3);
        padding: 15px 20px;
        border-radius: 10px;
    }

    .content-section {
        padding: 40px 20px;
    }

    .form-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .form-card {
        background: #ffffff;
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        border: 3px solid #006400;
    }

    .form-header {
        text-align: center;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 3px solid #006400;
    }

        .form-header h2 {
            color: #006400;
            font-size: 2.5rem;
            margin: 0;
        }

    .form-grid {
        display: grid;
        gap: 30px;
        margin-bottom: 40px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .control-label {
        font-weight: bold;
        margin-bottom: 10px;
        color: #333333;
        font-size: 1.4rem;
    }

    .form-input input,
    .form-input textarea {
        width: 100%;
        padding: 15px;
        border: 2px solid #ddd;
        border-radius: 8px;
        font-size: 1.3rem;
        transition: border-color 0.3s ease;
    }

        .form-input input:focus,
        .form-input textarea:focus {
            border-color: #006400;
            outline: none;
        }

    .checkbox-container {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .checkbox-container input[type="checkbox"] {
            width: 25px;
            height: 25px;
        }

    .form-actions {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 40px;
    }

    .btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 15px 30px;
        border: none;
        border-radius: 8px;
        font-size: 1.4rem;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s ease;
        min-width: 200px;
        justify-content: center;
    }

    .btn-success {
        background: #006400;
        color: white;
    }

        .btn-success:hover {
            background: #004d00;
            transform: translateY(-2px);
        }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

        .btn-secondary:hover {
            background: #545b62;
            transform: translateY(-2px);
        }

    .btn-icon {
        font-size: 1.6rem;
    }

    .text-danger {
        color: #dc3545;
        font-size: 1.2rem;
        margin-top: 5px;
    }

    @@media (max-width: 768px) {
        .hospital-name {
            font-size: 2rem;
        }

        .hospital-subtitle {
            font-size: 1.2rem;
        }

        .admin-info {
            flex-direction: column;
            gap: 10px;
            font-size: 1.2rem;
        }

        .form-card {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn {
            min-width: auto;
            width: 100%;
        }
    }
</style>