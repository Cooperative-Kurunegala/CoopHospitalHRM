@model HR_Application_CO_OP_HOS.Models.RelatedPartyOrderPayment

@{
    ViewBag.Title = "Payment Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
            margin: 0;
            width: 100%;
        }

        .page-header {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 30px -20px;
            border-radius: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .details-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .details-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px;
        }

        .details-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .details-body {
            padding: 30px;
        }

        .details-section {
            margin-bottom: 30px;
            padding: 25px;
            border: 2px solid #ecf0f1;
            border-radius: 10px;
            background: #f8f9fa;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #ecf0f1;
        }

            .detail-row:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
            flex: 1;
        }

        .detail-value {
            flex: 2;
            font-size: 1.05rem;
            color: #34495e;
        }

        .btn-action {
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 8px;
            border: none;
            transition: all 0.3s ease;
            font-size: 1.1rem;
            margin-right: 10px;
            text-decoration: none;
            display: inline-block;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            color: white;
        }

        .btn-back {
            background: linear-gradient(135deg, #95a5a6 0%, #bdc3c7 100%);
            color: white;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: white;
            text-decoration: none;
        }

        .status-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-recommended {
            background: #d4edda;
            color: #155724;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .amount-positive {
            color: #27ae60;
            font-weight: 600;
        }

        .amount-negative {
            color: #e74c3c;
            font-weight: 600;
        }

        .reference-panel {
            background: #e8f4fd;
            border-left: 4px solid #3498db;
            padding: 20px;
            border-radius: 8px;
            margin-top: 10px;
        }

        .reference-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        @@media (max-width: 768px) {
            .container-fluid {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
                margin: -15px -15px 20px -15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .details-body {
                padding: 20px;
            }

            .detail-row {
                flex-direction: column;
                align-items: flex-start;
            }

            .detail-label {
                margin-bottom: 5px;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title">
                        <i class="fa fa-credit-card"></i> Payment Details
                    </h1>
                    <p class="page-subtitle">Viewing payment record #@Model.ID</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-action btn-back" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <!-- Main Details -->
                <div class="details-container">
                    <div class="details-header">
                        <h3 class="details-title"><i class="fa fa-info-circle"></i> Payment Information</h3>
                    </div>

                    <div class="details-body">
                        <!-- Basic Information Section -->
                        <div class="details-section">
                            <h4 class="section-title"><i class="fa fa-info-circle"></i> Basic Information</h4>

                            <div class="detail-row">
                                <div class="detail-label">Payment ID</div>
                                <div class="detail-value">@Model.ID</div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Payment Type</div>
                                <div class="detail-value">
                                    @if (Model.PaymentType != null)
                                    {
                                        @Model.PaymentType.PaymentTypeName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Payment Amount</div>
                                <div class="detail-value amount-positive">@Model.PaymentAmount.ToString?("C")</div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Order ID</div>
                                <div class="detail-value">@Model.OrderID</div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Balance</div>
                                <div class="detail-value @(Model.Balance >= 0 ? "amount-positive" : "amount-negative")">
                                    @Model.Balance.ToString?("C")
                                </div>
                            </div>
                        </div>

                        <!-- Payment Timing Section -->
                        <div class="details-section">
                            <h4 class="section-title"><i class="fa fa-calendar"></i> Payment Timing</h4>

                            <div class="detail-row">
                                <div class="detail-label">Payment Date & Time</div>
                                <div class="detail-value">
                                    @if (Model.PaymentDateTime.HasValue)
                                    {
                                        @Model.PaymentDateTime.Value.ToString("MMM dd, yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Admission ID</div>
                                <div class="detail-value">
                                    @if (Model.AdmissionID.HasValue)
                                    {
                                        @Model.AdmissionID.Value
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Credit Card Information Section -->
                        <div class="details-section">
                            <h4 class="section-title"><i class="fa fa-credit-card-alt"></i> Credit Card Information</h4>

                            <div class="detail-row">
                                <div class="detail-label">Credit Card Type</div>
                                <div class="detail-value">
                                    @if (Model.CreditCardType != null)
                                    {
                                        @Model.CreditCardType.CreditCardTypeName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Credit Card Number</div>
                                <div class="detail-value">
                                    @if (!string.IsNullOrEmpty(Model.CreditCardNumber))
                                    {
                                        <span class="text-muted">****</span>@Model.CreditCardNumber.Substring(Math.Max(0, Model.CreditCardNumber.Length - 4))
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Credit Card Expiry</div>
                                <div class="detail-value">
                                    @if (Model.CreditCardExpiryDate.HasValue)
                                    {
                                        @Model.CreditCardExpiryDate.Value.ToString("MMM yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">MCash Code</div>
                                <div class="detail-value">
                                    @if (!string.IsNullOrEmpty(Model.MCashCode))
                                    {
                                        @Model.MCashCode
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Cheque Information Section -->
                        <div class="details-section">
                            <h4 class="section-title"><i class="fa fa-money"></i> Cheque Information</h4>

                            <div class="detail-row">
                                <div class="detail-label">Cheque Number</div>
                                <div class="detail-value">
                                    @if (!string.IsNullOrEmpty(Model.ChequeNumber))
                                    {
                                        @Model.ChequeNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Cheque Date</div>
                                <div class="detail-value">
                                    @if (Model.ChequeDate.HasValue)
                                    {
                                        @Model.ChequeDate.Value.ToString("MMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Account Recommendation Section -->
                        <div class="details-section">
                            <h4 class="section-title"><i class="fa fa-check-circle"></i> Account Recommendation</h4>

                            <div class="detail-row">
                                <div class="detail-label">Accounts Recommended</div>
                                <div class="detail-value">
                                    @if (Model.IsAccountsRecommended == true)
                                    {
                                        <span class="status-badge status-recommended">Recommended</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">Pending</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Recommended By User ID</div>
                                <div class="detail-value">
                                    @if (Model.RecommendedUserID.HasValue)
                                    {
                                        @Model.RecommendedUserID.Value
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Recommendation Comment</div>
                                <div class="detail-value">
                                    @if (!string.IsNullOrEmpty(Model.RecommendedComment))
                                    {
                                        @Model.RecommendedComment
                                    }
                                    else
                                    {
                                        <span class="text-muted">No comments provided</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Quick Actions Panel -->
                <div class="details-container">
                    <div class="details-header">
                        <h3 class="details-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                    </div>
                    <div class="details-body">
                        <div class="alert alert-info">
                            <h5><i class="fa fa-credit-card"></i> Payment Summary</h5>
                            <p>Complete details of payment record #@Model.ID</p>
                        </div>

                        <div class="reference-panel">
                            <div class="reference-title">Payment Overview:</div>
                            <div class="detail-row">
                                <div class="detail-label">Status:</div>
                                <div class="detail-value">
                                    @if (Model.IsAccountsRecommended == true)
                                    {
                                        <span class="status-badge status-recommended">Recommended</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">Pending</span>
                                    }
                                </div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Amount:</div>
                                <div class="detail-value amount-positive">@Model.PaymentAmount.ToString?("C")</div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Balance:</div>
                                <div class="detail-value @(Model.Balance >= 0 ? "amount-positive" : "amount-negative")">
                                    @Model.Balance.ToString?("C")
                                </div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Created:</div>
                                <div class="detail-value">
                                    @if (Model.PaymentDateTime.HasValue)
                                    {
                                        @Model.PaymentDateTime.Value.ToString("MMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 text-center">
                            @Html.ActionLink("Edit Payment", "Edit", new { id = Model.ID }, new { @class = "btn btn-action btn-edit mb-2" })
                            @Html.ActionLink("Delete Payment", "Delete", new { id = Model.ID }, new { @class = "btn btn-action btn-delete mb-2" })
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-action btn-back" })
                        </div>

                        <!-- Related Information -->
                        <div class="reference-panel mt-4">
                            <div class="reference-title">Related Information:</div>
                            <div class="detail-row">
                                <div class="detail-label">Payment Type:</div>
                                <div class="detail-value">
                                    @if (Model.PaymentType != null)
                                    {
                                        @Model.PaymentType.PaymentTypeName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not set</span>
                                    }
                                </div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Credit Card Type:</div>
                                <div class="detail-value">
                                    @if (Model.CreditCardType != null)
                                    {
                                        @Model.CreditCardType.CreditCardTypeName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not set</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Add print functionality
            $('.btn-print').on('click', function () {
                window.print();
            });

            // Add confirmation for delete action
            $('.btn-delete').on('click', function (e) {
                if (!confirm('Are you sure you want to delete this payment record? This action cannot be undone.')) {
                    e.preventDefault();
                }
            });

            // Enhanced error handling
            $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                console.error('AJAX Error:', thrownError);
                alert('An error occurred while processing your request. Please try again.');
            });

            // Add loading states for actions
            $('.btn-action').on('click', function () {
                const $this = $(this);
                const originalText = $this.html();
                $this.html('<i class="fa fa-spinner fa-spin"></i> Loading...').prop('disabled', true);

                setTimeout(() => {
                    $this.html(originalText).prop('disabled', false);
                }, 2000);
            });
        });
    </script>
</body>
</html>