@model HR_Application_CO_OP_HOS.Models.RelatedPartyOrderPayment

@{
    ViewBag.Title = "Edit Payment";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
            margin: 0;
            width: 100%;
        }

        .page-header {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 30px -20px;
            border-radius: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .form-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .form-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px;
        }

        .form-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .form-body {
            padding: 30px;
        }

        .form-section {
            margin-bottom: 30px;
            padding: 25px;
            border: 2px solid #ecf0f1;
            border-radius: 10px;
            background: #f8f9fa;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .control-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1.05rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .text-danger {
            font-size: 0.95rem;
            margin-top: 5px;
            font-weight: 500;
        }

        .btn-action {
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 8px;
            border: none;
            transition: all 0.3s ease;
            font-size: 1.1rem;
            margin-right: 10px;
        }

        .btn-save {
            background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
            color: white;
        }

        .btn-back {
            background: linear-gradient(135deg, #95a5a6 0%, #bdc3c7 100%);
            color: white;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .current-value {
            background: #e8f4fd;
            padding: 10px 15px;
            border-radius: 6px;
            margin-top: 5px;
            border-left: 4px solid #3498db;
        }

        .reference-panel {
            background: #e8f4fd;
            border-left: 4px solid #3498db;
            padding: 20px;
            border-radius: 8px;
            margin-top: 10px;
        }

        .reference-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .reference-item {
            padding: 8px 0;
            border-bottom: 1px solid #d1ecf1;
        }

            .reference-item:last-child {
                border-bottom: none;
            }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        @@media (max-width: 768px) {
            .container-fluid {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
                margin: -15px -15px 20px -15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .form-body {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title">
                        <i class="fa fa-edit"></i> Edit Payment
                    </h1>
                    <p class="page-subtitle">Update payment record #@Model.ID</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-action btn-back" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <!-- Main Form -->
                <div class="form-container">
                    <div class="form-header">
                        <h3 class="form-title"><i class="fa fa-credit-card"></i> Edit Payment Information</h3>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-body">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            @Html.HiddenFor(model => model.ID)

                            <!-- Basic Information Section -->
                            <div class="form-section">
                                <h4 class="section-title"><i class="fa fa-info-circle"></i> Basic Information</h4>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PaymentTypeID, "Payment Type", htmlAttributes: new { @class = "control-label" })
                                            @Html.DropDownList("PaymentTypeID", null, "Select Payment Type", htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.PaymentTypeID, "", new { @class = "text-danger" })

                                            <!-- Current Value -->
                                            <div class="current-value">
                                                <strong>Current:</strong>
                                                @if (Model.PaymentType != null)
                                                {
                                                    @Model.PaymentType.PaymentTypeName
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PaymentAmount, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.PaymentAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                            @Html.ValidationMessageFor(model => model.PaymentAmount, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong> @Model.PaymentAmount.ToString?("C")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OrderID, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.OrderID, new { htmlAttributes = new { @class = "form-control", placeholder = "Order ID" } })
                                            @Html.ValidationMessageFor(model => model.OrderID, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong> @Model.OrderID
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Balance, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.Balance, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                            @Html.ValidationMessageFor(model => model.Balance, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong> @Model.Balance.ToString?("C")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Credit Card Information Section -->
                            <div class="form-section">
                                <h4 class="section-title"><i class="fa fa-credit-card-alt"></i> Credit Card Information</h4>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CreditCardTypeID, "Credit Card Type", htmlAttributes: new { @class = "control-label" })
                                            @Html.DropDownList("CreditCardTypeID", null, "Select Card Type", htmlAttributes: new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.CreditCardTypeID, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong>
                                                @if (Model.CreditCardType != null)
                                                {
                                                    @Model.CreditCardType.CreditCardTypeName
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CreditCardNumber, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.CreditCardNumber, new { htmlAttributes = new { @class = "form-control", placeholder = "Card Number" } })
                                            @Html.ValidationMessageFor(model => model.CreditCardNumber, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong>
                                                @if (!string.IsNullOrEmpty(Model.CreditCardNumber))
                                                {
                                                    <span class="text-muted">****</span>@Model.CreditCardNumber.Substring(Math.Max(0, Model.CreditCardNumber.Length - 4))
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CreditCardExpiryDate, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.CreditCardExpiryDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                            @Html.ValidationMessageFor(model => model.CreditCardExpiryDate, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong>
                                                @if (Model.CreditCardExpiryDate.HasValue)
                                                {
                                                    @Model.CreditCardExpiryDate.Value.ToString("MMM dd, yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.MCashCode, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.MCashCode, new { htmlAttributes = new { @class = "form-control", placeholder = "MCash Code" } })
                                            @Html.ValidationMessageFor(model => model.MCashCode, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong>
                                                @(string.IsNullOrEmpty(Model.MCashCode) ? "Not set" : Model.MCashCode)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Account Recommendation Section -->
                            <div class="form-section">
                                <h4 class="section-title"><i class="fa fa-check-circle"></i> Account Recommendation</h4>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <div class="checkbox-container">
                                                @Html.EditorFor(model => model.IsAccountsRecommended)
                                                @Html.LabelFor(model => model.IsAccountsRecommended, htmlAttributes: new { @class = "control-label mb-0" })
                                            </div>
                                            @Html.ValidationMessageFor(model => model.IsAccountsRecommended, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong>
                                                <span class="@(Model.IsAccountsRecommended == true ? "text-success" : "text-warning")">
                                                    @(Model.IsAccountsRecommended == true ? "Recommended" : "Pending")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.RecommendedUserID, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.RecommendedUserID, new { htmlAttributes = new { @class = "form-control", placeholder = "User ID" } })
                                            @Html.ValidationMessageFor(model => model.RecommendedUserID, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong> @Model.RecommendedUserID
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.RecommendedComment, htmlAttributes: new { @class = "control-label" })
                                            @Html.EditorFor(model => model.RecommendedComment, new { htmlAttributes = new { @class = "form-control", placeholder = "Recommendation comments..." } })
                                            @Html.ValidationMessageFor(model => model.RecommendedComment, "", new { @class = "text-danger" })

                                            <div class="current-value">
                                                <strong>Current:</strong>
                                                @(string.IsNullOrEmpty(Model.RecommendedComment) ? "No comments" : Model.RecommendedComment)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Form Actions -->
                            <div class="form-group text-center mt-4">
                                <button type="submit" class="btn btn-action btn-save">
                                    <i class="fa fa-save"></i> Save Changes
                                </button>
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-action btn-back" })
                                @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-primary btn-action" })
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Quick Actions Panel -->
                <div class="form-container">
                    <div class="form-header">
                        <h3 class="form-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                    </div>
                    <div class="form-body">
                        <div class="alert alert-warning">
                            <h5><i class="fa fa-exclamation-triangle"></i> Editing Payment</h5>
                            <p>You are editing payment record #@Model.ID. Changes will be saved immediately.</p>
                        </div>

                        <div class="reference-panel">
                            <div class="reference-title">Payment Summary:</div>
                            <div class="reference-item">
                                <strong>ID:</strong> @Model.ID
                            </div>
                            <div class="reference-item">
                                <strong>Amount:</strong> @Model.PaymentAmount.ToString?("C")
                            </div>
                            <div class="reference-item">
                                <strong>Order ID:</strong> @Model.OrderID
                            </div>
                            <div class="reference-item">
                                <strong>Status:</strong>
                                <span class="@(Model.IsAccountsRecommended == true ? "text-success" : "text-warning")">
                                    @(Model.IsAccountsRecommended == true ? "Recommended" : "Pending")
                                </span>
                            </div>
                            <div class="reference-item">
                                <strong>Last Updated:</strong>
                                @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
                            </div>
                        </div>

                        <div class="mt-3">
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-block mb-2" })
                            @Html.ActionLink("Delete Payment", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-block" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            // Enhanced form validation
            $('form').on('submit', function (e) {
                const $form = $(this);
                const $submitBtn = $form.find('button[type="submit"]');
                const originalText = $submitBtn.html();

                // Show loading state
                $submitBtn.html('<i class="fa fa-spinner fa-spin"></i> Saving...').prop('disabled', true);

                // Simulate processing delay
                setTimeout(() => {
                    if (!$form.valid()) {
                        $submitBtn.html(originalText).prop('disabled', false);
                        $('html, body').animate({
                            scrollTop: $('.text-danger:first').offset().top - 100
                        }, 500);
                    }
                }, 1000);
            });

            // Real-time amount formatting
            $('#PaymentAmount, #Balance').on('blur', function () {
                const value = parseFloat($(this).val());
                if (!isNaN(value)) {
                    $(this).val(value.toFixed(2));
                }
            });

            // Credit card number formatting
            $('#CreditCardNumber').on('input', function () {
                let value = $(this).val().replace(/\s+/g, '').replace(/[^0-9]/gi, '');
                let matches = value.match(/\d{4,16}/g);
                let match = matches && matches[0] || '';
                let parts = [];

                for (let i = 0; i < match.length; i += 4) {
                    parts.push(match.substring(i, i + 4));
                }

                if (parts.length) {
                    $(this).val(parts.join(' '));
                }
            });

            // Handle confirmation for significant changes
            $('#PaymentAmount, #Balance').on('change', function () {
                const originalValue = parseFloat('@Model.PaymentAmount');
                const newValue = parseFloat($(this).val());

                if (!isNaN(newValue) && Math.abs(newValue - originalValue) > 1000) {
                    if (!confirm('You are making a significant change to the payment amount. Are you sure?')) {
                        $(this).val(originalValue.toFixed(2));
                    }
                }
            });

            // Handle errors gracefully
            $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                console.error('AJAX Error:', thrownError);
                alert('An error occurred while saving your changes. Please try again.');

                // Re-enable submit button
                $('button[type="submit"]').html('<i class="fa fa-save"></i> Save Changes').prop('disabled', false);
            });
        });
    </script>
</body>
</html>