@model HR_Application_CO_OP_HOS.Models.RelatedPartyOrderPayment

@{
    ViewBag.Title = "Delete Payment";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 20px;
            margin: 0;
            width: 100%;
        }

        .page-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 30px -20px;
            border-radius: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .delete-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .delete-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px;
        }

        .delete-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .delete-body {
            padding: 30px;
        }

        .warning-section {
            background: #f8d7da;
            border: 2px solid #f5c6cb;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .warning-icon {
            font-size: 3rem;
            color: #dc3545;
            margin-bottom: 15px;
        }

        .warning-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #721c24;
            margin-bottom: 10px;
        }

        .warning-text {
            color: #721c24;
            font-size: 1.1rem;
            margin-bottom: 0;
        }

        .details-section {
            margin-bottom: 30px;
            padding: 25px;
            border: 2px solid #ecf0f1;
            border-radius: 10px;
            background: #f8f9fa;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #ecf0f1;
        }

            .detail-row:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.1rem;
            flex: 1;
        }

        .detail-value {
            flex: 2;
            font-size: 1.05rem;
            color: #34495e;
        }

        .btn-action {
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 8px;
            border: none;
            transition: all 0.3s ease;
            font-size: 1.1rem;
            margin-right: 10px;
            text-decoration: none;
            display: inline-block;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #bdc3c7 100%);
            color: white;
        }

        .btn-back {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: white;
            text-decoration: none;
        }

        .status-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-recommended {
            background: #d4edda;
            color: #155724;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .amount-positive {
            color: #27ae60;
            font-weight: 600;
        }

        .amount-negative {
            color: #e74c3c;
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .container-fluid {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
                margin: -15px -15px 20px -15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .delete-body {
                padding: 20px;
            }

            .detail-row {
                flex-direction: column;
                align-items: flex-start;
            }

            .detail-label {
                margin-bottom: 5px;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="page-title">
                        <i class="fa fa-trash"></i> Delete Payment
                    </h1>
                    <p class="page-subtitle">Remove payment record from the system</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-action btn-back" })
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <!-- Delete Confirmation -->
                <div class="delete-container">
                    <div class="delete-header">
                        <h3 class="delete-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                    </div>

                    <div class="delete-body">
                        <!-- Warning Section -->
                        <div class="warning-section text-center">
                            <div class="warning-icon">
                                <i class="fa fa-exclamation-circle"></i>
                            </div>
                            <h3 class="warning-title">Warning: Irreversible Action</h3>
                            <p class="warning-text">
                                You are about to permanently delete payment record <strong>#@Model.ID</strong>.
                                This action cannot be undone and all associated data will be lost.
                            </p>
                        </div>

                        <!-- Payment Details Section -->
                        <div class="details-section">
                            <h4 class="section-title"><i class="fa fa-credit-card"></i> Payment Details to be Deleted</h4>

                            <div class="detail-row">
                                <div class="detail-label">Payment ID</div>
                                <div class="detail-value">@Model.ID</div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Payment Type</div>
                                <div class="detail-value">
                                    @if (Model.PaymentType != null)
                                    {
                                        @Model.PaymentType.PaymentTypeName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Payment Amount</div>
                                <div class="detail-value amount-positive">@Model.PaymentAmount.ToString?("C")</div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Order ID</div>
                                <div class="detail-value">@Model.OrderID</div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Balance</div>
                                <div class="detail-value @(Model.Balance >= 0 ? "amount-positive" : "amount-negative")">
                                    @Model.Balance.ToString?("C")
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Payment Date</div>
                                <div class="detail-value">
                                    @if (Model.PaymentDateTime.HasValue)
                                    {
                                        @Model.PaymentDateTime.Value.ToString("MMM dd, yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not specified</span>
                                    }
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Account Status</div>
                                <div class="detail-value">
                                    @if (Model.IsAccountsRecommended == true)
                                    {
                                        <span class="status-badge status-recommended">Recommended</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">Pending</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Additional Warning -->
                        <div class="alert alert-warning">
                            <h5><i class="fa fa-warning"></i> Important Considerations</h5>
                            <ul class="mb-0">
                                <li>This action will permanently remove the payment record from the database</li>
                                <li>Financial reports may be affected by this deletion</li>
                                <li>Audit trails will still reference this deletion action</li>
                                <li>Make sure you have proper backups before proceeding</li>
                            </ul>
                        </div>

                        <!-- Delete Form -->
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-group text-center mt-4">
                                <button type="submit" class="btn btn-action btn-delete" id="deleteButton">
                                    <i class="fa fa-trash"></i> Confirm Delete
                                </button>
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-action btn-cancel" })
                                @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-action btn-back" })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Enhanced delete confirmation
            $('#deleteButton').on('click', function (e) {
                e.preventDefault();

                const $button = $(this);
                const originalText = $button.html();

                // Show enhanced confirmation
                if (confirm('⚠️ FINAL WARNING: This will permanently delete payment record #@Model.ID. This action cannot be undone!\n\nAre you absolutely sure you want to proceed?')) {
                    // Double confirmation for significant amounts
                    if (@Model.PaymentAmount > 1000) {
                        if (!confirm('💰 This payment amount is significant ($@Model.PaymentAmount). Are you really sure you want to delete this record?')) {
                            return false;
                        }
                    }

                    // Show loading state
                    $button.html('<i class="fa fa-spinner fa-spin"></i> Deleting...').prop('disabled', true);

                    // Submit the form
                    $button.closest('form').submit();
                }

                return false;
            });

            // Prevent accidental form submission
            $('form').on('submit', function (e) {
                const $button = $('#deleteButton');
                if ($button.prop('disabled')) {
                    e.preventDefault();
                }
            });

            // Handle errors gracefully
            $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
                console.error('AJAX Error:', thrownError);
                alert('An error occurred while deleting the record. Please try again.');

                // Re-enable delete button
                $('#deleteButton').html('<i class="fa fa-trash"></i> Confirm Delete').prop('disabled', false);
            });

            // Add keyboard shortcuts
            $(document).on('keydown', function (e) {
                // Escape key to cancel
                if (e.key === 'Escape') {
                    window.location.href = '@Url.Action("Index")';
                }
            });
        });
    </script>
</body>
</html>