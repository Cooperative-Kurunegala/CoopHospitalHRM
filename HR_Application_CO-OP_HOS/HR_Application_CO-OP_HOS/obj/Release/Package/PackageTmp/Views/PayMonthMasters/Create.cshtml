@model HR_Application_CO_OP_HOS.Models.PayMonthMaster

@{
    ViewBag.Title = "Create Pay Month";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create Pay Month</h1>
            <p class="lead">Add new payroll month period</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calendar-plus-o"></i> Pay Month Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PayMonth, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.PayMonth, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter month (1-12)" } })
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.PayMonth, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PayYear, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.PayYear, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter year", @Value = DateTime.Now.Year } })
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa fa-calendar-check-o"></i></span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.PayYear, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StartDate, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control datepicker", @Value = DateTime.Now.ToString("yyyy-MM-dd") } })
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa fa-play"></i></span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EndDate, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.EndDate, new { htmlAttributes = new { @class = "form-control datepicker", @Value = DateTime.Now.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd") } })
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa fa-stop"></i></span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="form-check">
                                            @Html.EditorFor(model => model.isCurrentMonth, new { htmlAttributes = new { @class = "form-check-input" } })
                                            @Html.LabelFor(model => model.isCurrentMonth, htmlAttributes: new { @class = "form-check-label" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.isCurrentMonth, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="form-check">
                                            @Html.EditorFor(model => model.isProcessed, new { htmlAttributes = new { @class = "form-check-input" } })
                                            @Html.LabelFor(model => model.isProcessed, htmlAttributes: new { @class = "form-check-label" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.isProcessed, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter creator ID" } })
                                        @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedDateTime, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CreatedDateTime, new { htmlAttributes = new { @class = "form-control", @Value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") } })
                                        @Html.ValidationMessageFor(model => model.CreatedDateTime, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="btn-toolbar">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fa fa-save"></i> Create Pay Month
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Information Panel -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Quick Guide</h3>
                </div>
                <div class="panel-body">
                    <div class="info-item">
                        <h5><i class="fa fa-calendar text-primary"></i> Pay Month</h5>
                        <p>Enter the month number (1-12) for the payroll period</p>
                    </div>
                    <div class="info-item">
                        <h5><i class="fa fa-calendar-check-o text-success"></i> Pay Year</h5>
                        <p>Enter the year for the payroll period</p>
                    </div>
                    <div class="info-item">
                        <h5><i class="fa fa-star text-warning"></i> Current Month</h5>
                        <p>Mark this as the current active payroll month</p>
                    </div>
                    <div class="info-item">
                        <h5><i class="fa fa-check-circle text-info"></i> Processed</h5>
                        <p>Indicate if payroll processing is completed for this month</p>
                    </div>
                </div>
            </div>

            <!-- Validation Summary -->
            <div class="panel panel-warning" id="validationPanel" style="display: none;">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Validation Issues</h3>
                </div>
                <div class="panel-body" id="validationIssues">
                    <!-- Validation messages will appear here -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Date picker enhancement
            $('.datepicker').attr('type', 'date');

            // Auto-calculate end date based on start date
            $('#StartDate').on('change', function () {
                var startDate = new Date($(this).val());
                if (!isNaN(startDate.getTime())) {
                    var endDate = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 0);
                    $('#EndDate').val(endDate.toISOString().split('T')[0]);
                }
            });

            // Real-time validation
            $('form').on('submit', function (e) {
                var isValid = true;
                var issues = [];

                // Validate month range
                var month = parseInt($('#PayMonth').val());
                if (month < 1 || month > 12) {
                    isValid = false;
                    issues.push('Pay Month must be between 1 and 12');
                }

                // Validate year
                var year = parseInt($('#PayYear').val());
                var currentYear = new Date().getFullYear();
                if (year < currentYear - 1 || year > currentYear + 1) {
                    isValid = false;
                    issues.push('Pay Year seems unusual. Please verify.');
                }

                // Validate date range
                var startDate = new Date($('#StartDate').val());
                var endDate = new Date($('#EndDate').val());
                if (startDate >= endDate) {
                    isValid = false;
                    issues.push('End Date must be after Start Date');
                }

                if (!isValid) {
                    e.preventDefault();
                    $('#validationIssues').html('<ul>' + issues.map(issue => '<li>' + issue + '</li>').join('') + '</ul>');
                    $('#validationPanel').show();
                } else {
                    $('#validationPanel').hide();
                }

                return isValid;
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 30px;
    }

    .panel-heading {
        border-radius: 15px 15px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .control-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 16px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .input-group-text {
        background-color: #f8f9fa;
        border: 2px solid #e9ecef;
        border-left: none;
    }

    .input-group .form-control {
        border-right: none;
    }

    .btn-toolbar {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
    }

    .info-item {
        padding: 15px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-item h5 {
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .info-item p {
            color: #6c757d;
            margin: 0;
            font-size: 14px;
        }

    .alert {
        border-radius: 8px;
        padding: 15px 20px;
    }

    .form-check {
        padding: 10px 0;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-right: 10px;
    }

    .form-check-label {
        font-weight: 500;
        color: #2c3e50;
    }
</style>