@model HR_Application_CO_OP_HOS.Models.PayMonthMaster

@{
    ViewBag.Title = "Edit Pay Month";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Pay Month</h1>
            <p class="lead">Update payroll month details</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calendar-check-o"></i> Edit Pay Month Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PayMonth, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.PayMonth, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter month (1-12)" } })
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.PayMonth, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PayYear, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.PayYear, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter year" } })
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa fa-calendar-check-o"></i></span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.PayYear, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StartDate, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa fa-play"></i></span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EndDate, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.EndDate, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                            <div class="input-group-append">
                                                <span class="input-group-text"><i class="fa fa-stop"></i></span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="form-check">
                                            @Html.EditorFor(model => model.isCurrentMonth, new { htmlAttributes = new { @class = "form-check-input" } })
                                            @Html.LabelFor(model => model.isCurrentMonth, htmlAttributes: new { @class = "form-check-label" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.isCurrentMonth, "", new { @class = "text-danger" })
                                        <small class="form-text text-muted">
                                            @if (Model.isCurrentMonth == true)
                                            {
                                                <span class="text-success"><i class="fa fa-check-circle"></i> This is currently set as active month</span>
                                            }
                                        </small>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <div class="form-check">
                                            @Html.EditorFor(model => model.isProcessed, new { htmlAttributes = new { @class = "form-check-input" } })
                                            @Html.LabelFor(model => model.isProcessed, htmlAttributes: new { @class = "form-check-label" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.isProcessed, "", new { @class = "text-danger" })
                                        <small class="form-text text-muted">
                                            @if (Model.isProcessed == true)
                                            {
                                                <span class="text-info"><i class="fa fa-check-circle"></i> Payroll processing completed</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning"><i class="fa fa-clock-o"></i> Payroll processing pending</span>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", style = "background-color: #f8f9fa;" } })
                                        <small class="form-text text-muted">Original creator (read-only)</small>
                                        @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedDateTime, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CreatedDateTime, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", style = "background-color: #f8f9fa;" } })
                                        <small class="form-text text-muted">Creation timestamp (read-only)</small>
                                        @Html.ValidationMessageFor(model => model.CreatedDateTime, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="btn-toolbar">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fa fa-save"></i> Update Pay Month
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Current Status Panel -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Current Status</h3>
                </div>
                <div class="panel-body">
                    <div class="status-item">
                        <h5>Record ID</h5>
                        <p class="text-mono">#@Model.ID</p>
                    </div>
                    <div class="status-item">
                        <h5>Current Status</h5>
                        <p>
                            @if (Model.isCurrentMonth == true)
                            {
                                <span class="badge badge-success">Active Month</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Inactive Month</span>
                            }
                        </p>
                    </div>
                    <div class="status-item">
                        <h5>Processing Status</h5>
                        <p>
                            @if (Model.isProcessed == true)
                            {
                                <span class="badge badge-info">Processed</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Pending</span>
                            }
                        </p>
                    </div>
                    <div class="status-item">
                        <h5>Duration</h5>
                        <p>
                            @{
                                string durationText;
                                if (Model.StartDate.HasValue && Model.EndDate.HasValue)
                                {
                                    var days = (Model.EndDate.Value - Model.StartDate.Value).Days + 1;
                                    durationText = days.ToString() + " days";
                                }
                                else
                                {
                                    durationText = "N/A";
                                }
                            }
                            @durationText
                        </p>
                    </div>
                    <div class="status-item">
                        <h5>Created</h5>
                        <p>@(Model.CreatedDateTime.HasValue ? Model.CreatedDateTime.Value.ToString("MMM dd, yyyy HH:mm") : "N/A")</p>
                    </div>
                </div>
            </div>

            <!-- Validation Panel -->
            <div class="panel panel-warning" id="validationPanel" style="display: none;">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Validation Issues</h3>
                </div>
                <div class="panel-body" id="validationIssues">
                    <!-- Validation messages will appear here -->
                </div>
            </div>

            <!-- Actions Panel -->
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Dangerous Actions</h3>
                </div>
                <div class="panel-body">
                    <p class="text-muted">Be careful with these actions:</p>
                    <div class="btn-group-vertical w-100">
                        @Html.ActionLink("Delete this Record", "Delete", new { id = Model.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                        @Html.ActionLink("Reset to Defaults", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-warning btn-sm" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Date picker enhancement
            $('.datepicker').attr('type', 'date');

            // Auto-calculate end date based on start date
            $('#StartDate').on('change', function () {
                var startDate = new Date($(this).val());
                if (!isNaN(startDate.getTime())) {
                    var endDate = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 0);
                    $('#EndDate').val(endDate.toISOString().split('T')[0]);
                }
            });

            // Real-time validation
            $('form').on('submit', function (e) {
                var isValid = true;
                var issues = [];

                // Validate month range
                var month = parseInt($('#PayMonth').val());
                if (month < 1 || month > 12) {
                    isValid = false;
                    issues.push('Pay Month must be between 1 and 12');
                }

                // Validate date range
                var startDate = new Date($('#StartDate').val());
                var endDate = new Date($('#EndDate').val());
                if (startDate >= endDate) {
                    isValid = false;
                    issues.push('End Date must be after Start Date');
                }

                if (!isValid) {
                    e.preventDefault();
                    $('#validationIssues').html('<ul>' + issues.map(issue => '<li>' + issue + '</li>').join('') + '</ul>');
                    $('#validationPanel').show();
                } else {
                    $('#validationPanel').hide();
                }

                return isValid;
            });

            // Warn if making current month when others exist
            $('#isCurrentMonth').on('change', function () {
                if ($(this).is(':checked')) {
                    if (!confirm('Setting this as current month will affect payroll calculations. Continue?')) {
                        $(this).prop('checked', false);
                    }
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 30px;
    }

    .panel-heading {
        border-radius: 15px 15px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .control-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 16px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

        .form-control[readonly] {
            background-color: #f8f9fa;
            color: #6c757d;
        }

    .input-group-text {
        background-color: #f8f9fa;
        border: 2px solid #e9ecef;
        border-left: none;
    }

    .input-group .form-control {
        border-right: none;
    }

    .btn-toolbar {
        display: flex;
        gap: 15px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 16px;
        border-radius: 8px;
    }

    .status-item {
        padding: 12px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .status-item:last-child {
            border-bottom: none;
        }

        .status-item h5 {
            color: #2c3e50;
            margin-bottom: 5px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-item p {
            color: #2c3e50;
            margin: 0;
            font-weight: 500;
        }

    .text-mono {
        font-family: 'Courier New', monospace;
        background: #f8f9fa;
        padding: 5px 10px;
        border-radius: 4px;
        display: inline-block;
    }

    .badge {
        font-size: 12px;
        padding: 6px 12px;
    }

    .alert {
        border-radius: 8px;
        padding: 15px 20px;
    }

    .form-check {
        padding: 10px 0;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-right: 10px;
    }

    .form-check-label {
        font-weight: 500;
        color: #2c3e50;
    }

    .form-text.text-muted {
        font-size: 13px;
        margin-top: 5px;
    }

    .btn-group-vertical .btn {
        margin-bottom: 8px;
        text-align: left;
    }
</style>