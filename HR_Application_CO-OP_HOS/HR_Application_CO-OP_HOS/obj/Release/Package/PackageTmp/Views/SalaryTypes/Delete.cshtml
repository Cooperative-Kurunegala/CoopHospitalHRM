@model HR_Application_CO_OP_HOS.Models.SalaryType

@{
    ViewBag.Title = "Delete Salary Type - HR Management System";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Salary Type</h1>
            <p class="lead">Remove salary type from the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Confirmation Section -->
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-danger">
                        <h4><i class="fa fa-warning"></i> Warning: This action cannot be undone!</h4>
                        <p>You are about to permanently delete this salary type. This action will affect all associated records.</p>
                    </div>

                    <div class="confirmation-details">
                        <h5>You are deleting the following salary type:</h5>

                        <div class="detail-card">
                            <div class="detail-item">
                                <strong>ID:</strong>
                                <span class="badge badge-danger">@Model.ID</span>
                            </div>
                            <div class="detail-item">
                                <strong>Name:</strong>
                                <span>@Model.SalaryTypeName</span>
                            </div>
                            <div class="detail-item">
                                <strong>Created Date:</strong>
                                <span>
                                    @if (Model.CreatedDate.HasValue)
                                    {
                                        @Model.CreatedDate.Value.ToString("MMM dd, yyyy hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not set</span>
                                    }
                                </span>
                            </div>
                            <div class="detail-item">
                                <strong>Created By:</strong>
                                <span>
                                    @if (Model.CreatedBy.HasValue)
                                    {
                                        <span>User @Model.CreatedBy.Value</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">System</span>
                                    }
                                </span>
                            </div>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ID)

                            <div class="safety-checks mt-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                    <label class="form-check-label" for="confirmDelete">
                                        I understand that this action cannot be undone
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="confirmBackup" required>
                                    <label class="form-check-label" for="confirmBackup">
                                        I have verified that no critical data depends on this salary type
                                    </label>
                                </div>
                            </div>

                            <div class="action-buttons mt-4">
                                <button type="submit" class="btn btn-danger btn-lg" id="deleteBtn" disabled>
                                    <i class="fa fa-trash"></i> Confirm Delete
                                </button>
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Impact Analysis Section -->
        <div class="col-md-4">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bar-chart"></i> Impact Analysis</h3>
                </div>
                <div class="panel-body">
                    <div class="impact-analysis">
                        <h5><i class="fa fa-users"></i> Affected Employees</h5>
                        <div class="impact-item">
                            <span class="impact-number" id="affectedEmployees">25</span>
                            <span class="impact-label">Employees will be affected</span>
                        </div>

                        <h5><i class="fa fa-money"></i> Payroll Impact</h5>
                        <div class="impact-item">
                            <span class="impact-number" id="payrollRecords">156</span>
                            <span class="impact-label">Payroll records will need update</span>
                        </div>

                        <h5><i class="fa fa-database"></i> Data Impact</h5>
                        <ul class="list-unstyled">
                            <li>• Salary type mapping will be removed</li>
                            <li>• Historical data will be preserved</li>
                            <li>• Reports may need regeneration</li>
                        </ul>

                        <div class="recommendation mt-3">
                            <h5><i class="fa fa-lightbulb-o"></i> Recommendation</h5>
                            <div class="alert alert-info">
                                <strong>Consider archiving instead of deleting</strong>
                                <p>Archiving preserves historical data while removing the type from active use.</p>
                                @Html.ActionLink("Archive Instead", "Edit", new { id = Model.ID }, new { @class = "btn btn-info btn-sm btn-block" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Enable/disable delete button based on checkboxes
            $('.form-check-input').change(function () {
                var allChecked = $('#confirmDelete').is(':checked') && $('#confirmBackup').is(':checked');
                $('#deleteBtn').prop('disabled', !allChecked);
            });

            // Delete button confirmation
            $('#deleteBtn').click(function (e) {
                if (!confirm('Are you absolutely sure you want to delete this salary type? This action is permanent and cannot be undone.')) {
                    e.preventDefault();
                    return false;
                }

                // Show loading state
                $(this).html('<i class="fa fa-spinner fa-spin"></i> Deleting...').prop('disabled', true);
            });

            // Simulate impact analysis data loading
            setTimeout(function () {
                // These would typically come from server-side calculations
                $('#affectedEmployees').text('25');
                $('#payrollRecords').text('156');
            }, 500);

            // Add confirmation dialog for the archive option
            $('a[href*="Edit"]').click(function () {
                return confirm('Redirecting to edit page. Cancel deletion?');
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 30px;
    }

    .alert-danger {
        border-radius: 8px;
        border-left: 6px solid #e74c3c;
    }

    .confirmation-details h5 {
        color: #2c3e50;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .detail-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        border: 2px solid #e9ecef;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #dee2e6;
    }

        .detail-item:last-child {
            border-bottom: none;
        }

    .safety-checks .form-check {
        margin-bottom: 15px;
        padding: 15px;
        background: #fff3cd;
        border-radius: 6px;
        border: 1px solid #ffeaa7;
    }

    .form-check-input {
        transform: scale(1.2);
        margin-right: 10px;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-lg {
        padding: 15px 30px;
        font-size: 16px;
        border-radius: 8px;
        flex: 1;
        min-width: 160px;
    }

    .impact-analysis h5 {
        color: #2c3e50;
        margin-bottom: 15px;
        border-bottom: 2px solid #f39c12;
        padding-bottom: 8px;
    }

    .impact-item {
        text-align: center;
        margin-bottom: 20px;
        padding: 15px;
        background: #fff3cd;
        border-radius: 8px;
    }

    .impact-number {
        display: block;
        font-size: 2.5em;
        font-weight: bold;
        color: #e74c3c;
    }

    .impact-label {
        color: #7f8c8d;
        font-size: 0.9em;
    }

    .impact-analysis ul li {
        padding: 8px 0;
        border-bottom: 1px solid #f8f9fa;
    }

    .recommendation .alert {
        border-radius: 8px;
        border-left: 6px solid #3498db;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .detail-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-lg {
            width: 100%;
            margin-bottom: 10px;
        }

        .safety-checks .form-check {
            padding: 10px;
        }
    }
</style>