@model HR_Application_CO_OP_HOS.Models.SalaryType

@{
    ViewBag.Title = "Create Salary Type - HR Management System";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create New Salary Type</h1>
            <p class="lead">Add a new salary type to the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Salary Type Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group">
                                @Html.LabelFor(model => model.SalaryTypeName, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.SalaryTypeName, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter salary type name" } })
                                    @Html.ValidationMessageFor(model => model.SalaryTypeName, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">e.g., Monthly, Hourly, Contract, etc.</small>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.CreatedDate, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control form-control-lg", @type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Leave empty to use current date and time</small>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter user ID" } })
                                    @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Enter the user ID who is creating this record</small>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-4 col-md-8">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fa fa-save"></i> Create Salary Type
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Reference Information Section -->
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Reference Information</h3>
                </div>
                <div class="panel-body">
                    <div class="reference-section">
                        <h5><i class="fa fa-lightbulb-o"></i> Tips & Guidelines</h5>
                        <ul class="list-unstyled">
                            <li>• Use descriptive names for salary types</li>
                            <li>• Consider how this type affects payroll calculations</li>
                            <li>• Ensure consistency with existing naming conventions</li>
                        </ul>

                        <h5><i class="fa fa-database"></i> System Information</h5>
                        <div class="system-info">
                            <p><strong>Total Salary Types:</strong> <span id="totalSalaryTypes">Loading...</span></p>
                            <p><strong>Last Created:</strong> <span id="lastCreated">Loading...</span></p>
                        </div>

                        <h5><i class="fa fa-link"></i> Related Data</h5>
                        <div class="related-links">
                            @Html.ActionLink("View All Salary Types", "Index", null, new { @class = "btn btn-outline-info btn-sm btn-block" })
                            @Html.ActionLink("Manage Payroll", "Index", "PayrollRecords", null, new { @class = "btn btn-outline-info btn-sm btn-block" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Set default date to current datetime if empty
            if (!$('#CreatedDate').val()) {
                var now = new Date();
                var formatted = now.toISOString().slice(0, 16);
                $('#CreatedDate').val(formatted);
            }

            // Load system information
            loadSystemInfo();

            // Form submission handling
            $('form').submit(function (e) {
                var salaryTypeName = $('#SalaryTypeName').val().trim();
                if (!salaryTypeName) {
                    showAlert('Please enter a salary type name.', 'danger');
                    e.preventDefault();
                    return;
                }

                // Show loading state
                $('button[type="submit"]').html('<i class="fa fa-spinner fa-spin"></i> Creating...').prop('disabled', true);
            });

            function loadSystemInfo() {
                // Simulate loading system information
                setTimeout(function () {
                    $('#totalSalaryTypes').text('@ViewContext.Controller.ViewBag.TotalCount ?? "Calculating..."');
                    $('#lastCreated').text('@DateTime.Now.ToString("MMM dd, yyyy")');
                }, 1000);
            }

            function showAlert(message, type) {
                var alertClass = 'alert-' + type;
                var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                    message +
                    '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '</button>' +
                    '</div>';

                $('.form-horizontal').prepend(alertHtml);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-control-lg {
        padding: 15px 20px;
        font-size: 16px;
        border-radius: 8px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .form-control-lg:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .reference-section h5 {
        color: #2c3e50;
        margin-bottom: 15px;
        border-bottom: 2px solid #ecf0f1;
        padding-bottom: 8px;
    }

    .reference-section ul li {
        padding: 8px 0;
        border-bottom: 1px solid #f8f9fa;
    }

    .system-info p {
        margin-bottom: 10px;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 6px;
    }

    .related-links {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn-lg {
        padding: 15px 30px;
        font-size: 16px;
        border-radius: 8px;
        margin-right: 10px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .form-group .col-md-8 {
            margin-top: 10px;
        }

        .btn-lg {
            display: block;
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>