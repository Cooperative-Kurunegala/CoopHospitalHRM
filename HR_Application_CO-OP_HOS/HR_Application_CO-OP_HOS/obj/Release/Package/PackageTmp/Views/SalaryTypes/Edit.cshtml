@model HR_Application_CO_OP_HOS.Models.SalaryType

@{
    ViewBag.Title = "Edit Salary Type - HR Management System";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Salary Type</h1>
            <p class="lead">Modify existing salary type information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Salary Type Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group">
                                <label class="control-label col-md-4">Salary Type ID</label>
                                <div class="col-md-8">
                                    <input type="text" class="form-control form-control-lg" value="@Model.ID" disabled readonly />
                                    <small class="form-text text-muted">System-generated unique identifier</small>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.SalaryTypeName, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.SalaryTypeName, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter salary type name" } })
                                    @Html.ValidationMessageFor(model => model.SalaryTypeName, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Current: <strong>@Model.SalaryTypeName</strong></small>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.CreatedDate, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @{
                                        var createdDateValue = Model.CreatedDate.HasValue ?
                                            Model.CreatedDate.Value.ToString("yyyy-MM-ddTHH:mm") :
                                            DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
                                    }
                                    <input type="datetime-local" class="form-control form-control-lg"
                                           name="CreatedDate" value="@createdDateValue" />
                                    @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter user ID" } })
                                    @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-4 col-md-8">
                                    <button type="submit" class="btn btn-warning btn-lg">
                                        <i class="fa fa-save"></i> Update Salary Type
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Audit Information Section -->
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Audit Information</h3>
                </div>
                <div class="panel-body">
                    <div class="audit-info">
                        <h5><i class="fa fa-info-circle"></i> Current Values</h5>
                        <div class="current-values">
                            <p><strong>ID:</strong> <span class="badge badge-primary">@Model.ID</span></p>
                            <p><strong>Name:</strong> @Model.SalaryTypeName</p>
                            <p>
                                <strong>Created Date:</strong>
                                @if (Model.CreatedDate.HasValue)
                                {
                                    @Model.CreatedDate.Value.ToString("MMM dd, yyyy hh:mm tt")
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                            </p>
                            <p>
                                <strong>Created By:</strong>
                                @if (Model.CreatedBy.HasValue)
                                {
                                    <span class="badge badge-secondary">User @Model.CreatedBy.Value</span>
                                }
                                else
                                {
                                    <span class="text-muted">System</span>
                                }
                            </p>
                        </div>

                        <h5><i class="fa fa-exclamation-triangle"></i> Update Guidelines</h5>
                        <ul class="list-unstyled">
                            <li>• Changes will affect all associated records</li>
                            <li>• Update with caution in production</li>
                            <li>• Consider creating a new type instead of modifying</li>
                        </ul>

                        <div class="danger-zone mt-4">
                            <h5><i class="fa fa-warning"></i> Danger Zone</h5>
                            @Html.ActionLink("Delete This Type", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-sm btn-block" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Form validation and enhancement
            $('form').submit(function (e) {
                var salaryTypeName = $('#SalaryTypeName').val().trim();
                if (!salaryTypeName) {
                    showAlert('Salary type name cannot be empty.', 'danger');
                    e.preventDefault();
                    return;
                }

                if (salaryTypeName.length < 2) {
                    showAlert('Salary type name must be at least 2 characters long.', 'danger');
                    e.preventDefault();
                    return;
                }

                // Show loading state
                $('button[type="submit"]').html('<i class="fa fa-spinner fa-spin"></i> Updating...').prop('disabled', true);
            });

            // Real-time validation
            $('#SalaryTypeName').on('input', function () {
                var value = $(this).val().trim();
                var feedback = $(this).siblings('.text-danger');

                if (value.length === 0) {
                    feedback.text('Salary type name is required.');
                } else if (value.length < 2) {
                    feedback.text('Name must be at least 2 characters.');
                } else {
                    feedback.text('');
                }
            });

            function showAlert(message, type) {
                var alertClass = 'alert-' + type;
                var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                    '<i class="fa fa-exclamation-circle"></i> ' + message +
                    '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '</button>' +
                    '</div>';

                $('.form-horizontal').prepend(alertHtml);

                // Auto dismiss after 5 seconds
                setTimeout(function () {
                    $('.alert').alert('close');
                }, 5000);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-control-lg {
        padding: 15px 20px;
        font-size: 16px;
        border-radius: 8px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .form-control-lg:focus {
            border-color: #f39c12;
            box-shadow: 0 0 0 0.2rem rgba(243, 156, 18, 0.25);
        }

    .audit-info h5 {
        color: #2c3e50;
        margin-bottom: 15px;
        border-bottom: 2px solid #ecf0f1;
        padding-bottom: 8px;
    }

    .current-values p {
        margin-bottom: 12px;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 6px;
        border-left: 4px solid #3498db;
    }

    .audit-info ul li {
        padding: 8px 0;
        border-bottom: 1px solid #f8f9fa;
    }

    .danger-zone {
        padding: 15px;
        background: #fff3cd;
        border-radius: 8px;
        border: 2px solid #ffeaa7;
    }

        .danger-zone h5 {
            color: #e74c3c;
            border-bottom-color: #e74c3c;
        }

    .btn-lg {
        padding: 15px 30px;
        font-size: 16px;
        border-radius: 8px;
        margin-right: 10px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .form-group .col-md-8 {
            margin-top: 10px;
        }

        .btn-lg {
            display: block;
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>