@model IEnumerable<HR_Application_CO_OP_HOS.Models.SalaryType>

@{
    ViewBag.Title = "Salary Types - HR Management System";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-money"></i> Salary Types Management</h1>
            <p class="lead">Manage and configure salary types in the system</p>
        </div>
    </div>

    <!-- Quick Actions and Filters -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-primary quick-actions-panel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filters & Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-8">
                            <div class="filter-section">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label for="searchFilter">Search:</label>
                                            <input type="text" id="searchFilter" class="form-control" placeholder="Search salary types...">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label for="dateFilter">Created Date:</label>
                                            <input type="date" id="dateFilter" class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label for="sortFilter">Sort By:</label>
                                            <select id="sortFilter" class="form-control">
                                                <option value="name">Name (A-Z)</option>
                                                <option value="name_desc">Name (Z-A)</option>
                                                <option value="date">Date (Newest)</option>
                                                <option value="date_desc">Date (Oldest)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="action-buttons">
                                @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-lg btn-block" })
                                <button id="exportBtn" class="btn btn-info btn-lg btn-block">
                                    <i class="fa fa-download"></i> Export Data
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default data-panel">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-table"></i> Salary Types List</h3>
                    <div class="panel-tools">
                        <span class="badge badge-primary" id="recordCount">@Model.Count() records</span>
                    </div>
                </div>
                <div class="panel-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="salaryTypesTable">
                                <thead>
                                    <tr>
                                        <th data-sort="name">
                                            @Html.DisplayNameFor(model => model.SalaryTypeName)
                                            <i class="fa fa-sort"></i>
                                        </th>
                                        <th data-sort="date">
                                            @Html.DisplayNameFor(model => model.CreatedDate)
                                            <i class="fa fa-sort"></i>
                                        </th>
                                        <th data-sort="creator">
                                            @Html.DisplayNameFor(model => model.CreatedBy)
                                            <i class="fa fa-sort"></i>
                                        </th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.SalaryTypeName)</strong>
                                            </td>
                                            <td>
                                                @if (item.CreatedDate.HasValue)
                                                {
                                                    @item.CreatedDate.Value.ToString("MMM dd, yyyy hh:mm tt")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.CreatedBy.HasValue)
                                                {
                                                    <span class="badge badge-info">User @item.CreatedBy.Value</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">System</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fa fa-exclamation-triangle fa-3x"></i>
                            <h4>No Salary Types Found</h4>
                            <p>There are no salary types configured in the system yet.</p>
                            @Html.ActionLink("Create First Salary Type", "Create", null, new { @class = "btn btn-success btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchFilter').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#salaryTypesTable tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
                updateRecordCount();
            });

            // Date filter functionality
            $('#dateFilter').on('change', function () {
                var selectedDate = $(this).val();
                if (selectedDate) {
                    $('#salaryTypesTable tbody tr').each(function () {
                        var rowDate = $(this).find('td:eq(1)').text().toLowerCase();
                        $(this).toggle(rowDate.indexOf(selectedDate) > -1);
                    });
                } else {
                    $('#salaryTypesTable tbody tr').show();
                }
                updateRecordCount();
            });

            // Sort functionality
            $('th[data-sort]').click(function () {
                var table = $(this).parents('table').eq(0);
                var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()));
                this.asc = !this.asc;
                if (!this.asc) {
                    rows = rows.reverse();
                }
                for (var i = 0; i < rows.length; i++) {
                    table.append(rows[i]);
                }
                updateSortIcons($(this));
            });

            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index);
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB);
                };
            }

            function getCellValue(row, index) {
                return $(row).children('td').eq(index).text();
            }

            function updateSortIcons(clickedTh) {
                $('th i.fa').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
                var icon = clickedTh.find('i');
                icon.removeClass('fa-sort').addClass(clickedTh[0].asc ? 'fa-sort-up' : 'fa-sort-down');
            }

            function updateRecordCount() {
                var visibleRows = $('#salaryTypesTable tbody tr:visible').length;
                $('#recordCount').text(visibleRows + ' records');
            }

            // Export functionality
            $('#exportBtn').click(function () {
                // Simple CSV export implementation
                var csv = [];
                var headers = [];
                $('#salaryTypesTable thead th').each(function () {
                    if ($(this).text() !== 'Actions') {
                        headers.push($(this).text().trim());
                    }
                });
                csv.push(headers.join(','));

                $('#salaryTypesTable tbody tr:visible').each(function () {
                    var row = [];
                    $(this).find('td').each(function (index) {
                        if (index !== 3) { // Skip actions column
                            row.push($(this).text().trim().replace(/,/g, ''));
                        }
                    });
                    csv.push(row.join(','));
                });

                var csvContent = "data:text/csv;charset=utf-8," + csv.join('\n');
                var encodedUri = encodeURI(csvContent);
                var link = document.createElement("a");
                link.setAttribute("href", encodedUri);
                link.setAttribute("download", "salary_types_export.csv");
                document.body.appendChild(link);
                link.click();
            });

            // Initialize record count
            updateRecordCount();
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .quick-actions-panel {
        border-left: 6px solid #3498db;
        margin-bottom: 20px;
    }

    .data-panel {
        border-left: 6px solid #27ae60;
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .panel-tools {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filter-section .form-group {
        margin-bottom: 15px;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: 100%;
        justify-content: center;
    }

    .table th {
        cursor: pointer;
        user-select: none;
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

        .table th i {
            margin-left: 5px;
            opacity: 0.6;
        }

    .btn-group .btn {
        margin: 2px;
    }

    .badge {
        font-size: 0.9em;
        padding: 8px 12px;
    }

    .alert-warning {
        border-radius: 12px;
        padding: 40px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .panel-heading {
            flex-direction: column;
            gap: 10px;
            text-align: center;
        }

        .action-buttons {
            margin-top: 15px;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
        }

            .btn-group .btn {
                margin: 2px 0;
            }
    }
</style>