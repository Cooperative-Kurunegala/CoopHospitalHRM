@model HR_Application_CO_OP_HOS.Models.SalaryType

@{
    ViewBag.Title = "Salary Type Details - HR Management System";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-eye"></i> Salary Type Details</h1>
            <p class="lead">View detailed information about this salary type</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Details Section -->
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Salary Type Information</h3>
                </div>
                <div class="panel-body">
                    <div class="detail-section">
                        <div class="row detail-row">
                            <div class="col-md-4 detail-label">
                                <strong>Salary Type ID</strong>
                            </div>
                            <div class="col-md-8 detail-value">
                                <span class="badge badge-primary badge-lg">@Model.ID</span>
                            </div>
                        </div>

                        <div class="row detail-row">
                            <div class="col-md-4 detail-label">
                                <strong>@Html.DisplayNameFor(model => model.SalaryTypeName)</strong>
                            </div>
                            <div class="col-md-8 detail-value">
                                <h4 class="text-primary">@Html.DisplayFor(model => model.SalaryTypeName)</h4>
                            </div>
                        </div>

                        <div class="row detail-row">
                            <div class="col-md-4 detail-label">
                                <strong>@Html.DisplayNameFor(model => model.CreatedDate)</strong>
                            </div>
                            <div class="col-md-8 detail-value">
                                @if (Model.CreatedDate.HasValue)
                                {
                                    <div class="timestamp">
                                        <i class="fa fa-calendar"></i>
                                        @Model.CreatedDate.Value.ToString("MMMM dd, yyyy")
                                    </div>
                                    <div class="timestamp text-muted">
                                        <i class="fa fa-clock-o"></i>
                                        @Model.CreatedDate.Value.ToString("hh:mm tt")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Not specified</span>
                                }
                            </div>
                        </div>

                        <div class="row detail-row">
                            <div class="col-md-4 detail-label">
                                <strong>@Html.DisplayNameFor(model => model.CreatedBy)</strong>
                            </div>
                            <div class="col-md-8 detail-value">
                                @if (Model.CreatedBy.HasValue)
                                {
                                    <span class="user-badge">
                                        <i class="fa fa-user"></i>
                                        User @Model.CreatedBy.Value
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">System</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="action-buttons mt-4">
                        <div class="btn-group" role="group">
                            @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-lg" })
                            @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-lg" })
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Information Section -->
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Usage Statistics</h3>
                </div>
                <div class="panel-body">
                    <div class="stats-section">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-users"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-number" id="employeeCount">--</div>
                                <div class="stat-label">Employees Using</div>
                            </div>
                        </div>

                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-money"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-number" id="payrollCount">--</div>
                                <div class="stat-label">Payroll Records</div>
                            </div>
                        </div>

                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-calendar"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-number" id="activeCount">--</div>
                                <div class="stat-label">Active This Month</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="quick-actions">
                        @Html.ActionLink("Create Similar Type", "Create", null, new { @class = "btn btn-outline-success btn-block mb-2" })
                        @Html.ActionLink("View All Types", "Index", null, new { @class = "btn btn-outline-primary btn-block mb-2" })
                        @Html.ActionLink("Export Data", "Index", null, new { @class = "btn btn-outline-info btn-block mb-2" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Simulate loading statistics data
            setTimeout(function () {
                $('#employeeCount').text('25');
                $('#payrollCount').text('156');
                $('#activeCount').text('18');
            }, 1000);

            // Add animation to detail rows
            $('.detail-row').each(function (index) {
                $(this).delay(100 * index).fadeIn(300);
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 12px 12px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 30px;
    }

    .detail-row {
        margin-bottom: 25px;
        padding: 15px;
        border-radius: 8px;
        background: #f8f9fa;
        border-left: 4px solid #3498db;
    }

    .detail-label {
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
    }

    .detail-value {
        color: #34495e;
    }

    .badge-lg {
        font-size: 1.2em;
        padding: 10px 15px;
    }

    .timestamp {
        margin-bottom: 5px;
    }

    .user-badge {
        background: #ecf0f1;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 500;
    }

    .stats-section {
        text-align: center;
    }

    .stat-item {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .stat-icon {
        font-size: 2.5em;
        color: #3498db;
        margin-right: 15px;
        width: 60px;
    }

    .stat-content {
        flex: 1;
        text-align: left;
    }

    .stat-number {
        font-size: 1.8em;
        font-weight: bold;
        color: #2c3e50;
    }

    .stat-label {
        color: #7f8c8d;
        font-size: 0.9em;
    }

    .action-buttons .btn-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-lg {
        padding: 15px 30px;
        font-size: 16px;
        border-radius: 8px;
        flex: 1;
        min-width: 120px;
    }

    .quick-actions .btn {
        margin-bottom: 10px;
        padding: 12px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 10px;
        }

        .detail-row {
            flex-direction: column;
            text-align: center;
        }

        .detail-label {
            margin-bottom: 10px;
            justify-content: center;
        }

        .action-buttons .btn-group {
            flex-direction: column;
        }

        .btn-lg {
            width: 100%;
            margin-bottom: 10px;
        }

        .stat-item {
            flex-direction: column;
            text-align: center;
        }

        .stat-icon {
            margin-right: 0;
            margin-bottom: 10px;
        }

        .stat-content {
            text-align: center;
        }
    }
</style>