@model HR_Application_CO_OP_HOS.Models.RelatedPartyBankAccount

@{
    ViewBag.Title = "Delete Bank Account";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Bank Account</h1>
            <p class="lead">Remove bank account information from the system</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-danger">
                        <h4><i class="fa fa-warning"></i> Warning!</h4>
                        <p>You are about to permanently delete this bank account record. This action cannot be undone.</p>
                    </div>

                    <h4>Are you sure you want to delete this bank account?</h4>

                    <div class="deletion-details">
                        <div class="row">
                            <div class="col-md-6">
                                <h5>Account Information</h5>
                                <dl class="dl-horizontal">
                                    <dt>Account No:</dt>
                                    <dd>@Html.DisplayFor(model => model.BankAccountNo)</dd>

                                    <dt>Standing Order:</dt>
                                    <dd>@Html.DisplayFor(model => model.StandingOrderAmount)</dd>

                                    <dt>Status:</dt>
                                    <dd>
                                        <span class="badge @(Model.IsEnable == true ? "badge-success" : "badge-secondary")">
                                            @(Model.IsEnable == true ? "Enabled" : "Disabled")
                                        </span>
                                    </dd>
                                </dl>
                            </div>
                            <div class="col-md-6">
                                <h5>Associated Information</h5>
                                <dl class="dl-horizontal">
                                    <dt>Related Party:</dt>
                                    <dd id="relatedPartyName">Loading...</dd>

                                    <dt>Bank:</dt>
                                    <dd id="bankName">Loading...</dd>

                                    <dt>Branch:</dt>
                                    <dd id="branchName">Loading...</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-actions no-color">
                            <button type="submit" class="btn btn-danger" id="confirmDelete">
                                <i class="fa fa-trash"></i> Confirm Delete
                            </button>
                            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Impact Analysis -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Impact Analysis</h3>
                </div>
                <div class="panel-body">
                    <h5>This deletion will affect:</h5>
                    <ul class="list-group">
                        <li class="list-group-item">
                            <i class="fa fa-exclamation-circle text-danger"></i>
                            Bank account records
                        </li>
                        <li class="list-group-item">
                            <i class="fa fa-exclamation-circle text-danger"></i>
                            Standing order payments
                        </li>
                        <li class="list-group-item">
                            <i class="fa fa-info-circle text-info"></i>
                            Historical data (archived)
                        </li>
                    </ul>

                    <div class="alert alert-info mt-3">
                        <i class="fa fa-info-circle"></i>
                        <strong>Note:</strong> Historical records will be maintained for audit purposes.
                    </div>
                </div>
            </div>

            <!-- Safe Alternatives -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-shield"></i> Safe Alternatives</h3>
                </div>
                <div class="panel-body">
                    <p>Consider these alternatives instead of deletion:</p>
                    <div class="alternative-actions">
                        <div class="alternative-item">
                            @Html.ActionLink("Disable Account", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-block btn-sm" })
                            <small class="text-muted">Keep record but mark as inactive</small>
                        </div>
                        <div class="alternative-item">
                            @Html.ActionLink("Edit Details", "Edit", new { id = Model.ID }, new { @class = "btn btn-info btn-block btn-sm" })
                            <small class="text-muted">Update account information</small>
                        </div>
                        <div class="alternative-item">
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-success btn-block btn-sm" })
                            <small class="text-muted">Review account information</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Navigation -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-compass"></i> Quick Navigation</h3>
                </div>
                <div class="panel-body">
                    <div class="quick-nav">
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default btn-block" })
                        @Html.ActionLink("View All Accounts", "Index", null, new { @class = "btn btn-primary btn-block" })
                        @Html.ActionLink("Create New Account", "Create", null, new { @class = "btn btn-success btn-block" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Load associated information
            setTimeout(function () {
                var relatedPartyData = {
                    '1': { name: 'John Doe' },
                    '2': { name: 'Jane Smith' }
                };

                var bankData = {
                    '1': { name: 'Commercial Bank' },
                    '2': { name: 'Bank of Ceylon' }
                };

                var branchData = {
                    '1': { name: 'Colombo Main Branch' },
                    '2': { name: 'Kandy Branch' }
                };

                var partyId = '@Model.RelatedPartyID';
                var bankId = '@Model.BankID';
                var branchId = '@Model.BranchID';

                if (relatedPartyData[partyId]) {
                    $('#relatedPartyName').text(relatedPartyData[partyId].name);
                }

                if (bankData[bankId]) {
                    $('#bankName').text(bankData[bankId].name);
                }

                if (branchData[branchId]) {
                    $('#branchName').text(branchData[branchId].name);
                }
            }, 500);

            // Confirm deletion
            $('#confirmDelete').click(function (e) {
                var confirmed = confirm('Are you absolutely sure you want to delete this bank account? This action cannot be undone.');
                if (!confirmed) {
                    e.preventDefault();
                }
            });

            // Prevent accidental form submission
            $('form').submit(function (e) {
                var confirmed = confirm('Final warning: This will permanently delete the bank account record. Continue?');
                if (!confirmed) {
                    e.preventDefault();
                    return false;
                }

                // Show loading state
                $('#confirmDelete').html('<i class="fa fa-spinner fa-spin"></i> Deleting...').prop('disabled', true);
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 20px !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 20px;
    }

    .alert {
        border-radius: 8px;
        border: none;
    }

    .deletion-details {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin: 20px 0;
        border-left: 4px solid #dc3545;
    }

        .deletion-details h5 {
            color: #dc3545;
            font-weight: 600;
            margin-bottom: 15px;
        }

    .dl-horizontal dt {
        text-align: left;
        width: 120px;
        font-weight: 600;
        color: #7f8c8d;
    }

    .dl-horizontal dd {
        margin-left: 130px;
        margin-bottom: 8px;
    }

    .badge {
        font-size: 0.8rem;
        padding: 4px 8px;
    }

    .list-group-item {
        border: none;
        padding: 12px 15px;
        margin-bottom: 5px;
        border-radius: 6px !important;
    }

        .list-group-item i {
            margin-right: 8px;
        }

    .alternative-item {
        margin-bottom: 15px;
        text-align: center;
    }

        .alternative-item .btn {
            margin-bottom: 5px;
        }

    .quick-nav .btn {
        margin-bottom: 10px;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }

    .form-actions {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }
</style>