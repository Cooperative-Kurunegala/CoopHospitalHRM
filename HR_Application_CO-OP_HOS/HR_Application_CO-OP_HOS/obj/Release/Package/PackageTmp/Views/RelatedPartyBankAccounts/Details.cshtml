@model HR_Application_CO_OP_HOS.Models.RelatedPartyBankAccount

@{
    ViewBag.Title = "Bank Account Details";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-eye"></i> Bank Account Details</h1>
            <p class="lead">View detailed information about the bank account</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-credit-card"></i> Account Details
                        <div class="pull-right">
                            @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-sm" })
                        </div>
                    </h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-section">
                                <h5><i class="fa fa-user"></i> Related Party Information</h5>
                                <dl class="dl-horizontal">
                                    <dt>Related Party:</dt>
                                    <dd id="relatedPartyName">Loading...</dd>
                                    <dt>Party Type:</dt>
                                    <dd id="partyType">Loading...</dd>
                                    <dt>Designation:</dt>
                                    <dd id="partyDesignation">Loading...</dd>
                                </dl>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-section">
                                <h5><i class="fa fa-bank"></i> Bank Information</h5>
                                <dl class="dl-horizontal">
                                    <dt>Bank:</dt>
                                    <dd id="bankName">Loading...</dd>
                                    <dt>Branch:</dt>
                                    <dd id="branchName">Loading...</dd>
                                    <dt>Bank Code:</dt>
                                    <dd id="bankCode">Loading...</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-section">
                                <h5><i class="fa fa-info-circle"></i> Account Details</h5>
                                <dl class="dl-horizontal">
                                    <dt>@Html.DisplayNameFor(model => model.BankAccountNo):</dt>
                                    <dd>@Html.DisplayFor(model => model.BankAccountNo)</dd>

                                    <dt>@Html.DisplayNameFor(model => model.StandingOrderAmount):</dt>
                                    <dd>@Html.DisplayFor(model => model.StandingOrderAmount)</dd>

                                    <dt>@Html.DisplayNameFor(model => model.IsEnable):</dt>
                                    <dd>
                                        <span class="badge @(Model.IsEnable == true ? "badge-success" : "badge-secondary")">
                                            @(Model.IsEnable == true ? "Enabled" : "Disabled")
                                        </span>
                                    </dd>
                                </dl>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-section">
                                <h5><i class="fa fa-history"></i> Audit Information</h5>
                                <dl class="dl-horizontal">
                                    <dt>@Html.DisplayNameFor(model => model.CreatedDate):</dt>
                                    <dd>@Html.DisplayFor(model => model.CreatedDate)</dd>

                                    <dt>@Html.DisplayNameFor(model => model.CreatedBy):</dt>
                                    <dd>@Html.DisplayFor(model => model.CreatedBy)</dd>

                                    <dt>Last Modified:</dt>
                                    <dd>@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Quick Actions -->
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="quick-action-item">
                        @Html.ActionLink("Edit This Account", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-block" })
                    </div>
                    <div class="quick-action-item">
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default btn-block" })
                    </div>
                    <div class="quick-action-item">
                        @Html.ActionLink("Create New Account", "Create", null, new { @class = "btn btn-success btn-block" })
                    </div>
                </div>
            </div>

            <!-- Status Information -->
            <div class="panel panel-@(Model.IsEnable == true ? "success" : "warning")">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Account Status</h3>
                </div>
                <div class="panel-body text-center">
                    <div class="status-indicator">
                        <i class="fa fa-@(Model.IsEnable == true ? "check-circle" : "exclamation-circle") fa-3x"></i>
                        <h4>@(Model.IsEnable == true ? "Active" : "Inactive")</h4>
                        <p>This account is currently @(Model.IsEnable == true ? "enabled and active" : "disabled and inactive")</p>
                    </div>
                </div>
            </div>

            <!-- Related Information -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-link"></i> Related Information</h3>
                </div>
                <div class="panel-body">
                    <ul class="list-group">
                        <li class="list-group-item">
                            <i class="fa fa-user"></i>
                            <a href="@Url.Action("Details", "RelatedParties", new { id = Model.RelatedPartyID })" id="relatedPartyLink">
                                View Related Party Details
                            </a>
                        </li>
                        <li class="list-group-item">
                            <i class="fa fa-bank"></i>
                            <a href="#" id="bankLink">View Bank Information</a>
                        </li>
                        <li class="list-group-item">
                            <i class="fa fa-code-fork"></i>
                            <a href="#" id="branchLink">View Branch Details</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Simulate loading related data
            setTimeout(function () {
                // These would typically come from your controller via ViewBag or AJAX
                var relatedPartyData = {
                    '1': { name: 'John Doe', type: 'Employee', designation: 'Manager' },
                    '2': { name: 'Jane Smith', type: 'Doctor', designation: 'Consultant' }
                };

                var bankData = {
                    '1': { name: 'Commercial Bank', code: 'CB', branches: 150 },
                    '2': { name: 'Bank of Ceylon', code: 'BOC', branches: 200 }
                };

                var branchData = {
                    '1': { name: 'Colombo Main Branch', code: 'CMB' },
                    '2': { name: 'Kandy Branch', code: 'KNY' }
                };

                var partyId = '@Model.RelatedPartyID';
                var bankId = '@Model.BankID';
                var branchId = '@Model.BranchID';

                // Update related party information
                if (relatedPartyData[partyId]) {
                    $('#relatedPartyName').text(relatedPartyData[partyId].name);
                    $('#partyType').text(relatedPartyData[partyId].type);
                    $('#partyDesignation').text(relatedPartyData[partyId].designation);
                }

                // Update bank information
                if (bankData[bankId]) {
                    $('#bankName').text(bankData[bankId].name);
                    $('#bankCode').text(bankData[bankId].code);
                }

                // Update branch information
                if (branchData[branchId]) {
                    $('#branchName').text(branchData[branchId].name);
                }
            }, 500);
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 20px !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 20px;
    }

    .detail-section {
        margin-bottom: 25px;
    }

        .detail-section h5 {
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 8px;
            margin-bottom: 15px;
            font-weight: 600;
        }

            .detail-section h5 i {
                margin-right: 8px;
                color: #3498db;
            }

    .dl-horizontal dt {
        text-align: left;
        width: 120px;
        font-weight: 600;
        color: #7f8c8d;
    }

    .dl-horizontal dd {
        margin-left: 130px;
        margin-bottom: 10px;
    }

    .badge {
        font-size: 0.8rem;
        padding: 4px 8px;
    }

    .status-indicator {
        padding: 20px 0;
    }

        .status-indicator i {
            margin-bottom: 15px;
        }

        .status-indicator h4 {
            margin: 10px 0;
            font-weight: 600;
        }

    .quick-action-item {
        margin-bottom: 10px;
    }

    .list-group-item {
        border: none;
        padding: 12px 15px;
    }

        .list-group-item a {
            color: #2c3e50;
            text-decoration: none;
        }

            .list-group-item a:hover {
                color: #3498db;
            }

        .list-group-item i {
            margin-right: 8px;
            width: 20px;
            text-align: center;
        }
</style>