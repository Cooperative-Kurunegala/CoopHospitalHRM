@model HR_Application_CO_OP_HOS.Models.RelatedPartyBankAccount

@{
    ViewBag.Title = "Edit Bank Account";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Bank Account</h1>
            <p class="lead">Update bank account information for related parties</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-credit-card"></i> Edit Bank Account Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-warning", id = "validationSummary" })
                            @Html.HiddenFor(model => model.ID)

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.RelatedPartyID,
                                            new SelectList(ViewBag.RelatedParties ?? new List<SelectListItem>(), "Value", "Text"),
                                            "Select Related Party",
                                            new { @class = "form-control", id = "RelatedPartyID" })
                                        @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.BankID, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.BankID,
                                            new SelectList(ViewBag.Banks ?? new List<SelectListItem>(), "Value", "Text"),
                                            "Select Bank",
                                            new { @class = "form-control", id = "BankID" })
                                        @Html.ValidationMessageFor(model => model.BankID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.BranchID, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.BranchID,
                                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Value", "Text"),
                                            "Select Branch",
                                            new { @class = "form-control", id = "BranchID" })
                                        @Html.ValidationMessageFor(model => model.BranchID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.BankAccountNo, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.BankAccountNo, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter account number" } })
                                        @Html.ValidationMessageFor(model => model.BankAccountNo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StandingOrderAmount, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.StandingOrderAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                        @Html.ValidationMessageFor(model => model.StandingOrderAmount, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsEnable, htmlAttributes: new { @class = "control-label" })
                                        <div class="checkbox">
                                            @Html.EditorFor(model => model.IsEnable)
                                            @Html.ValidationMessageFor(model => model.IsEnable, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedDate, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                        @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                        @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fa fa-save"></i> Save Changes
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
                                    @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Current Information Panel -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Current Information</h3>
                </div>
                <div class="panel-body">
                    <div class="info-section">
                        <h5>Account Details</h5>
                        <p><strong>Account No:</strong> @Model.BankAccountNo</p>
                        <p><strong>Standing Order:</strong> @Model.StandingOrderAmount</p>
                        <p>
                            <strong>Status:</strong>
                            <span class="badge @(Model.IsEnable == true ? "badge-success" : "badge-secondary")">
                                @(Model.IsEnable == true ? "Enabled" : "Disabled")
                            </span>
                        </p>
                    </div>

                    <div id="relatedPartyInfo" class="info-section">
                        <h5>Related Party</h5>
                        <!-- Will be populated by JavaScript -->
                    </div>

                    <div id="bankInfo" class="info-section">
                        <h5>Bank Information</h5>
                        <!-- Will be populated by JavaScript -->
                    </div>
                </div>
            </div>

            <!-- Audit Information -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Audit Information</h3>
                </div>
                <div class="panel-body">
                    <p><strong>Created Date:</strong> @Model.CreatedDate</p>
                    <p><strong>Created By:</strong> User @Model.CreatedBy</p>
                    <p><strong>Last Modified:</strong> <span id="lastModified">Just now</span></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Load current information on page load
            loadCurrentInformation();

            // Update information when dropdowns change
            $('#RelatedPartyID, #BankID, #BranchID').change(function () {
                loadCurrentInformation();
            });

            function loadCurrentInformation() {
                var partyId = $('#RelatedPartyID').val();
                var bankId = $('#BankID').val();
                var branchId = $('#BranchID').val();

                // Load related party info
                if (partyId) {
                    var partyInfo = {
                        '1': { name: 'John Doe', type: 'Employee', designation: 'Manager' },
                        '2': { name: 'Jane Smith', type: 'Doctor', designation: 'Consultant' }
                    };

                    if (partyInfo[partyId]) {
                        var info = partyInfo[partyId];
                        $('#relatedPartyInfo').html(`
                            <h5>${info.name}</h5>
                            <p><strong>Type:</strong> ${info.type}</p>
                            <p><strong>Designation:</strong> ${info.designation}</p>
                        `);
                    }
                }

                // Load bank info
                if (bankId) {
                    var bankInfo = {
                        '1': { name: 'Commercial Bank', code: 'CB', branches: 150 },
                        '2': { name: 'Bank of Ceylon', code: 'BOC', branches: 200 }
                    };

                    if (bankInfo[bankId]) {
                        var info = bankInfo[bankId];
                        $('#bankInfo').html(`
                            <h5>${info.name}</h5>
                            <p><strong>Code:</strong> ${info.code}</p>
                            <p><strong>Total Branches:</strong> ${info.branches}</p>
                        `);
                    }
                }
            }

            // Form validation
            $('form').submit(function (e) {
                var isValid = true;
                $('.form-control:not([readonly])').each(function () {
                    if ($(this).val() === '' && $(this).prop('required')) {
                        isValid = false;
                        $(this).addClass('error');
                    } else {
                        $(this).removeClass('error');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    $('#validationSummary').show().html('<i class="fa fa-exclamation-triangle"></i> Please fill in all required fields.');
                } else {
                    // Update last modified timestamp
                    $('#lastModified').text(new Date().toLocaleString());
                }
            });

            // Initial load
            loadCurrentInformation();
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 20px !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 20px;
    }

    .info-section {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
    }

        .info-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

    .badge {
        font-size: 0.8rem;
        padding: 4px 8px;
    }

    .form-control[readonly] {
        background-color: #f8f9fa;
        opacity: 1;
    }
</style>