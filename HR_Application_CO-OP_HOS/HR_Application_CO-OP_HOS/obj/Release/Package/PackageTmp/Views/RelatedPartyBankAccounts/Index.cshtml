@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartyBankAccount>

@{
    ViewBag.Title = "Related Party Bank Accounts";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-credit-card"></i> Related Party Bank Accounts</h1>
            <p class="lead">Manage bank account information for related parties</p>
        </div>
    </div>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h3 class="panel-title">
                <i class="fa fa-list"></i> Bank Account List
                <div class="pull-right">
                    @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-sm" })
                </div>
            </h3>
        </div>
        <div class="panel-body">
            <!-- Filters Section -->
            <div class="row filter-section">
                <div class="col-md-12">
                    <div class="filter-panel">
                        <h4><i class="fa fa-filter"></i> Filters</h4>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Related Party</label>
                                    @Html.DropDownList("RelatedPartyFilter", new SelectList(ViewBag.RelatedParties ?? new List<SelectListItem>(), "Value", "Text"),
                                        "All Parties", new { @class = "form-control", id = "RelatedPartyFilter" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Bank</label>
                                    @Html.DropDownList("BankFilter", new SelectList(ViewBag.Banks ?? new List<SelectListItem>(), "Value", "Text"),
                                        "All Banks", new { @class = "form-control", id = "BankFilter" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Status</label>
                                    <select class="form-control" id="StatusFilter">
                                        <option value="">All Status</option>
                                        <option value="true">Enabled</option>
                                        <option value="false">Disabled</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <button type="button" id="ApplyFilters" class="btn btn-primary btn-block">Apply Filters</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="bankAccountsTable">
                    <thead>
                        <tr>
                            <th>Account No</th>
                            <th>Related Party</th>
                            <th>Bank</th>
                            <th>Branch</th>
                            <th>Standing Order</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.BankAccountNo)</td>
                                    <td>
                                        @{
                                            var relatedPartyName = "N/A";
                                            if (ViewBag.RelatedPartiesDict != null)
                                            {
                                                relatedPartyName = ViewBag.RelatedPartiesDict.ContainsKey(item.RelatedPartyID)
                                                    ? ViewBag.RelatedPartiesDict[item.RelatedPartyID]
                                                    : "N/A";
                                            }
                                        }
                                        @relatedPartyName
                                    </td>
                                    <td>
                                        @{
                                            var bankName = "N/A";
                                            if (ViewBag.BanksDict != null)
                                            {
                                                bankName = ViewBag.BanksDict.ContainsKey(item.BankID)
                                                    ? ViewBag.BanksDict[item.BankID]
                                                    : "N/A";
                                            }
                                        }
                                        @bankName
                                    </td>
                                    <td>
                                        @{
                                            var branchName = "N/A";
                                            if (ViewBag.BranchesDict != null)
                                            {
                                                branchName = ViewBag.BranchesDict.ContainsKey(item.BranchID)
                                                    ? ViewBag.BranchesDict[item.BranchID]
                                                    : "N/A";
                                            }
                                        }
                                        @branchName
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.StandingOrderAmount)</td>
                                    <td>
                                        <span class="badge @(item.IsEnable == true ? "badge-success" : "badge-secondary")">
                                            @(item.IsEnable == true ? "Enabled" : "Disabled")
                                        </span>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                                    <td>
                                        <div class="btn-group">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                            @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                            @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    <i class="fa fa-info-circle"></i> No bank accounts found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Filter functionality
            $('#ApplyFilters').click(function () {
                var relatedPartyId = $('#RelatedPartyFilter').val();
                var bankId = $('#BankFilter').val();
                var status = $('#StatusFilter').val();

                // Simple client-side filtering for demo
                // In production, this would typically be a server-side call
                $('#bankAccountsTable tbody tr').each(function () {
                    var row = $(this);
                    var showRow = true;

                    if (relatedPartyId && row.find('td:eq(1)').text().indexOf(relatedPartyId) === -1) {
                        showRow = false;
                    }

                    if (bankId && row.find('td:eq(2)').text().indexOf(bankId) === -1) {
                        showRow = false;
                    }

                    if (status !== '') {
                        var isEnabled = row.find('td:eq(5) .badge').hasClass('badge-success');
                        if ((status === 'true' && !isEnabled) || (status === 'false' && isEnabled)) {
                            showRow = false;
                        }
                    }

                    row.toggle(showRow);
                });
            });

            // Reset filters
            $('#ResetFilters').click(function () {
                $('#RelatedPartyFilter, #BankFilter, #StatusFilter').val('');
                $('#bankAccountsTable tbody tr').show();
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.2rem;
        opacity: 0.9;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-title {
        font-size: 1.3rem;
        margin: 0;
    }

    .panel-body {
        padding: 20px;
    }

    .filter-section {
        margin-bottom: 20px;
    }

    .filter-panel {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #3498db;
    }

        .filter-panel h4 {
            margin-top: 0;
            color: #2c3e50;
            font-size: 1.1rem;
        }

    .table th {
        background-color: #34495e;
        color: white;
        font-weight: 600;
    }

    .badge {
        font-size: 0.8rem;
        padding: 5px 10px;
    }

    .btn-group .btn {
        margin-right: 5px;
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 0.85rem;
    }
</style>