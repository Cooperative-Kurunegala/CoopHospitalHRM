@model HR_Application_CO_OP_HOS.Models.RelatedPartyBankAccount

@{
    ViewBag.Title = "Create Bank Account";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create Bank Account</h1>
            <p class="lead">Add new bank account information for related parties</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-credit-card"></i> Bank Account Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", id = "validationSummary" })

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.RelatedPartyID,
                                            new SelectList(ViewBag.RelatedParties ?? new List<SelectListItem>(), "Value", "Text"),
                                            "Select Related Party",
                                            new { @class = "form-control", id = "RelatedPartyID" })
                                        @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.BankID, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.BankID,
                                            new SelectList(ViewBag.Banks ?? new List<SelectListItem>(), "Value", "Text"),
                                            "Select Bank",
                                            new { @class = "form-control", id = "BankID" })
                                        @Html.ValidationMessageFor(model => model.BankID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.BranchID, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.BranchID,
                                            new SelectList(ViewBag.Branches ?? new List<SelectListItem>(), "Value", "Text"),
                                            "Select Branch",
                                            new { @class = "form-control", id = "BranchID" })
                                        @Html.ValidationMessageFor(model => model.BranchID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.BankAccountNo, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.BankAccountNo, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter account number" } })
                                        @Html.ValidationMessageFor(model => model.BankAccountNo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StandingOrderAmount, htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.StandingOrderAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                        @Html.ValidationMessageFor(model => model.StandingOrderAmount, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsEnable, htmlAttributes: new { @class = "control-label" })
                                        <div class="checkbox">
                                            @Html.EditorFor(model => model.IsEnable)
                                            @Html.ValidationMessageFor(model => model.IsEnable, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-save"></i> Create
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Related Information Panel -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Reference Information</h3>
                </div>
                <div class="panel-body">
                    <div id="relatedPartyInfo" class="reference-section">
                        <h5>Selected Related Party</h5>
                        <p class="text-muted">Select a related party to view details</p>
                    </div>

                    <div id="bankInfo" class="reference-section">
                        <h5>Selected Bank</h5>
                        <p class="text-muted">Select a bank to view details</p>
                    </div>

                    <div id="branchInfo" class="reference-section">
                        <h5>Selected Branch</h5>
                        <p class="text-muted">Select a branch to view details</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Load related party details
            $('#RelatedPartyID').change(function () {
                var partyId = $(this).val();
                if (partyId) {
                    // In a real application, you would make an AJAX call to get party details
                    // For this example, we'll simulate with static data
                    var partyInfo = {
                        '1': { name: 'John Doe', type: 'Employee', designation: 'Manager' },
                        '2': { name: 'Jane Smith', type: 'Doctor', designation: 'Consultant' }
                    };

                    if (partyInfo[partyId]) {
                        var info = partyInfo[partyId];
                        $('#relatedPartyInfo').html(`
                            <h5>${info.name}</h5>
                            <p><strong>Type:</strong> ${info.type}</p>
                            <p><strong>Designation:</strong> ${info.designation}</p>
                        `);
                    }
                } else {
                    $('#relatedPartyInfo').html('<h5>Selected Related Party</h5><p class="text-muted">Select a related party to view details</p>');
                }
            });

            // Load bank details
            $('#BankID').change(function () {
                var bankId = $(this).val();
                if (bankId) {
                    // Simulated bank data
                    var bankInfo = {
                        '1': { name: 'Commercial Bank', code: 'CB' },
                        '2': { name: 'Bank of Ceylon', code: 'BOC' }
                    };

                    if (bankInfo[bankId]) {
                        var info = bankInfo[bankId];
                        $('#bankInfo').html(`
                            <h5>${info.name}</h5>
                            <p><strong>Code:</strong> ${info.code}</p>
                        `);
                    }
                } else {
                    $('#bankInfo').html('<h5>Selected Bank</h5><p class="text-muted">Select a bank to view details</p>');
                }
            });

            // Load branch details
            $('#BranchID').change(function () {
                var branchId = $(this).val();
                if (branchId) {
                    // Simulated branch data
                    var branchInfo = {
                        '1': { name: 'Colombo Main Branch', code: 'CMB' },
                        '2': { name: 'Kandy Branch', code: 'KNY' }
                    };

                    if (branchInfo[branchId]) {
                        var info = branchInfo[branchId];
                        $('#branchInfo').html(`
                            <h5>${info.name}</h5>
                            <p><strong>Code:</strong> ${info.code}</p>
                        `);
                    }
                } else {
                    $('#branchInfo').html('<h5>Selected Branch</h5><p class="text-muted">Select a branch to view details</p>');
                }
            });

            // Form validation enhancement
            $('form').submit(function (e) {
                var isValid = true;
                $('.form-control').each(function () {
                    if ($(this).val() === '' && $(this).prop('required')) {
                        isValid = false;
                        $(this).addClass('error');
                    } else {
                        $(this).removeClass('error');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    $('#validationSummary').show().html('<i class="fa fa-exclamation-triangle"></i> Please fill in all required fields.');
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 20px !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 30px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .jumbotron h1 {
        font-size: 2.2rem;
        margin-bottom: 10px;
        font-weight: 700;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .control-label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 6px;
        border: 1px solid #ddd;
        padding: 10px 15px;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .reference-section {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
    }

        .reference-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

    .alert {
        border-radius: 6px;
        padding: 12px 15px;
    }

    .btn {
        border-radius: 6px;
        padding: 10px 20px;
        font-weight: 600;
    }

    .checkbox {
        margin-top: 8px;
    }
</style>