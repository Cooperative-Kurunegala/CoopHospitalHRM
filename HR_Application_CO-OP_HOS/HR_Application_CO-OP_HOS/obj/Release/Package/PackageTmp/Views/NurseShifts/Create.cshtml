@model HR_Application_CO_OP_HOS.Models.NurseShift

@{
    ViewBag.Title = "Create Nurse Shift";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Nurse Shift</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .header-content .lead {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
            min-height: calc(100vh - 200px);
        }

        .form-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .form-header {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            color: white;
            padding: 25px 30px;
        }

            .form-header h3 {
                margin: 0;
                font-size: 1.6rem;
                font-weight: 600;
            }

        .form-body {
            padding: 30px;
        }

        /* Two Column Layout */
        .form-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        @@media (max-width: 992px) {
            .form-columns {
                grid-template-columns: 1fr;
            }
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 1rem;
        }

        .form-control-custom {
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
            width: 100%;
        }

            .form-control-custom:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
            }

        .validation-message {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
            display: block;
        }

        /* Reference Panel */
        .reference-panel {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #3498db;
        }

        .reference-header {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .reference-item {
            padding: 10px;
            border-bottom: 1px solid #e9ecef;
            font-size: 0.9rem;
        }

            .reference-item:last-child {
                border-bottom: none;
            }

        /* Buttons */
        .form-actions {
            padding: 25px 30px;
            background: #f8f9fa;
            border-top: 1px solid #e9ecef;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn-submit {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        .btn-back {
            background: #95a5a6;
            border: none;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            font-size: 1rem;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .btn-back:hover {
                background: #7f8c8d;
                transform: translateY(-1px);
                color: white;
                text-decoration: none;
            }

        /* Loading States */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        /* Success/Error Messages */
        .alert-message {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .dashboard-header {
                padding: 20px;
            }

            .header-content h1 {
                font-size: 2rem;
            }

            .main-content {
                padding: 15px;
            }

            .form-body {
                padding: 20px;
            }

            .form-actions {
                padding: 20px;
                flex-direction: column;
            }

            .btn-submit, .btn-back {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1><i class="fa fa-plus-circle"></i> Create New Nurse Shift</h1>
                <p class="lead">Add a new nurse shift assignment to the system</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="form-container">
                <div class="form-header">
                    <h3><i class="fa fa-calendar"></i> Nurse Shift Information</h3>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-body">
                        @Html.ValidationSummary(true, "", new { @class = "alert-message alert-error" })

                        <div class="form-columns">
                            <!-- Left Column - Form Fields -->
                            <div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.AdmissionType, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.AdmissionType, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Enter admission type" } })
                                    @Html.ValidationMessageFor(model => model.AdmissionType, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.ReceivedNurse, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.ReceivedNurse, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Enter received nurse ID" } })
                                    @Html.ValidationMessageFor(model => model.ReceivedNurse, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.NurseInChargeAdditional, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.NurseInChargeAdditional, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Enter additional nurse in charge ID" } })
                                    @Html.ValidationMessageFor(model => model.NurseInChargeAdditional, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.AssitantNurse, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.AssitantNurse, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Enter assistant nurse ID" } })
                                    @Html.ValidationMessageFor(model => model.AssitantNurse, "", new { @class = "validation-message" })
                                </div>
                            </div>

                            <!-- Right Column - More Fields and Reference -->
                            <div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.NurseInCharge, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.NurseInCharge, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Enter nurse in charge ID" } })
                                    @Html.ValidationMessageFor(model => model.NurseInCharge, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Shift, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.Shift, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Enter shift (1=Morning, 2=Evening, 3=Night)" } })
                                    @Html.ValidationMessageFor(model => model.Shift, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.CreatedDate, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control-custom", type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "validation-message" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.RelatedPartySessionID, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.RelatedPartySessionID, new { htmlAttributes = new { @class = "form-control-custom", placeholder = "Enter related party session ID" } })
                                    @Html.ValidationMessageFor(model => model.RelatedPartySessionID, "", new { @class = "validation-message" })
                                </div>

                                <!-- Reference Information -->
                                <div class="reference-panel">
                                    <div class="reference-header">
                                        <i class="fa fa-info-circle"></i> Reference Information
                                    </div>
                                    <div class="reference-item">
                                        <strong>Shift Codes:</strong><br>
                                        1 = Morning Shift<br>
                                        2 = Evening Shift<br>
                                        3 = Night Shift
                                    </div>
                                    <div class="reference-item">
                                        <strong>Admission Types:</strong><br>
                                        1 = Emergency<br>
                                        2 = Routine<br>
                                        3 = Scheduled
                                    </div>
                                    <div class="reference-item">
                                        <strong>Note:</strong> All nurse IDs should reference valid employee records in the system.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-submit">
                            <i class="fa fa-save"></i> Create Nurse Shift
                        </button>
                        <a href="@Url.Action("Index")" class="btn-back">
                            <i class="fa fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            // Set default created date to current datetime
            var now = new Date();
            var formatted = now.toISOString().slice(0, 16);
            $('#CreatedDate').val(formatted);

            // Form submission handling
            $('form').submit(function () {
                $('.form-container').addClass('loading');
            });

            // Input validation styling
            $('.form-control-custom').on('blur', function () {
                if ($(this).val().trim() === '') {
                    $(this).addClass('is-invalid');
                } else {
                    $(this).removeClass('is-invalid');
                }
            });

            // Auto-format shift input
            $('#Shift').on('change', function () {
                var shift = $(this).val();
                if (shift >= 1 && shift <= 3) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                }
            });
        });
    </script>
</body>
</html>