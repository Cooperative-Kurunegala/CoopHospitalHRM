@model HR_Application_CO_OP_HOS.Models.NurseShift

@{
    ViewBag.Title = "Nurse Shift Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Nurse Shift Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .header-content .lead {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
            min-height: calc(100vh - 200px);
        }

        .details-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .details-header {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            padding: 25px 30px;
        }

            .details-header h3 {
                margin: 0;
                font-size: 1.6rem;
                font-weight: 600;
            }

        .details-body {
            padding: 30px;
        }

        /* Details Layout */
        .details-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        @@media (max-width: 992px) {
            .details-layout {
                grid-template-columns: 1fr;
            }
        }

        /* Details Groups */
        .details-group {
            margin-bottom: 25px;
        }

        .details-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .details-value {
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            color: #495057;
            min-height: 48px;
            display: flex;
            align-items: center;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        /* Related Information Panel */
        .related-info-panel {
            background: #e8f4fd;
            border: 1px solid #b3d9ff;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
        }

        .related-info-header {
            font-weight: 600;
            color: #004085;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .related-info-item {
            padding: 8px 0;
            border-bottom: 1px solid #cce7ff;
            font-size: 0.9rem;
        }

            .related-info-item:last-child {
                border-bottom: none;
            }

        /* Action Buttons */
        .action-buttons {
            padding: 25px 30px;
            background: #f8f9fa;
            border-top: 1px solid #e9ecef;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-edit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
                color: white;
                text-decoration: none;
            }

        .btn-back {
            background: #95a5a6;
            border: none;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            font-size: 1rem;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-back:hover {
                background: #7f8c8d;
                transform: translateY(-1px);
                color: white;
                text-decoration: none;
            }

        /* Timeline */
        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 20px;
            padding-left: 20px;
        }

            .timeline-item:before {
                content: '';
                position: absolute;
                left: -30px;
                top: 0;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #3498db;
            }

            .timeline-item:after {
                content: '';
                position: absolute;
                left: -24px;
                top: 12px;
                width: 2px;
                height: calc(100% + 8px);
                background: #3498db;
            }

            .timeline-item:last-child:after {
                display: none;
            }

        .timeline-date {
            font-weight: 600;
            color: #3498db;
            font-size: 0.9rem;
        }

        .timeline-content {
            color: #666;
            font-size: 0.9rem;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .dashboard-header {
                padding: 20px;
            }

            .header-content h1 {
                font-size: 2rem;
            }

            .main-content {
                padding: 15px;
            }

            .details-body {
                padding: 20px;
            }

            .action-buttons {
                padding: 20px;
                flex-direction: column;
            }

            .btn-edit, .btn-back {
                width: 100%;
                text-align: center;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1><i class="fa fa-eye"></i> Nurse Shift Details</h1>
                <p class="lead">View detailed information about nurse shift assignment</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="details-container">
                <div class="details-header">
                    <h3><i class="fa fa-calendar"></i> Shift Assignment #@Model.ID</h3>
                </div>

                <div class="details-body">
                    <div class="details-layout">
                        <!-- Left Column -->
                        <div>
                            <div class="details-group">
                                <div class="details-label">Admission Type</div>
                                <div class="details-value">
                                    @GetAdmissionTypeName(Model.AdmissionType)
                                    <span class="badge badge-secondary ml-2">@Model.AdmissionType</span>
                                </div>
                            </div>

                            <div class="details-group">
                                <div class="details-label">Received Nurse ID</div>
                                <div class="details-value">
                                    @(Model.ReceivedNurse?.ToString() ?? "Not assigned")
                                    @if (Model.ReceivedNurse.HasValue)
                                    {
                                        <span class="status-badge status-active ml-2">Assigned</span>
                                    }
                                </div>
                            </div>

                            <div class="details-group">
                                <div class="details-label">Additional Nurse In Charge</div>
                                <div class="details-value">
                                    @(Model.NurseInChargeAdditional?.ToString() ?? "Not assigned")
                                </div>
                            </div>

                            <div class="details-group">
                                <div class="details-label">Assistant Nurse</div>
                                <div class="details-value">
                                    @(Model.AssitantNurse?.ToString() ?? "Not assigned")
                                </div>
                            </div>

                            <!-- Timeline -->
                            <div class="details-group">
                                <div class="details-label">Activity Timeline</div>
                                <div class="timeline">
                                    <div class="timeline-item">
                                        <div class="timeline-date">Record Created</div>
                                        <div class="timeline-content">@Model.CreatedDate</div>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="timeline-date">Last Accessed</div>
                                        <div class="timeline-content">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div>
                            <div class="details-group">
                                <div class="details-label">Nurse In Charge</div>
                                <div class="details-value">
                                    @(Model.NurseInCharge?.ToString() ?? "Not assigned")
                                    @if (Model.NurseInCharge.HasValue)
                                    {
                                        <span class="status-badge status-active ml-2">Primary</span>
                                    }
                                </div>
                            </div>

                            <div class="details-group">
                                <div class="details-label">Shift</div>
                                <div class="details-value">
                                    <span class="status-badge @(Model.Shift.HasValue ? "status-active" : "status-inactive")">
                                        @GetShiftName(Model.Shift)
                                    </span>
                                    @if (Model.Shift.HasValue)
                                    {
                                        <span class="badge badge-secondary ml-2">Code: @Model.Shift</span>
                                    }
                                </div>
                            </div>

                            <div class="details-group">
                                <div class="details-label">Created Date</div>
                                <div class="details-value">
                                    <i class="fa fa-calendar"></i> @Model.CreatedDate
                                </div>
                            </div>

                            <div class="details-group">
                                <div class="details-label">Related Party Session ID</div>
                                <div class="details-value">
                                    @(Model.RelatedPartySessionID?.ToString() ?? "Not linked")
                                </div>
                            </div>

                            <!-- Related Information -->
                            <div class="related-info-panel">
                                <div class="related-info-header">
                                    <i class="fa fa-info-circle"></i> Reference Information
                                </div>
                                <div class="related-info-item">
                                    <strong>Shift Codes:</strong> 1=Morning, 2=Evening, 3=Night
                                </div>
                                <div class="related-info-item">
                                    <strong>Admission Types:</strong> 1=Emergency, 2=Routine, 3=Scheduled
                                </div>
                                <div class="related-info-item">
                                    <strong>Record ID:</strong> @Model.ID
                                </div>
                                <div class="related-info-item">
                                    <strong>System Status:</strong> <span class="text-success">Active</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="action-buttons">
                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn-edit">
                        <i class="fa fa-edit"></i> Edit This Shift
                    </a>
                    <a href="@Url.Action("Index")" class="btn-back">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Add some interactive elements
            $('.details-value').hover(function () {
                $(this).css('background-color', '#e9ecef');
            }, function () {
                $(this).css('background-color', '#f8f9fa');
            });

            // Print functionality
            $('.btn-print').click(function () {
                window.print();
            });
        });
    </script>
</body>
</html>

@functions {
    public string GetShiftName(int? shift)
    {
        switch (shift)
        {
            case 1: return "Morning Shift";
            case 2: return "Evening Shift";
            case 3: return "Night Shift";
            default: return "Not Assigned";
        }
    }

    public string GetAdmissionTypeName(int? admissionType)
    {
        switch (admissionType)
        {
            case 1: return "Emergency Admission";
            case 2: return "Routine Admission";
            case 3: return "Scheduled Admission";
            default: return "Unknown Type";
        }
    }
}