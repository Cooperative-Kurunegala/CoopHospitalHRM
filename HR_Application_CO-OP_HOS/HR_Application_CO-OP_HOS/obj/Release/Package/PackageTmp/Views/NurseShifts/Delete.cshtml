@model HR_Application_CO_OP_HOS.Models.NurseShift

@{
    ViewBag.Title = "Delete Nurse Shift";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Nurse Shift</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .header-content h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .header-content .lead {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
            min-height: calc(100vh - 200px);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .delete-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            max-width: 800px;
            width: 100%;
        }

        .delete-header {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
            padding: 25px 30px;
            text-align: center;
        }

            .delete-header h3 {
                margin: 0;
                font-size: 1.6rem;
                font-weight: 600;
            }

        .delete-body {
            padding: 30px;
        }

        /* Warning Section */
        .warning-section {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            text-align: center;
        }

        .warning-icon {
            font-size: 3rem;
            color: #721c24;
            margin-bottom: 15px;
        }

        .warning-title {
            font-weight: 600;
            color: #721c24;
            font-size: 1.3rem;
            margin-bottom: 10px;
        }

        .warning-message {
            color: #721c24;
            font-size: 1rem;
        }

        /* Details Section */
        .details-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .details-header {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        @@media (max-width: 576px) {
            .details-grid {
                grid-template-columns: 1fr;
            }
        }

        .detail-item {
            display: flex;
            flex-direction: column;
        }

        .detail-label {
            font-weight: 600;
            color: #495057;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }

        .detail-value {
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 8px 12px;
            font-size: 0.95rem;
            color: #2c3e50;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        /* Impact Analysis */
        .impact-section {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .impact-header {
            font-weight: 600;
            color: #856404;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .impact-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .impact-item {
            padding: 8px 0;
            border-bottom: 1px solid #ffeaa7;
            font-size: 0.9rem;
            color: #856404;
        }

            .impact-item:last-child {
                border-bottom: none;
            }

            .impact-item i {
                margin-right: 8px;
                width: 16px;
            }

        /* Action Buttons */
        .action-buttons {
            padding: 25px 30px;
            background: #f8f9fa;
            border-top: 1px solid #e9ecef;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-delete:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
                color: white;
            }

        .btn-cancel {
            background: #95a5a6;
            border: none;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            font-size: 1rem;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-cancel:hover {
                background: #7f8c8d;
                transform: translateY(-1px);
                color: white;
                text-decoration: none;
            }

        /* Confirmation Dialog */
        .confirmation-dialog {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .confirmation-content {
            background: white;
            border-radius: 15px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .confirmation-icon {
            font-size: 4rem;
            color: #e74c3c;
            margin-bottom: 20px;
        }

        .confirmation-title {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1.4rem;
            margin-bottom: 15px;
        }

        .confirmation-message {
            color: #7f8c8d;
            margin-bottom: 25px;
            font-size: 1rem;
        }

        .confirmation-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        /* Loading States */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .dashboard-header {
                padding: 20px;
            }

            .header-content h1 {
                font-size: 2rem;
            }

            .main-content {
                padding: 15px;
            }

            .delete-body {
                padding: 20px;
            }

            .action-buttons {
                padding: 20px;
                flex-direction: column;
            }

            .btn-delete, .btn-cancel {
                width: 100%;
                text-align: center;
                justify-content: center;
            }

            .confirmation-actions {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <div class="header-content">
                <h1><i class="fa fa-trash"></i> Delete Nurse Shift</h1>
                <p class="lead">Remove nurse shift assignment from the system</p>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="delete-container">
                <div class="delete-header">
                    <h3><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>

                <div class="delete-body">
                    <!-- Warning Section -->
                    <div class="warning-section">
                        <div class="warning-icon">
                            <i class="fa fa-exclamation-circle"></i>
                        </div>
                        <div class="warning-title">Warning: This action cannot be undone!</div>
                        <div class="warning-message">
                            You are about to permanently delete this nurse shift assignment. This action cannot be reversed.
                        </div>
                    </div>

                    <!-- Details Section -->
                    <div class="details-section">
                        <div class="details-header">
                            <i class="fa fa-info-circle"></i> Shift Assignment Details
                        </div>
                        <div class="details-grid">
                            <div class="detail-item">
                                <span class="detail-label">Record ID</span>
                                <span class="detail-value">@Model.ID</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Admission Type</span>
                                <span class="detail-value">
                                    @GetAdmissionTypeName(Model.AdmissionType)
                                    <span class="badge badge-secondary ml-1">@Model.AdmissionType</span>
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Shift Type</span>
                                <span class="detail-value">
                                    <span class="status-badge @(Model.Shift.HasValue ? "status-active" : "status-inactive")">
                                        @GetShiftName(Model.Shift)
                                    </span>
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Created Date</span>
                                <span class="detail-value">@Model.CreatedDate</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Nurse In Charge</span>
                                <span class="detail-value">
                                    @(Model.NurseInCharge?.ToString() ?? "Not assigned")
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Session ID</span>
                                <span class="detail-value">
                                    @(Model.RelatedPartySessionID?.ToString() ?? "Not linked")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Impact Analysis -->
                    <div class="impact-section">
                        <div class="impact-header">
                            <i class="fa fa-chain-broken"></i> This action will:
                        </div>
                        <ul class="impact-list">
                            <li class="impact-item">
                                <i class="fa fa-times text-danger"></i> Permanently remove this shift assignment
                            </li>
                            <li class="impact-item">
                                <i class="fa fa-database text-warning"></i> Delete the record from the database
                            </li>
                            <li class="impact-item">
                                <i class="fa fa-history text-info"></i> Be logged in the system audit trail
                            </li>
                            <li class="impact-item">
                                <i class="fa fa-warning text-danger"></i> Cannot be recovered without backup
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Action Buttons -->
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)

                    <div class="action-buttons">
                        <button type="button" class="btn-delete" id="deleteButton">
                            <i class="fa fa-trash"></i> Delete Permanently
                        </button>
                        <a href="@Url.Action("Index")" class="btn-cancel">
                            <i class="fa fa-arrow-left"></i> Cancel & Return
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Confirmation Dialog -->
    <div class="confirmation-dialog" id="confirmationDialog">
        <div class="confirmation-content">
            <div class="confirmation-icon">
                <i class="fa fa-question-circle"></i>
            </div>
            <div class="confirmation-title">Final Confirmation</div>
            <div class="confirmation-message">
                Are you absolutely sure you want to delete Nurse Shift #@Model.ID?<br>
                <strong>This action is permanent and cannot be undone.</strong>
            </div>
            <div class="confirmation-actions">
                <button type="button" class="btn-delete" id="confirmDelete">
                    <i class="fa fa-check"></i> Yes, Delete It
                </button>
                <button type="button" class="btn-cancel" id="cancelDelete">
                    <i class="fa fa-times"></i> Cancel
                </button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Confirmation dialog handling
            $('#deleteButton').click(function () {
                $('#confirmationDialog').fadeIn();
            });

            $('#cancelDelete').click(function () {
                $('#confirmationDialog').fadeOut();
            });

            $('#confirmDelete').click(function () {
                // Show loading state
                $('.delete-container').addClass('loading');
                $('#confirmationDialog').fadeOut();

                // Submit the form after a brief delay to show loading
                setTimeout(function () {
                    $('form').submit();
                }, 1000);
            });

            // Close dialog when clicking outside
            $(document).click(function (e) {
                if ($(e.target).hasClass('confirmation-dialog')) {
                    $('#confirmationDialog').fadeOut();
                }
            });

            // Escape key to close dialog
            $(document).keyup(function (e) {
                if (e.keyCode === 27) {
                    $('#confirmationDialog').fadeOut();
                }
            });

            // Add some visual feedback
            $('.detail-value').hover(function () {
                $(this).css('background-color', '#e9ecef');
            }, function () {
                $(this).css('background-color', 'white');
            });
        });
    </script>
</body>
</html>

@functions {
    public string GetShiftName(int? shift)
    {
        switch (shift)
        {
            case 1: return "Morning Shift";
            case 2: return "Evening Shift";
            case 3: return "Night Shift";
            default: return "Not Assigned";
        }
    }

    public string GetAdmissionTypeName(int? admissionType)
    {
        switch (admissionType)
        {
            case 1: return "Emergency";
            case 2: return "Routine";
            case 3: return "Scheduled";
            default: return "Unknown";
        }
    }
}