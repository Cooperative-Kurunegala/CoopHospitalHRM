﻿@model HR_Application_CO_OP_HOS.Models.Allowance

@{
    ViewBag.Title = "Edit Allowance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">EDIT ALLOWANCE</h1>
            <p class="hospital-subtitle">Update Allowance Information</p>
            <div class="admin-info">
                <span class="admin-welcome">Welcome, System Administrator</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="row no-gutters">
            <div class="col-md-12 dashboard-section">
                <div class="section-header">
                    <h2>✏️ EDIT ALLOWANCE DETAILS</h2>
                </div>
                <div class="section-content">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-container" style="background:#f8f9fa;border:3px solid #006400;border-radius:15px;padding:40px;">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.AllowanceID)

                            <div class="form-grid">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.AllowanceName, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.AllowanceName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter allowance name" } })
                                    @Html.ValidationMessageFor(model => model.AllowanceName, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.AllowanceType, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.AllowanceType, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., Travel, Medical, Housing" } })
                                    @Html.ValidationMessageFor(model => model.AllowanceType, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00" } })
                                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.IsPercentage, htmlAttributes: new { @class = "form-label" })
                                    <div class="checkbox-container">
                                        @Html.EditorFor(model => model.IsPercentage)
                                        @Html.ValidationMessageFor(model => model.IsPercentage, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.PercentageOf, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.PercentageOf, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., Basic Salary" } })
                                    @Html.ValidationMessageFor(model => model.PercentageOf, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.IsTaxable, htmlAttributes: new { @class = "form-label" })
                                    <div class="checkbox-container">
                                        @Html.EditorFor(model => model.IsTaxable)
                                        @Html.ValidationMessageFor(model => model.IsTaxable, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group full-width">
                                    @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-label" })
                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 4, placeholder = "Enter allowance description..." })
                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "form-label" })
                                    <div class="checkbox-container">
                                        @Html.EditorFor(model => model.IsActive)
                                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <span>💾 Save Changes</span>
                                </button>
                                <a href="@Url.Action("Index", "Allowances")" class="btn btn-secondary btn-lg">
                                    <span>📋 Back to List</span>
                                </a>
                                <a href="@Url.Action("Details", "Allowances", new { id = Model.AllowanceID })" class="btn btn-info btn-lg">
                                    <span>👁️ View Details</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-container {
        max-width: 100%;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
        margin-bottom: 40px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        font-weight: bold;
        margin-bottom: 10px;
        font-size: 1.8rem;
        color: #006400;
    }

    .form-control {
        width: 100%;
        padding: 15px;
        font-size: 1.6rem;
        border: 2px solid #006400;
        border-radius: 10px;
        background: white;
    }

    .checkbox-container {
        margin-top: 10px;
    }

        .checkbox-container input[type="checkbox"] {
            transform: scale(1.5);
            margin-right: 10px;
        }

    .form-actions {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 40px;
    }

    .btn-lg {
        padding: 20px 40px;
        font-size: 1.8rem;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}