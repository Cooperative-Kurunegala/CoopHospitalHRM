﻿@model HR_Application_CO_OP_HOS.Models.Allowance

@{
    ViewBag.Title = "Delete Allowance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">DELETE ALLOWANCE</h1>
            <p class="hospital-subtitle">Remove Allowance from System</p>
            <div class="admin-info">
                <span class="admin-welcome">Welcome, System Administrator</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="row no-gutters">
            <div class="col-md-8 dashboard-section">
                <div class="section-header">
                    <h2>⚠️ CONFIRM DELETION</h2>
                </div>
                <div class="section-content">
                    <div class="alert alert-danger" style="background:#f8d7da;border:3px solid #dc3545;border-radius:15px;padding:40px;">
                        <h3 style="color:#dc3545;margin-bottom:20px;">🚨 Warning: This action cannot be undone!</h3>
                        <p style="font-size:1.8rem;margin-bottom:30px;">
                            You are about to delete the following allowance. This action will permanently remove the allowance from the system.
                        </p>

                        <div class="detail-card" style="background:white;border:2px solid #dc3545;border-radius:10px;padding:30px;">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <strong>Allowance Name:</strong>
                                        <span>@Html.DisplayFor(model => model.AllowanceName)</span>
                                    </div>
                                    <div class="detail-item">
                                        <strong>Allowance Type:</strong>
                                        <span>@Html.DisplayFor(model => model.AllowanceType)</span>
                                    </div>
                                    <div class="detail-item">
                                        <strong>Amount:</strong>
                                        <span>@Html.DisplayFor(model => model.Amount)</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <strong>Is Percentage:</strong>
                                        <span>
                                            @if (Model.IsPercentage)
                                            {
                                                <span class="badge badge-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">No</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="detail-item">
                                        <strong>Is Taxable:</strong>
                                        <span>
                                            @if (Model.IsTaxable)
                                            {
                                                <span class="badge badge-warning">Taxable</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-info">Non-Taxable</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="detail-item">
                                        <strong>Status:</strong>
                                        <span>
                                            @if (Model.IsActive)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Inactive</span>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <div class="detail-item full-width">
                                    <strong>Description:</strong>
                                    <p style="background:#f8f9fa;padding:15px;border-radius:5px;margin-top:10px;">@Model.Description</p>
                                </div>
                            }
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-actions" style="margin-top:40px;">
                                <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('Are you absolutely sure you want to delete this allowance? This action cannot be undone.')">
                                    <span>🗑️ Confirm Delete</span>
                                </button>
                                <a href="@Url.Action("Index", "Allowances")" class="btn btn-secondary btn-lg">
                                    <span>📋 Cancel</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 dashboard-section">
                <div class="section-header">
                    <h2>💡 IMPORTANT NOTES</h2>
                </div>
                <div class="section-content">
                    <div class="info-card" style="background:#fff3cd;border:3px solid #ffc107;border-radius:15px;padding:30px;">
                        <h4 style="color:#856404;">Before Deleting:</h4>
                        <ul style="font-size:1.6rem;color:#856404;">
                            <li>Check if this allowance is assigned to any employees</li>
                            <li>Ensure no active payroll records use this allowance</li>
                            <li>Consider deactivating instead of deleting</li>
                            <li>Backup important data if needed</li>
                        </ul>
                    </div>

                    <div class="action-grid" style="margin-top:30px;">
                        <a href="@Url.Action("Edit", "Allowances", new { id = Model.AllowanceID })" class="action-card">
                            <div class="action-icon">✏️</div>
                            <span>Edit Instead</span>
                        </a>
                        <a href="@Url.Action("Details", "Allowances", new { id = Model.AllowanceID })" class="action-card">
                            <div class="action-icon">👁️</div>
                            <span>View Details</span>
                        </a>
                        <a href="@Url.Action("Index", "EmployeeAllowances")" class="action-card">
                            <div class="action-icon">💼</div>
                            <span>Check Assignments</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-item {
        padding: 12px 0;
        border-bottom: 1px solid #dee2e6;
        font-size: 1.8rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .full-width {
        flex-direction: column;
        align-items: flex-start;
    }

    .badge {
        font-size: 1.4rem;
        padding: 8px 12px;
    }

    .form-actions {
        display: flex;
        gap: 20px;
        justify-content: center;
    }

    .btn-lg {
        padding: 20px 40px;
        font-size: 1.8rem;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }
</style>