@model HR_Application_CO_OP_HOS.Models.Allowance

@{
    ViewBag.Title = "Create Allowance";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create New Allowance</h1>
            <p class="lead">Add a new allowance record for employees</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Allowance Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm("Create", "Allowances", FormMethod.Post, new { @class = "form-horizontal", id = "createForm" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="form-row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.EmployeeId, "Employee *", htmlAttributes: new { @class = "control-label" })
                                    @Html.DropDownList("EmployeeId", null, "-- Select Employee --", htmlAttributes: new { @class = "form-control select2", required = "required" })
                                    @Html.ValidationMessageFor(model => model.EmployeeId, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Select the employee for this allowance</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.AllowanceType, "Allowance Type *", htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.AllowanceType, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter allowance type", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.AllowanceType, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">e.g., Travel Allowance, Housing Allowance, etc.</small>
                                </div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Amount, "Amount *", htmlAttributes: new { @class = "control-label" })
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">$</span>
                                        </div>
                                        @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control", placeholder = "0.00", type = "number", step = "0.01", min = "0", required = "required" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.EffectiveDate, "Effective Date *", htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.EffectiveDate, new { htmlAttributes = new { @class = "form-control", type = "date", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.EffectiveDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CreatedDate, "Created Date", htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                    @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CreatedBy, "Created By", htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control", type = "number", placeholder = "User ID" } })
                                    @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fa fa-save"></i> Create Allowance
                            </button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            <button type="button" id="resetForm" class="btn btn-warning btn-lg">
                                <i class="fa fa-refresh"></i> Reset Form
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Information Panel -->
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Quick Information</h3>
                </div>
                <div class="panel-body">
                    <div class="info-section">
                        <h5><i class="fa fa-users text-primary"></i> Employee Details</h5>
                        <div id="employeeInfo" class="text-muted">
                            Select an employee to view details
                        </div>
                    </div>

                    <hr>

                    <div class="info-section">
                        <h5><i class="fa fa-money text-success"></i> Allowance Types</h5>
                        <ul class="list-unstyled">
                            <li><span class="badge badge-primary">Travel</span> - For travel expenses</li>
                            <li><span class="badge badge-success">Housing</span> - Accommodation support</li>
                            <li><span class="badge badge-info">Medical</span> - Health related</li>
                            <li><span class="badge badge-warning">Education</span> - Learning support</li>
                            <li><span class="badge badge-danger">Special</span> - Unique circumstances</li>
                        </ul>
                    </div>

                    <hr>

                    <div class="info-section">
                        <h5><i class="fa fa-lightbulb-o text-warning"></i> Tips</h5>
                        <ul class="list-unstyled">
                            <li><i class="fa fa-check text-success"></i> Ensure all required fields are filled</li>
                            <li><i class="fa fa-check text-success"></i> Verify employee selection</li>
                            <li><i class="fa fa-check text-success"></i> Double-check amount values</li>
                            <li><i class="fa fa-check text-success"></i> Set appropriate effective date</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Initialize select2
            $('.select2').select2();

            // Reset form
            $('#resetForm').click(function () {
                if (confirm('Are you sure you want to reset the form? All entered data will be lost.')) {
                    document.getElementById('createForm').reset();
                    $('.select2').val(null).trigger('change');
                }
            });

            // Employee selection change
            $('#EmployeeId').change(function () {
                var employeeId = $(this).val();
                if (employeeId) {
                    // Simulate employee data fetch (in real scenario, this would be an AJAX call)
                    $('#employeeInfo').html(`
                        <div class="alert alert-info">
                            <strong>Employee Selected:</strong><br>
                            ID: ${employeeId}<br>
                            <small>Additional details would be loaded here</small>
                        </div>
                    `);
                } else {
                    $('#employeeInfo').html('<div class="text-muted">Select an employee to view details</div>');
                }
            });

            // Form submission handling
            $('#createForm').submit(function (e) {
                var amount = $('#Amount').val();
                if (amount && parseFloat(amount) <= 0) {
                    e.preventDefault();
                    alert('Amount must be greater than 0');
                    return false;
                }

                // Show loading state
                $('button[type="submit"]').html('<i class="fa fa-spinner fa-spin"></i> Creating...').prop('disabled', true);
            });

            // Auto-fill current date for CreatedDate if empty
            if (!$('#CreatedDate').val()) {
                var now = new Date();
                var formatted = now.toISOString().slice(0, 16);
                $('#CreatedDate').val(formatted);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 25px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 25px;
        background: white;
    }

    .panel-heading {
        border-radius: 15px 15px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .control-label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #2c3e50;
    }

    .form-control {
        border-radius: 8px;
        border: 2px solid #e9ecef;
        padding: 12px 15px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .input-group-text {
        background-color: #f8f9fa;
        border: 2px solid #e9ecef;
        border-right: none;
    }

    .info-section {
        margin-bottom: 20px;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 1.1rem;
        border-radius: 8px;
        margin-right: 10px;
        margin-bottom: 10px;
    }

    .select2-container--default .select2-selection--single {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        height: calc(2.25rem + 14px);
        padding: 6px;
    }

    .badge {
        font-size: 0.7em;
        padding: 4px 8px;
    }
</style>