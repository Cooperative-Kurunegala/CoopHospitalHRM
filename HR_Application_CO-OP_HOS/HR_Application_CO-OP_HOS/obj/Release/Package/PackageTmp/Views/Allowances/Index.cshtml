@model IEnumerable<HR_Application_CO_OP_HOS.Models.Allowance>

@{
    ViewBag.Title = "Allowances Management";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-money"></i> Allowances Management</h1>
            <p class="lead">Manage employee allowances and compensation</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-4">
                            <a href="@Url.Action("Create")" class="btn btn-success btn-block">
                                <i class="fa fa-plus"></i> Create New Allowance
                            </a>
                        </div>
                        <div class="col-md-4">
                            <button id="exportBtn" class="btn btn-info btn-block">
                                <i class="fa fa-download"></i> Export Data
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button id="filterToggle" class="btn btn-warning btn-block">
                                <i class="fa fa-filter"></i> Toggle Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div id="filterSection" class="row no-gutters mb-4" style="display: none;">
        <div class="col-12">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filter Allowances</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Employee</label>
                                @Html.DropDownList("EmployeeFilter", null, "All Employees", new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Allowance Type</label>
                                <input type="text" id="typeFilter" class="form-control" placeholder="Filter by type..." />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Amount Range</label>
                                <select id="amountFilter" class="form-control">
                                    <option value="">All Amounts</option>
                                    <option value="0-1000">0 - 1,000</option>
                                    <option value="1001-5000">1,001 - 5,000</option>
                                    <option value="5001-10000">5,001 - 10,000</option>
                                    <option value="10001+">Above 10,000</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Effective Date</label>
                                <input type="date" id="dateFilter" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row no-gutters mt-3">
                        <div class="col-12 text-center">
                            <button id="applyFilters" class="btn btn-primary">Apply Filters</button>
                            <button id="clearFilters" class="btn btn-secondary">Clear Filters</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-list"></i> Allowances List</h3>
                </div>
                <div class="panel-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="allowancesTable">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Allowance Type</th>
                                        <th>Amount</th>
                                        <th>Effective Date</th>
                                        <th>Created Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (item.RelatedParty != null)
                                                {
                                                    @item.RelatedParty.RegistrationNumber
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not Assigned</span>
                                                }
                                            </td>
                                            <td>@Html.DisplayFor(modelItem => item.AllowanceType)</td>
                                            <td class="text-success font-weight-bold">@Html.DisplayFor(modelItem => item.Amount)</td>
                                            <td>@Html.DisplayFor(modelItem => item.EffectiveDate)</td>
                                            <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary Section -->
                        <div class="row no-gutters mt-4">
                            <div class="col-md-3">
                                <div class="stat-card bg-primary text-white text-center p-3 rounded">
                                    <h4>Total Allowances</h4>
                                    <p class="stat-number">@Model.Count()</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card bg-success text-white text-center p-3 rounded">
                                    <h4>Total Amount</h4>
                                    <p class="stat-number">@Model.Sum(a => a.Amount).ToString("C")</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card bg-info text-white text-center p-3 rounded">
                                    <h4>Average Amount</h4>
                                    <p class="stat-number">@Model.Average(a => a.Amount).ToString("C")</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card bg-warning text-white text-center p-3 rounded">
                                    <h4>Unique Types</h4>
                                    <p class="stat-number">@Model.Select(a => a.AllowanceType).Distinct().Count()</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fa fa-exclamation-triangle fa-2x"></i>
                            <h4>No Allowances Found</h4>
                            <p>There are no allowances in the system. Click "Create New" to add the first allowance.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Toggle filter section
            $('#filterToggle').click(function () {
                $('#filterSection').slideToggle();
            });

            // Apply filters
            $('#applyFilters').click(function () {
                applyTableFilters();
            });

            // Clear filters
            $('#clearFilters').click(function () {
                $('#EmployeeFilter').val('');
                $('#typeFilter').val('');
                $('#amountFilter').val('');
                $('#dateFilter').val('');
                applyTableFilters();
            });

            // Export functionality
            $('#exportBtn').click(function () {
                exportToExcel();
            });

            function applyTableFilters() {
                var employeeFilter = $('#EmployeeFilter').val().toLowerCase();
                var typeFilter = $('#typeFilter').val().toLowerCase();
                var amountFilter = $('#amountFilter').val();
                var dateFilter = $('#dateFilter').val();

                $('#allowancesTable tbody tr').each(function () {
                    var row = $(this);
                    var employee = row.find('td:eq(0)').text().toLowerCase();
                    var type = row.find('td:eq(1)').text().toLowerCase();
                    var amount = parseFloat(row.find('td:eq(2)').text().replace(/[^0-9.-]+/g, ""));
                    var date = row.find('td:eq(3)').text();

                    var showRow = true;

                    if (employeeFilter && employee.indexOf(employeeFilter) === -1) {
                        showRow = false;
                    }
                    if (typeFilter && type.indexOf(typeFilter) === -1) {
                        showRow = false;
                    }
                    if (amountFilter) {
                        switch (amountFilter) {
                            case '0-1000':
                                if (amount > 1000) showRow = false;
                                break;
                            case '1001-5000':
                                if (amount < 1001 || amount > 5000) showRow = false;
                                break;
                            case '5001-10000':
                                if (amount < 5001 || amount > 10000) showRow = false;
                                break;
                            case '10001+':
                                if (amount < 10001) showRow = false;
                                break;
                        }
                    }
                    if (dateFilter && date.indexOf(dateFilter) === -1) {
                        showRow = false;
                    }

                    if (showRow) {
                        row.show();
                    } else {
                        row.hide();
                    }
                });
            }

            function exportToExcel() {
                // Simple export implementation
                var table = document.getElementById('allowancesTable');
                var html = table.outerHTML;
                var url = 'data:application/vnd.ms-excel,' + escape(html);
                var downloadLink = document.createElement('a');
                downloadLink.href = url;
                downloadLink.download = 'allowances_export.xls';
                document.body.appendChild(downloadLink);
                downloadLink.click();
                document.body.removeChild(downloadLink);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 25px;
        background: white;
    }

    .panel-heading {
        border-radius: 15px 15px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .table th {
        background-color: #34495e;
        color: white;
        border: none;
        padding: 15px;
    }

    .table td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .btn-group .btn {
        margin: 2px;
    }

    .stat-card {
        margin: 10px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.1);
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        margin: 10px 0;
    }

    .alert {
        border-radius: 15px;
        padding: 30px;
    }
</style>