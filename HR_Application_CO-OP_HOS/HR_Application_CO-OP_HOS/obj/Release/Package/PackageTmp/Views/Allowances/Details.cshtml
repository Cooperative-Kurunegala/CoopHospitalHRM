@model HR_Application_CO_OP_HOS.Models.Allowance

@{
    ViewBag.Title = "Allowance Details";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-eye"></i> Allowance Details</h1>
            <p class="lead">View comprehensive allowance information</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Main Details -->
        <div class="col-md-8">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Allowance Information</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-card">
                                <h5><i class="fa fa-user text-primary"></i> Employee Information</h5>
                                <div class="detail-content">
                                    <strong>Employee ID:</strong> @Html.DisplayFor(model => model.EmployeeId)<br>
                                    <strong>Registration No:</strong> @(Model.RelatedParty?.RegistrationNumber ?? "N/A")<br>
                                    <strong>Employee Name:</strong> @(Model.RelatedParty?.RelatedPartyName ?? "N/A")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-card">
                                <h5><i class="fa fa-money text-success"></i> Allowance Details</h5>
                                <div class="detail-content">
                                    <strong>Type:</strong> <span class="badge badge-primary">@Html.DisplayFor(model => model.AllowanceType)</span><br>
                                    <strong>Amount:</strong> <span class="text-success font-weight-bold">@Html.DisplayFor(model => model.Amount)</span><br>
                                    <strong>Effective:</strong> @Html.DisplayFor(model => model.EffectiveDate)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="detail-card">
                                <h5><i class="fa fa-history text-warning"></i> System Information</h5>
                                <div class="detail-content">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <strong>Created Date:</strong> @Html.DisplayFor(model => model.CreatedDate)<br>
                                            <strong>Created By:</strong> @Html.DisplayFor(model => model.CreatedBy)
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Modified Date:</strong> @Html.DisplayFor(model => model.ModifiedDate)<br>
                                            <strong>Modified By:</strong> @Html.DisplayFor(model => model.ModifiedBy)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Information -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-link"></i> Related Information</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i>
                        <strong>Note:</strong> This allowance is linked to employee records and payroll calculations.
                    </div>

                    <!-- Simulated related data -->
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Recent Similar Allowances</h6>
                            <div class="list-group">
                                <div class="list-group-item">
                                    <small>Travel Allowance - $500.00</small>
                                </div>
                                <div class="list-group-item">
                                    <small>Housing Allowance - $1,200.00</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6>Employee Statistics</h6>
                            <div class="list-group">
                                <div class="list-group-item">
                                    <small>Total Allowances: 3</small>
                                </div>
                                <div class="list-group-item">
                                    <small>Average Amount: $867.00</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Panel -->
        <div class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-cogs"></i> Actions</h3>
                </div>
                <div class="panel-body text-center">
                    <div class="action-buttons">
                        @Html.ActionLink("Edit This Allowance", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning btn-block btn-lg mb-3" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-block btn-lg mb-3" })

                        <hr>

                        <div class="quick-actions">
                            <button class="btn btn-outline-info btn-block mb-2" onclick="printDetails()">
                                <i class="fa fa-print"></i> Print Details
                            </button>
                            <button class="btn btn-outline-success btn-block mb-2" onclick="exportDetails()">
                                <i class="fa fa-download"></i> Export as PDF
                            </button>
                            <button class="btn btn-outline-primary btn-block mb-2" onclick="shareDetails()">
                                <i class="fa fa-share"></i> Share Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary Panel -->
            <div class="panel panel-success mt-4">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Summary</h3>
                </div>
                <div class="panel-body">
                    <div class="summary-item">
                        <i class="fa fa-calendar text-primary"></i>
                        <div>
                            <strong>Effective Since</strong>
                            <div class="text-muted">
                                @{
                                    var effectiveDate = Model.EffectiveDate;
                                    var daysActive = (DateTime.Now - effectiveDate).Days;
                                }
                                @daysActive days ago
                            </div>
                        </div>
                    </div>

                    <div class="summary-item mt-3">
                        <i class="fa fa-money text-success"></i>
                        <div>
                            <strong>Annual Value</strong>
                            <div class="text-muted">
                                @((Model.Amount * 12).ToString("C"))
                            </div>
                        </div>
                    </div>

                    <div class="summary-item mt-3">
                        <i class="fa fa-percent text-info"></i>
                        <div>
                            <strong>Status</strong>
                            <div class="text-success">
                                <span class="badge badge-success">Active</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function printDetails() {
            window.print();
        }

        function exportDetails() {
            alert('Export feature would be implemented here');
            // In real implementation, this would generate a PDF
        }

        function shareDetails() {
            alert('Share feature would be implemented here');
            // In real implementation, this would open share dialog
        }

        // Add some interactivity
        $(document).ready(function () {
            $('.detail-card').hover(function () {
                $(this).css('transform', 'translateY(-2px)');
            }, function () {
                $(this).css('transform', 'translateY(0)');
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #3498db 0%, #2c3e50 100%);
        color: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 25px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 25px;
        background: white;
    }

    .panel-heading {
        border-radius: 15px 15px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .detail-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid #3498db;
        margin-bottom: 15px;
        transition: all 0.3s ease;
    }

    .detail-content {
        margin-top: 10px;
    }

    .action-buttons .btn-lg {
        padding: 15px;
        font-size: 1.1rem;
        border-radius: 10px;
    }

    .summary-item {
        display: flex;
        align-items: center;
        padding: 10px;
    }

        .summary-item i {
            font-size: 1.5rem;
            margin-right: 15px;
            width: 30px;
        }

    .badge {
        font-size: 0.8em;
        padding: 5px 10px;
    }

    .list-group-item {
        border: none;
        border-left: 3px solid #e9ecef;
        margin-bottom: 5px;
        border-radius: 5px;
    }

    @@media print {
        .dashboard-header,
        .panel-heading,
        .action-buttons {
            display: none;
        }

        .dashboard-container {
            background: white;
            padding: 0;
        }

        .panel {
            box-shadow: none;
            border: 1px solid #ddd;
        }
    }
</style>