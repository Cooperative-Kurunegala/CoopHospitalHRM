﻿@model HR_Application_CO_OP_HOS.Models.Allowance

@{
    ViewBag.Title = "Allowance Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">ALLOWANCE DETAILS</h1>
            <p class="hospital-subtitle">View Allowance Information</p>
            <div class="admin-info">
                <span class="admin-welcome">Welcome, System Administrator</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="row no-gutters">
            <div class="col-md-8 dashboard-section">
                <div class="section-header">
                    <h2>📊 ALLOWANCE INFORMATION</h2>
                </div>
                <div class="section-content">
                    <div class="detail-card" style="background:#f8f9fa;border:3px solid #006400;border-radius:15px;padding:40px;">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <strong>Allowance Name:</strong>
                                    <span>@Html.DisplayFor(model => model.AllowanceName)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Allowance Type:</strong>
                                    <span>@Html.DisplayFor(model => model.AllowanceType)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Amount:</strong>
                                    <span>@Html.DisplayFor(model => model.Amount)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Is Percentage:</strong>
                                    <span>
                                        @if (Model.IsPercentage)
                                        {
                                            <span class="badge badge-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">No</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <strong>Percentage Of:</strong>
                                    <span>@(string.IsNullOrEmpty(Model.PercentageOf) ? "N/A" : Model.PercentageOf)</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Is Taxable:</strong>
                                    <span>
                                        @if (Model.IsTaxable)
                                        {
                                            <span class="badge badge-warning">Taxable</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info">Non-Taxable</span>
                                        }
                                    </span>
                                </div>
                                <div class="detail-item">
                                    <strong>Status:</strong>
                                    <span>
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Inactive</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="detail-item full-width">
                                <strong>Description:</strong>
                                <p style="background:white;padding:20px;border-radius:10px;margin-top:10px;">@Model.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 dashboard-section">
                <div class="section-header">
                    <h2>⚡ QUICK ACTIONS</h2>
                </div>
                <div class="section-content">
                    <div class="action-grid">
                        <a href="@Url.Action("Edit", "Allowances", new { id = Model.AllowanceID })" class="action-card">
                            <div class="action-icon">✏️</div>
                            <span>Edit Allowance</span>
                        </a>
                        <a href="@Url.Action("Index", "Allowances")" class="action-card">
                            <div class="action-icon">📋</div>
                            <span>Back to List</span>
                        </a>
                        <a href="@Url.Action("Create", "Allowances")" class="action-card">
                            <div class="action-icon">➕</div>
                            <span>Create New</span>
                        </a>
                        <a href="@Url.Action("Index", "EmployeeAllowances")" class="action-card">
                            <div class="action-icon">💼</div>
                            <span>Assign to Employees</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-item {
        padding: 15px 0;
        border-bottom: 1px solid #dee2e6;
        font-size: 1.8rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .full-width {
        flex-direction: column;
        align-items: flex-start;
    }

    .badge {
        font-size: 1.4rem;
        padding: 8px 12px;
    }
</style>