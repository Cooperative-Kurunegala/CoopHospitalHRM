@model HR_Application_CO_OP_HOS.Models.SalaryModifier

@{
    ViewBag.Title = "Edit Salary Modifier";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Salary Modifier</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 0 !important;
            margin: 0 !important;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-size: 16px;
        }

        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            padding: 20px;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .content-panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            border-left: 6px solid #f39c12;
        }

        .panel-header {
            background: #f39c12;
            color: white;
            padding: 20px 25px;
            border-radius: 12px 12px 0 0;
        }

        .panel-body {
            padding: 30px;
        }

        .form-modern .form-group {
            margin-bottom: 25px;
        }

        .form-modern label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-modern .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .form-modern .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .checkbox-modern {
            transform: scale(1.2);
            margin-right: 10px;
        }

        .btn-modern {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
            font-size: 16px;
            margin-right: 10px;
        }

            .btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .reference-panel {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #3498db;
        }

        .current-values {
            background: #e8f4fd;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .field-validation-error {
            color: #e74c3c;
            font-size: 14px;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background: #e74c3c;
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Header Section -->
        <div class="dashboard-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-edit"></i> Edit Salary Modifier</h1>
                    <p class="lead">Update salary modifier details</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-modern btn-light" })
                    @Html.ActionLink("Details", "Details", new { id = Model.ID }, new { @class = "btn btn-modern btn-info ml-2" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Main Form -->
                <div class="content-panel">
                    <div class="panel-header">
                        <h3 class="mb-0"><i class="fa fa-pencil"></i> Edit Salary Modifier Details</h3>
                    </div>
                    <div class="panel-body">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ID)

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <!-- Current Values Display -->
                            <div class="current-values">
                                <h6><i class="fa fa-info-circle"></i> Current Values</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Name:</strong> @Html.DisplayFor(model => model.SalaryModifierName)
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Status:</strong>
                                        @if (Model.IsEnabled == true)
                                        {
                                            <span class="badge badge-success">Enabled</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Disabled</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="form-modern">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SalaryModifierName)
                                            @Html.EditorFor(model => model.SalaryModifierName, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.SalaryModifierName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SalaryModifierTypeID)
                                            @Html.EditorFor(model => model.SalaryModifierTypeID, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.SalaryModifierTypeID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OrderIndex)
                                            @Html.EditorFor(model => model.OrderIndex, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.OrderIndex, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.TaxTypeID)
                                            @Html.EditorFor(model => model.TaxTypeID, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.TaxTypeID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OTTypeID)
                                            @Html.EditorFor(model => model.OTTypeID, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.OTTypeID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SalaryTypeID)
                                            @Html.EditorFor(model => model.SalaryTypeID, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.SalaryTypeID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <!-- Checkbox Section -->
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsEnabled, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsEnabled, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsBasicSalary, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsBasicSalary, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsAllawance, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsAllawance, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsNoPay, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsNoPay, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsLateHours, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsLateHours, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsLoan, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsLoan, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsEditable, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsEditable, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsRemoved, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsRemoved, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.CommonValueForAll, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.CommonValueForAll, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="form-group text-right mt-4">
                                    <button type="submit" class="btn btn-modern btn-warning">
                                        <i class="fa fa-save"></i> Update Salary Modifier
                                    </button>
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-modern btn-secondary" })
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- Reference Information -->
                <div class="content-panel">
                    <div class="panel-header" style="background: #3498db;">
                        <h3 class="mb-0"><i class="fa fa-history"></i> Modification History</h3>
                    </div>
                    <div class="panel-body">
                        <div class="reference-panel">
                            <h5><i class="fa fa-calendar"></i> Creation Info</h5>
                            <p>
                                <strong>Created Date:</strong>
                                @if (Model.CreatedDate.HasValue)
                                {
                                    @Model.CreatedDate.Value.ToString("yyyy-MM-dd HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Not recorded</span>
                                }
                            </p>
                            <p>
                                <strong>Created By:</strong>
                                @if (Model.CreatedBy.HasValue)
                                {
                                    <span>User @Model.CreatedBy</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not recorded</span>
                                }
                            </p>
                        </div>

                        <div class="reference-panel mt-3">
                            <h5><i class="fa fa-exclamation-triangle"></i> Important Notes</h5>
                            <ul>
                                <li>Changes will affect all associated salary calculations</li>
                                <li>Disabled modifiers won't appear in selection lists</li>
                                <li>Order index changes affect display sequence</li>
                                <li>Review tax implications before saving changes</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>