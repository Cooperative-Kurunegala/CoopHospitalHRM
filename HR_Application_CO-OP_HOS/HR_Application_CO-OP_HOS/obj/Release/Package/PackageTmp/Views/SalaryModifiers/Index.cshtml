@model IEnumerable<HR_Application_CO_OP_HOS.Models.SalaryModifier>

@{
    ViewBag.Title = "Salary Modifiers";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Salary Modifiers</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 0 !important;
            margin: 0 !important;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-size: 16px;
        }

        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            padding: 20px;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .content-panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            border-left: 6px solid #3498db;
        }

        .panel-header {
            background: #3498db;
            color: white;
            padding: 20px 25px;
            border-radius: 12px 12px 0 0;
            display: flex;
            justify-content: between;
            align-items: center;
        }

        .panel-body {
            padding: 25px;
        }

        .btn-modern {
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
            font-size: 16px;
        }

            .btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .table-modern {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

            .table-modern th {
                background: #34495e;
                color: white;
                padding: 15px;
                text-align: left;
                font-weight: 600;
            }

            .table-modern td {
                padding: 12px 15px;
                border-bottom: 1px solid #ecf0f1;
            }

            .table-modern tr:hover {
                background-color: #f8f9fa;
            }

        .filter-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .action-buttons .btn {
            margin-right: 5px;
            padding: 6px 12px;
            font-size: 14px;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-enabled {
            background: #27ae60;
            color: white;
        }

        .badge-disabled {
            background: #e74c3c;
            color: white;
        }

        .no-records {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
            font-size: 18px;
        }

        .pagination-container {
            margin-top: 20px;
            display: flex;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Header Section -->
        <div class="dashboard-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-calculator"></i> Salary Modifiers Management</h1>
                    <p class="lead">Manage salary components, allowances, and deductions</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-modern btn-light" })
                    @Html.ActionLink("Back to Dashboard", "Index", "Home", null, new { @class = "btn btn-modern btn-outline-light ml-2" })
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="content-panel">
            <div class="filter-section">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Search</label>
                            <input type="text" id="searchInput" class="form-control" placeholder="Search modifiers...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Status</label>
                            <select id="statusFilter" class="form-control">
                                <option value="">All Status</option>
                                <option value="true">Enabled</option>
                                <option value="false">Disabled</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Type</label>
                            <select id="typeFilter" class="form-control">
                                <option value="">All Types</option>
                                <option value="true">Allowance</option>
                                <option value="false">Deduction</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button id="resetFilters" class="btn btn-secondary btn-block">Reset Filters</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Table Section -->
        <div class="content-panel">
            <div class="panel-header">
                <h3 class="mb-0"><i class="fa fa-list"></i> Salary Modifiers List</h3>
                <span class="badge badge-light" id="recordCount">@Model.Count() records</span>
            </div>
            <div class="panel-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table-modern">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Order</th>
                                    <th>Basic Salary</th>
                                    <th>Allowance</th>
                                    <th>Loan</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.SalaryModifierName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.SalaryModifierTypeID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.OrderIndex)</td>
                                        <td>
                                            @if (item.IsBasicSalary == true)
                                            {
                                                <span class="badge badge-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">No</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsAllawance == true)
                                            {
                                                <span class="badge badge-info">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">No</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsLoan == true)
                                            {
                                                <span class="badge badge-warning">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">No</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsEnabled == true)
                                            {
                                                <span class="status-badge badge-enabled">Enabled</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge badge-disabled">Disabled</span>
                                            }
                                        </td>
                                        <td class="action-buttons">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-sm btn-primary" })
                                            @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-sm btn-info" })
                                            @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-sm btn-danger" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-records">
                        <i class="fa fa-exclamation-circle fa-3x mb-3"></i>
                        <h4>No Salary Modifiers Found</h4>
                        <p>No salary modifier records available in the system.</p>
                        @Html.ActionLink("Create First Modifier", "Create", null, new { @class = "btn btn-modern btn-primary mt-3" })
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('.table-modern tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
                updateRecordCount();
            });

            // Status filter
            $('#statusFilter').on('change', function () {
                var value = $(this).val();
                filterTable();
            });

            // Type filter
            $('#typeFilter').on('change', function () {
                var value = $(this).val();
                filterTable();
            });

            // Reset filters
            $('#resetFilters').on('click', function () {
                $('#searchInput').val('');
                $('#statusFilter').val('');
                $('#typeFilter').val('');
                $('.table-modern tbody tr').show();
                updateRecordCount();
            });

            function filterTable() {
                var statusValue = $('#statusFilter').val();
                var typeValue = $('#typeFilter').val();
                var searchValue = $('#searchInput').val().toLowerCase();

                $('.table-modern tbody tr').each(function () {
                    var statusMatch = statusValue === '' || $(this).find('.status-badge').text().toLowerCase() === (statusValue === 'true' ? 'enabled' : 'disabled');
                    var typeMatch = typeValue === '' || $(this).find('td:nth-child(5) .badge').text().toLowerCase() === (typeValue === 'true' ? 'yes' : 'no');
                    var searchMatch = $(this).text().toLowerCase().indexOf(searchValue) > -1;

                    $(this).toggle(statusMatch && typeMatch && searchMatch);
                });

                updateRecordCount();
            }

            function updateRecordCount() {
                var visibleCount = $('.table-modern tbody tr:visible').length;
                $('#recordCount').text(visibleCount + ' records');
            }
        });
    </script>
</body>
</html>