@model HR_Application_CO_OP_HOS.Models.SalaryModifier

@{
    ViewBag.Title = "Delete Salary Modifier";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Salary Modifier</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 0 !important;
            margin: 0 !important;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-size: 16px;
        }

        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            padding: 20px;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .content-panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            border-left: 6px solid #e74c3c;
        }

        .panel-header {
            background: #e74c3c;
            color: white;
            padding: 20px 25px;
            border-radius: 12px 12px 0 0;
        }

        .panel-body {
            padding: 30px;
        }

        .warning-section {
            background: #fdf2f2;
            border: 2px solid #e74c3c;
            border-radius: 8px;
            padding: 25px;
            margin-bottom: 25px;
            text-align: center;
        }

        .warning-icon {
            font-size: 4rem;
            color: #e74c3c;
            margin-bottom: 20px;
        }

        .detail-section {
            margin-bottom: 25px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #f8f9fa;
        }

            .detail-row:nth-child(even) {
                background-color: #f8f9fa;
            }

        .detail-label {
            font-weight: 600;
            color: #34495e;
            flex: 1;
        }

        .detail-value {
            flex: 2;
            color: #2c3e50;
        }

        .btn-modern {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
            font-size: 16px;
            margin-right: 10px;
        }

            .btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .flag-item {
            display: inline-flex;
            align-items: center;
            background: #f8f9fa;
            padding: 6px 12px;
            border-radius: 6px;
            margin: 2px;
            font-size: 14px;
        }

        .flag-true {
            background: #d4edda;
            color: #155724;
        }

        .flag-false {
            background: #f8d7da;
            color: #721c24;
        }

        .impact-section {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Header Section -->
        <div class="dashboard-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-exclamation-triangle"></i> Delete Salary Modifier</h1>
                    <p class="lead">Remove salary modifier from the system</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-modern btn-light" })
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-10">
                <!-- Warning Section -->
                <div class="content-panel">
                    <div class="panel-header">
                        <h3 class="mb-0"><i class="fa fa-trash"></i> Confirm Deletion</h3>
                    </div>
                    <div class="panel-body">
                        <div class="warning-section">
                            <div class="warning-icon">
                                <i class="fa fa-exclamation-circle"></i>
                            </div>
                            <h3 class="text-danger">Warning: Critical Operation</h3>
                            <p class="lead">You are about to permanently delete this salary modifier. This action cannot be undone.</p>
                            <div class="impact-section">
                                <h5><i class="fa fa-chain-broken"></i> Potential Impacts</h5>
                                <ul class="text-left">
                                    <li>Affects all associated salary calculations</li>
                                    <li>May impact historical payroll data</li>
                                    <li>Could affect employee compensation</li>
                                    <li>System may require recalibration</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Item Details -->
                        <div class="detail-section">
                            <h4 class="mb-4"><i class="fa fa-list-alt"></i> Item to be Deleted</h4>
                            <div class="detail-row">
                                <div class="detail-label">Modifier Name</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.SalaryModifierName)</div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Modifier Type ID</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.SalaryModifierTypeID)</div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Order Index</div>
                                <div class="detail-value">@Html.DisplayFor(model => model.OrderIndex)</div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Current Status</div>
                                <div class="detail-value">
                                    @if (Model.IsEnabled == true)
                                    {
                                        <span class="flag-item flag-true">
                                            <i class="fa fa-check"></i> Enabled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="flag-item flag-false">
                                            <i class="fa fa-times"></i> Disabled
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Feature Flags -->
                        <div class="detail-section">
                            <h5 class="mb-3">Feature Configuration</h5>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="flag-item @(Model.IsBasicSalary == true ? "flag-true" : "flag-false")">
                                        <i class="fa @(Model.IsBasicSalary == true ? "fa-check" : "fa-times")"></i>
                                        Basic Salary
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="flag-item @(Model.IsAllawance == true ? "flag-true" : "flag-false")">
                                        <i class="fa @(Model.IsAllawance == true ? "fa-check" : "fa-times")"></i>
                                        Allowance
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="flag-item @(Model.IsLoan == true ? "flag-true" : "flag-false")">
                                        <i class="fa @(Model.IsLoan == true ? "fa-check" : "fa-times")"></i>
                                        Loan
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Creation Info -->
                        <div class="detail-section">
                            <h5 class="mb-3">System Information</h5>
                            <div class="detail-row">
                                <div class="detail-label">Created Date</div>
                                <div class="detail-value">
                                    @if (Model.CreatedDate.HasValue)
                                    {
                                        @Model.CreatedDate.Value.ToString("yyyy-MM-dd HH:mm:ss")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }
                                </div>
                            </div>
                            <div class="detail-row">
                                <div class="detail-label">Created By</div>
                                <div class="detail-value">
                                    @if (Model.CreatedBy.HasValue)
                                    {
                                        <span>User @Model.CreatedBy</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Final Confirmation -->
                        <div class="text-center mt-4">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()

                                <div class="alert alert-warning">
                                    <h5><i class="fa fa-shield"></i> Security Confirmation Required</h5>
                                    <p>Type "DELETE" in the box below to confirm this action:</p>
                                    <input type="text" id="confirmDelete" class="form-control text-center" style="max-width: 200px; margin: 0 auto;" placeholder="Type DELETE here">
                                </div>

                                <div class="d-flex justify-content-center gap-3">
                                    <button type="submit" id="deleteButton" class="btn btn-modern btn-danger" disabled>
                                        <i class="fa fa-trash"></i> Confirm Permanent Deletion
                                    </button>
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-modern btn-secondary" })
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#confirmDelete').on('keyup', function () {
                if ($(this).val().toUpperCase() === 'DELETE') {
                    $('#deleteButton').prop('disabled', false);
                } else {
                    $('#deleteButton').prop('disabled', true);
                }
            });

            $('#deleteButton').on('click', function (e) {
                if ($('#confirmDelete').val().toUpperCase() !== 'DELETE') {
                    e.preventDefault();
                    alert('Please type "DELETE" to confirm deletion.');
                    return false;
                }

                return confirm('Are you absolutely sure you want to permanently delete this salary modifier? This action cannot be undone!');
            });
        });
    </script>
</body>
</html>