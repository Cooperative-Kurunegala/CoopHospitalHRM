@model HR_Application_CO_OP_HOS.Models.SalaryModifier

@{
    ViewBag.Title = "Create Salary Modifier";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Salary Modifier</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 0 !important;
            margin: 0 !important;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-size: 16px;
        }

        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            padding: 20px;
        }

        .dashboard-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .content-panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            border-left: 6px solid #27ae60;
        }

        .panel-header {
            background: #27ae60;
            color: white;
            padding: 20px 25px;
            border-radius: 12px 12px 0 0;
        }

        .panel-body {
            padding: 30px;
        }

        .form-modern .form-group {
            margin-bottom: 25px;
        }

        .form-modern label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-modern .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .form-modern .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .checkbox-modern {
            transform: scale(1.2);
            margin-right: 10px;
        }

        .btn-modern {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
            font-size: 16px;
            margin-right: 10px;
        }

            .btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .reference-panel {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border-left: 4px solid #3498db;
        }

        .field-validation-error {
            color: #e74c3c;
            font-size: 14px;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background: #e74c3c;
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 20px;
            }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Header Section -->
        <div class="dashboard-header">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1><i class="fa fa-plus-circle"></i> Create New Salary Modifier</h1>
                    <p class="lead">Add new salary component to the system</p>
                </div>
                <div class="col-md-4 text-right">
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-modern btn-light" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Main Form -->
                <div class="content-panel">
                    <div class="panel-header">
                        <h3 class="mb-0"><i class="fa fa-edit"></i> Salary Modifier Details</h3>
                    </div>
                    <div class="panel-body">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-modern">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SalaryModifierName)
                                            @Html.EditorFor(model => model.SalaryModifierName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter modifier name" } })
                                            @Html.ValidationMessageFor(model => model.SalaryModifierName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SalaryModifierTypeID)
                                            @Html.EditorFor(model => model.SalaryModifierTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter type ID" } })
                                            @Html.ValidationMessageFor(model => model.SalaryModifierTypeID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OrderIndex)
                                            @Html.EditorFor(model => model.OrderIndex, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter order index" } })
                                            @Html.ValidationMessageFor(model => model.OrderIndex, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.TaxTypeID)
                                            @Html.EditorFor(model => model.TaxTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter tax type ID" } })
                                            @Html.ValidationMessageFor(model => model.TaxTypeID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OTTypeID)
                                            @Html.EditorFor(model => model.OTTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter OT type ID" } })
                                            @Html.ValidationMessageFor(model => model.OTTypeID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SalaryTypeID)
                                            @Html.EditorFor(model => model.SalaryTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter salary type ID" } })
                                            @Html.ValidationMessageFor(model => model.SalaryTypeID, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <!-- Checkbox Section -->
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsEnabled, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsEnabled, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsEnabled, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsBasicSalary, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsBasicSalary, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsBasicSalary, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsAllawance, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsAllawance, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsAllawance, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsNoPay, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsNoPay, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsNoPay, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsLateHours, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsLateHours, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsLateHours, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsLoan, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsLoan, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsLoan, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsEditable, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsEditable, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsEditable, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.IsRemoved, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.IsRemoved, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.IsRemoved, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <div class="form-check">
                                                @Html.EditorFor(model => model.CommonValueForAll, new { htmlAttributes = new { @class = "form-check-input checkbox-modern" } })
                                                @Html.LabelFor(model => model.CommonValueForAll, new { @class = "form-check-label" })
                                                @Html.ValidationMessageFor(model => model.CommonValueForAll, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="form-group text-right mt-4">
                                    <button type="submit" class="btn btn-modern btn-success">
                                        <i class="fa fa-save"></i> Create Salary Modifier
                                    </button>
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-modern btn-secondary" })
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- Reference Information -->
                <div class="content-panel">
                    <div class="panel-header" style="background: #3498db;">
                        <h3 class="mb-0"><i class="fa fa-info-circle"></i> Reference Information</h3>
                    </div>
                    <div class="panel-body">
                        <div class="reference-panel">
                            <h5><i class="fa fa-lightbulb-o"></i> Usage Guidelines</h5>
                            <ul>
                                <li>Use descriptive names for easy identification</li>
                                <li>Set proper order index for display sequence</li>
                                <li>Enable only active modifiers</li>
                                <li>Mark as basic salary for core compensation items</li>
                            </ul>
                        </div>

                        <div class="reference-panel mt-3">
                            <h5><i class="fa fa-cog"></i> Field Descriptions</h5>
                            <dl>
                                <dt>Order Index</dt>
                                <dd>Determines display order in lists and reports</dd>
                                <dt>Tax Type</dt>
                                <dd>Links to tax calculation rules</dd>
                                <dt>OT Type</dt>
                                <dd>Associates with overtime categories</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>