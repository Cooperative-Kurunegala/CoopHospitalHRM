@model HR_Application_CO_OP_HOS.Models.AttendanceLastRecordDetail

@{
    ViewBag.Title = "Edit Attendance Last Record";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Attendance Last Record</h1>
            <p class="lead">Update existing attendance last record details</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Record Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            @Html.HiddenFor(model => model.ID)

                            <div class="form-group">
                                <label class="control-label col-md-12">Record ID</label>
                                <div class="col-md-12">
                                    <input type="text" class="form-control form-control-lg" value="@Model.ID" disabled />
                                    <small class="form-text text-muted">Record ID cannot be modified</small>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.AttendanceLastRecord, htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.AttendanceLastRecord, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter attendance last record details..." } })
                                    @Html.ValidationMessageFor(model => model.AttendanceLastRecord, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Update the description for the attendance last record</small>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-warning btn-lg btn-block">
                                        <i class="fa fa-save"></i> Update Record
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg btn-block mt-2" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Information Section -->
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Record Information</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-info">
                        <h5><i class="fa fa-database"></i> Current Record Details:</h5>
                        <dl class="row">
                            <dt class="col-sm-4">Record ID:</dt>
                            <dd class="col-sm-8">@Model.ID</dd>

                            <dt class="col-sm-4">Current Value:</dt>
                            <dd class="col-sm-8">@Model.AttendanceLastRecord</dd>

                            <dt class="col-sm-4">Status:</dt>
                            <dd class="col-sm-8"><span class="badge badge-success">Active</span></dd>
                        </dl>
                    </div>

                    <div class="alert alert-warning">
                        <h5><i class="fa fa-exclamation-triangle"></i> Editing Guidelines:</h5>
                        <ul class="list-unstyled">
                            <li><i class="fa fa-check text-success"></i> Ensure changes are accurate</li>
                            <li><i class="fa fa-check text-success"></i> Review before saving</li>
                            <li><i class="fa fa-check text-success"></i> Changes take effect immediately</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-shield"></i> Danger Zone</h3>
                </div>
                <div class="panel-body text-center">
                    <p>Need to remove this record?</p>
                    @Html.ActionLink("Delete Record", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-lg btn-block" })
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            var originalValue = $('#AttendanceLastRecord').val();

            // Form validation enhancement
            $('form').submit(function (e) {
                var currentValue = $('#AttendanceLastRecord').val();

                if (!currentValue || currentValue.trim() === '') {
                    e.preventDefault();
                    showAlert('Please enter a valid record description.', 'danger');
                    return false;
                }

                if (currentValue === originalValue) {
                    if (!confirm('No changes detected. Are you sure you want to continue?')) {
                        e.preventDefault();
                        return false;
                    }
                }

                showAlert('Updating record...', 'info');
                return true;
            });

            // Track changes
            $('#AttendanceLastRecord').on('input', function () {
                var currentValue = $(this).val();
                if (currentValue !== originalValue) {
                    $(this).addClass('value-changed');
                } else {
                    $(this).removeClass('value-changed');
                }
            });

            function showAlert(message, type) {
                var alertClass = 'alert-' + type;
                var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                    message +
                    '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '</button>' +
                    '</div>';

                $('.form-horizontal').prepend(alertHtml);

                setTimeout(function () {
                    $('.alert').alert('close');
                }, 5000);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
    }

    .form-control-lg {
        height: calc(2.5em + 1rem + 2px);
        padding: 0.5rem 1rem;
        font-size: 1.1rem;
        border-radius: 8px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .form-control-lg.value-changed {
            border-color: #f39c12;
            background-color: #fffbf0;
        }

        .form-control-lg:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .btn-warning {
        background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
        border: none;
        color: white;
    }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
        }

    .badge {
        font-size: 0.8em;
        padding: 5px 10px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 5px;
        }

        .col-md-8, .col-md-4 {
            margin-bottom: 15px;
        }
    }
</style>