@model HR_Application_CO_OP_HOS.Models.AttendanceLastRecordDetail

@{
    ViewBag.Title = "Delete Record";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Record</h1>
            <p class="lead">Remove attendance last record from the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Confirmation Section -->
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-danger">
                        <h4><i class="fa fa-warning"></i> Warning: This action cannot be undone!</h4>
                        <p>You are about to permanently delete this record. This action is irreversible.</p>
                    </div>

                    <div class="confirmation-details">
                        <h5>Record to be deleted:</h5>
                        <div class="detail-card danger">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Record ID:</strong>
                                    <p class="detail-value">@Model.ID</p>
                                </div>
                                <div class="col-md-6">
                                    <strong>Record Value:</strong>
                                    <p class="detail-value">@Model.AttendanceLastRecord</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-actions no-color mt-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <button type="submit" class="btn btn-danger btn-lg btn-block" id="deleteButton">
                                        <i class="fa fa-trash"></i> Confirm Delete
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg btn-block" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Information & Impact Section -->
        <div class="col-md-4">
            <!-- Impact Analysis -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Impact Analysis</h3>
                </div>
                <div class="panel-body">
                    <div class="impact-item">
                        <i class="fa fa-times-circle text-danger"></i>
                        <div class="impact-content">
                            <h6>Immediate Effects</h6>
                            <p>Record will be permanently removed from the database</p>
                        </div>
                    </div>
                    <div class="impact-item">
                        <i class="fa fa-database text-warning"></i>
                        <div class="impact-content">
                            <h6>Data Loss</h6>
                            <p>All associated data will be lost</p>
                        </div>
                    </div>
                    <div class="impact-item">
                        <i class="fa fa-history text-info"></i>
                        <div class="impact-content">
                            <h6>System Impact</h6>
                            <p>May affect historical reports and analytics</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Safety Check -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-shield"></i> Safety Check</h3>
                </div>
                <div class="panel-body">
                    <div class="safety-checklist">
                        <div class="checklist-item">
                            <input type="checkbox" id="confirm1" class="safety-check">
                            <label for="confirm1">I have verified this is the correct record</label>
                        </div>
                        <div class="checklist-item">
                            <input type="checkbox" id="confirm2" class="safety-check">
                            <label for="confirm2">I understand this action is permanent</label>
                        </div>
                        <div class="checklist-item">
                            <input type="checkbox" id="confirm3" class="safety-check">
                            <label for="confirm3">I have appropriate permissions</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-life-ring"></i> Alternative Actions</h3>
                </div>
                <div class="panel-body text-center">
                    <p>Consider these alternatives instead of deletion:</p>
                    @Html.ActionLink("Edit Record", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-block mb-2" })
                    @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-block" })
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Warning -->
    <div class="row no-gutters mt-4">
        <div class="col-12">
            <div class="panel panel-dark">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-circle"></i> Final Warning</h3>
                </div>
                <div class="panel-body text-center">
                    <div class="final-warning">
                        <i class="fa fa-warning fa-3x text-danger mb-3"></i>
                        <h4>Proceed with extreme caution!</h4>
                        <p class="mb-0">Data recovery is not possible after deletion. Ensure you have proper backups.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var deleteButton = $('#deleteButton');
            var safetyChecks = $('.safety-check');

            // Initially disable delete button
            deleteButton.prop('disabled', true).addClass('disabled');

            // Enable delete button only when all safety checks are checked
            safetyChecks.change(function () {
                var allChecked = safetyChecks.length === safetyChecks.filter(':checked').length;
                deleteButton.prop('disabled', !allChecked);

                if (allChecked) {
                    deleteButton.removeClass('disabled').addClass('btn-danger');
                } else {
                    deleteButton.addClass('disabled').removeClass('btn-danger');
                }
            });

            // Confirm deletion with additional warning
            deleteButton.click(function (e) {
                if (!$(this).prop('disabled')) {
                    var confirmed = confirm('FINAL WARNING: This will permanently delete the record. This action cannot be undone!\n\nClick OK to confirm deletion.');
                    if (!confirmed) {
                        e.preventDefault();
                        showAlert('Deletion cancelled.', 'info');
                    } else {
                        showAlert('Deleting record...', 'warning');
                        // Add loading state
                        $(this).html('<i class="fa fa-spinner fa-spin"></i> Deleting...').prop('disabled', true);
                    }
                } else {
                    e.preventDefault();
                    showAlert('Please complete all safety checks before deletion.', 'warning');
                }
            });

            function showAlert(message, type) {
                var alertClass = 'alert-' + type;
                var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                    message +
                    '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '</button>' +
                    '</div>';

                $('.panel-body').prepend(alertHtml);

                setTimeout(function () {
                    $('.alert').alert('close');
                }, 5000);
            }

            // Add confirmation dialog for navigation away
            $('a').not('#deleteButton').click(function (e) {
                if (safetyChecks.filter(':checked').length > 0) {
                    var confirmNavigation = confirm('You have started the deletion process. Are you sure you want to leave?');
                    if (!confirmNavigation) {
                        e.preventDefault();
                    }
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
    }

    .alert-danger {
        border-radius: 8px;
        border: none;
    }

    .detail-card.danger {
        background: #f8d7da;
        border: 2px solid #f5c6cb;
        border-radius: 8px;
        padding: 20px;
        margin: 15px 0;
    }

    .detail-value {
        font-size: 1.2rem;
        font-weight: bold;
        color: #721c24;
        margin: 5px 0;
    }

    .impact-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 15px;
        padding: 10px;
        background: #fff3cd;
        border-radius: 6px;
    }

        .impact-item i {
            font-size: 1.2rem;
            margin-right: 10px;
            margin-top: 2px;
        }

    .impact-content h6 {
        margin: 0 0 5px 0;
        color: #856404;
        font-weight: 600;
    }

    .impact-content p {
        margin: 0;
        color: #856404;
        font-size: 0.9rem;
    }

    .safety-checklist {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .checklist-item {
        display: flex;
        align-items: center;
        padding: 10px;
        background: #e7f3ff;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

        .checklist-item:hover {
            background: #d1ecf1;
        }

    .safety-check {
        margin-right: 10px;
        transform: scale(1.2);
    }

    .checklist-item label {
        margin: 0;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .btn-danger:disabled {
        background-color: #6c757d;
        border-color: #6c757d;
        opacity: 0.6;
    }

    .final-warning {
        padding: 20px;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 5px;
        }

        .col-md-8, .col-md-4 {
            margin-bottom: 15px;
        }

        .impact-item {
            flex-direction: column;
            text-align: center;
        }

            .impact-item i {
                margin-right: 0;
                margin-bottom: 5px;
            }
    }
</style>