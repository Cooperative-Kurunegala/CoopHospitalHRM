@model HR_Application_CO_OP_HOS.Models.AttendanceLastRecordDetail

@{
    ViewBag.Title = "Create Attendance Last Record";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create Attendance Last Record</h1>
            <p class="lead">Add new attendance last record to the system</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Record Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group">
                                @Html.LabelFor(model => model.AttendanceLastRecord, htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.AttendanceLastRecord, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter attendance last record details..." } })
                                    @Html.ValidationMessageFor(model => model.AttendanceLastRecord, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Enter the description for the attendance last record</small>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-success btn-lg btn-block">
                                        <i class="fa fa-save"></i> Create Record
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg btn-block mt-2" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Information Section -->
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Creation Guidelines</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-info">
                        <h5><i class="fa fa-lightbulb-o"></i> Tips for creating records:</h5>
                        <ul class="list-unstyled">
                            <li><i class="fa fa-check text-success"></i> Ensure record description is clear and concise</li>
                            <li><i class="fa fa-check text-success"></i> Use meaningful names for easy identification</li>
                            <li><i class="fa fa-check text-success"></i> Avoid special characters when possible</li>
                        </ul>
                    </div>

                    <div class="alert alert-warning">
                        <h5><i class="fa fa-exclamation-triangle"></i> Important Notes:</h5>
                        <ul class="list-unstyled">
                            <li><i class="fa fa-clock-o"></i> Record ID will be auto-generated</li>
                            <li><i class="fa fa-database"></i> Changes are saved immediately</li>
                            <li><i class="fa fa-refresh"></i> You can edit records later if needed</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bar-chart"></i> System Stats</h3>
                </div>
                <div class="panel-body text-center">
                    <div class="row">
                        <div class="col-6">
                            <div class="stat-item-small">
                                <i class="fa fa-database fa-2x text-primary"></i>
                                <h6>Total Records</h6>
                                <p class="stat-number-small">--</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-item-small">
                                <i class="fa fa-plus-circle fa-2x text-success"></i>
                                <h6>New Record</h6>
                                <p class="stat-number-small">#Next</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Form validation enhancement
            $('form').submit(function (e) {
                var recordValue = $('#AttendanceLastRecord').val();
                if (!recordValue || recordValue.trim() === '') {
                    e.preventDefault();
                    showAlert('Please enter a valid record description.', 'danger');
                    return false;
                }
                showAlert('Creating record...', 'info');
                return true;
            });

            // Input focus enhancement
            $('#AttendanceLastRecord').focus(function () {
                $(this).parent().addClass('focused');
            }).blur(function () {
                $(this).parent().removeClass('focused');
            });

            function showAlert(message, type) {
                var alertClass = 'alert-' + type;
                var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                    message +
                    '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '</button>' +
                    '</div>';

                $('.form-horizontal').prepend(alertHtml);

                // Auto remove after 5 seconds
                setTimeout(function () {
                    $('.alert').alert('close');
                }, 5000);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 20px;
    }

    .form-control-lg {
        height: calc(2.5em + 1rem + 2px);
        padding: 0.5rem 1rem;
        font-size: 1.1rem;
        border-radius: 8px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .form-control-lg:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .control-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #2c3e50;
    }

    .stat-item-small {
        padding: 15px 5px;
    }

    .stat-number-small {
        font-size: 1.5rem;
        font-weight: bold;
        color: #2c3e50;
        margin: 5px 0;
    }

    .alert {
        border-radius: 8px;
        border: none;
    }

    .btn-lg {
        padding: 12px 24px;
        font-size: 1.1rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-success {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        border: none;
    }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
        }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 5px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .col-md-8, .col-md-4 {
            margin-bottom: 15px;
        }
    }
</style>