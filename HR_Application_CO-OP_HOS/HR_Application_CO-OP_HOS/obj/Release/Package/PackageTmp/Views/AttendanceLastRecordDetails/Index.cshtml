@model IEnumerable<HR_Application_CO_OP_HOS.Models.AttendanceLastRecordDetail>

@{
    ViewBag.Title = "Attendance Last Records";
}

<!-- Full Screen Container -->
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-clock-o"></i> Attendance Last Records</h1>
            <p class="lead">Manage and monitor attendance last record details</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-4">
                            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-lg btn-block" })
                        </div>
                        <div class="col-md-4">
                            <button id="filterToggle" class="btn btn-info btn-lg btn-block">
                                <i class="fa fa-filter"></i> Toggle Filters
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button id="refreshData" class="btn btn-warning btn-lg btn-block">
                                <i class="fa fa-refresh"></i> Refresh Data
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="row no-gutters mb-4" id="filterSection" style="display: none;">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Filter Records</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="searchTerm">Search Records:</label>
                                <input type="text" id="searchTerm" class="form-control form-control-lg" placeholder="Enter search term..." />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="recordFilter">Filter by Record Type:</label>
                                <select id="recordFilter" class="form-control form-control-lg">
                                    <option value="">All Records</option>
                                    <option value="active">Active Records</option>
                                    <option value="inactive">Inactive Records</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Section -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-list"></i> Attendance Last Records
                        <span class="badge badge-light" id="recordCount">@Model.Count()</span>
                    </h3>
                </div>
                <div class="panel-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="recordsTable">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>
                                            @Html.DisplayNameFor(model => model.AttendanceLastRecord)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.ID)
                                        </th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="record-row">
                                            <td>
                                                <span class="record-value">@Html.DisplayFor(modelItem => item.AttendanceLastRecord)</span>
                                            </td>
                                            <td>
                                                <span class="text-muted">@Html.DisplayFor(modelItem => item.ID)</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fa fa-exclamation-triangle fa-3x"></i>
                            <h3>No Records Found</h3>
                            <p>There are no attendance last records available in the system.</p>
                            @Html.ActionLink("Create First Record", "Create", null, new { @class = "btn btn-success btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Section -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-purple">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-bar-chart"></i> Record Statistics</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters text-center">
                        <div class="col-md-3 stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-database"></i>
                            </div>
                            <h4>Total Records</h4>
                            <p class="stat-number">@Model.Count()</p>
                        </div>
                        <div class="col-md-3 stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-check-circle"></i>
                            </div>
                            <h4>Active Records</h4>
                            <p class="stat-number">@Model.Count()</p>
                        </div>
                        <div class="col-md-3 stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-clock-o"></i>
                            </div>
                            <h4>Latest ID</h4>
                            <p class="stat-number">@(Model.Any() ? Model.Max(x => x.ID) : 0)</p>
                        </div>
                        <div class="col-md-3 stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-history"></i>
                            </div>
                            <h4>System Status</h4>
                            <p class="stat-number text-success">Active</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Toggle filter section
            $('#filterToggle').click(function () {
                $('#filterSection').slideToggle();
            });

            // Refresh data
            $('#refreshData').click(function () {
                location.reload();
            });

            // Search functionality
            $('#searchTerm').on('keyup', function () {
                var searchText = $(this).val().toLowerCase();
                $('.record-row').each(function () {
                    var recordText = $(this).find('.record-value').text().toLowerCase();
                    if (recordText.indexOf(searchText) > -1) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
                updateRecordCount();
            });

            // Record filter functionality
            $('#recordFilter').change(function () {
                var filterValue = $(this).val();
                // Implement your filtering logic here based on record properties
                updateRecordCount();
            });

            function updateRecordCount() {
                var visibleCount = $('.record-row:visible').length;
                $('#recordCount').text(visibleCount);
            }

            // Add hover effects
            $('.record-row').hover(
                function () {
                    $(this).addClass('table-active');
                },
                function () {
                    $(this).removeClass('table-active');
                }
            );
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .container.body-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .jumbotron h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
        font-weight: 700;
    }

    .jumbotron .lead {
        font-size: 1.3rem;
        opacity: 0.9;
    }

    .no-gutters {
        margin-right: 0;
        margin-left: 0;
    }

        .no-gutters > .col,
        .no-gutters > [class*="col-"] {
            padding-right: 8px;
            padding-left: 8px;
        }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin-bottom: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 15px 20px;
        font-weight: 600;
    }

    .panel-title {
        font-size: 1.2rem;
        margin: 0;
    }

        .panel-title i {
            margin-right: 10px;
        }

    .panel-body {
        padding: 20px;
    }

    .panel-primary .panel-heading {
        background-color: #3498db !important;
        color: white;
    }

    .panel-success .panel-heading {
        background-color: #27ae60 !important;
        color: white;
    }

    .panel-info .panel-heading {
        background-color: #17a2b8 !important;
        color: white;
    }

    .panel-warning .panel-heading {
        background-color: #f39c12 !important;
        color: white;
    }

    .panel-purple .panel-heading {
        background-color: #9b59b6 !important;
        color: white;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        font-size: 1rem;
    }

    .btn-group .btn {
        margin: 2px;
        border-radius: 5px;
    }

    .stat-item {
        padding: 20px 10px;
    }

    .stat-icon {
        font-size: 2.5rem;
        color: #3498db;
        margin-bottom: 10px;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: bold;
        color: #2c3e50;
        margin: 10px 0;
    }

    .stat-item h4 {
        font-size: 1rem;
        color: #7f8c8d;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .alert-warning {
        border-radius: 10px;
        padding: 30px;
    }

    .form-control-lg {
        height: calc(2.5em + 1rem + 2px);
        padding: 0.5rem 1rem;
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 5px;
        }

        .jumbotron h1 {
            font-size: 2rem;
        }

        .jumbotron .lead {
            font-size: 1.1rem;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
        }

            .btn-group .btn {
                margin: 2px 0;
                text-align: center;
            }

        .stat-item {
            margin-bottom: 15px;
        }
    }
</style>