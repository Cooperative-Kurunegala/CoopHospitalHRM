@model HR_Application_CO_OP_HOS.Models.OrderType

@{
    ViewBag.Title = "Delete Order Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Order Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Content Container */
        .content-container {
            padding: 30px;
            max-width: 100%;
        }

        /* Warning Container */
        .warning-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .warning-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 25px;
        }

        .warning-title {
            font-size: 1.8rem;
            font-weight: 600;
            margin: 0;
        }

        .warning-body {
            padding: 30px;
        }

        /* Warning Message */
        .warning-message {
            background: #fdedec;
            border: 2px solid #e74c3c;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
            text-align: center;
        }

        .warning-icon {
            font-size: 4rem;
            color: #e74c3c;
            margin-bottom: 20px;
        }

        .warning-text {
            font-size: 1.4rem;
            font-weight: 600;
            color: #c0392b;
            margin-bottom: 15px;
        }

        .warning-subtext {
            color: #7f8c8d;
            font-size: 1.1rem;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .detail-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            border-left: 4px solid #e74c3c;
        }

        .detail-label {
            font-weight: 600;
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .detail-value {
            font-size: 1.2rem;
            font-weight: 600;
            color: #2c3e50;
            margin: 0;
        }

        /* Impact Assessment */
        .impact-assessment {
            background: #fef9e7;
            border: 2px solid #f39c12;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .impact-title {
            font-weight: 600;
            color: #d35400;
            margin-bottom: 20px;
            font-size: 1.3rem;
        }

        .impact-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            padding: 10px;
            background: white;
            border-radius: 6px;
        }

        .impact-icon {
            color: #e74c3c;
            margin-right: 15px;
            font-size: 1.2rem;
        }

        .impact-text {
            color: #2c3e50;
            font-size: 1rem;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 25px;
            border-top: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn {
            border-radius: 8px;
            padding: 12px 25px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Confirmation Check */
        .confirmation-check {
            background: #e8f6f3;
            border: 2px solid #27ae60;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .confirmation-text {
            color: #27ae60;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .form-check {
            margin-bottom: 10px;
        }

        .form-check-label {
            font-weight: 500;
            color: #2c3e50;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-container {
                padding: 15px;
            }

            .action-buttons {
                flex-direction: column;
                gap: 10px;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Badge Styles */
        .badge {
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .code-badge {
            background: #2c3e50;
            color: white;
            font-family: 'Courier New', monospace;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-trash"></i> Delete Order Type
            </h1>
            <p class="page-subtitle">Permanently remove an order type from the system</p>
        </div>

        <!-- Main Content -->
        <div class="content-container">
            <div class="warning-container">
                <div class="warning-header">
                    <h3 class="warning-title">
                        <i class="fa fa-exclamation-triangle"></i> Delete Confirmation Required
                    </h3>
                </div>

                <div class="warning-body">
                    <!-- Warning Message -->
                    <div class="warning-message">
                        <div class="warning-icon">
                            <i class="fa fa-exclamation-circle"></i>
                        </div>
                        <div class="warning-text">
                            You are about to delete this order type permanently!
                        </div>
                        <div class="warning-subtext">
                            This action cannot be undone. Please review the details below before proceeding.
                        </div>
                    </div>

                    <!-- Order Type Details -->
                    <h4 class="impact-title">
                        <i class="fa fa-cube"></i> Order Type to be Deleted
                    </h4>
                    <div class="details-grid">
                        <div class="detail-card">
                            <div class="detail-label">Order Type Name</div>
                            <div class="detail-value">@Model.OrderTypeName</div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Order Sequence</div>
                            <div class="detail-value">
                                <span class="badge badge-info">@Model.OrderSequence</span>
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Order Type Code</div>
                            <div class="detail-value">
                                <span class="badge code-badge">@Model.OrderTypeCode</span>
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-label">Record ID</div>
                            <div class="detail-value">#@Model.ID</div>
                        </div>
                    </div>

                    <!-- Impact Assessment -->
                    <div class="impact-assessment">
                        <h4 class="impact-title">
                            <i class="fa fa-exclamation-triangle"></i> Potential Impact
                        </h4>
                        <div class="impact-item">
                            <i class="fa fa-warning impact-icon"></i>
                            <span class="impact-text">This will affect all orders using this order type</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-warning impact-icon"></i>
                            <span class="impact-text">Historical data referencing this type may become inconsistent</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-warning impact-icon"></i>
                            <span class="impact-text">System reports and analytics will be impacted</span>
                        </div>
                        <div class="impact-item">
                            <i class="fa fa-warning impact-icon"></i>
                            <span class="impact-text">This action is permanent and cannot be reversed</span>
                        </div>
                    </div>

                    <!-- Confirmation Check -->
                    <div class="confirmation-check">
                        <div class="confirmation-text">
                            <i class="fa fa-check-circle"></i> Please confirm your action
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="confirmDelete">
                            <label class="form-check-label" for="confirmDelete">
                                I understand that this action is permanent and cannot be undone
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="confirmBackup">
                            <label class="form-check-label" for="confirmBackup">
                                I have verified that there are no active dependencies on this order type
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="confirmResponsibility">
                            <label class="form-check-label" for="confirmResponsibility">
                                I take full responsibility for this deletion and its consequences
                            </label>
                        </div>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        <div class="action-buttons">
                            <div>
                                <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                    <i class="fa fa-trash"></i> Permanently Delete Order Type
                                </button>
                            </div>
                            <div>
                                <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-primary">
                                    <i class="fa fa-eye"></i> View Details
                                </a>
                                <a href="@Url.Action("Index")" class="btn btn-secondary">
                                    <i class="fa fa-arrow-left"></i> Back to List
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Enable delete button only when all checkboxes are checked
            function updateDeleteButton() {
                var allChecked = $('#confirmDelete').is(':checked') &&
                               $('#confirmBackup').is(':checked') &&
                               $('#confirmResponsibility').is(':checked');
                $('#deleteButton').prop('disabled', !allChecked);
            }

            $('.form-check-input').change(updateDeleteButton);

            // Delete button confirmation
            $('#deleteButton').click(function (e) {
                if (!$(this).prop('disabled')) {
                    var confirmed = confirm('Are you absolutely sure you want to permanently delete this order type? This action cannot be undone.');
                    if (!confirmed) {
                        e.preventDefault();
                    } else {
                        $(this).html('<i class="fa fa-spinner fa-spin"></i> Deleting...').prop('disabled', true);
                    }
                }
            });

            // Add some visual feedback
            $('.detail-card').hover(
                function () {
                    $(this).css('transform', 'translateY(-3px)');
                },
                function () {
                    $(this).css('transform', 'translateY(0)');
                }
            );
        });
    </script>
</body>
</html>