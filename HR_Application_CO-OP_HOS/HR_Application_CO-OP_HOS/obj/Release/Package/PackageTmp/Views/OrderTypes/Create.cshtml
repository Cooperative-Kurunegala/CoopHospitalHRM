@model HR_Application_CO_OP_HOS.Models.OrderType

@{
    ViewBag.Title = "Create Order Type";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Order Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Content Container */
        .content-container {
            padding: 30px;
            max-width: 100%;
        }

        /* Form Container */
        .form-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .form-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 25px;
        }

        .form-title {
            font-size: 1.8rem;
            font-weight: 600;
            margin: 0;
        }

        .form-body {
            padding: 30px;
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .validation-message {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 20px;
            border-top: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn {
            border-radius: 8px;
            padding: 12px 25px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        }

        .btn-success {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Reference Panel */
        .reference-panel {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 10px;
            border-left: 4px solid #3498db;
        }

        .reference-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .reference-item {
            padding: 8px 0;
            border-bottom: 1px solid #ecf0f1;
        }

            .reference-item:last-child {
                border-bottom: none;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-container {
                padding: 15px;
            }

            .action-buttons {
                flex-direction: column;
                gap: 10px;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
            }
        }

        /* Loading State */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        /* Help Text */
        .help-text {
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-plus-circle"></i> Create New Order Type
            </h1>
            <p class="page-subtitle">Add a new order type to the system</p>
        </div>

        <!-- Main Content -->
        <div class="content-container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="form-container">
                        <div class="form-header">
                            <h3 class="form-title">
                                <i class="fa fa-edit"></i> Order Type Information
                            </h3>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-body">
                                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                <div class="form-group">
                                    <label class="form-label" for="OrderTypeName">
                                        <i class="fa fa-tag"></i> Order Type Name
                                    </label>
                                    @Html.EditorFor(model => model.OrderTypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter order type name" } })
                                    @Html.ValidationMessageFor(model => model.OrderTypeName, "", new { @class = "validation-message" })
                                    <div class="help-text">Enter a descriptive name for this order type (e.g., "Laboratory Test", "Pharmacy Order")</div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="OrderSequence">
                                        <i class="fa fa-sort-numeric-asc"></i> Order Sequence
                                    </label>
                                    @Html.EditorFor(model => model.OrderSequence, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter sequence number", type = "number", min = "1" } })
                                    @Html.ValidationMessageFor(model => model.OrderSequence, "", new { @class = "validation-message" })
                                    <div class="help-text">Define the display order (lower numbers appear first)</div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="OrderTypeCode">
                                        <i class="fa fa-code"></i> Order Type Code
                                    </label>
                                    @Html.EditorFor(model => model.OrderTypeCode, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter type code" } })
                                    @Html.ValidationMessageFor(model => model.OrderTypeCode, "", new { @class = "validation-message" })
                                    <div class="help-text">Short code for system reference (e.g., "LAB", "PHARM", "RAD")</div>
                                </div>

                                <!-- Reference Information -->
                                <div class="reference-panel">
                                    <div class="reference-title">
                                        <i class="fa fa-info-circle"></i> About Order Types
                                    </div>
                                    <div class="reference-item">
                                        <strong>Purpose:</strong> Order types categorize different kinds of orders in the system
                                    </div>
                                    <div class="reference-item">
                                        <strong>Usage:</strong> Used in billing, reporting, and workflow management
                                    </div>
                                    <div class="reference-item">
                                        <strong>Examples:</strong> Laboratory Tests, Radiology, Pharmacy, Procedures
                                    </div>
                                </div>
                            </div>

                            <div class="action-buttons">
                                <div>
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-check"></i> Create Order Type
                                    </button>
                                    <button type="reset" class="btn btn-secondary">
                                        <i class="fa fa-refresh"></i> Reset Form
                                    </button>
                                </div>
                                <div>
                                    <a href="@Url.Action("Index")" class="btn btn-primary">
                                        <i class="fa fa-arrow-left"></i> Back to List
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Quick Reference Panel -->
                    <div class="form-container">
                        <div class="form-header" style="background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);">
                            <h3 class="form-title">
                                <i class="fa fa-lightbulb-o"></i> Quick Reference
                            </h3>
                        </div>
                        <div class="form-body">
                            <div class="reference-panel" style="border-left-color: #9b59b6;">
                                <div class="reference-title">
                                    <i class="fa fa-list"></i> Existing Order Types
                                </div>
                                @{
                                    // This would typically come from your database
                                    var existingTypes = new List<string> {
                                        "Laboratory", "Radiology", "Pharmacy", "Procedure", "Consultation"
                                    };
                                }
                                @foreach (var type in existingTypes)
                                {
                                    <div class="reference-item">
                                        <i class="fa fa-cube text-primary"></i> @type
                                    </div>
                                }
                            </div>

                            <div class="reference-panel mt-3" style="border-left-color: #e74c3c;">
                                <div class="reference-title">
                                    <i class="fa fa-exclamation-triangle"></i> Validation Rules
                                </div>
                                <div class="reference-item">
                                    <i class="fa fa-check text-success"></i> Name must be unique
                                </div>
                                <div class="reference-item">
                                    <i class="fa fa-check text-success"></i> Sequence must be positive number
                                </div>
                                <div class="reference-item">
                                    <i class="fa fa-check text-success"></i> Code should be 2-10 characters
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            // Form submission handling
            $('form').submit(function () {
                $('button[type="submit"]').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Creating...');
            });

            // Real-time validation feedback
            $('.form-control').on('blur', function () {
                var $this = $(this);
                var $formGroup = $this.closest('.form-group');
                var $validationMessage = $formGroup.find('.validation-message');

                if ($this.val().trim() === '') {
                    $this.addClass('is-invalid');
                } else {
                    $this.removeClass('is-invalid');
                }
            });

            // Auto-format code field
            $('#OrderTypeCode').on('input', function () {
                var value = $(this).val();
                $(this).val(value.toUpperCase().replace(/[^A-Z0-9]/g, ''));
            });
        });
    </script>
</body>
</html>