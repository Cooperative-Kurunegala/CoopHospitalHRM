@model HR_Application_CO_OP_HOS.Models.OrderType

@{
    ViewBag.Title = "Order Type Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Order Type Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Content Container */
        .content-container {
            padding: 30px;
            max-width: 100%;
        }

        /* Details Container */
        .details-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .details-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 25px;
        }

        .details-title {
            font-size: 1.8rem;
            font-weight: 600;
            margin: 0;
        }

        .details-body {
            padding: 30px;
        }

        /* Details Grid */
        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        .detail-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #3498db;
            transition: all 0.3s ease;
        }

            .detail-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .detail-label {
            font-weight: 600;
            color: #7f8c8d;
            font-size: 0.9rem;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .detail-value {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin: 0;
        }

        .detail-icon {
            font-size: 2rem;
            color: #3498db;
            margin-bottom: 15px;
        }

        /* Action Buttons */
        .action-buttons {
            background: #f8f9fa;
            padding: 20px;
            border-top: 1px solid #ecf0f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn {
            border-radius: 8px;
            padding: 12px 25px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
        }

        .btn-warning {
            background: linear-gradient(135deg, #e67e22 0%, #d35400 100%);
            color: white;
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            color: white;
            text-decoration: none;
        }

        /* Related Information */
        .related-info {
            background: #e8f4fd;
            border-radius: 10px;
            padding: 25px;
            margin-top: 30px;
            border-left: 4px solid #3498db;
        }

        .related-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            font-size: 1.3rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .stat-item {
            text-align: center;
            padding: 15px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #3498db;
            margin: 0;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #7f8c8d;
            margin: 5px 0 0 0;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-container {
                padding: 15px;
            }

            .action-buttons {
                flex-direction: column;
                gap: 10px;
            }

            .btn {
                width: 100%;
                margin-bottom: 10px;
                text-align: center;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Badge Styles */
        .badge {
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .code-badge {
            background: #2c3e50;
            color: white;
            font-family: 'Courier New', monospace;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-eye"></i> Order Type Details
            </h1>
            <p class="page-subtitle">View detailed information about this order type</p>
        </div>

        <!-- Main Content -->
        <div class="content-container">
            <div class="details-container">
                <div class="details-header">
                    <h3 class="details-title">
                        <i class="fa fa-cube"></i> @Model.OrderTypeName
                    </h3>
                </div>

                <div class="details-body">
                    <!-- Main Details Grid -->
                    <div class="details-grid">
                        <div class="detail-card">
                            <div class="detail-icon">
                                <i class="fa fa-tag"></i>
                            </div>
                            <div class="detail-label">Order Type Name</div>
                            <div class="detail-value">@Model.OrderTypeName</div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-icon">
                                <i class="fa fa-sort-numeric-asc"></i>
                            </div>
                            <div class="detail-label">Order Sequence</div>
                            <div class="detail-value">
                                <span class="badge badge-info" style="font-size: 1.2rem; padding: 8px 15px;">
                                    @Model.OrderSequence
                                </span>
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-icon">
                                <i class="fa fa-code"></i>
                            </div>
                            <div class="detail-label">Order Type Code</div>
                            <div class="detail-value">
                                <span class="badge code-badge">@Model.OrderTypeCode</span>
                            </div>
                        </div>

                        <div class="detail-card">
                            <div class="detail-icon">
                                <i class="fa fa-database"></i>
                            </div>
                            <div class="detail-label">Record ID</div>
                            <div class="detail-value">#@Model.ID</div>
                        </div>
                    </div>

                    <!-- Related Information -->
                    <div class="related-info">
                        <h4 class="related-title">
                            <i class="fa fa-line-chart"></i> Usage Statistics
                        </h4>
                        <div class="stats-grid">
                            <div class="stat-item">
                                <p class="stat-number">--</p>
                                <p class="stat-label">Total Orders</p>
                            </div>
                            <div class="stat-item">
                                <p class="stat-number">--</p>
                                <p class="stat-label">Active Today</p>
                            </div>
                            <div class="stat-item">
                                <p class="stat-number">--</p>
                                <p class="stat-label">This Month</p>
                            </div>
                            <div class="stat-item">
                                <p class="stat-number">--</p>
                                <p class="stat-label">System Usage</p>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    <div class="related-info" style="background: #fef9e7; border-left-color: #f39c12;">
                        <h4 class="related-title" style="color: #f39c12;">
                            <i class="fa fa-info-circle"></i> Additional Information
                        </h4>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <strong>Created Date:</strong>
                                    <span class="text-muted">@DateTime.Now.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="detail-item">
                                    <strong>Last Modified:</strong>
                                    <span class="text-muted">@DateTime.Now.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <strong>Status:</strong>
                                    <span class="badge badge-success">Active</span>
                                </div>
                                <div class="detail-item">
                                    <strong>System Impact:</strong>
                                    <span class="text-muted">High</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="action-buttons">
                    <div>
                        <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning">
                            <i class="fa fa-edit"></i> Edit Order Type
                        </a>
                        <a href="@Url.Action("Delete", new { id = Model.ID })" class="btn btn-danger">
                            <i class="fa fa-trash"></i> Delete Order Type
                        </a>
                    </div>
                    <div>
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <i class="fa fa-arrow-left"></i> Back to List
                        </a>
                        <a href="@Url.Action("Create")" class="btn btn-secondary">
                            <i class="fa fa-plus"></i> Create New
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Add some interactivity
            $('.detail-card').hover(
                function() {
                    $(this).css('transform', 'translateY(-5px)');
                },
                function() {
                    $(this).css('transform', 'translateY(0)');
                }
            );

            // Simulate loading statistics
            setTimeout(function() {
                $('.stat-number').each(function() {
                    var $this = $(this);
                    var target = Math.floor(Math.random() * 1000) + 100;
                    animateValue($this, 0, target, 1000);
                });
            }, 500);

            function animateValue($element, start, end, duration) {
                var range = end - start;
                var current = start;
                var increment = end > start ? 1 : -1;
                var stepTime = Math.abs(Math.floor(duration / range));
                var timer = setInterval(function() {
                    current += increment;
                    $element.text(current);
                    if (current == end) {
                        clearInterval(timer);
                    }
                }, stepTime);
            }
        });
    </script>
</body>
</html>