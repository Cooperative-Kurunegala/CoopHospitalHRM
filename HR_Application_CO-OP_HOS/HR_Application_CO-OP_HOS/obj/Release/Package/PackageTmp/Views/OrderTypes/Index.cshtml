@model IEnumerable<HR_Application_CO_OP_HOS.Models.OrderType>

@{
    ViewBag.Title = "Order Types";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Order Types</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Section */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Content Container */
        .content-container {
            padding: 30px;
            max-width: 100%;
        }

        /* Action Bar */
        .action-bar {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
                color: white;
                text-decoration: none;
            }

        /* Filter Section */
        .filter-section {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .filter-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }

            .filter-header i {
                margin-right: 10px;
                color: #3498db;
            }

        /* Table Container */
        .table-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .table-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px;
        }

        .table-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        /* Modern Table */
        .modern-table {
            width: 100%;
            border-collapse: collapse;
        }

            .modern-table thead {
                background: #ecf0f1;
            }

            .modern-table th {
                padding: 18px 15px;
                text-align: left;
                font-weight: 600;
                color: #2c3e50;
                border-bottom: 2px solid #bdc3c7;
                font-size: 1.1rem;
            }

            .modern-table td {
                padding: 15px;
                border-bottom: 1px solid #ecf0f1;
                font-size: 1rem;
            }

            .modern-table tbody tr {
                transition: all 0.3s ease;
            }

                .modern-table tbody tr:hover {
                    background: #f8f9fa;
                    transform: translateX(5px);
                }

        /* Action Buttons */
        .btn-action {
            padding: 6px 12px;
            margin: 2px;
            border: none;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-edit {
            background: #3498db;
            color: white;
        }

        .btn-details {
            background: #27ae60;
            color: white;
        }

        .btn-delete {
            background: #e74c3c;
            color: white;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
            text-decoration: none;
            color: white;
        }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 50px;
            color: #7f8c8d;
        }

            .no-records i {
                font-size: 4rem;
                margin-bottom: 20px;
                color: #bdc3c7;
            }

            .no-records h4 {
                font-size: 1.5rem;
                margin-bottom: 10px;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .content-container {
                padding: 15px;
            }

            .action-bar {
                flex-direction: column;
                gap: 15px;
            }

            .page-title {
                font-size: 2rem;
            }

            .modern-table {
                display: block;
                overflow-x: auto;
            }
        }

        /* Loading State */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        /* Form Controls */
        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .btn {
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-list-alt"></i> Order Types Management
            </h1>
            <p class="page-subtitle">Manage and organize different types of orders in the system</p>
        </div>

        <!-- Main Content -->
        <div class="content-container">
            <!-- Action Bar -->
            <div class="action-bar">
                <div>
                    <a href="@Url.Action("Create")" class="btn-create">
                        <i class="fa fa-plus"></i> Create New Order Type
                    </a>
                </div>
                <div>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light">
                        <i class="fa fa-home"></i> Back to Dashboard
                    </a>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="filter-header">
                    <i class="fa fa-filter"></i> Filter Order Types
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by name or code...">
                    </div>
                    <div class="col-md-3">
                        <select id="sequenceFilter" class="form-control">
                            <option value="">All Sequences</option>
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i">Sequence @i</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button id="applyFilters" class="btn btn-primary btn-block">
                            <i class="fa fa-search"></i> Apply Filters
                        </button>
                    </div>
                    <div class="col-md-2">
                        <button id="resetFilters" class="btn btn-outline-secondary btn-block">
                            <i class="fa fa-refresh"></i> Reset
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table Container -->
            <div class="table-container">
                <div class="table-header">
                    <h3 class="table-title">
                        <i class="fa fa-table"></i> Order Types List
                        <span class="badge badge-light ml-2" id="recordCount">@Model.Count()</span>
                    </h3>
                </div>

                <div class="table-responsive">
                    @if (Model.Any())
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Order Type Name</th>
                                    <th>Sequence</th>
                                    <th>Type Code</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@Html.DisplayFor(modelItem => item.OrderTypeName)</strong>
                                        </td>
                                        <td>
                                            <span class="badge badge-info">@Html.DisplayFor(modelItem => item.OrderSequence)</span>
                                        </td>
                                        <td>
                                            <code>@Html.DisplayFor(modelItem => item.OrderTypeCode)</code>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("Edit", new { id = item.ID })" class="btn-action btn-edit" title="Edit">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>
                                                <a href="@Url.Action("Details", new { id = item.ID })" class="btn-action btn-details" title="Details">
                                                    <i class="fa fa-eye"></i> Details
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = item.ID })" class="btn-action btn-delete" title="Delete">
                                                    <i class="fa fa-trash"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="no-records">
                            <i class="fa fa-inbox"></i>
                            <h4>No Order Types Found</h4>
                            <p>There are no order types in the system yet. Start by creating a new one.</p>
                            <a href="@Url.Action("Create")" class="btn btn-primary">
                                <i class="fa fa-plus"></i> Create First Order Type
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Filter functionality
            $('#applyFilters').click(function () {
                applyFilters();
            });

            $('#resetFilters').click(function () {
                $('#searchInput').val('');
                $('#sequenceFilter').val('');
                applyFilters();
            });

            $('#searchInput').on('keyup', function () {
                applyFilters();
            });

            function applyFilters() {
                var searchText = $('#searchInput').val().toLowerCase();
                var sequenceFilter = $('#sequenceFilter').val();

                $('.modern-table tbody tr').each(function () {
                    var row = $(this);
                    var name = row.find('td:eq(0)').text().toLowerCase();
                    var sequence = row.find('td:eq(1)').text().trim();
                    var code = row.find('td:eq(2)').text().toLowerCase();

                    var matchesSearch = name.includes(searchText) || code.includes(searchText);
                    var matchesSequence = !sequenceFilter || sequence.includes(sequenceFilter);

                    if (matchesSearch && matchesSequence) {
                        row.show();
                    } else {
                        row.hide();
                    }
                });

                // Update record count
                var visibleCount = $('.modern-table tbody tr:visible').length;
                $('#recordCount').text(visibleCount);
            }

            // Loading state for buttons
            $('.btn-action').click(function () {
                $(this).closest('tr').addClass('loading');
            });
        });
    </script>
</body>
</html>