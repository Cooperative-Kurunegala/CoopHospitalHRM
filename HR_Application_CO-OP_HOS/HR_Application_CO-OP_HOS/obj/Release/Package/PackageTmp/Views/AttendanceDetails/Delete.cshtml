@using System.Globalization
@model HR_Application_CO_OP_HOS.Models.AttendanceDetail

@{
    ViewBag.Title = "Delete Attendance Record";
}

@if (Model == null)
{
    <div class="dashboard-container">
        <div class="dashboard-header">
            <div class="jumbotron">
                <h1><i class="fa fa-exclamation-circle"></i> Record Not Found</h1>
                <p class="lead">The requested attendance record could not be loaded.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="panel panel-warning">
                    <div class="panel-body">
                        <p>Please return to the list and try again.</p>
                        <a href="@Url.Action("Index", "AttendanceDetails")" class="btn btn-primary">
                            <i class="fa fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    // Declare partyName in the outer else scope so it's available to the markup below
    var partyName = ViewBag.PartyName as string ?? $"Sample Employee {Model.RelatedPartyID}";

    <div class="dashboard-container">
        <div class="dashboard-header">
            <div class="jumbotron">
                <h1><i class="fa fa-trash"></i> Delete Attendance Record</h1>
                <p class="lead">Remove attendance record from the system</p>
            </div>
        </div>

        <div class="row no-gutters">
            <!-- Warning Section -->
            <div class="col-12">
                <div class="panel panel-danger">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Delete Confirmation</h3>
                    </div>
                    <div class="panel-body">
                        <div class="alert alert-danger">
                            <h4><i class="fa fa-warning"></i> Warning!</h4>
                            <p>You are about to permanently delete this attendance record. This action cannot be undone.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Record Details -->
            <div class="col-md-8">
                <div class="panel panel-warning">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-info-circle"></i> Record to be Deleted</h3>
                    </div>
                    <div class="panel-body">
                        <div class="delete-preview">
                            <div class="preview-section">
                                <h4>Basic Information</h4>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="preview-item">
                                            <strong>Record ID:</strong> @Model.ID
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="preview-item">
                                            <strong>Status:</strong>
                                            <span class="badge @(Model.IsOTRecommended.HasValue && Model.IsOTRecommended.Value ? "badge-success" : "badge-secondary")">
                                                @(Model.IsOTRecommended.HasValue && Model.IsOTRecommended.Value ? "OT Recommended" : "Regular")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="preview-section">
                                <h4>Attendance Period</h4>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="preview-item">
                                            <strong>Worked Month:</strong> @GetMonthName(Model.WorkedMonth)
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="preview-item">
                                            <strong>Worked Year:</strong> @Model.WorkedYear
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="preview-section">
                                <h4>Related Party</h4>
                                <div class="preview-item">
                                    <strong>Party ID:</strong> @Model.RelatedPartyID
                                </div>
                                <div class="party-info">
                                    <strong>Party Name:</strong> @partyName
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Impact Analysis -->
            <div class="col-md-4">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-line-chart"></i> Impact Analysis</h3>
                    </div>
                    <div class="panel-body">
                        <div class="impact-list">
                            <div class="impact-item">
                                <i class="fa fa-exclamation-circle text-warning"></i>
                                <span>This will affect payroll calculations</span>
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-exclamation-circle text-warning"></i>
                                <span>Attendance statistics will be updated</span>
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-exclamation-circle text-warning"></i>
                                <span>OT calculations may be affected</span>
                            </div>
                            <div class="impact-item">
                                <i class="fa fa-info-circle text-info"></i>
                                <span>Backup will be created automatically</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel panel-secondary">
                    <div class="panel-heading">
                        <h3 class="panel-title"><i class="fa fa-history"></i> Recent Activity</h3>
                    </div>
                    <div class="panel-body">
                        <div class="activity-list">
                            <div class="activity-item">
                                <div class="activity-time">Just now</div>
                                <div class="activity-desc">Delete confirmation opened</div>
                            </div>
                            <div class="activity-item">
                                <div class="activity-time">@DateTime.Now.AddHours(-1).ToString("HH:mm")</div>
                                <div class="activity-desc">Record last viewed</div>
                            </div>
                            <div class="activity-item">
                                <div class="activity-time">@DateTime.Now.AddDays(-1).ToString("MMM dd")</div>
                                <div class="activity-desc">Last modification</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Form -->
            <div class="col-12">
                <div class="panel panel-default">
                    <div class="panel-body text-center">
                        @using (Html.BeginForm("DeleteConfirmed", "AttendanceDetails", FormMethod.Post, new { id = "deleteForm" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ID)

                            <div class="confirmation-actions">
                                <button type="button" class="btn btn-success btn-lg" onclick="cancelDelete()">
                                    <i class="fa fa-arrow-left"></i> Cancel
                                </button>
                                <button type="submit" class="btn btn-danger btn-lg" onclick="return confirmDelete()">
                                    <i class="fa fa-trash"></i> Confirm Delete
                                </button>
                            </div>

                            <div class="security-check mt-4">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="confirmCheck" required>
                                    <label class="form-check-label" for="confirmCheck">
                                        I understand that this action cannot be undone and I have verified this is the correct record to delete.
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function confirmDelete() {
                const isChecked = document.getElementById('confirmCheck').checked;
                if (!isChecked) {
                    alert('Please confirm that you understand this action cannot be undone.');
                    return false;
                }

                return confirm('Are you absolutely sure you want to delete this attendance record? This action is permanent and cannot be reversed.');
            }

            function cancelDelete() {
                if (confirm('Are you sure you want to cancel? Any changes will be lost.')) {
                    window.history.back();
                }
            }

            $(document).ready(function () {
                // Only bind to the delete form
                $('#deleteForm').on('submit', function (e) {
                    if (!document.getElementById('confirmCheck').checked) {
                        e.preventDefault();
                        alert('Please confirm that you understand this action cannot be undone.');
                        return false;
                    }
                });

                // Add some visual feedback
                $('.preview-section').hover(
                    function () {
                        $(this).css('background-color', '#fff3cd');
                    },
                    function () {
                        $(this).css('background-color', '');
                    }
                );
            });
        </script>
    }

    <style>
        .dashboard-container {
            width: 100%;
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 20px;
            margin: 0;
        }

        .dashboard-header .jumbotron {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            border-radius: 15px;
            padding: 40px 30px;
            margin-bottom: 30px;
        }

        .panel {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            background: white;
        }

        .panel-heading {
            border-radius: 15px 15px 0 0 !important;
            border: none;
            padding: 20px 25px;
            font-weight: 600;
        }

        .panel-body {
            padding: 25px;
        }

        .alert-danger {
            border-radius: 10px;
            border: none;
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
        }

            .alert-danger h4 {
                margin-bottom: 10px;
            }

        .delete-preview {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
        }

        .preview-section {
            margin-bottom: 25px;
            padding: 20px;
            border-radius: 8px;
            background: white;
            border-left: 4px solid #e74c3c;
            transition: background-color 0.3s ease;
        }

            .preview-section h4 {
                color: #2c3e50;
                border-bottom: 1px solid #e9ecef;
                padding-bottom: 10px;
                margin-bottom: 15px;
                font-weight: 600;
            }

        .preview-item {
            margin-bottom: 12px;
            padding: 8px 0;
        }

        .party-info {
            background: #e3f2fd;
            padding: 12px;
            border-radius: 6px;
            margin-top: 10px;
            border-left: 3px solid #2196f3;
        }

        .impact-list .impact-item {
            padding: 12px 0;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            align-items: center;
        }

            .impact-list .impact-item:last-child {
                border-bottom: none;
            }

            .impact-list .impact-item i {
                margin-right: 10px;
                font-size: 1.2rem;
                min-width: 20px;
            }

        .activity-list .activity-item {
            padding: 10px 0;
            border-bottom: 1px solid #e9ecef;
        }

            .activity-list .activity-item:last-child {
                border-bottom: none;
            }

        .activity-time {
            font-size: 0.8rem;
            color: #6c757d;
            font-weight: 600;
        }

        .activity-desc {
            font-size: 0.9rem;
            color: #495057;
        }

        .confirmation-actions {
            margin: 30px 0;
        }

            .confirmation-actions .btn {
                margin: 0 15px;
                padding: 15px 30px;
                border-radius: 10px;
                font-weight: 600;
                font-size: 1.1rem;
                min-width: 200px;
            }

        .security-check {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            border: 2px solid #e9ecef;
        }

        .form-check-input {
            transform: scale(1.2);
            margin-right: 10px;
        }

        .form-check-label {
            font-weight: 500;
            color: #495057;
        }

        .badge {
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .confirmation-actions .btn {
                margin: 10px 0;
                width: 100%;
            }
        }
    </style>

    @functions {
        private string GetMonthName(int? month)
        {
            if (!month.HasValue) return "N/A";
            var m = month.Value;
            if (m < 1 || m > 12) return "Invalid month";
            return CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
        }
    }
}