@model HR_Application_CO_OP_HOS.Models.AttendanceDetail
@using System.Globalization

@{
    ViewBag.Title = "Create Attendance Record";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create Attendance Record</h1>
            <p class="lead">Add new attendance details for employees</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-edit"></i> Attendance Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.RelatedPartyID, GetRelatedParties(), "Select Related Party", new { @class = "form-control", id = "RelatedPartyID" })
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-info" onclick="showPartyDetails()">
                                                    <i class="fa fa-info"></i>
                                                </button>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WorkedMonth, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.WorkedMonth, GetMonths(), "Select Month", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.WorkedMonth, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WorkedYear, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.WorkedYear, GetYears(), "Select Year", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.WorkedYear, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsOTRecommended, htmlAttributes: new { @class = "control-label" })
                                        <div class="checkbox-container">
                                            <label class="switch">
                                                @* Use non-For helper because the model property is nullable (bool?). Html.CheckBoxFor requires a non-nullable bool expression. *@
                                                @Html.CheckBox("IsOTRecommended", Model?.IsOTRecommended ?? false, new { @class = "form-check-input", id = "IsOTRecommended" })
                                                <span class="slider round"></span>
                                            </label>
                                            <span class="checkbox-label">Recommend for Overtime</span>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.IsOTRecommended, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-12 text-right">
                                        <button type="submit" class="btn btn-success btn-lg">
                                            <i class="fa fa-save"></i> Create Record
                                        </button>
                                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Information Panel -->
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Related Party Information</h3>
                </div>
                <div class="panel-body" id="partyInfoPanel">
                    <div class="text-center text-muted">
                        <i class="fa fa-user fa-3x mb-3"></i>
                        <p>Select a related party to view details</p>
                    </div>
                </div>
            </div>

            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-calendar"></i> Quick Stats</h3>
                </div>
                <div class="panel-body">
                    <div class="quick-stat">
                        <h5>Current Month Records</h5>
                        <p class="stat-value">0</p>
                    </div>
                    <div class="quick-stat">
                        <h5>OT Recommended This Month</h5>
                        <p class="stat-value">0</p>
                    </div>
                    <div class="quick-stat">
                        <h5>Active Parties</h5>
                        <p class="stat-value">0</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function showPartyDetails() {
            const partyId = $('#RelatedPartyID').val();
            if (!partyId) {
                alert('Please select a related party first.');
                return;
            }

            // Simulate API call to get party details
            $('#partyInfoPanel').html(`
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                        <p>Loading party information...</p>
                    </div>
                `);

            // Simulate API response
            setTimeout(() => {
                $('#partyInfoPanel').html(`
                        <div class="party-details">
                            <h5>Party Information</h5>
                            <div class="detail-item">
                                <strong>ID:</strong> <span>${partyId}</span>
                            </div>
                            <div class="detail-item">
                                <strong>Name:</strong> <span>Sample Employee ${partyId}</span>
                            </div>
                            <div class="detail-item">
                                <strong>Department:</strong> <span>Operations</span>
                            </div>
                            <div class="detail-item">
                                <strong>Designation:</strong> <span>Staff Member</span>
                            </div>
                            <div class="detail-item">
                                <strong>Status:</strong> <span class="badge badge-success">Active</span>
                            </div>
                        </div>
                    `);
            }, 1000);
        }

        $(document).ready(function () {
            // Real-time validation
            $('form').on('submit', function (e) {
                let isValid = true;
                $('.form-control').each(function () {
                    if (!$(this).val() && $(this).prop('required')) {
                        isValid = false;
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    alert('Please fill in all required fields.');
                }
            });

            // Auto-calculate suggestions
            $('#WorkedMonth, #WorkedYear').change(function () {
                updateQuickStats();
            });
        });

        function updateQuickStats() {
            // This would typically call your API to get real stats
            console.log('Updating quick stats...');
        }
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 25px;
        background: white;
    }

    .panel-heading {
        border-radius: 15px 15px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .control-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 10px;
        border: 2px solid #ecf0f1;
        padding: 12px 15px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .checkbox-container {
        display: flex;
        align-items: center;
        margin-top: 10px;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
        margin-right: 15px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #27ae60;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    .checkbox-label {
        font-weight: 500;
        color: #2c3e50;
    }

    .btn-lg {
        padding: 12px 30px;
        border-radius: 10px;
        font-weight: 600;
        margin-left: 10px;
    }

    .party-details .detail-item {
        padding: 8px 0;
        border-bottom: 1px solid #ecf0f1;
    }

        .party-details .detail-item:last-child {
            border-bottom: none;
        }

    .quick-stat {
        text-align: center;
        padding: 15px;
        border-bottom: 1px solid #ecf0f1;
    }

        .quick-stat:last-child {
            border-bottom: none;
        }

    .stat-value {
        font-size: 1.8rem;
        font-weight: bold;
        color: #e74c3c;
        margin: 5px 0;
    }

    .input-group-append .btn {
        border-radius: 0 10px 10px 0;
    }

    .alert-danger {
        border-radius: 10px;
        padding: 15px;
    }
</style>

@functions {
    private List<SelectListItem> GetRelatedParties()
    {
        // This would typically come from your database
        return new List<SelectListItem>
{
            new SelectListItem { Text = "John Doe (EMP001)", Value = "1" },
            new SelectListItem { Text = "Jane Smith (EMP002)", Value = "2" },
            new SelectListItem { Text = "Mike Johnson (EMP003)", Value = "3" }
        };
    }

    private List<SelectListItem> GetMonths()
    {
        return DateTimeFormatInfo.CurrentInfo.MonthNames
            .Select((monthName, index) => new SelectListItem
            {
                Value = (index + 1).ToString(),
                Text = monthName,
                Selected = (index + 1) == DateTime.Now.Month
            })
            .Where(x => !string.IsNullOrEmpty(x.Text))
            .ToList();
    }

    private List<SelectListItem> GetYears()
    {
        var years = new List<SelectListItem>();
        for (int year = DateTime.Now.Year - 2; year <= DateTime.Now.Year + 1; year++)
        {
            years.Add(new SelectListItem
            {
                Value = year.ToString(),
                Text = year.ToString(),
                Selected = year == DateTime.Now.Year
            });
        }
        return years;
    }
}