@using System.Globalization
@model IEnumerable<HR_Application_CO_OP_HOS.Models.AttendanceDetail>

@{
    ViewBag.Title = "Attendance Details";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-calendar-check-o"></i> Attendance Details</h1>
            <p class="lead">Manage and monitor employee attendance records</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row no-gutters mb-4">
        <div class="col-12">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-rocket"></i> Quick Actions</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success btn-block" })
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-info btn-block" onclick="toggleFilters()">
                                <i class="fa fa-filter"></i> Toggle Filters
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-warning btn-block" onclick="exportToExcel()">
                                <i class="fa fa-download"></i> Export Excel
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary btn-block" onclick="refreshData()">
                                <i class="fa fa-refresh"></i> Refresh
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="row no-gutters mb-4" id="filtersSection" style="display: none;">
        <div class="col-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-filter"></i> Advanced Filters</h3>
                </div>
                <div class="panel-body">
                    <div class="row no-gutters">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Related Party</label>
                                @Html.DropDownList("RelatedPartyFilter", GetRelatedParties(), "All Parties", new { @class = "form-control", onchange = "applyFilters()" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>Worked Month</label>
                                @Html.DropDownList("MonthFilter", GetMonths(), "All Months", new { @class = "form-control", onchange = "applyFilters()" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>Worked Year</label>
                                @Html.DropDownList("YearFilter", GetYears(), "All Years", new { @class = "form-control", onchange = "applyFilters()" })
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>OT Recommended</label>
                                <select class="form-control" id="OTFilter" onchange="applyFilters()">
                                    <option value="">All</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Search</label>
                                <input type="text" class="form-control" id="searchFilter" placeholder="Search records..." onkeyup="applyFilters()" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="row no-gutters">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-list"></i> Attendance Records</h3>
                </div>
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="attendanceTable">
                            <thead>
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.RelatedPartyID)</th>
                                    <th>@Html.DisplayNameFor(model => model.WorkedMonth)</th>
                                    <th>@Html.DisplayNameFor(model => model.WorkedYear)</th>
                                    <th>@Html.DisplayNameFor(model => model.IsOTRecommended)</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <span class="party-info" data-toggle="tooltip" title="@GetRelatedPartyName(item.RelatedPartyID)">
                                                    @Html.DisplayFor(modelItem => item.RelatedPartyID)
                                                </span>
                                            </td>
                                            <td>@GetMonthName(item.WorkedMonth)</td>
                                            <td>@Html.DisplayFor(modelItem => item.WorkedYear)</td>
                                            <td>
                                                @if (item.IsOTRecommended.HasValue && item.IsOTRecommended.Value)
                                                {
                                                    <span class="badge badge-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info btn-sm" })
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-warning btn-sm" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger btn-sm" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">
                                            <i class="fa fa-info-circle fa-2x mb-3"></i>
                                            <br />
                                            No attendance records found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Summary Statistics -->
                    <div class="row no-gutters mt-4">
                        <div class="col-md-3 text-center">
                            <div class="stat-card">
                                <h4>Total Records</h4>
                                <p class="stat-number">@(Model?.Count() ?? 0)</p>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="stat-card">
                                <h4>OT Recommended</h4>
                                <p class="stat-number">@(Model?.Count(x => x.IsOTRecommended == true) ?? 0)</p>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="stat-card">
                                <h4>Current Month</h4>
                                <p class="stat-number">@(Model?.Count(x => x.WorkedMonth == DateTime.Now.Month && x.WorkedYear == DateTime.Now.Year) ?? 0)</p>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="stat-card">
                                <h4>Active Parties</h4>
                                <p class="stat-number">@(Model?.Select(x => x.RelatedPartyID).Distinct().Count() ?? 0)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleFilters() {
            $('#filtersSection').slideToggle();
        }

        function applyFilters() {
            const searchText = $('#searchFilter').val().toLowerCase();
            const partyFilter = $('#RelatedPartyFilter').val();
            // Keep monthFilter (value) for potential numeric logic, but compare using the selected text
            const monthFilterText = $('#MonthFilter option:selected').text();
            const yearFilter = $('#YearFilter').val();
            const otFilter = $('#OTFilter').val();

            $('#attendanceTable tbody tr').each(function () {
                const row = $(this);
                const partyId = row.find('td:eq(0)').text().trim();
                const month = row.find('td:eq(1)').text().trim(); // this is the month name
                const year = row.find('td:eq(2)').text().trim();
                const ot = row.find('td:eq(3) .badge').text().trim().toLowerCase();
                const rowText = row.text().toLowerCase();

                const showRow =
                    (searchText === '' || rowText.includes(searchText)) &&
                    (partyFilter === '' || partyId === partyFilter) &&
                    (monthFilterText === 'All Months' || month === monthFilterText) &&
                    (yearFilter === '' || year === yearFilter) &&
                    (otFilter === '' || (otFilter === 'true' && ot === 'yes') || (otFilter === 'false' && ot === 'no'));

                row.toggle(showRow);
            });
        }

        function exportToExcel() {
            // Simple Excel export implementation
            const table = document.getElementById('attendanceTable');
            const html = table.outerHTML;
            const url = 'data:application/vnd.ms-excel,' + escape(html);
            window.open(url, 'Attendance_Export');
        }

        function refreshData() {
            location.reload();
        }

        $(document).ready(function () {
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 25px;
        background: white;
    }

    .panel-heading {
        border-radius: 15px 15px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .table th {
        background-color: #34495e;
        color: white;
        border: none;
        padding: 15px;
        font-weight: 600;
    }

    .table td {
        padding: 15px;
        vertical-align: middle;
        border-color: #ecf0f1;
    }

    .btn-group .btn {
        margin: 2px;
        border-radius: 8px;
    }

    .stat-card {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        margin: 10px 0;
    }

    .badge {
        padding: 8px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
    }

    .party-info {
        cursor: help;
        border-bottom: 1px dotted #3498db;
    }

    .form-control {
        border-radius: 8px;
        border: 2px solid #ecf0f1;
        padding: 12px 15px;
        font-size: 1rem;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }
</style>

@functions {
    private List<SelectListItem> GetRelatedParties()
    {
        // This would typically come from your database
        // For demo purposes, returning empty list
        return new List<SelectListItem>();
    }

    private List<SelectListItem> GetMonths()
    {
        return new List<SelectListItem>
    {
            new SelectListItem { Text = "All Months", Value = "" },
            new SelectListItem { Text = "January", Value = "1" },
            new SelectListItem { Text = "February", Value = "2" },
            new SelectListItem { Text = "March", Value = "3" },
            new SelectListItem { Text = "April", Value = "4" },
            new SelectListItem { Text = "May", Value = "5" },
            new SelectListItem { Text = "June", Value = "6" },
            new SelectListItem { Text = "July", Value = "7" },
            new SelectListItem { Text = "August", Value = "8" },
            new SelectListItem { Text = "September", Value = "9" },
            new SelectListItem { Text = "October", Value = "10" },
            new SelectListItem { Text = "November", Value = "11" },
            new SelectListItem { Text = "December", Value = "12" }
        };
    }

    private List<SelectListItem> GetYears()
    {
        var years = new List<SelectListItem>();
        for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year + 1; year++)
        {
            years.Add(new SelectListItem { Text = year.ToString(), Value = year.ToString() });
        }
        return years;
    }

    private string GetMonthName(int? month)
    {
        if (!month.HasValue) return "N/A";
        if (month.Value < 1 || month.Value > 12) return "Invalid";
        // fixed: CultureInfo is available via @using System.Globalization at top
        return CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month.Value);
    }

    private string GetRelatedPartyName(int? partyId)
    {
        if (!partyId.HasValue) return "Unknown";
        // This would typically come from your database
        return $"Party ID: {partyId.Value}";
    }
}