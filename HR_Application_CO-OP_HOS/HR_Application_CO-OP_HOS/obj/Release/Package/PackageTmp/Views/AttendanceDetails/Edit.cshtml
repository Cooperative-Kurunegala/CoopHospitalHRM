@model HR_Application_CO_OP_HOS.Models.AttendanceDetail

@{
    ViewBag.Title = "Edit Attendance Record";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Attendance Record</h1>
            <p class="lead">Update attendance details for employees</p>
        </div>
    </div>

    <div class="row no-gutters">
        <!-- Form Section -->
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-pencil"></i> Edit Attendance Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ID)

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group">
                                <label class="control-label">Record ID</label>
                                <div class="form-control-static">
                                    <strong>@Model.ID</strong>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.RelatedPartyID, GetRelatedParties(), "Select Related Party", new { @class = "form-control", id = "RelatedPartyID" })
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-info" onclick="showPartyDetails()">
                                                    <i class="fa fa-info"></i>
                                                </button>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WorkedMonth, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.WorkedMonth, GetMonths(), "Select Month", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.WorkedMonth, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WorkedYear, htmlAttributes: new { @class = "control-label" })
                                        @Html.DropDownListFor(model => model.WorkedYear, GetYears(), "Select Year", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.WorkedYear, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsOTRecommended, htmlAttributes: new { @class = "control-label" })
                                        <div class="checkbox-container">
                                            <label class="switch">
                                                @* Hidden input to ensure a value is posted when the checkbox is unchecked (mirrors CheckBoxFor behavior) *@
                                                <input type="hidden" name="IsOTRecommended" value="false" />
                                                <input type="checkbox" name="IsOTRecommended" value="true" class="form-check-input" @(Model.IsOTRecommended == true ? "checked=\"checked\"" : "") />
                                                <span class="slider round"></span>
                                            </label>
                                            <span class="checkbox-label">Recommend for Overtime</span>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.IsOTRecommended, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-12 text-right">
                                        <button type="submit" class="btn btn-warning btn-lg">
                                            <i class="fa fa-save"></i> Update Record
                                        </button>
                                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                        @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Information Panel -->
        <div class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Current Record Info</h3>
                </div>
                <div class="panel-body">
                    <div class="record-summary">
                        <div class="summary-item">
                            <strong>Record ID:</strong> <span>@Model.ID</span>
                        </div>
                        <div class="summary-item">
                            <strong>Created:</strong> <span>@DateTime.Now.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="summary-item">
                            <strong>Last Modified:</strong> <span>@DateTime.Now.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="summary-item">
                            <strong>Status:</strong>
                            <span class="badge @(Model.IsOTRecommended.HasValue && Model.IsOTRecommended.Value ? "badge-success" : "badge-secondary")">
                                @(Model.IsOTRecommended.HasValue && Model.IsOTRecommended.Value ? "OT Recommended" : "Regular")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> Update History</h3>
                </div>
                <div class="panel-body">
                    <div class="history-list">
                        <div class="history-item">
                            <div class="history-date">Today</div>
                            <div class="history-action">Record opened for editing</div>
                        </div>
                        <div class="history-item">
                            <div class="history-date">@DateTime.Now.AddDays(-1).ToString("MMM dd")</div>
                            <div class="history-action">Last modification</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function showPartyDetails() {
            const partyId = $('#RelatedPartyID').val();
            if (!partyId) {
                alert('Please select a related party first.');
                return;
            }

            // In a real application, this would fetch actual party details
            alert(`Showing details for party ID: ${partyId}\n\nThis would display detailed information about the selected party in a real application.`);
        }

        $(document).ready(function () {
            // Auto-populate party info when page loads
            if ($('#RelatedPartyID').val()) {
                showPartyDetails();
            }

            // Real-time validation
            $('form').on('submit', function (e) {
                let isValid = true;
                $('.form-control').each(function () {
                    if (!$(this).val() && $(this).prop('required')) {
                        isValid = false;
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    alert('Please fill in all required fields.');
                }
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        margin: 0;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #f39c12 0%, #f1c40f 100%);
        color: white;
        border-radius: 15px;
        padding: 40px 30px;
        margin-bottom: 30px;
    }

    .panel {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        margin-bottom: 25px;
        background: white;
    }

    .panel-heading {
        border-radius: 15px 15px 0 0 !important;
        border: none;
        padding: 20px 25px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .form-control-static {
        padding: 10px 15px;
        background-color: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .record-summary .summary-item {
        padding: 10px 0;
        border-bottom: 1px solid #ecf0f1;
    }

        .record-summary .summary-item:last-child {
            border-bottom: none;
        }

    .history-list .history-item {
        padding: 12px 0;
        border-bottom: 1px solid #ecf0f1;
    }

        .history-list .history-item:last-child {
            border-bottom: none;
        }

    .history-date {
        font-weight: 600;
        color: #2c3e50;
        font-size: 0.9rem;
    }

    .history-action {
        color: #7f8c8d;
        font-size: 0.85rem;
    }

    /* Reuse styles from Create view */
    .form-group {
        margin-bottom: 25px;
    }

    .control-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 10px;
        border: 2px solid #ecf0f1;
        padding: 12px 15px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .checkbox-container {
        display: flex;
        align-items: center;
        margin-top: 10px;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
        margin-right: 15px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #27ae60;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    .checkbox-label {
        font-weight: 500;
        color: #2c3e50;
    }

    .btn-lg {
        padding: 12px 30px;
        border-radius: 10px;
        font-weight: 600;
        margin-left: 10px;
    }

    .input-group-append .btn {
        border-radius: 0 10px 10px 0;
    }

    .alert-danger {
        border-radius: 10px;
        padding: 15px;
    }
</style>

@functions {
    private List<SelectListItem> GetRelatedParties()
    {
        return new List<SelectListItem>
{
            new SelectListItem { Text = "John Doe (EMP001)", Value = "1" },
            new SelectListItem { Text = "Jane Smith (EMP002)", Value = "2" },
            new SelectListItem { Text = "Mike Johnson (EMP003)", Value = "3" }
        };
    }

    private List<SelectListItem> GetMonths()
    {
        return System.Globalization.DateTimeFormatInfo.CurrentInfo.MonthNames
            .Select((monthName, index) => new SelectListItem
            {
                Value = (index + 1).ToString(),
                Text = monthName
            })
            .Where(x => !string.IsNullOrEmpty(x.Text))
            .ToList();
    }

    private List<SelectListItem> GetYears()
    {
        var years = new List<SelectListItem>();
        for (int year = DateTime.Now.Year - 2; year <= DateTime.Now.Year + 1; year++)
        {
            years.Add(new SelectListItem
            {
                Value = year.ToString(),
                Text = year.ToString()
            });
        }
        return years;
    }
}