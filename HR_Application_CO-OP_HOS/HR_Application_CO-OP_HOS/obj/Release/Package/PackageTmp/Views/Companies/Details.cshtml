@model HR_Application_CO_OP_HOS.Models.Company

@{
    ViewBag.Title = "Company Details";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-building"></i> Company Details</h1>
            <p class="lead">View complete company information</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Basic Information</h3>
                </div>
                <div class="panel-body">
                    <div class="details-section">
                        <dl class="row details-dl">
                            <dt class="col-sm-4">Company ID:</dt>
                            <dd class="col-sm-8">@Model.ID</dd>

                            <dt class="col-sm-4">Company Name:</dt>
                            <dd class="col-sm-8">@Model.companyName</dd>
                        </dl>
                    </div>

                    <div class="action-buttons mt-4">
                        <div class="btn-group" role="group">
                            @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-warning btn-lg" })
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                            @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn btn-danger btn-lg" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Related Data Panel -->
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-line-chart"></i> Related Statistics</h3>
                </div>
                <div class="panel-body">
                    <div class="statistics-section">
                        <div class="stat-item text-center mb-4">
                            <div class="stat-icon">
                                <i class="fa fa-users fa-3x text-primary"></i>
                            </div>
                            <h3 id="employeeCount">--</h3>
                            <p class="text-muted">Total Employees</p>
                        </div>

                        <div class="stat-item text-center mb-4">
                            <div class="stat-icon">
                                <i class="fa fa-money fa-3x text-success"></i>
                            </div>
                            <h3 id="payrollCount">--</h3>
                            <p class="text-muted">Payroll Records</p>
                        </div>

                        <div class="stat-item text-center">
                            <div class="stat-icon">
                                <i class="fa fa-clock-o fa-3x text-warning"></i>
                            </div>
                            <h3 id="attendanceCount">--</h3>
                            <p class="text-muted">Attendance Records</p>
                        </div>
                    </div>

                    <div class="quick-links mt-4">
                        <h5><i class="fa fa-external-link"></i> Quick Links</h5>
                        <div class="list-group">
                            <a href="@Url.Action("Index", "RelatedParties", new { companyId = Model.ID })" class="list-group-item list-group-item-action">
                                <i class="fa fa-users text-primary"></i> View Employees
                            </a>
                            <a href="@Url.Action("Index", "PayrollRecords", new { companyId = Model.ID })" class="list-group-item list-group-item-action">
                                <i class="fa fa-money text-success"></i> View Payroll
                            </a>
                            <a href="@Url.Action("Index", "AttendanceRecords", new { companyId = Model.ID })" class="list-group-item list-group-item-action">
                                <i class="fa fa-clock-o text-warning"></i> View Attendance
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Information Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-history"></i> System Information</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Creation Information</h5>
                            <p class="text-muted">This company record was created in the system.</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Last Updated</h5>
                            <p class="text-muted">Record maintained in the central database.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Load statistics (simulated)
            loadStatistics();

            function loadStatistics() {
                // Simulate API call to get statistics
                setTimeout(function () {
                    $('#employeeCount').text('0');
                    $('#payrollCount').text('0');
                    $('#attendanceCount').text('0');
                }, 1000);
            }

            // Print functionality
            $('.btn-print').click(function () {
                window.print();
            });
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin: 20px 0;
        background: white;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .details-dl dt {
        font-weight: 600;
        color: #6c757d;
        padding: 8px 0;
    }

    .details-dl dd {
        color: #495057;
        padding: 8px 0;
        border-bottom: 1px solid #e9ecef;
    }

    .stat-item {
        padding: 20px;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        background: #f8f9fa;
    }

        .stat-item h3 {
            font-size: 2rem;
            font-weight: bold;
            margin: 10px 0;
            color: #2c3e50;
        }

    .quick-links .list-group-item {
        border: none;
        border-left: 3px solid transparent;
        margin-bottom: 5px;
        transition: all 0.3s ease;
    }

        .quick-links .list-group-item:hover {
            border-left-color: #3498db;
            background-color: #f8f9fa;
        }

    .btn-group .btn {
        margin: 0 5px;
    }

    @@media (max-width: 768px) {
        .dashboard-header .jumbotron {
            padding: 30px 15px;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
        }

            .btn-group .btn {
                margin: 5px 0;
                width: 100%;
            }

        .details-dl .row {
            margin-bottom: 10px;
        }
    }
</style>