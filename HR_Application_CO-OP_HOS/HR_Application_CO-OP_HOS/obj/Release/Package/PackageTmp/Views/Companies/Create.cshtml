@model HR_Application_CO_OP_HOS.Models.Company

@{
    ViewBag.Title = "Create Company";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-plus-circle"></i> Create New Company</h1>
            <p class="lead">Add a new company to the system</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-building"></i> Company Information</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="form-group row">
                                @Html.LabelFor(model => model.companyName, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.companyName, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter company name" } })
                                    @Html.ValidationMessageFor(model => model.companyName, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Enter the full legal name of the company</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-3 col-md-9">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fa fa-save"></i> Create Company
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Foreign Key Reference Panel -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Reference Information</h3>
                </div>
                <div class="panel-body">
                    <div class="reference-section">
                        <h5><i class="fa fa-link"></i> Related Entities</h5>
                        <p class="text-muted">This company can be linked to:</p>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <i class="fa fa-users text-primary"></i>
                                <strong>Related Parties</strong>
                                <span class="badge badge-primary float-right" id="relatedPartiesCount">--</span>
                            </li>
                            <li class="list-group-item">
                                <i class="fa fa-money text-success"></i>
                                <strong>Payroll Records</strong>
                                <span class="badge badge-success float-right" id="payrollRecordsCount">--</span>
                            </li>
                            <li class="list-group-item">
                                <i class="fa fa-clock-o text-warning"></i>
                                <strong>Attendance Records</strong>
                                <span class="badge badge-warning float-right" id="attendanceRecordsCount">--</span>
                            </li>
                        </ul>
                    </div>

                    <div class="quick-tips mt-4">
                        <h5><i class="fa fa-lightbulb-o"></i> Quick Tips</h5>
                        <div class="alert alert-info">
                            <ul class="mb-0">
                                <li>Use descriptive company names</li>
                                <li>Ensure the name matches legal documents</li>
                                <li>Consider naming conventions for consistency</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Form validation enhancement
            $('form').submit(function (e) {
                var companyName = $('#companyName').val().trim();
                if (companyName === '') {
                    e.preventDefault();
                    showError('Company name is required');
                    return false;
                }

                // Additional validation can be added here
                showLoading('Creating company...');
            });

            // Real-time validation
            $('#companyName').on('input', function () {
                var value = $(this).val();
                if (value.length > 0) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                }
            });

            // Load reference data (simulated - in real scenario, you'd fetch from API)
            loadReferenceData();

            function loadReferenceData() {
                // Simulate loading reference data
                setTimeout(function () {
                    $('#relatedPartiesCount').text('0');
                    $('#payrollRecordsCount').text('0');
                    $('#attendanceRecordsCount').text('0');
                }, 500);
            }

            function showError(message) {
                var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                    '<i class="fa fa-exclamation-triangle"></i> ' + message +
                    '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '</button>' +
                    '</div>';
                $('.form-horizontal').prepend(alertHtml);
            }

            function showLoading(message) {
                // You can implement a loading indicator here
                console.log(message);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #27ae60 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin: 20px 0;
        background: white;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .form-control-lg {
        font-size: 1.1rem;
        padding: 12px 15px;
    }

    .reference-section .list-group-item {
        border: none;
        border-left: 3px solid transparent;
        margin-bottom: 5px;
        transition: all 0.3s ease;
    }

        .reference-section .list-group-item:hover {
            border-left-color: #3498db;
            background-color: #f8f9fa;
        }

    .btn-lg {
        padding: 12px 30px;
        font-size: 1.1rem;
        margin-right: 10px;
    }

    @@media (max-width: 768px) {
        .dashboard-header .jumbotron {
            padding: 30px 15px;
        }

        .form-group.row .col-md-9 {
            margin-top: 10px;
        }

        .btn-lg {
            width: 100%;
            margin-bottom: 10px;
            margin-right: 0;
        }
    }
</style>