@model HR_Application_CO_OP_HOS.Models.Company

@{
    ViewBag.Title = "Delete Company";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-trash"></i> Delete Company</h1>
            <p class="lead">Remove company from the system</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> Confirm Deletion</h3>
                </div>
                <div class="panel-body">
                    <div class="alert alert-danger">
                        <h4><i class="fa fa-warning"></i> Warning!</h4>
                        <p>You are about to permanently delete this company. This action cannot be undone.</p>
                    </div>

                    <div class="company-details">
                        <h5>Company to be deleted:</h5>
                        <dl class="row">
                            <dt class="col-sm-4">Company ID:</dt>
                            <dd class="col-sm-8">@Model.ID</dd>

                            <dt class="col-sm-4">Company Name:</dt>
                            <dd class="col-sm-8">@Model.companyName</dd>
                        </dl>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-actions no-color mt-4">
                            <button type="submit" class="btn btn-danger btn-lg" id="deleteButton">
                                <i class="fa fa-trash"></i> Confirm Delete
                            </button>
                            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Impact Analysis Panel -->
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-chain-broken"></i> Impact Analysis</h3>
                </div>
                <div class="panel-body">
                    <div class="impact-list">
                        <h5><i class="fa fa-exclamation-circle text-danger"></i> This will affect:</h5>
                        <ul class="list-group">
                            <li class="list-group-item list-group-item-danger">
                                <i class="fa fa-users"></i> All related employee records
                            </li>
                            <li class="list-group-item list-group-item-danger">
                                <i class="fa fa-money"></i> Payroll and salary records
                            </li>
                            <li class="list-group-item list-group-item-danger">
                                <i class="fa fa-clock-o"></i> Attendance and time records
                            </li>
                            <li class="list-group-item list-group-item-danger">
                                <i class="fa fa-file-text"></i> All associated reports
                            </li>
                            <li class="list-group-item list-group-item-danger">
                                <i class="fa fa-bar-chart"></i> Analytics and statistics
                            </li>
                        </ul>
                    </div>

                    <div class="recommendation mt-4">
                        <div class="alert alert-info">
                            <h6><i class="fa fa-lightbulb-o"></i> Recommendation</h6>
                            <p class="mb-0">Consider archiving instead of deleting to preserve historical data.</p>
                        </div>
                    </div>

                    <div class="alternative-actions mt-4">
                        <h5><i class="fa fa-random"></i> Alternative Actions</h5>
                        <div class="btn-group-vertical w-100">
                            @Html.ActionLink("Edit Instead", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-warning btn-sm mb-2" })
                            @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-outline-info btn-sm mb-2" })
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary btn-sm" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var confirmed = false;

            $('#deleteButton').click(function (e) {
                if (!confirmed) {
                    e.preventDefault();

                    // Show confirmation dialog with more details
                    var companyName = '@Model.companyName';
                    var confirmationMessage =
                        'You are about to PERMANENTLY DELETE the company:\n\n' +
                        'Company: ' + companyName + '\n' +
                        'ID: @Model.ID\n\n' +
                        'This action cannot be undone!\n\n' +
                        'Type "DELETE" to confirm:';

                    var userInput = prompt(confirmationMessage);

                    if (userInput === 'DELETE') {
                        confirmed = true;
                        showLoading('Deleting company...');
                        $('#deleteButton').click();
                    } else {
                        showError('Deletion cancelled. The company was not deleted.');
                    }
                }
            });

            // Add confirmation safeguard
            $('form').submit(function (e) {
                if (!confirmed) {
                    e.preventDefault();
                    showError('Please confirm deletion using the button.');
                    return false;
                }
            });

            function showError(message) {
                var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                    '<i class="fa fa-exclamation-triangle"></i> ' + message +
                    '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '</button>' +
                    '</div>';
                $('.panel-body').prepend(alertHtml);
            }

            function showLoading(message) {
                $('#deleteButton').html('<i class="fa fa-spinner fa-spin"></i> ' + message).prop('disabled', true);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #e74c3c 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin: 20px 0;
        background: white;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .company-details dl {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        border-left: 4px solid #e74c3c;
    }

    .company-details dt {
        font-weight: 600;
        color: #6c757d;
    }

    .company-details dd {
        color: #495057;
        font-weight: 500;
    }

    .impact-list .list-group-item {
        border: none;
        border-left: 3px solid #e74c3c;
        margin-bottom: 5px;
        font-weight: 500;
    }

    .btn-group-vertical .btn {
        text-align: left;
        padding: 10px 15px;
    }

    #deleteButton {
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .dashboard-header .jumbotron {
            padding: 30px 15px;
        }

        .form-actions .btn {
            width: 100%;
            margin-bottom: 10px;
        }

        .company-details .row {
            margin-bottom: 10px;
        }
    }
</style>