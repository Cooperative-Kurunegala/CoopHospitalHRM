@model HR_Application_CO_OP_HOS.Models.Company

@{
    ViewBag.Title = "Edit Company";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="jumbotron">
            <h1><i class="fa fa-edit"></i> Edit Company</h1>
            <p class="lead">Update company information</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-building"></i> Edit Company Details</h3>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                            @Html.HiddenFor(model => model.ID)

                            <div class="form-group row">
                                @Html.LabelFor(model => model.companyName, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.companyName, new { htmlAttributes = new { @class = "form-control form-control-lg", placeholder = "Enter company name" } })
                                    @Html.ValidationMessageFor(model => model.companyName, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">Current company name will be updated</small>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-offset-3 col-md-9">
                                    <button type="submit" class="btn btn-warning btn-lg">
                                        <i class="fa fa-save"></i> Update Company
                                    </button>
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                                    @Html.ActionLink("View Details", "Details", new { id = Model.ID }, new { @class = "btn btn-info btn-lg" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Current Information Panel -->
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-info-circle"></i> Current Information</h3>
                </div>
                <div class="panel-body">
                    <div class="current-info">
                        <h5><i class="fa fa-building text-primary"></i> Current Details</h5>
                        <dl class="row">
                            <dt class="col-sm-5">Company ID:</dt>
                            <dd class="col-sm-7">@Model.ID</dd>

                            <dt class="col-sm-5">Current Name:</dt>
                            <dd class="col-sm-7" id="currentCompanyName">@Model.companyName</dd>
                        </dl>
                    </div>

                    <div class="impact-analysis mt-4">
                        <h5><i class="fa fa-exclamation-triangle text-warning"></i> Impact Analysis</h5>
                        <div class="alert alert-warning">
                            <strong>Note:</strong> Changing the company name will affect:
                            <ul class="mt-2 mb-0">
                                <li>All related employee records</li>
                                <li>Payroll calculations</li>
                                <li>Reporting and analytics</li>
                            </ul>
                        </div>
                    </div>

                    <div class="change-history mt-4">
                        <h5><i class="fa fa-history text-info"></i> Quick Actions</h5>
                        <div class="btn-group-vertical w-100">
                            @Html.ActionLink("View Related Employees", "Index", "RelatedParties", new { companyId = Model.ID }, new { @class = "btn btn-outline-primary btn-sm mb-2" })
                            @Html.ActionLink("View Attendance", "Index", "AttendanceRecords", new { companyId = Model.ID }, new { @class = "btn btn-outline-info btn-sm mb-2" })
                            @Html.ActionLink("View Payroll", "Index", "PayrollRecords", new { companyId = Model.ID }, new { @class = "btn btn-outline-success btn-sm" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            var originalName = '@Model.companyName';

            // Real-time comparison
            $('#companyName').on('input', function () {
                var newName = $(this).val();
                var currentNameElement = $('#currentCompanyName');

                if (newName !== originalName) {
                    currentNameElement.html('<span class="text-warning">' + originalName + '</span>');
                    showChangeIndicator();
                } else {
                    currentNameElement.text(originalName);
                    hideChangeIndicator();
                }

                // Validation
                if (newName.trim() === '') {
                    $(this).addClass('is-invalid').removeClass('is-valid');
                } else {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                }
            });

            // Form submission enhancement
            $('form').submit(function (e) {
                var newName = $('#companyName').val().trim();
                if (newName === '') {
                    e.preventDefault();
                    showError('Company name cannot be empty');
                    return false;
                }

                if (newName === originalName) {
                    if (!confirm('No changes detected. Are you sure you want to continue?')) {
                        e.preventDefault();
                        return false;
                    }
                }

                showLoading('Updating company information...');
            });

            function showChangeIndicator() {
                $('.impact-analysis').fadeIn();
            }

            function hideChangeIndicator() {
                $('.impact-analysis').fadeOut();
            }

            function showError(message) {
                var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                    '<i class="fa fa-exclamation-triangle"></i> ' + message +
                    '<button type="button" class="close" data-dismiss="alert" aria-label="Close">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '</button>' +
                    '</div>';
                $('.form-horizontal').prepend(alertHtml);
            }

            function showLoading(message) {
                // Implement loading indicator
                console.log(message);
            }
        });
    </script>
}

<style>
    .dashboard-container {
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 0;
        margin: 0;
    }

    body {
        padding: 0 !important;
        margin: 0 !important;
        overflow-x: hidden;
    }

    .dashboard-header .jumbotron {
        background: linear-gradient(135deg, #2c3e50 0%, #f39c12 100%);
        color: white;
        border-radius: 0;
        padding: 40px 20px;
        margin: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .panel {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        margin: 20px 0;
        background: white;
    }

    .panel-heading {
        border-radius: 10px 10px 0 0 !important;
        border: none;
        padding: 20px;
        font-weight: 600;
    }

    .panel-body {
        padding: 25px;
    }

    .current-info dl {
        margin-bottom: 0;
    }

    .current-info dt {
        font-weight: 600;
        color: #6c757d;
    }

    .current-info dd {
        color: #495057;
    }

    .btn-group-vertical .btn {
        text-align: left;
        padding: 10px 15px;
    }

    @@media (max-width: 768px) {
        .dashboard-header .jumbotron {
            padding: 30px 15px;
        }

        .form-group.row .col-md-9 {
            margin-top: 10px;
        }

        .btn-lg {
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>