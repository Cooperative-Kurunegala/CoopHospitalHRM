@model IEnumerable<HR_Application_CO_OP_HOS.Models.PaymentSubCategory>

@{
    ViewBag.Title = "Payment Sub Categories";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Payment Sub Categories</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        .container-fluid {
            padding: 20px;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px 30px;
            margin: -20px -20px 25px -20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.2rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 5px 0 0 0;
        }

        /* Card Styles */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            background: white;
        }

        .card-header {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            border-radius: 12px 12px 0 0 !important;
            padding: 20px 25px;
            font-weight: 600;
            font-size: 1.3rem;
        }

        .card-body {
            padding: 25px;
        }

        /* Table Styles */
        .table-container {
            overflow-x: auto;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            font-size: 1.1rem;
        }

            .table th {
                background-color: #34495e;
                color: white;
                padding: 15px 12px;
                font-weight: 600;
                border: none;
            }

            .table td {
                padding: 12px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: middle;
            }

            .table tbody tr:hover {
                background-color: #f8f9fa;
                transform: scale(1.01);
                transition: all 0.2s ease;
            }

        /* Action Buttons */
        .btn-action {
            padding: 6px 12px;
            margin: 2px;
            border-radius: 6px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .btn-edit {
            background-color: #f39c12;
            border-color: #f39c12;
            color: white;
        }

        .btn-details {
            background-color: #3498db;
            border-color: #3498db;
            color: white;
        }

        .btn-delete {
            background-color: #e74c3c;
            border-color: #e74c3c;
            color: white;
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            color: white;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        /* Filter Section */
        .filter-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            border-left: 4px solid #3498db;
        }

        .filter-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 2px solid #ecf0f1;
            padding: 10px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
            font-size: 1.2rem;
        }

            .no-records i {
                font-size: 3rem;
                margin-bottom: 15px;
                color: #bdc3c7;
            }

        /* Loading Spinner */
        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
        }

        .spinner-border {
            width: 3rem;
            height: 3rem;
            color: #3498db;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 10px;
            }

            .page-header {
                padding: 20px;
                margin: -10px -10px 20px -10px;
            }

            .page-title {
                font-size: 1.8rem;
            }

            .card-body {
                padding: 15px;
            }

            .table {
                font-size: 0.95rem;
            }

            .btn-action {
                padding: 4px 8px;
                font-size: 0.8rem;
                margin: 1px;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="page-title"><i class="fa fa-list-alt"></i> Payment Sub Categories</h1>
                    <p class="page-subtitle">Manage all payment sub categories in the system</p>
                </div>
                <div>
                    <a href="@Url.Action("Create")" class="btn btn-create">
                        <i class="fa fa-plus"></i> Create New
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="filter-label">Search Category Name</label>
                        <input type="text" id="searchCategory" class="form-control" placeholder="Enter category name...">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="filter-label">Filter by Order Type</label>
                        <select id="filterOrderType" class="form-select">
                            <option value="">All Order Types</option>
                            <!-- Order Types will be populated via AJAX -->
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3 d-flex align-items-end">
                        <button id="btnClearFilters" class="btn btn-outline-secondary me-2">
                            <i class="fa fa-refresh"></i> Clear
                        </button>
                        <button id="btnApplyFilters" class="btn btn-primary">
                            <i class="fa fa-filter"></i> Apply Filters
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading Spinner -->
        <div class="loading-spinner" id="loadingSpinner">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading data...</p>
        </div>

        <!-- Main Content -->
        <div class="card">
            <div class="card-header">
                <i class="fa fa-table"></i> Payment Sub Categories List
                <span class="badge bg-light text-dark ms-2" id="recordCount">0 records</span>
            </div>
            <div class="card-body">
                <div class="table-container">
                    <table class="table table-hover" id="paymentSubCategoriesTable">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th>Order Type ID</th>
                                <th>Order Type Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            @try
                            {
                                if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.OrderTypeID)</td>
                                            <td class="order-type-name" data-order-type-id="@item.OrderTypeID">
                                                <i class="fa fa-spinner fa-spin"></i>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-action btn-edit" })
                                                    @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-action btn-details" })
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-action btn-delete" })
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="no-records">
                                            <i class="fa fa-inbox"></i>
                                            <br>
                                            No payment sub categories found
                                        </td>
                                    </tr>
                                }
                            }
                            catch (Exception ex)
                            {
                                <tr>
                                    <td colspan="4" class="text-danger text-center">
                                        <i class="fa fa-exclamation-triangle"></i>
                                        <br>
                                        Error loading data: @ex.Message
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Load order types for filter dropdown
            loadOrderTypes();

            // Load order type names for display
            loadOrderTypeNames();

            // Filter functionality
            $('#btnApplyFilters').click(function () {
                applyFilters();
            });

            $('#btnClearFilters').click(function () {
                $('#searchCategory').val('');
                $('#filterOrderType').val('');
                applyFilters();
            });

            // Update record count
            updateRecordCount();

            function loadOrderTypes() {
                $.ajax({
                    url: '@Url.Action("GetOrderTypes", "OrderTypes")',
                    type: 'GET',
                    success: function (data) {
                        var dropdown = $('#filterOrderType');
                        dropdown.empty();
                        dropdown.append('<option value="">All Order Types</option>');

                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                dropdown.append($('<option></option>').val(item.ID).text(item.OrderTypeName));
                            });
                        }
                    },
                    error: function () {
                        console.error('Failed to load order types');
                    }
                });
            }

            function loadOrderTypeNames() {
                $('.order-type-name').each(function () {
                    var cell = $(this);
                    var orderTypeId = cell.data('order-type-id');

                    if (orderTypeId) {
                        $.ajax({
                            url: '@Url.Action("GetOrderTypeName", "OrderTypes")' + '?id=' + orderTypeId,
                            type: 'GET',
                            success: function (data) {
                                cell.text(data || 'N/A');
                            },
                            error: function () {
                                cell.text('Error loading');
                            }
                        });
                    } else {
                        cell.text('N/A');
                    }
                });
            }

            function applyFilters() {
                var searchText = $('#searchCategory').val().toLowerCase();
                var orderTypeFilter = $('#filterOrderType').val();

                $('#tableBody tr').each(function () {
                    var row = $(this);
                    var categoryName = row.find('td:first').text().toLowerCase();
                    var orderTypeId = row.find('.order-type-name').data('order-type-id');

                    var showRow = true;

                    if (searchText && categoryName.indexOf(searchText) === -1) {
                        showRow = false;
                    }

                    if (orderTypeFilter && orderTypeId != orderTypeFilter) {
                        showRow = false;
                    }

                    row.toggle(showRow);
                });

                updateRecordCount();
            }

            function updateRecordCount() {
                var visibleCount = $('#tableBody tr:visible').length;
                var hasNoRecordsRow = $('#tableBody tr .no-records').length > 0;

                if (hasNoRecordsRow && visibleCount === 1) {
                    $('#recordCount').text('0 records');
                } else {
                    $('#recordCount').text(visibleCount + ' records');
                }
            }
        });
    </script>
</body>
</html>