@model HR_Application_CO_OP_HOS.Models.PaymentSubCategory

@{
    ViewBag.Title = "Delete Payment Sub Category";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Payment Sub Category</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        .container-fluid {
            padding: 20px;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px 30px;
            margin: -20px -20px 25px -20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.2rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 5px 0 0 0;
        }

        /* Card Styles */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            background: white;
        }

        .card-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            border-radius: 12px 12px 0 0 !important;
            padding: 20px 25px;
            font-weight: 600;
            font-size: 1.3rem;
        }

        .card-body {
            padding: 25px;
        }

        /* Warning Section */
        .warning-section {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 4px solid #e74c3c;
        }

        .warning-icon {
            color: #e74c3c;
            font-size: 2rem;
            margin-right: 15px;
        }

        .warning-title {
            color: #721c24;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .warning-text {
            color: #721c24;
            margin: 0;
        }

        /* Details Styles */
        .details-container {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .details-section {
            flex: 1;
            min-width: 300px;
        }

        .impact-section {
            flex: 1;
            min-width: 300px;
            background: #fff3cd;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #ffc107;
        }

        .detail-item {
            padding: 15px 0;
            border-bottom: 1px solid #ecf0f1;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
            font-size: 1.1rem;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.2rem;
        }

        .detail-id {
            background: #34495e;
            color: white;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.9rem;
        }

        /* Button Styles */
        .btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 25px;
        }

        .btn {
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Impact Section Styles */
        .impact-header {
            font-weight: 600;
            color: #856404;
            margin-bottom: 15px;
            font-size: 1.1rem;
            border-bottom: 2px solid #ffc107;
            padding-bottom: 8px;
        }

        .impact-item {
            padding: 10px 0;
            border-bottom: 1px solid #ffeaa7;
        }

        .impact-label {
            font-weight: 600;
            color: #856404;
        }

        .no-impact {
            text-align: center;
            padding: 20px;
            color: #856404;
            font-style: italic;
        }

        /* Confirmation Dialog */
        .confirmation-dialog {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .confirmation-content {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            max-width: 500px;
            width: 90%;
        }

        .confirmation-title {
            color: #e74c3c;
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 1.4rem;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 10px;
            }

            .page-header {
                padding: 20px;
                margin: -10px -10px 20px -10px;
            }

            .page-title {
                font-size: 1.8rem;
            }

            .card-body {
                padding: 15px;
            }

            .details-container {
                flex-direction: column;
            }

            .details-section, .impact-section {
                min-width: 100%;
            }

            .btn-group {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="page-title"><i class="fa fa-trash"></i> Delete Payment Sub Category</h1>
                    <p class="page-subtitle">Remove payment sub category from the system</p>
                </div>
                <div>
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="card">
            <div class="card-header">
                <i class="fa fa-exclamation-triangle"></i> Confirm Deletion - ID: @Model.ID
            </div>
            <div class="card-body">
                <!-- Warning Section -->
                <div class="warning-section d-flex align-items-start">
                    <div>
                        <i class="fa fa-warning warning-icon"></i>
                    </div>
                    <div>
                        <h4 class="warning-title">Warning: This action cannot be undone!</h4>
                        <p class="warning-text">
                            You are about to permanently delete this payment sub category. This action will remove all associated data and cannot be reversed. Please review the details below before proceeding.
                        </p>
                    </div>
                </div>

                <div class="details-container">
                    <!-- Details Section -->
                    <div class="details-section">
                        <h5 class="mb-4"><i class="fa fa-list-alt"></i> Payment Sub Category Details</h5>

                        <div class="detail-item">
                            <div class="detail-label">ID</div>
                            <div class="detail-value">
                                <span class="detail-id">@Model.ID</span>
                            </div>
                        </div>

                        <div class="detail-item">
                            <div class="detail-label">Category Name</div>
                            <div class="detail-value">@Model.CategoryName</div>
                        </div>

                        <div class="detail-item">
                            <div class="detail-label">Order Type ID</div>
                            <div class="detail-value">
                                @Model.OrderTypeID
                                <span id="orderTypeName" class="text-muted"></span>
                            </div>
                        </div>

                        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "deleteForm" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="btn-group">
                                <button type="button" class="btn btn-danger" id="btnDelete">
                                    <i class="fa fa-trash"></i> Delete
                                </button>
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                            </div>
                        }
                    </div>

                    <!-- Impact Analysis Section -->
                    <div class="impact-section">
                        <h5 class="impact-header"><i class="fa fa-exclamation-circle"></i> Impact Analysis</h5>
                        <div id="impactAnalysis">
                            <div class="impact-item">
                                <div class="impact-label">Related Records Check</div>
                                <div>
                                    <i class="fa fa-spinner fa-spin"></i> Analyzing dependencies...
                                </div>
                            </div>
                            <div class="impact-item">
                                <div class="impact-label">System Impact</div>
                                <div>This deletion may affect:</div>
                                <ul class="mt-2">
                                    <li>Payment categorizations</li>
                                    <li>Financial reports</li>
                                    <li>Order processing</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Dialog -->
    <div class="confirmation-dialog" id="confirmationDialog">
        <div class="confirmation-content">
            <h4 class="confirmation-title"><i class="fa fa-exclamation-circle"></i> Final Confirmation</h4>
            <p>Are you absolutely sure you want to delete the payment sub category "<strong>@Model.CategoryName</strong>" (ID: @Model.ID)?</p>
            <p class="text-danger"><small>This action cannot be undone.</small></p>
            <div class="btn-group mt-4">
                <button type="button" class="btn btn-secondary" id="btnCancelDelete">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete">
                    <i class="fa fa-trash"></i> Yes, Delete Permanently
                </button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            // Load order type name
            loadOrderTypeName();

            // Load impact analysis
            loadImpactAnalysis();

            // Delete button click handler
            $('#btnDelete').click(function () {
                $('#confirmationDialog').fadeIn();
            });

            // Cancel delete
            $('#btnCancelDelete').click(function () {
                $('#confirmationDialog').fadeOut();
            });

            // Confirm delete
            $('#btnConfirmDelete').click(function () {
                var btn = $(this);
                var originalText = btn.html();

                btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Deleting...');

                // Submit the form
                $('#deleteForm').submit();

                // Show loading state on main button too
                $('#btnDelete').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Deleting...');
            });

            // Close dialog when clicking outside
            $(document).on('click', function (e) {
                if ($(e.target).hasClass('confirmation-dialog')) {
                    $('#confirmationDialog').fadeOut();
                }
            });

            function loadOrderTypeName() {
                var orderTypeId = @Model.OrderTypeID;
                if (orderTypeId) {
                    $.ajax({
                        url: '@Url.Action("GetOrderTypeName", "OrderTypes")' + '?id=' + orderTypeId,
                        type: 'GET',
                        success: function (data) {
                            if (data) {
                                $('#orderTypeName').text('(' + data + ')');
                            }
                        },
                        error: function () {
                            $('#orderTypeName').text('(Error loading name)');
                        }
                    });
                }
            }

            function loadImpactAnalysis() {
                var paymentSubCategoryId = @Model.ID;

                $.ajax({
                    url: '@Url.Action("CheckDependencies", "PaymentSubCategories")' + '?id=' + paymentSubCategoryId,
                    type: 'GET',
                    success: function (data) {
                        var impactHtml = '';

                        if (data && data.hasDependencies) {
                            impactHtml += '<div class="impact-item">' +
                                '<div class="impact-label">Dependencies Found</div>' +
                                '<div class="text-danger">' +
                                '<i class="fa fa-exclamation-triangle"></i> ' + data.dependencyCount + ' related records found' +
                                '</div>' +
                                '<small class="text-muted">Deletion is not recommended due to existing dependencies.</small>' +
                                '</div>';
                        } else {
                            impactHtml += '<div class="impact-item">' +
                                '<div class="impact-label">Dependencies Check</div>' +
                                '<div class="text-success">' +
                                '<i class="fa fa-check-circle"></i> No critical dependencies found' +
                                '</div>' +
                                '</div>';
                        }

                        impactHtml += '<div class="impact-item">' +
                            '<div class="impact-label">System Impact</div>' +
                            '<div>This deletion may affect:</div>' +
                            '<ul class="mt-2">' +
                            '<li>Payment categorizations</li>' +
                            '<li>Financial reports</li>' +
                            '<li>Order processing</li>' +
                            '</ul>' +
                            '</div>';

                        $('#impactAnalysis').html(impactHtml);
                    },
                    error: function () {
                        $('#impactAnalysis').html(
                            '<div class="impact-item">' +
                            '<div class="impact-label">Dependencies Check</div>' +
                            '<div class="text-warning">' +
                            '<i class="fa fa-exclamation-triangle"></i> Unable to verify dependencies' +
                            '</div>' +
                            '<small class="text-muted">Proceed with caution.</small>' +
                            '</div>' +
                            '<div class="impact-item">' +
                            '<div class="impact-label">System Impact</div>' +
                            '<div>This deletion may affect:</div>' +
                            '<ul class="mt-2">' +
                            '<li>Payment categorizations</li>' +
                            '<li>Financial reports</li>' +
                            '<li>Order processing</li>' +
                            '</ul>' +
                            '</div>'
                        );
                    }
                });
            }

            // Add confirmation requirement for form submission
            $('#deleteForm').on('submit', function (e) {
                if (!confirm('Final confirmation: Are you sure you want to delete this payment sub category?')) {
                    e.preventDefault();
                    $('#btnDelete').prop('disabled', false).html('<i class="fa fa-trash"></i> Delete');
                    $('#btnConfirmDelete').prop('disabled', false).html('<i class="fa fa-trash"></i> Yes, Delete Permanently');
                }
            });
        });
    </script>
</body>
</html>