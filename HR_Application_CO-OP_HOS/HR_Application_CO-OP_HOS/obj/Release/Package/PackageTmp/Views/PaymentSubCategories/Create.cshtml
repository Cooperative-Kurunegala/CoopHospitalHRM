@model HR_Application_CO_OP_HOS.Models.PaymentSubCategory

@{
    ViewBag.Title = "Create Payment Sub Category";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Payment Sub Category</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        .container-fluid {
            padding: 20px;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px 30px;
            margin: -20px -20px 25px -20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.2rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 5px 0 0 0;
        }

        /* Card Styles */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            background: white;
        }

        .card-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            border-radius: 12px 12px 0 0 !important;
            padding: 20px 25px;
            font-weight: 600;
            font-size: 1.3rem;
        }

        .card-body {
            padding: 25px;
        }

        /* Form Styles */
        .form-container {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .form-section {
            flex: 1;
            min-width: 300px;
        }

        .reference-section {
            flex: 1;
            min-width: 300px;
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #3498db;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 2px solid #ecf0f1;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .field-validation-error {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            color: #721c24;
        }

        /* Button Styles */
        .btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Reference Data Styles */
        .reference-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .reference-item {
            padding: 12px 15px;
            border-bottom: 1px solid #e9ecef;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .reference-item:hover {
                background-color: #e3f2fd;
                border-left: 3px solid #3498db;
            }

            .reference-item.selected {
                background-color: #3498db;
                color: white;
            }

        .reference-header {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .reference-search {
            margin-bottom: 15px;
        }

        /* Loading States */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .spinner-border {
            width: 1rem;
            height: 1rem;
            margin-right: 8px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 10px;
            }

            .page-header {
                padding: 20px;
                margin: -10px -10px 20px -10px;
            }

            .page-title {
                font-size: 1.8rem;
            }

            .card-body {
                padding: 15px;
            }

            .form-container {
                flex-direction: column;
            }

            .form-section, .reference-section {
                min-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="page-title"><i class="fa fa-plus-circle"></i> Create Payment Sub Category</h1>
                    <p class="page-subtitle">Add a new payment sub category to the system</p>
                </div>
                <div>
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="card">
            <div class="card-header">
                <i class="fa fa-edit"></i> Payment Sub Category Details
            </div>
            <div class="card-body">
                @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "createForm" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="form-container">
                        <!-- Form Section -->
                        <div class="form-section">
                            <div class="form-group">
                                @Html.LabelFor(model => model.CategoryName, htmlAttributes: new { @class = "form-label" })
                                @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter category name" } })
                                @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "field-validation-error" })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.OrderTypeID, htmlAttributes: new { @class = "form-label" })
                                <div class="input-group">
                                    @Html.EditorFor(model => model.OrderTypeID, new { htmlAttributes = new { @class = "form-control", id = "OrderTypeID", placeholder = "Select order type" } })
                                    <button type="button" class="btn btn-outline-secondary" id="btnBrowseOrderTypes">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                                @Html.ValidationMessageFor(model => model.OrderTypeID, "", new { @class = "field-validation-error" })
                                <small class="form-text text-muted" id="selectedOrderTypeInfo"></small>
                            </div>

                            <div class="form-group">
                                <div class="btn-group">
                                    <button type="submit" class="btn btn-primary" id="btnSubmit">
                                        <i class="fa fa-save"></i> Create
                                    </button>
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                                </div>
                            </div>
                        </div>

                        <!-- Reference Data Section -->
                        <div class="reference-section">
                            <div class="reference-header">
                                <i class="fa fa-book"></i> Available Order Types
                            </div>
                            <div class="reference-search">
                                <input type="text" class="form-control" id="searchOrderTypes" placeholder="Search order types...">
                            </div>
                            <div class="reference-list" id="orderTypesList">
                                <div class="text-center text-muted">
                                    <i class="fa fa-spinner fa-spin"></i> Loading order types...
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            // Load order types for reference
            loadOrderTypes();

            // Search functionality for order types
            $('#searchOrderTypes').on('input', function () {
                var searchText = $(this).val().toLowerCase();
                $('#orderTypesList .reference-item').each(function () {
                    var itemText = $(this).text().toLowerCase();
                    $(this).toggle(itemText.indexOf(searchText) >= 0);
                });
            });

            // Order type selection
            $(document).on('click', '.reference-item', function () {
                $('.reference-item').removeClass('selected');
                $(this).addClass('selected');

                var orderTypeId = $(this).data('id');
                var orderTypeName = $(this).data('name');

                $('#OrderTypeID').val(orderTypeId);
                $('#selectedOrderTypeInfo').html('<strong>Selected:</strong> ' + orderTypeName + ' (ID: ' + orderTypeId + ')');
            });

            // Browse order types
            $('#btnBrowseOrderTypes').click(function () {
                var currentId = $('#OrderTypeID').val();
                if (currentId) {
                    var selectedItem = $('.reference-item[data-id="' + currentId + '"]');
                    if (selectedItem.length) {
                        $('.reference-list').animate({
                            scrollTop: selectedItem.offset().top - $('.reference-list').offset().top + $('.reference-list').scrollTop()
                        }, 500);

                        selectedItem.addClass('selected');
                    }
                }
            });

            // Form submission
            $('#createForm').on('submit', function () {
                $('#btnSubmit').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Creating...');
            });

            function loadOrderTypes() {
                $.ajax({
                    url: '@Url.Action("GetOrderTypes", "OrderTypes")',
                    type: 'GET',
                    success: function (data) {
                        var list = $('#orderTypesList');
                        list.empty();

                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                list.append(
                                    '<div class="reference-item" data-id="' + item.ID + '" data-name="' + item.OrderTypeName + '">' +
                                    '<strong>' + item.OrderTypeName + '</strong><br>' +
                                    '<small class="text-muted">ID: ' + item.ID + ' | Code: ' + (item.OrderTypeCode || 'N/A') + '</small>' +
                                    '</div>'
                                );
                            });
                        } else {
                            list.html('<div class="text-center text-muted">No order types found</div>');
                        }
                    },
                    error: function () {
                        $('#orderTypesList').html('<div class="text-center text-danger">Error loading order types</div>');
                    }
                });
            }

            // Input validation styling
            $('.form-control').on('blur', function () {
                validateField($(this));
            });

            function validateField(field) {
                var isValid = field.valid();
                if (field.val().trim() !== '') {
                    if (isValid) {
                        field.removeClass('is-invalid').addClass('is-valid');
                    } else {
                        field.removeClass('is-valid').addClass('is-invalid');
                    }
                } else {
                    field.removeClass('is-valid is-invalid');
                }
            }
        });
    </script>
</body>
</html>