@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartyRoleAndSplashScreenItemMapping>

@{
    ViewBag.Title = "Role & Splash Screen Mappings";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Role & Splash Screen Mappings</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            width: 100%;
            padding: 20px;
            margin: 0;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 20px -20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 0 10px 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 0;
        }

        /* Action Buttons */
        .action-buttons {
            margin: 20px 0;
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            font-size: 1rem;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-success {
            background: #27ae60;
            color: white;
        }

        .btn-warning {
            background: #f39c12;
            color: white;
        }

        .btn-danger {
            background: #e74c3c;
            color: white;
        }

        .btn-info {
            background: #17a2b8;
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Table Styles */
        .table-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 20px;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

            .table th {
                background: #34495e;
                color: white;
                padding: 20px;
                text-align: left;
                font-weight: 600;
                font-size: 1.1rem;
            }

            .table td {
                padding: 18px 20px;
                border-bottom: 1px solid #ecf0f1;
                font-size: 1rem;
            }

            .table tr:hover {
                background-color: #f8f9fa;
            }

            .table tr:last-child td {
                border-bottom: none;
            }

        /* Action Links */
        .action-links a {
            color: #3498db;
            text-decoration: none;
            margin: 0 8px;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            .action-links a:hover {
                color: #2980b9;
                text-decoration: underline;
            }

        /* Filter Section */
        .filter-section {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }

        .filter-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #2c3e50;
        }

        .filter-controls {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            align-items: end;
        }

        .filter-group {
            flex: 1;
            min-width: 200px;
        }

        .filter-label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #34495e;
        }

        .filter-input {
            width: 100%;
            padding: 10px;
            border: 2px solid #bdc3c7;
            border-radius: 6px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

            .filter-input:focus {
                border-color: #3498db;
                outline: none;
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
            font-size: 1.2rem;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container {
                padding: 10px;
            }

            .page-header {
                padding: 20px;
                margin: -10px -10px 15px -10px;
            }

            .page-title {
                font-size: 2rem;
            }

            .table-container {
                overflow-x: auto;
            }

            .table th,
            .table td {
                padding: 12px 15px;
                font-size: 0.9rem;
            }

            .filter-controls {
                flex-direction: column;
            }

            .filter-group {
                min-width: 100%;
            }
        }

        /* Loading State */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        /* Status Indicators */
        .status-active {
            color: #27ae60;
            font-weight: 600;
        }

        .status-inactive {
            color: #e74c3c;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-link"></i> Role & Splash Screen Mappings
            </h1>
            <p class="page-subtitle">Manage relationships between user roles and splash screen items</p>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fa fa-plus"></i> Create New Mapping
            </a>
            <a href="@Url.Action("Index", "RelatedPartyRoles")" class="btn btn-info">
                <i class="fa fa-users"></i> Manage Roles
            </a>
            <a href="@Url.Action("Index", "SplashScreenItems")" class="btn btn-success">
                <i class="fa fa-desktop"></i> Manage Splash Screens
            </a>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <h3 class="filter-title"><i class="fa fa-filter"></i> Filter Mappings</h3>
            <div class="filter-controls">
                <div class="filter-group">
                    <label class="filter-label">Role ID</label>
                    <input type="number" id="filterRoleId" class="filter-input" placeholder="Filter by Role ID...">
                </div>
                <div class="filter-group">
                    <label class="filter-label">Splash Screen ID</label>
                    <input type="number" id="filterSplashId" class="filter-input" placeholder="Filter by Splash Screen ID...">
                </div>
                <div class="filter-group">
                    <button id="applyFilters" class="btn btn-primary" style="margin-bottom: 0;">
                        <i class="fa fa-search"></i> Apply Filters
                    </button>
                    <button id="clearFilters" class="btn btn-warning" style="margin-bottom: 0;">
                        <i class="fa fa-times"></i> Clear
                    </button>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Role ID</th>
                        <th>Splash Screen ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ID</td>
                                <td>@item.RelatedPartyRoleID</td>
                                <td>@item.SplashScreenItemID</td>
                                <td class="action-links">
                                    @Html.ActionLink("Edit", "Edit", new { id = item.ID }) |
                                    @Html.ActionLink("Details", "Details", new { id = item.ID }) |
                                    @Html.ActionLink("Delete", "Delete", new { id = item.ID })
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="no-records">
                                <i class="fa fa-info-circle"></i> No records found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Back to Dashboard -->
        <div style="text-align: center; margin-top: 30px;">
            <a href="@Url.Action("Index", "Home")" class="btn btn-info">
                <i class="fa fa-dashboard"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <script>
        // Filter functionality
        document.addEventListener('DOMContentLoaded', function () {
            const applyFilters = document.getElementById('applyFilters');
            const clearFilters = document.getElementById('clearFilters');
            const filterRoleId = document.getElementById('filterRoleId');
            const filterSplashId = document.getElementById('filterSplashId');
            const tableRows = document.querySelectorAll('.table tbody tr');

            function filterTable() {
                const roleIdFilter = filterRoleId.value.toLowerCase();
                const splashIdFilter = filterSplashId.value.toLowerCase();

                tableRows.forEach(row => {
                    if (row.cells.length < 4) return;

                    const roleId = row.cells[1].textContent.toLowerCase();
                    const splashId = row.cells[2].textContent.toLowerCase();

                    const showRow =
                        (roleIdFilter === '' || roleId.includes(roleIdFilter)) &&
                        (splashIdFilter === '' || splashId.includes(splashIdFilter));

                    row.style.display = showRow ? '' : 'none';
                });
            }

            applyFilters.addEventListener('click', filterTable);

            clearFilters.addEventListener('click', function () {
                filterRoleId.value = '';
                filterSplashId.value = '';
                filterTable();
            });

            // Apply filters on Enter key
            [filterRoleId, filterSplashId].forEach(input => {
                input.addEventListener('keyup', function (event) {
                    if (event.key === 'Enter') {
                        filterTable();
                    }
                });
            });
        });

        // Error handling for AJAX calls (if needed in future)
        function handleAjaxError(xhr, status, error) {
            console.error('AJAX Error:', status, error);
            alert('An error occurred while processing your request. Please try again.');
        }
    </script>
</body>
</html>