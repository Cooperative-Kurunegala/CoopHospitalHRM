@model HR_Application_CO_OP_HOS.Models.RelatedPartyRoleAndSplashScreenItemMapping

@{
    ViewBag.Title = "Edit Mapping";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Mapping</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            width: 100%;
            padding: 20px;
            margin: 0;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 20px -20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 0 10px 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 0;
        }

        /* Form Container */
        .form-container {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-section {
            flex: 1;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .reference-section {
            flex: 1;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            max-height: 600px;
            overflow-y: auto;
        }

        .section-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 20px;
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        /* Form Styles */
        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #34495e;
            font-size: 1rem;
        }

        .form-control {
            width: 100%;
            padding: 12px;
            border: 2px solid #bdc3c7;
            border-radius: 6px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
                outline: none;
            }

        .validation-message {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
            display: block;
        }

        .validation-summary {
            background: #e74c3c;
            color: white;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .validation-summary-errors {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        /* Current Selection Display */
        .current-selection {
            background: #ecf0f1;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            border-left: 4px solid #3498db;
        }

        .selection-item {
            margin-bottom: 10px;
        }

        .selection-label {
            font-weight: 600;
            color: #2c3e50;
        }

        .selection-value {
            color: #34495e;
        }

        /* Buttons */
        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            font-size: 1rem;
            cursor: pointer;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-warning {
            background: #f39c12;
            color: white;
        }

        .btn-secondary {
            background: #95a5a6;
            color: white;
        }

        .btn-success {
            background: #27ae60;
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .form-actions {
            margin-top: 30px;
            text-align: center;
        }

        /* Reference Data */
        .reference-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .reference-item {
            padding: 15px;
            border: 1px solid #ecf0f1;
            border-radius: 6px;
            margin-bottom: 10px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .reference-item:hover {
                background: #f8f9fa;
                border-color: #3498db;
            }

            .reference-item.active {
                background: #3498db;
                color: white;
                border-color: #2980b9;
            }

        .reference-title {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .reference-details {
            font-size: 0.9rem;
            color: #7f8c8d;
        }

        .reference-item.active .reference-details {
            color: #ecf0f1;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container {
                padding: 10px;
            }

            .page-header {
                padding: 20px;
                margin: -10px -10px 15px -10px;
            }

            .page-title {
                font-size: 2rem;
            }

            .form-container {
                flex-direction: column;
            }

            .form-section,
            .reference-section {
                max-height: none;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-edit"></i> Edit Mapping
            </h1>
            <p class="page-subtitle">Update the relationship between user roles and splash screen items</p>
        </div>

        <!-- Main Content -->
        <div class="form-container">
            <!-- Form Section -->
            <div class="form-section">
                <h3 class="section-title">Edit Mapping Details</h3>

                <!-- Current Selection -->
                <div class="current-selection">
                    <h4 style="margin-top: 0; color: #2c3e50;">
                        <i class="fa fa-info-circle"></i> Current Mapping
                    </h4>
                    <div class="selection-item">
                        <span class="selection-label">Mapping ID:</span>
                        <span class="selection-value">@Model.ID</span>
                    </div>
                    <div class="selection-item">
                        <span class="selection-label">Current Role ID:</span>
                        <span class="selection-value">@Model.RelatedPartyRoleID</span>
                    </div>
                    <div class="selection-item">
                        <span class="selection-label">Current Splash Screen ID:</span>
                        <span class="selection-value">@Model.SplashScreenItemID</span>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

                    <div class="form-group">
                        @Html.LabelFor(model => model.RelatedPartyRoleID, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.RelatedPartyRoleID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Role ID" } })
                        @Html.ValidationMessageFor(model => model.RelatedPartyRoleID, "", new { @class = "validation-message" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.SplashScreenItemID, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.SplashScreenItemID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Splash Screen ID" } })
                        @Html.ValidationMessageFor(model => model.SplashScreenItemID, "", new { @class = "validation-message" })
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-success" style="margin-right: 10px;">
                            <i class="fa fa-check"></i> Save Changes
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fa fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                }
            </div>

            <!-- Reference Data Section -->
            <div class="reference-section">
                <h3 class="section-title">Available Roles & Splash Screens</h3>

                <div style="margin-bottom: 20px;">
                    <h4 style="color: #2c3e50; margin-bottom: 10px;">
                        <i class="fa fa-users"></i> User Roles
                    </h4>
                    <div id="rolesList" class="reference-list">
                        <!-- Roles will be populated by JavaScript -->
                        <div class="no-records">Loading roles...</div>
                    </div>
                </div>

                <div>
                    <h4 style="color: #2c3e50; margin-bottom: 10px;">
                        <i class="fa fa-desktop"></i> Splash Screen Items
                    </h4>
                    <div id="splashScreensList" class="reference-list">
                        <!-- Splash screens will be populated by JavaScript -->
                        <div class="no-records">Loading splash screens...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div style="text-align: center; margin-top: 20px;">
            <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-primary" style="margin-right: 10px;">
                <i class="fa fa-eye"></i> View Details
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-warning">
                <i class="fa fa-dashboard"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Set current selections
            const currentRoleId = @Model.RelatedPartyRoleID;
            const currentScreenId = @Model.SplashScreenItemID;

            // Simulate loading reference data
            setTimeout(() => {
                loadReferenceData(currentRoleId, currentScreenId);
            }, 1000);

            function loadReferenceData(currentRoleId, currentScreenId) {
                // Sample roles data (replace with actual data from your database)
                const sampleRoles = [
                    { id: 1, name: "Administrator", description: "Full system access" },
                    { id: 2, name: "Manager", description: "Department management access" },
                    { id: 3, name: "User", description: "Standard user access" },
                    { id: 4, name: "Viewer", description: "Read-only access" },
                    { id: 5, name: "Supervisor", description: "Team supervision access" }
                ];

                // Sample splash screens data
                const sampleSplashScreens = [
                    { id: 1, name: "Main Dashboard", description: "Primary system dashboard" },
                    { id: 2, name: "HR Portal", description: "Human resources management" },
                    { id: 3, name: "Finance Portal", description: "Financial management system" },
                    { id: 4, name: "Patient Portal", description: "Patient management interface" },
                    { id: 5, name: "Admin Portal", description: "Administrative functions" }
                ];

                displayRoles(sampleRoles, currentRoleId);
                displaySplashScreens(sampleSplashScreens, currentScreenId);
            }

            function displayRoles(roles, currentRoleId) {
                const container = document.getElementById('rolesList');
                if (roles.length === 0) {
                    container.innerHTML = '<div class="no-records">No roles found</div>';
                    return;
                }

                container.innerHTML = roles.map(role => `
                    <div class="reference-item ${role.id === currentRoleId ? 'active' : ''}"
                         onclick="selectRole(${role.id}, '${role.name}')">
                        <div class="reference-title">${role.name} (ID: ${role.id})</div>
                        <div class="reference-details">${role.description}</div>
                    </div>
                `).join('');
            }

            function displaySplashScreens(screens, currentScreenId) {
                const container = document.getElementById('splashScreensList');
                if (screens.length === 0) {
                    container.innerHTML = '<div class="no-records">No splash screens found</div>';
                    return;
                }

                container.innerHTML = screens.map(screen => `
                    <div class="reference-item ${screen.id === currentScreenId ? 'active' : ''}"
                         onclick="selectSplashScreen(${screen.id}, '${screen.name}')">
                        <div class="reference-title">${screen.name} (ID: ${screen.id})</div>
                        <div class="reference-details">${screen.description}</div>
                    </div>
                `).join('');
            }
        });

        // Global functions for selection
        function selectRole(roleId, roleName) {
            document.querySelector('input[name="RelatedPartyRoleID"]').value = roleId;
            highlightSelectedItem('rolesList', roleId);
            showNotification(`Selected role: ${roleName} (ID: ${roleId})`);
        }

        function selectSplashScreen(screenId, screenName) {
            document.querySelector('input[name="SplashScreenItemID"]').value = screenId;
            highlightSelectedItem('splashScreensList', screenId);
            showNotification(`Selected splash screen: ${screenName} (ID: ${screenId})`);
        }

        function highlightSelectedItem(containerId, itemId) {
            const container = document.getElementById(containerId);
            const items = container.querySelectorAll('.reference-item');
            items.forEach(item => item.classList.remove('active'));

            const selectedItem = Array.from(items).find(item =>
                item.textContent.includes(`ID: ${itemId}`)
            );
            if (selectedItem) {
                selectedItem.classList.add('active');
            }
        }

        function showNotification(message) {
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: #27ae60;
                color: white;
                padding: 15px 20px;
                border-radius: 6px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                z-index: 1000;
                font-weight: 600;
            `;
            notification.textContent = message;
            document.body.appendChild(notification);

            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Form validation enhancement
        document.querySelector('form').addEventListener('submit', function (e) {
            const roleId = document.querySelector('input[name="RelatedPartyRoleID"]').value;
            const screenId = document.querySelector('input[name="SplashScreenItemID"]').value;

            if (!roleId || !screenId) {
                e.preventDefault();
                alert('Please select both a role and a splash screen before submitting.');
                return;
            }

            // Show loading state
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving...';
            submitBtn.disabled = true;
        });
    </script>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>