@model HR_Application_CO_OP_HOS.Models.RelatedPartyRoleAndSplashScreenItemMapping

@{
    ViewBag.Title = "Delete Mapping";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Mapping</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            width: 100%;
            padding: 20px;
            margin: 0;
            max-width: 800px;
            margin: 0 auto;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 20px -20px;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            text-align: center;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 0 10px 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 0;
        }

        /* Warning Section */
        .warning-section {
            background: #fff3cd;
            border: 2px solid #ffeaa7;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            text-align: center;
        }

        .warning-icon {
            font-size: 3rem;
            color: #f39c12;
            margin-bottom: 15px;
        }

        .warning-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #e67e22;
            margin-bottom: 10px;
        }

        .warning-message {
            color: #d35400;
            font-size: 1.1rem;
            line-height: 1.5;
        }

        /* Details Section */
        .details-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .section-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 20px;
            color: #2c3e50;
            border-bottom: 2px solid #e74c3c;
            padding-bottom: 10px;
        }

        /* Details Display */
        .details-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .detail-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #e74c3c;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1rem;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.1rem;
            font-weight: 500;
        }

        /* Reference Data */
        .reference-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .reference-card {
            background: #ecf0f1;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .reference-header {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

        .reference-details {
            color: #34495e;
        }

        .reference-item {
            margin-bottom: 8px;
        }

        .no-reference {
            text-align: center;
            color: #7f8c8d;
            font-style: italic;
            padding: 20px;
        }

        /* Buttons */
        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            font-size: 1rem;
            cursor: pointer;
            margin: 0 10px;
        }

        .btn-danger {
            background: #e74c3c;
            color: white;
        }

            .btn-danger:hover {
                background: #c0392b;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.3);
            }

        .btn-secondary {
            background: #95a5a6;
            color: white;
        }

            .btn-secondary:hover {
                background: #7f8c8d;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .btn-info {
            background: #3498db;
            color: white;
        }

            .btn-info:hover {
                background: #2980b9;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
            }

        .form-actions {
            text-align: center;
            margin-top: 30px;
        }

        /* Confirmation Dialog */
        .confirmation-dialog {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            text-align: center;
            border: 2px solid #e74c3c;
        }

        .confirmation-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #e74c3c;
            margin-bottom: 15px;
        }

        .confirmation-message {
            color: #34495e;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container {
                padding: 10px;
            }

            .page-header {
                padding: 20px;
                margin: -10px -10px 15px -10px;
            }

            .page-title {
                font-size: 2rem;
            }

            .detail-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 5px;
            }

            .form-actions {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .btn {
                margin: 5px 0;
                width: 100%;
            }
        }

        /* Loading State */
        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

            .loading::after {
                content: ' Loading...';
                font-style: italic;
            }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-trash"></i> Delete Mapping
            </h1>
            <p class="page-subtitle">Remove a relationship between user roles and splash screen items</p>
        </div>

        <!-- Warning Section -->
        <div class="warning-section">
            <div class="warning-icon">
                <i class="fa fa-exclamation-triangle"></i>
            </div>
            <h2 class="warning-title">Warning: Irreversible Action</h2>
            <p class="warning-message">
                You are about to permanently delete this mapping. This action cannot be undone and may affect user access to certain system features.
            </p>
        </div>

        <!-- Confirmation Dialog -->
        <div class="confirmation-dialog">
            <h3 class="confirmation-title">Confirm Deletion</h3>
            <p class="confirmation-message">
                Are you sure you want to delete the mapping between Role ID <strong>@Model.RelatedPartyRoleID</strong>
                and Splash Screen ID <strong>@Model.SplashScreenItemID</strong>?
            </p>
        </div>

        <!-- Details Section -->
        <div class="details-section">
            <h3 class="section-title">Mapping Details to be Deleted</h3>

            <div class="details-grid">
                <div class="detail-item">
                    <span class="detail-label">Mapping ID:</span>
                    <span class="detail-value">@Model.ID</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Role ID:</span>
                    <span class="detail-value">@Model.RelatedPartyRoleID</span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Splash Screen ID:</span>
                    <span class="detail-value">@Model.SplashScreenItemID</span>
                </div>
            </div>
        </div>

        <!-- Reference Data Section -->
        <div class="reference-section">
            <h3 class="section-title">Related Information</h3>

            <div id="roleReference" class="reference-card">
                <div class="reference-header">
                    <i class="fa fa-users"></i> Role Information
                </div>
                <div id="roleDetails" class="reference-details">
                    Loading role details...
                </div>
            </div>

            <div id="splashReference" class="reference-card">
                <div class="reference-header">
                    <i class="fa fa-desktop"></i> Splash Screen Information
                </div>
                <div id="splashDetails" class="reference-details">
                    Loading splash screen details...
                </div>
            </div>
        </div>

        <!-- Delete Form -->
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ID)

            <div class="form-actions">
                <button type="submit" class="btn btn-danger" id="deleteButton">
                    <i class="fa fa-trash"></i> Confirm Delete
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Cancel
                </a>
                <a href="@Url.Action("Details", new { id = Model.ID })" class="btn btn-info">
                    <i class="fa fa-eye"></i> View Details
                </a>
            </div>
        }

        <!-- Additional Warning -->
        <div style="text-align: center; margin-top: 20px; color: #7f8c8d; font-size: 0.9rem;">
            <i class="fa fa-info-circle"></i>
            Note: This action will permanently remove the mapping from the system.
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Simulate loading reference data based on current IDs
            const roleId = @Model.RelatedPartyRoleID;
            const screenId = @Model.SplashScreenItemID;

            setTimeout(() => {
                loadReferenceData(roleId, screenId);
            }, 1000);

            function loadReferenceData(roleId, screenId) {
                // Sample roles data (replace with actual data from your database)
                const sampleRoles = {
                    1: { name: "Administrator", description: "Full system access", userCount: 5 },
                    2: { name: "Manager", description: "Department management access", userCount: 12 },
                    3: { name: "User", description: "Standard user access", userCount: 150 },
                    4: { name: "Viewer", description: "Read-only access", userCount: 25 },
                    5: { name: "Supervisor", description: "Team supervision access", userCount: 8 }
                };

                // Sample splash screens data
                const sampleSplashScreens = {
                    1: { name: "Main Dashboard", description: "Primary system dashboard", activeUsers: 180 },
                    2: { name: "HR Portal", description: "Human resources management", activeUsers: 45 },
                    3: { name: "Finance Portal", description: "Financial management system", activeUsers: 22 },
                    4: { name: "Patient Portal", description: "Patient management interface", activeUsers: 320 },
                    5: { name: "Admin Portal", description: "Administrative functions", activeUsers: 8 }
                };

                displayRoleDetails(roleId, sampleRoles[roleId]);
                displaySplashDetails(screenId, sampleSplashScreens[screenId]);
            }

            function displayRoleDetails(roleId, roleData) {
                const container = document.getElementById('roleDetails');

                if (!roleData) {
                    container.innerHTML = `
                        <div class="no-reference">
                            <i class="fa fa-exclamation-triangle"></i><br>
                            Role with ID ${roleId} not found.<br>
                            <small>This role may have been deleted.</small>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = `
                    <div class="reference-item">
                        <strong>Role Name:</strong> ${roleData.name}
                    </div>
                    <div class="reference-item">
                        <strong>Description:</strong> ${roleData.description}
                    </div>
                    <div class="reference-item">
                        <strong>Users with this role:</strong> ${roleData.userCount}
                    </div>
                `;
            }

            function displaySplashDetails(screenId, screenData) {
                const container = document.getElementById('splashDetails');

                if (!screenData) {
                    container.innerHTML = `
                        <div class="no-reference">
                            <i class="fa fa-exclamation-triangle"></i><br>
                            Splash screen with ID ${screenId} not found.<br>
                            <small>This splash screen may have been deleted.</small>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = `
                    <div class="reference-item">
                        <strong>Screen Name:</strong> ${screenData.name}
                    </div>
                    <div class="reference-item">
                        <strong>Description:</strong> ${screenData.description}
                    </div>
                    <div class="reference-item">
                        <strong>Active Users:</strong> ${screenData.activeUsers}
                    </div>
                `;
            }

            // Enhanced delete confirmation
            const deleteButton = document.getElementById('deleteButton');
            const form = document.querySelector('form');

            deleteButton.addEventListener('click', function (e) {
                if (!confirm('⚠️ FINAL WARNING: This action is permanent and cannot be undone!\n\nAre you absolutely sure you want to delete this mapping?')) {
                    e.preventDefault();
                    return;
                }

                // Show loading state
                deleteButton.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Deleting...';
                deleteButton.disabled = true;

                // Disable other buttons
                const otherButtons = form.querySelectorAll('.btn:not(#deleteButton)');
                otherButtons.forEach(btn => {
                    btn.style.opacity = '0.6';
                    btn.style.pointerEvents = 'none';
                });
            });

            // Prevent form resubmission
            if (window.history.replaceState) {
                window.history.replaceState(null, null, window.location.href);
            }
        });

        // Global error handling
        window.addEventListener('error', function (e) {
            console.error('Error:', e.error);
            const deleteButton = document.getElementById('deleteButton');
            if (deleteButton) {
                deleteButton.innerHTML = '<i class="fa fa-trash"></i> Delete (Error - Try Again)';
                deleteButton.disabled = false;
            }
        });
    </script>

    @Scripts.Render("~/bundles/jquery")
</body>
</html>