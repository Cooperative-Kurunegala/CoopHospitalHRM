@model HR_Application_CO_OP_HOS.Models.RelatedPartyRoleAndSplashScreenItemMapping

@{
    ViewBag.Title = "Mapping Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Mapping Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            width: 100%;
            padding: 20px;
            margin: 0;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin: -20px -20px 20px -20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 0 10px 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 0;
        }

        /* Details Container */
        .details-container {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .details-section {
            flex: 1;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .reference-section {
            flex: 1;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .section-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 20px;
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        /* Details Display */
        .details-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .detail-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #3498db;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 1rem;
        }

        .detail-value {
            color: #34495e;
            font-size: 1.1rem;
            font-weight: 500;
        }

        /* Reference Data */
        .reference-card {
            background: #ecf0f1;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 4px solid #e74c3c;
        }

        .reference-header {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

        .reference-details {
            color: #34495e;
        }

        .reference-item {
            margin-bottom: 8px;
        }

        .no-reference {
            text-align: center;
            color: #7f8c8d;
            font-style: italic;
            padding: 20px;
        }

        /* Buttons */
        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            font-size: 1rem;
            cursor: pointer;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-warning {
            background: #f39c12;
            color: white;
        }

        .btn-info {
            background: #17a2b8;
            color: white;
        }

        .btn-secondary {
            background: #95a5a6;
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .action-buttons {
            margin-top: 30px;
            text-align: center;
        }

        /* Status Indicators */
        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .container {
                padding: 10px;
            }

            .page-header {
                padding: 20px;
                margin: -10px -10px 15px -10px;
            }

            .page-title {
                font-size: 2rem;
            }

            .details-container {
                flex-direction: column;
            }

            .detail-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 5px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-eye"></i> Mapping Details
            </h1>
            <p class="page-subtitle">View detailed information about the role and splash screen mapping</p>
        </div>

        <!-- Main Content -->
        <div class="details-container">
            <!-- Details Section -->
            <div class="details-section">
                <h3 class="section-title">Mapping Information</h3>

                <div class="details-grid">
                    <div class="detail-item">
                        <span class="detail-label">Mapping ID:</span>
                        <span class="detail-value">@Model.ID</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Role ID:</span>
                        <span class="detail-value">@Model.RelatedPartyRoleID</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Splash Screen ID:</span>
                        <span class="detail-value">@Model.SplashScreenItemID</span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Status:</span>
                        <span class="detail-value status-badge status-active">Active</span>
                    </div>
                </div>

                <div class="action-buttons">
                    <a href="@Url.Action("Edit", new { id = Model.ID })" class="btn btn-warning" style="margin-right: 10px;">
                        <i class="fa fa-edit"></i> Edit Mapping
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>

            <!-- Reference Data Section -->
            <div class="reference-section">
                <h3 class="section-title">Related Information</h3>

                <div id="roleReference" class="reference-card">
                    <div class="reference-header">
                        <i class="fa fa-users"></i> Role Information
                    </div>
                    <div id="roleDetails" class="reference-details">
                        Loading role details...
                    </div>
                </div>

                <div id="splashReference" class="reference-card">
                    <div class="reference-header">
                        <i class="fa fa-desktop"></i> Splash Screen Information
                    </div>
                    <div id="splashDetails" class="reference-details">
                        Loading splash screen details...
                    </div>
                </div>

                <div class="quick-links">
                    <h4 style="color: #2c3e50; margin-bottom: 15px;">
                        <i class="fa fa-external-link"></i> Quick Links
                    </h4>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <a href="@Url.Action("Index", "RelatedPartyRoles")" class="btn btn-info btn-sm">
                            <i class="fa fa-users"></i> All Roles
                        </a>
                        <a href="@Url.Action("Index", "SplashScreenItems")" class="btn btn-success btn-sm">
                            <i class="fa fa-desktop"></i> All Splash Screens
                        </a>
                        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                            <i class="fa fa-plus"></i> New Mapping
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Actions -->
        <div style="text-align: center; margin-top: 20px;">
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                <i class="fa fa-dashboard"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Simulate loading reference data based on current IDs
            const roleId = @Model.RelatedPartyRoleID;
            const screenId = @Model.SplashScreenItemID;

            setTimeout(() => {
                loadReferenceData(roleId, screenId);
            }, 1000);

            function loadReferenceData(roleId, screenId) {
                // Sample roles data (replace with actual data from your database)
                const sampleRoles = {
                    1: { name: "Administrator", description: "Full system access", permissions: "All permissions" },
                    2: { name: "Manager", description: "Department management access", permissions: "Department management" },
                    3: { name: "User", description: "Standard user access", permissions: "Basic access" },
                    4: { name: "Viewer", description: "Read-only access", permissions: "View only" },
                    5: { name: "Supervisor", description: "Team supervision access", permissions: "Team management" }
                };

                // Sample splash screens data
                const sampleSplashScreens = {
                    1: { name: "Main Dashboard", description: "Primary system dashboard", type: "System", accessLevel: "All" },
                    2: { name: "HR Portal", description: "Human resources management", type: "HR", accessLevel: "HR Staff" },
                    3: { name: "Finance Portal", description: "Financial management system", type: "Finance", accessLevel: "Finance Staff" },
                    4: { name: "Patient Portal", description: "Patient management interface", type: "Medical", accessLevel: "Medical Staff" },
                    5: { name: "Admin Portal", description: "Administrative functions", type: "Admin", accessLevel: "Administrators" }
                };

                displayRoleDetails(roleId, sampleRoles[roleId]);
                displaySplashDetails(screenId, sampleSplashScreens[screenId]);
            }

            function displayRoleDetails(roleId, roleData) {
                const container = document.getElementById('roleDetails');

                if (!roleData) {
                    container.innerHTML = `
                        <div class="no-reference">
                            <i class="fa fa-exclamation-triangle"></i><br>
                            Role with ID ${roleId} not found in the system.<br>
                            <small>This role may have been deleted or the ID might be incorrect.</small>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = `
                    <div class="reference-item">
                        <strong>Role Name:</strong> ${roleData.name}
                    </div>
                    <div class="reference-item">
                        <strong>Description:</strong> ${roleData.description}
                    </div>
                    <div class="reference-item">
                        <strong>Permissions:</strong> ${roleData.permissions}
                    </div>
                    <div class="reference-item">
                        <strong>Role ID:</strong> ${roleId}
                    </div>
                `;
            }

            function displaySplashDetails(screenId, screenData) {
                const container = document.getElementById('splashDetails');

                if (!screenData) {
                    container.innerHTML = `
                        <div class="no-reference">
                            <i class="fa fa-exclamation-triangle"></i><br>
                            Splash screen with ID ${screenId} not found in the system.<br>
                            <small>This splash screen may have been deleted or the ID might be incorrect.</small>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = `
                    <div class="reference-item">
                        <strong>Screen Name:</strong> ${screenData.name}
                    </div>
                    <div class="reference-item">
                        <strong>Description:</strong> ${screenData.description}
                    </div>
                    <div class="reference-item">
                        <strong>Type:</strong> ${screenData.type}
                    </div>
                    <div class="reference-item">
                        <strong>Access Level:</strong> ${screenData.accessLevel}
                    </div>
                    <div class="reference-item">
                        <strong>Screen ID:</strong> ${screenId}
                    </div>
                `;
            }
        });

        // Error handling for any JavaScript errors
        window.addEventListener('error', function (e) {
            console.error('JavaScript Error:', e.error);
            // You could show a user-friendly error message here
        });
    </script>
</body>
</html>