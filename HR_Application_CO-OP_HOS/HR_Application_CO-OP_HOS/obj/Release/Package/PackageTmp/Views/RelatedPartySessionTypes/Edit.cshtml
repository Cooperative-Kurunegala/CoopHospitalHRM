@model HR_Application_CO_OP_HOS.Models.RelatedPartySessionType

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Session Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Form Container */
        .form-container {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .form-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            border-bottom: 2px solid #f39c12;
            padding-bottom: 15px;
        }

        .form-group label {
            font-weight: 600;
            color: #34495e;
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #f39c12;
                box-shadow: 0 0 0 0.2rem rgba(243, 156, 18, 0.25);
            }

        .btn-update {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
        }

            .btn-update:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: inline-block;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
                color: white;
                text-decoration: none;
            }

        .btn-details {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: inline-block;
        }

            .btn-details:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
                color: white;
                text-decoration: none;
            }

        /* Reference Section */
        .reference-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .reference-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .foreign-key-helper {
            background: #f8f9fa;
            border-left: 4px solid #3498db;
            padding: 15px;
            margin: 10px 0;
            border-radius: 0 8px 8px 0;
        }

            .foreign-key-helper h6 {
                color: #2c3e50;
                margin-bottom: 8px;
                font-weight: 600;
            }

        .fk-item {
            background: white;
            padding: 10px 15px;
            margin: 8px 0;
            border-radius: 8px;
            border: 1px solid #ecf0f1;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: between;
            align-items: center;
        }

            .fk-item:hover {
                background: #3498db;
                color: white;
                transform: translateX(5px);
            }

            .fk-item i {
                margin-right: 10px;
                opacity: 0.7;
            }

        /* Record Info */
        .record-info {
            background: #e8f4fd;
            border: 1px solid #3498db;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

            .record-info h6 {
                color: #2c3e50;
                margin-bottom: 15px;
                font-weight: 600;
            }

        .info-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid #d6eaf8;
        }

            .info-item:last-child {
                border-bottom: none;
                margin-bottom: 0;
            }

        .info-label {
            font-weight: 600;
            color: #34495e;
        }

        .info-value {
            color: #2c3e50;
        }

        /* Validation Styles */
        .field-validation-error {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            color: #721c24;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 20px;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .form-container {
                padding: 20px;
            }
        }

        /* Loading Animation */
        .spinner {
            border: 2px solid #f3f3f3;
            border-top: 2px solid #f39c12;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
            display: inline-block;
            margin-right: 8px;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .change-indicator {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 6px;
            padding: 10px 15px;
            margin-bottom: 15px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-edit"></i> Edit Session Type
            </h1>
            <p class="page-subtitle">Update session type information</p>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <div class="col-md-8">
                    <!-- Form Container -->
                    <div class="form-container">
                        <div class="form-header">
                            <i class="fa fa-pencil"></i> Edit Session Type Details
                        </div>

                        <!-- Change Indicator -->
                        <div class="change-indicator" id="changeIndicator">
                            <i class="fa fa-info-circle text-warning"></i>
                            <span>You have unsaved changes</span>
                        </div>

                        <!-- Record Information -->
                        <div class="record-info">
                            <h6><i class="fa fa-info-circle"></i> Record Information</h6>
                            <div class="info-item">
                                <span class="info-label">Record ID:</span>
                                <span class="info-value badge badge-secondary">#@Model.ID</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Current Name:</span>
                                <span class="info-value">@Model.RelatedPartySessionTypeName</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Status:</span>
                                <span class="info-value badge badge-success">Active</span>
                            </div>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ID)

                            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                            <div class="form-group">
                                @Html.LabelFor(model => model.RelatedPartySessionTypeName, "Session Type Name", new { @class = "control-label" })
                                @Html.EditorFor(model => model.RelatedPartySessionTypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter session type name" } })
                                @Html.ValidationMessageFor(model => model.RelatedPartySessionTypeName, "", new { @class = "field-validation-error" })
                                <small class="form-text text-muted">Update the session type name as needed.</small>
                            </div>

                            <div class="form-group mt-4">
                                <div class="row">
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-update btn-block" id="submitButton">
                                            <i class="fa fa-save"></i> Update
                                        </button>
                                    </div>
                                    <div class="col-md-4">
                                        @Html.ActionLink("Details", "Details", new { id = Model.ID }, new { @class = "btn-details btn-block text-center" })
                                    </div>
                                    <div class="col-md-4">
                                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn-cancel btn-block text-center" })
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Reference Section -->
                    <div class="reference-section">
                        <div class="reference-header">
                            <i class="fa fa-lightbulb-o"></i> Quick Templates
                        </div>

                        <div class="foreign-key-helper">
                            <h6>Common Session Types</h6>
                            <div class="fk-item" onclick="setSessionType('Consultation')">
                                <i class="fa fa-stethoscope"></i>
                                <span>Consultation</span>
                            </div>
                            <div class="fk-item" onclick="setSessionType('Therapy Session')">
                                <i class="fa fa-heartbeat"></i>
                                <span>Therapy Session</span>
                            </div>
                            <div class="fk-item" onclick="setSessionType('Assessment')">
                                <i class="fa fa-clipboard"></i>
                                <span>Assessment</span>
                            </div>
                            <div class="fk-item" onclick="setSessionType('Follow-up')">
                                <i class="fa fa-calendar-check-o"></i>
                                <span>Follow-up</span>
                            </div>
                        </div>
                    </div>

                    <!-- Change History -->
                    <div class="reference-section">
                        <div class="reference-header">
                            <i class="fa fa-history"></i> Change History
                        </div>
                        <div class="foreign-key-helper">
                            <div class="fk-item" style="cursor: default; background: #e8f4fd;">
                                <i class="fa fa-edit text-primary"></i>
                                <span>Editing now</span>
                                <small class="text-muted ml-2">@DateTime.Now.ToString("MMM dd, HH:mm")</small>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #f8f9fa;">
                                <i class="fa fa-file-text-o"></i>
                                <span>Record created</span>
                                <small class="text-muted ml-2">Initial</small>
                            </div>
                        </div>
                    </div>

                    <!-- Danger Zone -->
                    <div class="reference-section" style="border-left: 4px solid #e74c3c;">
                        <div class="reference-header" style="border-bottom-color: #e74c3c;">
                            <i class="fa fa-exclamation-triangle"></i> Danger Zone
                        </div>
                        <div class="foreign-key-helper">
                            <p class="text-muted small mb-3">Be careful with these actions</p>
                            @Html.ActionLink("Delete This Type", "Delete", new { id = Model.ID }, new
                            {
                                @class = "btn btn-outline-danger btn-sm btn-block",
                                onclick = "return confirm('Are you sure you want to delete this session type? This action cannot be undone.');"
                            })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            const originalName = '@Model.RelatedPartySessionTypeName';
            const nameField = $('#RelatedPartySessionTypeName');
            const changeIndicator = $('#changeIndicator');
            const submitButton = $('#submitButton');

            // Track changes
            function checkForChanges() {
                const currentName = nameField.val();
                const hasChanges = currentName !== originalName;

                if (hasChanges) {
                    changeIndicator.show();
                    submitButton.html('<i class="fa fa-save"></i> Save Changes');
                } else {
                    changeIndicator.hide();
                    submitButton.html('<i class="fa fa-save"></i> Update');
                }

                return hasChanges;
            }

            // Check changes on input
            nameField.on('input', checkForChanges);

            // Form submission handling
            $('form').submit(function (e) {
                if (!checkForChanges()) {
                    e.preventDefault();
                    showMessage('No changes detected to save.', 'info');
                    return;
                }

                const originalText = submitButton.html();
                submitButton.html('<span class="spinner"></span> Saving...').prop('disabled', true);

                // Re-enable after 5 seconds if still disabled (fallback)
                setTimeout(() => {
                    if (submitButton.prop('disabled')) {
                        submitButton.html(originalText).prop('disabled', false);
                        showMessage('Save operation is taking longer than expected.', 'warning');
                    }
                }, 5000);
            });

            // Set focus to field
            nameField.focus();
        });

        function setSessionType(name) {
            $('#RelatedPartySessionTypeName').val(name).focus();
            showMessage(`"${name}" template applied`, 'success', 2000);
        }

        function showMessage(message, type, duration = 5000) {
            const alertClass = type === 'error' ? 'alert-danger' :
                type === 'warning' ? 'alert-warning' :
                    type === 'info' ? 'alert-info' : 'alert-success';

            const alert = $(`<div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                ${message}
            </div>`);

            $('.form-container').prepend(alert);

            setTimeout(() => {
                alert.alert('close');
            }, duration);
        }

        // Handle unsaved changes
        window.addEventListener('beforeunload', function (e) {
            const currentName = $('#RelatedPartySessionTypeName').val();
            if (currentName !== '@Model.RelatedPartySessionTypeName') {
                e.preventDefault();
                e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
            }
        });

        // Error handling
        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            console.error('AJAX Error:', thrownError);
            showMessage('An error occurred while processing your request. Please try again.', 'error');
        });
    </script>
</body>
</html>