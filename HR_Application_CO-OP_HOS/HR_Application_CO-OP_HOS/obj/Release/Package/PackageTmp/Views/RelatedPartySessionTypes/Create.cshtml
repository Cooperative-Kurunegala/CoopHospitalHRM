@model HR_Application_CO_OP_HOS.Models.RelatedPartySessionType

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Session Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Form Container */
        .form-container {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .form-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            border-bottom: 2px solid #27ae60;
            padding-bottom: 15px;
        }

        .form-group label {
            font-weight: 600;
            color: #34495e;
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #27ae60;
                box-shadow: 0 0 0 0.2rem rgba(39, 174, 96, 0.25);
            }

        .btn-create {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        .btn-cancel {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: inline-block;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
                color: white;
                text-decoration: none;
            }

        /* Reference Section */
        .reference-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .reference-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .foreign-key-helper {
            background: #f8f9fa;
            border-left: 4px solid #3498db;
            padding: 15px;
            margin: 10px 0;
            border-radius: 0 8px 8px 0;
        }

            .foreign-key-helper h6 {
                color: #2c3e50;
                margin-bottom: 8px;
                font-weight: 600;
            }

        .fk-item {
            background: white;
            padding: 10px 15px;
            margin: 8px 0;
            border-radius: 8px;
            border: 1px solid #ecf0f1;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: between;
            align-items: center;
        }

            .fk-item:hover {
                background: #3498db;
                color: white;
                transform: translateX(5px);
            }

            .fk-item i {
                margin-right: 10px;
                opacity: 0.7;
            }

        /* Validation Styles */
        .field-validation-error {
            color: #e74c3c;
            font-size: 0.9rem;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            color: #721c24;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 20px;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .form-container {
                padding: 20px;
            }
        }

        /* Loading Animation */
        .spinner {
            border: 2px solid #f3f3f3;
            border-top: 2px solid #27ae60;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
            display: inline-block;
            margin-right: 8px;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-plus-circle"></i> Create Session Type
            </h1>
            <p class="page-subtitle">Add a new session type to the system</p>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <div class="col-md-8">
                    <!-- Form Container -->
                    <div class="form-container">
                        <div class="form-header">
                            <i class="fa fa-edit"></i> Session Type Details
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                            <div class="form-group">
                                @Html.LabelFor(model => model.RelatedPartySessionTypeName, "Session Type Name", new { @class = "control-label" })
                                @Html.EditorFor(model => model.RelatedPartySessionTypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter session type name (e.g., Consultation, Therapy, Assessment)" } })
                                @Html.ValidationMessageFor(model => model.RelatedPartySessionTypeName, "", new { @class = "field-validation-error" })
                                <small class="form-text text-muted">Enter a descriptive name for the session type. This will be used throughout the system.</small>
                            </div>

                            <div class="form-group mt-4">
                                <div class="row">
                                    <div class="col-md-6">
                                        <button type="submit" class="btn btn-create btn-block" id="submitButton">
                                            <i class="fa fa-save"></i> Create Session Type
                                        </button>
                                    </div>
                                    <div class="col-md-6">
                                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn-cancel btn-block text-center" })
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Reference Section -->
                    <div class="reference-section">
                        <div class="reference-header">
                            <i class="fa fa-lightbulb-o"></i> Quick Reference
                        </div>

                        <div class="foreign-key-helper">
                            <h6>Common Session Types</h6>
                            <div class="fk-item" onclick="setSessionType('Consultation')">
                                <i class="fa fa-stethoscope"></i>
                                <span>Consultation</span>
                            </div>
                            <div class="fk-item" onclick="setSessionType('Therapy Session')">
                                <i class="fa fa-heartbeat"></i>
                                <span>Therapy Session</span>
                            </div>
                            <div class="fk-item" onclick="setSessionType('Assessment')">
                                <i class="fa fa-clipboard"></i>
                                <span>Assessment</span>
                            </div>
                            <div class="fk-item" onclick="setSessionType('Follow-up')">
                                <i class="fa fa-calendar-check-o"></i>
                                <span>Follow-up</span>
                            </div>
                            <div class="fk-item" onclick="setSessionType('Group Therapy')">
                                <i class="fa fa-users"></i>
                                <span>Group Therapy</span>
                            </div>
                            <div class="fk-item" onclick="setSessionType('Initial Evaluation')">
                                <i class="fa fa-file-text-o"></i>
                                <span>Initial Evaluation</span>
                            </div>
                        </div>

                        <div class="foreign-key-helper mt-4">
                            <h6>Naming Guidelines</h6>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-check text-success"></i>
                                <span>Use clear, descriptive names</span>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-check text-success"></i>
                                <span>Keep it under 50 characters</span>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-check text-success"></i>
                                <span>Avoid special characters</span>
                            </div>
                        </div>
                    </div>

                    <!-- System Information -->
                    <div class="reference-section">
                        <div class="reference-header">
                            <i class="fa fa-info-circle"></i> System Information
                        </div>
                        <div class="foreign-key-helper">
                            <h6>Current Status</h6>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-database text-info"></i>
                                <span>New Record</span>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-clock-o text-info"></i>
                                <span>Created: @DateTime.Now.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-user text-info"></i>
                                <span>By: System User</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            // Set focus to first field
            $('#RelatedPartySessionTypeName').focus();

            // Form submission handling
            $('form').submit(function (e) {
                const submitButton = $('#submitButton');
                const originalText = submitButton.html();

                // Show loading state
                submitButton.html('<span class="spinner"></span> Creating...').prop('disabled', true);

                // Re-enable after 5 seconds if still disabled (fallback)
                setTimeout(() => {
                    if (submitButton.prop('disabled')) {
                        submitButton.html(originalText).prop('disabled', false);
                        showMessage('Submission taking longer than expected. Please check your connection.', 'warning');
                    }
                }, 5000);
            });

            // Auto-save draft
            let draftTimer;
            $('#RelatedPartySessionTypeName').on('input', function () {
                clearTimeout(draftTimer);
                draftTimer = setTimeout(() => {
                    const value = $(this).val();
                    if (value.trim() !== '') {
                        localStorage.setItem('sessionTypeDraft', value);
                        showMessage('Draft saved automatically', 'info', 2000);
                    }
                }, 1000);
            });

            // Load draft if exists
            const draft = localStorage.getItem('sessionTypeDraft');
            if (draft) {
                $('#RelatedPartySessionTypeName').val(draft);
                showMessage('Draft restored from previous session', 'info', 3000);
            }

            // Clear draft on successful form submission
            $('form').on('submit', function () {
                localStorage.removeItem('sessionTypeDraft');
            });
        });

        function setSessionType(name) {
            $('#RelatedPartySessionTypeName').val(name).focus();
            showMessage(`"${name}" template applied`, 'success', 2000);
        }

        function showMessage(message, type, duration = 5000) {
            const alertClass = type === 'error' ? 'alert-danger' :
                type === 'warning' ? 'alert-warning' :
                    type === 'info' ? 'alert-info' : 'alert-success';

            const alert = $(`<div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    ${message}
                </div>`);

            $('.form-container').prepend(alert);

            setTimeout(() => {
                alert.alert('close');
            }, duration);
        }

        // Handle unsaved changes
        window.addEventListener('beforeunload', function (e) {
            const nameValue = $('#RelatedPartySessionTypeName').val();
            if (nameValue && nameValue.trim() !== '') {
                e.preventDefault();
                e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
            }
        });

        // Error handling
        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            console.error('AJAX Error:', thrownError);
            showMessage('An error occurred while processing your request. Please try again.', 'error');
        });
    </script>
</body>
</html>