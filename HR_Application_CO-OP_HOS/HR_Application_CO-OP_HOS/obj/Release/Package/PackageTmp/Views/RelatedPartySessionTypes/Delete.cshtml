@model HR_Application_CO_OP_HOS.Models.RelatedPartySessionType

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Session Type</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Warning Container */
        .warning-container {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            border-left: 6px solid #e74c3c;
        }

        .warning-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            border-bottom: 2px solid #e74c3c;
            padding-bottom: 15px;
        }

        .warning-content {
            background: #fdf2f2;
            border: 1px solid #f5c6cb;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .warning-icon {
            text-align: center;
            margin-bottom: 20px;
        }

            .warning-icon i {
                font-size: 4rem;
                color: #e74c3c;
            }

        .warning-text h4 {
            color: #c0392b;
            margin-bottom: 15px;
            text-align: center;
        }

        .warning-text p {
            color: #721c24;
            text-align: center;
            margin-bottom: 0;
        }

        /* Item to Delete */
        .item-to-delete {
            background: #f8f9fa;
            border: 2px solid #e74c3c;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .item-header {
            background: #e74c3c;
            color: white;
            padding: 15px 20px;
            margin: -25px -25px 20px -25px;
            border-radius: 8px 8px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .item-header h5 {
                margin: 0;
                font-weight: 600;
            }

        .item-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #e9ecef;
        }

            .detail-row:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #34495e;
        }

        .detail-value {
            color: #2c3e50;
        }

        /* Impact Analysis */
        .impact-analysis {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

            .impact-analysis h5 {
                color: #856404;
                margin-bottom: 15px;
                font-weight: 600;
            }

        .impact-items {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .impact-item {
            display: flex;
            align-items: flex-start;
            padding: 12px 15px;
            background: white;
            border-radius: 6px;
            border-left: 4px solid #f39c12;
        }

            .impact-item i {
                margin-right: 12px;
                color: #f39c12;
                margin-top: 2px;
            }

        .impact-content strong {
            display: block;
            margin-bottom: 5px;
            color: #2c3e50;
        }

        .impact-content span {
            color: #7f8c8d;
            font-size: 0.9rem;
        }

        /* Confirmation Section */
        .confirmation-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .confirmation-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #e74c3c;
            padding-bottom: 10px;
        }

        .form-group label {
            font-weight: 600;
            color: #34495e;
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #e74c3c;
                box-shadow: 0 0 0 0.2rem rgba(231, 76, 60, 0.25);
            }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            width: 100%;
        }

            .btn-delete:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
            }

            .btn-delete:disabled {
                background: #95a5a6;
                cursor: not-allowed;
            }

        .btn-cancel {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: block;
            text-align: center;
            margin-top: 15px;
        }

            .btn-cancel:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
                color: white;
                text-decoration: none;
            }

        /* Reference Section */
        .reference-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .reference-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .foreign-key-helper {
            background: #f8f9fa;
            border-left: 4px solid #3498db;
            padding: 15px;
            margin: 10px 0;
            border-radius: 0 8px 8px 0;
        }

            .foreign-key-helper h6 {
                color: #2c3e50;
                margin-bottom: 8px;
                font-weight: 600;
            }

        .fk-item {
            background: white;
            padding: 10px 15px;
            margin: 8px 0;
            border-radius: 8px;
            border: 1px solid #ecf0f1;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

            .fk-item i {
                margin-right: 10px;
                color: #3498db;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .warning-container {
                padding: 20px;
            }

            .item-details {
                grid-template-columns: 1fr;
            }

            .impact-item {
                flex-direction: column;
                align-items: flex-start;
            }

                .impact-item i {
                    margin-bottom: 8px;
                }
        }

        /* Loading Animation */
        .spinner {
            border: 2px solid #f3f3f3;
            border-top: 2px solid #e74c3c;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
            display: inline-block;
            margin-right: 8px;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-trash"></i> Delete Session Type
            </h1>
            <p class="page-subtitle">Remove a session type from the system</p>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <div class="col-md-8">
                    <!-- Warning Container -->
                    <div class="warning-container">
                        <div class="warning-header">
                            <i class="fa fa-exclamation-triangle"></i> Confirm Deletion
                        </div>

                        <div class="warning-content">
                            <div class="warning-icon">
                                <i class="fa fa-exclamation-circle"></i>
                            </div>
                            <div class="warning-text">
                                <h4>Warning: This action cannot be undone!</h4>
                                <p>You are about to permanently delete this session type. This action will remove all associated data and cannot be reversed.</p>
                            </div>
                        </div>

                        <!-- Item to Delete -->
                        <div class="item-to-delete">
                            <div class="item-header">
                                <h5><i class="fa fa-tag"></i> Session Type to be Deleted</h5>
                                <span class="badge badge-light">ID: @Model.ID</span>
                            </div>
                            <div class="item-details">
                                <div class="detail-row">
                                    <span class="detail-label">Session Type Name:</span>
                                    <span class="detail-value"><strong>@Model.RelatedPartySessionTypeName</strong></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Type:</span>
                                    <span class="detail-value">Related Party Session Type</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Status:</span>
                                    <span class="detail-value"><span class="badge badge-success">Active</span></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Created:</span>
                                    <span class="detail-value">System Default</span>
                                </div>
                            </div>
                        </div>

                        <!-- Impact Analysis -->
                        <div class="impact-analysis">
                            <h5><i class="fa fa-line-chart"></i> Impact Analysis</h5>
                            <div class="impact-items">
                                <div class="impact-item">
                                    <i class="fa fa-exclamation-triangle"></i>
                                    <div class="impact-content">
                                        <strong>Data Loss</strong>
                                        <span>All references to this session type will be removed</span>
                                    </div>
                                </div>
                                <div class="impact-item">
                                    <i class="fa fa-database"></i>
                                    <div class="impact-content">
                                        <strong>System Integrity</strong>
                                        <span>May affect historical reports and analytics</span>
                                    </div>
                                </div>
                                <div class="impact-item">
                                    <i class="fa fa-chain-broken"></i>
                                    <div class="impact-content">
                                        <strong>Dependencies</strong>
                                        <span>Check for existing sessions using this type</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <!-- Confirmation Section -->
                            <div class="confirmation-section">
                                <div class="confirmation-header">
                                    <i class="fa fa-keyboard-o"></i> Final Confirmation
                                </div>

                                <div class="form-group">
                                    <label for="confirmationText">
                                        <i class="fa fa-shield"></i> Type "DELETE" to confirm
                                    </label>
                                    <input type="text" id="confirmationText" class="form-control"
                                           placeholder="Type DELETE here" onkeyup="validateConfirmation()">
                                    <small class="form-text text-muted">This extra step prevents accidental deletions</small>
                                </div>

                                <button type="submit" id="deleteButton" class="btn-delete" disabled>
                                    <i class="fa fa-trash"></i> Permanently Delete Session Type
                                </button>

                                @Html.ActionLink("Cancel Deletion", "Index", null, new { @class = "btn-cancel" })
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Safety Check -->
                    <div class="reference-section">
                        <div class="reference-header">
                            <i class="fa fa-shield"></i> Safety Check
                        </div>
                        <div class="foreign-key-helper">
                            <h6>Before you delete, consider:</h6>
                            <div class="fk-item" style="cursor: default; background: #fff3cd;">
                                <i class="fa fa-question-circle text-warning"></i>
                                <span>Are there any active sessions using this type?</span>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #fff3cd;">
                                <i class="fa fa-question-circle text-warning"></i>
                                <span>Have you backed up important data?</span>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #fff3cd;">
                                <i class="fa fa-question-circle text-warning"></i>
                                <span>Is there an alternative to deletion?</span>
                            </div>
                        </div>
                    </div>

                    <!-- Alternative Actions -->
                    <div class="reference-section">
                        <div class="reference-header">
                            <i class="fa fa-random"></i> Alternatives to Deletion
                        </div>
                        <div class="foreign-key-helper">
                            <div class="fk-item" onclick="location.href='@Url.Action("Edit", new { id = Model.ID })'">
                                <i class="fa fa-edit text-info"></i>
                                <span>Edit Instead</span>
                            </div>
                            <div class="fk-item" onclick="location.href='@Url.Action("Details", new { id = Model.ID })'">
                                <i class="fa fa-eye text-success"></i>
                                <span>View Details</span>
                            </div>
                            <div class="fk-item" onclick="location.href='@Url.Action("Index")'">
                                <i class="fa fa-list text-primary"></i>
                                <span>Back to List</span>
                            </div>
                        </div>
                    </div>

                    <!-- Recovery Options -->
                    <div class="reference-section">
                        <div class="reference-header">
                            <i class="fa fa-life-ring"></i> Recovery Options
                        </div>
                        <div class="foreign-key-helper">
                            <h6>If deleted accidentally:</h6>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-database text-success"></i>
                                <span>Contact System Administrator</span>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-history text-success"></i>
                                <span>Use database backup</span>
                            </div>
                            <div class="fk-item" style="cursor: default; background: #e8f6f3;">
                                <i class="fa fa-file-text-o text-success"></i>
                                <span>Check audit logs</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        function validateConfirmation() {
            const confirmationText = document.getElementById('confirmationText').value;
            const deleteButton = document.getElementById('deleteButton');

            if (confirmationText.toUpperCase() === 'DELETE') {
                deleteButton.disabled = false;
                deleteButton.innerHTML = '<i class="fa fa-trash"></i> Confirm Permanent Deletion';
            } else {
                deleteButton.disabled = true;
                deleteButton.innerHTML = '<i class="fa fa-trash"></i> Permanently Delete Session Type';
            }
        }

        $(document).ready(function () {
            // Form submission handling
            $('form').submit(function (e) {
                const confirmationText = $('#confirmationText').val();

                if (confirmationText.toUpperCase() !== 'DELETE') {
                    e.preventDefault();
                    showMessage('Please type "DELETE" to confirm deletion', 'error');
                    return;
                }

                // Additional confirmation
                if (!confirm('Are you absolutely sure? This action cannot be undone!')) {
                    e.preventDefault();
                    return;
                }

                // Show loading state
                const deleteBtn = $('#deleteButton');
                const originalText = deleteBtn.html();
                deleteBtn.html('<span class="spinner"></span> Deleting...').prop('disabled', true);

                // Fallback in case form doesn't submit
                setTimeout(() => {
                    if (deleteBtn.prop('disabled')) {
                        deleteBtn.html(originalText).prop('disabled', false);
                        showMessage('Deletion is taking longer than expected. Please try again.', 'warning');
                    }
                }, 5000);
            });

            // Prevent accidental navigation
            let formChanged = false;
            $('#confirmationText').on('input', function () {
                formChanged = true;
            });

            window.addEventListener('beforeunload', function (e) {
                if (formChanged) {
                    e.preventDefault();
                    e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
                }
            });
        });

        function showMessage(message, type, duration = 5000) {
            const alertClass = type === 'error' ? 'alert-danger' :
                type === 'warning' ? 'alert-warning' :
                    type === 'info' ? 'alert-info' : 'alert-success';

            const alert = $(`<div class="alert ${alertClass} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 1000;">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    ${message}
                </div>`);

            $('body').append(alert);

            setTimeout(() => {
                alert.alert('close');
            }, duration);
        }

        // Error handling
        window.onerror = function (msg, url, lineNo, columnNo, error) {
            console.error('Error:', msg, '\nURL:', url, '\nLine:', lineNo);
            showMessage('An error occurred. Please try again.', 'error');
            return false;
        };
    </script>
</body>
</html>