@model HR_Application_CO_OP_HOS.Models.RelatedPartySessionType

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Session Type Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Details Container */
        .details-container {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .details-header {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 15px;
        }

        /* Detail Cards */
        .detail-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 20px;
            border-left: 4px solid #3498db;
        }

        .detail-card-primary {
            border-left-color: #3498db;
        }

        .detail-card-secondary {
            border-left-color: #95a5a6;
        }

        .detail-card h5 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .detail-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #e9ecef;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #34495e;
            flex: 1;
        }

        .detail-value {
            color: #2c3e50;
            flex: 2;
            text-align: right;
        }

        /* Action Buttons */
        .action-buttons {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .btn-edit {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: inline-block;
            margin: 5px;
        }

            .btn-edit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(243, 156, 18, 0.4);
                color: white;
                text-decoration: none;
            }

        .btn-back {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: inline-block;
            margin: 5px;
        }

            .btn-back:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
                color: white;
                text-decoration: none;
            }

        .btn-delete {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: inline-block;
            margin: 5px;
        }

            .btn-delete:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
                color: white;
                text-decoration: none;
            }

        /* Stats Section */
        .stats-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .stats-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #27ae60;
            padding-bottom: 10px;
        }

        .stat-card {
            text-align: center;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            margin: 10px 0;
            border-top: 4px solid #27ae60;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #27ae60;
            margin: 10px 0;
        }

        .stat-label {
            color: #7f8c8d;
            font-weight: 600;
        }

        /* Reference Section */
        .reference-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
        }

        .reference-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #9b59b6;
            padding-bottom: 10px;
        }

        .foreign-key-helper {
            background: #f8f9fa;
            border-left: 4px solid #9b59b6;
            padding: 15px;
            margin: 10px 0;
            border-radius: 0 8px 8px 0;
        }

            .foreign-key-helper h6 {
                color: #2c3e50;
                margin-bottom: 8px;
                font-weight: 600;
            }

        .fk-item {
            background: white;
            padding: 10px 15px;
            margin: 8px 0;
            border-radius: 8px;
            border: 1px solid #ecf0f1;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

            .fk-item i {
                margin-right: 10px;
                color: #9b59b6;
            }

        /* Badge Styles */
        .session-badge {
            background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
            color: white;
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .details-container {
                padding: 20px;
            }

            .detail-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .detail-value {
                text-align: left;
                margin-top: 5px;
            }

            .action-buttons .btn {
                display: block;
                width: 100%;
                margin: 10px 0;
            }
        }

        /* Print Styles */
        @@media print {
            .action-buttons, .reference-section {
                display: none !important;
            }

            .details-container, .stats-section {
                box-shadow: none !important;
                border: 1px solid #000 !important;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-eye"></i> Session Type Details
            </h1>
            <p class="page-subtitle">View detailed information about this session type</p>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="row">
                <div class="col-md-8">
                    <!-- Details Container -->
                    <div class="details-container">
                        <div class="details-header">
                            <i class="fa fa-info-circle"></i> Session Type Information
                        </div>

                        <!-- Primary Details -->
                        <div class="detail-card detail-card-primary">
                            <h5><i class="fa fa-tag"></i> Basic Information</h5>
                            <div class="detail-item">
                                <span class="detail-label">Session Type ID</span>
                                <span class="detail-value">
                                    <span class="session-badge">#@Model.ID</span>
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Session Type Name</span>
                                <span class="detail-value">
                                    <strong>@Html.DisplayFor(model => model.RelatedPartySessionTypeName)</strong>
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Status</span>
                                <span class="detail-value">
                                    <span class="badge badge-success">Active</span>
                                </span>
                            </div>
                        </div>

                        <!-- System Information -->
                        <div class="detail-card detail-card-secondary">
                            <h5><i class="fa fa-cog"></i> System Information</h5>
                            <div class="detail-item">
                                <span class="detail-label">Record Type</span>
                                <span class="detail-value">Related Party Session Type</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Created Date</span>
                                <span class="detail-value">System Default</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Last Modified</span>
                                <span class="detail-value">@DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons text-center">
                        @Html.ActionLink("Edit Session Type", "Edit", new { id = Model.ID }, new { @class = "btn-edit" })
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn-back" })
                        @Html.ActionLink("Delete", "Delete", new { id = Model.ID }, new { @class = "btn-delete" })
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Statistics Section -->
                    <div class="stats-section">
                        <div class="stats-header">
                            <i class="fa fa-bar-chart"></i> Usage Statistics
                        </div>
                        <div class="stat-card">
                            <i class="fa fa-calendar-check-o fa-2x text-success"></i>
                            <div class="stat-number">0</div>
                            <div class="stat-label">Total Sessions</div>
                        </div>
                        <div class="stat-card">
                            <i class="fa fa-users fa-2x text-primary"></i>
                            <div class="stat-number">0</div>
                            <div class="stat-label">Active Parties</div>
                        </div>
                        <div class="stat-card">
                            <i class="fa fa-line-chart fa-2x text-warning"></i>
                            <div class="stat-number">0%</div>
                            <div class="stat-label">Usage Rate</div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="stats-section">
                        <div class="stats-header">
                            <i class="fa fa-rocket"></i> Quick Actions
                        </div>
                        <div class="foreign-key-helper">
                            <div class="fk-item" onclick="location.href='@Url.Action("Create", "RelatedPartySessions")'">
                                <i class="fa fa-plus-circle"></i>
                                <span>Create New Session</span>
                            </div>
                            <div class="fk-item" onclick="location.href='@Url.Action("Index", "RelatedPartySessions")'">
                                <i class="fa fa-list"></i>
                                <span>View All Sessions</span>
                            </div>
                            <div class="fk-item" onclick="location.href='@Url.Action("Index", "RelatedPartySessionTypes")'">
                                <i class="fa fa-cogs"></i>
                                <span>Manage Session Types</span>
                            </div>
                        </div>
                    </div>

                    <!-- Export Options -->
                    <div class="reference-section">
                        <div class="reference-header">
                            <i class="fa fa-download"></i> Export Options
                        </div>
                        <div class="foreign-key-helper">
                            <div class="fk-item" onclick="exportToPDF()">
                                <i class="fa fa-file-pdf-o"></i>
                                <span>Export as PDF</span>
                            </div>
                            <div class="fk-item" onclick="exportToExcel()">
                                <i class="fa fa-file-excel-o"></i>
                                <span>Export as Excel</span>
                            </div>
                            <div class="fk-item" onclick="window.print()">
                                <i class="fa fa-print"></i>
                                <span>Print Details</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Add loading states to buttons
            $('.btn-edit, .btn-back, .btn-delete').click(function (e) {
                const btn = $(this);
                const originalText = btn.html();

                if (!btn.hasClass('disabled')) {
                    btn.html('<i class="fa fa-spinner fa-spin"></i> Loading...').addClass('disabled');

                    // Revert after 2 seconds if still on same page
                    setTimeout(() => {
                        if (btn.hasClass('disabled')) {
                            btn.html(originalText).removeClass('disabled');
                        }
                    }, 2000);
                }
            });

            // Enhance detail cards with hover effects
            $('.detail-card').hover(
                function () {
                    $(this).css('transform', 'translateY(-2px)');
                },
                function () {
                    $(this).css('transform', 'translateY(0)');
                }
            );
        });

        function exportToPDF() {
            showMessage('PDF export feature would be implemented here', 'info');
        }

        function exportToExcel() {
            showMessage('Excel export feature would be implemented here', 'info');
        }

        function showMessage(message, type, duration = 4000) {
            const alertClass = type === 'error' ? 'alert-danger' :
                type === 'warning' ? 'alert-warning' :
                    type === 'info' ? 'alert-info' : 'alert-success';

            const alert = $(`<div class="alert ${alertClass} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 1000;">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    ${message}
                </div>`);

            $('body').append(alert);

            setTimeout(() => {
                alert.alert('close');
            }, duration);
        }

        // Error handling
        window.onerror = function (msg, url, lineNo, columnNo, error) {
            console.error('Error:', msg, '\nURL:', url, '\nLine:', lineNo);
            showMessage('An error occurred. Please try again.', 'error');
            return false;
        };

        // Handle AJAX errors
        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            console.error('AJAX Error:', thrownError);
            showMessage('An error occurred while processing your request. Please try again.', 'error');
        });
    </script>
</body>
</html>