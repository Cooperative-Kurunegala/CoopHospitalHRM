@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartySessionType>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Related Party Session Types</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Full Screen Layout */
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container-fluid {
            padding: 0;
            margin: 0;
            width: 100%;
        }

        /* Header Styles */
        .page-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            margin-bottom: 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin: 10px 0 0 0;
        }

        /* Main Content */
        .main-content {
            padding: 30px;
        }

        /* Action Bar */
        .action-bar {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .btn-create {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: inline-block;
        }

            .btn-create:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
                color: white;
                text-decoration: none;
            }

        /* Filter Section */
        .filter-section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .filter-header {
            font-size: 1.3rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 20px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
        }

        .form-group label {
            font-weight: 600;
            color: #34495e;
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 10px 15px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .btn-filter {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            padding: 10px 20px;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: white;
        }

            .btn-filter:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
                color: white;
            }

        /* Data Container */
        .data-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .table-header {
            background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
            color: white;
            padding: 20px;
        }

            .table-header h3 {
                margin: 0;
                font-size: 1.5rem;
                font-weight: 600;
            }

        /* Modern Table */
        .modern-table {
            width: 100%;
            border-collapse: collapse;
        }

            .modern-table th {
                background: #ecf0f1;
                color: #2c3e50;
                font-weight: 600;
                padding: 15px;
                text-align: left;
                border-bottom: 2px solid #bdc3c7;
                font-size: 1rem;
            }

            .modern-table td {
                padding: 15px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: middle;
                font-size: 0.95rem;
            }

            .modern-table tbody tr {
                transition: all 0.3s ease;
            }

                .modern-table tbody tr:hover {
                    background: #f8f9fa;
                    transform: translateX(5px);
                }

        /* Action Links */
        .action-links a {
            padding: 6px 12px;
            margin: 2px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            font-size: 0.9rem;
            display: inline-block;
        }

        .btn-edit {
            background: #f39c12;
            color: white;
        }

            .btn-edit:hover {
                background: #e67e22;
                color: white;
                transform: translateY(-1px);
                text-decoration: none;
            }

        .btn-details {
            background: #3498db;
            color: white;
        }

            .btn-details:hover {
                background: #2980b9;
                color: white;
                transform: translateY(-1px);
                text-decoration: none;
            }

        .btn-delete {
            background: #e74c3c;
            color: white;
        }

            .btn-delete:hover {
                background: #c0392b;
                color: white;
                transform: translateY(-1px);
                text-decoration: none;
            }

        /* No Records */
        .no-records {
            text-align: center;
            padding: 60px 20px;
            color: #7f8c8d;
        }

            .no-records i {
                font-size: 4rem;
                margin-bottom: 20px;
                color: #bdc3c7;
            }

            .no-records h4 {
                font-size: 1.5rem;
                margin-bottom: 10px;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .main-content {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 2rem;
            }

            .modern-table {
                display: block;
                overflow-x: auto;
            }

            .action-links {
                white-space: nowrap;
            }
        }

        /* Foreign Key Helper */
        .foreign-key-helper {
            background: #f8f9fa;
            border-left: 4px solid #3498db;
            padding: 15px;
            margin: 10px 0;
            border-radius: 0 8px 8px 0;
        }

            .foreign-key-helper h6 {
                color: #2c3e50;
                margin-bottom: 8px;
                font-weight: 600;
            }

        .fk-item {
            background: white;
            padding: 8px 12px;
            margin: 5px 0;
            border-radius: 6px;
            border: 1px solid #ecf0f1;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .fk-item:hover {
                background: #3498db;
                color: white;
                transform: translateX(5px);
            }

        /* Tooltip */
        .tooltip-info {
            cursor: help;
            color: #3498db;
            margin-left: 5px;
        }

        .session-type-badge {
            background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa fa-tags"></i> Related Party Session Types
            </h1>
            <p class="page-subtitle">Manage and view all session type configurations</p>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Action Bar -->
            <div class="action-bar">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h4 style="margin: 0; color: #2c3e50;">
                            <i class="fa fa-list-alt"></i> Session Type Management
                        </h4>
                    </div>
                    <div class="col-md-6 text-right">
                        @Html.ActionLink("Create New Type", "Create", null, new { @class = "btn btn-create" })
                    </div>
                </div>
            </div>

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="filter-header">
                    <i class="fa fa-filter"></i> Filter Session Types
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="filterName">Session Type Name</label>
                            <input type="text" class="form-control" id="filterName" placeholder="Enter session type name">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <div class="d-flex gap-2">
                                <button class="btn btn-filter flex-grow-1" id="applyFilters">
                                    <i class="fa fa-search"></i> Apply Filters
                                </button>
                                <button class="btn btn-secondary flex-grow-1" id="clearFilters">
                                    <i class="fa fa-refresh"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Container -->
            <div class="data-container">
                <div class="table-header">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h3><i class="fa fa-table"></i> Session Types</h3>
                        </div>
                        <div class="col-md-6 text-right">
                            <span class="badge badge-light" id="recordCount">@Model.Count() records found</span>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    @if (Model.Any())
                    {
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Session Type Name</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="session-type-badge">#@item.ID</span>
                                        </td>
                                        <td>
                                            <strong>@Html.DisplayFor(modelItem => item.RelatedPartySessionTypeName)</strong>
                                        </td>
                                        <td>
                                            <span class="badge badge-success">Active</span>
                                        </td>
                                        <td class="action-links">
                                            @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn-edit" })
                                            @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn-details" })
                                            @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn-delete" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="no-records">
                            <i class="fa fa-tags"></i>
                            <h4>No Session Types Found</h4>
                            <p>There are no session type records in the database.</p>
                            @Html.ActionLink("Create First Session Type", "Create", null, new { @class = "btn btn-create" })
                        </div>
                    }
                </div>
            </div>

            <!-- Reference Data Section -->
            <div class="filter-section mt-4">
                <div class="filter-header">
                    <i class="fa fa-info-circle"></i> Quick Reference
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="foreign-key-helper">
                            <h6>Common Session Types <i class="fa fa-question-circle tooltip-info" title="Predefined session type examples"></i></h6>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="fk-item" onclick="setFilter('Consultation')">Consultation</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fk-item" onclick="setFilter('Therapy')">Therapy Session</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fk-item" onclick="setFilter('Assessment')">Assessment</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="fk-item" onclick="setFilter('Follow-up')">Follow-up</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            // Filter functionality
            $('#applyFilters').click(function () {
                applyTableFilters();
            });

            $('#clearFilters').click(function () {
                clearFilters();
            });

            // Enter key support for filters
            $('#filterName').keypress(function (e) {
                if (e.which === 13) {
                    applyTableFilters();
                }
            });

            function applyTableFilters() {
                const nameFilter = $('#filterName').val().toLowerCase();
                let visibleCount = 0;

                $('.modern-table tbody tr').each(function () {
                    const $row = $(this);
                    const name = $row.find('td:eq(1)').text().toLowerCase();

                    let showRow = true;

                    if (nameFilter && name.indexOf(nameFilter) === -1) {
                        showRow = false;
                    }

                    $row.toggle(showRow);

                    if (showRow) {
                        visibleCount++;
                    }
                });

                // Update record count
                $('#recordCount').text(visibleCount + ' records found');

                if (visibleCount === 0) {
                    $('.modern-table').hide();
                    $('.table-responsive').append(`
                        <div class="no-records">
                            <i class="fa fa-search"></i>
                            <h4>No Matching Records</h4>
                            <p>No session types match your filter criteria.</p>
                        </div>
                    `);
                } else {
                    $('.no-records').remove();
                    $('.modern-table').show();
                }
            }

            function clearFilters() {
                $('#filterName').val('');
                $('.modern-table tbody tr').show();
                $('.modern-table').show();
                $('.no-records').remove();
                $('#recordCount').text('@Model.Count() records found');
            }

            // Loading state for actions
            $('.action-links a').click(function (e) {
                const $link = $(this);
                const originalText = $link.html();
                $link.html('<i class="fa fa-spinner fa-spin"></i>').addClass('disabled');

                setTimeout(() => {
                    $link.html(originalText).removeClass('disabled');
                }, 1000);
            });

            // Responsive table enhancements
            function enhanceTableResponsive() {
                if ($(window).width() < 768) {
                    $('.modern-table th, .modern-table td').css('white-space', 'nowrap');
                }
            }

            $(window).resize(enhanceTableResponsive);
            enhanceTableResponsive();
        });

        function setFilter(value) {
            $('#filterName').val(value);
            $('#applyFilters').click();
        }

        // Error handling
        $(document).ajaxError(function (event, jqxhr, settings, thrownError) {
            console.error('Error:', thrownError);
            alert('An error occurred while processing your request. Please try again.');
        });
    </script>
</body>
</html>