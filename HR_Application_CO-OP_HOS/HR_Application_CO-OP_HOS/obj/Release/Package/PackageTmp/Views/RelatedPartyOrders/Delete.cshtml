﻿@model HR_Application_CO_OP_HOS.Models.RelatedPartyOrder

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Related Party Order</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .delete-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 0;
            margin-bottom: 30px;
            max-width: 900px;
            margin: 0 auto;
        }

        .delete-header {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 25px;
            border-radius: 12px 12px 0 0;
        }

        .delete-content {
            padding: 30px;
        }

        .warning-section {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .detail-group {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            border-left: 4px solid #3498db;
        }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .detail-value {
            color: #34495e;
            font-size: 16px;
            font-weight: 500;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(231, 76, 60, 0.4);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        .action-buttons {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid #ecf0f1;
        }

        @@media (max-width: 768px) {
            .delete-container {
                margin: 10px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .delete-content {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="delete-container">
            <div class="delete-header">
                <h2><i class="fa fa-exclamation-triangle"></i> Delete Related Party Order</h2>
                <p class="mb-0">Confirm deletion of this order record</p>
            </div>

            <div class="delete-content">
                <div class="warning-section">
                    <h4><i class="fa fa-warning"></i> Warning</h4>
                    <p class="mb-0">You are about to permanently delete this related party order. This action cannot be undone. Please review the details below before proceeding.</p>
                </div>

                <h4 class="mb-4">Order Details</h4>

                <div class="details-grid">
                    <div class="detail-group">
                        <div class="detail-label">Order Number</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.OrderNo)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Order Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.OrderDate)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Related Party ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.RelatedPartyID)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Order Type</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.OrderTypeID)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Order Status</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.OrderStatus)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Created Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.CreatedDate)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Created By</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.CreatedBy)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Location</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LocationID)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Consultant</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.ConsultantID)</div>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="action-buttons">
                        <button type="submit" class="btn btn-danger mr-3">
                            <i class="fa fa-trash"></i> Confirm Delete
                        </button>
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>