﻿@model HR_Application_CO_OP_HOS.Models.RelatedPartyOrder

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Order Details</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .details-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 0;
            margin-bottom: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .details-header {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            color: white;
            padding: 25px;
            border-radius: 12px 12px 0 0;
        }

        .details-content {
            padding: 30px;
        }

        .section-title {
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .detail-group {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            border-left: 4px solid #3498db;
            transition: all 0.3s ease;
        }

            .detail-group:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .detail-label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 14px;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-value {
            color: #34495e;
            font-size: 16px;
            font-weight: 500;
            word-break: break-word;
        }

        .action-buttons {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid #ecf0f1;
            margin-top: 30px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 0 5px;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin: 0 5px;
        }

            .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        .badge-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        @@media (max-width: 768px) {
            .details-container {
                margin: 10px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .details-content {
                padding: 20px;
            }

            .action-buttons .btn {
                display: block;
                width: 100%;
                margin-bottom: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="details-container">
            <div class="details-header">
                <h2><i class="fa fa-eye"></i> Order Details</h2>
                <p class="mb-0">Complete information for order #@Model.OrderNo</p>
            </div>

            <div class="details-content">
                <!-- Basic Information Section -->
                <h4 class="section-title"><i class="fa fa-info-circle"></i> Basic Information</h4>
                <div class="details-grid">
                    <div class="detail-group">
                        <div class="detail-label">Order Number</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.OrderNo)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Order Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.OrderDate)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Related Party ID</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.RelatedPartyID)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Order Type</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.OrderTypeID)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Order Status</div>
                        <div class="detail-value">
                            <span class="badge-status @(Model.OrderStatus == 1 ? "status-active" : "status-inactive")">
                                @(Model.OrderStatus == 1 ? "Active" : "Inactive")
                            </span>
                        </div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Location</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.LocationID)</div>
                    </div>
                </div>

                <!-- Timestamps Section -->
                <h4 class="section-title"><i class="fa fa-clock-o"></i> Timestamps</h4>
                <div class="details-grid">
                    <div class="detail-group">
                        <div class="detail-label">Created Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.CreatedDate)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Created By</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.CreatedBy)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Modified Date</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.ModifiedDate)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Modified By</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.ModifiedBy)</div>
                    </div>
                </div>

                <!-- Financial Information Section -->
                <h4 class="section-title"><i class="fa fa-money"></i> Financial Information</h4>
                <div class="details-grid">
                    <div class="detail-group">
                        <div class="detail-label">Discount Percentage</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.DiscountPercentage)%</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Cash Paid</div>
                        <div class="detail-value">$@Html.DisplayFor(model => model.CashPaid)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Home Visit Hospital Charge</div>
                        <div class="detail-value">$@Html.DisplayFor(model => model.HomeVisitHospitalCharge)</div>
                    </div>
                </div>

                <!-- Additional Details Section -->
                <h4 class="section-title"><i class="fa fa-list-alt"></i> Additional Details</h4>
                <div class="details-grid">
                    <div class="detail-group">
                        <div class="detail-label">Consultant</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.ConsultantID)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Division Master</div>
                        <div class="detail-value">@Html.DisplayFor(model => model.DivisionMasterID)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">Remarks</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.Remarks) ? "No remarks" : Model.Remarks)</div>
                    </div>

                    <div class="detail-group">
                        <div class="detail-label">BHT Number</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.BHTNo) ? "N/A" : Model.BHTNo)</div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    @Html.ActionLink("Edit", "Edit", new { id = Model.ID }, new { @class = "btn btn-primary" })
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>
    </div>
</body>
</html>