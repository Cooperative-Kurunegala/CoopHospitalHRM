﻿@model IEnumerable<HR_Application_CO_OP_HOS.Models.RelatedPartyOrder>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Related Party Orders</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .index-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 0;
            margin-bottom: 30px;
        }

        .index-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px;
            border-radius: 12px 12px 0 0;
        }

        .index-content {
            padding: 30px;
        }

        .action-bar {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 5px solid #3498db;
        }

        .btn-success {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 25px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
            }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            border-radius: 6px;
            padding: 8px 15px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            margin: 2px;
        }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 3px 10px rgba(52, 152, 219, 0.3);
            }

        .btn-info {
            background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
            border: none;
            border-radius: 6px;
            padding: 8px 15px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            margin: 2px;
        }

            .btn-info:hover {
                transform: translateY(-1px);
                box-shadow: 0 3px 10px rgba(23, 162, 184, 0.3);
            }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            border: none;
            border-radius: 6px;
            padding: 8px 15px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            margin: 2px;
        }

            .btn-danger:hover {
                transform: translateY(-1px);
                box-shadow: 0 3px 10px rgba(231, 76, 60, 0.3);
            }

        .table-container {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .dataTables_wrapper {
            padding: 0;
        }

        table.dataTable {
            border-collapse: collapse !important;
        }

            table.dataTable thead th {
                background: #34495e;
                color: white;
                border: none;
                padding: 15px 10px;
                font-weight: 600;
            }

            table.dataTable tbody td {
                padding: 12px 10px;
                border-bottom: 1px solid #ecf0f1;
                vertical-align: middle;
            }

            table.dataTable tbody tr:hover {
                background-color: #f8f9fa;
            }

        .badge-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        .filters-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 5px solid #9b59b6;
        }

        .filter-group {
            margin-bottom: 15px;
        }

        .no-records {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
        }

            .no-records i {
                font-size: 48px;
                margin-bottom: 15px;
                color: #bdc3c7;
            }

        @@media (max-width: 768px) {
            .index-container {
                margin: 10px;
            }

            .index-content {
                padding: 20px;
            }

            .btn-primary, .btn-info, .btn-danger {
                display: block;
                width: 100%;
                margin-bottom: 5px;
            }

            .action-buttons {
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="index-container">
            <div class="index-header">
                <h2><i class="fa fa-list-alt"></i> Related Party Orders</h2>
                <p class="mb-0">Manage and view all related party orders in the system</p>
            </div>

            <div class="index-content">
                <!-- Action Bar -->
                <div class="action-bar">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h4 class="mb-0"><i class="fa fa-cubes"></i> Order Management</h4>
                        </div>
                        <div class="col-md-6 text-right">
                            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-success" })
                        </div>
                    </div>
                </div>

                <!-- Filters Section -->
                <div class="filters-section">
                    <h5><i class="fa fa-filter"></i> Filters & Search</h5>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="control-label">Order Status</label>
                                <select class="form-control" id="statusFilter">
                                    <option value="">All Statuses</option>
                                    <option value="1">Active</option>
                                    <option value="0">Inactive</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="control-label">Order Type</label>
                                <input type="number" class="form-control" id="typeFilter" placeholder="Order Type ID">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="control-label">Date From</label>
                                <input type="date" class="form-control" id="dateFromFilter">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="filter-group">
                                <label class="control-label">Date To</label>
                                <input type="date" class="form-control" id="dateToFilter">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 text-right">
                            <button class="btn btn-primary mr-2" id="applyFilters">
                                <i class="fa fa-check"></i> Apply Filters
                            </button>
                            <button class="btn btn-secondary" id="resetFilters">
                                <i class="fa fa-refresh"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Orders Table -->
                <div class="table-container">
                    @if (Model != null && Model.Any())
                    {
                        <table class="table table-striped table-bordered" id="ordersTable">
                            <thead>
                                <tr>
                                    <th>Order No</th>
                                    <th>Order Date</th>
                                    <th>Related Party</th>
                                    <th>Order Type</th>
                                    <th>Status</th>
                                    <th>Location</th>
                                    <th>Consultant</th>
                                    <th>Created Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.OrderNo)</td>
                                        <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
                                        <td>@Html.DisplayFor(modelItem => item.RelatedPartyID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.OrderTypeID)</td>
                                        <td>
                                            <span class="badge-status @(item.OrderStatus == 1 ? "status-active" : "status-inactive")">
                                                @(item.OrderStatus == 1 ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.LocationID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.ConsultantID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                                        <td class="action-buttons">
                                            @Html.ActionLink("Details", "Details", new { id = item.ID }, new { @class = "btn btn-info" })
                                            @Html.ActionLink("Edit", "Edit", new { id = item.ID }, new { @class = "btn btn-primary" })
                                            @Html.ActionLink("Delete", "Delete", new { id = item.ID }, new { @class = "btn btn-danger" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="no-records">
                            <i class="fa fa-inbox"></i>
                            <h4>No Orders Found</h4>
                            <p>There are no related party orders in the system yet.</p>
                            @Html.ActionLink("Create First Order", "Create", null, new { @class = "btn btn-success" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initialize DataTable if records exist
            var table = $('#ordersTable').DataTable({
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                "order": [[1, 'desc']],
                "language": {
                    "emptyTable": "No orders available",
                    "zeroRecords": "No matching orders found"
                },
                "responsive": true
            });

            // Filter functionality
            $('#applyFilters').on('click', function () {
                var statusFilter = $('#statusFilter').val();
                var typeFilter = $('#typeFilter').val();
                var dateFrom = $('#dateFromFilter').val();
                var dateTo = $('#dateToFilter').val();

                table.columns().search('').draw();

                if (statusFilter !== '') {
                    table.column(4).search(statusFilter).draw();
                }

                if (typeFilter !== '') {
                    table.column(3).search(typeFilter).draw();
                }

                if (dateFrom !== '' || dateTo !== '') {
                    $.fn.dataTable.ext.search.push(
                        function (settings, data, dataIndex) {
                            var orderDate = new Date(data[1]);
                            var fromDate = dateFrom ? new Date(dateFrom) : null;
                            var toDate = dateTo ? new Date(dateTo) : null;

                            if ((fromDate === null && toDate === null) ||
                                (fromDate === null && orderDate <= toDate) ||
                                (fromDate <= orderDate && toDate === null) ||
                                (fromDate <= orderDate && orderDate <= toDate)) {
                                return true;
                            }
                            return false;
                        }
                    );
                    table.draw();
                    $.fn.dataTable.ext.search.pop();
                }
            });

            // Reset filters
            $('#resetFilters').on('click', function () {
                $('#statusFilter').val('');
                $('#typeFilter').val('');
                $('#dateFromFilter').val('');
                $('#dateToFilter').val('');
                table.columns().search('').draw();
            });

            // Enhanced row click for better UX
            $('#ordersTable tbody').on('click', 'tr', function () {
                $(this).toggleClass('table-active');
            });

            // Export functionality placeholder
            $('#exportBtn').on('click', function () {
                alert('Export functionality will be implemented with server-side processing.');
            });
        });
    </script>
</body>
</html>