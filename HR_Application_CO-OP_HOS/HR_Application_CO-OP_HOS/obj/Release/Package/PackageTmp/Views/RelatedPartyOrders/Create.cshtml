﻿@model HR_Application_CO_OP_HOS.Models.RelatedPartyOrder

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Related Party Order</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .form-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 30px;
            margin-bottom: 30px;
        }

        .form-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 25px;
            border-radius: 12px 12px 0 0;
            margin: -30px -30px 30px -30px;
        }

        .form-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 5px solid #3498db;
        }

            .form-section h5 {
                color: #2c3e50;
                margin-bottom: 20px;
                font-weight: 600;
            }

        .form-group {
            margin-bottom: 20px;
        }

        .control-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-control {
            border-radius: 8px;
            border: 2px solid #e9ecef;
            padding: 12px 15px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #3498db;
                box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
            }

        .checkbox {
            margin-top: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(149, 165, 166, 0.4);
            }

        .text-danger {
            font-size: 14px;
            margin-top: 5px;
        }

        .reference-panel {
            background: #fff;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-top: 20px;
            max-height: 400px;
            overflow-y: auto;
        }

        .reference-item {
            padding: 12px 15px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .reference-item:hover {
                background: #3498db;
                color: white;
            }

            .reference-item:last-child {
                border-bottom: none;
            }

        .row.no-gutters {
            margin-right: 0;
            margin-left: 0;
        }

            .row.no-gutters > .col,
            .row.no-gutters > [class*="col-"] {
                padding-right: 15px;
                padding-left: 15px;
            }

        @@media (max-width: 768px) {
            .form-container {
                padding: 20px;
                margin: 10px;
            }

            .form-header {
                padding: 20px;
                margin: -20px -20px 20px -20px;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row no-gutters">
            <div class="col-12">
                <div class="form-container">
                    <div class="form-header">
                        <h2><i class="fa fa-plus-circle"></i> Create New Related Party Order</h2>
                        <p class="mb-0">Add a new related party order to the system</p>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="row no-gutters">
                            <div class="col-md-8">
                                <div class="form-section">
                                    <h5><i class="fa fa-info-circle"></i> Basic Information</h5>
                                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                                    <div class="row no-gutters">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.RelatedPartyID, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.RelatedPartyID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Related Party ID" } })
                                                @Html.ValidationMessageFor(model => model.RelatedPartyID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.OrderDate, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.OrderDate, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                                @Html.ValidationMessageFor(model => model.OrderDate, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row no-gutters">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.OrderTypeID, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.OrderTypeID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Order Type ID" } })
                                                @Html.ValidationMessageFor(model => model.OrderTypeID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.OrderNo, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.OrderNo, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Order Number" } })
                                                @Html.ValidationMessageFor(model => model.OrderNo, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h5><i class="fa fa-cog"></i> Order Details</h5>
                                    <div class="row no-gutters">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.OrderStatus, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.OrderStatus, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Order Status" } })
                                                @Html.ValidationMessageFor(model => model.OrderStatus, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.LocationID, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.LocationID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Location ID" } })
                                                @Html.ValidationMessageFor(model => model.LocationID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row no-gutters">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.DivisionMasterID, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.DivisionMasterID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Division Master ID" } })
                                                @Html.ValidationMessageFor(model => model.DivisionMasterID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.ConsultantID, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.ConsultantID, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Consultant ID" } })
                                                @Html.ValidationMessageFor(model => model.ConsultantID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h5><i class="fa fa-money"></i> Financial Information</h5>
                                    <div class="row no-gutters">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.DiscountPercentage, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.DiscountPercentage, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Discount Percentage" } })
                                                @Html.ValidationMessageFor(model => model.DiscountPercentage, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.CashPaid, htmlAttributes: new { @class = "control-label" })
                                                @Html.EditorFor(model => model.CashPaid, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter Cash Paid Amount" } })
                                                @Html.ValidationMessageFor(model => model.CashPaid, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="reference-panel">
                                    <h5><i class="fa fa-database"></i> Reference Data</h5>
                                    <p class="text-muted">Available reference data will appear here when implemented with proper database connections.</p>
                                    <div class="reference-item">
                                        <strong>Related Parties</strong>
                                        <small class="text-muted d-block">No data available</small>
                                    </div>
                                    <div class="reference-item">
                                        <strong>Order Types</strong>
                                        <small class="text-muted d-block">No data available</small>
                                    </div>
                                    <div class="reference-item">
                                        <strong>Division Masters</strong>
                                        <small class="text-muted d-block">No data available</small>
                                    </div>
                                    <div class="reference-item">
                                        <strong>Consultants</strong>
                                        <small class="text-muted d-block">No data available</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group text-center mt-4">
                            <button type="submit" class="btn btn-primary mr-3">
                                <i class="fa fa-save"></i> Create Order
                            </button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Add real-time validation feedback
            $('input[type="text"], input[type="number"]').on('blur', function () {
                var $this = $(this);
                if ($this.val().trim() === '') {
                    $this.addClass('is-invalid');
                } else {
                    $this.removeClass('is-invalid').addClass('is-valid');
                }
            });

            // Auto-format date fields
            $('input[type="datetime-local"]').each(function () {
                if (!$(this).val()) {
                    var now = new Date();
                    var formatted = now.toISOString().slice(0, 16);
                    $(this).val(formatted);
                }
            });

            // Enhanced form submission
            $('form').on('submit', function (e) {
                var isValid = true;
                $('input[required]').each(function () {
                    if ($(this).val().trim() === '') {
                        $(this).addClass('is-invalid');
                        isValid = false;
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    alert('Please fill in all required fields.');
                }
            });
        });
    </script>
</body>
</html>