﻿@model HR_Application_CO_OP_HOS.Models.EmployeeAllowance

@{
    ViewBag.Title = "Allowance Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="fullscreen-container dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">ALLOWANCE DETAILS</h1>
            <p class="hospital-subtitle">Hospital Human Resources System</p>
            <div class="admin-info">
                <span class="admin-welcome">Allowance Record Information</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="dashboard-section">
        <div class="section-header">
            <h2>📋 ALLOWANCE INFORMATION</h2>
        </div>
        <div class="section-content">
            <div class="details-container">
                <div class="details-grid">
                    <div class="detail-item">
                        <label class="detail-label">Employee ID:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.EmployeeID)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Allowance ID:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.AllowanceID)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Amount:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.Amount)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Effective Date:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.EffectiveDate)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">End Date:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.EndDate)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Status:</label>
                        <span class="detail-value">
                            <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </span>
                    </div>
                </div>

                <div class="action-buttons">
                    @Html.ActionLink("Edit", "Edit", new { id = Model.EmployeeAllowanceID }, new { @class = "btn btn-warning btn-lg" })
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fullscreen-container {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .dashboard-header {
        background: linear-gradient(135deg, #006400 0%, #228B22 100%);
        color: white;
        padding: 30px 20px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .hospital-name {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .hospital-subtitle {
        font-size: 1.3rem;
        margin-bottom: 20px;
        opacity: 0.9;
    }

    .admin-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.1rem;
        background: rgba(255,255,255,0.1);
        padding: 15px 20px;
        border-radius: 10px;
        margin-top: 20px;
    }

    .dashboard-section {
        background: white;
        margin: 20px;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .section-header {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        padding: 20px;
        border-bottom: 3px solid #006400;
    }

        .section-header h2 {
            margin: 0;
            font-size: 1.6rem;
            font-weight: bold;
        }

    .section-content {
        padding: 30px;
    }

    .details-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 10px;
        border-left: 4px solid #006400;
    }

    .detail-label {
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 8px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .detail-value {
        font-size: 1.2rem;
        color: #495057;
        font-weight: 500;
    }

    .badge {
        font-size: 0.9rem;
        padding: 8px 15px;
        border-radius: 20px;
    }

    .badge-success {
        background: #28a745;
        color: white;
    }

    .badge-secondary {
        background: #6c757d;
        color: white;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
    }

    .btn {
        padding: 12px 30px;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-warning {
        background: #ffc107;
        color: black;
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    @@media (max-width: 768px) {
        .hospital-name {
            font-size: 2rem;
        }

        .admin-info {
            flex-direction: column;
            gap: 10px;
            font-size: 1rem;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>