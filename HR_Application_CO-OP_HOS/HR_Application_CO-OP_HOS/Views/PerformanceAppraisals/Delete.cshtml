@model HR_Application_CO_OP_HOS.Models.PerformanceAppraisal
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Appraisal</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f5f5f5;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .header {
            background: #dc3545;
            color: white;
            padding: 20px;
            text-align: center;
        }

            .header h1 {
                margin: 0;
                font-size: 2rem;
            }

        .warning {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            padding: 20px;
            margin: 20px;
            border-radius: 5px;
            text-align: center;
            font-size: 1.2rem;
            color: #856404;
        }

        .content {
            padding: 30px;
        }

        .dl-horizontal {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 15px;
            margin-bottom: 30px;
        }

        dt {
            font-weight: bold;
            color: #006400;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 5px;
        }

        dd {
            margin: 0;
            padding: 10px;
            border: 1px solid #dee2e6;
            border-radius: 5px;
        }

        .form-actions {
            text-align: center;
            padding: 20px;
            border-top: 1px solid #dee2e6;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            margin: 0 10px;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Delete Performance Appraisal</h1>
        </div>

        <div class="warning">
            <h3>Are you sure you want to delete this appraisal?</h3>
        </div>

        <div class="content">
            <dl class="dl-horizontal">
                <dt>Employee ID</dt>
                <dd>@Html.DisplayFor(model => model.EmployeeID)</dd>

                <dt>Appraisal Date</dt>
                <dd>@Html.DisplayFor(model => model.AppraisalDate)</dd>

                <dt>Appraisal Period</dt>
                <dd>@Html.DisplayFor(model => model.AppraisalPeriod)</dd>

                <dt>Overall Rating</dt>
                <dd>@Html.DisplayFor(model => model.OverallRating)</dd>

                <dt>Rating Scale</dt>
                <dd>@Html.DisplayFor(model => model.RatingScale)</dd>

                <dt>Strengths</dt>
                <dd>@Html.DisplayFor(model => model.Strengths)</dd>

                <dt>Areas For Improvement</dt>
                <dd>@Html.DisplayFor(model => model.AreasForImprovement)</dd>

                <dt>Goals</dt>
                <dd>@Html.DisplayFor(model => model.Goals)</dd>

                <dt>Appraised By</dt>
                <dd>@Html.DisplayFor(model => model.AppraisedBy)</dd>

                <dt>Next Appraisal Date</dt>
                <dd>@Html.DisplayFor(model => model.NextAppraisalDate)</dd>

                <dt>Remarks</dt>
                <dd>@Html.DisplayFor(model => model.Remarks)</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Back to List</a>
                </div>
            }
        </div>
    </div>
</body>
</html>