﻿@model HR_Application_CO_OP_HOS.Models.EmployeeQualification

@{
    ViewBag.Title = "Delete Qualification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Container -->
<div class="fullscreen-container dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">DELETE QUALIFICATION</h1>
            <p class="hospital-subtitle">Hospital Human Resources System</p>
            <div class="admin-info">
                <span class="admin-welcome">Confirm Qualification Deletion</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="dashboard-section">
        <div class="section-header">
            <h2>🗑️ CONFIRM DELETION</h2>
        </div>
        <div class="section-content">
            <div class="alert alert-danger">
                <h4 class="alert-heading">⚠️ Warning!</h4>
                <p>Are you sure you want to delete this qualification record? This action cannot be undone and will permanently remove this qualification from the employee's record.</p>
            </div>

            <div class="details-container">
                <div class="details-grid">
                    <div class="detail-item">
                        <label class="detail-label">Qualification ID:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.QualificationID)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Employee ID:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.EmployeeID)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Qualification:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.Qualification)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Institution:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.Institution)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Year:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.Year)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Grade:</label>
                        <span class="detail-value">@Html.DisplayFor(model => model.Grade)</span>
                    </div>

                    <div class="detail-item">
                        <label class="detail-label">Verification Status:</label>
                        <span class="detail-value">
                            <span class="badge @(Model.IsVerified ? "badge-success" : "badge-warning")">
                                @(Model.IsVerified ? "Verified" : "Pending Verification")
                            </span>
                        </span>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="action-buttons">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <span class="btn-icon">🗑️</span> Confirm Delete
                        </button>
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .fullscreen-container {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .dashboard-header {
        background: linear-gradient(135deg, #006400 0%, #228B22 100%);
        color: white;
        padding: 25px 20px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .hospital-name {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 8px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .hospital-subtitle {
        font-size: 1.1rem;
        margin-bottom: 15px;
        opacity: 0.9;
    }

    .admin-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1rem;
        background: rgba(255,255,255,0.1);
        padding: 12px 18px;
        border-radius: 8px;
        margin-top: 15px;
    }

    .dashboard-section {
        background: white;
        margin: 15px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .section-header {
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        color: white;
        padding: 18px;
        border-bottom: 3px solid #006400;
    }

        .section-header h2 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: bold;
        }

    .section-content {
        padding: 25px;
    }

    .alert {
        padding: 18px 22px;
        border-radius: 8px;
        margin-bottom: 25px;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 2px solid #f5c6cb;
    }

    .alert-heading {
        font-size: 1.2rem;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .details-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #dc3545;
    }

    .detail-label {
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 8px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .detail-value {
        font-size: 1.1rem;
        color: #495057;
        font-weight: 500;
        word-break: break-word;
    }

    .badge {
        font-size: 0.8rem;
        padding: 4px 8px;
        border-radius: 12px;
    }

    .badge-success {
        background: #28a745;
        color: white;
    }

    .badge-warning {
        background: #ffc107;
        color: black;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
    }

    .btn {
        padding: 12px 30px;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-danger {
        background: #dc3545;
        color: white;
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    @@media (max-width: 768px) {
        .hospital-name {
            font-size: 1.6rem;
        }

        .admin-info {
            flex-direction: column;
            gap: 8px;
            font-size: 0.9rem;
        }

        .details-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .action-buttons {
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            width: 100%;
            justify-content: center;
            padding: 10px 25px;
        }

        .detail-value {
            font-size: 1rem;
        }
    }
</style>