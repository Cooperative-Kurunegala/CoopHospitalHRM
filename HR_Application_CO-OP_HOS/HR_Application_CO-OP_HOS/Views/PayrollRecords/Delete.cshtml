@model HR_Application_CO_OP_HOS.Models.PayrollRecord
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Delete Payroll Record</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f5f5f5;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .header {
            background: #dc3545;
            color: white;
            padding: 20px;
            text-align: center;
        }

            .header h1 {
                margin: 0;
                font-size: 2rem;
            }

        .warning {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            padding: 20px;
            margin: 20px;
            border-radius: 5px;
            text-align: center;
            font-size: 1.2rem;
            color: #856404;
        }

        .content {
            padding: 30px;
        }

        .dl-horizontal {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 15px;
            margin-bottom: 30px;
        }

        dt {
            font-weight: bold;
            color: #006400;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 5px;
        }

        dd {
            margin: 0;
            padding: 10px;
            border: 1px solid #dee2e6;
            border-radius: 5px;
        }

        .financial-positive {
            color: #28a745;
            font-weight: bold;
        }

        .financial-negative {
            color: #dc3545;
            font-weight: bold;
        }

        .form-actions {
            text-align: center;
            padding: 20px;
            border-top: 1px solid #dee2e6;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            margin: 0 10px;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Delete Payroll Record</h1>
        </div>

        <div class="warning">
            <h3>Are you sure you want to delete this payroll record?</h3>
        </div>

        <div class="content">
            <dl class="dl-horizontal">
                <dt>Employee ID</dt>
                <dd>@Html.DisplayFor(model => model.EmployeeID)</dd>

                <dt>Pay Period</dt>
                <dd>@Html.DisplayFor(model => model.PayPeriod)</dd>

                <dt>Pay Date</dt>
                <dd>@Html.DisplayFor(model => model.PayDate)</dd>

                <dt>Basic Salary</dt>
                <dd class="financial-positive">@Html.DisplayFor(model => model.BasicSalary)</dd>

                <dt>Fixed Allowances</dt>
                <dd class="financial-positive">@Html.DisplayFor(model => model.FixedAllowances)</dd>

                <dt>Variable Allowances</dt>
                <dd class="financial-positive">@Html.DisplayFor(model => model.VariableAllowances)</dd>

                <dt>Overtime Pay</dt>
                <dd class="financial-positive">@Html.DisplayFor(model => model.OvertimePay)</dd>

                <dt>Shift Allowances</dt>
                <dd class="financial-positive">@Html.DisplayFor(model => model.ShiftAllowances)</dd>

                <dt>Attendance Incentive</dt>
                <dd class="financial-positive">@Html.DisplayFor(model => model.AttendanceIncentive)</dd>

                <dt>Gross Salary</dt>
                <dd class="financial-positive">@Html.DisplayFor(model => model.GrossSalary)</dd>

                <dt>EPF Employee</dt>
                <dd class="financial-negative">@Html.DisplayFor(model => model.EPFEmployee)</dd>

                <dt>EPF Employer</dt>
                <dd class="financial-negative">@Html.DisplayFor(model => model.EPFEmployer)</dd>

                <dt>ETF Employer</dt>
                <dd class="financial-negative">@Html.DisplayFor(model => model.ETFEmployer)</dd>

                <dt>Payee Tax</dt>
                <dd class="financial-negative">@Html.DisplayFor(model => model.PayeeTax)</dd>

                <dt>Loan Deductions</dt>
                <dd class="financial-negative">@Html.DisplayFor(model => model.LoanDeductions)</dd>

                <dt>Other Deductions</dt>
                <dd class="financial-negative">@Html.DisplayFor(model => model.OtherDeductions)</dd>

                <dt>Total Deductions</dt>
                <dd class="financial-negative">@Html.DisplayFor(model => model.TotalDeductions)</dd>

                <dt>Net Salary</dt>
                <dd class="financial-positive">@Html.DisplayFor(model => model.NetSalary)</dd>

                <dt>Status</dt>
                <dd>@Html.DisplayFor(model => model.Status)</dd>

                <dt>Payment Method</dt>
                <dd>@Html.DisplayFor(model => model.PaymentMethod)</dd>

                <dt>Bank Account ID</dt>
                <dd>@Html.DisplayFor(model => model.BankAccountID)</dd>

                <dt>Generated Date</dt>
                <dd>@Html.DisplayFor(model => model.GeneratedDate)</dd>

                <dt>Generated By</dt>
                <dd>@Html.DisplayFor(model => model.GeneratedBy)</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Back to List</a>
                </div>
            }
        </div>
    </div>
</body>
</html>