@model IEnumerable<HR_Application_CO_OP_HOS.Models.RosterStatu>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <p>
        @Html.ActionLink("Create New", "Create")
    </p>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DayStatusDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderIndex)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RosterRelated)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RosterTypeID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NoOfMinutes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WithNextDay)
            </th>
            <th></th>
        </tr>
    
    @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DayStatusDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderIndex)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RosterRelated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RosterTypeID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NoOfMinutes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WithNextDay)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.ID }) |
                @Html.ActionLink("Details", "Details", new { id=item.ID }) |
                @Html.ActionLink("Delete", "Delete", new { id=item.ID })
            </td>
        </tr>
    }
    
    </table>
</body>
</html>
