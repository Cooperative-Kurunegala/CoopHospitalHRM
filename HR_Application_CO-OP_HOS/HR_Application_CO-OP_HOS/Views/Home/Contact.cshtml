@{
    ViewBag.Title = "Contact Support";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="contact-header">
        <h1>CONTACT SUPPORT</h1>
        <p class="subtitle">We're Here to Help You</p>
    </div>

    <div class="contact-content" style="padding:40px;">
        <div class="content-grid" style="display:grid;grid-template-columns:2fr 1fr;gap:40px;">
            <!-- Main Content -->
            <div class="main-content">
                <div class="support-section">
                    <h2>📞 GET IN TOUCH</h2>
                    <p class="lead">
                        We're here to help with any questions or support you may need regarding the HRM System.
                    </p>

                    <div class="support-card">
                        <h3>🔧 TECHNICAL SUPPORT</h3>
                        <p>For technical assistance, system issues, or bug reports, please contact our support team:</p>
                        <div class="contact-details">
                            <div class="contact-item"><strong>Email:</strong> <a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a></div>
                            <div class="contact-item"><strong>Response Time:</strong> Within 24 hours during business days</div>
                        </div>
                    </div>

                    <div class="support-card">
                        <h3>👨‍💼 SYSTEM ADMINISTRATOR</h3>
                        <p>For hospital-specific queries, user access, or local system configuration:</p>
                        <div class="contact-details">
                            <div class="contact-item"><strong>Contact:</strong> Please reach out to your local system administrator</div>
                            <div class="contact-item"><strong>Location:</strong> Hospital IT Department</div>
                        </div>
                    </div>

                    <div class="faq-section">
                        <h3>❓ FREQUENTLY ASKED QUESTIONS</h3>
                        <div class="faq-list">
                            <div class="faq-item" style="background:#f8f9fa;border:3px solid #006400;border-radius:15px;padding:25px;">
                                <div class="faq-question"><strong>How do I reset my password?</strong></div>
                                <div class="faq-answer">Contact your system administrator or send a password reset request to our support team.</div>
                            </div>

                            <div class="faq-item" style="background:#f8f9fa;border:3px solid #006400;border-radius:15px;padding:25px;">
                                <div class="faq-question"><strong>Where can I find user manuals?</strong></div>
                                <div class="faq-answer">User manuals and documentation are available through your system administrator or can be requested from support.</div>
                            </div>

                            <div class="faq-item" style="background:#f8f9fa;border:3px solid #006400;border-radius:15px;padding:25px;">
                                <div class="faq-question"><strong>How do I report a system bug?</strong></div>
                                <div class="faq-answer">Please email detailed information about the issue to <a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a> including steps to reproduce the problem.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="sidebar">
                <div class="info-card developer-card">
                    <h3>👨‍💻 DEVELOPER INFORMATION</h3>
                    <h4>eHealthcare Solutions</h4>
                    <p>Specialized Healthcare Software Solutions</p>

                    <div class="contact-info"><strong>Website:</strong><br><a href="https://ehealthcare.lk" target="_blank">https://ehealthcare.lk</a></div>
                    <div class="contact-info"><strong>Support Email:</strong><br><a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a></div>

                    <div class="services-list">
                        <strong>Services:</strong>
                        <ul>
                            <li>Healthcare Software Development</li>
                            <li>HRM Systems</li>
                            <li>Hospital Management Systems</li>
                            <li>Custom Healthcare Solutions</li>
                        </ul>
                    </div>
                </div>

                <div class="info-card hospital-card">
                    <h3>🏥 HOSPITAL INFORMATION</h3>
                    <p>This HRM System is specifically designed and implemented for:</p>
                    <div class="hospital-details">
                        <strong>Leading Private Hospital</strong><br>
                        <span>Sri Lanka</span>
                        <p>Ensuring efficient human resources management<br>and streamlined hospital operations.</p>
                    </div>
                </div>

                <div class="emergency-alert" style="background:#fff3cd;border:4px solid #ffc107;border-radius:15px;padding:25px;text-align:center;">
                    <h4>🚨 EMERGENCY SUPPORT</h4>
                    <p>For critical system outages affecting hospital operations, please contact both your local system administrator and our support team immediately.</p>
                </div>
            </div>
        </div>
    </div>
</div>