@model HR_Application_CO_OP_HOS.Models.Specialization

@{
    ViewBag.Title = "Edit Specialization";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Edit Form -->
<div class="fullscreen-container form-container">
    <div class="form-header">
        <h1 class="form-title">EDIT SPECIALIZATION</h1>
        <p class="form-subtitle">Hospital Human Resources Management System</p>
    </div>

    <div class="form-content">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.SpecializationID)

            <div class="form-card">
                <div class="form-section">
                    <h3 class="section-title">Specialization Information</h3>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                @Html.LabelFor(model => model.SpecializationName, htmlAttributes: new { @class = "form-label" })
                                @Html.EditorFor(model => model.SpecializationName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.SpecializationName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check-group">
                                @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { @class = "form-check-input" } })
                                @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "form-check-label" })
                                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-label" })
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 6, placeholder = "Enter detailed description of the specialization..." })
                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-success btn-lg">
                        <span class="btn-icon">💾</span>
                        SAVE CHANGES
                    </button>
                    @Html.ActionLink("BACK TO LIST", "Index", null, new { @class = "btn btn-secondary btn-lg" })
                </div>
            </div>
        }
    </div>
</div>

<style>
    .fullscreen-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #006400 0%, #228B22 100%);
        padding: 20px;
    }

    .form-header {
        text-align: center;
        color: white;
        margin-bottom: 40px;
        padding: 40px 20px;
    }

    .form-title {
        font-size: 3.5rem;
        font-weight: bold;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .form-subtitle {
        font-size: 1.8rem;
        opacity: 0.9;
    }

    .form-content {
        max-width: 1000px;
        margin: 0 auto;
    }

    .form-card {
        background: white;
        border-radius: 20px;
        padding: 50px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        border: 4px solid #006400;
    }

    .form-section {
        margin-bottom: 40px;
        padding: 30px;
        background: #f8f9fa;
        border-radius: 15px;
        border-left: 5px solid #006400;
    }

    .section-title {
        color: #006400;
        font-size: 2.2rem;
        margin-bottom: 25px;
        font-weight: bold;
        border-bottom: 3px solid #006400;
        padding-bottom: 10px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-label {
        font-weight: bold;
        color: #006400;
        font-size: 1.6rem;
        margin-bottom: 10px;
        display: block;
    }

    .form-control {
        height: 60px;
        font-size: 1.6rem;
        border: 3px solid #006400;
        border-radius: 10px;
        padding: 15px 20px;
    }

    textarea.form-control {
        height: auto;
        min-height: 150px;
        resize: vertical;
    }

    .form-check-group {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 20px 0;
        height: 60px;
        align-items: center;
    }

    .form-check-input {
        width: 30px;
        height: 30px;
    }

    .form-check-label {
        font-size: 1.6rem;
        font-weight: bold;
        color: #006400;
    }

    .form-actions {
        text-align: center;
        margin-top: 40px;
        padding-top: 30px;
        border-top: 3px solid #006400;
    }

    .btn {
        padding: 20px 40px;
        font-size: 1.8rem;
        font-weight: bold;
        border-radius: 15px;
        margin: 0 15px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 3px solid transparent;
        transition: all 0.3s ease;
    }

    .btn-success {
        background: #28a745;
        color: white;
        border-color: #28a745;
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
        border-color: #6c757d;
    }

    .btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }

    .btn-icon {
        font-size: 2rem;
    }

    @@media (max-width: 768px) {
        .form-title {
            font-size: 2.5rem;
        }

        .form-subtitle {
            font-size: 1.4rem;
        }

        .form-card {
            padding: 30px 20px;
        }

        .btn {
            width: 100%;
            margin: 10px 0;
            justify-content: center;
        }
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}