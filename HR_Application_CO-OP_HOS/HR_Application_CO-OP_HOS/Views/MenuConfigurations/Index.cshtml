@model IEnumerable<HR_Application_CO_OP_HOS.Models.MenuConfiguration>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <p>
        @Html.ActionLink("Create New", "Create")
    </p>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MenuItemName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MenuItemDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParentMenuItemID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MenuLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MenuItemControlName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UIType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MenuTypeID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MenuTypeDetailID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SplashScreenItemID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderIndex)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DivisionMasterID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChargeTypeID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RelatedPartyTypeID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderTypeID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsSellWardPharmacyPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdmissionTypeID)
            </th>
            <th></th>
        </tr>
    
    @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MenuItemName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MenuItemDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ParentMenuItemID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MenuLevel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MenuItemControlName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UIType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MenuTypeID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MenuTypeDetailID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SplashScreenItemID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderIndex)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DivisionMasterID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ChargeTypeID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RelatedPartyTypeID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderTypeID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsSellWardPharmacyPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdmissionTypeID)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.ID }) |
                @Html.ActionLink("Details", "Details", new { id=item.ID }) |
                @Html.ActionLink("Delete", "Delete", new { id=item.ID })
            </td>
        </tr>
    }
    
    </table>
</body>
</html>
