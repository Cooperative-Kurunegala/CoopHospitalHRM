@model IEnumerable<HR_Application_CO_OP_HOS.Models.AdmissionType>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.AdmissionTypeName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AdmissionTypeDescription)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AdmissionTypeSequence)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AdmissionTypeCode)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.AdmissionTypeName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AdmissionTypeDescription)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AdmissionTypeSequence)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AdmissionTypeCode)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Details", "Details", new { id=item.ID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.ID })
        </td>
    </tr>
}

</table>
