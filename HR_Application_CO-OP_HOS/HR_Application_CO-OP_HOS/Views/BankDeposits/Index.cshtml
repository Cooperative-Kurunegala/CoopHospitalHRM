@model IEnumerable<HR_Application_CO_OP_HOS.Models.BankDeposit>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Pharmacy_Deposit)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Reception_Deposit)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DepositDatetime)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedBy)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Cheque_Deposit)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CashInHand)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Pharmacy_Deposit)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Reception_Deposit)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DepositDatetime)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CreatedBy)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Cheque_Deposit)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CashInHand)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Details", "Details", new { id=item.ID }) |
