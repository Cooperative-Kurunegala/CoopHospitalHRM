@model IEnumerable<HR_Application_CO_OP_HOS.Models.LogDetail>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <p>
        @Html.ActionLink("Create New", "Create")
    </p>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.log_date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.usr_sys_code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RelatedID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RelatedTable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.log_desc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.log_event)
            </th>
            <th></th>
        </tr>
    
    @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.log_date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.usr_sys_code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RelatedID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RelatedTable)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.log_desc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.log_event)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.id }) |
                @Html.ActionLink("Details", "Details", new { id=item.id }) |
                @Html.ActionLink("Delete", "Delete", new { id=item.id })
            </td>
        </tr>
    }
    
    </table>
</body>
</html>
