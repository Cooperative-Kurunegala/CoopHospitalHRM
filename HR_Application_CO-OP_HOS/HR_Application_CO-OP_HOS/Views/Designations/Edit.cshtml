<!-- Edit.cshtml -->
@model HR_Application_CO_OP_HOS.Models.Designation

@{
    ViewBag.Title = "Edit Designation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Full Screen Edit Designation -->
<div class="fullscreen-container dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">✏️ EDIT DESIGNATION</h1>
            <p class="hospital-subtitle">Update designation information</p>
            <div class="admin-info">
                <span class="admin-welcome">Editing: @Model.DesignationName</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Edit Form Section -->
    <div class="dashboard-section">
        <div class="section-header">
            <h2>📝 UPDATE DESIGNATION INFORMATION</h2>
        </div>
        <div class="section-content">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.DesignationID)

                <div class="form-container">
                    @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

                    <div class="form-grid">
                        <div class="form-group">
                            @Html.LabelFor(model => model.DesignationName, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.DesignationName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.DesignationName, "", new { @class = "validation-message" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Grade, htmlAttributes: new { @class = "form-label" })
                            @Html.EditorFor(model => model.Grade, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Grade, "", new { @class = "validation-message" })
                        </div>

                        <div class="form-group full-width">
                            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-label" })
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control textarea-large", rows = 4 })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "validation-message" })
                        </div>

                        <div class="form-group checkbox-group">
                            <label class="checkbox-label">
                                @Html.EditorFor(model => model.IsActive)
                                <span class="checkbox-custom"></span>
                                Active Designation
                            </label>
                            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "validation-message" })
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="quick-action-btn btn-primary">
                            💾 Save Changes
                        </button>
                        <a href="@Url.Action("Index")" class="quick-action-btn btn-secondary">
                            📋 Back to List
                        </a>
                        <a href="@Url.Action("Details", new { id = Model.DesignationID })" class="quick-action-btn btn-info">
                            👁️ View Details
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<style>
    .dashboard-container {
        margin: 0;
        padding: 0;
    }

    .admin-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.8rem;
        background: rgba(0,0,0,0.2);
        padding: 20px;
        border-radius: 10px;
    }

    .dashboard-section {
        padding: 20px;
    }

    .section-content {
        padding: 40px;
    }

    .form-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 40px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        font-size: 1.8rem;
        font-weight: bold;
        margin-bottom: 10px;
        color: #333;
    }

    .form-control {
        padding: 15px;
        font-size: 1.6rem;
        border: 2px solid #006400;
        border-radius: 10px;
        background: #f8f9fa;
    }

    .textarea-large {
        min-height: 150px;
        resize: vertical;
    }

    .checkbox-group {
        flex-direction: row;
        align-items: center;
        grid-column: 1 / -1;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        font-size: 1.6rem;
        cursor: pointer;
    }

    .checkbox-custom {
        display: inline-block;
        width: 25px;
        height: 25px;
        border: 2px solid #006400;
        border-radius: 5px;
        margin-right: 10px;
        position: relative;
    }

    input[type="checkbox"]:checked + .checkbox-custom::after {
        content: "✓";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: #006400;
        font-weight: bold;
    }

    input[type="checkbox"] {
        display: none;
    }

    .form-actions {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 40px;
    }

    .quick-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px 30px;
        border: none;
        border-radius: 10px;
        font-size: 1.8rem;
        font-weight: bold;
        text-decoration: none;
        transition: all 0.3s ease;
        min-width: 200px;
    }

    .btn-primary {
        background: #006400;
        color: white;
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn-info {
        background: #17a2b8;
        color: white;
    }

    .quick-action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .validation-summary {
        color: #dc3545;
        font-size: 1.6rem;
        margin-bottom: 20px;
        padding: 15px;
        background: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 5px;
    }

    .validation-message {
        color: #dc3545;
        font-size: 1.4rem;
        margin-top: 5px;
    }

    @@media (max-width: 768px) {
        body {
            font-size: 24px;
        }

        .hospital-name {
            font-size: 2.5rem;
        }

        .hospital-subtitle {
            font-size: 1.5rem;
        }

        .admin-info {
            flex-direction: column;
            gap: 15px;
            font-size: 1.4rem;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
            align-items: center;
        }
    }
</style>