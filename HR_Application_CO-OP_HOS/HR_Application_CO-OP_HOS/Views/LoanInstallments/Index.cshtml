@model IEnumerable<HR_Application_CO_OP_HOS.Models.LoanInstallment>

@{
    ViewBag.Title = "Loan Installments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container dashboard-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">LOAN INSTALLMENTS MANAGEMENT</h1>
            <p class="hospital-subtitle">Hospital Human Resources Management System</p>
            <div class="admin-info">
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <div class="dashboard-section">
        <div class="section-header">
            <h2>📊 LOAN INSTALLMENTS</h2>
            <div class="action-buttons">
                @Html.ActionLink("➕ CREATE NEW", "Create", null, new { @class = "btn btn-success" })
            </div>
        </div>

        <div class="section-content">
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.LoanID)</th>
                            <th>@Html.DisplayNameFor(model => model.InstallmentNumber)</th>
                            <th>@Html.DisplayNameFor(model => model.DueDate)</th>
                            <th>@Html.DisplayNameFor(model => model.Amount)</th>
                            <th>@Html.DisplayNameFor(model => model.PaidDate)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.PaidAmount)</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.LoanID)</td>
                                <td>@Html.DisplayFor(modelItem => item.InstallmentNumber)</td>
                                <td>@Html.DisplayFor(modelItem => item.DueDate)</td>
                                <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                                <td>@Html.DisplayFor(modelItem => item.PaidDate)</td>
                                <td>
                                    <span class="status-badge @(item.Status?.ToLower())">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.PaidAmount)</td>
                                <td class="action-buttons">
                                    @Html.ActionLink("✏️", "Edit", new { id = item.InstallmentID }, new { @class = "btn btn-primary btn-sm", title = "Edit" })
                                    @Html.ActionLink("👁️", "Details", new { id = item.InstallmentID }, new { @class = "btn btn-info btn-sm", title = "Details" })
                                    @Html.ActionLink("🗑️", "Delete", new { id = item.InstallmentID }, new { @class = "btn btn-danger btn-sm", title = "Delete" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .action-buttons {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .table-container {
        background: #ffffff;
        border-radius: 15px;
        border: 3px solid #006400;
        overflow: hidden;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 1.6rem;
    }

        .data-table th,
        .data-table td {
            padding: 20px;
            text-align: left;
            border-bottom: 2px solid #f0f0f0;
        }

        .data-table th {
            background: #006400;
            color: white;
            font-weight: bold;
            font-size: 1.8rem;
        }

        .data-table tr:hover {
            background: #f8f9fa;
        }

    .status-badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 1.4rem;
        text-transform: uppercase;
    }

        .status-badge.paid {
            background: #d4edda;
            color: #155724;
        }

        .status-badge.pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-badge.overdue {
            background: #f8d7da;
            color: #721c24;
        }

        .status-badge.partial {
            background: #cce7ff;
            color: #004085;
        }

    .btn-sm {
        padding: 10px 15px;
        min-width: auto;
        font-size: 1.4rem;
    }

    .btn-success {
        background: #28a745;
        color: white;
    }

    .btn-primary {
        background: #007bff;
        color: white;
    }

    .btn-info {
        background: #17a2b8;
        color: white;
    }

    .btn-danger {
        background: #dc3545;
        color: white;
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 10px;
        font-size: 1.6rem;
        font-weight: bold;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        display: inline-block;
    }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    @@media (max-width: 768px) {
        .data-table {
            display: block;
            overflow-x: auto;
        }

        .action-buttons {
            flex-direction: column;
        }

        .data-table th,
        .data-table td {
            padding: 15px 10px;
            font-size: 1.4rem;
        }
    }
</style>