﻿@model IEnumerable<HR_Application_CO_OP_HOS.Models.AttendanceRecord>

@{
    ViewBag.Title = "Attendance Records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">ATTENDANCE RECORDS</h1>
            <p class="hospital-subtitle">Manage Employee Attendance and Time Tracking</p>
            <div class="admin-info">
                <span class="admin-welcome">Welcome, System Administrator</span>
                <span class="current-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions-panel">
        <div class="section-header"><h2>🚀 QUICK ACTIONS</h2></div>
        <div class="quick-actions-grid">
            <a href="@Url.Action("Create", "AttendanceRecords")" class="quick-action-btn btn-primary"><span>➕ Create New Record</span></a>
            <a href="@Url.Action("Index", "Shifts")" class="quick-action-btn btn-success"><span>🔄 Manage Shifts</span></a>
            <a href="@Url.Action("Index", "Employees")" class="quick-action-btn btn-info"><span>👥 View Employees</span></a>
            <a href="@Url.Action("Index", "Home")" class="quick-action-btn btn-secondary"><span>🏠 Back to Dashboard</span></a>
        </div>
    </div>

    <!-- Attendance Records Grid -->
    <div class="dashboard-grid">
        <div class="row no-gutters">
            <div class="col-md-12 dashboard-section">
                <div class="section-header">
                    <h2>📊 ATTENDANCE RECORDS</h2>
                </div>
                <div class="section-content">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-header">
                                <tr>
                                    <th>Employee ID</th>
                                    <th>Date</th>
                                    <th>Shift</th>
                                    <th>Actual In</th>
                                    <th>Actual Out</th>
                                    <th>Total Hours</th>
                                    <th>Overtime</th>
                                    <th>Status</th>
                                    <th>Regularized</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="table-row">
                                        <td>@Html.DisplayFor(modelItem => item.EmployeeID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.AttendanceDate)</td>
                                        <td>@Html.DisplayFor(modelItem => item.ShiftID)</td>
                                        <td>@Html.DisplayFor(modelItem => item.ActualIn)</td>
                                        <td>@Html.DisplayFor(modelItem => item.ActualOut)</td>
                                        <td>
                                            <span class="badge @(item.TotalHours >= 8 ? "badge-success" : "badge-warning")">
                                                @Html.DisplayFor(modelItem => item.TotalHours) hrs
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.OvertimeHours > 0)
                                            {
                                                <span class="badge badge-info">@item.OvertimeHours hrs</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">0 hrs</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var statusClass = item.Status == "Present" ? "badge-success" :
                                                                item.Status == "Absent" ? "badge-danger" :
                                                                item.Status == "Late" ? "badge-warning" : "badge-secondary";
                                            }
                                            <span class="badge @statusClass">@item.Status</span>
                                        </td>
                                        <td>
                                            @if (item.IsRegularized)
                                            {
                                                <span class="badge badge-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">No</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                @Html.ActionLink("✏️", "Edit", new { id = item.AttendanceID }, new { @class = "btn btn-sm btn-outline-primary", title = "Edit" })
                                                @Html.ActionLink("👁️", "Details", new { id = item.AttendanceID }, new { @class = "btn btn-sm btn-outline-info", title = "Details" })
                                                @Html.ActionLink("🗑️", "Delete", new { id = item.AttendanceID }, new { @class = "btn btn-sm btn-outline-danger", title = "Delete" })
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-header {
        background: #006400;
        color: white;
        font-size: 1.8rem;
    }

    .table-row {
        font-size: 1.6rem;
        transition: all 0.3s ease;
    }

        .table-row:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }

    .action-buttons .btn {
        margin: 2px;
        padding: 8px 12px;
        font-size: 1.4rem;
        border-radius: 8px;
    }

    .badge {
        font-size: 1.4rem;
        padding: 8px 12px;
    }
</style>