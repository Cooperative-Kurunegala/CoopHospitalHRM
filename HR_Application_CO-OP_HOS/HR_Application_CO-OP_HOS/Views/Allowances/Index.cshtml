﻿@model IEnumerable<HR_Application_CO_OP_HOS.Models.Allowance>

@{
    ViewBag.Title = "Allowances Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fullscreen-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="hospital-name">ALLOWANCES MANAGEMENT</h1>
            <p class="hospital-subtitle">Manage Employee Allowances and Benefits</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions-panel">
        <div class="section-header"><h2>🚀 QUICK ACTIONS</h2></div>
        <div class="quick-actions-grid">
            <a href="@Url.Action("Create", "Allowances")" class="quick-action-btn btn-primary"><span>➕ Create New Allowance</span></a>
            <a href="@Url.Action("Index", "EmployeeAllowances")" class="quick-action-btn btn-success"><span>💼 Assign Allowances</span></a>
            <a href="@Url.Action("Index", "PayrollRecords")" class="quick-action-btn btn-info"><span>💰 Payroll Processing</span></a>
            <a href="@Url.Action("Index", "Home")" class="quick-action-btn btn-secondary"><span>🏠 Back to Dashboard</span></a>
        </div>
    </div>

    <!-- Allowances Grid -->
    <div class="dashboard-grid">
        <div class="row no-gutters">
            <div class="col-md-12 dashboard-section">
                <div class="section-header">
                    <h2>💰 ALLOWANCES LIST</h2>
                </div>
                <div class="section-content">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-header">
                                <tr>
                                    <th>Allowance Name</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Percentage</th>
                                    <th>Taxable</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="table-row">
                                        <td>
                                            <strong>@Html.DisplayFor(modelItem => item.AllowanceName)</strong>
                                            @if (!string.IsNullOrEmpty(item.Description))
                                            {
                                                <br /><small class="text-muted">@item.Description</small>
                                            }
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.AllowanceType)</td>
                                        <td>
                                            @if (item.IsPercentage)
                                            {
                                                <span>@Html.DisplayFor(modelItem => item.Amount)% of @item.PercentageOf</span>
                                            }
                                            else
                                            {
                                                <span>@Html.DisplayFor(modelItem => item.Amount)</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsPercentage)
                                            {
                                                <span class="badge badge-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">No</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsTaxable)
                                            {
                                                <span class="badge badge-warning">Taxable</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-info">Non-Taxable</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                @Html.ActionLink("✏️", "Edit", new { id = item.AllowanceID }, new { @class = "btn btn-sm btn-outline-primary", title = "Edit" })
                                                @Html.ActionLink("👁️", "Details", new { id = item.AllowanceID }, new { @class = "btn btn-sm btn-outline-info", title = "Details" })
                                                @Html.ActionLink("🗑️", "Delete", new { id = item.AllowanceID }, new { @class = "btn btn-sm btn-outline-danger", title = "Delete" })
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-header {
        background: #006400;
        color: white;
        font-size: 1.8rem;
    }

    .table-row {
        font-size: 1.6rem;
        transition: all 0.3s ease;
    }

        .table-row:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }

    .action-buttons .btn {
        margin: 2px;
        padding: 8px 12px;
        font-size: 1.4rem;
        border-radius: 8px;
    }

    .badge {
        font-size: 1.4rem;
        padding: 8px 12px;
    }
</style>