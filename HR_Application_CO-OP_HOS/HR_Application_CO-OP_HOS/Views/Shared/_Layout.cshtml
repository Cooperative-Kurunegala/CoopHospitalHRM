﻿
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HRM System</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">

    <style>
        /* Global base and typography */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Times New Roman', serif;
            font-size: 32px;
            background-color: #ffffff;
            color: #000;
            line-height: 1.6;
            overflow: auto;
        }

        * {
            box-sizing: border-box;
        }

        /* Fixed navbar height is 80px, footer 80px -> content area calc(100vh - 160px) */
        .navbar-inverse {
            background: linear-gradient(135deg,#2c3e50,#34495e);
            border: none;
            box-shadow: 0 2px 10px rgba(0,0,0,.1);
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.2rem;
            padding: 15px;
            font-family: 'Times New Roman', serif;
        }

        .navbar-inverse .navbar-nav > li > a {
            color: #ecf0f1;
            font-weight: 500;
            padding: 15px 20px;
            transition: all .3s ease;
        }

            .navbar-inverse .navbar-nav > li > a:hover {
                color: #3498db;
                background-color: rgba(255,255,255,.1);
                border-radius: 5px;
            }

        /* Body content: full width, occupies area between navbar and footer */
        .body-content {
            width: 100%;
            margin: 0;
            padding-top: 80px; /* space for fixed navbar */
            min-height: calc(100vh - 160px);
            display: block;
        }

        /* Fullscreen container used by views: no outer margins/paddings */
        .fullscreen-container {
            width: 100%;
            margin: 0;
            padding: 0;
            min-height: calc(100vh - 160px);
            background: linear-gradient(135deg,#fff,#f8f9fa);
            overflow: auto;
            position: relative;
        }

        /* Header / footer / shared UI */
        .dashboard-header, .about-header, .contact-header {
            background: linear-gradient(135deg,#006400,#008000);
            color: #fff;
            padding: 60px 40px;
            text-align: center;
            border-bottom: 8px solid #000;
            font-family: 'Times New Roman', serif;
        }

            .dashboard-header h1, .about-header h1, .contact-header h1 {
                font-size: 4rem;
                font-weight: bold;
                margin-bottom: 20px;
                text-shadow: 2px 2px 4px rgba(0,0,0,.3);
            }

        .subtitle {
            font-size: 2rem;
            opacity: .9;
        }

        .footer {
            background: linear-gradient(135deg,#2c3e50,#34495e);
            color: #ecf0f1;
            padding: 30px 0;
            border-top: 4px solid #3498db;
            font-family: 'Times New Roman', serif;
            font-size: 18px;
        }

            /* Make footer full width with fluid container to avoid outer margins */
            .footer .container-fluid {
                width: 100%;
                padding-left: 20px;
                padding-right: 20px;
            }

        /* Utilities reused by views */
        .lead {
            font-size: 2rem;
            line-height: 1.6;
            margin-bottom: 30px;
            color: #333;
        }

        .info-card, .stat-content, .support-card {
            background: #f8f9fa;
            border: 3px solid #006400;
            border-radius: 15px;
            padding: 25px;
            font-family: 'Times New Roman', serif;
        }

        @@media (max-width: 768px) {
            body {
                font-size: 24px;
            }

            .dashboard-header, .about-header, .contact-header {
                padding: 40px 20px;
            }

                .dashboard-header h1, .about-header h1, .contact-header h1 {
                    font-size: 2.5rem;
                }

            .body-content {
                padding-top: 70px;
            }
        }
    </style>
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
                </button>
                @Html.ActionLink("HRM System", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li>@Html.ActionLink("Home", "Index", "Home")</li>
                    <li>@Html.ActionLink("About", "About", "Home")</li>
                    <li>@Html.ActionLink("Contact", "Contact", "Home")</li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-th-large"></i> Modules <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink(" Employee Management", "Index", "RelatedParties", null, new { @class = "fa fa-users" })</li>
                            <li>@Html.ActionLink(" Attendance", "Index", "AttendanceRecords", null, new { @class = "fa fa-clock-o" })</li>
                            <li>@Html.ActionLink(" Payroll", "Index", "PayrollRecords", null, new { @class = "fa fa-money" })</li>
                            <li>@Html.ActionLink(" Leave Management", "Index", "Leaves", null, new { @class = "fa fa-calendar" })</li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Render full-width body area (no outer .container so pages can be full screen) -->
    <div class="body-content">
        @RenderBody()

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6">
                        <p>&copy; @DateTime.Now.Year - HRM System</p>
                        <p>Powered by <a href="https://ehealthcare.lk" target="_blank">eHealthcare Solutions</a></p>
                    </div>
                    <div class="col-md-6 text-right">
                        <p>
                            <strong><i class="fa fa-envelope"></i> Support:</strong> <a href="mailto:support@ehealthcare.lk">support@ehealthcare.lk</a><br />
                            <strong><i class="fa fa-globe"></i> Website:</strong> <a href="https://ehealthcare.lk" target="_blank">https://ehealthcare.lk</a>
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Back to Top -->
    <button class="back-to-top" onclick="scrollToTop()" style="display:none;position:fixed;bottom:20px;right:20px;background:#3498db;color:#fff;border-radius:50%;width:50px;height:50px;border:none;z-index:1000;">
        <i class="fa fa-chevron-up" style="line-height:50px;"></i>
    </button>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        window.onscroll = function () {
            var btn = document.querySelector('.back-to-top');
            if (!btn) return;
            if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) btn.style.display = 'block'; else btn.style.display = 'none';
        };
        function scrollToTop() { window.scrollTo({ top: 0, behavior: 'smooth' }); }
        $(document).ready(function () {
            var url = window.location.pathname;
            $('.nav li a').each(function () { if ($(this).attr('href') === url) $(this).parent().addClass('active'); });
        });
    </script>
</body>
</html>